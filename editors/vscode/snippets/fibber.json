{
  "defun": {
    "prefix": "defun",
    "body": ["(defun ${1:name} (${2:x}: ${3:i64}) -> ${4:i64}", "  $0)"],
    "description": "A function"
  },
  "defn (overloaded)": {
    "prefix": "defn",
    "body": [
      "(defn ${1:name}",
      "  ([${2:x}: ${3:i64}] -> ${4:i64} $5)",
      "  ([${2:x}: ${3:i64} ${6:y}: ${3:i64}] -> ${4:i64} $0))"
    ],
    "description": "Arity overloading: clauses chosen by argument count"
  },
  "defstruct": {
    "prefix": "defstruct",
    "body": ["(defstruct ${1:Name} (${2:field}: ${3:i64}))"],
    "description": "A struct"
  },
  "defenum": {
    "prefix": "defenum",
    "body": ["(defenum ${1:Name}", "  (${2:Variant} ${3:v}: ${4:i64})", "  (${5:Empty}))"],
    "description": "An enum"
  },
  "defprotocol": {
    "prefix": "defprotocol",
    "body": ["(defprotocol ${1:Name}", "  (${2:method} (self) -> ${3:i64}))"],
    "description": "A protocol"
  },
  "impl": {
    "prefix": "impl",
    "body": ["(impl ${1:Protocol} ${2:Type}", "  (${3:method} (self) $0))"],
    "description": "A protocol implementation"
  },
  "match": {
    "prefix": "match",
    "body": ["(match ${1:x}", "  ((${2:Variant} ${3:v}) $4)", "  ($0))"],
    "description": "Pattern match"
  },
  "let": {
    "prefix": "let",
    "body": ["(let [${1:x} ${2:init}]", "  $0)"],
    "description": "Bindings"
  },
  "loop": {
    "prefix": "loop",
    "body": ["(loop [${1:i} 0 ${2:acc} 0]", "  (if ${3:done}", "    ${2:acc}", "    (recur (+ ${1:i} 1) $0)))"],
    "description": "loop / recur"
  },
  "cond": {
    "prefix": "cond",
    "body": ["(cond", "  ${1:test} ${2:expr}", "  :else ${0:expr})"],
    "description": "Flat cond"
  },
  "try-let": {
    "prefix": "try-let",
    "body": ["(try-let [${1:x} ${2:(Ok 1)}]", "  $0)"],
    "description": "Chain Results"
  },
  "if-some": {
    "prefix": "if-some",
    "body": ["(if-some [${1:x} ${2:opt}]", "  ${3:then}", "  ${0:else})"],
    "description": "Bind an Option"
  },
  "ns": {
    "prefix": "ns",
    "body": ["(ns ${1:main}", "  (:require [${2:a.b} :as ${3:ab}]))"],
    "description": "Module header"
  },
  "main": {
    "prefix": "main",
    "body": ["(defun main () -> i64", "  $0)"],
    "description": "Entry point"
  },
  "case header": {
    "prefix": "check",
    "body": ["(let [c (checks)]", "  (let [c (check c (= ${1:actual} ${2:expected}))]", "    (checks-result c)))"],
    "description": "tl.check assertions (see the skill's case example)"
  }
}
