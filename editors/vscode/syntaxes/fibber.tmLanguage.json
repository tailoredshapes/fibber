{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "fibber",
  "scopeName": "source.fibber",
  "fileTypes": ["fib"],
  "patterns": [{ "include": "#form" }],
  "repository": {
    "form": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#form-comment" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#keyword" },
        { "include": "#constant" },
        { "include": "#definition" },
        { "include": "#special-form" },
        { "include": "#macro" },
        { "include": "#reader-macro" },
        { "include": "#annotation" },
        { "include": "#arrow" },
        { "include": "#type" },
        { "include": "#namespaced" },
        { "include": "#collection" }
      ]
    },
    "comment": {
      "name": "comment.line.semicolon.fibber",
      "match": ";.*$"
    },
    "form-comment": {
      "name": "comment.block.form.fibber",
      "begin": "#_\\s*(?=[(\\[{])",
      "end": "(?<=[)\\]}])",
      "patterns": [{ "include": "#form-comment-body" }]
    },
    "form-comment-body": {
      "patterns": [
        { "match": "\"(?:[^\"\\\\]|\\\\.)*\"" },
        { "begin": "[(\\[{]", "end": "[)\\]}]", "patterns": [{ "include": "#form-comment-body" }] }
      ]
    },
    "string": {
      "name": "string.quoted.double.fibber",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.fibber",
          "match": "\\\\(?:[ntr0\\\\\"]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        { "name": "invalid.illegal.escape.fibber", "match": "\\\\." }
      ]
    },
    "char": {
      "name": "constant.character.fibber",
      "match": "\\\\(?:newline|space|tab|return|u\\{[0-9A-Fa-f]{1,6}\\}|[^\\s])(?![\\w])"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.ratio.fibber",
          "match": "(?<![\\w.+*!?<>=/:-])-?\\d+/\\d+(?![\\w.+*!?<>=/:-])"
        },
        {
          "name": "constant.numeric.float.fibber",
          "match": "(?<![\\w.+*!?<>=/:-])-?\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?|[eE][+-]?\\d+)(?:f32|f64)?(?![\\w.+*!?<>=/:-])"
        },
        {
          "name": "constant.numeric.hex.fibber",
          "match": "(?<![\\w.+*!?<>=/:-])-?0[xX][0-9A-Fa-f_]+(?:i8|i16|i32|i64)?(?![\\w.+*!?<>=/:-])"
        },
        {
          "name": "constant.numeric.binary.fibber",
          "match": "(?<![\\w.+*!?<>=/:-])-?0[bB][01_]+(?:i8|i16|i32|i64)?(?![\\w.+*!?<>=/:-])"
        },
        {
          "name": "constant.numeric.integer.fibber",
          "match": "(?<![\\w.+*!?<>=/:-])-?\\d[\\d_]*(?:i8|i16|i32|i64)?(?![\\w.+*!?<>=/:-])"
        }
      ]
    },
    "keyword": {
      "name": "constant.other.keyword.fibber",
      "match": "(?<![\\w.+*!?<>=/:-]):[^\\s()\\[\\]{}\",;'`~@\\\\]+"
    },
    "constant": {
      "name": "constant.language.fibber",
      "match": "(?<![\\w.+*!?<>=/:-])(?:true|false|nil)(?![\\w.+*!?<>=/:-])"
    },
    "definition": {
      "patterns": [
        {
          "match": "(\\()\\s*(defun|defn|defmacro)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)",
          "captures": {
            "1": { "name": "punctuation.section.fibber" },
            "2": { "name": "keyword.control.fibber" },
            "3": { "name": "entity.name.function.fibber" }
          }
        },
        {
          "match": "(\\()\\s*(defstruct|defenum|defrecord|defprotocol)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)",
          "captures": {
            "1": { "name": "punctuation.section.fibber" },
            "2": { "name": "keyword.control.fibber" },
            "3": { "name": "entity.name.type.fibber" }
          }
        },
        {
          "match": "(\\()\\s*(impl)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)",
          "captures": {
            "1": { "name": "punctuation.section.fibber" },
            "2": { "name": "keyword.control.fibber" },
            "3": { "name": "entity.name.type.interface.fibber" },
            "4": { "name": "entity.name.type.fibber" }
          }
        },
        {
          "match": "(\\()\\s*(ns)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)",
          "captures": {
            "1": { "name": "punctuation.section.fibber" },
            "2": { "name": "keyword.control.fibber" },
            "3": { "name": "entity.name.namespace.fibber" }
          }
        },
        {
          "match": "(\\()\\s*(def|defonce|declare)\\s+([^\\s()\\[\\]{}\",;'`~@\\\\]+)",
          "captures": {
            "1": { "name": "punctuation.section.fibber" },
            "2": { "name": "keyword.control.fibber" },
            "3": { "name": "variable.other.constant.fibber" }
          }
        }
      ]
    },
    "special-form": {
      "name": "keyword.control.fibber",
      "match": "(?<=[(\\s])(?:defun|defn|fn|let|if|do|match|loop|recur|defstruct|defenum|defprotocol|defrecord|impl|ns|def|defonce|declare|defmacro|quote|quasiquote|unquote|unquote-splicing|set!|set-field!|deref|async|await|unsafe|extern|var|dyn|and|or|cond|spawn|join)(?![\\w.+*!?<>=/:-])"
    },
    "macro": {
      "name": "support.function.macro.fibber",
      "match": "(?<=\\()(?:when|when-not|if-not|if-let|when-let|if-some|when-some|when-first|try-let|doseq|dotimes|for|while|case|condp|cond->|cond->>|some->|some->>|->|->>|as->|with|lazy-seq|lazy-cat|future|partial2|try)(?![\\w.+*!?<>=/:-])"
    },
    "reader-macro": {
      "patterns": [
        { "name": "keyword.operator.deref.fibber", "match": "@(?=[^\\s)\\]}])" },
        { "name": "keyword.operator.inout.fibber", "match": "&(?=[A-Za-z_(])" },
        { "name": "keyword.operator.unquote.fibber", "match": "~@?" },
        { "name": "keyword.operator.quote.fibber", "match": "['`]" },
        { "name": "punctuation.definition.fn.fibber", "match": "#(?=[({])" },
        { "name": "variable.parameter.anonymous.fibber", "match": "(?<![\\w])%\\d?(?![\\w])" }
      ]
    },
    "annotation": {
      "name": "variable.parameter.fibber",
      "match": "(?<![\\w.+*!?<>=/:-])[^\\s()\\[\\]{}\",;'`~@\\\\:][^\\s()\\[\\]{}\",;'`~@\\\\]*:(?=\\s)"
    },
    "arrow": {
      "name": "keyword.operator.arrow.fibber",
      "match": "(?<=\\s)->(?=\\s)"
    },
    "type": {
      "name": "entity.name.type.fibber",
      "match": "(?<![\\w.+*!?<>=/:-])(?:[A-Z][\\w*!?-]*|i8|i16|i32|i64|f32|f64|bool|str|char|unit)(?![\\w.+*!?<>=/:-])"
    },
    "namespaced": {
      "match": "(?<![\\w.+*!?<>=/:-])([A-Za-z_][\\w*!?<>=+.-]*)(/)(?=[^\\s/])",
      "captures": {
        "1": { "name": "entity.name.namespace.fibber" },
        "2": { "name": "punctuation.separator.namespace.fibber" }
      }
    },
    "collection": {
      "patterns": [
        { "name": "punctuation.section.collection.fibber", "match": "[()\\[\\]{}]" }
      ]
    }
  }
}
