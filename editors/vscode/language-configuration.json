{
  "comments": { "lineComment": ";" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "wordPattern": "[^\\s()\\[\\]{}\",;'`~@\\\\]+",
  "indentationRules": {
    "increaseIndentPattern": "^[^;]*\\((defun|defn|defmacro|defstruct|defenum|defprotocol|defrecord|impl|fn|let|loop|match|cond|do|if|when|ns)\\b[^()]*$",
    "decreaseIndentPattern": "^\\s*[)\\]}]"
  },
  "onEnterRules": [
    { "beforeText": "^\\s*\\(.*[^)\\]}]\\s*$", "action": { "indent": "indentOutdent" } }
  ]
}
