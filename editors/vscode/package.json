{
  "name": "fibber",
  "displayName": "fibber",
  "description": "Language support for fibber (.fib): syntax highlighting, brackets, comments and snippets.",
  "version": "0.1.0",
  "publisher": "tailoredshapes",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages", "Snippets"],
  "contributes": {
    "languages": [
      {
        "id": "fibber",
        "aliases": ["fibber", "Fibber"],
        "extensions": [".fib"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fibber",
        "scopeName": "source.fibber",
        "path": "./syntaxes/fibber.tmLanguage.json"
      }
    ],
    "snippets": [
      { "language": "fibber", "path": "./snippets/fibber.json" }
    ]
  }
}
