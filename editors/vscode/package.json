{
  "name": "fibber",
  "displayName": "fibber",
  "description": "Language support for fibber (.fib): syntax highlighting, brackets, snippets, and completion, hover, diagnostics, go to definition and document symbols from the real front end (fibc lsp).",
  "version": "0.2.0",
  "publisher": "tailoredshapes",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:fibber"
  ],
  "scripts": {
    "test": "node test/lsp.js",
    "test:host": "node test/host.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "fibber",
        "aliases": [
          "fibber",
          "Fibber"
        ],
        "extensions": [
          ".fib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fibber",
        "scopeName": "source.fibber",
        "path": "./syntaxes/fibber.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fibber",
        "path": "./snippets/fibber.json"
      }
    ],
    "commands": [
      {
        "command": "fibber.restartServer",
        "title": "Restart the language server",
        "category": "fibber"
      }
    ],
    "configuration": {
      "title": "fibber",
      "properties": {
        "fibber.serverPath": {
          "type": "string",
          "default": "fibc",
          "description": "The executable that runs the language server as `<path> lsp`: `fibc` (the default) or `fibref`."
        },
        "fibber.fibrefPath": {
          "type": "string",
          "default": "",
          "description": "Deprecated: an older name for fibber.serverPath. When set it is used instead of fibber.serverPath.",
          "deprecationMessage": "Use fibber.serverPath."
        },
        "fibber.libraryPath": {
          "type": "string",
          "default": "",
          "description": "Directories searched for library modules, as FIB_LIB (separated by the platform's path separator). Empty: only the library the server carries."
        },
        "fibber.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Directories passed to the server as -I, searched for modules before FIB_LIB."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tailoredshapes/fibber.git",
    "directory": "editors/vscode"
  }
}
