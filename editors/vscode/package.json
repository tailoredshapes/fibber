{
  "name": "fibber",
  "displayName": "fibber",
  "description": "Language support for fibber (.fib): syntax highlighting, brackets and snippets. No language server yet.",
  "version": "0.3.0",
  "publisher": "tailoredshapes",
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fibber",
        "aliases": [
          "fibber",
          "Fibber"
        ],
        "extensions": [
          ".fib"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fibber",
        "scopeName": "source.fibber",
        "path": "./syntaxes/fibber.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fibber",
        "path": "./snippets/fibber.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tailoredshapes/fibber.git",
    "directory": "editors/vscode"
  }
}
