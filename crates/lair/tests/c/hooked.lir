;; A macro-time module as fibm.set-hooks and fibm.gensym-hook make one
;; (crates/fibc/rt/core.lir, src/macros/abi.rs): the hooks and the context
;; in globals the module's code calls through, set by `install`. Shared by
;; tests/common/mod.rs (Rust consumer) and tests/c/consumer.c.
(global hook1 ptr (ptr null))
(global hook2 ptr (ptr null))
(global cx ptr (ptr null))
(global marker i64 (i64 0))
(global flag i64 (i64 0))
(define (install void) ((ptr h1) (ptr h2) (ptr c))
  (block entry (store h1 @hook1) (store h2 @hook2) (store c @cx) (ret)))
(define (ask1 i64) ((i64 x))
  (block entry
    (let ((h (load ptr @hook1)) (c (load ptr @cx)))
      (ret (indirect-call h (fn i64 (ptr i64)) c x)))))
(define (ask2 i64) ((i64 x) (i64 y))
  (block entry
    (let ((h (load ptr @hook2)) (c (load ptr @cx)))
      (ret (indirect-call h (fn i64 (ptr i64 i64)) c x y)))))
(define (one i64) ((i64 x)) (block entry (ret (add (call @ask1 x) (i64 1000000)))))
(define (two i64) ((i64 x) (i64 y)) (block entry (ret (add (call @ask2 x y) (i64 2000000)))))
(define (both i64) ((i64 x)) (block entry (ret (add (call @ask1 x) (call @ask2 x (i64 7))))))
(define (many i64) ((i64 n))
  (block entry (br head))
  (block head
    (let ((i (phi i64 (entry (i64 0)) (body i2)))
          (acc (phi i64 (entry (i64 0)) (body acc2))))
      (br (icmp slt i n) body exit)))
  (block body
    (let ((r (call @ask1 i))
          (acc2 (add acc r))
          (i2 (add i (i64 1))))
      (br head)))
  (block exit (ret acc)))
(define (mark_after i64) ((i64 x))
  (block entry (let ((r (call @ask1 x))) (store (i64 1) @marker) (ret r))))
(define (get_marker i64) () (block entry (ret (load i64 @marker))))
(define (seven i64) () (block entry (ret (i64 7))))
(define (set_flag i64) () (block entry (store (i64 1) @flag) (ret (i64 0))))
(define (spin_then_mark i64) ()
  (block entry (br head))
  (block head (br (icmp eq (atomicrmw add monotonic @flag (i64 0)) (i64 0)) head done))
  (block done (store (i64 1) @marker) (ret (i64 99))))
(define (ask1cx i64) ((ptr h) (ptr c) (i64 x))
  (block entry (ret (indirect-call h (fn i64 (ptr i64)) c x))))
;; Recursion that is not a loop: each level is a frame of the worker's stack.
(define (deep i64) ((i64 n))
  (block entry (br (icmp eq n (i64 0)) base more))
  (block base (ret (i64 0)))
  (block more (ret (add (call @deep (sub n (i64 1))) (i64 1)))))
(define (deep_ask i64) ((i64 n))
  (block entry (br (icmp eq n (i64 0)) base more))
  (block base (ret (call @ask1 (i64 7))))
  (block more (ret (add (call @deep_ask (sub n (i64 1))) (i64 1)))))
