;; fib.rt, strings (types §8.3): a str is the header, the byte length,
;; then the UTF-8 bytes and a NUL in the same allocation. Every
;; function allocates exactly where the interpreter's string natives do
;; (eval/strings.rs).
(define internal (fib.str-len i64) ((ptr s))
  (block entry (ret (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))))

(define internal (fib.str-bytes-ptr ptr) ((ptr s))
  (block entry (ret (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0)))))

;; A fresh str of n bytes (type id 0), NUL-terminated; the bytes are
;; the caller's to fill.
(define internal (fib.str-new ptr) ((i64 n))
  (block entry
    (let ((s (call @fib.alloc (add n (i64 25)) (i32 0))))
      (store n (getelementptr %struct.fib.str s (i32 0) (i32 3)))
      (store (i8 0) (getelementptr %struct.fib.str s (i32 0) (i32 4) n))
      (ret s))))

;; A fresh str of the n bytes at p.
(define internal (fib.str-from-bytes ptr) ((ptr p) (i64 n))
  (block entry
    (let ((s (call @fib.str-new n)))
      (call @memcpy (call @fib.str-bytes-ptr s) p n)
      (ret s))))

(define internal (fib.str-copy ptr) ((ptr s))
  (block entry
    (ret (call @fib.str-from-bytes (call @fib.str-bytes-ptr s) (call @fib.str-len s)))))

;; (hash s) on a str: 64-bit FNV-1a over the bytes (eval/arith.rs fnv).
(define internal (fib.str-hash i64) ((ptr s))
  (block entry
    (let ((p (call @fib.str-bytes-ptr s))
          (n (call @fib.str-len s)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2)))
          (h (phi i64 (entry (i64 -3750763034362895579)) (body h2))))
      (br (icmp slt i n) body done)))
  (block body
    (let ((b (zext i64 (load i8 (getelementptr i8 p i))))
          (h2 (mul (xor h b) (i64 1099511628211)))
          (i2 (add i (i64 1))))
      (br loop)))
  (block done (ret h)))

;; The native Show instances (types §2.12), each a fresh str with the
;; interpreter's text (eval/arith.rs show).
(define internal (fib.show-int ptr) ((i64 n))
  (block entry
    (let ((buf (alloca i8 (i32 24)))
          (len (call @snprintf buf (i64 24) (string "%lld") n)))
      (ret (call @fib.str-from-bytes buf (sext i64 len))))))

(define internal (fib.show-ptr ptr) ((ptr p))
  (block entry
    (let ((buf (alloca i8 (i32 24)))
          (len (call @snprintf buf (i64 24) (string "#ptr%llx") (ptrtoint i64 p))))
      (ret (call @fib.str-from-bytes buf (sext i64 len))))))

(define internal (fib.show-bool ptr) ((i1 b))
  (block entry (br b yes no))
  (block yes (ret (call @fib.str-from-bytes (string "true") (i64 4))))
  (block no (ret (call @fib.str-from-bytes (string "false") (i64 5)))))

;; show of a float (types §2.12): the shortest %e text that reads back
;; at the value's width, laid out positionally with .0 when integral;
;; NaN, inf, -inf. Written with the shortest digits into `out`.
(declare strtod double (ptr ptr))
(declare strtof float (ptr ptr))
(declare memset ptr (ptr i32 i64))

;; Whether the %e text in buf reads back to x, at single precision or
;; double.
(define internal (fib.fp-exact i1) ((ptr buf) (double x) (i1 single))
  (block entry (br single narrow wide))
  (block wide
    (ret (icmp eq (bitcast i64 (call @strtod buf (ptr null))) (bitcast i64 x))))
  (block narrow
    (ret (icmp eq (bitcast i32 (call @strtof buf (ptr null))) (bitcast i32 (fptrunc float x))))))

;; The digits of a %e text (no sign, no point) into digits, its
;; exponent into exp; returns the count of digits.
(define internal (fib.fp-parse i64) ((ptr buf) (ptr digits) (ptr exp))
  (block entry
    (let ((neg (icmp eq (load i8 buf) (i8 45)))
          (start (select neg (i64 1) (i64 0))))
      (br scan)))
  (block scan
    (let ((i (phi i64 (entry start) (skip i2) (keep i2)))
          (n (phi i64 (entry (i64 0)) (skip n) (keep n2)))
          (c (load i8 (getelementptr i8 buf i)))
          (i2 (add i (i64 1))))
      (br (icmp eq c (i8 101)) expo point?)))
  (block point? (br (icmp eq c (i8 46)) skip keep))
  (block keep
    (store c (getelementptr i8 digits n))
    (let ((n2 (add n (i64 1)))) (br scan)))
  (block skip (br scan))
  (block expo
    (let ((s (load i8 (getelementptr i8 buf i2)))
          (eneg (icmp eq s (i8 45)))
          (j0 (add i2 (i64 1))))
      (br eloop)))
  (block eloop
    (let ((j (phi i64 (expo j0) (edigit j2)))
          (e (phi i64 (expo (i64 0)) (edigit e2)))
          (d (load i8 (getelementptr i8 buf j))))
      (br (icmp eq d (i8 0)) edone edigit)))
  (block edigit
    (let ((e2 (add (mul e (i64 10)) (sext i64 (sub d (i8 48)))))
          (j2 (add j (i64 1))))
      (br eloop)))
  (block edone
    (store (select eneg (sub (i64 0) e) e) exp)
    (ret n)))

;; The positional text of the value d1.d2..dn x 10^e into out, with a
;; leading - when neg and .0 when integral; returns its length.
(define internal (fib.fp-layout i64) ((ptr out) (ptr digits) (i64 n) (i64 e) (i1 neg))
  (block entry
    (store (i8 45) out)
    (let ((o0 (select neg (i64 1) (i64 0)))
          (ef (add e (i64 1))))
      (br (icmp slt e (i64 0)) small big)))
  (block big
    (let ((ni (select (icmp slt n ef) n ef))
          (pad (sub ef ni))
          (o1 (add o0 ef)))
      (call @memcpy (getelementptr i8 out o0) digits ni)
      (call @memset (getelementptr i8 out (add o0 ni)) (i32 48) pad)
      (br (icmp sgt n ef) frac intg)))
  (block frac
    (let ((nf (sub n ef)))
      (store (i8 46) (getelementptr i8 out o1))
      (call @memcpy (getelementptr i8 out (add o1 (i64 1))) (getelementptr i8 digits ef) nf)
      (ret (add (add o1 (i64 1)) nf))))
  (block intg
    (store (i8 46) (getelementptr i8 out o1))
    (store (i8 48) (getelementptr i8 out (add o1 (i64 1))))
    (ret (add o1 (i64 2))))
  (block small
    (let ((z (sub (i64 -1) e))
          (o2 (add o0 (i64 2))))
      (store (i8 48) (getelementptr i8 out o0))
      (store (i8 46) (getelementptr i8 out (add o0 (i64 1))))
      (call @memset (getelementptr i8 out o2) (i32 48) z)
      (call @memcpy (getelementptr i8 out (add o2 z)) digits n)
      (ret (add (add o2 z) n)))))

(define internal (fib.show-fp ptr) ((double x) (i1 single))
  (block entry (br (fcmp uno x x) nan finite))
  (block nan (ret (call @fib.str-from-bytes (string "NaN") (i64 3))))
  (block finite
    (let ((buf (alloca i8 (i32 64)))
          (len0 (call @snprintf buf (i64 64) (string "%.0e") x))
          (c0 (load i8 buf))
          (c1 (load i8 (getelementptr i8 buf (i64 1)))))
      (br (or (icmp eq c0 (i8 105)) (icmp eq c1 (i8 105))) inf search)))
  (block inf (ret (call @fib.str-from-bytes buf (sext i64 len0))))
  (block search
    (let ((p (phi i32 (finite (i32 0)) (more p2))))
      (call @snprintf buf (i64 64) (string "%.*e") p x)
      (br (call @fib.fp-exact buf x single) found more)))
  (block more
    (let ((p2 (add p (i32 1))))
      (br (icmp sgt p2 (i32 17)) found search)))
  (block found
    (let ((digits (alloca i8 (i32 32)))
          (exp (alloca i64))
          (out (alloca i8 (i32 400)))
          (n (call @fib.fp-parse buf digits exp))
          (neg (icmp eq (load i8 buf) (i8 45)))
          (m (call @fib.fp-layout out digits n (load i64 exp) neg)))
      (ret (call @fib.str-from-bytes out m)))))

(define internal (fib.show-double ptr) ((double x))
  (block entry (ret (call @fib.show-fp x (i1 0)))))

(define internal (fib.show-float ptr) ((float x))
  (block entry (ret (call @fib.show-fp (fpext double x) (i1 1)))))

;; The UTF-8 encoding of the scalar value c.
(define internal (fib.show-char ptr) ((i32 c))
  (block entry
    (let ((buf (alloca i8 (i32 4))))
      (br (icmp slt c (i32 128)) one more1)))
  (block one
    (store (trunc i8 c) buf)
    (ret (call @fib.str-from-bytes buf (i64 1))))
  (block more1 (br (icmp slt c (i32 2048)) two more2))
  (block two
    (store (trunc i8 (or (lshr c (i32 6)) (i32 192))) buf)
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (ret (call @fib.str-from-bytes buf (i64 2))))
  (block more2 (br (icmp slt c (i32 65536)) three four))
  (block three
    (store (trunc i8 (or (lshr c (i32 12)) (i32 224))) buf)
    (store (trunc i8 (or (and (lshr c (i32 6)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 2)))
    (ret (call @fib.str-from-bytes buf (i64 3))))
  (block four
    (store (trunc i8 (or (lshr c (i32 18)) (i32 240))) buf)
    (store (trunc i8 (or (and (lshr c (i32 12)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (store (trunc i8 (or (and (lshr c (i32 6)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 2)))
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 3)))
    (ret (call @fib.str-from-bytes buf (i64 4)))))

(define internal (fib.str-cmp i32) ((ptr a) (ptr b))
  (block entry
    (let ((na (call @fib.str-len a))
          (nb (call @fib.str-len b))
          (n (select (icmp slt na nb) na nb))
          (c (call @memcmp (call @fib.str-bytes-ptr a) (call @fib.str-bytes-ptr b) n)))
      (br (icmp ne c (i32 0)) differ prefix)))
  (block differ (ret c))
  (block prefix (ret (select (icmp slt na nb) (i32 -1) (select (icmp sgt na nb) (i32 1) (i32 0))))))

(define internal (fib.str-eq i1) ((ptr a) (ptr b))
  (block entry (ret (icmp eq (call @fib.str-cmp a b) (i32 0)))))

(define internal (fib.str-starts-with i1) ((ptr s) (ptr prefix))
  (block entry
    (let ((n (call @fib.str-len s))
          (m (call @fib.str-len prefix)))
      (br (icmp sgt m n) no cmp)))
  (block no (ret (i1 0)))
  (block cmp (ret (icmp eq (call @memcmp (call @fib.str-bytes-ptr s) (call @fib.str-bytes-ptr prefix) m) (i32 0)))))

(define internal (fib.str-concat ptr) ((ptr a) (ptr b))
  (block entry
    (let ((na (call @fib.str-len a))
          (nb (call @fib.str-len b))
          (s (call @fib.str-new (add na nb)))
          (d (call @fib.str-bytes-ptr s)))
      (call @memcpy d (call @fib.str-bytes-ptr a) na)
      (call @memcpy (getelementptr i8 d na) (call @fib.str-bytes-ptr b) nb)
      (ret s))))

;; The interpreter's traps for a bad slice (eval/strings.rs).
(define internal (fib.str-slice ptr) ((ptr s) (i64 i) (i64 j))
  (block entry
    (let ((n (call @fib.str-len s))
          (bad (or (icmp slt i (i64 0)) (or (icmp sgt i j) (icmp sgt j n)))))
      (br bad range check-i)))
  (block range
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string "str-slice [%lld, %lld) out of range 0..%lld") i j n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block check-i
    (let ((p (call @fib.str-bytes-ptr s)))
      (br (call @fib.splits-char p i n) split check-j)))
  (block check-j (br (call @fib.splits-char p j n) split ok))
  (block split
    (let ((buf2 (alloca i8 (i32 96)))
          (len2 (call @snprintf buf2 (i64 96) (string "str-slice [%lld, %lld) splits a character") i j)))
      (call @fib.trap-bytes buf2 (sext i64 len2))
      (unreachable)))
  (block ok
    (let ((m (sub j i))
          (r (call @fib.str-new m)))
      (call @memcpy (call @fib.str-bytes-ptr r) (getelementptr i8 p i) m)
      (ret r))))

;; Whether byte k of a string of n bytes is a UTF-8 continuation byte
;; (10xxxxxx): a boundary there splits a character.
(define internal (fib.splits-char i1) ((ptr p) (i64 k) (i64 n))
  (block entry (br (icmp sge k n) no test))
  (block no (ret (i1 0)))
  (block test (ret (icmp eq (and (load i8 (getelementptr i8 p k)) (i8 -64)) (i8 -128)))))

;; (str-bytes s): a fresh (Array i8) of the bytes.
(define internal (fib.str-bytes ptr) ((ptr s) (i32 tid))
  (block entry
    (let ((n (call @fib.str-len s))
          (a (call @fib.array-alloc n tid (i64 1))))
      (call @memcpy (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)) (call @fib.str-bytes-ptr s) n)
      (ret a))))

;; Whether byte j of the n at p exists and lies in lo..=hi.
(define internal (fib.utf8-cont i1) ((ptr p) (i64 n) (i64 j) (i32 lo) (i32 hi))
  (block entry (br (icmp sge j n) no test))
  (block no (ret (i1 0)))
  (block test
    (let ((b (zext i32 (load i8 (getelementptr i8 p j)))))
      (ret (and (icmp sge b lo) (icmp sle b hi))))))

;; Whether the n bytes at p are UTF-8: the shortest encodings of the
;; scalar values, as Rust's from_utf8 checks them (the interpreter's
;; rule for str-from-bytes).
(define internal (fib.utf8-valid i1) ((ptr p) (i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (adv inext))))
      (br (icmp sge i n) ok head)))
  (block head
    (let ((b (zext i32 (load i8 (getelementptr i8 p i)))))
      (br (icmp slt b (i32 128)) one two?)))
  (block one (let ((s1 (add i (i64 1)))) (br adv)))
  (block two? (br (and (icmp sge b (i32 194)) (icmp sle b (i32 223))) two three?))
  (block two
    (let ((s2 (add i (i64 2))))
      (br (call @fib.utf8-cont p n (add i (i64 1)) (i32 128) (i32 191)) adv bad)))
  (block three? (br (and (icmp sge b (i32 224)) (icmp sle b (i32 239))) three four?))
  (block three
    (let ((s3 (add i (i64 3)))
          (lo (select (icmp eq b (i32 224)) (i32 160) (i32 128)))
          (hi (select (icmp eq b (i32 237)) (i32 159) (i32 191))))
      (br (and (call @fib.utf8-cont p n (add i (i64 1)) lo hi)
               (call @fib.utf8-cont p n (add i (i64 2)) (i32 128) (i32 191)))
          adv bad)))
  (block four? (br (and (icmp sge b (i32 240)) (icmp sle b (i32 244))) four bad))
  (block four
    (let ((s4 (add i (i64 4)))
          (lo4 (select (icmp eq b (i32 240)) (i32 144) (i32 128)))
          (hi4 (select (icmp eq b (i32 244)) (i32 143) (i32 191))))
      (br (and (call @fib.utf8-cont p n (add i (i64 1)) lo4 hi4)
               (and (call @fib.utf8-cont p n (add i (i64 2)) (i32 128) (i32 191))
                    (call @fib.utf8-cont p n (add i (i64 3)) (i32 128) (i32 191))))
          adv bad)))
  (block adv
    (let ((inext (phi i64 (one s1) (two s2) (three s3) (four s4))))
      (br loop)))
  (block ok (ret (i1 1)))
  (block bad (ret (i1 0))))

;; (str-from-bytes a): a fresh str of the array's bytes, which must be
;; UTF-8 (the interpreter traps with the same message).
(define internal (fib.str-from-array ptr) ((ptr arr))
  (block entry
    (let ((n (load i64 (getelementptr %struct.fib.array.i8 arr (i32 0) (i32 3))))
          (p (getelementptr %struct.fib.array.i8 arr (i32 0) (i32 4) (i64 0))))
      (br (call @fib.utf8-valid p n) ok bad)))
  (block ok (ret (call @fib.str-from-bytes p n)))
  (block bad
    (call @fib.trap-c (string "str-from-bytes: invalid UTF-8"))
    (unreachable)))

;; (i32->char n): traps unless n is a Unicode scalar value.
(define internal (fib.i32-to-char i32) ((i32 n))
  (block entry
    (let ((neg (icmp slt n (i32 0)))
          (surrogate (and (icmp sge n (i32 55296)) (icmp sle n (i32 57343))))
          (big (icmp sgt n (i32 1114111))))
      (br (or neg (or surrogate big)) bad ok)))
  (block bad
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string "i32->char of %d, not a Unicode scalar value") n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok (ret n)))
