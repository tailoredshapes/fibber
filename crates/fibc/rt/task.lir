;; fib.rt, tasks (types §8.8): the run queue, the pool of workers that
;; take tasks from it, the joiners that drive it too, parking at an
;; await and the wake at a completion. A task's state word: 0 pending
;; (never resumed), 1 running or queued, 2 done, 3 parked (registered
;; as a waiter of another task). Its driver word: 0 free, 1 claimed;
;; resume runs only under a claim, and a task in state 3 is never
;; resumed until its wake sets 1 and queues it.
(declare sysconf i64 (i32))
(global internal fib.rq-head ptr (ptr null))
(global internal fib.rq-tail ptr (ptr null))
(global internal fib.rq-lock i32 (i32 0))
(global internal fib.pool-started i32 (i32 0))

;; A queue node: task, next.
(define internal (fib.enqueue void) ((ptr task))
  (block entry
    (let ((node (call @malloc (i64 16))))
      (store task node)
      (store (ptr null) (getelementptr i8 node (i64 8)))
      (call @fib.lock @fib.rq-lock)
      (br (icmp eq (load ptr @fib.rq-tail) (ptr null)) first append)))
  (block first
    (store node @fib.rq-head)
    (store node @fib.rq-tail)
    (call @fib.unlock @fib.rq-lock)
    (call @fib.pool-start)
    (ret))
  (block append
    (store node (getelementptr i8 (load ptr @fib.rq-tail) (i64 8)))
    (store node @fib.rq-tail)
    (call @fib.unlock @fib.rq-lock)
    (ret)))

;; The task at the head of the queue, or null.
(define internal (fib.dequeue ptr) ()
  (block entry
    (call @fib.lock @fib.rq-lock)
    (let ((node (load ptr @fib.rq-head)))
      (br (icmp eq node (ptr null)) empty take)))
  (block empty (call @fib.unlock @fib.rq-lock) (ret (ptr null)))
  (block take
    (let ((next (load ptr (getelementptr i8 node (i64 8))))
          (task (load ptr node)))
      (store next @fib.rq-head)
      (br (icmp eq next (ptr null)) last more)))
  (block last (store (ptr null) @fib.rq-tail) (br out))
  (block more (br out))
  (block out
    (call @fib.unlock @fib.rq-lock)
    (call @free node)
    (ret task)))

;; Starts the workers once, on the first enqueue: one per processor,
;; and a T line in trace mode (compiler.md §4), since from here on the
;; program's allocations interleave with the workers'.
(define internal (fib.pool-start void) ()
  (block entry
    (let ((r (cmpxchg acq_rel acquire @fib.pool-started (i32 0) (i32 1))))
      (br (extractvalue r 1) start done)))
  (block start
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced spawn))
  (block traced (call @write (i32 2) (string "T\n") (i64 2)) (br spawn))
  (block spawn
    (let ((n0 (call @sysconf (i32 84)))
          (n (select (icmp slt n0 (i64 1)) (i64 1) n0)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (spawn (i64 0)) (next i2))))
      (br (icmp slt i n) one done)))
  (block one
    (let ((handle (alloca i64))
          (rc (call @pthread_create handle (ptr null) @fib.worker (ptr null))))
      (br (icmp ne rc (i32 0)) failed next)))
  (block failed
    (call @fib.trap-c (string "async: cannot start a worker thread"))
    (unreachable))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block done (ret)))

;; A worker: runs whatever the queue holds, yielding when it is empty.
(define internal (fib.worker ptr) ((ptr arg))
  (block entry (br loop))
  (block loop
    (let ((t (call @fib.dequeue)))
      (br (icmp eq t (ptr null)) idle run)))
  (block idle (call @sched_yield) (br loop))
  (block run (call @fib.run-one t) (br loop)))

;; Runs a queued task under a claim of its driver; a task whose driver
;; is still held goes back on the queue; one a joiner drove meanwhile
;; to its completion or to a park is left alone. The queue's count on
;; the task is released afterwards.
(define internal (fib.run-one void) ((ptr t))
  (block entry
    (let ((dp (getelementptr %struct.fib.task t (i32 0) (i32 4)))
          (r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed busy)))
  (block busy (call @sched_yield) (call @fib.enqueue t) (ret))
  (block claimed
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task t (i32 0) (i32 3))) (i32 1)) resume unclaim))
  (block resume
    (indirect-call (load ptr (getelementptr %struct.fib.task t (i32 0) (i32 6))) (fn void (ptr)) t)
    (br unclaim))
  (block unclaim
    (atomic-store release (i32 0) dp)
    (call @fib.release t)
    (ret)))

;; join/block-on (§8.8): drives the executor until the task is done,
;; resuming the task itself when it can claim it, running other queued
;; tasks meanwhile, yielding when there is nothing to run.
(define internal (fib.drive void) ((ptr task))
  (block entry
    (let ((sp (getelementptr %struct.fib.task task (i32 0) (i32 3)))
          (dp (getelementptr %struct.fib.task task (i32 0) (i32 4))))
      (br loop)))
  (block loop
    (br (icmp eq (atomic-load acquire i32 sp) (i32 2)) done claim))
  (block claim
    (let ((r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed other)))
  (block claimed
    (let ((s (atomic-load acquire i32 sp)))
      (br (icmp eq s (i32 2)) unclaim-done check-parked)))
  (block check-parked (br (icmp eq s (i32 3)) parked resume))
  (block unclaim-done (atomic-store release (i32 0) dp) (ret))
  (block resume
    (atomic-store release (i32 1) sp)
    (indirect-call (load ptr (getelementptr %struct.fib.task task (i32 0) (i32 6))) (fn void (ptr)) task)
    (atomic-store release (i32 0) dp)
    (br loop))
  (block parked (atomic-store release (i32 0) dp) (br other))
  (block other
    (let ((u (call @fib.dequeue)))
      (br (icmp eq u (ptr null)) idle run)))
  (block idle (call @sched_yield) (br loop))
  (block run (call @fib.run-one u) (br loop))
  (block done (ret)))

;; `await e` from the running task `self`: 0 when `e` is done (the
;; result can be read at once), else `self` is registered as a waiter
;; of `e`, marked parked, and 1 says return from the resume. A pending
;; `e` is queued so that a worker or a joiner starts it (syntax §3.12:
;; the executor runs a task when it is awaited).
(define internal (fib.await-or-park i1) ((ptr self) (ptr e))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task e (i32 0) (i32 5)))
          (sp (getelementptr %struct.fib.task e (i32 0) (i32 3))))
      (call @fib.lock lockp)
      (let ((s (atomic-load acquire i32 sp)))
        (br (icmp eq s (i32 2)) done pending?))))
  (block done (call @fib.unlock lockp) (ret (i1 0)))
  (block pending? (br (icmp eq s (i32 0)) start register))
  (block start
    (atomic-store release (i32 1) sp)
    (call @fib.retain e)
    (call @fib.enqueue e)
    (br register))
  (block register
    (let ((node (call @malloc (i64 16)))
          (wp (getelementptr %struct.fib.task e (i32 0) (i32 8))))
      (call @fib.retain self)
      (store self node)
      (store (load ptr wp) (getelementptr i8 node (i64 8)))
      (store node wp)
      (atomic-store release (i32 3) (getelementptr %struct.fib.task self (i32 0) (i32 3)))
      (call @fib.unlock lockp)
      (ret (i1 1)))))

;; Completion (§8.8): state done, then every waiter is woken: marked
;; runnable and queued, the registration's count passing to the queue.
(define internal (fib.task-complete void) ((ptr task))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task task (i32 0) (i32 5)))
          (wp (getelementptr %struct.fib.task task (i32 0) (i32 8))))
      (atomic-store release (i32 2) (getelementptr %struct.fib.task task (i32 0) (i32 3)))
      (call @fib.lock lockp)
      (let ((list (load ptr wp)))
        (store (ptr null) wp)
        (call @fib.unlock lockp)
        (br wake))))
  (block wake
    (let ((node (phi ptr (entry list) (woken next))))
      (br (icmp eq node (ptr null)) done woken)))
  (block woken
    (let ((w (load ptr node))
          (next (load ptr (getelementptr i8 node (i64 8)))))
      (call @free node)
      (atomic-store release (i32 1) (getelementptr %struct.fib.task w (i32 0) (i32 3)))
      (call @fib.enqueue w)
      (br wake)))
  (block done (ret)))

;; Waits for a task to be done, yielding meanwhile.
(define internal (fib.wait-done void) ((ptr task))
  (block entry (br spin))
  (block spin
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task task (i32 0) (i32 3))) (i32 2)) done wait))
  (block wait (call @sched_yield) (br spin))
  (block done (ret)))
