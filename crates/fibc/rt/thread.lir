;; fib.rt, threads (types §8.8): a spawned task runs on an OS thread of
;; its own (pthreads); the threads are kept in a list so that main's
;; return joins every one still running. A join waits for the task's
;; state to become done, yielding meanwhile.
(declare pthread_create i32 (ptr ptr ptr ptr))
(declare pthread_join i32 (i64 ptr))
(global internal fib.threads ptr (ptr null))
(global internal fib.threads-lock i32 (i32 0))

;; States of a task's state word.
;; 1 running, 2 done.

;; Starts entry(task) on a new thread and records it; in trace mode
;; writes the T line (compiler.md §4).
(define internal (fib.spawn void) ((ptr task) (ptr entry))
  (block entry
    (let ((node (call @malloc (i64 16)))
          (rc (call @pthread_create node (ptr null) entry task)))
      (br (icmp ne rc (i32 0)) failed started)))
  (block failed
    (call @fib.trap-c (string "spawn: cannot start a thread"))
    (unreachable))
  (block started
    (call @fib.lock @fib.threads-lock)
    (store (load ptr @fib.threads) (getelementptr i8 node (i64 8)))
    (store node @fib.threads)
    (call @fib.unlock @fib.threads-lock)
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced done))
  (block traced (call @write (i32 2) (string "T\n") (i64 2)) (br done))
  (block done (ret)))

(define internal (fib.task-complete void) ((ptr task))
  (block entry
    (atomic-store release (i32 2) (getelementptr %struct.fib.task task (i32 0) (i32 3)))
    (ret)))

(define internal (fib.wait-done void) ((ptr task))
  (block entry (br spin))
  (block spin
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task task (i32 0) (i32 3))) (i32 2)) done wait))
  (block wait (call @sched_yield) (br spin))
  (block done (ret)))

;; Joins every thread started so far, including those started while
;; joining.
(define internal (fib.join-all void) ()
  (block entry (br next))
  (block next
    (call @fib.lock @fib.threads-lock)
    (let ((node (load ptr @fib.threads)))
      (br (icmp eq node (ptr null)) empty take)))
  (block empty (call @fib.unlock @fib.threads-lock) (ret))
  (block take
    (store (load ptr (getelementptr i8 node (i64 8))) @fib.threads)
    (call @fib.unlock @fib.threads-lock)
    (call @pthread_join (load i64 node) (ptr null))
    (call @free node)
    (br next)))

;; join/await (§8.8): claim the driver; a pending task is resumed on
;; this thread through its resume function; otherwise wait for done.
(define internal (fib.drive void) ((ptr task))
  (block entry
    (let ((dp (getelementptr %struct.fib.task task (i32 0) (i32 4)))
          (r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed wait)))
  (block claimed
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task task (i32 0) (i32 3))) (i32 0)) resume wait))
  (block resume
    (indirect-call (load ptr (getelementptr %struct.fib.task task (i32 0) (i32 6))) (fn void (ptr)) task)
    (atomic-store release (i32 0) dp)
    (ret))
  (block wait (call @fib.wait-done task) (ret)))
