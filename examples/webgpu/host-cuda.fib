;; examples/webgpu/host-cuda.fib: the CUDA host of the same kernels (docs/design/webgpu.md 6): hostrun.fib over `cuda/platform`, the driver fib-gpu-cuda v0.1.0.
;;   fibc build examples/webgpu/host-cuda.fib -I examples/webgpu -I fib-gpu-cuda/src -o host-cuda; host-cuda KERNELS.ptx
;; where KERNELS.ptx is `fibc build --target nvptx64-nvidia-cuda --emit ptx examples/webgpu/kernels.fib` (the kernel-sig header is the launch ABI).
(ns main (:use fib.core fib.seq fib.coll) (:require [cuda :as g] [hostrun :as h]))

(defun main () -> i64
  (let [a (args)]
    (if (< (count a) 1)
        (do (println "usage: host-cuda KERNELS.ptx") 2)
        (match (try-slurp (nth a 0))
          ((Err e) (do (println (str "cannot read " (nth a 0) ": " e)) 2))
          ((Ok ptx) (h/report (h/run-all (g/platform) (str-bytes ptx) true)))))))
