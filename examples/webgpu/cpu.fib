;; examples/webgpu/cpu.fib: the CPU run of the one-language guard (docs/design/webgpu.md 6): the hash of each reference result of refs.fib, the lines every
;; backend's run (hostrun.fib) must repeat. `fibc run examples/webgpu/cpu.fib -I examples/webgpu`.
(ns main (:require [refs :as k]))

(defun main () -> i64
  (let ((a (k/fill-f32 k/VADD-N 1)) (b (k/fill-f32 k/VADD-N 2)) (ai (k/fill-i32 k/VADD-N 3)) (bi (k/fill-i32 k/VADD-N 4))
        (ga (k/fill-f32 (* k/GEMM-N k/GEMM-N) 5)) (gb (k/fill-f32 (* k/GEMM-N k/GEMM-N) 6)))
    (do (println (str "vadd " k/VADD-N " " (k/hash-f32 (k/vadd-ref a b))))
        (println (str "vaddi " k/VADD-N " " (k/hash-i32 (k/vaddi-ref ai bi))))
        (println (str "gemm " k/GEMM-N " " (k/hash-f32 (k/gemm-ref ga gb k/GEMM-N))))
        0)))
