;; Run: ./F run examples/sudoku.fib -- examples/sudoku/test.txt
(ns main (:require [sudoku.solver :as s]))
(defun main () -> i64
  (let ((arguments (args)))
    (do (when (!= (count arguments) 1) (trap "usage: sudoku <puzzle-file>"))
        (let ((hints (s/parse-hints
                       (match (read-file (nth arguments 0))
                         ((some text) text)
                         (nil (trap "sudoku: cannot read puzzle file")))))
              (start (sys-clock-now))
              (answers (s/sudokufd hints)) (elapsed (- (sys-clock-now) start)))
          (do (println "Solutions: " (count answers) "; solve ns: " elapsed)
              (when (> (count answers) 0)
                (do (when (not (s/valid-solution? hints (nth answers 0))) (trap "sudoku: invalid solution"))
                    (dotimes (row 9) (println (to-vec (take 9 (drop (* row 9) (nth answers 0))))))))
              0)))))
