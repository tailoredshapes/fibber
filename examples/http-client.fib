;; F build examples/http-client.fib -I lib -o /tmp/http-client
;; FIB_HTTP_URL=http://127.0.0.1:8080/ /tmp/http-client     (http only: https needs the TLS package)
(ns main (:use fib.core fib.seq fib.coll fib.print)
  (:require [fib.http :as h] [fib.http.client :as c] [fib.os.environment :as os]))
(defun main () -> i64
  (match (c/get (unwrap-or (os/getenv "FIB_HTTP_URL") "http://127.0.0.1:8080/"))
    ((Err error) (do (eprintln (h/error-message error)) 1))
    ((Ok response) (do (println "Status:" (. response status))
      (match (h/body-text response) ((Ok text) (println text)) ((Err _) (println "Binary body bytes:" (array-len (. response body))))) 0))))
