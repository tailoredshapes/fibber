;; examples/gpu/kernels.fib: the kernels of fibber's GPU examples, in the kernel subset (docs/design/gpu.md 3; spec/syntax.md 3.22): vector add,
;; an f32 GEMM tiled in registers, the same GEMM staged through block-shared memory, and a device-side assert.
;;   fibc build --target nvptx64-nvidia-cuda --emit ptx examples/gpu/kernels.fib -o kernels.ptx     writes their PTX (and the signature header)
;;   fibc run examples/gpu/gpu.fib -I examples/gpu                                                 runs them on the host (the one-language guard)
;; The host side on a GPU is fib-gpu-cuda's examples (the driver repository), which load the PTX and launch `vadd`, `gemm`, `gemm_smem` and
;; `assert_positive` by name. `defkernel` is a core form: the body is checked by own.kernel (no allocation, no task, no string, no closure, no
;; recursion, no Simd value), and the same function compiles for the host, where `gpu/global-id` is the index `fib.gpu/host-launch` is running.
(ns kernels (:require [fib.gpu :as gpu]))

;; c[i] = a[i] + b[i] for i below n: one thread per element, the grid sized by the host.
(defkernel vadd (a: ptr b: ptr c: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n)
      (gpu/f32-set! c i (+ (gpu/f32-at a i) (gpu/f32-at b i))))))

;; C = A*B, row major, square n: each thread computes a 4x4 tile of C from registers (16 accumulators), reading A's four rows and B's
;; four columns from global memory through the cache: a register-tiled kernel with no shared memory. The grid is (n/4) x (n/4) threads in
;; blocks of 16x16 (the host sizes it); n is a multiple of 4.
;; Every product is `simd/fma`-exact (the scalar form of the builtin: f32 is a Float): a fused multiply-add per element per k, in increasing k, as the CPU's `fma-reference`.
(defkernel gemm (a: ptr b: ptr c: ptr n: i64)
  (let ((col (unchecked-multiply 4 (gpu/global-id 0)))
        (row (unchecked-multiply 4 (gpu/global-id 1))))
    (when (and (< row n) (< col n))
      (let ((a0 (unchecked-multiply row n)) (a1 (unchecked-add a0 n)) (a2 (unchecked-add a1 n)) (a3 (unchecked-add a2 n)))
        (loop ((k 0)
               (c00 0.0f32) (c01 0.0f32) (c02 0.0f32) (c03 0.0f32)
               (c10 0.0f32) (c11 0.0f32) (c12 0.0f32) (c13 0.0f32)
               (c20 0.0f32) (c21 0.0f32) (c22 0.0f32) (c23 0.0f32)
               (c30 0.0f32) (c31 0.0f32) (c32 0.0f32) (c33 0.0f32))
          (if (< k n)
              (let ((bk (unchecked-add (unchecked-multiply k n) col))
                    (b0 (gpu/f32-at b bk)) (b1 (gpu/f32-at b (unchecked-add bk 1)))
                    (b2 (gpu/f32-at b (unchecked-add bk 2))) (b3 (gpu/f32-at b (unchecked-add bk 3)))
                    (x0 (gpu/f32-at a (unchecked-add a0 k))) (x1 (gpu/f32-at a (unchecked-add a1 k)))
                    (x2 (gpu/f32-at a (unchecked-add a2 k))) (x3 (gpu/f32-at a (unchecked-add a3 k))))
                (recur (unchecked-add k 1)
                       (simd/fma x0 b0 c00) (simd/fma x0 b1 c01) (simd/fma x0 b2 c02) (simd/fma x0 b3 c03)
                       (simd/fma x1 b0 c10) (simd/fma x1 b1 c11) (simd/fma x1 b2 c12) (simd/fma x1 b3 c13)
                       (simd/fma x2 b0 c20) (simd/fma x2 b1 c21) (simd/fma x2 b2 c22) (simd/fma x2 b3 c23)
                       (simd/fma x3 b0 c30) (simd/fma x3 b1 c31) (simd/fma x3 b2 c32) (simd/fma x3 b3 c33)))
              (store-tile c n row col c00 c01 c02 c03 c10 c11 c12 c13 c20 c21 c22 c23 c30 c31 c32 c33)))))))

;; The 4x4 tile at (row, col) of C, stored: a device function (in the subset, reached from both GEMMs).
(defun store-tile (c: ptr n: i64 row: i64 col: i64
                   c00: f32 c01: f32 c02: f32 c03: f32 c10: f32 c11: f32 c12: f32 c13: f32
                   c20: f32 c21: f32 c22: f32 c23: f32 c30: f32 c31: f32 c32: f32 c33: f32) -> unit
  (let ((r0 (unchecked-add (unchecked-multiply row n) col)) (r1 (unchecked-add r0 n)) (r2 (unchecked-add r1 n)) (r3 (unchecked-add r2 n)))
    (do (gpu/f32-set! c r0 c00) (gpu/f32-set! c (unchecked-add r0 1) c01) (gpu/f32-set! c (unchecked-add r0 2) c02) (gpu/f32-set! c (unchecked-add r0 3) c03)
        (gpu/f32-set! c r1 c10) (gpu/f32-set! c (unchecked-add r1 1) c11) (gpu/f32-set! c (unchecked-add r1 2) c12) (gpu/f32-set! c (unchecked-add r1 3) c13)
        (gpu/f32-set! c r2 c20) (gpu/f32-set! c (unchecked-add r2 1) c21) (gpu/f32-set! c (unchecked-add r2 2) c22) (gpu/f32-set! c (unchecked-add r2 3) c23)
        (gpu/f32-set! c r3 c30) (gpu/f32-set! c (unchecked-add r3 1) c31) (gpu/f32-set! c (unchecked-add r3 2) c32) (gpu/f32-set! c (unchecked-add r3 3) c33))))

;; The same GEMM staged through block-shared memory (docs/design/gpu.md 6, item 3): a block of 256 threads computes a 64x64 tile of C; for each
;; slice of 16 k's the block loads a 64x16 slice of A and a 16x64 slice of B into shared memory (4 elements per thread), waits at the barrier,
;; and each thread takes its 4x4 micro-tile's 16 fmas per k from shared memory (`tile-step`), then a barrier before the next slice is loaded.
;; The accumulators are cells of f32 (a kernel may hold scalar cells: stack slots the emitter makes, registers after LLVM), so the k loop
;; is a plain counted loop of 16 that LLVM unrolls. The grid is (n/64) x (n/64) blocks of 256 (one dimension); n is a multiple of 64. The
;; sum per element is in increasing k, so the result is bit for bit `gemm`'s and the CPU's. Launched on the host (`host-launch`) it does
;; NOT reproduce: a thread needs the slice the other 255 loaded before the barrier (gpu.md 3.5).
(defkernel gemm-smem (a: ptr b: ptr c: ptr n: i64)
  (let ((as (gpu/shared :f32 1024)) (bs (gpu/shared :f32 1024))
        (tid (gpu/local-id 0)) (xa (unchecked-multiply 4 (quot (gpu/local-id 0) 16))) (xb (unchecked-multiply 4 (rem (gpu/local-id 0) 16)))
        (row0 (unchecked-multiply 64 (gpu/group-id 1))) (col0 (unchecked-multiply 64 (gpu/group-id 0)))
        (c00 (cell 0.0f32)) (c01 (cell 0.0f32)) (c02 (cell 0.0f32)) (c03 (cell 0.0f32))
        (c10 (cell 0.0f32)) (c11 (cell 0.0f32)) (c12 (cell 0.0f32)) (c13 (cell 0.0f32))
        (c20 (cell 0.0f32)) (c21 (cell 0.0f32)) (c22 (cell 0.0f32)) (c23 (cell 0.0f32))
        (c30 (cell 0.0f32)) (c31 (cell 0.0f32)) (c32 (cell 0.0f32)) (c33 (cell 0.0f32)))
    (do (loop ((k0 0))
          (when (< k0 n)
            (do (load-slices as bs a b n tid row0 col0 k0)
                (gpu/barrier)
                (loop ((k 0))
                  (when (< k 16)
                    (let ((ka (unchecked-add (unchecked-multiply k 64) xa)) (kb (unchecked-add (unchecked-multiply k 64) xb))
                          (x0 (gpu/f32-at as ka)) (x1 (gpu/f32-at as (unchecked-add ka 1))) (x2 (gpu/f32-at as (unchecked-add ka 2))) (x3 (gpu/f32-at as (unchecked-add ka 3)))
                          (b0 (gpu/f32-at bs kb)) (b1 (gpu/f32-at bs (unchecked-add kb 1))) (b2 (gpu/f32-at bs (unchecked-add kb 2))) (b3 (gpu/f32-at bs (unchecked-add kb 3))))
                      (do (set! c00 (simd/fma x0 b0 @c00)) (set! c01 (simd/fma x0 b1 @c01)) (set! c02 (simd/fma x0 b2 @c02)) (set! c03 (simd/fma x0 b3 @c03))
                          (set! c10 (simd/fma x1 b0 @c10)) (set! c11 (simd/fma x1 b1 @c11)) (set! c12 (simd/fma x1 b2 @c12)) (set! c13 (simd/fma x1 b3 @c13))
                          (set! c20 (simd/fma x2 b0 @c20)) (set! c21 (simd/fma x2 b1 @c21)) (set! c22 (simd/fma x2 b2 @c22)) (set! c23 (simd/fma x2 b3 @c23))
                          (set! c30 (simd/fma x3 b0 @c30)) (set! c31 (simd/fma x3 b1 @c31)) (set! c32 (simd/fma x3 b2 @c32)) (set! c33 (simd/fma x3 b3 @c33))
                          (recur (unchecked-add k 1))))))
                (gpu/barrier)
                (recur (unchecked-add k0 16)))))
        (store-tile c n (unchecked-add row0 xa) (unchecked-add col0 xb)
                    @c00 @c01 @c02 @c03 @c10 @c11 @c12 @c13 @c20 @c21 @c22 @c23 @c30 @c31 @c32 @c33))))

;; The block's 256 threads load a 64x16 slice of A (as[k*64 + r]) and a 16x64 slice of B (bs[k*64 + c]) for the k's from k0: 4 elements of each per thread.
(defun load-slices (as: ptr bs: ptr a: ptr b: ptr n: i64 tid: i64 row0: i64 col0: i64 k0: i64) -> unit
  (loop ((e tid))
    (when (< e 1024)
      (let ((r (quot e 16)) (k (rem e 16)) (kb (quot e 64)) (cb (rem e 64)))
        (do (gpu/f32-set! as (unchecked-add (unchecked-multiply k 64) r) (gpu/f32-at a (unchecked-add (unchecked-multiply (unchecked-add row0 r) n) (unchecked-add k0 k))))
            (gpu/f32-set! bs (unchecked-add (unchecked-multiply kb 64) cb) (gpu/f32-at b (unchecked-add (unchecked-multiply (unchecked-add k0 kb) n) (unchecked-add col0 cb))))
            (recur (unchecked-add e 256)))))))

;; A device-side assert: every element of `a` must be positive, else the kernel traps (`trap`: the runtime's trap entry becomes `llvm.trap`
;; on the device, gpu.md 3.4); the host sees the trap as an error after the stream syncs (fib-gpu-cuda's assert example).
;; A checked `+` on the index path traps the same way on overflow.
(defkernel assert-positive (a: ptr n: i64)
  (let ((i (+ (gpu/global-id 0) 0)))
    (when (< i n)
      (when (<= (gpu/f32-at a i) 0.0f32) (trap "assert-positive: an element is not positive")))))
