;; Run with a rebuilt stage-2 compiler: ./F run examples/logic.fib
(ns main (:require [fib.logic :as l]) (:use fib.logic))

(defun appendo (x: l/Term y: l/Term z: l/Term) -> l/Goal
  (conde [(l/== x (l/nil-term)) (l/== y z)]
         [(fresh [head tail rest]
            (l/== x (l/pair head tail))
            (l/== z (l/pair head rest))
            (zzz (appendo tail y rest)))]))

(defun main () -> i64
  (let ((whole (l/list-term [(l/symbol "tea") (l/symbol "cup")])))
    (do (println "Splits: " (l/run-many 4 2
          (fn (qs) (appendo (nth qs 0) (nth qs 1) whole))))
        (println "Prefix: " (l/run 1
          (fn (q) (appendo q (l/list-term [(l/symbol "cup")]) whole))))
        0)))
