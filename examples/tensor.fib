;; Run with: fibc run examples/tensor.fib
(ns main (:require [fib.tensor :as t]))

(defun main () -> i64
  (let ((a (t/reshape [2 3] (t/linspace 1.0 6.0 6)))
        (bias (t/tensor [10.0 20.0 30.0]))
        (shifted (t/add a bias))
        (normalized (t/div a (t/sum-axis -1 true a))))
    (do (println "shape: " (t/shape shifted))
        (println "broadcast sum: " (t/to-vec shifted))
        (println "fused affine: " (t/to-vec (t/axpby 0.5 a -0.25 bias)))
        (println "row-normalized: " (t/to-vec normalized))
        (println "A times transpose(A): " (t/to-vec (t/mmul a (t/transpose a))))
        (println "row means: " (t/to-vec (t/mean-axis -1 true a)))
        (println "values above 3: " (t/to-vec (t/where (t/greater a (t/full [] 3.0)) a (t/full [] 0.0))))
        (println "ordered sum: " (t/sum a))
        (println "SIMD sum: " (t/sum-fast a))
        0)))
