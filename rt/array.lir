;; fib.rt, arrays (types §8.3): header, length, then the elements in
;; the same allocation. The element type is the caller's; these
;; functions see only its size.

;; A fresh array of n elements of esize bytes, of type id tid; the
;; elements are the caller's to fill. A negative n traps as the
;; interpreter does (eval/arrays.rs).
(define internal (fib.array-alloc ptr) ((i64 n) (i32 tid) (i64 esize))
  (block entry (br (icmp slt n (i64 0)) bad ok))
  (block bad
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string "array of negative length %lld") n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok
    (let ((a (call @fib.alloc (add (i64 24) (mul n esize)) tid)))
      (store n (getelementptr %struct.fib.array.i8 a (i32 0) (i32 3)))
      (ret a))))

(define internal (fib.array-len i64) ((ptr a))
  (block entry (ret (load i64 (getelementptr %struct.fib.array.i8 a (i32 0) (i32 3))))))

;; The elements [i, j) of a as a fresh array (array-copy), not yet
;; retained; out of range traps with the interpreter's message.
(define internal (fib.array-slice ptr) ((ptr a) (i64 i) (i64 j) (i32 tid) (i64 esize))
  (block entry
    (let ((n (call @fib.array-len a))
          (bad (or (icmp slt i (i64 0)) (or (icmp sgt i j) (icmp sgt j n)))))
      (br bad range ok)))
  (block range
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string "array-copy [%lld, %lld) out of range 0..%lld") i j n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok
    (let ((m (sub j i))
          (r (call @fib.array-alloc m tid esize))
          (src (getelementptr i8 (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)) (mul i esize)))
          (dst (getelementptr %struct.fib.array.i8 r (i32 0) (i32 4) (i64 0))))
      (call @memcpy dst src (mul m esize))
      (ret r))))

;; `array-push!` (in-place-update.md §2): a copy of a with room to grow, the elements not yet retained. The capacity of a
;; ROOMY block (flag bit 4, no reader of the flags tests it: they mask bits 0-3) is not stored; it is a function of the
;; length: the smallest power of two that is at least max(len, 32) (`fib.array-cap`). So a unique ROOMY array grows in
;; place while len is below 32, or is not a power of two; at a power of two the next push copies into a block of twice the
;; room (amortised constant time per push, LIBFIX-1: an array of 32 or more elements used to get exactly one more element
;; per copy, so a loop of pushes was quadratic). A pop only shortens len, so the block always has at least that capacity.
(define internal (fib.array-cap i64) ((i64 n))
  (block entry (br loop))
  (block loop
    (let ((c (phi i64 (entry (i64 32)) (step c1))))
      (br (icmp ult c n) step done)))
  (block step
    (let ((c1 (shl c (i64 1))))
      (br loop)))
  (block done (ret c)))

(define internal (fib.array-room ptr) ((ptr a) (i32 tid) (i64 esize))
  (block entry
    (let ((n (call @fib.array-len a))
          (cap (call @fib.array-cap (add n (i64 1))))
          (r (call @fib.alloc (add (i64 24) (mul cap esize)) tid))
          (src (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)))
          (dst (getelementptr %struct.fib.array.i8 r (i32 0) (i32 4) (i64 0)))
          (fp (getelementptr %struct.fib.hdr r (i32 0) (i32 2))))
      (store n (getelementptr %struct.fib.array.i8 r (i32 0) (i32 3)))
      (call @memcpy dst src (mul n esize))
      (store (or (load i32 fp) (i32 16)) fp)
      (ret r))))

;; True when a is unique and ROOMY with a free slot: array-push! writes it in place. Below 32 there is always room; from 32 on
;; the capacity is the power of two at or above len, so there is room unless len is a power of two.
(define internal (fib.array-roomy? i1) ((ptr a))
  (block entry
    (br (call @fib.unique? a) test no))
  (block test
    (br (icmp ne (and (call @fib.flags a) (i32 16)) (i32 0)) full no))
  (block full
    (let ((n (call @fib.array-len a)))
      (br (icmp slt n (i64 32)) yes big)))
  (block big
    (let ((m (and n (sub n (i64 1)))))
      (ret (icmp ne m (i64 0)))))
  (block yes (ret (i1 1)))
  (block no (ret (i1 0))))
