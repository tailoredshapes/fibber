;; fib.prelude: the library of syntax §4.5 that the cases in
;; cases/ownership use, written in fibber over the primitives of syntax
;; §4.3. The expander's own prelude (expand::PRELUDE_SOURCE) comes first
;; and supplies the List enum and the derived Eq/Ord/Hash/Show instances
;; of Option and List.
;;
;; Vec is the persistent vector of types §2.13: a 32-way trie of
;; (Array a) nodes with a tail of up to 32 elements, as in Clojure. A
;; conj copies the tail (at most 32 elements) and, every 32 elements,
;; one path of the trie; nth walks one path. It has an empty variant
;; because (array n x) needs an element to fill with, so no function can
;; make an empty (Array a) for a generic a. The reference interpreter
;; builds and reads this layout natively for Form items and concat
;; (fibref eval/vecs.rs), so a change here must be made there too.

;; Box (syntax §4.5)
(defstruct (Box a) (v: a))
(defun box (x) (Box x))
(defun unbox (b: (Box a)) -> a (. b v))

;; Option helpers (syntax §4.5, Appendix A case 20)
(defun nil? (o) (match o (nil true) ((some _) false)))
(defun some? (o) (match o (nil false) ((some _) true)))
(defun unwrap-or (o d) (match o ((some x) x) (nil d)))

;; Protocols (syntax §4.5)
(defprotocol Countable (count (self) -> i64))
(defprotocol (Indexable s e) (nth (self i: i64) -> e))
(defprotocol (Seq s e) (first (self) -> e) (rest (self) -> Self))
(defprotocol (Collection s e) (conj (self x: e) -> Self))
(defprotocol (Traversable s e) (for-each (self f: (fn (e) unit) :borrow) -> unit))
(defprotocol (Iter s e) (next (self) -> (Option e)))

;; Vec
(defenum (VNode a) (VLeaf items: (Array a)) (VBranch kids: (Array (VNode a))))
(defenum (Vec a)
  (VecEmpty)
  (VecOf cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a)))

(defun vec-empty () VecEmpty)

(defun array-push (items: (Array a) x: a) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (+ n 1) x))))
    (dotimes (i n) (array-set! &c i (array-get items i)))
    @c))

;; A path of branches from level down to node (level 0 is a leaf).
(defun vnode-path (level: i64 node: (VNode a)) -> (VNode a)
  (if (= level 0) node (VBranch (array 1 (vnode-path (- level 5) node)))))

;; node, a branch at level, with the leaf whose first index is idx added.
(defun vnode-push (level: i64 node: (VNode a) idx: i64 leaf: (VNode a)) -> (VNode a)
  (match node
    ((VLeaf _) (trap "vec: a leaf where a branch belongs"))
    ((VBranch kids)
     (let ((sub (bit-and (shr idx level) 31)))
       (if (= level 5)
           (VBranch (array-push kids leaf))
           (if (< sub (array-len kids))
               (VBranch (array-with kids sub (vnode-push (- level 5) (array-get kids sub) idx leaf)))
               (VBranch (array-push kids (vnode-path (- level 5) leaf)))))))))

(defun vnode-get (node: (VNode a) level: i64 i: i64) -> a
  (match node
    ((VLeaf items) (array-get items (bit-and i 31)))
    ((VBranch kids) (vnode-get (array-get kids (bit-and (shr i level) 31)) (- level 5) i))))

;; conj when the tail is full: the tail becomes a leaf of the trie.
(defun vec-push-tail (cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a) x: a) -> (Vec a)
  (let ((leaf (VLeaf tail))
        (tailoff (- cnt 32)))
    (match root
      (nil (VecOf (+ cnt 1) 5 (some (VBranch (array 1 leaf))) (array 1 x)))
      ((some r)
       (if (= (shr tailoff 5) (shl 1 shift))
           (VecOf (+ cnt 1) (+ shift 5)
                  (some (VBranch (array-push (array 1 r) (vnode-path shift leaf))))
                  (array 1 x))
           (VecOf (+ cnt 1) shift (some (vnode-push shift r tailoff leaf)) (array 1 x)))))))

(defun vec-conj (v: (Vec a) x: a) -> (Vec a)
  (match v
    ((VecEmpty) (VecOf 1 5 nil (array 1 x)))
    ((VecOf cnt shift root tail)
     (if (< (array-len tail) 32)
         (VecOf (+ cnt 1) shift root (array-push tail x))
         (vec-push-tail cnt shift root tail x)))))

(defun vec-count (v: (Vec a)) -> i64
  (match v
    ((VecEmpty) 0)
    ((VecOf cnt _ _ _) cnt)))

(defun vec-nth (v: (Vec a) i: i64) -> a
  (match v
    ((VecEmpty) (trap "nth: index out of range"))
    ((VecOf cnt shift root tail)
     (let ((tailoff (- cnt (array-len tail))))
       (if (or (< i 0) (>= i cnt))
           (trap "nth: index out of range")
           (if (>= i tailoff)
               (array-get tail (- i tailoff))
               (match root
                 (nil (trap "nth: index out of range"))
                 ((some r) (vnode-get r shift i)))))))))

(impl Countable (Vec a)
  (count (self) (vec-count self)))

(impl (Indexable a) (Vec a)
  (nth (self i) (vec-nth self i)))

(impl (Collection a) (Vec a)
  (conj (self x) (vec-conj self x)))

(impl (Traversable a) (Vec a)
  (for-each (self f)
    (dotimes (i (vec-count self)) (f (vec-nth self i)))))

;; List (the enum is in the expander's prelude)
(impl Countable (List a)
  (count (self)
    (match self
      ((empty) 0)
      ((cons _ t) (+ 1 (count t))))))

(impl (Indexable a) (List a)
  (nth (self i)
    (match self
      ((empty) (trap "nth: index out of range"))
      ((cons h t) (if (= i 0) h (nth t (- i 1)))))))

(impl (Seq a) (List a)
  (first (self)
    (match self
      ((empty) (trap "first: empty list"))
      ((cons h _) h)))
  (rest (self)
    (match self
      ((empty) empty)
      ((cons _ t) t))))

(impl (Collection a) (List a)
  (conj (self x) (cons x self)))

(impl (Traversable a) (List a)
  (for-each (self f)
    (match self
      ((empty) ())
      ((cons h t) (do (f h) (for-each t f))))))

;; Strings
(impl Countable str
  (count (self) (str-len self)))

(defun length (s: str) -> i64 (str-len s))

;; Iterators
(defstruct (VecIter a) (vec: (Vec a) pos: (Cell i64)))

(defun iter (v: (Vec a)) -> (VecIter a) (VecIter v (cell 0)))

(impl (Iter a) (VecIter a)
  (next (self)
    (let ((i @(. self pos)))
      (if (< i (count (. self vec)))
          (do (set! (. self pos) (+ i 1))
              (some (nth (. self vec) i)))
          nil))))

(defstruct (FilterIter i e) (inner: i pred: (fn (e) bool)))

(defun filter-iter (it: i p: (fn (e) bool)) :where ((Iter i e)) -> (FilterIter i e)
  (FilterIter it p))

(impl (Iter e) (FilterIter i e) :where ((Iter i e))
  (next (self)
    (loop ()
      (match (next (. self inner))
        (nil nil)
        ((some x) (if ((. self pred) x) (some x) (recur)))))))

(defun collect (it)
  (loop ((acc (vec-empty)))
    (match (next it)
      (nil acc)
      ((some x) (recur (conj acc x))))))

;; Sequences of numbers and whole-vector operations
(defun even? (n: i64) -> bool (= (rem n 2) 0))

(defun range-between (a: i64 b: i64) -> (Vec i64)
  (loop ((i a) (acc (vec-empty)))
    (if (< i b) (recur (+ i 1) (vec-conj acc i)) acc)))

;; (range n) is (range 0 n); (range a b) is the prelude macro's rewrite
;; to range-between (syntax §4.4, §4.5).
(defun range (n: i64) -> (Vec i64) (range-between 0 n))

(defun map (f v: (Vec a))
  (let ((n (vec-count v)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n) (recur (+ i 1) (vec-conj acc (f (vec-nth v i)))) acc))))

;; In-place updates through & (syntax §3.13): append is push!.
(defun push! (&v x) (set! v (conj @v x)))
(defun append (&v x) (push! &v x))

;; Threads and tasks (syntax §3.12, §3.14)
(defun pmap (f: (fn :send (a) b) xs: (Vec a)) -> (Vec b)
  (let ((tasks (map (fn (x) (spawn (fn () (f x)))) xs)))
    (map (fn (t) (join t)) tasks)))

(defun yield () -> (Task unit) (async ()))
(defun block-on (t) (join t))
(defun panic (msg: str) (trap msg))

;; I/O (syntax §4.5): eprintln writes s and a newline to stderr, through
;; the C write(2) on fd 2, copying the string's bytes to a raw buffer.
(extern write (i32 ptr i64) -> i64)

(defun write-str (fd: i32 s: str) -> unit
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc n)))
        (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
        (write fd p n)
        (free p)))))

(defun eprintln (s: str) -> unit
  (do (write-str 2i32 s) (write-str 2i32 "\n")))
