;; fib.prelude: the library of syntax §4.5 that the cases in
;; cases/ownership use, written in fibber over the primitives of syntax
;; §4.3. The expander's own prelude (expand::PRELUDE_SOURCE) comes first
;; and supplies the List enum (variants Empty and Cons) and the derived
;; Eq/Ord/Hash instances of Option and List; their Show is written here,
;; below, because a derived Show cannot print an Option as its payload.
;; The helpers marked :private (syntax §5) are not exported: the trie's
;; nodes and their functions, and the raw write under println, eprintln
;; and print-raw.
;;
;; Pair, Triple and Result (stdlib design §2.3, L4) are the library's tuple
;; types: the entry a Map yields is a Pair, the one tuple type, and
;; map-each and set-each are the walks over a Map and a Set that can stop early.
;;
;; The flip (tranche 1, M): the protocols Countable, Indexable, Seq, Collection,
;; Traversable, Iter and Associative, their instances, the Vec-only map, range,
;; for-each (the function), iter, collect, filter-iter and the iterators are
;; gone; the library's four implicit modules (fib.core, fib.seq, fib.coll,
;; fib.print) are what a program sees first, the prelude after them. What stays
;; are the types and their raw operations (vec-count vec-nth vec-conj map-get
;; map-assoc map-count set-count map-each set-each ..), which the library is
;; built on, and the names of stdlib §6.5.
;;
;; Vec is the persistent vector of types §2.13: a 32-way trie of
;; (Array a) nodes with a tail of up to 32 elements, as in Clojure. A
;; conj copies the tail (at most 32 elements) and, every 32 elements,
;; one path of the trie; nth walks one path. It has an empty variant
;; because (array n x) needs an element to fill with, so no function can
;; make an empty (Array a) for a generic a. The reference interpreter
;; builds and reads this layout natively for Form items and concat
;; (fibref eval/vecs.rs), so a change here must be made there too.

;; Box (syntax §4.5)
(defstruct (Box a) (v: a))
(defun box (x) (Box x))
(defun unbox (b: (Box a)) -> a (. b v))

;; Option helpers (syntax §4.5, Appendix A case 20)
(defun nil? (o) (match o (nil true) ((some _) false)))
(defun some? (o) (match o (nil false) ((some _) true)))
(defun unwrap-or (o d) (match o ((some x) x) (nil d)))

;; hash-combine folds the hash x of the next field into the running hash h
;; (derive Hash and the derived Option and List use it): rotate h left by 7,
;; xor in x and a constant, then eight invertible xorshift steps, a positive
;; amount shl and a negative one shr. Only shl, shr, bit-or and bit-xor,
;; which never trap: the h*31 + x it replaced trapped at two strings. Case
;; 198 tests it against an independent transcription (types §2.12).
(defun hash-xorshift :private (m: i64 s: i64) -> i64
  (if (> s 0) (bit-xor m (shl m s)) (bit-xor m (shr m (- 0 s)))))
(defun hash-combine (h: i64 x: i64) -> i64
  (let ((m (bit-xor (bit-xor (bit-or (shl h 7) (shr h 57)) x) -7046029254386353131))
        (a (hash-xorshift (hash-xorshift (hash-xorshift (hash-xorshift m -36) 11) -15) 23)))
    (hash-xorshift (hash-xorshift (hash-xorshift (hash-xorshift a -2) 31) -39) 15)))

;; Tuples (stdlib design §2.3, §4.3; L4). Pair is the one tuple type: the
;; entry a Map yields, what the library's zip and juxt give. Triple is its
;; three-field twin and Result the value of a function that can fail. Each
;; derives Eq, Ord and Hash; their Show is the library's (fib.print.show prints
;; a Pair as [1 2]), which a derived Show would overlap, so none is derived.
(defstruct (Pair a b) (fst: a snd: b))
(defstruct (Triple a b c) (fst: a snd: b thd: c))
(defenum (Result a b) (Ok v: a) (Err e: b))
(derive Eq Pair) (derive Ord Pair) (derive Hash Pair)
(derive Eq Triple) (derive Ord Triple) (derive Hash Triple)
(derive Eq Result) (derive Ord Result) (derive Hash Result)

;; Vec
(defenum (VNode a) :private (VLeaf items: (Array a)) (VBranch kids: (Array (VNode a))))
(defenum (Vec a)
  (VecEmpty)
  (VecOf cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a)))

(defun vec-empty () VecEmpty)

(defun array-push :private (items: (Array a) x: a) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (+ n 1) x))))
    (dotimes (i n) (array-set! &c i (array-get items i)))
    @c))

;; A path of branches from level down to node (level 0 is a leaf).
(defun vnode-path :private (level: i64 node: (VNode a)) -> (VNode a)
  (if (= level 0) node (VBranch (array 1 (vnode-path (- level 5) node)))))

;; node, a branch at level, with the leaf whose first index is idx added.
(defun vnode-push :private (level: i64 node: (VNode a) idx: i64 leaf: (VNode a)) -> (VNode a)
  (match node
    ((VLeaf _) (trap "vec: a leaf where a branch belongs"))
    ((VBranch kids)
     (let ((sub (bit-and (shr idx level) 31)))
       (let ((c (cell kids)))
         (if (= level 5)
             (do (array-push! &c leaf) (VBranch @c))
             (if (< sub (array-len @c))
                 (let ((kid (array-take! &c sub)))
                   (do (array-set! &c sub (vnode-push (- level 5) kid idx leaf)) (VBranch @c)))
                 (do (array-push! &c (vnode-path (- level 5) leaf)) (VBranch @c)))))))))

(defun vnode-get :private (node: (VNode a) level: i64 i: i64) -> a
  (match node
    ((VLeaf items) (array-get items (bit-and i 31)))
    ((VBranch kids) (vnode-get (array-get kids (bit-and (shr i level) 31)) (- level 5) i))))

;; conj when the tail is full: the tail becomes a leaf of the trie.
(defun vec-push-tail :private (cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a) x: a) -> (Vec a)
  (let ((leaf (VLeaf tail))
        (tailoff (- cnt 32)))
    (match root
      (nil (VecOf (+ cnt 1) 5 (some (VBranch (array 1 leaf))) (array 1 x)))
      ((some r)
       (if (= (shr tailoff 5) (shl 1 shift))
           (VecOf (+ cnt 1) (+ shift 5)
                  (some (VBranch (array-push (array 1 r) (vnode-path shift leaf))))
                  (array 1 x))
           (VecOf (+ cnt 1) shift (some (vnode-push shift r tailoff leaf)) (array 1 x)))))))

(defun vec-conj (v: (Vec a) x: a) -> (Vec a)
  (match v
    ((VecEmpty) (VecOf 1 5 nil (array 1 x)))
    ((VecOf cnt shift root tail)
     (if (< (array-len tail) 32)
         (let ((c (cell tail)))
           (do (array-push! &c x) (VecOf (+ cnt 1) shift root @c)))
         (vec-push-tail cnt shift root tail x)))))

(defun vec-count (v: (Vec a)) -> i64
  (match v
    ((VecEmpty) 0)
    ((VecOf cnt _ _ _) cnt)))

(defun vec-nth (v: (Vec a) i: i64) -> a
  (match v
    ((VecEmpty) (trap "nth: index out of range"))
    ((VecOf cnt shift root tail)
     (let ((tailoff (- cnt (array-len tail))))
       (if (or (< i 0) (>= i cnt))
           (trap "nth: index out of range")
           (if (>= i tailoff)
               (array-get tail (- i tailoff))
               (match root
                 (nil (trap "nth: index out of range"))
                 ((some r) (vnode-get r shift i)))))))))

;; node, a branch at level, with element i replaced by x: one new array and one new node for each level of
;; the path from the root to the leaf, the other kids shared.
(defun vnode-assoc :private (node: (VNode a) level: i64 i: i64 x: a) -> (VNode a)
  (match node
    ((VLeaf items)
     (let ((c (cell items)))
       (do (array-set! &c (bit-and i 31) x) (VLeaf @c))))
    ((VBranch kids)
     (let ((sub (bit-and (shr i level) 31))
           (c (cell kids)))
       (let ((kid (array-take! &c sub)))
         (do (array-set! &c sub (vnode-assoc kid (- level 5) i x)) (VBranch @c)))))))

;; (vec-assoc v i x) is v with element i replaced by x (stdlib §2.5): the path from the root to the leaf is
;; copied, or only the tail when i is in the tail, so O(log32 n) objects, and v is unchanged. i = the count
;; appends, as Clojure's assoc does; an index below zero or above the count traps `assoc: index out of range`.
(defun vec-assoc (v: (Vec a) i: i64 x: a) -> (Vec a)
  (let ((n (vec-count v)))
    (if (= i n)
        (vec-conj v x)
        (if (or (< i 0) (> i n))
            (trap "assoc: index out of range")
            ;; the trie clause names the root's payload in the pattern, so that it is a field of v's own slot: it can be stolen
            (match v
              ((VecOf cnt shift root tail) :when (>= i (- cnt (array-len tail)))
               (let ((k (- i (- cnt (array-len tail))))
                     (c (cell tail)))
                 (do (array-set! &c k x) (VecOf cnt shift root @c))))
              ((VecOf cnt shift (some r) tail) (VecOf cnt shift (some (vnode-assoc r shift i x)) tail))
              (_ (trap "assoc: index out of range")))))))

;; The leaf of the trie that holds index i, as its array of 32.
(defun vnode-leaf :private (node: (VNode a) level: i64 i: i64) -> (Array a)
  (match node
    ((VLeaf items) items)
    ((VBranch kids) (vnode-leaf (array-get kids (bit-and (shr i level) 31)) (- level 5) i))))

;; node, a branch at level (5 or more), without its last leaf; nil when that leaves nothing. One new array and one
;; new node for each level of the path to the last leaf, the other kids shared.
(defun vnode-pop :private (node: (VNode a) level: i64) -> (Option (VNode a))
  (match node
    ((VLeaf _) nil)
    ((VBranch kids)
     (let ((n (array-len kids))
           (c (cell kids)))
       (if (= level 5)
           (if (= n 1) nil (do (array-pop! &c) (some (VBranch @c))))
           (match (vnode-pop (array-take! &c (- n 1)) (- level 5))
             (nil (if (= n 1) nil (do (array-pop! &c) (some (VBranch @c)))))
             ((some sub) (do (array-set! &c (- n 1) sub) (some (VBranch @c))))))))))

;; the root of a trie that has lost its last leaf; a root with a single kid above level 5 is that kid, one level down
(defun vec-pop-root :private (cnt: i64 shift: i64 root: (VNode a) tail: (Array a)) -> (Vec a)
  (match (vnode-pop root shift)
    (nil (VecOf cnt 5 nil tail))
    ((some r)
     (match r
       ((VBranch kids)
        (if (and (> shift 5) (= (array-len kids) 1))
            (VecOf cnt (- shift 5) (some (array-get kids 0)) tail)
            (VecOf cnt shift (some r) tail)))
       ((VLeaf _) (trap "vec: a leaf where a branch belongs"))))))

;; (vec-pop v) is v without its last element (stdlib §1.2 P3, §4.4 row pop): the tail without its last element,
;; and when the tail holds one element, the last leaf of the trie becomes the tail; v is unchanged. An empty
;; vector traps `pop: empty`. Popping the only element answers VecEmpty, so a vector of no elements has one form.
(defun vec-pop (v: (Vec a)) -> (Vec a)
  (match v
    ((VecEmpty) (trap "pop: empty"))
    ((VecOf cnt shift root tail)
     (let ((t (array-len tail)))
       (if (= cnt 1)
           VecEmpty
           (if (> t 1)
               (let ((c (cell tail)))
                 (do (array-pop! &c) (VecOf (- cnt 1) shift root @c)))
               (match root
                 (nil (trap "vec: a vector with no leaves and no tail"))
                 ((some r) (vec-pop-root (- cnt 1) shift r (vnode-leaf r shift (- cnt 2)))))))))))

;; The bulk builder (stdlib design §2.5; tranche 1 plan L9). A Vec built by conj spends 2.09 heap
;; objects an element (the tail is copied, and one path of the trie every 32); built here, 2 objects
;; for every 32 elements (a leaf's array and its node, and the same one level up for every 32 nodes)
;; and a few constants. The layout is the one above, unchanged, because rt/vec.lir and eval/vecs.rs
;; read it: VecOf cnt shift root tail with the last 1..32 elements exactly in the tail, full leaves
;; in the trie, shift 5 for a root of leaves, and an empty vector VecEmpty. The result is the vector
;; a conj loop builds, as far as a program can tell (cases 480 and 481 read every element of a built
;; vector and of the same grown by conj, which depends on the shift, the tail and the leaves being
;; where a conj loop puts them); eval/vecs.rs build_vec stacks the branches the same way.
;; Decided here:
;;  - two entry points, both public: vec-from-array for an array whose length is known, and
;;    vec-collect for a walk of unknown length (what the library's default to-vec is);
;;  - the buffer of a collect has 32 slots, made from the first element (an (Array a) of a generic
;;    a cannot be made without one) and written in place by array-set!; it becomes a leaf, itself
;;    and not a copy, when the 33rd element of its run arrives, so a full buffer that ends the walk
;;    is the tail without a copy;
;;  - every mutable part of the state is a cell holding its array alone, because only then does
;;    array-set! write in place (the count of a callee's owned parameter is two: §2.5);
;;  - the leaves are an array that doubles from 4, made when the first leaf is full;
;;  - the price is a constant: the state is a cell, a struct and three cells, so a collect of one element
;;    allocates 6 more objects than the conj loop it replaced, of two 4 more, of three 2 more, of four the
;;    same and of five or more fewer (cases 483 and 489 pin the counts).

;; The branches one level up: nodes[0..n) in groups of 32, an array of ceil(n/32) branches.
(defun vnodes-up :private (nodes: (Array (VNode a)) n: i64) -> (Array (VNode a))
  (let ((groups (shr (+ n 31) 5))
        (out (cell (array groups (array-get nodes 0)))))
    (do (dotimes (g groups)
          (let ((lo (shl g 5)))
            (array-set! &out g (VBranch (array-copy nodes lo (if (< (+ lo 32) n) (+ lo 32) n))))))
        @out)))

;; The vector of cnt elements whose full leaves are nodes[0..n) and whose last 1..32 are tail:
;; branches are stacked until one is left, as build_vec of eval/vecs.rs stacks them. The root
;; branch is the nodes themselves when the array holds exactly n of them (nothing writes it again).
(defun vec-trie :private (cnt: i64 shift: i64 nodes: (Array (VNode a)) n: i64 tail: (Array a)) -> (Vec a)
  (if (<= n 32)
      (VecOf cnt shift (some (VBranch (if (= n (array-len nodes)) nodes (array-copy nodes 0 n)))) tail)
      (vec-trie cnt (+ shift 5) (vnodes-up nodes n) (shr (+ n 31) 5) tail)))

;; The vector of the elements of xs, in order, built in one pass: a leaf per 32 elements and a
;; branch per 32 nodes, so 2 objects for every 32 elements (the node and its array) where a conj
;; loop spends 2.09 for each element. xs of at most 32 elements is the tail itself.
(defun vec-from-array (xs: (Array a)) -> (Vec a)
  (let ((n (array-len xs))
        (split (- n (+ (bit-and (- n 1) 31) 1))))
    (if (= n 0)
        VecEmpty
        (if (= split 0)
            (VecOf n 5 nil xs)
            (let ((leaves (cell (array (shr split 5) (VLeaf (array-copy xs 0 32))))))
              (do (loop ((i 1))
                    (if (< (shl i 5) split)
                        (do (array-set! &leaves i (VLeaf (array-copy xs (shl i 5) (+ (shl i 5) 32))))
                            (recur (+ i 1)))
                        ()))
                  (vec-trie n 5 @leaves (shr split 5) (array-copy xs split n))))))))

;; The state of a build from a walk of unknown length: the buffer being filled (32 slots), the
;; count of elements taken, and the full leaves so far, an array that doubles (made when the first
;; leaf is full). Every field is a cell, so that a write goes to the array in place: the cell holds
;; the array alone.
(defstruct (VecBuild a) :private
  (buf: (Cell (Array a)) n: (Cell i64) leaves: (Cell (Option (Cell (Array (VNode a)))))))

;; The leaf of a full buffer goes on the leaves, doubling their array when it is full.
(defun vb-leaf :private (b: (VecBuild a) k: i64) -> unit
  (let ((leaf (VLeaf @(. b buf))))
    (match @(. b leaves)
      (nil (set! (. b leaves) (some (cell (array 4 leaf)))))
      ((some lc)
       (do (if (= k (array-len @lc))
               (let ((bigger (cell (array (shl k 1) leaf))))
                 (do (dotimes (i k) (array-set! &bigger i (array-get @lc i)))
                     (set! lc @bigger)))
               ())
           (array-set! &lc k leaf))))))

(defun vb-push :private (b: (VecBuild a) x: a) -> unit
  (let ((n @(. b n))
        (buf (. b buf)))
    (do (if (= (bit-and n 31) 0)
            (do (vb-leaf b (- (shr n 5) 1)) (set! buf (array 32 x)))
            (array-set! &buf (bit-and n 31) x))
        (set! (. b n) (+ n 1)))))

(defun vb-done :private (b: (VecBuild a)) -> (Vec a)
  (let ((n @(. b n))
        (f (+ (bit-and (- n 1) 31) 1))
        (buf @(. b buf)))
    (let ((tail (if (= f 32) buf (array-copy buf 0 f))))
      (match @(. b leaves)
        (nil (VecOf n 5 nil tail))
        ((some lc) (vec-trie n 5 @lc (shr (- n 1) 5) tail))))))

;; The sink a walk is given: the first element makes the state, every other one is a write.
(defun vec-take :private (st: (Cell (Option (VecBuild a))) x: a) -> bool
  (do (match @st
        (nil (set! st (some (VecBuild (cell (array 32 x)) (cell 1) (cell nil)))))
        ((some b) (vb-push b x)))
      true))

;; The Vec of every element a walk offers, in one pass: walk is handed a function that takes each
;; element and says true to go on (the visitor each-while is given), and runs it.
(defun vec-collect (walk: (fn ((fn (a) bool)) bool) :borrow) -> (Vec a)
  (let ((st (cell nil)))
    (do (walk (fn (x) (vec-take st x)))
        (match @st
          (nil VecEmpty)
          ((some b) (vb-done b))))))

;; List (the enum is in the expander's prelude: Empty and Cons, stdlib design
;; C-3; the library's own `empty` and `cons` are a method and a function).
;; The protocols a List answers (count first rest nth conj ..) are the library's.

;; Show of Option and List as Clojure prints them (stdlib design §2.7): a
;; present value is its payload's text (a nested Option is as ambiguous as
;; Clojure's nested nil), nil is `nil`, and a List is its elements in
;; parentheses, a space apart: `(1 2)`, `()`. The two are here, not
;; derived, because a derived Show says `(some 3)` and `(Cons 1 (Cons 2
;; Empty))`.
(impl Show (Option a) :where ((Show a))
  (show (self)
    (match self
      (nil "nil")
      ((some x) (show x)))))

(defun list-text :private (l: (List a)) :where ((Show a)) -> str
  (loop ((rest l) (acc "") (first true))
    (match rest
      ((Empty) acc)
      ((Cons h t)
       (recur t (str-concat (if first acc (str-concat acc " ")) (show h)) false)))))

(impl Show (List a) :where ((Show a))
  (show (self) (str-concat "(" (str-concat (list-text self) ")"))))

;; Hash of a List is the hash of the Vec of the same elements, as Clojure's (= (hash [1 2]) (hash '(1 2))): the fold
;; of hash-combine over the elements' hashes in order from the seed 1, then combined with the count, which is what
;; fib.seq.hash's hash-ordered-coll gives any source. It is here and not derived because the prelude must hash a List
;; with no library module loaded (ownership case 199) and a derived instance folds the variant index and the fields,
;; which is a different number (and 0 for the empty list). Case 2140 pins the equality with the Vec's.
(defun list-hash :private (l: (List a)) :where ((Hash a)) -> i64
  (loop ((rest l) (h 1) (n 0))
    (match rest
      ((Empty) (hash-combine h n))
      ((Cons x t) (recur t (hash-combine h (hash x)) (+ n 1))))))

(impl Hash (List a) :where ((Hash a))
  (hash (self) (list-hash self)))

;; Map: a hash array mapped trie (types §2.13, syntax §4.5) over the
;; keys' hash: 32-way bitmap nodes five bits of the hash at a time, a
;; leaf per key, a bucket for keys whose hashes collide. Keys need Hash
;; and Eq. assoc and dissoc share structure with the previous version.
;; A bucket holds its entries as Pairs (key fst, value snd).
(defenum (MNode k v) :private
  (MLeaf hash: i64 key: k val: v)
  (MColl hash: i64 items: (Array (Pair k v)))
  (MBits bitmap: i64 kids: (Array (MNode k v))))
(defenum (Map k v)
  (MapEmpty)
  (MapOf cnt: i64 root: (MNode k v)))
(defstruct (MRes k v) :private (node: (MNode k v) added: bool))

(defun map-empty () MapEmpty)

;; The empty hashed Map, which the `hash-map` macro expands to (stdlib §4.8, §2.7). Every Map is hashed today, so it is
;; the same value as map-empty; the small insertion-ordered Map of the plan would be what `array-map` and a literal give,
;; and this the one that stays a hash trie at any size.
(defun map-empty-hashed () MapEmpty)

;; items with x inserted at i, and with element i removed.
(defun array-insert :private (items: (Array a) i: i64 x: a) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (+ n 1) x))))
    (dotimes (j i) (array-set! &c j (array-get items j)))
    (dotimes (j (- n i)) (array-set! &c (+ i (+ j 1)) (array-get items (+ i j))))
    @c))

(defun array-remove :private (items: (Array a) i: i64) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (- n 1) (array-get items 0)))))
    (dotimes (j i) (array-set! &c j (array-get items j)))
    (dotimes (j (- (- n i) 1)) (array-set! &c (+ i j) (array-get items (+ i (+ j 1)))))
    @c))

(defun mchunk :private (h: i64 shift: i64) -> i64 (bit-and (shr h shift) 31))

;; A node holding two leaves whose hashes differ, below shift.
(defun mnode-two :private (shift: i64 h0: i64 a: (MNode k v) h1: i64 b: (MNode k v)) -> (MNode k v)
  (let ((c0 (mchunk h0 shift))
        (c1 (mchunk h1 shift)))
    (if (= c0 c1)
        (MBits (shl 1 c0) (array 1 (mnode-two (+ shift 5) h0 a h1 b)))
        (if (< c0 c1)
            (MBits (bit-or (shl 1 c0) (shl 1 c1)) (array-push (array 1 a) b))
            (MBits (bit-or (shl 1 c0) (shl 1 c1)) (array-push (array 1 b) a))))))

(defun mcoll-find :private (items: (Array (Pair k v)) key: k) -> i64
  (loop ((i 0))
    (if (>= i (array-len items))
        -1
        (if (= (. (array-get items i) fst) key) i (recur (+ i 1))))))

(defun mnode-get :private (node: (MNode k v) shift: i64 h: i64 key: k) :where ((Eq k)) -> (Option v)
  (match node
    ((MLeaf h0 k0 v0) (if (and (= h0 h) (= k0 key)) (some v0) nil))
    ((MColl h0 items)
     (if (= h0 h)
         (let ((i (mcoll-find items key)))
           (if (< i 0) nil (some (. (array-get items i) snd))))
         nil))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift))))
       (if (= (bit-and bitmap bit) 0)
           nil
           (mnode-get (array-get kids (popcount (bit-and bitmap (- bit 1)))) (+ shift 5) h key))))))

(defun mnode-assoc :private (node: (MNode k v) shift: i64 h: i64 key: k val: v) :where ((Eq k)) -> (MRes k v)
  (match node
    ((MLeaf h0 k0 v0)
     (if (= h0 h)
         (if (= k0 key)
             (MRes (MLeaf h key val) false)
             (MRes (MColl h (array-push (array 1 (Pair k0 v0)) (Pair key val))) true))
         (MRes (mnode-two shift h0 node h (MLeaf h key val)) true)))
    ((MColl h0 items)
     (if (= h0 h)
         (let ((i (mcoll-find items key)))
           (if (< i 0)
               (MRes (MColl h (array-push items (Pair key val))) true)
               (let ((c (cell items)))
                 (array-set! &c i (Pair key val))
                 (MRes (MColl h @c) false))))
         (MRes (mnode-two shift h0 node h (MLeaf h key val)) true)))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift)))
           (idx (popcount (bit-and bitmap (- bit 1)))))
       (if (= (bit-and bitmap bit) 0)
           (MRes (MBits (bit-or bitmap bit) (array-insert kids idx (MLeaf h key val))) true)
           ;; descent over the cell idiom: array-take! moves the child out when kids is unique
           (let ((c (cell kids))
                 (r (mnode-assoc (array-take! &c idx) (+ shift 5) h key val)))
             (array-set! &c idx (. r node))
             (MRes (MBits bitmap @c) (. r added))))))))

;; The node without key, or nil when that empties it.
(defun mnode-dissoc :private (node: (MNode k v) shift: i64 h: i64 key: k) :where ((Eq k)) -> (Option (MNode k v))
  (match node
    ((MLeaf h0 k0 _) (if (and (= h0 h) (= k0 key)) nil (some node)))
    ((MColl h0 items)
     (let ((i (if (= h0 h) (mcoll-find items key) -1)))
       (if (< i 0)
           (some node)
           (if (= (array-len items) 2)
               (let ((e (array-get items (- 1 i))))
                 (some (MLeaf h0 (. e fst) (. e snd))))
               (some (MColl h0 (array-remove items i)))))))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift)))
           (idx (popcount (bit-and bitmap (- bit 1)))))
       (if (= (bit-and bitmap bit) 0)
           (some node)
           (let ((c (cell kids)))
             (match (mnode-dissoc (array-take! &c idx) (+ shift 5) h key)
               ((some kid) (array-set! &c idx kid) (some (MBits bitmap @c)))
               (nil (if (= (array-len kids) 1)
                        nil
                        (some (MBits (bit-xor bitmap bit) (array-remove @c idx))))))))))))

(defun map-assoc (m: (Map k v) key: k val: v) -> (Map k v)
  (let ((h (hash key)))
    (match m
      ((MapEmpty) (MapOf 1 (MLeaf h key val)))
      ((MapOf cnt root)
       (let ((r (mnode-assoc root 0 h key val)))
         (MapOf (if (. r added) (+ cnt 1) cnt) (. r node)))))))

(defun map-get (m: (Map k v) key: k) -> (Option v)
  (match m
    ((MapEmpty) nil)
    ((MapOf _ root) (mnode-get root 0 (hash key) key))))

(defun dissoc (m: (Map k v) key: k) -> (Map k v)
  (match m
    ((MapEmpty) MapEmpty)
    ((MapOf cnt root)
     (match (mnode-get root 0 (hash key) key)
       (nil m)
       ((some _)
        (match (mnode-dissoc root 0 (hash key) key)
          (nil MapEmpty)
          ((some r) (MapOf (- cnt 1) r))))))))

;; The number of entries, as vec-count is the number of elements.
(defun map-count (m: (Map k v)) -> i64
  (match m
    ((MapEmpty) 0)
    ((MapOf cnt _) cnt)))

(defun contains? (m: (Map k v) key: k) -> bool (some? (map-get m key)))

;; The walk that can stop (stdlib design §4.2, L4): f is given each key and
;; its value, in the trie's order, and says whether to go on; the result is
;; whether the walk ran to the end. No Pair is built.
(defun mnode-each :private (node: (MNode k v) f: (fn (k v) bool) :borrow) -> bool
  (match node
    ((MLeaf _ k0 v0) (f k0 v0))
    ((MColl _ items)
     (loop ((i 0))
       (if (< i (array-len items))
           (let ((e (array-get items i)))
             (if (f (. e fst) (. e snd)) (recur (+ i 1)) false))
           true)))
    ((MBits _ kids)
     (loop ((i 0))
       (if (< i (array-len kids))
           (if (mnode-each (array-get kids i) f) (recur (+ i 1)) false)
           true)))))

(defun map-each (m: (Map k v) f: (fn (k v) bool) :borrow) -> bool
  (match m
    ((MapEmpty) true)
    ((MapOf _ root) (mnode-each root f))))

;; In-place updates through & (syntax §3.13).
(defun map-put! (&m key val) (set! m (map-assoc @m key val)))
(defun map-del! (&m key) (set! m (dissoc @m key)))

;; Set: the keys of a Map.
(defstruct (Set k) (m: (Map k bool)))

(defun set-empty () (Set MapEmpty))
(defun set-contains? (s: (Set k) x: k) -> bool (contains? (. s m) x))
(defun disj (s: (Set k) x: k) -> (Set k) (Set (dissoc (. s m) x)))

;; The number of elements.
(defun set-count (s: (Set k)) -> i64 (map-count (. s m)))

;; The elements of a Set, as map-each walks a Map: f says whether to go on.
;; The call is bound before it is returned: a closure given to a call in tail
;; position is a heap closure (types §6.10), which would capture the borrowed f.
(defun set-each (s: (Set k) f: (fn (k) bool) :borrow) -> bool
  (let ((r (map-each (. s m) (fn (x y) (f x))))) r))

;; Strings
(defun length (s: str) -> i64 (str-len s))

;; Building and characters (M5): str-join concatenates a vector of
;; strings in one allocation; str-chars decodes the UTF-8 bytes into
;; chars; char->str encodes one char.
(defun str-join (parts: (Vec str)) -> str
  (let ((n (vec-count parts))
        (total (loop ((i 0) (t 0))
                 (if (< i n) (recur (+ i 1) (+ t (str-len (vec-nth parts i)))) t)))
        (c (cell (array total 0i8))))
    (loop ((i 0) (pos 0))
      (if (< i n)
          (let ((bs (str-bytes (vec-nth parts i))))
            (dotimes (j (array-len bs)) (array-set! &c (+ pos j) (array-get bs j)))
            (recur (+ i 1) (+ pos (array-len bs))))
          ()))
    (str-from-bytes @c)))

(defun utf8-len :private (b: i32) -> i64
  (if (< b 128i32) 1 (if (< b 224i32) 2 (if (< b 240i32) 3 4))))

(defun utf8-code :private (bs: (Array i8) i: i64 b: i32 len: i64) -> i32
  (if (= len 1)
      b
      (let ((c1 (bit-and (zext i32 (array-get bs (+ i 1))) 63i32)))
        (if (= len 2)
            (bit-or (shl (bit-and b 31i32) 6i32) c1)
            (let ((c2 (bit-and (zext i32 (array-get bs (+ i 2))) 63i32)))
              (if (= len 3)
                  (bit-or (shl (bit-and b 15i32) 12i32) (bit-or (shl c1 6i32) c2))
                  (let ((c3 (bit-and (zext i32 (array-get bs (+ i 3))) 63i32)))
                    (bit-or (shl (bit-and b 7i32) 18i32)
                            (bit-or (shl c1 12i32) (bit-or (shl c2 6i32) c3))))))))))

(defun str-chars (s: str) -> (Vec char)
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n)
          (let ((b (zext i32 (array-get bs i)))
                (len (utf8-len b)))
            (recur (+ i len) (vec-conj acc (i32->char (utf8-code bs i b len)))))
          acc))))

(defun char->str (c: char) -> str
  (let ((code (char->i32 c))
        (cont (fn (sh: i32) (trunc i8 (bit-or 128i32 (bit-and (shr code sh) 63i32))))))
    (str-from-bytes
      (if (< code 128i32)
          (array 1 (trunc i8 code))
          (if (< code 2048i32)
              (array-push (array 1 (trunc i8 (bit-or 192i32 (shr code 6i32)))) (cont 0i32))
              (if (< code 65536i32)
                  (array-push (array-push (array 1 (trunc i8 (bit-or 224i32 (shr code 12i32)))) (cont 6i32)) (cont 0i32))
                  (array-push (array-push (array-push (array 1 (trunc i8 (bit-or 240i32 (shr code 18i32)))) (cont 12i32)) (cont 6i32)) (cont 0i32))))))))

;; Numbers
(defun even? (n: i64) -> bool (= (rem n 2) 0))

;; In-place updates through & (syntax §3.13): append is push!.
(defun push! (&v x) (set! v (vec-conj @v x)))
(defun append (&v x) (push! &v x))

;; Threads and tasks (syntax §3.12, §3.14)
;; pmap spawns one task per element and joins them in order; it is written
;; over spawn and join alone, so that the Vec-only map can go (stdlib design §8.3 C).
(defun pmap (f: (fn :send (a) b) xs: (Vec a)) -> (Vec b)
  (let ((n (vec-count xs))
        (tasks (loop ((i 0) (acc (vec-empty)))
                 (if (< i n)
                     (let ((x (vec-nth xs i))) (recur (+ i 1) (vec-conj acc (spawn (fn () (f x))))))
                     acc))))
    (loop ((i 0) (out (vec-empty)))
      (if (< i n) (recur (+ i 1) (vec-conj out (join (vec-nth tasks i)))) out))))

(defun yield () -> (Task unit) (async ()))
(defun block-on (t) (join t))
(defun panic (msg: str) (trap msg))

;; I/O (syntax §4.5): println and eprintln write s and a newline to fd 1
;; and fd 2 through the C write(2), copying the string's bytes to a raw
;; buffer first. write may take fewer bytes than it is given, so each
;; string is written in a loop until every byte has gone, and a call
;; that fails (-1) or makes no progress (0 bytes of a non-empty rest,
;; which would loop for ever) is the trap `NAME: write failed`, NAME
;; being the function the program called.
(extern write :private (i32 ptr i64) -> i64)

;; The n bytes at p to fd, from the first to the last.
(defun write-bytes :private (who: str fd: i32 p: ptr n: i64) -> unit
  (unsafe
    (loop ((done 0))
      (if (< done n)
          (let ((w (write fd (ptr+ p done) (- n done))))
            (if (> w 0)
                (recur (+ done w))
                (trap (str-concat who ": write failed"))))
          ()))))

(defun write-str :private (who: str fd: i32 s: str) -> unit
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc n)))
        (do (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
            (write-bytes who fd p n)
            (free p))))))

(defun eprintln (s: str) -> unit
  (do (write-str "eprintln" 2i32 s) (write-str "eprintln" 2i32 "\n")))

(defun println (s: str) -> unit
  (do (write-str "println" 1i32 s) (write-str "println" 1i32 "\n")))

;; print-raw writes s without the newline: what the print macro of the
;; library (tranche 1, R5) expands to, and Clojure's print. It was
;; print-str until X3 (tranche 2): print-str is Clojure's name for the
;; macro that returns the text, so a prelude function of that name would
;; be the macro's own head.
(defun print-raw (s: str) -> unit
  (write-str "print-raw" 1i32 s))
