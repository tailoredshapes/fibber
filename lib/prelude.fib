;; fib.prelude: the library of syntax §4.5 that the cases in
;; cases/ownership use, written in fibber over the primitives of syntax
;; §4.3. The expander's own prelude (expand::PRELUDE_SOURCE) comes first
;; and supplies the List enum (variants Empty and Cons) and the derived
;; Eq/Ord/Hash instances of Option and List; their Show is written here,
;; below, because a derived Show cannot print an Option as its payload.
;; The helpers marked :private (syntax §5) are not exported: the trie's
;; nodes and their functions, and the raw write under println, eprintln
;; and print-str.
;;
;; Pair, Triple and Result (stdlib design §2.3, L4) are the library's tuple
;; types: the entry a Map hands to for-each is a Pair, the one tuple type, and
;; map-each and set-each are the walks over a Map and a Set that can stop early.
;;
;; Vec is the persistent vector of types §2.13: a 32-way trie of
;; (Array a) nodes with a tail of up to 32 elements, as in Clojure. A
;; conj copies the tail (at most 32 elements) and, every 32 elements,
;; one path of the trie; nth walks one path. It has an empty variant
;; because (array n x) needs an element to fill with, so no function can
;; make an empty (Array a) for a generic a. The reference interpreter
;; builds and reads this layout natively for Form items and concat
;; (fibref eval/vecs.rs), so a change here must be made there too.

;; Box (syntax §4.5)
(defstruct (Box a) (v: a))
(defun box (x) (Box x))
(defun unbox (b: (Box a)) -> a (. b v))

;; Option helpers (syntax §4.5, Appendix A case 20)
(defun nil? (o) (match o (nil true) ((some _) false)))
(defun some? (o) (match o (nil false) ((some _) true)))
(defun unwrap-or (o d) (match o ((some x) x) (nil d)))

;; hash-combine folds the hash x of the next field into the running hash h
;; (derive Hash and the derived Option and List use it): rotate h left by 7,
;; xor in x and a constant, then eight invertible xorshift steps, a positive
;; amount shl and a negative one shr. Only shl, shr, bit-or and bit-xor,
;; which never trap: the h*31 + x it replaced trapped at two strings. Case
;; 198 tests it against an independent transcription (types §2.12).
(defun hash-xorshift :private (m: i64 s: i64) -> i64
  (if (> s 0) (bit-xor m (shl m s)) (bit-xor m (shr m (- 0 s)))))
(defun hash-combine (h: i64 x: i64) -> i64
  (let ((m (bit-xor (bit-xor (bit-or (shl h 7) (shr h 57)) x) -7046029254386353131))
        (a (hash-xorshift (hash-xorshift (hash-xorshift (hash-xorshift m -36) 11) -15) 23)))
    (hash-xorshift (hash-xorshift (hash-xorshift (hash-xorshift a -2) 31) -39) 15)))

;; Tuples (stdlib design §2.3, §4.3; L4). Pair is the one tuple type: the
;; entry a Map yields, what the library's zip and juxt give. Triple is its
;; three-field twin and Result the value of a function that can fail. Each
;; derives Eq, Ord and Hash; their Show is the library's (fib.print.show prints
;; a Pair as [1 2]), which a derived Show would overlap, so none is derived.
(defstruct (Pair a b) (fst: a snd: b))
(defstruct (Triple a b c) (fst: a snd: b thd: c))
(defenum (Result a b) (Ok v: a) (Err e: b))
(derive Eq Pair) (derive Ord Pair) (derive Hash Pair)
(derive Eq Triple) (derive Ord Triple) (derive Hash Triple)
(derive Eq Result) (derive Ord Result) (derive Hash Result)

;; Protocols (syntax §4.5)
(defprotocol Countable (count (self) -> i64))
(defprotocol (Indexable s e) (nth (self i: i64) -> e))
(defprotocol (Seq s e) (first (self) -> e) (rest (self) -> Self))
(defprotocol (Collection s e) (conj (self x: e) -> Self))
(defprotocol (Traversable s e) (for-each (self f: (fn (e) unit) :borrow) -> unit))
(defprotocol (Iter s e) (next (self) -> (Option e)))

;; Vec
(defenum (VNode a) :private (VLeaf items: (Array a)) (VBranch kids: (Array (VNode a))))
(defenum (Vec a)
  (VecEmpty)
  (VecOf cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a)))

(defun vec-empty () VecEmpty)

(defun array-push :private (items: (Array a) x: a) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (+ n 1) x))))
    (dotimes (i n) (array-set! &c i (array-get items i)))
    @c))

;; A path of branches from level down to node (level 0 is a leaf).
(defun vnode-path :private (level: i64 node: (VNode a)) -> (VNode a)
  (if (= level 0) node (VBranch (array 1 (vnode-path (- level 5) node)))))

;; node, a branch at level, with the leaf whose first index is idx added.
(defun vnode-push :private (level: i64 node: (VNode a) idx: i64 leaf: (VNode a)) -> (VNode a)
  (match node
    ((VLeaf _) (trap "vec: a leaf where a branch belongs"))
    ((VBranch kids)
     (let ((sub (bit-and (shr idx level) 31)))
       (if (= level 5)
           (VBranch (array-push kids leaf))
           (if (< sub (array-len kids))
               (VBranch (array-with kids sub (vnode-push (- level 5) (array-get kids sub) idx leaf)))
               (VBranch (array-push kids (vnode-path (- level 5) leaf)))))))))

(defun vnode-get :private (node: (VNode a) level: i64 i: i64) -> a
  (match node
    ((VLeaf items) (array-get items (bit-and i 31)))
    ((VBranch kids) (vnode-get (array-get kids (bit-and (shr i level) 31)) (- level 5) i))))

;; conj when the tail is full: the tail becomes a leaf of the trie.
(defun vec-push-tail :private (cnt: i64 shift: i64 root: (Option (VNode a)) tail: (Array a) x: a) -> (Vec a)
  (let ((leaf (VLeaf tail))
        (tailoff (- cnt 32)))
    (match root
      (nil (VecOf (+ cnt 1) 5 (some (VBranch (array 1 leaf))) (array 1 x)))
      ((some r)
       (if (= (shr tailoff 5) (shl 1 shift))
           (VecOf (+ cnt 1) (+ shift 5)
                  (some (VBranch (array-push (array 1 r) (vnode-path shift leaf))))
                  (array 1 x))
           (VecOf (+ cnt 1) shift (some (vnode-push shift r tailoff leaf)) (array 1 x)))))))

(defun vec-conj (v: (Vec a) x: a) -> (Vec a)
  (match v
    ((VecEmpty) (VecOf 1 5 nil (array 1 x)))
    ((VecOf cnt shift root tail)
     (if (< (array-len tail) 32)
         (VecOf (+ cnt 1) shift root (array-push tail x))
         (vec-push-tail cnt shift root tail x)))))

(defun vec-count (v: (Vec a)) -> i64
  (match v
    ((VecEmpty) 0)
    ((VecOf cnt _ _ _) cnt)))

(defun vec-nth (v: (Vec a) i: i64) -> a
  (match v
    ((VecEmpty) (trap "nth: index out of range"))
    ((VecOf cnt shift root tail)
     (let ((tailoff (- cnt (array-len tail))))
       (if (or (< i 0) (>= i cnt))
           (trap "nth: index out of range")
           (if (>= i tailoff)
               (array-get tail (- i tailoff))
               (match root
                 (nil (trap "nth: index out of range"))
                 ((some r) (vnode-get r shift i)))))))))

(impl Countable (Vec a)
  (count (self) (vec-count self)))

(impl (Indexable a) (Vec a)
  (nth (self i) (vec-nth self i)))

(impl (Collection a) (Vec a)
  (conj (self x) (vec-conj self x)))

(impl (Traversable a) (Vec a)
  (for-each (self f)
    (dotimes (i (vec-count self)) (f (vec-nth self i)))))

;; List (the enum is in the expander's prelude: Empty and Cons, stdlib design
;; C-3; the library's own `empty` and `cons` are a method and a function)
(impl Countable (List a)
  (count (self)
    (match self
      ((Empty) 0)
      ((Cons _ t) (+ 1 (count t))))))

(impl (Indexable a) (List a)
  (nth (self i)
    (match self
      ((Empty) (trap "nth: index out of range"))
      ((Cons h t) (if (= i 0) h (nth t (- i 1)))))))

(impl (Seq a) (List a)
  (first (self)
    (match self
      ((Empty) (trap "first: empty list"))
      ((Cons h _) h)))
  (rest (self)
    (match self
      ((Empty) Empty)
      ((Cons _ t) t))))

(impl (Collection a) (List a)
  (conj (self x) (Cons x self)))

(impl (Traversable a) (List a)
  (for-each (self f)
    (match self
      ((Empty) ())
      ((Cons h t) (do (f h) (for-each t f))))))

;; Show of Option and List as Clojure prints them (stdlib design §2.7): a
;; present value is its payload's text (a nested Option is as ambiguous as
;; Clojure's nested nil), nil is `nil`, and a List is its elements in
;; parentheses, a space apart: `(1 2)`, `()`. The two are here, not
;; derived, because a derived Show says `(some 3)` and `(Cons 1 (Cons 2
;; Empty))`.
(impl Show (Option a) :where ((Show a))
  (show (self)
    (match self
      (nil "nil")
      ((some x) (show x)))))

(defun list-text :private (l: (List a)) :where ((Show a)) -> str
  (loop ((rest l) (acc "") (first true))
    (match rest
      ((Empty) acc)
      ((Cons h t)
       (recur t (str-concat (if first acc (str-concat acc " ")) (show h)) false)))))

(impl Show (List a) :where ((Show a))
  (show (self) (str-concat "(" (str-concat (list-text self) ")"))))

;; Map: a hash array mapped trie (types §2.13, syntax §4.5) over the
;; keys' hash: 32-way bitmap nodes five bits of the hash at a time, a
;; leaf per key, a bucket for keys whose hashes collide. Keys need Hash
;; and Eq. assoc and dissoc share structure with the previous version.
;; A bucket holds its entries as Pairs (key fst, value snd).
(defenum (MNode k v) :private
  (MLeaf hash: i64 key: k val: v)
  (MColl hash: i64 items: (Array (Pair k v)))
  (MBits bitmap: i64 kids: (Array (MNode k v))))
(defenum (Map k v)
  (MapEmpty)
  (MapOf cnt: i64 root: (MNode k v)))
(defstruct (MRes k v) :private (node: (MNode k v) added: bool))

(defprotocol (Associative m k v)
  (assoc (self key: k val: v) -> Self)
  (get (self key: k) -> (Option v)))

(defun map-empty () MapEmpty)

;; items with x inserted at i, and with element i removed.
(defun array-insert :private (items: (Array a) i: i64 x: a) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (+ n 1) x))))
    (dotimes (j i) (array-set! &c j (array-get items j)))
    (dotimes (j (- n i)) (array-set! &c (+ i (+ j 1)) (array-get items (+ i j))))
    @c))

(defun array-remove :private (items: (Array a) i: i64) -> (Array a)
  (let ((n (array-len items))
        (c (cell (array (- n 1) (array-get items 0)))))
    (dotimes (j i) (array-set! &c j (array-get items j)))
    (dotimes (j (- (- n i) 1)) (array-set! &c (+ i j) (array-get items (+ i (+ j 1)))))
    @c))

(defun mchunk :private (h: i64 shift: i64) -> i64 (bit-and (shr h shift) 31))

;; A node holding two leaves whose hashes differ, below shift.
(defun mnode-two :private (shift: i64 h0: i64 a: (MNode k v) h1: i64 b: (MNode k v)) -> (MNode k v)
  (let ((c0 (mchunk h0 shift))
        (c1 (mchunk h1 shift)))
    (if (= c0 c1)
        (MBits (shl 1 c0) (array 1 (mnode-two (+ shift 5) h0 a h1 b)))
        (if (< c0 c1)
            (MBits (bit-or (shl 1 c0) (shl 1 c1)) (array-push (array 1 a) b))
            (MBits (bit-or (shl 1 c0) (shl 1 c1)) (array-push (array 1 b) a))))))

(defun mcoll-find :private (items: (Array (Pair k v)) key: k) -> i64
  (loop ((i 0))
    (if (>= i (array-len items))
        -1
        (if (= (. (array-get items i) fst) key) i (recur (+ i 1))))))

(defun mnode-get :private (node: (MNode k v) shift: i64 h: i64 key: k) :where ((Eq k)) -> (Option v)
  (match node
    ((MLeaf h0 k0 v0) (if (and (= h0 h) (= k0 key)) (some v0) nil))
    ((MColl h0 items)
     (if (= h0 h)
         (let ((i (mcoll-find items key)))
           (if (< i 0) nil (some (. (array-get items i) snd))))
         nil))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift))))
       (if (= (bit-and bitmap bit) 0)
           nil
           (mnode-get (array-get kids (popcount (bit-and bitmap (- bit 1)))) (+ shift 5) h key))))))

(defun mnode-assoc :private (node: (MNode k v) shift: i64 h: i64 key: k val: v) :where ((Eq k)) -> (MRes k v)
  (match node
    ((MLeaf h0 k0 v0)
     (if (= h0 h)
         (if (= k0 key)
             (MRes (MLeaf h key val) false)
             (MRes (MColl h (array-push (array 1 (Pair k0 v0)) (Pair key val))) true))
         (MRes (mnode-two shift h0 node h (MLeaf h key val)) true)))
    ((MColl h0 items)
     (if (= h0 h)
         (let ((i (mcoll-find items key)))
           (if (< i 0)
               (MRes (MColl h (array-push items (Pair key val))) true)
               (MRes (MColl h (array-with items i (Pair key val))) false)))
         (MRes (mnode-two shift h0 node h (MLeaf h key val)) true)))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift)))
           (idx (popcount (bit-and bitmap (- bit 1)))))
       (if (= (bit-and bitmap bit) 0)
           (MRes (MBits (bit-or bitmap bit) (array-insert kids idx (MLeaf h key val))) true)
           (let ((r (mnode-assoc (array-get kids idx) (+ shift 5) h key val)))
             (MRes (MBits bitmap (array-with kids idx (. r node))) (. r added))))))))

;; The node without key, or nil when that empties it.
(defun mnode-dissoc :private (node: (MNode k v) shift: i64 h: i64 key: k) :where ((Eq k)) -> (Option (MNode k v))
  (match node
    ((MLeaf h0 k0 _) (if (and (= h0 h) (= k0 key)) nil (some node)))
    ((MColl h0 items)
     (let ((i (if (= h0 h) (mcoll-find items key) -1)))
       (if (< i 0)
           (some node)
           (if (= (array-len items) 2)
               (let ((e (array-get items (- 1 i))))
                 (some (MLeaf h0 (. e fst) (. e snd))))
               (some (MColl h0 (array-remove items i)))))))
    ((MBits bitmap kids)
     (let ((bit (shl 1 (mchunk h shift)))
           (idx (popcount (bit-and bitmap (- bit 1)))))
       (if (= (bit-and bitmap bit) 0)
           (some node)
           (match (mnode-dissoc (array-get kids idx) (+ shift 5) h key)
             ((some kid) (some (MBits bitmap (array-with kids idx kid))))
             (nil (if (= (array-len kids) 1)
                      nil
                      (some (MBits (bit-xor bitmap bit) (array-remove kids idx)))))))))))

(defun map-assoc (m: (Map k v) key: k val: v) -> (Map k v)
  (let ((h (hash key)))
    (match m
      ((MapEmpty) (MapOf 1 (MLeaf h key val)))
      ((MapOf cnt root)
       (let ((r (mnode-assoc root 0 h key val)))
         (MapOf (if (. r added) (+ cnt 1) cnt) (. r node)))))))

(defun map-get (m: (Map k v) key: k) -> (Option v)
  (match m
    ((MapEmpty) nil)
    ((MapOf _ root) (mnode-get root 0 (hash key) key))))

(defun dissoc (m: (Map k v) key: k) -> (Map k v)
  (match m
    ((MapEmpty) MapEmpty)
    ((MapOf cnt root)
     (match (mnode-dissoc root 0 (hash key) key)
       (nil MapEmpty)
       ((some r) (if (= (map-count r) (map-count root)) m (MapOf (- cnt 1) r)))))))

(defun map-count :private (node: (MNode k v)) -> i64
  (match node
    ((MLeaf _ _ _) 1)
    ((MColl _ items) (array-len items))
    ((MBits _ kids)
     (loop ((i 0) (n 0))
       (if (< i (array-len kids)) (recur (+ i 1) (+ n (map-count (array-get kids i)))) n)))))

(defun contains? (m: (Map k v) key: k) -> bool (some? (map-get m key)))

(defun mnode-for-each :private (node: (MNode k v) f: (fn ((Pair k v)) unit) :borrow) -> unit
  (match node
    ((MLeaf _ k0 v0) (f (Pair k0 v0)))
    ((MColl _ items) (dotimes (i (array-len items)) (f (array-get items i))))
    ((MBits _ kids) (dotimes (i (array-len kids)) (mnode-for-each (array-get kids i) f)))))

;; The walk that can stop (stdlib design §4.2, L4): f is given each key and
;; its value, in the trie's order, and says whether to go on; the result is
;; whether the walk ran to the end. No Pair is built, unlike for-each's.
(defun mnode-each :private (node: (MNode k v) f: (fn (k v) bool) :borrow) -> bool
  (match node
    ((MLeaf _ k0 v0) (f k0 v0))
    ((MColl _ items)
     (loop ((i 0))
       (if (< i (array-len items))
           (let ((e (array-get items i)))
             (if (f (. e fst) (. e snd)) (recur (+ i 1)) false))
           true)))
    ((MBits _ kids)
     (loop ((i 0))
       (if (< i (array-len kids))
           (if (mnode-each (array-get kids i) f) (recur (+ i 1)) false)
           true)))))

(defun map-each (m: (Map k v) f: (fn (k v) bool) :borrow) -> bool
  (match m
    ((MapEmpty) true)
    ((MapOf _ root) (mnode-each root f))))

(impl (Associative k v) (Map k v) :where ((Hash k) (Eq k))
  (assoc (self key val) (map-assoc self key val))
  (get (self key) (map-get self key)))

(impl Countable (Map k v)
  (count (self) (match self ((MapEmpty) 0) ((MapOf cnt _) cnt))))

(impl (Traversable (Pair k v)) (Map k v)
  (for-each (self f)
    (match self
      ((MapEmpty) ())
      ((MapOf _ root) (mnode-for-each root f)))))

;; In-place updates through & (syntax §3.13).
(defun map-put! (&m key val) (set! m (assoc @m key val)))
(defun map-del! (&m key) (set! m (dissoc @m key)))

;; Set: the keys of a Map.
(defstruct (Set k) (m: (Map k bool)))

(defun set-empty () (Set MapEmpty))
(defun set-contains? (s: (Set k) x: k) -> bool (contains? (. s m) x))
(defun disj (s: (Set k) x: k) -> (Set k) (Set (dissoc (. s m) x)))

(impl (Collection k) (Set k) :where ((Hash k) (Eq k))
  (conj (self x) (Set (assoc (. self m) x true))))

(impl Countable (Set k)
  (count (self) (count (. self m))))

(impl (Traversable k) (Set k)
  (for-each (self f) (for-each (. self m) (fn (e) (f (. e fst))))))

;; The elements of a Set, as map-each walks a Map: f says whether to go on.
;; The call is bound before it is returned: a closure given to a call in tail
;; position is a heap closure (types §6.10), which would capture the borrowed f.
(defun set-each (s: (Set k) f: (fn (k) bool) :borrow) -> bool
  (let ((r (map-each (. s m) (fn (x y) (f x))))) r))

;; Strings
(impl Countable str
  (count (self) (str-len self)))

(defun length (s: str) -> i64 (str-len s))

;; Building and characters (M5): str-join concatenates a vector of
;; strings in one allocation; str-chars decodes the UTF-8 bytes into
;; chars; char->str encodes one char.
(defun str-join (parts: (Vec str)) -> str
  (let ((n (count parts))
        (total (loop ((i 0) (t 0))
                 (if (< i n) (recur (+ i 1) (+ t (str-len (nth parts i)))) t)))
        (c (cell (array total 0i8))))
    (loop ((i 0) (pos 0))
      (if (< i n)
          (let ((bs (str-bytes (nth parts i))))
            (dotimes (j (array-len bs)) (array-set! &c (+ pos j) (array-get bs j)))
            (recur (+ i 1) (+ pos (array-len bs))))
          ()))
    (str-from-bytes @c)))

(defun utf8-len :private (b: i32) -> i64
  (if (< b 128i32) 1 (if (< b 224i32) 2 (if (< b 240i32) 3 4))))

(defun utf8-code :private (bs: (Array i8) i: i64 b: i32 len: i64) -> i32
  (if (= len 1)
      b
      (let ((c1 (bit-and (zext i32 (array-get bs (+ i 1))) 63i32)))
        (if (= len 2)
            (bit-or (shl (bit-and b 31i32) 6i32) c1)
            (let ((c2 (bit-and (zext i32 (array-get bs (+ i 2))) 63i32)))
              (if (= len 3)
                  (bit-or (shl (bit-and b 15i32) 12i32) (bit-or (shl c1 6i32) c2))
                  (let ((c3 (bit-and (zext i32 (array-get bs (+ i 3))) 63i32)))
                    (bit-or (shl (bit-and b 7i32) 18i32)
                            (bit-or (shl c1 12i32) (bit-or (shl c2 6i32) c3))))))))))

(defun str-chars (s: str) -> (Vec char)
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n)
          (let ((b (zext i32 (array-get bs i)))
                (len (utf8-len b)))
            (recur (+ i len) (conj acc (i32->char (utf8-code bs i b len)))))
          acc))))

(defun char->str (c: char) -> str
  (let ((code (char->i32 c))
        (cont (fn (sh: i32) (trunc i8 (bit-or 128i32 (bit-and (shr code sh) 63i32))))))
    (str-from-bytes
      (if (< code 128i32)
          (array 1 (trunc i8 code))
          (if (< code 2048i32)
              (array-push (array 1 (trunc i8 (bit-or 192i32 (shr code 6i32)))) (cont 0i32))
              (if (< code 65536i32)
                  (array-push (array-push (array 1 (trunc i8 (bit-or 224i32 (shr code 12i32)))) (cont 6i32)) (cont 0i32))
                  (array-push (array-push (array-push (array 1 (trunc i8 (bit-or 240i32 (shr code 18i32)))) (cont 12i32)) (cont 6i32)) (cont 0i32))))))))

;; Iterators
(defstruct (VecIter a) (vec: (Vec a) pos: (Cell i64)))

(defun iter (v: (Vec a)) -> (VecIter a) (VecIter v (cell 0)))

(impl (Iter a) (VecIter a)
  (next (self)
    (let ((i @(. self pos)))
      (if (< i (count (. self vec)))
          (do (set! (. self pos) (+ i 1))
              (some (nth (. self vec) i)))
          nil))))

(defstruct (FilterIter i e) (inner: i pred: (fn (e) bool)))

(defun filter-iter (it: i p: (fn (e) bool)) :where ((Iter i e)) -> (FilterIter i e)
  (FilterIter it p))

(impl (Iter e) (FilterIter i e) :where ((Iter i e))
  (next (self)
    (loop ()
      (match (next (. self inner))
        (nil nil)
        ((some x) (if ((. self pred) x) (some x) (recur)))))))

(defun collect (it)
  (loop ((acc (vec-empty)))
    (match (next it)
      (nil acc)
      ((some x) (recur (conj acc x))))))

;; Sequences of numbers and whole-vector operations
(defun even? (n: i64) -> bool (= (rem n 2) 0))

(defun range-between (a: i64 b: i64) -> (Vec i64)
  (loop ((i a) (acc (vec-empty)))
    (if (< i b) (recur (+ i 1) (vec-conj acc i)) acc)))

;; (range n) is (range 0 n); (range a b) is the prelude macro's rewrite
;; to range-between (syntax §4.4, §4.5).
(defun range (n: i64) -> (Vec i64) (range-between 0 n))

(defun map (f v: (Vec a))
  (let ((n (vec-count v)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n) (recur (+ i 1) (vec-conj acc (f (vec-nth v i)))) acc))))

;; In-place updates through & (syntax §3.13): append is push!.
(defun push! (&v x) (set! v (conj @v x)))
(defun append (&v x) (push! &v x))

;; Threads and tasks (syntax §3.12, §3.14)
;; pmap spawns one task per element and joins them in order; it is written
;; over spawn and join alone, so that the Vec-only map can go (stdlib design §8.3 C).
(defun pmap (f: (fn :send (a) b) xs: (Vec a)) -> (Vec b)
  (let ((n (vec-count xs))
        (tasks (loop ((i 0) (acc (vec-empty)))
                 (if (< i n)
                     (let ((x (vec-nth xs i))) (recur (+ i 1) (vec-conj acc (spawn (fn () (f x))))))
                     acc))))
    (loop ((i 0) (out (vec-empty)))
      (if (< i n) (recur (+ i 1) (vec-conj out (join (vec-nth tasks i)))) out))))

(defun yield () -> (Task unit) (async ()))
(defun block-on (t) (join t))
(defun panic (msg: str) (trap msg))

;; I/O (syntax §4.5): println and eprintln write s and a newline to fd 1
;; and fd 2 through the C write(2), copying the string's bytes to a raw
;; buffer first. write may take fewer bytes than it is given, so each
;; string is written in a loop until every byte has gone, and a call
;; that fails (-1) or makes no progress (0 bytes of a non-empty rest,
;; which would loop for ever) is the trap `NAME: write failed`, NAME
;; being the function the program called.
(extern write :private (i32 ptr i64) -> i64)

;; The n bytes at p to fd, from the first to the last.
(defun write-bytes :private (who: str fd: i32 p: ptr n: i64) -> unit
  (unsafe
    (loop ((done 0))
      (if (< done n)
          (let ((w (write fd (ptr+ p done) (- n done))))
            (if (> w 0)
                (recur (+ done w))
                (trap (str-concat who ": write failed"))))
          ()))))

(defun write-str :private (who: str fd: i32 s: str) -> unit
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc n)))
        (do (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
            (write-bytes who fd p n)
            (free p))))))

(defun eprintln (s: str) -> unit
  (do (write-str "eprintln" 2i32 s) (write-str "eprintln" 2i32 "\n")))

(defun println (s: str) -> unit
  (do (write-str "println" 1i32 s) (write-str "println" 1i32 "\n")))

;; print-str writes s without the newline: what the print macro of the
;; library (tranche 1, R5) expands to, and Clojure's print.
(defun print-str (s: str) -> unit
  (write-str "print-str" 1i32 s))
