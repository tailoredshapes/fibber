;; Double (package FOLLOWUP-1): the names of java.lang.Double that Clojure code writes (stdlib §4.3 row Double/parseDouble). Required with its own name,
;; (:require [Double :as Double]). Traps on a malformed string with Java's NumberFormatException text (`For input string: "x"`, `empty String` for ""); the grammar is
;; parse-double's (fib.core.decimal), which is the Option twin.
(ns Double (:use fib.core))

(defun parseDouble (s: str) -> f64
  (match (parse-double s)
    ((some x) x)
    (nil (trap (if (= (str-len s) 0) "empty String" (str "For input string: \"" s "\""))))))
