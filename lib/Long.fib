;; Long (owner L12): the names of java.lang.Long that Clojure code writes (stdlib §2.8, §4.3 rows
;; Long/MAX_VALUE and Long/MIN_VALUE, §4.1 row Long/bitCount). The module is `:require`d with its own
;; name, (:require [Long :as Long]), and used as Long/MAX_VALUE and (Long/bitCount x); the Java class
;; names become implicit aliases only with E15 (tranche 4). Not under fib.*: it is a Java name, and it
;; takes no implicit :use after the flip (plan §4.1), so it needs none.
;;
;; Decided here: bitCount takes an i64 and returns an i64. Row Long/bitCount writes `t -> t | Bits t`,
;; the width of the builtin popcount, but Java's Long.bitCount widens an int to a long first, so a
;; generic one would answer 32 for (Long/bitCount -1i32) where Java answers 64. An i64 only has the
;; one answer, and a narrower integer is refused by the checker (nothing widens) instead of being
;; counted at the wrong width.
(ns Long (:use fib.core))

(def MAX_VALUE: i64 9223372036854775807)
(def MIN_VALUE: i64 -9223372036854775808)

(defun bitCount (x: i64) -> i64 (popcount x))

;; (Long/parseLong s) and (Long/parseLong s radix) (stdlib §4.3 row, package FOLLOWUP-1): traps with Java's NumberFormatException text, `For input string: "x"` (radix 10)
;; or `For input string: "x" under radix 16`; `parse-long` is the nil-returning one and `try-parse-long` the radix twin.
(defn parseLong
  ([s: str] -> i64
    (match (try-parse-long s) ((some v) v) (nil (trap (str "For input string: \"" s "\"")))))
  ([s: str radix: i64] -> i64
    (if (< radix 2)
        (trap (str "radix " radix " less than Character.MIN_RADIX"))
        (if (> radix 36)
            (trap (str "radix " radix " greater than Character.MAX_RADIX"))
            (match (try-parse-long s radix) ((some v) v) (nil (trap (str "For input string: \"" s "\" under radix " radix))))))))
