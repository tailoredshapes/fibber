;; Darwin implementation of the same internal backend interface.
(ns fib.os.backend (:require [fib.os.abi-data :as a]))
(extern __error :private () -> ptr)
(extern socket :private (i32 i32 i32) -> i32)
(extern accept :private (i32 ptr ptr) -> i32)
(extern pipe :private (ptr) -> i32)
(extern fcntl :private (i32 i32 i64) -> i32 :varargs :fixed 2)
(extern close :private (i32) -> i32)
(extern readdir :private (ptr) -> ptr)
(extern _NSGetExecutablePath :private (ptr ptr) -> i32)
(extern strlen :private (ptr) -> i64)
(extern getpid :private () -> i32)
(extern proc_pidinfo :private (i32 i32 i64 ptr i32) -> i32)
;; Bound to the runtime's own definition (rt/thread.lir `fib_guard_ctl`): op 2 answers how many threads the runtime parks (the first thread of the process while main runs on a stack it made).
(extern fib_guard_ctl :private (i64 i64) -> i64)
(def abi: a/Abi (a/darwin-abi))
(def platform-name: str "Darwin")
(defun errno () -> i64 (unsafe (sext i64 (load-i32 (__error)))))
(defun clear-errno () -> unit (unsafe (store-i32 (__error) 0i32)))
(defun directory-next (directory: ptr) -> ptr (unsafe (readdir directory)))
(defun executable-path (buffer: ptr size: i64) -> i64
  (unsafe (let [slot (alloc 4)]
    (do (store-i32 slot (trunc i32 size))
      (let [result (_NSGetExecutablePath buffer slot)]
        (do (free slot) (if (= result 0i32) (strlen buffer) -34)))))))
(defun configure :private (fd: i32) -> i64
  (unsafe (let [flags (fcntl fd 3i32 0)]
    (if (and (>= flags 0i32) (>= (fcntl fd 2i32 1) 0i32)
             (>= (fcntl fd 4i32 (bit-or (sext i64 flags) 4)) 0i32)) (sext i64 fd)
      (let [saved (errno)] (do (close fd) (- 0 saved)))))))
(defun socket-new (family: i64) -> i64
  (let [fd (unsafe (socket (trunc i32 family) 1i32 0i32))]
    (if (< fd 0i32) (- 0 (errno)) (configure fd))))
(defun socket-new-datagram (family: i64) -> i64
  (let [fd (unsafe (socket (trunc i32 family) 2i32 0i32))]
    (if (< fd 0i32) (- 0 (errno)) (configure fd))))
(defun socket-accept (fd: i64 address: ptr size: ptr) -> i64
  (let [accepted (unsafe (accept (trunc i32 fd) address size))]
    (if (< accepted 0i32) (- 0 (errno)) (configure accepted))))
(defun pipe-cloexec (fds: ptr) -> i32
  (unsafe (let [made (pipe fds)]
    (if (< made 0i32) (trunc i32 (- 0 (errno)))
      (let [read-fd (load-i32 fds) write-fd (load-i32 (ptr+ fds 4))]
        (if (and (>= (fcntl read-fd 2i32 1) 0i32) (>= (fcntl write-fd 2i32 1) 0i32)) 0i32
          (let [saved (errno)] (do (close read-fd) (close write-fd) (trunc i32 (- 0 saved))))))))))
;; This process's own numbers from `proc_pidinfo(PROC_PIDTASKINFO)`, the struct proc_taskinfo of 96 bytes (<sys/proc_info.h>): pti_resident_size at 8, pti_threadnum (int) at 84.
;; field 0: the threads of the process other than the parked first thread (what /proc/self/task gives on Linux, fib.os.process thread-count); 1: the resident set in bytes. -1 when the kernel refuses.
(defun task-info (field: i64) -> i64
  (unsafe (let [buf (alloc 96) n (proc_pidinfo (getpid) 4i32 0 buf 96i32)
                v (cond (< n 96i32) -1
                        (= field 0) (- (sext i64 (load-i32 (ptr+ buf 84))) (fib_guard_ctl 2 0))
                        (= field 1) (load-i64 (ptr+ buf 8))
                        :else -1)]
            (do (free buf) v))))
