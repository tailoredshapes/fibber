;; Integer (package FOLLOWUP-1): the names of java.lang.Integer that Clojure code writes (stdlib §4.3 row Integer/parseInt). Required with its own name,
;; (:require [Integer :as Integer]), and used as (Integer/parseInt s) or (Integer/parseInt s radix). Traps with Java's NumberFormatException texts:
;; `For input string: "x"` (radix 10), `For input string: "x" under radix 16`, `radix 1 less than Character.MIN_RADIX`, `radix 37 greater than Character.MAX_RADIX`;
;; `try-parse-int` (fib.core) is the Option twin.
(ns Integer (:use fib.core))

(defn parseInt
  ([s: str] -> i32
    (match (try-parse-int s) ((some v) v) (nil (trap (str "For input string: \"" s "\"")))))
  ([s: str radix: i64] -> i32
    (if (< radix 2)
        (trap (str "radix " radix " less than Character.MIN_RADIX"))
        (if (> radix 36)
            (trap (str "radix " radix " greater than Character.MAX_RADIX"))
            (match (try-parse-int s radix) ((some v) v) (nil (trap (str "For input string: \"" s "\" under radix " radix))))))))
