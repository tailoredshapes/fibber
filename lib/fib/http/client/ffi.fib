;; libcurl >= 7.85; bounded native streams come from fib.os.
(ns fib.http.client.ffi (:use fib.core fib.http.types)
  (:require [fib.http.native :as n] [fib.os.memory-stream :as m]))
(extern curl_global_init :private (i64) -> i32 :lib "curl")
(extern curl_global_cleanup :private () -> unit :lib "curl")
(extern curl_easy_init :private () -> i64 :lib "curl")
(extern curl_easy_cleanup :private (i64) -> unit :lib "curl")
(extern curl_easy_reset :private (i64) -> unit :lib "curl")
;; Stage 2 types the declared prefix at a :varargs call. All options here
;; use LP64 integer/pointer registers, so declare the third word explicitly,
;; as the compiler's own bindings do for opaque pointer handles.
(extern curl_easy_setopt :private (i64 i32 i64) -> i32 :varargs :fixed 2 :lib "curl")
(extern curl_easy_perform :private (i64) -> i32 :lib "curl")
(extern curl_easy_getinfo :private (i64 i32 ptr) -> i32 :varargs :fixed 2 :lib "curl")
(extern curl_easy_strerror :private (i32) -> ptr :lib "curl")
(extern curl_slist_append :private (i64 ptr) -> i64 :lib "curl")
(extern curl_slist_free_all :private (i64) -> unit :lib "curl")
(defstruct Buffer (stream: m/Stream))
(defun curl-error (code: i32) -> Error
  (TransportError (sext i64 code) (unsafe (n/c-string (curl_easy_strerror code)))))
(defun checked :private (code: i32) -> (Result unit Error)
  (if (= code 0i32) (Ok ()) (Err (curl-error code))))
(defun open-handle () -> (Result i64 Error)
  (try-let [_ (checked (unsafe (curl_global_init 3)))]
    (let [handle (unsafe (curl_easy_init))]
      (if (= handle 0) (do (unsafe (curl_global_cleanup)) (Err (TransportError 2 "cannot allocate HTTP client")))
          (Ok handle)))))
(defun close-handle (handle: i64) -> unit
  (unsafe (do (curl_easy_cleanup handle) (curl_global_cleanup))))
(defun reset-handle (handle: i64) -> unit (unsafe (curl_easy_reset handle)))
(defun set-long (handle: i64 option: i32 value: i64) -> (Result unit Error)
  (checked (unsafe (curl_easy_setopt handle option value))))
(defun set-pointer (handle: i64 option: i32 p: ptr) -> (Result unit Error)
  (checked (unsafe (curl_easy_setopt handle option (n/address p)))))
(defun set-text (handle: i64 option: i32 value: str) -> (Result unit Error)
  (let [p (n/c-text value) result (set-pointer handle option p)] (unsafe (do (free p) result))))
(defun set-body (handle: i64 bytes: (Array i8)) -> (Result unit Error)
  (try-let [_ (set-long handle 60i32 (array-len bytes))]
    (let [p (n/bytes-new bytes) result (set-pointer handle 10165i32 p)] (unsafe (do (free p) result)))))
(defun append-header (list: i64 line: str) -> (Result i64 Error)
  (let [p (n/c-text line) next (unsafe (curl_slist_append list p))]
    (unsafe (do (free p) (if (= next 0) (Err (TransportError 27 "cannot allocate HTTP headers")) (Ok next))))))
(defun free-headers (list: i64) -> unit (unsafe (curl_slist_free_all list)))
(defun open-buffer (limit: i64) -> (Result Buffer Error)
  (match (m/open-stream limit) ((Ok stream) (Ok (Buffer stream))) ((Err error) (Err (n/os-error error)))))
(defun buffer-full? (b: Buffer) -> bool (m/full? (. b stream)))
(defun buffer-bytes (b: Buffer) -> (Result (Array i8) Error)
  (match (m/bytes (. b stream)) ((Ok bytes) (Ok bytes)) ((Err error) (Err (n/os-error error)))))
(defun buffer-pointer (b: Buffer) -> (Result ptr Error)
  (match (m/native-handle (. b stream)) ((Ok pointer) (Ok pointer)) ((Err error) (Err (n/os-error error)))))
(defun close-buffer (b: Buffer) -> unit (do (m/close-stream (. b stream)) ()))
(defun perform (handle: i64) -> (Result unit Error) (checked (unsafe (curl_easy_perform handle))))
(defun status (handle: i64) -> (Result i64 Error)
  (unsafe (let [slot (alloc 8) code (curl_easy_getinfo handle 2097154i32 slot) value (load-i64 slot)]
    (do (free slot) (if (= code 0i32) (Ok value) (Err (curl-error code)))))))
