;; The public client: the shape of the libcurl client it replaces (request, get, post, build-http-client, request-with, request-async, close),
;; plus the stream (request-stream), the pool statistics and the options of fib.http.client.types. Local closures keep the pool private and
;; the client on one thread.
(ns fib.http.client.api (:use fib.core fib.seq fib.coll fib.http.types fib.http.headers fib.http.bytes fib.http.url fib.http.body
                              fib.http.client.types fib.http.client.pool fib.http.client.run)
  (:require [fib.string :as s]))
(defun last-coding :private (headers: (Map str (Vec str))) -> str
  (match (header headers "content-encoding")
    (nil "") ((some v) (let [parts (s/split v "," -1)] (ascii-lower (trim-ows (nth parts (- (count parts) 1))))))))
(defun decode :private (o: Options headers: (Map str (Vec str)) bytes: (Array i8)) -> (Result (Array i8) Error)
  (let [coding (last-coding headers)
        found (some-p (fn (d: Decoder) (if (= (. d name) coding) (some d) nil)) (. o decoders))]
    (if (or (not (. o decompress)) (= coding "")) (Ok bytes)
      (match found (nil (Ok bytes)) ((some d) ((. d decode) bytes))))))
(defun finish :private (st: State sr: StreamResponse) -> (Result Response Error)
  (let [o (. st options)]
    (match (read-all (. sr body) (. o max-response-bytes))
      ((Err e) (do ((. sr abandon)) (Err e)))
      ((Ok bytes) (try-let [plain (decode o (. sr headers) bytes)]
        (let [response (Response (. sr status) (. sr headers) plain)]
          (if (and (. o throw-exceptions) (>= (. sr status) 400)) (Err (StatusError response)) (Ok response))))))))
(defun execute :private (st: State request: ClientRequest) -> (Result Response Error)
  (try-let [sr (start st request)] (finish st sr)))
(defun close-state :private (st: State) -> unit (do (set! (. st closed) true) (close-all (. st pool))))
(defun build-http-client (o: Options) -> (Result Client Error)
  (if (not (valid-options? o)) (Err (InvalidRequest "invalid HTTP client options"))
    (let [st (State o (new-pool) (cell false))]
      (Ok (Client (fn (r: ClientRequest) (execute st r)) (fn () (close-state st)) (fn () (stats (. st pool)))
                  (fn (r: ClientRequest) (start st r)))))))
(defun close-http-client (client: Client) -> unit ((. client close)))
(defun pool-stats (client: Client) -> PoolStats ((. client stats)))
(defun request-with (client: Client request: ClientRequest) -> (Result Response Error) ((. client execute) request))
;; The response before its body is read: read it with fib.http.body/next-chunk or abandon it. Redirects are followed under the options.
(defun request-stream (client: Client request: ClientRequest) -> (Result StreamResponse Error) ((. client stream) request))
(defun request (request: ClientRequest o: Options) -> (Result Response Error)
  (try-let [client (build-http-client o)]
    (let [result (request-with client request)] (do (close-http-client client) result))))
(defun request-async (req: ClientRequest o: Options) -> (Task (Result Response Error))
  (spawn (fn () (request req o))))
(defn get
  ([url: str] -> (Result Response Error) (request (ClientRequest "GET" url {} (array 0 0i8)) (default-options)))
  ([url: str o: Options] -> (Result Response Error) (request (ClientRequest "GET" url {} (array 0 0i8)) o)))
(defn post
  ([url: str body: str] -> (Result Response Error)
    (request (ClientRequest "POST" url {} (str-bytes body)) (default-options)))
  ([url: str body: str o: Options] -> (Result Response Error) (request (ClientRequest "POST" url {} (str-bytes body)) o)))
(defun form-request (method: str url: str params: (Vec (Pair str str))) -> ClientRequest
  (ClientRequest method url {"content-type" ["application/x-www-form-urlencoded"]} (form-body params)))
(defun head (url: str o: Options) -> (Result Response Error)
  (request (ClientRequest "HEAD" url {} (array 0 0i8)) o))
(defun put (url: str body: str o: Options) -> (Result Response Error)
  (request (ClientRequest "PUT" url {} (str-bytes body)) o))
(defun patch (url: str body: str o: Options) -> (Result Response Error)
  (request (ClientRequest "PATCH" url {} (str-bytes body)) o))
(defun delete (url: str o: Options) -> (Result Response Error)
  (request (ClientRequest "DELETE" url {} (array 0 0i8)) o))
(defun bearer-auth (request: ClientRequest token: str) -> ClientRequest
  (with request (headers (header-set (. request headers) "authorization" (str "Bearer " token)))))
(defun basic-auth (request: ClientRequest username: str password: str) -> ClientRequest
  (with request (headers (header-set (. request headers) "authorization"
    (str "Basic " (base64-encode (str-bytes (str username ":" password))))))))
(defun wrap-header (handler: (fn :send (ClientRequest) (Result Response Error)) name: str value: str)
  -> (fn :send (ClientRequest) (Result Response Error))
  (fn (r: ClientRequest) (handler (with r (headers (header-set (. r headers) name value))))))
