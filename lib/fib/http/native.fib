;; HTTP adapts the shared OS errors to its protocol error model.
(ns fib.http.native (:use fib.http.types) (:export-from fib.os.native)
  (:require [fib.os.errors :as os]))
(defun os-error (error: os/OSError) -> Error
  (match (. error kind) ((os/LimitExceeded) (LimitError (. error message)))
    ((os/Cancelled) Cancelled) (_ (TransportError (. error code) (. error message)))))
