;; Protocol-independent socket operations belong to fib.os.net.
(ns fib.http.server.transport (:use fib.core fib.http.types)
  (:require [fib.os.net :as net] [fib.os.io :as io] [fib.os.errors :as os] [fib.http.native :as n]))
(defun close-fd (fd: i64) -> unit (do (io/close-fd fd) ()))
(defun open-listener (host: str port: i64 backlog: i64) -> (Result net/Listener Error)
  (match (net/listen-tcp host port backlog) ((Ok listener) (Ok listener)) ((Err error) (Err (n/os-error error)))))
(defun accept-connection (fd: i64) -> (Result net/Accepted Error)
  (match (net/accept-tcp fd) ((Ok accepted) (Ok accepted)) ((Err error) (Err (n/os-error error)))))
(defun ready? (fd: i64 writing: bool timeout-ms: i64) -> (Result bool Error)
  (match (net/ready? fd writing timeout-ms) ((Ok ready) (Ok ready)) ((Err error) (Err (n/os-error error)))))
(defun read-available (fd: i64) -> (Result (Array i8) Error)
  (loop [] (match (io/read-fd fd 4096)
    ((Ok bytes) (Ok bytes)) ((Err error)
      (if (= (. error kind) os/Interrupted) (recur) (Err (n/os-error error)))))))
(defun wait-readable (fd: i64 deadline: i64 stop: (Atom bool)) -> (Result unit Error)
  (match (net/wait-readable fd deadline stop) ((Ok _) (Ok ())) ((Err error) (Err (n/os-error error)))))
(defun send-all (fd: i64 bytes: (Array i8) timeout-ms: i64 stop: (Atom bool)) -> (Result unit Error)
  (match (net/send-all fd bytes timeout-ms stop) ((Ok _) (Ok ())) ((Err error) (Err (n/os-error error)))))
