;; The Date header (RFC 9110 5.6.7: IMF-fixdate) computed from the wall clock in fibber: no extern here (ADR 0011), the civil-from-days
;; arithmetic is H. Hinnant's. fib.os.time supplies the clock.
(ns fib.http.server.date (:use fib.core fib.seq fib.coll) (:require [fib.os.time :as u]))
(def days: (Vec str) ["Sun" "Mon" "Tue" "Wed" "Thu" "Fri" "Sat"])
(def months: (Vec str) ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"])
(defun two :private (n: i64) -> str (if (< n 10) (str "0" n) (str n)))
;; IMF-fixdate of a count of seconds since the Unix epoch (non-negative).
(defun format-date (seconds: i64) -> str
  (let [days-since (quot seconds 86400) rest (rem seconds 86400)
        z (+ days-since 719468) era (quot z 146097) doe (- z (* era 146097))
        yoe (quot (- (+ (- doe (quot doe 1460)) (quot doe 36524)) (quot doe 146096)) 365)
        doy (- doe (- (+ (* 365 yoe) (quot yoe 4)) (quot yoe 100)))
        mp (quot (+ (* 5 doy) 2) 153) d (+ (- doy (quot (+ (* 153 mp) 2) 5)) 1)
        m (if (< mp 10) (+ mp 3) (- mp 9)) y (+ (+ yoe (* era 400)) (if (<= m 2) 1 0))]
    (str (nth days (rem (+ days-since 4) 7)) ", " (two d) " " (nth months (- m 1)) " " y " "
         (two (quot rest 3600)) ":" (two (quot (rem rest 3600) 60)) ":" (two (rem rest 60)) " GMT")))
(defun http-date () -> str (format-date (quot (u/wall-now) 1000000000)))
