;; Middleware is ordinary function composition over immutable messages.
(ns fib.http.server.middleware (:use fib.core fib.http.types fib.http.bytes))
(defun wrap-header (handler: (fn :send (Request) Response) name: str value: str) -> (fn :send (Request) Response)
  (fn (request: Request) (with-header (handler request) name value)))
