;; One connection: a loop of requests over a Transport, on the task that owns it. Between requests the connection waits in slices of 100 ms so a
;; graceful stop (stop is set) closes it promptly; a request in flight is always finished. Deadlines are armed before every wait: idle, then the
;; head (absolute from its first byte), then the body.
(ns fib.http.server.connection (:use fib.core fib.seq fib.coll fib.http.types fib.http.headers fib.http.bytes fib.http.wire
                                     fib.http.transport fib.http.reader fib.http.body fib.http.server.types fib.http.server.reply)
  (:require [fib.os.time :as time]))
(defun ms (n: i64) -> i64 (* n 1000000))
(defun await-request :private (t: Transport r: Reader o: Options stop: (Atom bool)) -> (Result bool Error)
  (let [limit (+ (time/clock-now) (ms (. o idle-timeout-ms)))]
    (loop []
      (cond (or @stop (>= (time/clock-now) limit)) (Ok false)
            :else (do (t-deadline t (min limit (+ (time/clock-now) (ms 100))))
                      (match (fill r) ((Ok b) (Ok b)) ((Err (Timeout _ _)) (recur)) ((Err e) (Err e))))))))
(defun acknowledge :private (t: Transport head: RequestHead mode: BodyMode) -> (Result unit Error)
  (let [values (header-values (. head headers) "expect")]
    (cond (= (count values) 0) (Ok ())
          (and (= (count values) 1) (= (ascii-lower (nth values 0)) "100-continue"))
          (match mode ((NoBody) (Ok ())) (_ (t-write t (str-bytes "HTTP/1.1 100 Continue\r\n\r\n"))))
          :else (Err (ProtocolError "unsupported HTTP expectation")))))
(defun read-request :private (t: Transport r: Reader head: RequestHead o: Options peer: str) -> (Result Request Error)
  (try-let [_ (if (and (= (. head version) "HTTP/1.0") (some? (header (. head headers) "transfer-encoding")))
                  (Err (ProtocolError "HTTP/1.0 request cannot use Transfer-Encoding")) (Ok ()))
            mode (request-framing (. head headers) (. o max-body-bytes))
            _ (acknowledge t head mode)
            _ (Ok (t-deadline t (+ (time/clock-now) (ms (. o request-timeout-ms)))))
            bd (Ok (body-reader r mode (. o max-body-bytes) (. o max-header-bytes)))
            b (read-all bd (. o max-body-bytes))]
    (Ok (Request (. head request-method) (. head uri) (. head query-string) (. head headers) b (trailers bd) (. head version) peer (. o port)))))
(defun failure-status :private (error: Error) -> i64
  (match error
    ((LimitError s) (if (or (some? (str-find s "header" 0)) (some? (str-find s "line" 0))) 431 413))
    ((Timeout _ _) 408)
    ((ProtocolError s) (cond (= s "unsupported HTTP expectation") 417 (= s "unsupported HTTP transfer encoding") 501 :else 400))
    (_ 400)))
(defun fail :private (t: Transport error: Error o: Options) -> unit
  (match error ((Cancelled) ()) ((Closed) ()) ((TransportError _ _) ())
    (_ (do (t-deadline t (+ (time/clock-now) (ms (. o request-timeout-ms))))
           (error-reply t (failure-status error) (error-message error))))))
(defun keep? :private (head: RequestHead reply: Reply number: i64 o: Options stop: (Atom bool)) -> bool
  (and (keep-alive? head) (< number (. o max-requests-per-connection)) (not @stop)
       (match reply ((Whole r) (not (header-token? (. r headers) "connection" "close"))) (_ true))))
(defun handle-one :private (t: Transport r: Reader text: str handler: (fn :send (Request) Reply) o: Options peer: str
                            stop: (Atom bool) number: i64) -> (Result bool Error)
  (try-let [head (parse-request-head text (. o max-header-bytes) (. o max-headers)) request (read-request t r head o peer)]
    (let [reply (handler request) keep (keep? head reply number o stop)]
      (do (t-deadline t (+ (time/clock-now) (ms (. o request-timeout-ms))))
          (try-let [_ (send-reply t reply (. head request-method) keep (. head version))] (Ok keep))))))
(defun head-of :private (t: Transport r: Reader o: Options) -> (Result (Option str) Error)
  (do (t-deadline t (+ (time/clock-now) (ms (. o header-timeout-ms))))
      (read-head r (. o max-header-bytes) (. o max-line-bytes) (+ (. o max-headers) 1))))
(defun serve-connection (t: Transport handler: (fn :send (Request) Reply) o: Options stop: (Atom bool)) -> unit
  (let [r (reader t)]
    (loop [number 1]
      (match (await-request t r o stop)
        ((Ok false) ())
        ((Err _) ())
        ((Ok true)
          (match (head-of t r o)
            ((Err error) (fail t error o))
            ((Ok nil) ())
            ((Ok (some text))
              (match (handle-one t r text handler o (. t peer) stop number)
                ((Err error) (fail t error o))
                ((Ok keep) (if keep (recur (+ number 1)) ()))))))))))
