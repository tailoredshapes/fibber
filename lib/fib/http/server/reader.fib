;; One buffered reader per connection. Its cells never cross a thread boundary.
(ns fib.http.server.reader (:use fib.core fib.seq fib.coll fib.http.types fib.http.bytes)
  (:require [fib.http.server.transport :as t] [fib.os.time :as u]
            [fib.os.errors :as os] [fib.http.native :as n]))
(defstruct Input (fd: i64 buffer: (Cell (Array i8)) position: (Cell i64)
  stop: (Atom bool) deadline: (Cell i64) max-line: i64))
(defun input (fd: i64 stop: (Atom bool) max-line: i64) -> Input
  (Input fd (cell (array 0 0i8)) (cell 0) stop (cell 0) max-line))
(defun begin-request (in: Input timeout-ms: i64) -> unit
  (set! (. in deadline) (+ (u/clock-now) (* timeout-ms 1000000))))
(defun fill :private (in: Input) -> (Result bool Error)
  (cond @(. in stop) (Err Cancelled)
        (>= (u/clock-now) @(. in deadline)) (Err (n/os-error (os/timeout-error "HTTP request")))
        (< @(. in position) (array-len @(. in buffer))) (Ok true)
        :else (try-let [_ (t/wait-readable (. in fd) @(. in deadline) (. in stop))
                        bytes (t/read-available (. in fd))]
          (do (set! (. in buffer) bytes) (set! (. in position) 0) (Ok (> (array-len bytes) 0))))))
(defun read-one :private (in: Input) -> (Result (Option i8) Error)
  (try-let [available (fill in)]
    (if (not available) (Ok nil)
      (let [i @(. in position) b (array-get @(. in buffer) i)]
        (do (set! (. in position) (+ i 1)) (Ok (some b)))))))
(defun read-line (in: Input) -> (Result (Option (Array i8)) Error)
  (let [out (cell (array 0 0i8))]
    (loop []
      (try-let [byte (read-one in)]
        (match byte
          (nil (if (= (array-len @out) 0) (Ok nil) (Err (ProtocolError "truncated HTTP line"))))
          ((some b)
            (cond (= b 13i8)
                  (try-let [next (read-one in)]
                    (if (= next (some 10i8)) (Ok (some @out)) (Err (ProtocolError "HTTP line needs CRLF"))))
                  (= b 10i8) (Err (ProtocolError "HTTP line needs CRLF"))
                  (>= (array-len @out) (. in max-line)) (Err (LimitError "HTTP line is too long"))
                  :else (do (array-push! &out b) (recur)))))))))
(defun read-exact (in: Input size: i64) -> (Result (Array i8) Error)
  (let [out (cell (array size 0i8))]
    (loop [offset 0]
      (if (= offset size) (Ok @out)
        (try-let [available (fill in)]
          (if (not available) (Err (ProtocolError "truncated HTTP body"))
            (let [bytes @(. in buffer) start @(. in position)
                  n (min (- size offset) (- (array-len bytes) start))]
              (do (dotimes (i n) (array-set! &out (+ offset i) (array-get bytes (+ start i))))
                  (set! (. in position) (+ start n)) (recur (+ offset n))))))))))
(defun required-line (in: Input) -> (Result str Error)
  (try-let [line (read-line in)]
    (match line (nil (Err (ProtocolError "truncated HTTP message"))) ((some bytes) (Ok (latin1-text bytes))))))
(defun read-head (in: Input limit: i64) -> (Result (Option str) Error)
  (loop [lines: (Vec str) [] size 0]
    (try-let [line (read-line in)]
      (match line
        (nil (if (= (count lines) 0) (Ok nil) (Err (ProtocolError "truncated HTTP headers"))))
        ((some bytes)
          (let [next (+ size (+ (array-len bytes) 2))]
            (cond (> next limit) (Err (LimitError "HTTP headers are too large"))
                  (= (array-len bytes) 0)
                  (if (= (count lines) 0) (Err (ProtocolError "empty HTTP request line"))
                      (Ok (some (str-join (conj lines "\r\n")))))
                  (>= (count lines) 101) (Err (LimitError "too many HTTP headers"))
                  :else (recur (conj lines (str (latin1-text bytes) "\r\n")) next))))))))
