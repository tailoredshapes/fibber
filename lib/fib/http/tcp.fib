;; Descriptor-backed Transports over fib.os: plain TCP (connect, and the server's accepted sockets) and a pair of pipes (the in-memory duplex of tests,
;; real kernel buffers and real deadlines, no sockets). No extern here: names resolve and sockets move through fib.os.net.
(ns fib.http.tcp (:use fib.core fib.seq fib.coll fib.http.types fib.http.transport)
  (:require [fib.dns :as dns] [fib.os.net :as net] [fib.os.io :as io] [fib.os.errors :as os] [fib.os.time :as time] [fib.http.native :as n]))
(def far: i64 3600000000000)
(defstruct Fd :private (rfd: i64 wfd: i64 deadline: (Cell i64) closed: (Cell bool) socket: bool stop: (Atom bool)))
(defun map-os :private (e: os/OSError) -> Error
  (cond (= (. e kind) os/TimedOut) (Timeout "io" (. e message))
        (= (. e kind) os/Cancelled) Cancelled
        :else (n/os-error e)))
(defun limit :private (d: Fd) -> i64 (let [x @(. d deadline)] (if (= x 0) (+ (time/clock-now) far) x)))
(defun retry? :private (e: os/OSError) -> bool (includes? (. e kind) [os/Interrupted os/WouldBlock]))
(defun fd-read :private (d: Fd n: i64) -> (Result (Array i8) Error)
  (if @(. d closed) (Err Closed)
    (loop []
      (match (net/wait-readable (. d rfd) (limit d) (. d stop))
        ((Err e) (Err (map-os e)))
        ((Ok _) (match (io/read-fd (. d rfd) n)
          ((Ok bytes) (Ok bytes))
          ((Err e) (if (retry? e) (recur) (Err (map-os e))))))))))
(defun remaining-ms :private (d: Fd) -> i64 (quot (- (limit d) (time/clock-now)) 1000000))
(defun pipe-write :private (d: Fd bytes: (Array i8)) -> (Result unit Error)
  (loop [off 0]
    (cond (= off (array-len bytes)) (Ok ())
          @(. d stop) (Err Cancelled)
          (<= (remaining-ms d) 0) (Err (Timeout "io" "write timed out"))
          :else (match (net/ready? (. d wfd) true (min 50 (max 1 (remaining-ms d))))
            ((Err e) (Err (map-os e)))
            ((Ok false) (recur off))
            ((Ok true) (match (io/write-fd-range (. d wfd) bytes off (- (array-len bytes) off))
              ((Ok k) (recur (+ off k)))
              ((Err e) (if (retry? e) (recur off) (Err (map-os e))))))))))
(defun fd-write :private (d: Fd bytes: (Array i8)) -> (Result unit Error)
  (cond @(. d closed) (Err Closed)
        (= (array-len bytes) 0) (Ok ())
        (not (. d socket)) (pipe-write d bytes)
        (<= (remaining-ms d) 0) (Err (Timeout "io" "write timed out"))
        :else (match (net/send-all (. d wfd) bytes (min 3600000 (remaining-ms d)) (. d stop))
                ((Ok _) (Ok ())) ((Err e) (Err (map-os e))))))
(defun fd-close :private (d: Fd) -> unit
  (if @(. d closed) ()
    (do (set! (. d closed) true) (io/close-fd (. d rfd))
        (if (!= (. d wfd) (. d rfd)) (do (io/close-fd (. d wfd)) ()) ()))))
(defun fd-transport (rfd: i64 wfd: i64 socket: bool peer: str stop: (Atom bool)) -> Transport
  (let [d (Fd rfd wfd (cell 0) (cell false) socket stop)]
    (Transport (fn (n: i64) (fd-read d n)) (fn (b: (Array i8)) (fd-write d b)) (fn () (fd-close d))
               (fn (at: i64) (set! (. d deadline) at)) peer)))
;; A connected socket the caller already holds (the server's accepted sockets). The Transport owns the descriptor from here.
(defun socket-transport (fd: i64 peer: str stop: (Atom bool)) -> Transport (fd-transport fd fd true peer stop))

;; Two pipes make a duplex stream: [p1r p1w p2r p2w], p1 carrying A to B and p2 B to A. The descriptors are plain numbers so a task can be
;; handed its end and build the Transport itself (a Transport never crosses a thread). Each end owns its two descriptors.
(defun pipe-fds () -> (Result (Vec i64) Error)
  (match (io/make-pipe)
    ((Err e) (Err (n/os-error e)))
    ((Ok a) (match (io/make-pipe)
      ((Err e) (do (io/close-fd (. a fst)) (io/close-fd (. a snd)) (Err (n/os-error e))))
      ((Ok b) (do (io/set-nonblocking (. a fst) true) (io/set-nonblocking (. a snd) true)
                  (io/set-nonblocking (. b fst) true) (io/set-nonblocking (. b snd) true)
                  (Ok [(. a fst) (. a snd) (. b fst) (. b snd)])))))))
(defun pipe-end-a (fds: (Vec i64)) -> Transport (fd-transport (nth fds 2) (nth fds 1) false "pipe-a" (atom false)))
(defun pipe-end-b (fds: (Vec i64)) -> Transport (fd-transport (nth fds 0) (nth fds 3) false "pipe-b" (atom false)))
(defun pipe-pair () -> (Result (Pair Transport Transport) Error)
  (try-let [fds (pipe-fds)] (Ok (Pair (pipe-end-a fds) (pipe-end-b fds)))))

(defun ip-literal? :private (host: str) -> bool
  (or (some? (str-find host ":" 0))
      (and (> (str-len host) 0)
           (loop [i 0] (if (= i (str-len host)) true
             (let [b (zext i64 (str-byte-at host i))] (if (or (= b 46) (and (>= b 48) (<= b 57))) (recur (+ i 1)) false)))))))
(defun addresses (host: str) -> (Result (Vec str) Error)
  (if (ip-literal? host) (Ok [host])
    (match (net/resolve-host host) ((Ok xs) (Ok xs)) ((Err e) (Err (DnsError (str host ": " (. e message))))))))
(defun native-resolve :private (r: dns/Resolver host: str) -> (Result (Vec str) Error)
  (match (dns/resolve-host r host) ((Ok xs) (Ok xs)) ((Err e) (Err (DnsError (str host ": " (. e message)))))))
;; How names become addresses: the native resolver of fib.dns (the default: no getaddrinfo, no NSS, works in a static binary in a scratch image),
;; the platform's getaddrinfo (:resolver :system: for hosts whose names live in NSS only, mDNS or LDAP), or a function of the caller's.
(defenum ResolverMode NativeDns SystemResolver (CustomResolver f: (fn :send (str) (Result (Vec str) Error))))
(defun resolve-fn (mode: ResolverMode) -> (fn :send (str) (Result (Vec str) Error))
  (match mode
    ((NativeDns) (let [r (dns/system-resolver)] (fn (h: str) (native-resolve r h))))
    ((SystemResolver) (fn (h: str) (addresses h)))
    ((CustomResolver f) f)))
(defun connect-error :private (e: os/OSError host: str port: i64) -> Error
  (if (= (. e kind) os/TimedOut) (Timeout "connect" (str host ":" port))
      (ConnectError (str host ":" port ": " (. e message)))))
(defun connect-any :private (xs: (Vec str) host: str port: i64 deadline: i64) -> (Result i64 Error)
  (loop [i 0 last: Error (ConnectError "no address")]
    (if (= i (count xs)) (Err last)
      (let [ms (quot (- deadline (time/clock-now)) 1000000)]
        (if (< ms 1) (Err (Timeout "connect" (str host ":" port)))
          (match (net/connect-tcp (nth xs i) port (min ms 3600000))
            ((Ok fd) (Ok fd))
            ((Err e) (recur (+ i 1) (connect-error e host port)))))))))
(defun connect-via (resolve: (fn :send (str) (Result (Vec str) Error)) host: str port: i64 connect-timeout-ms: i64) -> (Result Transport Error)
  (let [deadline (+ (time/clock-now) (* (max 1 (if (= connect-timeout-ms 0) 3600000 connect-timeout-ms)) 1000000))]
    (try-let [xs (resolve host) fd (connect-any xs host port deadline)]
      (Ok (socket-transport fd (str host ":" port) (atom false))))))
;; Connects with the native resolver and no cache (a resolver per call). The client's own dial (Target.dial) shares one resolver and its cache.
(defun connect (host: str port: i64 connect-timeout-ms: i64) -> (Result Transport Error)
  (connect-via (resolve-fn NativeDns) host port connect-timeout-ms))
(defun dialer (resolve: (fn :send (str) (Result (Vec str) Error))) -> (fn :send (str i64 i64) (Result Transport Error))
  (fn (h: str p: i64 ms: i64) (connect-via resolve h p ms)))
(defun tcp-factory () -> Factory
  (Factory "tcp" (fn (t: Target) ((. t dial) (. t host) (. t port) (. t connect-timeout-ms)))))
