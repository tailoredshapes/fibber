;; Internal ABI data. Applications use named operations and ErrorKind instead.
(ns fib.os.abi-data)
(defstruct Abi (create-flag: i64 exclusive-flag: i64 truncate-flag: i64 append-flag: i64
  nonblock-flag: i64 cloexec-flag: i64 at-cwd: i64 monotonic-clock: i64
  would-block: i64 timed-out: i64 connection-aborted: i64 connection-reset: i64
  connection-refused: i64 not-supported: i64 address-in-use: i64
  socket-level: i64 reuse-address: i64 no-signal: i64 ipv6-family: i64
  sockaddr-length: bool uname-width: i64 dirent-type: i64 dirent-name: i64 online-cpus: i64
  in-progress: i64 socket-error: i64))
(defun linux-abi () -> Abi
  (Abi 64 128 512 1024 2048 524288 -100 1 11 110 103 104 111 95 98
       1 2 16384 10 false 65 18 19 84 115 4))
(defun darwin-abi () -> Abi
  (Abi 512 2048 1024 8 4 16777216 -2 6 35 60 53 54 61 45 48
       65535 4 524288 30 true 256 20 21 58 36 4103))
