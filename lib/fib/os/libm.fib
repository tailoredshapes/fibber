;; fib.os.libm: the libm symbols fib.math wraps (ADR 0011: an `extern` lives in the platform layer; this replaces `fib.math.libm`, which was
;; a listed violator). A leaf: it uses no other module. Not for programs: a call needs `unsafe`, and fib.math is the safe face of each.
;; Every one is a C99 `double` function. On wasm32-wasi they link against wasi-libc's libm (the sysroot has all of them; no import
;; whitelist applies to a scalar extern), on Darwin against libSystem's, on Linux against libm or musl.
(ns fib.os.libm)

(extern sqrt (f64) -> f64)
(extern cbrt (f64) -> f64)
(extern pow (f64 f64) -> f64)
(extern exp (f64) -> f64)
(extern expm1 (f64) -> f64)
(extern log (f64) -> f64)
(extern log10 (f64) -> f64)
(extern log1p (f64) -> f64)
(extern sin (f64) -> f64)
(extern cos (f64) -> f64)
(extern tan (f64) -> f64)
(extern asin (f64) -> f64)
(extern acos (f64) -> f64)
(extern atan (f64) -> f64)
(extern atan2 (f64 f64) -> f64)
(extern sinh (f64) -> f64)
(extern cosh (f64) -> f64)
(extern tanh (f64) -> f64)
(extern hypot (f64 f64) -> f64)
(extern floor (f64) -> f64)
(extern ceil (f64) -> f64)
(extern rint (f64) -> f64)
(extern copysign (f64 f64) -> f64)
(extern nextafter (f64 f64) -> f64)
(extern remainder (f64 f64) -> f64)
(extern scalbn (f64 i32) -> f64)
