;; Bounded native FILE streams with local closures over private state.
(ns fib.os.memory-stream (:use fib.core fib.os.errors) (:require [fib.os.native :as n]))
(extern fmemopen :private (ptr i64 ptr) -> i64)
(extern setbuf :private (i64 ptr) -> unit)
(extern ftell :private (i64) -> i64)
(extern ferror :private (ptr) -> i32)
(extern fclose :private (ptr) -> i32)
(extern fwrite :private (ptr i64 i64 ptr) -> i64)
(defstruct State :private (memory: i64 stream: (Cell i64) limit: i64))
(defstruct Stream (read: (fn () (Result (Array i8) OSError)) write: (fn ((Array i8)) (Result unit OSError))
  close: (fn () (Result unit OSError)) full: (fn () bool) native: (fn () (Result ptr OSError))))
(defun full-state? :private (state: State) -> bool
  (and (!= @(. state stream) 0)
    (unsafe (or (!= (ferror (n/pointer @(. state stream))) 0i32) (> (ftell @(. state stream)) (. state limit))))))
(defun read-state :private (state: State) -> (Result (Array i8) OSError)
  (if (= @(. state stream) 0) (Err (error-from-code 9 "fmemopen"))
    (if (full-state? state) (Err (OSError LimitExceeded 0 "fmemopen" "memory stream exceeds byte limit"))
      (try-let [size (c-result (unsafe (ftell @(. state stream))) "ftell")]
        (Ok (n/bytes-at (n/pointer (. state memory)) size))))))
(defun close-state :private (state: State) -> (Result unit OSError)
  (if (= @(. state stream) 0) (Ok ())
    (unsafe (let [result (fclose (n/pointer @(. state stream))) saved (n/errno)]
      (do (set! (. state stream) 0) (free (n/pointer (. state memory)))
        (if (< result 0i32) (Err (error-from-code saved "fclose")) (Ok ())))))))
(defun write-state :private (state: State bytes: (Array i8)) -> (Result unit OSError)
  (if (= @(. state stream) 0) (Err (error-from-code 9 "fwrite"))
    (let [buffer (n/bytes-new bytes)
          wrote (unsafe (fwrite buffer 1 (array-len bytes) (n/pointer @(. state stream))))]
      (unsafe (do (free buffer)
        (if (or (!= wrote (array-len bytes)) (full-state? state))
          (Err (OSError LimitExceeded 0 "fwrite" "memory stream exceeds byte limit")) (Ok ())))))))
(defun native-state :private (state: State) -> (Result ptr OSError)
  (if (= @(. state stream) 0) (Err (error-from-code 9 "fmemopen")) (Ok (n/pointer @(. state stream)))))
(defun open-stream (limit: i64) -> (Result Stream OSError)
  (if (or (< limit 0) (> limit 67108864)) (Err (invalid-input "fmemopen" "invalid memory stream limit"))
    (unsafe (let [buffer (alloc (+ limit 1)) mode (n/c-text "w")
                  handle (fmemopen buffer (+ limit 1) mode) saved (n/errno)]
      (do (free mode)
        (if (= handle 0) (do (free buffer) (Err (error-from-code saved "fmemopen")))
          (do (setbuf handle (n/pointer 0))
            (let [state (State (n/address buffer) (cell handle) limit)]
              (Ok (Stream (fn () (read-state state)) (fn (bytes: (Array i8)) (write-state state bytes))
                (fn () (close-state state)) (fn () (full-state? state)) (fn () (native-state state))))))))))))
(defun bytes (stream: Stream) -> (Result (Array i8) OSError) ((. stream read)))
(defun write-bytes (stream: Stream bytes: (Array i8)) -> (Result unit OSError) ((. stream write) bytes))
(defun close-stream (stream: Stream) -> (Result unit OSError) ((. stream close)))
(defun full? (stream: Stream) -> bool ((. stream full)))
;; Native interop only: the pointer remains valid until close-stream.
(defun native-handle (stream: Stream) -> (Result ptr OSError) ((. stream native)))
