;; fib.os.decimal: libc's strtod, the exact fallback of the decimal-to-double parsers (fib.core.decimal's parse-double; fib.json.number has its own
;; declaration, listed in docs/adr/0011). It is a leaf of the platform layer (ADR 0011: an `extern` lives here and nowhere in fib.core) and uses no other
;; module, so fib.core may depend on it without a cycle. `(strtod p end-slot)` reads the NUL-terminated text at p; the end pointer is written to end-slot.
(ns fib.os.decimal)
(extern strtod (ptr ptr) -> f64)
