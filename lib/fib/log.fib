;; fib.log: logging with structured fields (docs/design/observability-and-databases.md 2). Clojure's clojure.tools.logging in shape, log4j's
;; levels and logger hierarchy, data instead of format strings. Explicit: `(:require [fib.log :as log])`.
;;
;;   (let [sys (log/system-from-env)                                  ; or (log/log-system (log/console-text) levels)
;;         lg  (log/get-logger sys "app.db")] ..)
;;   (log/info lg "connected" :host host :port 5432)                  ; message, then keyword/value pairs; values by ->datum
;;   (log/debug lg "row" :id (expensive id))                          ; disabled: one compare, `(expensive id)` is not evaluated
;;   (let [lg (log/with-context lg :request-id rid)] ..)              ; a logger whose every record carries the field; tasks capture it
;;
;; The level macros are `trace debug info warn error fatal`; each is `(if (enabled? lg L) (emit lg L msg [fields]) ())`, so the message and
;; the field values are evaluated only when the level is on (measured in the design, 2.5). Use them through the alias (`log/debug`): the
;; implicit fib.core has a `debug` of its own (the Debug protocol), which a `:use` of this module would shadow.
(ns fib.log (:export-from fib.datum fib.log.core fib.log.sinks))

;; The six level macros are one template each (a macro reaches only names the using module sees, or `var`: syntax §5, so they cannot share a
;; macro of this module that the user did not name).
(defmacro trace (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 0)
               (fib.log/emit ~l 0 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

(defmacro debug (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 1)
               (fib.log/emit ~l 1 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

(defmacro info (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 2)
               (fib.log/emit ~l 2 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

(defmacro warn (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 3)
               (fib.log/emit ~l 3 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

(defmacro error (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 4)
               (fib.log/emit ~l 4 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

(defmacro fatal (lg message ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: the fields after the message come in keyword/value pairs")
      (let ((l (gensym "lg")))
        `(let ((~l ~lg))
           (if (fib.log/enabled? ~l 5)
               (fib.log/emit ~l 5 ~message
                 [~@(loop ((i 0) (out (vec-empty)))
                      (if (< i (vec-count kvs))
                          (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                          out))])
               ())))))

;; (with-context lg :k v ..): the logger with these fields added to its context (a value; the old logger is unchanged).
(defmacro with-context (lg ... kvs)
  (if (= (rem (vec-count kvs) 2) 1)
      (trap "fib.log: with-context takes keyword/value pairs")
      `(fib.log/add-context ~lg
         [~@(loop ((i 0) (out (vec-empty)))
              (if (< i (vec-count kvs))
                  (recur (+ i 2) (vec-conj out `(Pair ~(vec-nth kvs i) (fib.log/->datum ~(vec-nth kvs (+ i 1))))))
                  out))])))
