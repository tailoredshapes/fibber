;; Validated native reductions. Four independent accumulators hide addition latency.
(ns fib.tensor.simd-f32
  (:use fib.core fib.simd fib.seq fib.tensor.storage fib.tensor.memory fib.tensor.plan))

(defun data :private (x: (Tensor f32)) -> ptr
  (unsafe (ptr+ (raw (. x buffer)) (+ (array-header-size) (* 4 (array-get (. x meta) 0))))))

(defun address :private (p: ptr step: i64 i: i64) -> ptr
  (unsafe (ptr+ p (unchecked-multiply 4 (unchecked-multiply step i)))))

(defun gather :private (p: ptr step: i64 i: i64) -> f32xn
  (unsafe
    (cond (= step 1) (load-simd (address p step i))
          (= step 0) (splat f32xn (load-f32 p))
          :else (loop ((k 0) (acc (splat f32xn 0.0f32)))
                  (if (< k (native-lanes f32)) (recur (+ k 1) (with-lane acc k (load-f32 (address p step (+ i k))))) acc)))))

(defun short-sum :private (p: ptr n: i64) -> f32
  (unsafe
    (let ((end (- n (rem n (native-lanes f32))))
          (lanes (loop ((i 0) (acc (splat f32xn 0.0f32)))
                   (if (< i end) (recur (+ i (native-lanes f32)) (+ acc (load-simd (address p 1 i)))) acc))))
      (loop ((i end) (acc (hsum lanes)))
        (if (< i n) (recur (+ i 1) (+ acc (load-f32 (address p 1 i)))) acc)))))

(defun long-sum :private (p: ptr n: i64) -> f32
  (unsafe
    (let ((end (- n (rem n (* 4 (native-lanes f32)))))
          (lanes (loop ((i 0) (a (splat f32xn 0.0f32)) (b (splat f32xn 0.0f32))
                        (c (splat f32xn 0.0f32)) (d (splat f32xn 0.0f32)))
                   (if (< i end)
                       (recur (+ i (* 4 (native-lanes f32))) (+ a (load-simd (address p 1 i)))
                              (+ b (load-simd (address p 1 (+ i (native-lanes f32)))))
                              (+ c (load-simd (address p 1 (+ i (* 2 (native-lanes f32))))))
                              (+ d (load-simd (address p 1 (+ i (* 3 (native-lanes f32))))))) (+ (+ a b) (+ c d)))))
          (packed (- n (rem n (native-lanes f32))))
          (rest (loop ((i end) (acc lanes))
                  (if (< i packed) (recur (+ i (native-lanes f32)) (+ acc (load-simd (address p 1 i)))) acc))))
      (loop ((i packed) (acc (hsum rest)))
        (if (< i n) (recur (+ i 1) (+ acc (load-f32 (address p 1 i)))) acc)))))

(defun dense-sum :private (p: ptr n: i64) -> f32
  (if (< n 32) (short-sum p n) (long-sum p n)))

(defun strided-row-sum :private (p: ptr step: i64 n: i64) -> f32
  (unsafe
    (let ((end (- n (rem n (native-lanes f32))))
          (lanes (loop ((i 0) (acc (splat f32xn 0.0f32)))
                   (if (< i end) (recur (+ i (native-lanes f32)) (+ acc (gather p step i))) acc))))
      (loop ((i end) (acc (hsum lanes)))
        (if (< i n) (recur (+ i 1) (+ acc (load-f32 (address p step i)))) acc)))))

(defun strided-sum :private (x: (Tensor f32)) -> f32
  (let ((steps (strides x)) (plan (traversal (shape x) steps steps))
        (n (inner-length plan)) (step (left-step plan)) (p (data x)))
    (loop ((row 0) (acc 0.0f32))
      (if (< row (rows plan))
          (let ((rp (address p 1 (row-offset plan (. plan left) row))))
            (recur (+ row 1) (+ acc (if (= step 1) (dense-sum rp n) (strided-row-sum rp step n))))) acc))))

(defun sum-packed (x: (Tensor f32)) -> f32
  (do (validate x)
      (if (contiguous? x) (dense-sum (data x) (fib.tensor.storage/size x)) (strided-sum x))))

(defun dense-dot :private (ap: ptr bp: ptr n: i64) -> f32
  (unsafe
    (let ((end (- n (rem n (* 4 (native-lanes f32)))))
          (lanes (loop ((i 0) (a (splat f32xn 0.0f32)) (b (splat f32xn 0.0f32))
                        (c (splat f32xn 0.0f32)) (d (splat f32xn 0.0f32)))
                   (if (< i end)
                       (recur (+ i (* 4 (native-lanes f32)))
                              (+ a (* (load-simd (address ap 1 i)) (load-simd (address bp 1 i))))
                              (+ b (* (load-simd (address ap 1 (+ i (native-lanes f32)))) (load-simd (address bp 1 (+ i (native-lanes f32))))))
                              (+ c (* (load-simd (address ap 1 (+ i (* 2 (native-lanes f32))))) (load-simd (address bp 1 (+ i (* 2 (native-lanes f32)))))))
                              (+ d (* (load-simd (address ap 1 (+ i (* 3 (native-lanes f32))))) (load-simd (address bp 1 (+ i (* 3 (native-lanes f32))))))))
                       (+ (+ a b) (+ c d)))))
          (packed (- n (rem n (native-lanes f32))))
          (rest (loop ((i end) (acc lanes))
                  (if (< i packed) (recur (+ i (native-lanes f32)) (+ acc (* (load-simd (address ap 1 i)) (load-simd (address bp 1 i))))) acc))))
      (loop ((i packed) (acc (hsum rest)))
        (if (< i n) (recur (+ i 1) (+ acc (* (load-f32 (address ap 1 i))
                                          (load-f32 (address bp 1 i))))) acc)))))

(defun strided-dot :private (ap: ptr bp: ptr n: i64 astep: i64 bstep: i64) -> f32
  (unsafe
    (let ((end (- n (rem n (* 4 (native-lanes f32)))))
          (lanes (loop ((i 0) (a (splat f32xn 0.0f32)) (b (splat f32xn 0.0f32))
                        (c (splat f32xn 0.0f32)) (d (splat f32xn 0.0f32)))
                   (if (< i end)
                       (recur (+ i (* 4 (native-lanes f32)))
                              (+ a (* (gather ap astep i) (gather bp bstep i)))
                              (+ b (* (gather ap astep (+ i (native-lanes f32))) (gather bp bstep (+ i (native-lanes f32)))))
                              (+ c (* (gather ap astep (+ i (* 2 (native-lanes f32)))) (gather bp bstep (+ i (* 2 (native-lanes f32))))))
                              (+ d (* (gather ap astep (+ i (* 3 (native-lanes f32)))) (gather bp bstep (+ i (* 3 (native-lanes f32)))))))
                       (+ (+ a b) (+ c d)))))
          (packed (- n (rem n (native-lanes f32))))
          (rest (loop ((i end) (acc lanes))
                  (if (< i packed) (recur (+ i (native-lanes f32)) (+ acc (* (gather ap astep i) (gather bp bstep i)))) acc))))
      (loop ((i packed) (acc (hsum rest)))
        (if (< i n) (recur (+ i 1) (+ acc (* (load-f32 (address ap astep i))
                                          (load-f32 (address bp bstep i))))) acc)))))

(defun dot-packed (a: (Tensor f32) b: (Tensor f32)) -> f32
  (do (validate a) (validate b)
      (when (or (!= (rank a) 1) (!= (rank b) 1)) (trap "tensor: dot requires rank one"))
      (when (!= (fib.tensor.storage/size a) (fib.tensor.storage/size b)) (trap "tensor: dot size mismatch"))
      (if (and (contiguous? a) (contiguous? b)) (dense-dot (data a) (data b) (fib.tensor.storage/size a))
          (strided-dot (data a) (data b) (fib.tensor.storage/size a) (nth (strides a) 0) (nth (strides b) 0)))))
