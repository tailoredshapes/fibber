;; Shared native Array layout constant. Raw pointers stay private to kernel modules.
(ns fib.tensor.memory (:use fib.core))

;; Native Array has a 16-byte ownership/type header followed by an 8-byte length.
(defun array-header-size () -> i64 24)

(defun number-op (op: i64 a: t b: t) :where ((Num t) (Float t)) -> t
  (cond (= op 0) (+ a b) (= op 1) (- a b) (= op 2) (* a b) :else (fdiv a b)))
