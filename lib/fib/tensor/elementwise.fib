;; Eager, checked scalar kernels. Broadcasting is planned once per operation.
(ns fib.tensor.elementwise
  (:use fib.core fib.seq fib.coll fib.tensor.layout fib.tensor.storage fib.tensor.views fib.tensor.kernels fib.tensor.plan))

;; Explicit output seed supports dtype-changing maps and empty results without calling f.
;; A dense input is read straight from its buffer (logical element i is buffer element offset+i); any other layout is walked
;; row by row, the outer coordinates decoded once per row and the inner loop advancing by a constant stride (the plan of
;; fib.tensor.plan, as the arithmetic kernels do). Reads stay bounds-checked; callbacks run once per element in row-major order.
(defun map-as (f: (fn (a) b) :borrow seed: b x: (Tensor a)) :where ((Element b)) -> (Tensor b)
  (let ((dims (shape x)) (n (checked-size (shape x) seed)) (buf (cell (array n seed)))
        (src (. x buffer)) (off (array-get (. x meta) 0)))
    (do (if (contiguous? x)
            (dotimes (i n) (array-set! &buf i (f (array-get src (+ off i)))))
            (let ((plan (traversal dims (strides x) (strides x))) (inner (inner-length plan)) (step (left-step plan)))
              (dotimes (r (rows plan))
                (let ((base (+ off (row-offset plan (. plan left) r))) (out (* r inner)))
                  (dotimes (i inner) (array-set! &buf (+ out i) (f (array-get src (+ base (* i step))))))))))
        (from-array dims @buf seed))))

(defun map (f: (fn (t) t) :borrow x: (Tensor t)) :where ((Element t)) -> (Tensor t)
  (map-as f (. x seed) x))

(defun zip-with (f: (fn (a b) c) :borrow seed: c a: (Tensor a) b: (Tensor b))
  :where ((Element a) (Element b) (Element c)) -> (Tensor c)
  (let ((dims (broadcast-shape (shape a) (shape b)))
        (left (broadcast-to dims a)) (right (broadcast-to dims b))
        (n (checked-size dims seed)) (buf (cell (array n seed)))
        (as (. left buffer)) (bs (. right buffer))
        (ao (array-get (. left meta) 0)) (bo (array-get (. right meta) 0)))
    (do (if (and (contiguous? left) (contiguous? right))
            (dotimes (i n) (array-set! &buf i (f (array-get as (+ ao i)) (array-get bs (+ bo i)))))
            (let ((plan (traversal dims (strides left) (strides right))) (inner (inner-length plan))
                  (lstep (left-step plan)) (rstep (right-step plan)))
              (dotimes (r (rows plan))
                (let ((abase (+ ao (row-offset plan (. plan left) r))) (bbase (+ bo (row-offset plan (. plan right) r)))
                      (out (* r inner)))
                  (dotimes (i inner)
                    (array-set! &buf (+ out i) (f (array-get as (+ abase (* i lstep))) (array-get bs (+ bbase (* i rstep))))))))))
        (from-array dims @buf seed))))

(defun add (a: (Tensor t) b: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (binary (. a seed) 0 a b))

(defun sub (a: (Tensor t) b: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (binary (. a seed) 1 a b))

(defun mul (a: (Tensor t) b: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (binary (. a seed) 2 a b))

;; Division is float-only: integer / in Fibber creates ratios, not scalar tensors.
(defun div (a: (Tensor t) b: (Tensor t)) :where ((Element t) (Float t) (Division t)) -> (Tensor t)
  (divide (. a seed) a b))

(defun scale (factor: t x: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (mul x (full [] factor)))

(defun shift (amount: t x: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (add x (full [] amount)))

(defun neg (x: (Tensor t)) :where ((Element t) (Num t)) -> (Tensor t)
  (map (fn (value: t) (negate-value value)) x))

(defun square (x: (Tensor t)) :where ((Element t) (Num t) (Arithmetic t)) -> (Tensor t)
  (mul x x))

;; Eager alpha*x + beta*y in one traversal and one output allocation; no implicit FMA.
(defun axpby (alpha: t x: (Tensor t) beta: t y: (Tensor t))
  :where ((Element t) (Num t) (Affine t)) -> (Tensor t)
  (affine (. x seed) alpha x beta y))
