(ns fib.tensor.views (:use fib.core fib.seq fib.coll fib.tensor.layout fib.tensor.storage))

;; View-only reshape. Explicit copy handles layouts that cannot be reshaped densely.
(defun reshape (dims: (Vec i64) x: (Tensor t)) -> (Tensor t)
  (do (when (!= (shape-size dims) (fib.tensor.storage/size x)) (trap "tensor: reshape size mismatch"))
      (when (not (contiguous? x)) (trap "tensor: reshape requires contiguous layout"))
      (from-parts (. x buffer) (array-get (. x meta) 0) dims (dense-strides dims) (. x seed))))

(defun permute (axes: (Vec i64) x: (Tensor t)) -> (Tensor t)
  (let ((r (rank x)) (dims (shape x)) (steps (strides x)))
    (do (when (!= (count axes) r) (trap "tensor: permutation rank mismatch"))
        (loop ((i 0) (seen (vec-empty)) (ds (vec-empty)) (ss (vec-empty)))
          (if (< i r)
              (let ((a (normalize-axis r (nth axes i))))
                (do (when (includes? a seen) (trap "tensor: duplicate permutation axis"))
                    (recur (+ i 1) (conj seen a) (conj ds (nth dims a)) (conj ss (nth steps a)))))
              (from-parts (. x buffer) (array-get (. x meta) 0) ds ss (. x seed)))))))

(defun transpose (x: (Tensor t)) -> (Tensor t)
  (let ((axes (loop ((i (- (rank x) 1)) (out (vec-empty)))
                (if (>= i 0) (recur (- i 1) (conj out i)) out))))
    (permute axes x)))

(defun flip (axis: i64 x: (Tensor t)) -> (Tensor t)
  (let ((a (normalize-axis (rank x) axis)) (dims (shape x)) (ss (strides x))
        (offset (array-get (. x meta) 0)) (d (nth dims a)) (s (nth ss a)))
    (from-parts (. x buffer) (if (= (fib.tensor.storage/size x) 0) offset (+ offset (* (- d 1) s)))
                dims (fib.coll/assoc ss a (- 0 s)) (. x seed))))

;; Half-open, positive-step interval on one axis. An empty slice preserves a valid offset.
(defun slice (axis: i64 start: i64 stop: i64 step: i64 x: (Tensor t)) -> (Tensor t)
  (let ((a (normalize-axis (rank x) axis)) (dims (shape x)) (ss (strides x)) (d (nth dims a)))
    (do (when (<= step 0) (trap "tensor: slice step must be positive"))
        (when (or (< start 0) (< stop start) (> stop d)) (trap "tensor: slice bounds out of range"))
        (let ((distance (- stop start))
              (n (+ (quot distance step) (if (= (rem distance step) 0) 0 1)))
              (ds (fib.coll/assoc dims a n)) (offset (array-get (. x meta) 0)))
          (from-parts (. x buffer) (if (= (shape-size ds) 0) offset (+ offset (* start (nth ss a))))
                      ds (fib.coll/assoc ss a (* step (nth ss a))) (. x seed))))))

(defun broadcast-to (dims: (Vec i64) x: (Tensor t)) -> (Tensor t)
  (let ((old (shape x)) (steps (strides x)) (r (count dims)) (extra (- r (count old))))
    (do (shape-size dims)
        (when (< extra 0) (trap "tensor: broadcast cannot reduce rank"))
        (let ((ss (loop ((i 0) (out (vec-empty)))
                    (if (< i r)
                        (if (< i extra) (recur (+ i 1) (conj out 0))
                            (let ((j (- i extra)) (a (nth old j)) (b (nth dims i)))
                              (cond (= a b) (recur (+ i 1) (conj out (nth steps j)))
                                    (= a 1) (recur (+ i 1) (conj out 0))
                                    :else (trap "tensor: broadcast shape mismatch"))))
                        out))))
          (from-parts (. x buffer) (array-get (. x meta) 0) dims ss (. x seed))))))
