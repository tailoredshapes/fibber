;; Blocked f32 GEMM: fused multiply-add micro-kernel on packed panels (GotoBLAS/BLIS loop nest).
;;
;; C = A*B for rank-two inputs of any strides. B is packed per (column block, inner block) into
;; panels of 16 columns, A per (row block, inner block) into panels of 6 rows, both zero padded to
;; whole panels, so the micro-kernel always runs a full 6x16 tile (twelve f32x8 accumulators, the
;; sixteen ymm registers of AVX2 less two B vectors and one broadcast) with unchecked loads.
;; Pointers are in range by construction: `validate` proves every logical element of A and B is in
;; its array; packed buffers are sized from the loop bounds (roundup of the block to whole panels).
;; Every output element is one chain of fused multiply-adds over the inner index in increasing
;; order, whatever the tile or block it falls in (a block continues the chain from C): the result
;; equals `fma-reference` bit for bit. It differs from the ordered `mmul-scalar` (multiply, then add) in
;; the last bits, because an fma rounds once.
(ns fib.tensor.gemm-fma-f32
  (:use fib.core fib.seq fib.coll fib.tensor.layout fib.tensor.storage fib.tensor.memory))

(defun mc :private () -> i64 96)   ; rows of A per block, a multiple of 6
(defun kc :private () -> i64 512)  ; inner extent per block
(defun nc :private () -> i64 1024) ; columns of B per block, a multiple of 16

(defun ofs :private (p: ptr i: i64) -> ptr (unsafe (ptr+ p (unchecked-multiply 4 i))))
(defun roundup :private (x: i64 q: i64) -> i64 (* q (quot (+ x (- q 1)) q)))
(defun data :private (x: (Tensor f32)) -> ptr (ofs (unsafe (ptr+ (raw (. x buffer)) (array-header-size))) (array-get (. x meta) 0)))

;; ---- micro-kernel: C[0..6)x[0..16) (row pitch ldc) = (load ? C : 0) + sum over p of ap[p*6+i] * bp[p*16+j]
(defun kern6x16 :private (ap: ptr bp: ptr cp: ptr ldc: i64 kk: i64 load: bool) -> unit
  (unsafe
    (loop ((p 0)
           (a00 (if load (load-f32x8 (ofs cp 0)) (splat f32x8 0.0f32)))
           (a01 (if load (load-f32x8 (ofs cp 8)) (splat f32x8 0.0f32)))
           (a10 (if load (load-f32x8 (ofs cp ldc)) (splat f32x8 0.0f32)))
           (a11 (if load (load-f32x8 (ofs cp (unchecked-add ldc 8))) (splat f32x8 0.0f32)))
           (a20 (if load (load-f32x8 (ofs cp (unchecked-multiply 2 ldc))) (splat f32x8 0.0f32)))
           (a21 (if load (load-f32x8 (ofs cp (unchecked-add (unchecked-multiply 2 ldc) 8))) (splat f32x8 0.0f32)))
           (a30 (if load (load-f32x8 (ofs cp (unchecked-multiply 3 ldc))) (splat f32x8 0.0f32)))
           (a31 (if load (load-f32x8 (ofs cp (unchecked-add (unchecked-multiply 3 ldc) 8))) (splat f32x8 0.0f32)))
           (a40 (if load (load-f32x8 (ofs cp (unchecked-multiply 4 ldc))) (splat f32x8 0.0f32)))
           (a41 (if load (load-f32x8 (ofs cp (unchecked-add (unchecked-multiply 4 ldc) 8))) (splat f32x8 0.0f32)))
           (a50 (if load (load-f32x8 (ofs cp (unchecked-multiply 5 ldc))) (splat f32x8 0.0f32)))
           (a51 (if load (load-f32x8 (ofs cp (unchecked-add (unchecked-multiply 5 ldc) 8))) (splat f32x8 0.0f32))))
      (if (< p kk)
          (let ((b0 (load-f32x8 (ofs bp (unchecked-multiply 16 p))))
                (b1 (load-f32x8 (ofs bp (unchecked-add (unchecked-multiply 16 p) 8))))
                (ab (ofs ap (unchecked-multiply 6 p)))
                (x0 (splat f32x8 (load-f32 ab)))
                (x1 (splat f32x8 (load-f32 (ofs ab 1))))
                (x2 (splat f32x8 (load-f32 (ofs ab 2))))
                (x3 (splat f32x8 (load-f32 (ofs ab 3))))
                (x4 (splat f32x8 (load-f32 (ofs ab 4))))
                (x5 (splat f32x8 (load-f32 (ofs ab 5)))))
            (recur (+ p 1)
                   (simd/fma x0 b0 a00) (simd/fma x0 b1 a01)
                   (simd/fma x1 b0 a10) (simd/fma x1 b1 a11)
                   (simd/fma x2 b0 a20) (simd/fma x2 b1 a21)
                   (simd/fma x3 b0 a30) (simd/fma x3 b1 a31)
                   (simd/fma x4 b0 a40) (simd/fma x4 b1 a41)
                   (simd/fma x5 b0 a50) (simd/fma x5 b1 a51)))
          (do (store-f32x8 (ofs cp 0) a00) (store-f32x8 (ofs cp 8) a01)
              (store-f32x8 (ofs cp ldc) a10) (store-f32x8 (ofs cp (unchecked-add ldc 8)) a11)
              (store-f32x8 (ofs cp (unchecked-multiply 2 ldc)) a20) (store-f32x8 (ofs cp (unchecked-add (unchecked-multiply 2 ldc) 8)) a21)
              (store-f32x8 (ofs cp (unchecked-multiply 3 ldc)) a30) (store-f32x8 (ofs cp (unchecked-add (unchecked-multiply 3 ldc) 8)) a31)
              (store-f32x8 (ofs cp (unchecked-multiply 4 ldc)) a40) (store-f32x8 (ofs cp (unchecked-add (unchecked-multiply 4 ldc) 8)) a41)
              (store-f32x8 (ofs cp (unchecked-multiply 5 ldc)) a50) (store-f32x8 (ofs cp (unchecked-add (unchecked-multiply 5 ldc) 8)) a51))))))

;; ---- an incomplete tile goes through a 6x16 scratch tile (pitch 16) so the kernel is the same
(defun edge-tile :private (ap: ptr bp: ptr cp: ptr ldc: i64 kk: i64 load: bool mr: i64 nr: i64 tp: ptr) -> unit
  (unsafe
    (do (dotimes (i 96) (store-f32 (ofs tp i) 0.0f32))
        (when load
          (dotimes (i mr) (dotimes (j nr) (store-f32 (ofs tp (unchecked-add (unchecked-multiply 16 i) j))
                                                      (load-f32 (ofs cp (unchecked-add (unchecked-multiply ldc i) j)))))))
        (kern6x16 ap bp tp 16 kk load)
        (dotimes (i mr) (dotimes (j nr) (store-f32 (ofs cp (unchecked-add (unchecked-multiply ldc i) j))
                                                    (load-f32 (ofs tp (unchecked-add (unchecked-multiply 16 i) j)))))))))

;; ---- packing: a panel of up to 6 rows of A over kk inner steps, p-major, rows beyond mr are zero
(defun pack-a :private (dst: ptr src: ptr as0: i64 as1: i64 mr: i64 kk: i64) -> unit
  (unsafe
    (dotimes (p kk)
      (dotimes (i 6)
        (store-f32 (ofs dst (unchecked-add (unchecked-multiply 6 p) i))
                   (if (< i mr) (load-f32 (ofs src (unchecked-add (unchecked-multiply i as0) (unchecked-multiply p as1)))) 0.0f32))))))

;; a panel of up to 16 columns of B, p-major, columns beyond nr are zero
(defun pack-b :private (dst: ptr src: ptr bs0: i64 bs1: i64 nr: i64 kk: i64) -> unit
  (unsafe
    (if (and (= nr 16) (= bs1 1))
        (dotimes (p kk)
          (let ((s (ofs src (unchecked-multiply p bs0))) (d (ofs dst (unchecked-multiply 16 p))))
            (do (store-f32x8 d (load-f32x8 s)) (store-f32x8 (ofs d 8) (load-f32x8 (ofs s 8))))))
        (dotimes (p kk)
          (dotimes (j 16)
            (store-f32 (ofs dst (unchecked-add (unchecked-multiply 16 p) j))
                       (if (< j nr) (load-f32 (ofs src (unchecked-add (unchecked-multiply p bs0) (unchecked-multiply j bs1)))) 0.0f32)))))))

(defun pack-a-block :private (dst: ptr src: ptr as0: i64 as1: i64 rows: i64 kk: i64) -> unit
  (dotimes (q (quot (+ rows 5) 6))
    (pack-a (ofs dst (unchecked-multiply (unchecked-multiply 6 q) kk)) (ofs src (unchecked-multiply (unchecked-multiply 6 q) as0))
            as0 as1 (min 6 (- rows (* 6 q))) kk)))

(defun pack-b-block :private (dst: ptr src: ptr bs0: i64 bs1: i64 cols: i64 kk: i64) -> unit
  (dotimes (q (quot (+ cols 15) 16))
    (pack-b (ofs dst (unchecked-multiply (unchecked-multiply 16 q) kk)) (ofs src (unchecked-multiply (unchecked-multiply 16 q) bs1))
            bs0 bs1 (min 16 (- cols (* 16 q))) kk)))

;; ---- one (A block) x (B block) product into C
(defun block-product :private (ap: ptr bp: ptr cp: ptr ldc: i64 rows: i64 cols: i64 kk: i64 load: bool tp: ptr) -> unit
  (dotimes (jq (quot (+ cols 15) 16))
    (dotimes (iq (quot (+ rows 5) 6))
      (let ((mr (min 6 (- rows (* 6 iq)))) (nr (min 16 (- cols (* 16 jq))))
            (a (ofs ap (unchecked-multiply (unchecked-multiply 6 iq) kk)))
            (b (ofs bp (unchecked-multiply (unchecked-multiply 16 jq) kk)))
            (c (ofs cp (unchecked-add (unchecked-multiply (unchecked-multiply 6 iq) ldc) (unchecked-multiply 16 jq)))))
        (if (and (= mr 6) (= nr 16))
            (kern6x16 a b c ldc kk load)
            (edge-tile a b c ldc kk load mr nr tp))))))

;; ---- the loop nest: column block, inner block (pack B), row block (pack A)
(defun nest :private (ap: ptr bp: ptr cp: ptr abuf: ptr bbuf: ptr tp: ptr
                      as0: i64 as1: i64 bs0: i64 bs1: i64 m: i64 n: i64 k: i64) -> unit
  (loop ((jj 0))
    (when (< jj n)
      (let ((cols (min (nc) (- n jj))))
        (do (loop ((pp 0))
              (when (< pp k)
                (let ((kk (min (kc) (- k pp))))
                  (do (pack-b-block bbuf (ofs bp (unchecked-add (unchecked-multiply pp bs0) (unchecked-multiply jj bs1))) bs0 bs1 cols kk)
                      (loop ((ii 0))
                        (when (< ii m)
                          (let ((rows (min (mc) (- m ii))))
                            (do (pack-a-block abuf (ofs ap (unchecked-add (unchecked-multiply ii as0) (unchecked-multiply pp as1))) as0 as1 rows kk)
                                (block-product abuf bbuf (ofs cp (unchecked-add (unchecked-multiply ii n) jj)) n rows cols kk (> pp 0) tp)
                                (recur (+ ii (mc)))))))
                      (recur (+ pp (kc)))))))
            (recur (+ jj (nc))))))))

(defun multiply (a: (Tensor f32) b: (Tensor f32)) -> (Tensor f32)
  (do (validate a) (validate b)
      (when (or (!= (rank a) 2) (!= (rank b) 2)) (trap "tensor: mmul requires rank two"))
      (let ((ad (shape a)) (bd (shape b)) (m (nth ad 0)) (k (nth ad 1)) (n (nth bd 1)))
        (do (when (!= k (nth bd 0)) (trap "tensor: mmul inner dimension mismatch"))
            (let ((length (checked-size [m n] 0.0f32))
                  (output (if (= k 0) (array length 0.0f32) (unsafe (array-uninit-f32 length)))))
              (do (when (and (> length 0) (> k 0))
                    (let ((kk (min (kc) k))
                          (abuf (unsafe (array-uninit-f32 (* (roundup (min (mc) m) 6) kk))))
                          (bbuf (unsafe (array-uninit-f32 (* (roundup (min (nc) n) 16) kk))))
                          (tbuf (unsafe (array-uninit-f32 96)))
                          (as (strides a)) (bs (strides b)))
                      (nest (data a) (data b) (unsafe (ptr+ (raw output) (array-header-size)))
                            (unsafe (ptr+ (raw abuf) (array-header-size))) (unsafe (ptr+ (raw bbuf) (array-header-size)))
                            (unsafe (ptr+ (raw tbuf) (array-header-size)))
                            (nth as 0) (nth as 1) (nth bs 0) (nth bs 1) m n k)))
                  (from-array [m n] output 0.0f32)))))))

;; The ordered fused reference: one fma chain per output, inner index increasing. Checked, scalar.
(defun fma-reference (a: (Tensor f32) b: (Tensor f32)) -> (Tensor f32)
  (do (validate a) (validate b)
      (when (or (!= (rank a) 2) (!= (rank b) 2)) (trap "tensor: mmul requires rank two"))
      (let ((ad (shape a)) (bd (shape b)) (m (nth ad 0)) (k (nth ad 1)) (n (nth bd 1)))
        (do (when (!= k (nth bd 0)) (trap "tensor: mmul inner dimension mismatch"))
            (let ((as (strides a)) (bs (strides b)) (ao (array-get (. a meta) 0)) (bo (array-get (. b meta) 0))
                  (buf (cell (array (checked-size [m n] 0.0f32) 0.0f32))))
              (do (dotimes (i m)
                    (dotimes (j n)
                      (array-set! &buf (+ (* i n) j)
                        (loop ((p 0) (acc 0.0f32))
                          (if (< p k)
                              (recur (+ p 1) (simd/fma (array-get (. a buffer) (+ ao (+ (* i (nth as 0)) (* p (nth as 1)))))
                                                       (array-get (. b buffer) (+ bo (+ (* p (nth bs 0)) (* j (nth bs 1)))))
                                                       acc))
                              acc)))))
                  (from-array [m n] @buf 0.0f32)))))))
