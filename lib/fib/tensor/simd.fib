;; Explicit SIMD reductions permit reassociation; ordered sum and dot remain available.
(ns fib.tensor.simd (:use fib.core fib.tensor.storage)
  (:require [fib.tensor.simd-f32 :as s32] [fib.tensor.simd-f64 :as s64]))

(defprotocol PackedReduction
  (packed-sum (self x: (Tensor Self)) -> Self)
  (packed-dot (self a: (Tensor Self) b: (Tensor Self)) -> Self))
(impl PackedReduction f32
  (packed-sum (self x) (s32/sum-packed x))
  (packed-dot (self a b) (s32/dot-packed a b)))
(impl PackedReduction f64
  (packed-sum (self x) (s64/sum-packed x))
  (packed-dot (self a b) (s64/dot-packed a b)))

(defun sum-fast (x: (Tensor t)) :where ((PackedReduction t)) -> t
  (packed-sum (. x seed) x))
(defun dot-fast (a: (Tensor t) b: (Tensor t)) :where ((PackedReduction t)) -> t
  (packed-dot (. a seed) a b))
