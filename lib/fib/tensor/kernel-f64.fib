;; Complete writes into fresh scalar-only output buffers. Raw helpers are private.
(ns fib.tensor.kernel-f64
  (:use fib.core fib.seq fib.coll fib.tensor.storage fib.tensor.views fib.tensor.layout fib.tensor.plan fib.tensor.memory))

(defun data :private (x: (Tensor f64)) -> ptr
  (unsafe (ptr+ (raw (. x buffer)) (+ (array-header-size) (* 8 (array-get (. x meta) 0))))))
(defun address :private (p: ptr step: i64 i: i64) -> ptr
  (unsafe (ptr+ p (unchecked-multiply 8 (unchecked-multiply step i)))))

(defun block :private (p: ptr step: i64 i: i64 scalar: f64) -> f64x4
  (unsafe
    (cond (= step 0) (splat f64x4 scalar)
          (= step 1) (load-f64x4 (address p step i))
          :else <<(load-f64 (address p step i)) (load-f64 (address p step (+ i 1)))
                  (load-f64 (address p step (+ i 2))) (load-f64 (address p step (+ i 3)))>>)))

(defun row-add :private (alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (block ap ls i av))
                    (b (block bp rs i bv)))
                (do (store-f64x4 (address cp 1 i) (+ a b)) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (+ a b)) (recur (+ i 1))))))))))

(defun row-sub :private (alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (block ap ls i av))
                    (b (block bp rs i bv)))
                (do (store-f64x4 (address cp 1 i) (- a b)) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (- a b)) (recur (+ i 1))))))))))

(defun row-mul :private (alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (block ap ls i av))
                    (b (block bp rs i bv)))
                (do (store-f64x4 (address cp 1 i) (* a b)) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (* a b)) (recur (+ i 1))))))))))

