  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (block ap ls i av))
                    (b (block bp rs i bv)))
                (do (store-f64x4 (address cp 1 i) (fdiv a b)) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (fdiv a b)) (recur (+ i 1))))))))))

(defun row-affine :private (alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (block ap ls i av))
                    (b (block bp rs i bv)))
                (do (store-f64x4 (address cp 1 i) (+ (* alphav a) (* betav b))) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (+ (* alpha a) (* beta b))) (recur (+ i 1))))))))))

(defun row :private (op: i64 alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (cond (= op 0) (row-add alpha beta ap bp cp n ls rs)
        (= op 1) (row-sub alpha beta ap bp cp n ls rs)
        (= op 2) (row-mul alpha beta ap bp cp n ls rs)
        (= op 3) (row-div alpha beta ap bp cp n ls rs)
        :else (row-affine alpha beta ap bp cp n ls rs)))

(defun flat-add :private (alpha: f64 beta: f64 ap: ptr bp: ptr cp: ptr n: i64 ls: i64 rs: i64) -> unit
  (unsafe
    (let ((end (- n (rem n 4))) (av (if (= ls 0) (load-f64 ap) 0.0))
          (bv (if (= rs 0) (load-f64 bp) 0.0))
          (alphav (splat f64x4 alpha)) (betav (splat f64x4 beta)))
      (do (loop ((i 0))
            (when (< i end)
              (let ((a (if (= ls 0) (splat f64x4 av) (load-f64x4 (address ap 1 i))))
                    (b (if (= rs 0) (splat f64x4 bv) (load-f64x4 (address bp 1 i)))))
                (do (store-f64x4 (address cp 1 i) (+ a b)) (recur (+ i 4))))))
          (loop ((i end))
            (when (< i n)
              (let ((a (if (= ls 0) av (load-f64 (address ap ls i))))
                    (b (if (= rs 0) bv (load-f64 (address bp rs i)))))
                (do (store-f64 (address cp 1 i) (+ a b)) (recur (+ i 1))))))))))

