;; Vector exp, log and tanh for f64 and f32 tensors (generated constants: scripts/bench/tensor/gen-vmath.py documents the derivation).
;;
;; One lane function over `(Simd f64 n)` at any width: the native width of the target for an f64 tensor (4 lanes at 256 bits, 8 at 512), an f32 tensor
;; eight at a time (as two f64x4 halves at 256 bits, one f64x8 at 512; computed in f64 and rounded back, so a
;; result is within one rounding of the f64 result). Every lane is independent, so the bits do not depend on the width. No libm call; no table. Accuracy, measured against libm over a dense
;; sweep by cases 7080 and 7081 (the bounds asserted there are the contract):
;;   exp  : max error 1 ULP for f64 in [-708.396, 709.78]; below -708.396 the result is flushed to +0.0 (libm returns subnormals),
;;          above 709.7827 it is +inf; exp(NaN) = NaN, exp(-inf) = 0, exp(+inf) = +inf.
;;   log  : max error 2 ULP for f64 over the positive finite range (subnormal inputs included); log(0) = -inf, log(x < 0) = NaN
;;          (also -inf), log(+inf) = +inf, log(NaN) = NaN.
;;   tanh : max error 2 ULP for f64; tanh(+-inf) = +-1, tanh(+-0.0) = +-0.0 (sign kept), tanh(NaN) = NaN.
;; f32: within 1 ULP of the f64 libm reference rounded to f32 in the same ranges (the f64 result is under half an f32 ULP away).
;; Using f32 libm directly is not an accuracy oracle: older tanhf implementations can themselves err by 2 ULP.
;; Not bit-for-bit libm, and a result may differ from the scalar libm in the last place.
(ns fib.tensor.vmath
  (:use fib.core fib.seq fib.coll fib.tensor.layout fib.tensor.storage fib.tensor.views))

(defun nan :private () -> f64 (bits->f64 9221120237041090560))
(defun inf :private () -> f64 (bits->f64 9218868437227405312))

;; 2^e for e in [-1022, 1023], by building the exponent field and reinterpreting it as the double (no lane leaves the vector register)
(defun pow2 :private (e: (Simd i64 n)) -> (Simd f64 n)
  (let ((b: (Simd i64 n) (shl (unchecked-add e (splat (Simd i64 n) 1023)) 52)))
    (simd/bitcast b)))

;; exp(x) = 2^k * exp(r), k = round(x log2 e), r = x - k ln2 (two fused steps), exp(r) a degree-13 Taylor polynomial on |r| <= ln2/2.
;; 2^k is applied as 2^(k -+ 1) and a factor 2 or 1/2 on the polynomial so that k = 1024 and k = -1022 stay representable.
(defun exp-lanes :private (x: (Simd f64 n)) -> (Simd f64 n)
  (let ((xc (simd/min (simd/max x (splat (Simd f64 n) -708.4)) (splat (Simd f64 n) 709.8)))
        (kf (simd/round-even (* xc (splat (Simd f64 n) 1.4426950408889634))))
        (r1 (simd/muladd kf (splat (Simd f64 n) (neg 0.693147180559663)) xc))
        (r (simd/muladd kf (splat (Simd f64 n) (neg 2.8235290563031577e-13)) r1))
        (p (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (splat (Simd f64 n) 1.6059043836821613e-10) r (splat (Simd f64 n) 2.08767569878681e-09)) r (splat (Simd f64 n) 2.505210838544172e-08)) r (splat (Simd f64 n) 2.755731922398589e-07)) r (splat (Simd f64 n) 2.7557319223985893e-06)) r (splat (Simd f64 n) 2.48015873015873e-05)) r (splat (Simd f64 n) 0.0001984126984126984)) r (splat (Simd f64 n) 0.001388888888888889)) r (splat (Simd f64 n) 0.008333333333333333)) r (splat (Simd f64 n) 0.041666666666666664)) r (splat (Simd f64 n) 0.16666666666666666)) r (splat (Simd f64 n) 0.5)) r (splat (Simd f64 n) 1.0)) r (splat (Simd f64 n) 1.0)))
        (ki: (Simd i64 n) (simd/convert kf))
        (pos (simd/gt kf (splat (Simd f64 n) 0.0)))
        (m (simd/blend pos (splat (Simd i64 n) -1) (splat (Simd i64 n) 1)))
        (c (simd/blend pos (splat (Simd f64 n) 2.0) (splat (Simd f64 n) 0.5)))
        (y (* (* p c) (pow2 (unchecked-add ki m)))))
    (simd/blend (simd/lt x (splat (Simd f64 n) -708.396)) (splat (Simd f64 n) 0.0)
                (simd/blend (simd/gt x (splat (Simd f64 n) 709.782712893384)) (splat (Simd f64 n) (inf)) y))))

;; log(x) = e ln2 + log(m), x = m 2^e with m in [sqrt(1/2), sqrt 2) (integer bit trick on the exponent), log m = 2 s Q(s^2), s = (m-1)/(m+1).
;; Subnormal inputs are scaled by 2^54 first.
(defun log-lanes :private (x: (Simd f64 n)) -> (Simd f64 n)
  (let ((small (simd/lt x (splat (Simd f64 n) 2.2250738585072014e-308)))
        (xs (simd/blend small (* x (splat (Simd f64 n) 18014398509481984.0)) x))
        (adj (simd/blend small (splat (Simd f64 n) 54.0) (splat (Simd f64 n) 0.0)))
        (hx: (Simd i64 n) (simd/bitcast xs))
        (tmp (unchecked-subtract hx (splat (Simd i64 n) 4604544271217802189)))
        (ki (sar tmp 52))
        (mb: (Simd i64 n) (unchecked-subtract hx (shl ki 52)))
        (m: (Simd f64 n) (simd/bitcast mb))
        (ef0: (Simd f64 n) (simd/convert ki))
        (ef (- ef0 adj))
        (f (- m (splat (Simd f64 n) 1.0)))
        (s (fdiv f (+ m (splat (Simd f64 n) 1.0))))
        (z (* s s))
        (q (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (splat (Simd f64 n) 0.047619047619047616) z (splat (Simd f64 n) 0.05263157894736842)) z (splat (Simd f64 n) 0.058823529411764705)) z (splat (Simd f64 n) 0.06666666666666667)) z (splat (Simd f64 n) 0.07692307692307693)) z (splat (Simd f64 n) 0.09090909090909091)) z (splat (Simd f64 n) 0.1111111111111111)) z (splat (Simd f64 n) 0.14285714285714285)) z (splat (Simd f64 n) 0.2)) z (splat (Simd f64 n) 0.3333333333333333)))
        (s2 (* s (splat (Simd f64 n) 2.0)))
        (logm (simd/muladd (* s2 z) q s2))
        (y (simd/muladd ef (splat (Simd f64 n) 0.693147180559663) (simd/muladd ef (splat (Simd f64 n) 2.8235290563031577e-13) logm)))
        (zero (splat (Simd f64 n) 0.0)))
    (simd/blend (simd/ne x x) x
                (simd/blend (simd/eq x zero) (splat (Simd f64 n) (- 0.0 (inf)))
                            (simd/blend (simd/lt x zero) (splat (Simd f64 n) (nan))
                                        (simd/blend (simd/eq x (splat (Simd f64 n) (inf))) (splat (Simd f64 n) (inf)) y))))))

;; tanh(x) = x + x z G(z), z = x^2, G a degree-13 fit of (tanh x - x)/x^3, for |x| < 0.55; else 1 - 2/(exp(2|x|) + 1) with the sign restored.
(defun tanh-lanes :private (x: (Simd f64 n)) -> (Simd f64 n)
  (let ((a (simd/abs x)) (zero (splat (Simd f64 n) 0.0)) (one (splat (Simd f64 n) 1.0))
        (z (* x x))
        (g (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (simd/muladd (splat (Simd f64 n) 1.1502191446949632e-06) z (splat (Simd f64 n) -5.273641022066474e-06)) z (splat (Simd f64 n) 1.531458042362091e-05)) z (splat (Simd f64 n) -3.9068724399643e-05)) z (splat (Simd f64 n) 9.686461378957666e-05)) z (splat (Simd f64 n) -0.0002391204040613736)) z (splat (Simd f64 n) 0.0005900263819919156)) z (splat (Simd f64 n) -0.0014558342969834689)) z (splat (Simd f64 n) 0.00359212803135852)) z (splat (Simd f64 n) -0.008863235529706255)) z (splat (Simd f64 n) 0.021869488536150786)) z (splat (Simd f64 n) -0.053968253968253915)) z (splat (Simd f64 n) 0.13333333333333333)) z (splat (Simd f64 n) -0.3333333333333333)))
        (small (simd/muladd (* x z) g x))
        (t (exp-lanes (* a (splat (Simd f64 n) 2.0))))
        (th (- one (fdiv (splat (Simd f64 n) 2.0) (+ t one))))
        (large (simd/blend (simd/lt x zero) (neg th) th)))
    (simd/blend (simd/eq x zero) x (simd/blend (simd/lt a (splat (Simd f64 n) 0.55)) small large))))

;; Activations (op 3 and up; `activation-code` names them). Built on exp-lanes and tanh-lanes, so they are as accurate as those and as the f64 result
;; rounded to f32. relu keeps the `where (greater x 0) x 0` meaning: NaN and -0.0 give +0.0.
;;   sigmoid 1/(1+e^-x)   silu x*sigmoid(x)   gelu 0.5x(1+tanh(sqrt(2/pi)(x+0.044715x^3)))  (the tanh form, as GPT-2 and BERT use)
(defun sigmoid-lanes :private (x: (Simd f64 n)) -> (Simd f64 n)
  (let ((one (splat (Simd f64 n) 1.0))) (fdiv one (+ one (exp-lanes (neg x))))))

(defun gelu-lanes :private (x: (Simd f64 n)) -> (Simd f64 n)
  (let ((inner (* (splat (Simd f64 n) 0.7978845608028654) (simd/muladd (* (* x x) x) (splat (Simd f64 n) 0.044715) x))))
    (* (* (splat (Simd f64 n) 0.5) x) (+ (splat (Simd f64 n) 1.0) (tanh-lanes inner)))))

(defun apply-lanes :private (op: i64 x: (Simd f64 n)) -> (Simd f64 n)
  (cond (= op 0) (exp-lanes x) (= op 1) (log-lanes x) (= op 2) (tanh-lanes x) (= op 3) (sigmoid-lanes x)
        (= op 4) (* x (sigmoid-lanes x)) (= op 5) (gelu-lanes x)
        (= op 6) (simd/blend (simd/gt x (splat (Simd f64 n) 0.0)) x (splat (Simd f64 n) 0.0))
        :else x))

(defun activation-code (name: keyword) -> i64
  (cond (= name :tanh) 2 (= name :sigmoid) 3 (= name :silu) 4 (= name :gelu) 5 (= name :relu) 6 (= name :identity) 7
        :else (trap "tensor: unknown activation (:identity :relu :tanh :sigmoid :silu :gelu)")))

;; One f32x8 through activation `op`: the GEMM epilogue's lane function and the f32 tensor kernels'. relu and identity stay in f32; the rest run in f64,
;; as one f64x8 pass where the target's native width is 512 bits and as two f64x4 halves otherwise: the same lanes either way, so the same bits.
(defun lift8-halves :private (op: i64 v: f32x8) -> f32x8
  (let ((lo: f32x4 (simd/shuffle v v <<0 1 2 3>>)) (hi: f32x4 (simd/shuffle v v <<4 5 6 7>>))
        (wl: f64x4 (simd/convert lo)) (wh: f64x4 (simd/convert hi))
        (rl: f32x4 (simd/convert (apply-lanes op wl))) (rh: f32x4 (simd/convert (apply-lanes op wh))))
    (simd/shuffle rl rh <<0 1 2 3 4 5 6 7>>)))

(defun lift8-whole :private (op: i64 v: f32x8) -> f32x8
  (let ((w: f64x8 (simd/convert v)) (r: f32x8 (simd/convert (apply-lanes op w)))) r))

(defun lift8 :private (op: i64 v: f32x8) -> f32x8
  (if (>= (native-lanes f64) 8) (lift8-whole op v) (lift8-halves op v)))

(defun activate8 (op: i64 v: f32x8) -> f32x8
  (cond (= op 7) v
        (= op 6) (simd/blend (simd/gt v (splat f32x8 0.0f32)) v (splat f32x8 0.0f32))
        :else (lift8 op v)))

(defun run-f64 :private (op: i64 x: (Tensor f64)) -> (Tensor f64)
  (let ((d (contiguous x)) (n (fib.tensor.storage/size d)) (off (array-get (. d meta) 0)) (src (. d buffer))
        (buf (cell (array (checked-size (shape d) 0.0) 0.0))))
    (do (loop ((i 0))
          (when (< i n)
            (if (<= (+ i (native-lanes f64)) n)
                (let ((v: f64xn (simd-load src (+ off i))))
                  (do (simd-store! &buf i (apply-lanes op v)) (recur (+ i (native-lanes f64)))))
                (let ((v: f64xn (simd-load-tail src (+ off i))))
                  (simd-store-tail! &buf i (apply-lanes op v))))))
        (from-array (shape d) @buf 0.0))))

(defun run-f32 :private (op: i64 x: (Tensor f32)) -> (Tensor f32)
  (let ((d (contiguous x)) (n (fib.tensor.storage/size d)) (off (array-get (. d meta) 0)) (src (. d buffer))
        (buf (cell (array (checked-size (shape d) 0.0f32) 0.0f32))))
    (do (loop ((i 0))
          (when (< i n)
            (if (<= (+ i 8) n)
                (let ((v: f32x8 (simd-load src (+ off i))))
                  (do (simd-store! &buf i (lift8 op v)) (recur (+ i 8))))
                (let ((v: f32x8 (simd-load-tail src (+ off i))))
                  (simd-store-tail! &buf i (lift8 op v))))))
        (from-array (shape d) @buf 0.0f32))))

(defprotocol Transcendental
  (transcend (self op: i64 x: (Tensor Self)) -> (Tensor Self)))
(impl Transcendental f64 (transcend (self op x) (run-f64 op x)))
(impl Transcendental f32 (transcend (self op x) (run-f32 op x)))

(defun exp (x: (Tensor t)) :where ((Element t) (Transcendental t)) -> (Tensor t) (transcend (. x seed) 0 x))
(defun log (x: (Tensor t)) :where ((Element t) (Transcendental t)) -> (Tensor t) (transcend (. x seed) 1 x))
(defun tanh (x: (Tensor t)) :where ((Element t) (Transcendental t)) -> (Tensor t) (transcend (. x seed) 2 x))
;; Elementwise activation in one pass and one allocation: (t/activate :gelu x). Names: :identity :relu :tanh :sigmoid :silu :gelu.
(defun activate (name: keyword x: (Tensor t)) :where ((Element t) (Transcendental t)) -> (Tensor t)
  (transcend (. x seed) (activation-code name) x))
(defun relu (x: (Tensor t)) :where ((Element t) (Transcendental t)) -> (Tensor t) (transcend (. x seed) 6 x))

;; ---- softmax and layernorm over the last axis, row by row, in the row's own cache lines: a row is read at most three times and written once
;; (the composition of maximum-axis, sub, exp, sum-axis, div makes eleven passes over the whole tensor and five temporaries). The reductions
;; are reassociated (four or eight lanes, then a horizontal add), like sum-fast: the sums can differ from the ordered `sum-axis` in the last bits.
;; softmax x = exp(x - rowmax) / rowsum; a NaN in a row gives a NaN row. layernorm x gamma beta eps = (x - mean) / sqrt(var + eps) * gamma + beta
;; with the population variance, from one pass of sums of (x - x0) and (x - x0)^2 (x0 the row's first element: the shift keeps the one-pass
;; variance from cancelling when the mean is large) and one pass that writes. Every read and write is bounds-checked.

(defun expv-f64 :private (v: f64xn) -> f64xn (exp-lanes v))

(defun row-max-f64 :private (src: (Array f64) b: i64 n: i64) -> f64
  (let ((end (- n (rem n (native-lanes f64))))
        (v: f64xn (loop ((i 0) (acc: f64xn (splat f64xn (array-get src b))))
                    (if (< i end) (let ((x: f64xn (simd-load src (+ b i)))) (recur (+ i (native-lanes f64)) (simd/max acc x))) acc))))
    (loop ((i end) (m (hmax v))) (if (< i n) (recur (+ i 1) (max m (array-get src (+ b i)))) m))))

;; out[ob..ob+n) = exp(src[sb..sb+n) - mx); returns the sum
(defun row-exp-f64 :private (src: (Array f64) sb: i64 n: i64 mx: f64 &out: (Array f64) ob: i64) -> f64
  (let ((end (- n (rem n (native-lanes f64)))) (m (splat f64xn mx))
        (v: f64xn (loop ((i 0) (acc: f64xn (splat f64xn 0.0)))
                    (if (< i end)
                        (let ((x: f64xn (simd-load src (+ sb i))) (e: f64xn (expv-f64 (- x m))))
                          (do (simd-store! &out (+ ob i) e) (recur (+ i (native-lanes f64)) (+ acc e))))
                        acc))))
    (loop ((i end) (acc (hsum v)))
      (if (< i n)
          (let ((e (lane (expv-f64 (splat f64xn (- (array-get src (+ sb i)) mx))) 0)))
            (do (array-set! &out (+ ob i) e) (recur (+ i 1) (+ acc e))))
          acc))))

(defun row-divide-f64 :private (ob: i64 n: i64 d: f64 &out: (Array f64)) -> unit
  (let ((end (- n (rem n (native-lanes f64)))) (dv (splat f64xn d)))
    (do (loop ((i 0)) (when (< i end) (let ((e: f64xn (simd-load @out (+ ob i)))) (do (simd-store! &out (+ ob i) (fdiv e dv)) (recur (+ i (native-lanes f64)))))))
        (loop ((i end)) (when (< i n) (do (array-set! &out (+ ob i) (fdiv (array-get @out (+ ob i)) d)) (recur (+ i 1))))))))

(defun softmax-f64 :private (x: (Tensor f64)) -> (Tensor f64)
  (let ((d (contiguous x)) (dims (shape d)) (n (nth dims (- (count dims) 1))) (total (fib.tensor.storage/size d))
        (off (array-get (. d meta) 0)) (src (. d buffer)) (buf (cell (array (checked-size dims 0.0) 0.0))))
    (do (when (> total 0)
          (dotimes (r (quot total n))
            (let ((b (* r n)) (mx (row-max-f64 src (+ off b) n)) (sum (row-exp-f64 src (+ off b) n mx &buf b)))
              (row-divide-f64 b n sum &buf))))
        (from-array dims @buf 0.0))))

;; sum over src[sb..sb+n) of (x - c)^k, k = 1 or 2 (reassociated: 4 lanes, then a horizontal add and the tail)
(defun row-sum-f64 :private (src: (Array f64) sb: i64 n: i64 c: f64 squared: bool) -> f64
  (let ((end (- n (rem n (native-lanes f64)))) (cv (splat f64xn c))
        (v: f64xn (loop ((i 0) (acc: f64xn (splat f64xn 0.0)))
                    (if (< i end)
                        (let ((x: f64xn (simd-load src (+ sb i))) (dx: f64xn (- x cv)))
                          (recur (+ i (native-lanes f64)) (+ acc (if squared (* dx dx) dx))))
                        acc))))
    (loop ((i end) (acc (hsum v)))
      (if (< i n)
          (let ((dx (- (array-get src (+ sb i)) c))) (recur (+ i 1) (+ acc (if squared (* dx dx) dx))))
          acc))))

;; out[ob..) = (src - mu) * inv * gamma + beta, the order of operations of the composed layernorm
(defun row-normalize-f64 :private (src: (Array f64) sb: i64 n: i64 mu: f64 inv: f64 gamma: (Array f64) beta: (Array f64) &out: (Array f64) ob: i64) -> unit
  (let ((end (- n (rem n (native-lanes f64)))) (m (splat f64xn mu)) (iv (splat f64xn inv)))
    (do (loop ((i 0))
          (when (< i end)
            (let ((x: f64xn (simd-load src (+ sb i))) (g: f64xn (simd-load gamma i)) (bt: f64xn (simd-load beta i)))
              (do (simd-store! &out (+ ob i) (+ (* (* (- x m) iv) g) bt)) (recur (+ i (native-lanes f64)))))))
        (loop ((i end))
          (when (< i n)
            (do (array-set! &out (+ ob i) (+ (* (* (- (array-get src (+ sb i)) mu) inv) (array-get gamma i)) (array-get beta i)))
                (recur (+ i 1))))))))

(defun layernorm-f64 :private (x: (Tensor f64) gamma: (Tensor f64) beta: (Tensor f64) eps: f64) -> (Tensor f64)
  (let ((d (contiguous x)) (dims (shape d)) (n (nth dims (- (count dims) 1))) (total (fib.tensor.storage/size d))
        (off (array-get (. d meta) 0)) (src (. d buffer))
        (g (contiguous (broadcast-to [n] gamma))) (bt (contiguous (broadcast-to [n] beta)))
        (buf (cell (array (checked-size dims 0.0) 0.0))))
    (do (when (> total 0)
          (dotimes (r (quot total n))
            (let ((b (* r n)) (sb (+ off b))
                  (mu (fdiv (row-sum-f64 src sb n 0.0 false) (double n)))
                  (var (fdiv (row-sum-f64 src sb n mu true) (double n)))
                  (inv (fdiv 1.0 (lane (simd/sqrt (splat f64xn (+ var eps))) 0))))
              (row-normalize-f64 src sb n mu inv (. g buffer) (. bt buffer) &buf b))))
        (from-array dims @buf 0.0))))

(defun expv-f32 :private (v: f32x8) -> f32x8 (lift8 0 v))

(defun row-max-f32 :private (src: (Array f32) b: i64 n: i64) -> f32
  (let ((end (- n (rem n 8)))
        (v: f32x8 (loop ((i 0) (acc: f32x8 (splat f32x8 (array-get src b))))
                    (if (< i end) (let ((x: f32x8 (simd-load src (+ b i)))) (recur (+ i 8) (simd/max acc x))) acc))))
    (loop ((i end) (m (hmax v))) (if (< i n) (recur (+ i 1) (max m (array-get src (+ b i)))) m))))

;; out[ob..ob+n) = exp(src[sb..sb+n) - mx); returns the sum
(defun row-exp-f32 :private (src: (Array f32) sb: i64 n: i64 mx: f32 &out: (Array f32) ob: i64) -> f32
  (let ((end (- n (rem n 8))) (m (splat f32x8 mx))
        (v: f32x8 (loop ((i 0) (acc: f32x8 (splat f32x8 0.0f32)))
                    (if (< i end)
                        (let ((x: f32x8 (simd-load src (+ sb i))) (e: f32x8 (expv-f32 (- x m))))
                          (do (simd-store! &out (+ ob i) e) (recur (+ i 8) (+ acc e))))
                        acc))))
    (loop ((i end) (acc (hsum v)))
      (if (< i n)
          (let ((e (lane (expv-f32 (splat f32x8 (- (array-get src (+ sb i)) mx))) 0)))
            (do (array-set! &out (+ ob i) e) (recur (+ i 1) (+ acc e))))
          acc))))

(defun row-divide-f32 :private (ob: i64 n: i64 d: f32 &out: (Array f32)) -> unit
  (let ((end (- n (rem n 8))) (dv (splat f32x8 d)))
    (do (loop ((i 0)) (when (< i end) (let ((e: f32x8 (simd-load @out (+ ob i)))) (do (simd-store! &out (+ ob i) (fdiv e dv)) (recur (+ i 8))))))
        (loop ((i end)) (when (< i n) (do (array-set! &out (+ ob i) (fdiv (array-get @out (+ ob i)) d)) (recur (+ i 1))))))))

(defun softmax-f32 :private (x: (Tensor f32)) -> (Tensor f32)
  (let ((d (contiguous x)) (dims (shape d)) (n (nth dims (- (count dims) 1))) (total (fib.tensor.storage/size d))
        (off (array-get (. d meta) 0)) (src (. d buffer)) (buf (cell (array (checked-size dims 0.0f32) 0.0f32))))
    (do (when (> total 0)
          (dotimes (r (quot total n))
            (let ((b (* r n)) (mx (row-max-f32 src (+ off b) n)) (sum (row-exp-f32 src (+ off b) n mx &buf b)))
              (row-divide-f32 b n sum &buf))))
        (from-array dims @buf 0.0f32))))

;; sum over src[sb..sb+n) of (x - c)^k, k = 1 or 2 (reassociated: 8 lanes, then a horizontal add and the tail)
(defun row-sum-f32 :private (src: (Array f32) sb: i64 n: i64 c: f32 squared: bool) -> f32
  (let ((end (- n (rem n 8))) (cv (splat f32x8 c))
        (v: f32x8 (loop ((i 0) (acc: f32x8 (splat f32x8 0.0f32)))
                    (if (< i end)
                        (let ((x: f32x8 (simd-load src (+ sb i))) (dx: f32x8 (- x cv)))
                          (recur (+ i 8) (+ acc (if squared (* dx dx) dx))))
                        acc))))
    (loop ((i end) (acc (hsum v)))
      (if (< i n)
          (let ((dx (- (array-get src (+ sb i)) c))) (recur (+ i 1) (+ acc (if squared (* dx dx) dx))))
          acc))))

;; out[ob..) = (src - mu) * inv * gamma + beta, the order of operations of the composed layernorm
(defun row-normalize-f32 :private (src: (Array f32) sb: i64 n: i64 mu: f32 inv: f32 gamma: (Array f32) beta: (Array f32) &out: (Array f32) ob: i64) -> unit
  (let ((end (- n (rem n 8))) (m (splat f32x8 mu)) (iv (splat f32x8 inv)))
    (do (loop ((i 0))
          (when (< i end)
            (let ((x: f32x8 (simd-load src (+ sb i))) (g: f32x8 (simd-load gamma i)) (bt: f32x8 (simd-load beta i)))
              (do (simd-store! &out (+ ob i) (+ (* (* (- x m) iv) g) bt)) (recur (+ i 8))))))
        (loop ((i end))
          (when (< i n)
            (do (array-set! &out (+ ob i) (+ (* (* (- (array-get src (+ sb i)) mu) inv) (array-get gamma i)) (array-get beta i)))
                (recur (+ i 1))))))))

(defun layernorm-f32 :private (x: (Tensor f32) gamma: (Tensor f32) beta: (Tensor f32) eps: f32) -> (Tensor f32)
  (let ((d (contiguous x)) (dims (shape d)) (n (nth dims (- (count dims) 1))) (total (fib.tensor.storage/size d))
        (off (array-get (. d meta) 0)) (src (. d buffer))
        (g (contiguous (broadcast-to [n] gamma))) (bt (contiguous (broadcast-to [n] beta)))
        (buf (cell (array (checked-size dims 0.0f32) 0.0f32))))
    (do (when (> total 0)
          (dotimes (r (quot total n))
            (let ((b (* r n)) (sb (+ off b))
                  (mu (fdiv (row-sum-f32 src sb n 0.0f32 false) (float n)))
                  (var (fdiv (row-sum-f32 src sb n mu true) (float n)))
                  (inv (fdiv 1.0f32 (lane (simd/sqrt (splat f32x8 (+ var eps))) 0))))
              (row-normalize-f32 src sb n mu inv (. g buffer) (. bt buffer) &buf b))))
        (from-array dims @buf 0.0f32))))

(defprotocol Rows
  (rows-softmax (self x: (Tensor Self)) -> (Tensor Self))
  (rows-layernorm (self x: (Tensor Self) gamma: (Tensor Self) beta: (Tensor Self) eps: Self) -> (Tensor Self)))
(impl Rows f64 (rows-softmax (self x) (softmax-f64 x)) (rows-layernorm (self x gamma beta eps) (layernorm-f64 x gamma beta eps)))
(impl Rows f32 (rows-softmax (self x) (softmax-f32 x)) (rows-layernorm (self x gamma beta eps) (layernorm-f32 x gamma beta eps)))

;; softmax over the last axis of a tensor of any rank at least one; layernorm over the last axis with gamma and beta that broadcast to [n].
(defun softmax (x: (Tensor t)) :where ((Element t) (Rows t)) -> (Tensor t)
  (do (when (< (rank x) 1) (trap "tensor: softmax needs rank at least one"))
      (rows-softmax (. x seed) x)))
(defun layernorm (x: (Tensor t) gamma: (Tensor t) beta: (Tensor t) eps: t) :where ((Element t) (Rows t)) -> (Tensor t)
  (do (when (< (rank x) 1) (trap "tensor: layernorm needs rank at least one"))
      (rows-layernorm (. x seed) x gamma beta eps)))
