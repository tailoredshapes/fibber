;; fib.char: the two character classes the compiler's tokenizer needs (stdlib §4.8; owner L10b; tranche 1 plan
;; §6 L10b, C-21, C-22), required with the alias `char`: `(char/digit? c)`. Java's `Character/isDigit` and
;; `Character/isWhitespace` are tranche 4 (module `Character`); these two are the library's own names.
;; Decided here, where the page is silent:
;;  - `digit?` is true for the ASCII digits `0` to `9` only (not Unicode `Nd`, which `Character/isDigit` is).
;;  - `whitespace?` is the Unicode `White_Space` property: U+0009 to U+000D, U+0020, U+0085, U+00A0, U+1680,
;;    U+2000 to U+200A, U+2028, U+2029, U+202F, U+205F, U+3000. It counts the no-break spaces, which Java's
;;    `isWhitespace` and so `str/trim` do not (plan C-22, flagged for the owner), and it does not count
;;    U+001C to U+001F, which Java's does.
(ns fib.char)

(defun within :private (c: i32 lo: i32 hi: i32) -> bool
  (if (>= c lo) (<= c hi) false))

(defun digit? (c: char) -> bool (within (char->i32 c) 48i32 57i32))

(defun whitespace? (c: char) -> bool
  (let ((n (char->i32 c)))
    (or (within n 9i32 13i32)
    (or (= n 32i32)
    (or (= n 133i32)
    (or (= n 160i32)
    (or (= n 5760i32)
    (or (within n 8192i32 8202i32)
    (or (within n 8232i32 8233i32)
    (or (= n 8239i32)
    (or (= n 8287i32) (= n 12288i32))))))))))))
