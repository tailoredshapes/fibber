;; fib.view.tiles: disjoint windows on native tasks (decision 5 of 2026-10-04; types 6.15). Not implicit: `(:use fib.view fib.view.tiles)`.
;;
;;   (with-tiles [w a 4]                    ; four tasks; each gets its own window of a, a cell it cannot let go of; a is an array of f64, f32, i64 or i32
;;     (fill! w 1.0))
;;
;; `a` is lent to the combinator for the call, which joins every task before it returns, so no task outlives the owner's frozen extent. A
;; task's window is a view cell made inside the task from the array and a range of it, with the same rules as any other view cell
;; (it is never a value, no closure mentions it, `fib.view`'s checker applies to the task's body). The body is a `:send` closure, so what it
;; captures must be sendable (a cell or a view cell of the outer function is refused by `spawn`'s own rule), and a window is not
;; sendable: only the array and two integers cross into the task, and the window is built there. The tiles are the ranges
;; [n t / k, n (t + 1) / k) for t in 0 .. k, so they are disjoint and cover the array.
;;
;; The unique-write protocol is applied once, before any task starts; the tasks then store through raw pointers into disjoint ranges of
;; one buffer that each of them holds a count of (so the buffer is *shared* for the duration, which is why the checks of `fib.view` do
;; not apply to the combinator's own body: it is the trusted kernel). The element type is any that `fib.view` has an instance of `ViewElem` for
;; (`f64`, `f32`, `i64`, `i32`); an empty array is refused, as every lender refuses it (the window needs an element for its seed).
(ns fib.view.tiles (:use fib.core fib.seq fib.coll fib.view))

(defun header-bytes :private () -> i64 24)

;; The window [lo, hi) of the array, for a task. Private: a window made from an array and a range, with no lender and no owner, is only safe
;; where the array is known to be held for as long as the window, which `run-tiles!` and the macro below ensure.
(defun tile-window :private (arr: (Array a) lo: i64 hi: i64) :where ((ViewElem a)) -> (Win a)
  (let ((seed (array-get arr 0)))
    (unsafe (Win (ptr+ (raw arr) (+ (header-bytes) (* (view-width seed) lo))) (- hi lo) seed))))

;; Runs `f arr lo hi` for each of k tiles of the array lent through `&a`, one task each, and joins them all.
(defun run-tiles! (&a: (Array a) k: i64 f: (fn :send ((Array a) i64 i64) unit)) :where ((ViewElem a) (Send a)) -> unit
  (do (when (< k 1) (trap "with-tiles: the number of tiles is at least 1"))
      (when (= (array-len @a) 0) (trap "with-tiles: the array is empty"))
      (array-set! &a 0 (array-get @a 0))
      (let ((n (array-len @a)) (tasks (cell [])))
        (do (dotimes (t k)
              (let ((arr @a) (lo (quot (* n t) k)) (hi (quot (* n (+ t 1)) k)))
                (set! tasks (conj @tasks (spawn (fn () (f arr lo hi)))))))
            (doseq [t @tasks] (join t))))))

;; (with-tiles [w a k] body+): `w` names the tile's window in the body; `a` is the owner (a private cell, as for with-view); k the number of tiles.
(defmacro with-tiles (spec ... body)
  (match spec
    ((Vec items)
     (if (= (vec-count items) 3)
         (let ((arr (gensym "tile-array")) (lo (gensym "tile-lo")) (hi (gensym "tile-hi")))
           `(fib.view.tiles/run-tiles! (& ~(vec-nth items 1)) ~(vec-nth items 2)
              (fn (~arr ~lo ~hi)
                (let ((~(vec-nth items 0) (fib.prelude/cell (fib.view/view-sub ((var fib.view.tiles/tile-window) ~arr ~lo ~hi)))))
                  (do ~@body)))))
         (trap "with-tiles: the spec is [w a k]")))
    (_ (trap "with-tiles: the spec is [w a k]"))))
