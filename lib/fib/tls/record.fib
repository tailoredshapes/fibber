;; fib.tls.record: the TLS 1.3 record layer (RFC 8446 5). `Io` is the byte stream under it (a `fib.http.transport.Transport` adapted in fib.tls.http, or any pair of
;; closures); `Rec` is one connection's record state: the bytes read and not yet parsed, the protection of each direction (none until the handshake keys are
;; installed), and the handshake bytes of a message still being assembled. A record is TLSPlaintext (header, fragment) or TLSCiphertext (header, AEAD of
;; content || type || padding); the AEAD itself is the provider's. Refused here: a record over 2^14+256 bytes (2^14 in plaintext), a plaintext record once
;; the read keys are on (except the compatibility change_cipher_spec, only during the handshake), an inner plaintext of zeros only, an inner content over
;; 2^14, an unknown inner type, a major version other than 3, an empty handshake fragment, a partial handshake message cut by another record type,
;; and a sequence number at the bound. Closing the transport without close_notify is `Truncated`.
(ns fib.tls.record (:use fib.core fib.seq fib.coll fib.crypto.types fib.tls.types fib.tls.bytes fib.tls.msg fib.tls.keys) (:require [fib.crypto :as c]))

(defstruct Io (read: (fn (i64) (Result (Array i8) TlsError)) write: (fn ((Array i8)) (Result unit TlsError)) close: (fn () unit) set-deadline: (fn (i64) unit)))
;; One direction's protection: the AEAD, the key, the static IV and the next sequence number.
(defstruct Prot (alg: keyword key: (Array i8) iv: (Array i8) seq: i64))
(defstruct Rec (io: Io inbuf: (Cell (Array i8)) rd: (Cell (Option Prot)) wr: (Cell (Option Prot)) hsbuf: (Cell (Array i8)) ccs: (Cell i64) handshaking: (Cell bool)))
(defstruct RecIn (type: i64 data: (Array i8)))
(defstruct HsMsg (type: i64 body: (Array i8) raw: (Array i8)))

(def max-plain: i64 16384)
(def max-cipher: i64 16640)
(def seq-bound: i64 1099511627776)
(def max-hs-message: i64 262144)

(defun new-rec (io: Io) -> Rec (Rec io (cell (empty-bytes)) (cell nil) (cell nil) (cell (empty-bytes)) (cell 0) (cell true)))
(defun prot-of (alg: keyword t: Traffic) -> Prot (Prot alg (. t key) (. t iv) 0))
(defun set-read-keys (r: Rec alg: keyword t: Traffic) -> unit (set! (. r rd) (some (prot-of alg t))))
(defun set-write-keys (r: Rec alg: keyword t: Traffic) -> unit (set! (. r wr) (some (prot-of alg t))))
(defun read-seq (r: Rec) -> i64 (match @(. r rd) (nil 0) ((some p) (. p seq))))
(defun write-seq (r: Rec) -> i64 (match @(. r wr) (nil 0) ((some p) (. p seq))))
(defun encrypted-read? (r: Rec) -> bool (some? @(. r rd)))
(defun encrypted-write? (r: Rec) -> bool (some? @(. r wr)))

;; ---- reading bytes
(defun fill (r: Rec n: i64) -> (Result unit TlsError)
  (loop []
    (let [have (array-len @(. r inbuf))]
      (if (>= have n) (Ok ())
        (match ((. (. r io) read) (max (- n have) 32768))
          ((Err e) (Err e))
          ((Ok b) (if (= (array-len b) 0) (Err Truncated) (do (set! (. r inbuf) (cat [@(. r inbuf) b])) (recur)))))))))
(defun consume (r: Rec n: i64) -> (Array i8)
  (let [b @(. r inbuf)] (do (set! (. r inbuf) (drop-bytes b n)) (slice b 0 n))))

;; ---- one record off the wire
(defun open-record :private (p: p r: Rec pr: Prot header: (Array i8) frag: (Array i8)) :where ((CryptoProvider p)) -> (Result RecIn TlsError)
  (match (c/aead-open p (. pr alg) (. pr key) (record-nonce (. pr iv) (. pr seq)) header frag)
    ((Err e) (if (unsupported? e) (Err (from-crypto e)) (Err (proto-alert 20 "bad_record_mac: a record does not authenticate"))))
    ((Ok pt) (do (set! (. r rd) (some (with pr (seq (+ (. pr seq) 1)))))
                 (let [end (loop [i (- (array-len pt) 1)] (cond (< i 0) -1 (not (= (b-at pt i) 0)) i :else (recur (- i 1))))]
                   (cond (= end -1) (Err (proto-alert 10 "an encrypted record of padding only"))
                         (> end max-plain) (Err (proto-alert 22 "record_overflow: an inner plaintext over 2^14"))
                         (not (includes? (b-at pt end) [21 22 23])) (Err (proto-alert 10 "an unknown inner content type"))
                         :else (Ok (RecIn (b-at pt end) (slice pt 0 end)))))))))

(defun finish-record :private (p: p r: Rec enc: (Option Prot) ct: i64 header: (Array i8) frag: (Array i8)) :where ((CryptoProvider p)) -> (Result RecIn TlsError)
  (match enc
    (nil (Ok (RecIn ct frag)))
    ((some pr) (if (>= (. pr seq) seq-bound) (Err (proto-alert 80 "the read sequence number is at its bound")) (open-record p r pr header frag)))))

(defun read-record (p: p r: Rec) :where ((CryptoProvider p)) -> (Result RecIn TlsError)
  (try-let [_ (fill r 5)]
    (let [hb @(. r inbuf) ct (b-at hb 0) ver (be16 hb 1) len (be16 hb 3) enc @(. r rd)]
      (cond (not (= (shr ver 8) 3)) (Err (proto-alert 10 "a record with a major version other than 3"))
            (and (some? enc) (not (= ct 23)) (not (= ct 20))) (Err (proto-alert 10 "a plaintext record after the handshake keys are on"))
            (> len (if (some? enc) max-cipher max-plain)) (Err (proto-alert 22 "record_overflow: a record over the limit"))
            (and (some? enc) (= ct 23) (< len 17)) (Err (proto-err "an encrypted record too short for a tag and a type"))
            (not (includes? ct [20 21 22 23])) (Err (proto-alert 10 "an unknown record type"))
            :else (try-let [_ (fill r (+ 5 len))]
                    (let [header (consume r 5) frag (consume r len)]
                      (cond (and (= ct 20)) (if (and (= len 1) (= (b-at frag 0) 1) @(. r handshaking) (< @(. r ccs) 2))
                                              (do (set! (. r ccs) (+ @(. r ccs) 1)) (read-record p r))
                                              (Err (proto-alert 10 "an unexpected change_cipher_spec")))
                            :else (finish-record p r enc ct header frag))))))))

;; ---- writing
(defun seal-record :private (p: p r: Rec ct: i64 data: (Array i8)) :where ((CryptoProvider p)) -> (Result (Array i8) TlsError)
  (match @(. r wr)
    (nil (Ok (cat [(w8 ct) (w16 771) (vec16 data)])))
    ((some pr)
      (if (>= (. pr seq) seq-bound) (Err (proto-alert 80 "the write sequence number is at its bound"))
        (let [inner (cat [data (w8 ct)]) header (cat [(w8 23) (w16 771) (w16 (+ (array-len inner) 16))])]
          (match (c/aead-seal p (. pr alg) (. pr key) (record-nonce (. pr iv) (. pr seq)) header inner)
            ((Err e) (Err (from-crypto e)))
            ((Ok sealed) (do (set! (. r wr) (some (with pr (seq (+ (. pr seq) 1))))) (Ok (cat [header sealed]))))))))))

;; The records of `data` (split at 2^14) of content type `ct`, in order, as one array: one write.
(defun records-of (p: p r: Rec ct: i64 data: (Array i8)) :where ((CryptoProvider p)) -> (Result (Array i8) TlsError)
  (loop [off 0 acc []]
    (if (and (>= off (array-len data)) (> (count acc) 0)) (Ok (cat acc))
      (let [end (min (array-len data) (+ off max-plain))]
        (match (seal-record p r ct (slice data off end))
          ((Err e) (Err e))
          ((Ok rec) (recur end (conj acc rec))))))))
(defun send (p: p r: Rec ct: i64 data: (Array i8)) :where ((CryptoProvider p)) -> (Result unit TlsError)
  (try-let [bytes (records-of p r ct data)] ((. (. r io) write) bytes)))
;; The first ClientHello goes out with the record version 0x0301 (RFC 8446 5.1: for compatibility), as plaintext.
(defun send-client-hello (r: Rec hello: (Array i8)) -> (Result unit TlsError)
  ((. (. r io) write) (cat [(w8 22) (w16 769) (vec16 hello)])))

;; ---- handshake messages: a message may span records, and a record may hold several messages
(defun pop-message (r: Rec) -> (Result (Option HsMsg) TlsError)
  (let [b @(. r hsbuf)]
    (if (< (array-len b) 4) (Ok nil)
      (let [len (be24 b 1)]
        (cond (> len max-hs-message) (Err (proto-alert 22 "record_overflow: a handshake message over the limit"))
              (< (array-len b) (+ 4 len)) (Ok nil)
              :else (do (set! (. r hsbuf) (drop-bytes b (+ 4 len)))
                        (Ok (some (HsMsg (b-at b 0) (slice b 4 (+ 4 len)) (slice b 0 (+ 4 len)))))))))))
(defun alert-error (data: (Array i8)) -> TlsError
  (if (not (= (array-len data) 2)) (proto-err "an alert record is not two bytes")
    (if (= (b-at data 1) 0) Truncated (TlsAlert (b-at data 1) (alert-name (b-at data 1))))))

(defun next-message (p: p r: Rec) :where ((CryptoProvider p)) -> (Result HsMsg TlsError)
  (match (pop-message r)
    ((Err e) (Err e))
    ((Ok (some m)) (Ok m))
    ((Ok nil) (match (read-record p r)
                ((Err e) (Err e))
                ((Ok x) (cond (= (. x type) ct-handshake)
                                (if (= (array-len (. x data)) 0) (Err (proto-err "an empty handshake record"))
                                  (do (set! (. r hsbuf) (cat [@(. r hsbuf) (. x data)])) (next-message p r)))
                              (> (array-len @(. r hsbuf)) 0) (Err (proto-alert 10 "a record of another type inside a handshake message"))
                              (= (. x type) ct-alert) (Err (match (alert-error (. x data)) ((Truncated) (TlsAlert 0 "close_notify (during the handshake)")) (e e)))
                              :else (Err (proto-alert 10 "application data during the handshake"))))))))
(defun message-boundary? (r: Rec) -> bool (= (array-len @(. r hsbuf)) 0))
