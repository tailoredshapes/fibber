;; fib.tls.client: `connect` runs the TLS 1.3 client handshake over an `Io` (any byte stream) with a crypto provider and a `ClientConfig`, and returns a `Session` or the
;; typed reason. The handshake is bounded by `handshake-timeout-ms` through the stream's own deadline (cleared afterwards). Any failure sends the alert that names it
;; (best effort), closes the stream and returns the error; nothing falls back to a weaker protocol, suite or check. The provider is a VALUE the caller passes: there
;; is no global provider (docs/adr/0013).
(ns fib.tls.client (:use fib.core fib.seq fib.coll fib.crypto.types fib.tls.types fib.tls.bytes fib.tls.msg fib.tls.record fib.tls.hello fib.tls.hs fib.tls.hs-flight fib.tls.conn)
  (:require [fib.os.time :as time]))

(defun give-up :private (p: p hs: Hs e: TlsError) :where ((CryptoProvider p)) -> TlsError
  (do (if (match e ((TlsAlert _ _) false) ((Truncated) false) ((TransportFailed _) false) ((TlsTimeout _) false) (_ true))
        (do (send p (. hs rec) ct-alert (alert-body true (alert-for e))) ()) ())
      (release-keys (. hs rec))
      ((. (. (. hs rec) io) close))
      e))

;; Runs the handshake with the given hooks (`connect` passes the real ones). A ready-made first ClientHello is `start` with its key.
(defun connect-start (p: p cfg: ClientConfig io: Io hooks: Hooks st: Start key: (dyn PrivateKey :send)) :where ((CryptoProvider p)) -> (Result (Pair Session HsDone) TlsError)
  (let [hs (new-hs cfg io hooks st key)]
    (do ((. io set-deadline) (+ (time/clock-now) (* 1000000 (. cfg handshake-timeout-ms))))
        (match (run-handshake p hs)
          ((Err e) (Err (give-up p hs e)))
          ((Ok d) (do ((. io set-deadline) 0) (Ok (Pair (make-session p (. hs rec) d) d))))))))

(defun connect-with (p: p cfg: ClientConfig io: Io hooks: Hooks) :where ((CryptoProvider p)) -> (Result Session TlsError)
  (match (make-offer p cfg)
    ((Err e) (do ((. io close)) (Err e)))
    ((Ok o) (match (fresh-hello p cfg o)
              ((Err e) (do ((. io close)) (Err e)))
              ((Ok sk) (match (connect-start p cfg io hooks (. sk fst) (. sk snd)) ((Err e) (Err e)) ((Ok r) (Ok (. r fst)))))))))

(defun connect (p: p cfg: ClientConfig io: Io) :where ((CryptoProvider p)) -> (Result Session TlsError)
  (connect-with p cfg io (default-hooks p cfg)))
