;; fib.crypto: the interface for cryptography, with no cryptography in it (docs/design/crypto.md). A DRIVER implements `CryptoProvider`
;; over a C library (fib-crypto-openssl, fib-crypto-apple: their own repositories); a program holds the provider as a value and passes it
;; to the code that needs it. Explicit: `(:require [fib.crypto :as c])`.
;;
;;   (match (openssl/open-provider) ((Ok p) ..) ((Err e) ..))              ; a driver's constructor
;;   (c/digest p :sha-256 (str-bytes "abc"))                               ; (Result (Array i8) CryptoError)
;;   (c/hmac p :sha-256 key data)   (c/pbkdf2 p :sha-256 password salt 4096 32)   (c/hkdf p :sha-256 ikm salt info 42)
;;   (c/random-bytes p 32)          (c/ct= p a b)           (c/supports? p :argon2id)
;;   (c/hex bytes)  (c/unhex "ab")  (c/base64 bytes)  (c/unbase64 "AQI=")  (c/base64url-nopad bytes)   ; fib.crypto.encoding, ours
;;
;;   (c/aead-seal p :aes-256-gcm key nonce aad pt)  (c/aead-open ..)   (c/generate-key p :x25519)  (c/import-public-key p spki-der)  (c/verify-signature ..)
;;
;; An algorithm the provider lacks is an `unsupported` CryptoError, never a silent fallback. NOT audited; see lib/fib/crypto/README.md.
(ns fib.crypto (:export-from fib.crypto.types fib.crypto.ops fib.crypto.pk fib.crypto.der fib.crypto.encoding))
