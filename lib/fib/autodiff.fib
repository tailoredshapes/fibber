;; fib.autodiff: reverse-mode automatic differentiation on fib.tensor (docs/design/autodiff.md). Explicit: (:require [fib.autodiff :as ad]).
;;   (ad/value-and-grad f params) (ad/grad f params) (ad/backward out)                                                  tape.fib, run.fib
;;   ad/add ad/sub ad/mul ad/div ad/neg ad/scale ad/exp ad/log ad/tanh ad/relu ad/sigmoid ad/sum ad/mean ad/sum-axis
;;   ad/reshape ad/transpose ad/broadcast-to                                                                            ops.fib
;;   ad/matmul ad/dense ad/softmax ad/softmax-cross-entropy                                                             nn.fib
;;   ad/sgd-step ad/adam-init ad/adam-step                                                                              optim.fib
;; Not in the facade (it pulls in fib.parallel): (:require [fib.autodiff.parallel :as adp]) for adp/shard-value-and-grad.
(ns fib.autodiff (:export-from fib.autodiff.tape fib.autodiff.run fib.autodiff.ops fib.autodiff.nn fib.autodiff.optim fib.autodiff.real))
