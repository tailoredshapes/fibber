;; fib.string: the functions of clojure.string, required with the alias `str` (stdlib §4.7). A facade over its
;; parts, as the four implicit modules are (tranche 1 plan PC-2): `(:require [fib.string :as str])`, then
;; `(str/split s ",")`. `fib.string.utf8` is the byte layer the parts share and is not re-exported.
(ns fib.string (:export-from fib.string.pattern fib.string.search fib.string.split fib.string.join fib.string.trim fib.string.view))
