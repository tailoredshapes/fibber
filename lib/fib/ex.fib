;; fib.ex (stdlib §2.10 step 1, rows ex-info ex-data ex-message ex-cause): exceptions as plain data, usable as the error of a `Result`
;; and as what a handler reports. `throw`, `try`, `catch` and `finally` are not here: they need unwinding (L28 step 2, docs/design/
;; exceptions.md 4.2); until then `(throw e)` is `(trap (ex-message e))` and a program that must recover returns a `Result`.
;; Decided here, where the page leaves a choice (the page's `Val` is the type of fib.data, which does not exist yet):
;;  - `ExInfo` is generic in its data: `(ExInfo d)` holds a message, a `d` and an optional cause; a program that keeps maps of
;;    heterogeneous values has no `Val` to put in them until fib.data, so it picks its own `d`.
;;  - Clojure's three-argument `(ex-info msg data cause)` is `ex-info-cause`: a function has one arity until L1.
;;  - `ex-cause` is `(Option (ExInfo d))`, Clojure's `nil` when there is no cause.
(ns fib.ex)

(defstruct (ExInfo d) (message: str data: d cause: (Option (ExInfo d))))
(derive Eq ExInfo)

(defun ex-info (message: str data: d) -> (ExInfo d) (ExInfo message data nil))

(defun ex-info-cause (message: str data: d cause: (ExInfo d)) -> (ExInfo d) (ExInfo message data (some cause)))

(defun ex-message (e: (ExInfo d)) -> str (. e message))

(defun ex-data (e: (ExInfo d)) -> d (. e data))

(defun ex-cause (e: (ExInfo d)) -> (Option (ExInfo d)) (. e cause))
