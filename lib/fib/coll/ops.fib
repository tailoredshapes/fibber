;; fib.coll.ops: the operations over the key protocols (tranche 1 plan §4.2; owner L8b).
;; get/3, update, update-or, update-opt and into: none of them knows a collection type, each is written
;; over Lookup, Assoc and Collection, so a user type with those instances has them. Decided here, where the
;; page is silent:
;;  - update traps `update: no key` on a missing key, where Clojure's (update m :n inc) throws a
;;    NullPointerException; update-or and update-opt are the typed forms that cope with a missing key.
;;  - the function parameter of update, update-or and update-opt is :borrow: it is called, never stored.
;;  - into requires the Collection instance to answer its own type ((Collection t t e), the page's
;;    `into requires r = s`): (into [] ..) is a Vec and (into {} ..) a Map, and a Range, whose conj answers
;;    an LSeq, is no target.
(ns fib.coll.ops (:use fib.core fib.seq fib.coll.protocols))

;; (update m k f): m with f of the value at k; a missing key traps
(defun update (m: s k: k f: (fn (v) v) :borrow) :where ((Lookup s k v) (Assoc s k v)) -> s
  (match (get m k)
    (nil (trap "update: no key"))
    ((some x) (assoc m k (f x)))))

;; (update-or m k f d): f sees d when k is missing
(defun update-or (m: s k: k f: (fn (v) v) :borrow d: v) :where ((Lookup s k v) (Assoc s k v)) -> s
  (let ((cur (get m k d)))
    (assoc m k (f cur))))

;; (update-opt m k f): f sees the value as an Option, nil when k is missing
(defun update-opt (m: s k: k f: (fn ((Option v)) v) :borrow) :where ((Lookup s k v) (Assoc s k v)) -> s
  (assoc m k (f (get m k))))

;; (into to c): to with every element of c conj-ed on, in c's order
(defun into (to: t c: c) :where ((Collection t t e) (Reducible c e)) -> t
  (let ((acc (cell to)))
    (do (each-while c (fn (x) (do (set! acc (conj @acc x)) true)))
        @acc)))
