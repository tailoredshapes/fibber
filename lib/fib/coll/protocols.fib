;; fib.coll.protocols: the key-addressed protocols of stdlib §2.3 and the first instances (tranche 1 plan §4.2;
;; owner P0, the instances for the other collections L8a, L8b).
;; Replaces the prelude's Associative (split into Lookup, Assoc and Dissoc, so a Vec can be looked up and a Set
;; dissociated), Collection and Indexable, which the flip deleted. conj's result type is the instance's: the collection
;; itself, or an LSeq for a seq. Seeded here: Collection for Vec and VSeq, Lookup and Emptyable for Vec; get on a
;; Vec is nil out of range, as Clojure's. The List variants are `Empty` and `Cons` (R2).
(ns fib.coll.protocols (:use fib.core fib.seq))
(defprotocol (Lookup s k v)   (get (self key: k) -> (Option v)))
(defprotocol (Assoc s k v)    (assoc (self key: k val: v) -> Self))
(defprotocol (Dissoc s k)     (dissoc (self key: k) -> Self))
(defprotocol (Keyed s k)      (contains? (self key: k) -> bool))
(defprotocol Emptyable        (empty (self) -> Self))
(defprotocol (Stack s e)      (peek (self) -> (Option e)) (pop (self) -> Self))
(defprotocol (Reversible s e) (each-while-rev (self k: (fn (e) bool) :borrow) -> bool))
(defprotocol (KeyReducible m k v) (each-kv-while (self k: (fn (k v) bool) :borrow) -> bool))
;; conj's result type is the instance's: the collection itself, or an LSeq for a seq
(defprotocol (Collection s r e) (conj (self x: e) -> r))
;; seed instances (P0): Vec and VSeq. L8a adds the rest.
(impl (Collection (Vec a) a) (Vec a) (conj (self x) (vec-conj self x)))
(impl (Collection (VSeq a) a) (VSeq a) (conj (self x) (VSeq (Cons x (. self front)) (. self v) (. self lo))))
(impl (Lookup i64 a) (Vec a)
  (get (self i) (if (if (>= i 0) (< i (vec-count self)) false) (some (vec-nth self i)) nil)))
(impl Emptyable (Vec a) (empty (self) (vec-empty)))
