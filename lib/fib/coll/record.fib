;; fib.coll.record: the macros `defrecord` and `with` (stdlib §4.2 rows defrecord, ->Name, with; tranche 2 plan Y8, items L17 and
;; PC2-5). Exports the two macros; ->Name is the function `defrecord` writes, one per record, not a name of this part. Replaces
;; nothing in the prelude.
;;
;; (defrecord Name [f: T ..]) expands to the defstruct, the six derives and the positional constructor, in one top-level do:
;;   (do (defstruct Name (f: T ..)) (derive Eq Name) .. (derive ToStr Name) (defun ->Name (f: T ..) -> Name (Name f ..)))
;; (defrecord (Name a b) [f: a ..]) is the same with the head as the struct's own and as the result type of ->Name, so a
;; generic record works as R8's derive does (syntax §3.16). A field with no instance of one of the six is the checker's error
;; naming the type and the first instance missing; there is no default derive in tranche 2 (the opt-out is a defstruct with
;; the derives its author chooses). `println` of a record is Show, whose derived text is the builtin's, not the page's: case 2806.
;;
;; (with e (f v) ..) is (let ((c (cell e))) (do (set-field! &c f v) .. @c)) with c a gensym: e is evaluated once, each v
;; after it and in order against the original e, and e is not touched (probe P16).
;;
;; Decided here, where the page is silent:
;;  - the fields are the vector `[f: T ..]` (a list is accepted too); a record has at least one field, and every field is
;;    written `f: T` with its type, so the type of ->Name is known without reading the struct (the macro cannot, it expands
;;    before the struct exists). Each of those is a `(trap "defrecord: ...")`, which fibref reports as `macro defrecord
;;    failed: FILE:L:C: trap: defrecord: ...`; the stage-1 fibc aborts the compiler on a macro's trap instead, so these
;;    errors are shown by fibref only (reported, not cased).
;;  - the derives are written with the bare protocol names: `derive` takes no qualified name (`fib.core/Eq` is "cannot derive").
;;  - `(with e)` is e; an update that is not a list of a field and a value is `(trap "with: each update is (field value)")`;
;;    the field is not looked up, so an unknown one is set-field!'s own error (`P has no field z`, case 2808).
;;  - macro bodies use the prelude's names only (`vec-count vec-nth vec-conj str-concat str-len str-slice str-byte-at`):
;;    the library's `count` and `nth` are not bound at expansion time (stdlib §6.3).
(ns fib.coll.record)

;; a copy of the struct e with the named fields replaced. A new value that reads the field it replaces reads it once, into a `let`:
;; `(set-field! &c f (let ((t (. e f))) v))`, which the checker turns into a take from the cell when e is named nowhere else (types §6.3,
;; "Field moves", the `with` take), so the field of a unique struct is updated where it lies
(defmacro with (e ... updates)
  (let ((c (gensym "with"))
        (en (match e ((Sym s) s) (_ "")))
        (named (fn (x: Form s: str) -> bool (match x ((Sym n) (= n s)) (_ false))))
        (kids (fn (x: Form) -> (Vec Form) (match x ((List xs) xs) ((Vec xs) xs) ((Map xs) xs) (_ (vec-empty)))))
        ;; x is the read of the field f of the target: (. e f) or (:f e)
        (hit? (fn (x: Form f: str) -> bool
                (match x
                  ((List xs) (or (and (= (vec-count xs) 3) (named (vec-nth xs 0) ".") (named (vec-nth xs 1) en) (named (vec-nth xs 2) f))
                                 (and (= (vec-count xs) 2) (named (vec-nth xs 1) en) (match (vec-nth xs 0) ((Kw k) (= k f)) (_ false)))))
                  (_ false))))
        ;; the occurrences in x of the target's name, and of reads of its field f
        (uses (fn uses (x: Form f: str) -> (Pair i64 i64)
                (if (hit? x f)
                    (Pair 1 1)
                    (let ((xs (kids x)))
                      (loop ((i 0) (m (if (named x en) 1 0)) (h 0))
                        (if (< i (vec-count xs))
                            (match (uses (vec-nth xs i) f) ((Pair a b) (recur (+ i 1) (+ m a) (+ h b))))
                            (Pair m h)))))))
        ;; x with each read of the field f of the target replaced by t
        (swap (fn swap (x: Form f: str t: Form) -> Form
                (if (hit? x f)
                    t
                    (let ((xs (kids x))
                          (ys (loop ((i 0) (ys (vec-empty))) (if (< i (vec-count xs)) (recur (+ i 1) (vec-conj ys (swap (vec-nth xs i) f t))) ys))))
                      (match x ((List _) (List ys)) ((Vec _) (Vec ys)) ((Map _) (Map ys)) (_ x)))))))
    (let ((pairs (loop ((i 0) (ps (vec-empty)))
                   (if (< i (vec-count updates))
                       (match (vec-nth updates i)
                         ((List pair) (if (= (vec-count pair) 2) (recur (+ i 1) (vec-conj ps pair)) (trap "with: each update is (field value)")))
                         (_ (trap "with: each update is (field value)")))
                       ps)))
          (fname (fn (pair: (Vec Form)) -> str (match (vec-nth pair 0) ((Sym s) s) (_ "")))))
      ;; the take is used when every mention of the target in the new values is a read of the field that value replaces, and that
      ;; field is replaced once; else each value reads the target itself (and the cell's struct is shared while it does)
      (let ((takes (loop ((i 0) (ok (not (= en ""))) (ts (vec-empty)))
                     (if (and ok (< i (vec-count pairs)))
                         (let ((pair (vec-nth pairs i)) (f (fname pair)))
                           (match (uses (vec-nth pair 1) f)
                             ((Pair m h)
                              (let ((once (loop ((j 0) (n 0)) (if (< j (vec-count pairs)) (recur (+ j 1) (if (= (fname (vec-nth pairs j)) f) (+ n 1) n)) (= n 1)))))
                                (recur (+ i 1) (and (= m h) (or (= h 0) once)) (vec-conj ts (> h 0)))))))
                         (if ok ts (vec-empty))))))
        (let ((sets (loop ((i 0) (sets (vec-empty)))
                      (if (< i (vec-count pairs))
                          (let ((pair (vec-nth pairs i)) (f (vec-nth pair 0)) (v (vec-nth pair 1)))
                            (recur (+ i 1)
                                   (vec-conj sets
                                             (if (and (< i (vec-count takes)) (vec-nth takes i))
                                                 (let ((t (gensym "old")))
                                                   `(set-field! (& ~c) ~f (let ((~t (. ~e ~f))) ~(swap v (fname pair) t))))
                                                 `(set-field! (& ~c) ~f ~v)))))
                          sets))))
          `(let ((~c (fib.prelude/cell ~e)))
             (do ~@sets @~c)))))))

;; the struct, its six derives and ->Name; the field names for the constructor are the written ones without the colon
(defmacro defrecord (head fields)
  (let ((tag (match head
               ((Sym _) head)
               ((List parts)
                (if (> (vec-count parts) 0)
                    (match (vec-nth parts 0)
                      ((Sym _) (vec-nth parts 0))
                      (_ (trap "defrecord: the name is Name or (Name param ..)")))
                    (trap "defrecord: the name is Name or (Name param ..)")))
               (_ (trap "defrecord: the name is Name or (Name param ..)"))))
        (items (match fields
                 ((Vec xs) xs)
                 ((List xs) xs)
                 (_ (trap "defrecord: the fields are a vector [f: T ..]"))))
        (ctor (match tag
                ((Sym s) (Sym (str-concat "->" s)))
                (_ (trap "defrecord: the name is Name or (Name param ..)")))))
    (loop ((i 0) (names (vec-empty)))
      (if (< i (vec-count items))
          (match (vec-nth items i)
            ((Sym s)
             (let ((n (str-len s)))
               (if (and (> n 1)
                        (< (+ i 1) (vec-count items))
                        (= (str-byte-at s (- n 1)) 58i8))
                   (recur (+ i 2) (vec-conj names (Sym (str-slice s 0 (- n 1)))))
                   (trap "defrecord: a field is written f: T"))))
            (_ (trap "defrecord: a field is written f: T")))
          (if (= (vec-count names) 0)
              (trap "defrecord: a record has at least one field")
              `(do (defstruct ~head ~(List items))
                   (derive Eq ~tag)
                   (derive Ord ~tag)
                   (derive Hash ~tag)
                   (derive Show ~tag)
                   (derive Debug ~tag)
                   (derive ToStr ~tag)
                   (defun ~ctor ~(List items) -> ~head (~tag ~@names))))))))
