;; fib.coll.map: Map and Set through the protocols of fib.coll.protocols, and the functions that read a map
;; entry or build a collection from keys (tranche 1 plan §4.2; owner L8b).
;; Replaces the prelude's Associative instance of Map and its Collection instance of Set, which the flip deleted; its
;; `contains?`, `dissoc` and `disj` functions stay, and the instances here call the
;; prelude's low-level functions (map-assoc map-get map-empty dissoc contains? disj set-contains? set-empty
;; vec-conj), which are public: the flip deleted the prelude's protocols and kept `dissoc` and
;; `contains?` (or their renamed twins) for these instances. Decided here, where the page is silent:
;;  - (Collection (Map k v) (Pair k v)) takes a Pair, as the page says; a two-element Vec waits for L23.
;;  - Set has no Lookup: Clojure's (get #{1} 1) answers the element, which waits for L21 (callable sets).
;;    A Set is Keyed, Dissoc, Collection and Emptyable.
;;  - keys and vals answer an LSeq of the keys or values in the walk's order, which is the hash's; the
;;    two are in one order. The walk of the map happens when keys is called (it collects a Vec, and the
;;    seq is the lazy view of that Vec, to-lseq), as the table's note "an empty recipe, not nil" allows.
;;    They read any source of Pairs through Reducible: a Map is one (fib.seq.sources), and so is a Vec of Pairs.
;;  - merge is right-biased over two maps (Clojure's: the later map wins a conflict). The macro that
;;    nests more operands is Rust (R6a).
;;  - this part walks a Map only through Reducible (each-while), whose Map instance is L5a's and stops at
;;    the first false; it names no entry type of the prelude.
;; Every instance for Map and Set needs (Hash k) (Eq k).
(ns fib.coll.map (:use fib.core fib.seq fib.coll.protocols))

;; the map entry is a Pair: key and val read it
(defun key (p: (Pair k v)) -> k (. p fst))
(defun val (p: (Pair k v)) -> v (. p snd))

;; Map
(impl (Lookup k v) (Map k v) :where ((Hash k) (Eq k))
  (get (self key) (fib.prelude/map-get self key)))
(impl (Assoc k v) (Map k v) :where ((Hash k) (Eq k))
  (assoc (self key val) (fib.prelude/map-assoc self key val)))
(impl (Dissoc k) (Map k v) :where ((Hash k) (Eq k))
  (dissoc (self key) (fib.prelude/dissoc self key)))
(impl (Keyed k) (Map k v) :where ((Hash k) (Eq k))
  (contains? (self key) (fib.prelude/contains? self key)))
(impl (Collection (Map k v) (Pair k v)) (Map k v) :where ((Hash k) (Eq k))
  (conj (self x) (fib.prelude/map-assoc self (. x fst) (. x snd))))
(impl Emptyable (Map k v) (empty (self) (fib.prelude/map-empty)))

;; Set: the keys of a Map
(impl (Dissoc k) (Set k) :where ((Hash k) (Eq k))
  (dissoc (self key) (fib.prelude/disj self key)))
(impl (Keyed k) (Set k) :where ((Hash k) (Eq k))
  (contains? (self key) (fib.prelude/set-contains? self key)))
(impl (Collection (Set k) k) (Set k) :where ((Hash k) (Eq k))
  (conj (self x) (Set (fib.prelude/map-assoc (. self m) x true))))
(impl Emptyable (Set k) (empty (self) (fib.prelude/set-empty)))

;; (disj s x): s without x; the page's `disj` is the Dissoc method under its Clojure name
(defun disj (s: s x: k) :where ((Dissoc s k)) -> s (dissoc s x))

(defun keys (m: m) :where ((Reducible m (Pair k v))) -> (LSeq k)
  (let ((acc (cell (vec-empty))))
    (do (each-while m (fn (p) (do (set! acc (fib.prelude/vec-conj @acc (. p fst))) true)))
        (to-lseq @acc))))

(defun vals (m: m) :where ((Reducible m (Pair k v))) -> (LSeq v)
  (let ((acc (cell (vec-empty))))
    (do (each-while m (fn (p) (do (set! acc (fib.prelude/vec-conj @acc (. p snd))) true)))
        (to-lseq @acc))))

;; (merge a b): a with every entry of b, b's value winning a conflict
(defun merge (a: (Map k v) b: (Map k v)) :where ((Hash k) (Eq k)) -> (Map k v)
  (let ((acc (cell a)))
    (do (each-while b
          (fn (p) (do (set! acc (fib.prelude/map-assoc @acc (. p fst) (. p snd))) true)))
        @acc)))

;; (select-keys m ks): the entries of m whose key is in ks, always as a Map, whatever m is (Clojure builds it from {};
;; a Vec of values gives a Map of index to value); a key m lacks is skipped
(defun select-keys (m: s ks: c) :where ((Lookup s k v) (Hash k) (Eq k) (Reducible c k)) -> (Map k v)
  (let ((acc (cell (fib.prelude/map-empty))))
    (do (each-while ks
          (fn (k) (do (match (get m k) (nil ()) ((some v) (set! acc (fib.prelude/map-assoc @acc k v)))) true)))
        @acc)))

;; (set c): the elements of c as a Set
(defun set (c: c) :where ((Reducible c e) (Hash e) (Eq e)) -> (Set e)
  (let ((acc (cell (fib.prelude/set-empty))))
    (do (each-while c (fn (x) (do (set! acc (conj @acc x)) true)))
        @acc)))
