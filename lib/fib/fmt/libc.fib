;; The libc symbol fib.fmt wraps (an extern is named for its C symbol, so it cannot share a module with the function
;; that wraps it). Not for programs: calls need `unsafe`.
(ns fib.fmt.libc)

;; snprintf is variadic: on Apple arm64 the arguments after the format go on the stack, so the double must be a variadic argument (`:fixed 3`: three real
;; parameters), not a fixed one. strfromd, a fixed-arity glibc function, does not exist on macOS.
(extern snprintf (ptr i64 ptr f64) -> i32 :varargs :fixed 3)
