;; fib.json.eisel: the Eisel-Lemire fast path of decimal to double (docs/design/json.md 3; Lemire, "Number parsing at a gigabyte per second").
;; `(eisel-lemire w q)` is w * 10^q rounded to nearest-even as a positive double, for a decimal mantissa 0 < w < 2^63, or 0.0 when the
;; method cannot decide (a rare near-tie, an overflow, an underflow): the caller then asks strtod. The language has no 64x64 to 128 multiply
;; and no unsigned type: `mul128` builds the product from 32-bit limbs with the wrapping family, and unsigned comparisons flip the sign bit.
;; The table of 128-bit powers of five is fib.json.pow5 (generated by scripts/gen-json-pow5.py).
(ns fib.json.eisel (:use fib.core fib.seq fib.coll fib.json.pow5))

(def m32: i64 4294967295)
(def sign-bit: i64 -9223372036854775808)

;; Unsigned a < b.
(defun ult (a: i64 b: i64) -> bool (< (bit-xor a sign-bit) (bit-xor b sign-bit)))

;; The high 64 bits of the unsigned product a*b; the low 64 bits go to `lo`.
(defun mul128 (a: i64 b: i64 &lo: i64) -> i64
  (let [a0 (bit-and a m32) a1 (shr a 32) b0 (bit-and b m32) b1 (shr b 32)
        p00 (unchecked-multiply a0 b0) p01 (unchecked-multiply a0 b1) p10 (unchecked-multiply a1 b0) p11 (unchecked-multiply a1 b1)
        mid (+ (+ (shr p00 32) (bit-and p01 m32)) (bit-and p10 m32))]
    (do (set! lo (bit-or (bit-and p00 m32) (shl mid 32)))
        (unchecked-add (unchecked-add p11 (shr p01 32)) (unchecked-add (shr p10 32) (shr mid 32))))))

(defun clz64 (w: i64) -> i64 (clz w))

(defun to-double (mant: i64 power2: i64) -> f64
  (bits->f64 (bit-or (bit-and mant 4503599627370495) (shl power2 52))))

;; w * 2^lz normalised, times the table's 128-bit 5^q: the high word, with the low word in `lo`; widened by the second word when the first is ambiguous.
(defun product (wn: i64 q: i64 &lo: i64) -> i64
  (let [idx (* 2 (+ q 342))
        hi5 (array-get pow5 idx)
        l1 (cell 0)
        h1 (mul128 wn hi5 &l1)]
    (if (= (bit-and h1 511) 511)
        (let [l2 (cell 0)
              h2 (mul128 wn (array-get pow5 (+ idx 1)) &l2)
              low (unchecked-add @l1 h2)]
          (do (set! lo low) (if (ult low h2) (unchecked-add h1 1) h1)))
        (do (set! lo @l1) h1))))

(defun subnormal (mant: i64 power2: i64) -> f64
  (if (>= (+ (- 0 power2) 1) 64)
      0.0
      (let [m1 (shr mant (+ (- 0 power2) 1))
            m2 (shr (+ m1 (bit-and m1 1)) 1)]
        (to-double m2 (if (< m2 4503599627370496) 0 1)))))

(defun eisel-lemire (w: i64 q: i64) -> f64
  (if (or (< q -342) (> q 308))
      0.0
      (let [lz (clz64 w)
            wn (shl w lz)
            lo (cell 0)
            upper (product wn q &lo)
            lower @lo]
        (if (and (= lower -1) (or (< q -27) (> q 55)))
            0.0
            (let [upperbit (shr upper 63)
                  mant (shr upper (+ upperbit 9))
                  power2 (- (+ (+ (sar (* 217706 q) 16) 63) upperbit) (- lz 1023))]
              (if (<= power2 0)
                  (subnormal mant power2)
                  (let [m0 (if (and (and (and (>= lower 0) (<= lower 1)) (and (>= q -4) (<= q 23))) (= (bit-and mant 3) 1))
                               (if (= (shl mant (+ upperbit 9)) upper) (bit-and mant -2) mant)
                               mant)
                        m1 (shr (+ m0 (bit-and m0 1)) 1)
                        carry (>= m1 9007199254740992)
                        m2 (if carry 4503599627370496 m1)
                        p2 (if carry (+ power2 1) power2)]
                    (if (>= p2 2047) 0.0 (to-double m2 p2)))))))))
