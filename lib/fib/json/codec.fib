;; fib.json.codec: typed records (docs/design/json.md 2, 5). `defjson` writes a struct, its `ToJson` instance (encode) and a decoder that reads the
;; tape directly: no intermediate `Json` DOM is built, a field is found by key, converted in place and stored in the record.
;;   (defjson Person [name: str age: i64 tags: (Vec str) boss: (Option Person) score: f64 ok: bool])
;;   (->json p)                      -> Json            ; then fib.json/write
;;   (decode-Person text)            -> (Result Person JsonError)       ; the function `decode-` + the name
;;   (json->Person doc node)         -> (Option Person)                 ; for a record inside another document
;; A field is i64, f64 (an integer is accepted), str, bool, (Vec T), (Option T) (a missing key or null is nil), or another defjson record. A missing
;; key, a value of another kind or a number that does not fit is a mismatch: the result is an Err with code 16 (the key's offset is not tracked; the message names the type).
;; Duplicate keys: the first one is read. Unknown keys are ignored.
(ns fib.json.codec (:use fib.core fib.seq fib.coll fib.json.types fib.json.tape fib.json.tapebuild fib.json.view fib.json.convert) (:require [fib.json.codecform :as f] [fib.json.buffer :as b] [fib.json.libc :as libc]))

(def e-mismatch: i64 16)

;; The direct encoder's block handling (the writers are fib.json.writefast's): a block of `cap` bytes from the large-block cache, its pointer, the finished bytes, the next size.
(defun enc-block (cap: i64) -> (Array f64) (unsafe (array-uninit-f64 (quot cap 8))))
(defun enc-ptr (ba: (Array f64)) -> ptr (unsafe (ptr+ (raw ba) 24)))
(defun enc-finish (ba: (Array f64) n: i64) -> (Array i8)
  (let [out (array n 0i8)] (do (unsafe (libc/memcpy (ptr+ (raw out) 24) (ptr+ (raw ba) 24) n)) out)))
(defun enc-grow (cap: i64) -> i64 (cond (= cap 4096) 65536 (= cap 65536) 4194304 :else (* cap 8)))
(defun enc-scratch () -> (Array i8) (b/new-buffer 64))

(defun dec-i64 (d: Doc n: i64) -> (Option i64) (if (>= n 0) (node-i64 d n) nil))
(defun dec-f64 (d: Doc n: i64) -> (Option f64) (if (>= n 0) (node-f64 d n) nil))
(defun dec-str (d: Doc n: i64) -> (Option str) (if (>= n 0) (node-str d n) nil))
(defun dec-bool (d: Doc n: i64) -> (Option bool) (if (>= n 0) (node-bool d n) nil))

;; An array whose every element decodes through f.
(defun dec-vec (d: Doc n: i64 f: (fn (i64) (Option a))) -> (Option (Vec a))
  (if (and (>= n 0) (= (kind-of d n) k-array))
      (let [end (word1 d n)]
        (loop [j (+ n 2) out: (Vec a) []]
          (if (>= j end) (some out)
              (if-some [x (f j)] (recur (next-node d j) (conj out x)) nil))))
      nil))

;; Some of the inner Option when the key is there and not null; Some nil when it is missing or null; nil when the value does not decode.
(defun dec-opt (d: Doc n: i64 f: (fn (i64) (Option a))) -> (Option (Option a))
  (if (or (< n 0) (= (kind-of d n) k-null)) (some nil)
      (if-some [x (f n)] (some (some x)) nil)))

;; Where a node does not decode (the generated `diag-NAME` functions walk the same fields as the decoder): the leaf's message, with the path of the node from the root.
(defun mismatch (d: Doc n: i64 p: str want: str) -> str
  (if (< n 0) (str p ": missing, expected " want) (str p ": expected " want ", found " (node-kind d n))))

(defun diag-vec (d: Doc n: i64 p: str f: (fn (i64 str) (Option str))) -> (Option str)
  (cond (< n 0) (some (str p ": missing, expected array"))
        (!= (kind-of d n) k-array) (some (str p ": expected array, found " (node-kind d n)))
        :else (let [end (word1 d n)]
                (loop [j (+ n 2) k 0]
                  (if (>= j end) nil
                      (match (f j (str p "[" k "]")) ((some m) (some m)) (nil (recur (next-node d j) (+ k 1)))))))))

(defun diag-opt (d: Doc n: i64 p: str f: (fn (i64 str) (Option str))) -> (Option str)
  (if (or (< n 0) (= (kind-of d n) k-null)) nil (f n p)))

(defun diag-object (d: Doc i: i64 p: str) -> (Option str)
  (cond (< i 0) (some (str p ": missing, expected object"))
        (!= (kind-of d i) k-object) (some (str p ": expected object, found " (node-kind d i)))
        :else nil))

(defun decode-with (s: str what: str f: (fn (Doc i64) (Option a)) g: (fn (Doc i64 str) (Option str))) -> (Result a JsonError)
  (match (tape-of s)
    ((Err e) (Err e))
    ((Ok d) (if-some [x (f d 0)] (Ok x)
              (Err (JsonError e-mismatch (str "the document does not match " what (match (g d 0 "$") ((some m) (str " at " m)) (nil ""))) 0 1 1))))))

(defmacro defjson (head fields)
  (let ((tag (match head ((Sym _) head) (_ (trap "defjson: the name is a symbol"))))
        (items (match fields ((Vec xs) xs) (_ (trap "defjson: the fields are a vector [f: T ..]"))))
        (name (f/sym-text head)))
    (let ((n (quot (vec-count items) 2)))
      (let ((names (loop ((i 0) (acc (vec-empty))) (if (< i n) (recur (+ i 1) (vec-conj acc (Sym (f/field-name (vec-nth items (* 2 i)))))) acc)))
            (types (loop ((i 0) (acc (vec-empty))) (if (< i n) (recur (+ i 1) (vec-conj acc (vec-nth items (+ (* 2 i) 1)))) acc))))
        (let ((keys (loop ((i 0) (acc (vec-empty))) (if (< i n) (recur (+ i 1) (vec-conj acc (Str (f/sym-text (vec-nth names i))))) acc)))
              (encoded (loop ((i 0) (acc (vec-empty)))
                         (if (< i n) (recur (+ i 1) (vec-conj acc `(->json (. self ~(vec-nth names i))))) acc)))
              (enc-fields (loop ((i (- n 1)) (acc `(fib.json.writefast/wchar b cap pp 125)))
                       (if (>= i 0)
                           (recur (- i 1) `(let [pp (fib.json.writefast/wlit b cap pp ~(Str (str-concat (if (= i 0) "\"" ",\"") (str-concat (f/sym-text (vec-nth names i)) "\":"))))]
                                             (if (< pp 0) -1
                                                 (let [pp ~(f/encoder (vec-nth types i) `(. self ~(vec-nth names i)) 0)]
                                                   (if (< pp 0) -1 ~acc)))))
                           acc)))
              (diags (loop ((i (- n 1)) (acc `nil))
                       (if (>= i 0)
                           (recur (- i 1) `(if-some [m ~(f/diagnoser (vec-nth types i) `(field d i ~(Str (f/sym-text (vec-nth names i)))) `(str p ~(Str (str-concat "." (f/sym-text (vec-nth names i))))))] (some m) ~acc))
                           acc)))
              (built (loop ((i (- n 1)) (acc `(some (~tag ~@names))))
                       (if (>= i 0)
                           (recur (- i 1) `(if-some [~(vec-nth names i) ~(f/decoder (vec-nth types i) `(field d i ~(Str (f/sym-text (vec-nth names i)))))] ~acc nil))
                           acc))))
          `(do (defstruct ~head ~(List items))
               (derive Eq ~tag)
               (derive Debug ~tag)
               (impl fib.json.convert/ToJson ~tag (->json (self) (JObj [~@keys] [~@encoded])))
               (defun ~(Sym (str-concat "wenc-" name)) (b: ptr cap: i64 pp: i64 self: ~tag &tb: (Array i8) &tl: i64) -> i64
                 (let [pp (fib.json.writefast/wchar b cap pp 123)] (if (< pp 0) -1 ~enc-fields)))
               (defun ~(Sym (str-concat "encode-bytes-" name)) (x: ~tag) -> (Array i8)
                 (let [tb (cell (fib.json.codec/enc-scratch)) tl (cell 0)]
                   (loop [cap 4096]
                     (let [ba (fib.json.codec/enc-block cap) r (~(Sym (str-concat "wenc-" name)) (fib.json.codec/enc-ptr ba) cap 0 x &tb &tl)]
                       (if (>= r 0) (fib.json.codec/enc-finish ba r) (recur (fib.json.codec/enc-grow cap)))))))
               (defun ~(Sym (str-concat "encode-" name)) (x: ~tag) -> str (str-from-bytes (~(Sym (str-concat "encode-bytes-" name)) x)))
               (defun ~(Sym (str-concat "json->" name)) (d: Doc i: i64) -> (Option ~tag) (if (< i 0) nil ~built))
               (defun ~(Sym (str-concat "diag-" name)) (d: Doc i: i64 p: str) -> (Option str)
                 (if-some [m (fib.json.codec/diag-object d i p)] (some m) ~diags))
               (defun ~(Sym (str-concat "decode-" name)) (s: str) -> (Result ~tag JsonError)
                 (decode-with s ~(Str name) (fn (d: Doc i: i64) (~(Sym (str-concat "json->" name)) d i))
                              (fn (d: Doc i: i64 p: str) (~(Sym (str-concat "diag-" name)) d i p))))))))))
