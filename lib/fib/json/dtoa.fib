;; fib.json.dtoa: a double as the shortest decimal text that reads back as the same double (docs/design/json.md 4). Schubfach (Giulietti, "The Schubfach
;; way to render doubles", the algorithm of the JDK's Double.toString since 19): three multiplications of the 126-bit table entry g(k) (fib.json.pow10) by
;; the scaled mantissa and its two neighbours give the interval of decimals that round to the double; one of the candidates inside it is the answer, the
;; closest to the double. No division, no big integers, no libc. Verified against Python's repr on millions of doubles (scripts/json-floats.sh).
;; The text always has a `.` or an exponent, so that it reads back as a float: `100.0`, `1.5e-7`, `1e21`; plain notation for decimal exponents -5 to 16.
(ns fib.json.dtoa (:use fib.core fib.seq fib.coll fib.json.buffer fib.json.eisel fib.json.pow10))

(def mask63: i64 9223372036854775807)

(defun flog10pow2 (e: i64) -> i64 (sar (* e 677859288149824) 51))
(defun flog10-three-quarters-pow2 (e: i64) -> i64 (sar (- (* e 677859288149824) 281337023816640) 51))
(defun flog2pow10 (e: i64) -> i64 (sar (* e 935039633142894) 48))

;; Schubfach's rounding to odd of g * cp / 2^126, g = g1 2^63 + g0.
(defun rop (g1: i64 g0: i64 cp: i64) -> i64
  (let [l (cell 0)
        x1 (mul128 g0 cp &l)
        y0 (unchecked-multiply g1 cp)
        y1 (mul128 g1 cp &l)
        z (unchecked-add (shr y0 1) x1)
        vbp (unchecked-add y1 (shr z 63))]
    (bit-or vbp (shr (unchecked-add (bit-and z mask63) mask63) 63))))

;; The decimal f * 10^k for the double with mantissa c and exponent q (c * 2^q), c > 0: f has at most 17 digits and may end in zeros. Answers f, k in `kout`.
(defun to-decimal (c: i64 q: i64 &kout: i64) -> i64
  (let [out (bit-and c 1)
        cb (shl c 2)
        cbr (+ cb 2)
        regular (or (!= c 4503599627370496) (= q -1074))
        cbl (if regular (- cb 2) (- cb 1))
        k (if regular (flog10pow2 q) (flog10-three-quarters-pow2 q))
        h (+ (+ q (flog2pow10 (- 0 k))) 2)
        idx (* 2 (+ k 324))
        g1 (array-get pow10 idx)
        g0 (array-get pow10 (+ idx 1))
        vb (rop g1 g0 (shl cb h))
        vbl (rop g1 g0 (shl cbl h))
        vbr (rop g1 g0 (shl cbr h))
        s (sar vb 2)]
    (do (set! kout k)
        (let [sp10 (* 10 (quot s 10))
              tp10 (+ sp10 10)
              upin (<= (+ vbl out) (shl sp10 2))
              wpin (<= (+ (shl tp10 2) out) vbr)]
          (if (and (>= s 100) (!= upin wpin))
              (if upin sp10 tp10)
              (let [t (+ s 1)
                    uin (<= (+ vbl out) (shl s 2))
                    win (<= (+ (shl t 2) out) vbr)]
                (if (!= uin win)
                    (if uin s t)
                    (let [cmp (- vb (shl (+ s t) 1))]
                      (if (or (< cmp 0) (and (= cmp 0) (= (bit-and s 1) 0))) s t)))))))))

(defun digit-count (f: i64) -> i64
  (cond (< f 100000000) (cond (< f 10000) (cond (< f 100) (if (< f 10) 1 2) (< f 1000) 3 :else 4)
                              (< f 1000000) (if (< f 100000) 5 6)
                              :else (if (< f 10000000) 7 8))
        (< f 10000000000000000) (cond (< f 1000000000000) (cond (< f 10000000000) (if (< f 1000000000) 9 10) (< f 100000000000) 11 :else 12)
                                      (< f 100000000000000) (if (< f 10000000000000) 13 14)
                                      :else (if (< f 1000000000000000) 15 16))
        :else (if (< f 100000000000000000) 17 18)))

(defun ten-pow (n: i64) -> i64
  (loop [i 0 p 1] (if (= i n) p (recur (+ i 1) (* p 10)))))

;; ---- the text, written straight to memory (JSON-3): a float is at most 25 bytes, so the caller has room for 32 and nothing here checks. Position in, position out.

(defun dput (p: ptr at: i64 c: i64) -> unit (unsafe (store-i8 (ptr+ p at) (trunc i8 c))))

;; The `width` digits of v >= 0 (leading zeros kept) at p+at, last digit last, two digits at a time from the table of the hundred pairs.
(defun dig-write (p: ptr at: i64 width: i64 v: i64) -> unit
  (loop [k (+ at (- width 1)) x v w width]
    (cond (>= w 2) (let [q (quot x 100) r (- x (* q 100))]
                     (do (dput p k (zext i64 (str-byte-at digit-pairs (+ (* r 2) 1))))
                         (dput p (- k 1) (zext i64 (str-byte-at digit-pairs (* r 2))))
                         (recur (- k 2) q (- w 2))))
          (= w 1) (dput p k (+ 48 x))
          :else ())))

;; f (no trailing zeros, n digits) times 10^k as JSON text at p+at: plain notation for decimal exponents -5 to 16, else d.ddde[-]x.
(defun dtoa-decimal (p: ptr at: i64 f: i64 n: i64 k: i64) -> i64
  (let [e (+ k (- n 1))]
    (cond (and (>= e 0) (< e 17))
          (if (<= n (+ e 1))
              (do (dig-write p at n f)
                  (loop [i (+ at n)] (if (< i (+ at (+ e 1))) (do (dput p i 48) (recur (+ i 1)))
                                         (do (dput p i 46) (dput p (+ i 1) 48) (+ i 2)))))
              (let [fl (- n (+ e 1))
                    d (ten-pow fl)
                    ip (quot f d)]
                (do (dig-write p at (+ e 1) ip)
                    (dput p (+ at (+ e 1)) 46)
                    (dig-write p (+ at (+ e 2)) fl (- f (* ip d)))
                    (+ at (+ n 1)))))
          (and (< e 0) (>= e -5))
          (do (dput p at 48) (dput p (+ at 1) 46)
              (loop [i (+ at 2)] (if (< i (+ at (- 1 e))) (do (dput p i 48) (recur (+ i 1)))
                                     (do (dig-write p i n f) (+ i n)))))
          :else
          (let [d (ten-pow (- n 1))
                lead (quot f d)
                ae (if (< e 0) (- 0 e) e)
                a1 (if (> n 1) (do (dput p (+ at 1) 46) (dig-write p (+ at 2) (- n 1) (- f (* lead d))) (+ at (+ n 1))) (+ at 1))]
            (do (dput p at (+ 48 lead))
                (dput p a1 101)
                (let [a2 (if (< e 0) (do (dput p (+ a1 1) 45) (+ a1 2)) (+ a1 1))
                      nd (digit-count ae)]
                  (do (dig-write p a2 nd ae) (+ a2 nd))))))))

;; x as JSON text at p (32 bytes of room): the length. A NaN or an infinity is `null`.
(defun dtoa-raw (p: ptr x: f64) -> i64
  (if (!= (- x x) 0.0)
      (do (unsafe (store-i32 p 1819047278i32)) 4)
      (let [bits (f64->bits x)
            neg (< bits 0)
            mag (bit-and bits mask63)
            bq (shr mag 52)
            frac (bit-and mag 4503599627370495)
            at (if neg (do (dput p 0 45) 1) 0)]
        (if (= mag 0)
            (do (dput p at 48) (dput p (+ at 1) 46) (dput p (+ at 2) 48) (+ at 3))
            (let [kc (cell 0)
                  f0 (if (= bq 0) (to-decimal frac -1074 &kc) (to-decimal (bit-or frac 4503599627370496) (- bq 1075) &kc))
                  fc (cell f0)]
              (do (loop [] (when (= (rem @fc 10) 0) (do (set! fc (quot @fc 10)) (set! kc (+ @kc 1)) (recur))))
                  (dtoa-decimal p at @fc (digit-count @fc) @kc)))))))

(defun put-f64 (&buf: (Array i8) &len: i64 x: f64) -> unit
  (do (ensure &buf &len 32)
      (set! len (+ @len (dtoa-raw (unsafe (ptr+ (raw @buf) (+ 24 @len))) x)))))
