;; fib.json.stage1: simdjson's stage 1 in fibber's lane vectors (docs/design/json.md 3, docs/shootout/json.md): the positions of everything stage 2 has to look at, found
;; 64 bytes at a time. Per block: byte-class compares on an `i8x64` (LLVM splits it to the target's width), each turned into a 64-bit mask by `simd/movemask`
;; (one `pmovmskb` per 16 or 32 lanes, `kmov` on AVX-512, the NEON equivalent on aarch64); escaped quotes are removed with simdjson's odd-backslash-run addition; the
;; inside-a-string mask is the prefix XOR of the quote bits by a shift/xor ladder (no carry-less multiply); positions leave the word with `ctz`, eight at a time
;; written unconditionally (the branch is on the count, not on every bit).
;; The index holds, in ascending order: every unescaped quote (an even count of them per string: the opening one, then the closing one), every structural character
;; `{ } [ ] : ,` outside a string, and the first byte of every other token outside a string (a number or `true`, `false`, `null`: a run of bytes that are none of
;; whitespace, structural or a quote). `flags` (an OR of f-control, f-unterminated) says what stage 1 saw that stage 2 must act on: a control byte inside a
;; string, a string still open at the end. The index lives in malloc'ed memory (a malloc'ed buffer,
;; not an array: no zero-fill, and `realloc` grows it): the caller frees it with `sidx-free`.
;;   (structural-index s) -> Sidx
(ns fib.json.stage1 (:use fib.core fib.seq fib.coll) (:require [fib.json.libc :as libc]))

(def even-bits: i64 6148914691236517205)
(def f-control: i64 1)
(def f-unterminated: i64 2)

(defstruct Sidx (p: ptr count: i64 flags: i64 closing: i64))

(defun sidx-free (x: Sidx) -> unit (unsafe (free (. x p))))
(defun sidx-at (x: Sidx k: i64) -> i64 (unsafe (load-i64 (ptr+ (. x p) (* 8 k)))))

(defun cmp-eq (v: (Simd i8 64) c: i8) -> (Simd bool 64) (simd/eq v (splat (Simd i8 64) c)))
(defun mask-eq (v: (Simd i8 64) c: i8) -> i64 (simd/movemask (cmp-eq v c)))

;; `{ } [ ] : ,`: `[` and `]` are `{` and `}` with bit 5 set, so two compares do the four brackets.
(defun op-mask (v: (Simd i8 64)) -> i64
  (let [t (bit-or v (splat (Simd i8 64) 32i8))]
    (simd/movemask (simd/or (simd/or (cmp-eq t 123i8) (cmp-eq t 125i8)) (simd/or (cmp-eq v 58i8) (cmp-eq v 44i8))))))

(defun ws-mask (v: (Simd i8 64)) -> i64
  (simd/movemask (simd/or (simd/or (cmp-eq v 32i8) (cmp-eq v 10i8)) (simd/or (cmp-eq v 13i8) (cmp-eq v 9i8)))))

;; The bytes below 0x20 (a byte of 0x80 or more has bit 7 set and is not).
(defun ctl-mask (v: (Simd i8 64)) -> i64
  (simd/movemask (simd/eq (bit-and v (splat (Simd i8 64) -32i8)) (splat (Simd i8 64) 0i8))))

(defun ult (x: i64 y: i64) -> bool (< (bit-xor x -9223372036854775808) (bit-xor y -9223372036854775808)))

;; simdjson's find_escaped, in two pure halves: the bits of the characters that follow an odd-length run of backslashes, and whether the block ends on one
;; (`c`: whether the previous block did, 0 or 1).
(defun esc-sum (bs0: i64 c: i64) -> i64
  (let [bs (bit-and bs0 (bit-not c))
        follows (bit-or (shl bs 1) c)]
    (unchecked-add (bit-and (bit-and bs (bit-not even-bits)) (bit-not follows)) bs)))

(defun esc-mask (bs0: i64 c: i64) -> i64
  (let [bs (bit-and bs0 (bit-not c))
        follows (bit-or (shl bs 1) c)]
    (bit-and (bit-xor even-bits (shl (esc-sum bs0 c) 1)) follows)))

(defun esc-carry (bs0: i64 c: i64) -> i64
  (let [bs (bit-and bs0 (bit-not c))
        follows (bit-or (shl bs 1) c)]
    (if (ult (esc-sum bs0 c) (bit-and (bit-and bs (bit-not even-bits)) (bit-not follows))) 1 0)))

;; Bit i of the result is the XOR of bits 0..i of x (carry-less multiplication by all ones, as a ladder).
(defun prefix-xor (x: i64) -> i64
  (let [a (bit-xor x (shl x 1)) b (bit-xor a (shl a 2)) c (bit-xor b (shl b 4)) d (bit-xor c (shl c 8)) e (bit-xor d (shl d 16))]
    (bit-xor e (shl e 32))))

;; ---- the index: eight positions written at a time

(defun put-one (o: ptr k: i64 m: i64 base: i64) -> i64
  (do (unsafe (store-i64 (ptr+ o (shl k 3)) (unchecked-add base (ctz m)))) (bit-and m (unchecked-subtract m 1))))

;; Four positions at a time: small enough for the compiler to inline into the block loop (an eight-at-a-time function is not, and a call costs a `vzeroupper`).
(defun put-four (o: ptr k: i64 m0: i64 base: i64) -> i64
  (let [m1 (put-one o k m0 base) m2 (put-one o (unchecked-add k 1) m1 base) m3 (put-one o (unchecked-add k 2) m2 base)]
    (put-one o (unchecked-add k 3) m3 base)))

;; The positions of the set bits of m, offset by base, from slot k; the new count. Sixteen slots are written whatever the count (a block rarely has more, and a
;; branch on the count mispredicts about as often as it costs); beyond 16 a loop. Up to `cnt + 15` slots are written.
(defun flatten (o: ptr k: i64 m: i64 base: i64) -> i64
  (let [cnt (popcount m)
        m4 (put-four o k m base)
        m8 (put-four o (unchecked-add k 4) m4 base)]
    (if (<= cnt 8) (unchecked-add k cnt)
        (loop [m m8 j (unchecked-add k 8)]
          (if (= m 0) j (recur (put-one o j m base) (unchecked-add j 1)))))))

;; ---- one block

(defun load-block (p: ptr i: i64) -> (Simd i8 64) (unsafe (load-simd (ptr+ p i))))

(defun grow (o: ptr cap: i64) -> ptr (unsafe (libc/realloc o (* 8 (* cap 2)))))

;; The state carried from block to block: the escape carry (0/1), the in-string state (0 or -1), the last bit of the token-byte mask (0/1), the flags.
(defun index-text (p: ptr n: i64 pad: ptr) -> Sidx
  (let [cap0 (+ 256 (quot n 8))]
    (loop [i 0 k 0 o (unsafe (alloc (* 8 cap0))) cap cap0 carry 0 instr 0 prevt 0 flags 0 nq 0]
      (if (>= i n)
          (Sidx o k (if (= instr 0) flags (bit-or flags f-unterminated)) nq)
          (if (> (+ k 96) cap)
              (recur i k (grow o cap) (* cap 2) carry instr prevt flags nq)
              (let [v (if (<= (+ i 64) n) (load-block p i) (load-block pad 0))
                    q (mask-eq v 34i8)
                    bs (mask-eq v 92i8)
                    esc (if (= (bit-or bs carry) 0) 0 (esc-mask bs carry))
                    quote (bit-and q (bit-not esc))
                    inq (bit-xor (prefix-xor quote) instr)
                    ops (op-mask v)
                    ws (ws-mask v)
                    tok (bit-not (bit-or (bit-or ws ops) (bit-or quote inq)))
                    starts (bit-and tok (bit-not (bit-or (shl tok 1) prevt)))
                    m (bit-or (bit-or (bit-and ops (bit-not inq)) quote) starts)
                    fl (bit-or flags (if (= (bit-and (ctl-mask v) inq) 0) 0 f-control))]
                (recur (+ i 64) (flatten o k m i) o cap (esc-carry bs carry) (sar inq 63) (shr tok 63) fl (unchecked-add nq (popcount (bit-and quote (bit-not inq)))))))))))

(defun structural-index (s: str) -> Sidx
  (let [n (str-len s)
        pad (unsafe (alloc 64))
        full (* 64 (quot n 64))]
    (do (unsafe (do (loop [j 0] (when (< j 64) (do (store-i8 (ptr+ pad j) 32i8) (recur (+ j 1)))))
                    (loop [j full] (when (< j n) (do (store-i8 (ptr+ pad (- j full)) (load-i8 (ptr+ (raw s) (+ 24 j)))) (recur (+ j 1)))))))
        (let [r (index-text (unsafe (ptr+ (raw s) 24)) n (if (= full n) pad pad))]
          (do (unsafe (free pad)) r)))))
