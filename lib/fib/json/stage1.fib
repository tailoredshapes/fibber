;; fib.json.stage1: simdjson's stage 1 in fibber's lane vectors (docs/design/json.md 3, docs/shootout/json.md): the positions of every unescaped quote and of every
;; structural character (`{ } [ ] : ,`) outside a string, found 64 bytes at a time. Per 16 bytes: compares against the byte classes (`simd/eq`, `simd/or` on masks);
;; the masks become integers by `bits16`, which has to EMULATE a movemask (the language has none: a mask is converted to 0/1 lanes, widened to i32, multiplied by
;; 2^lane and summed); the four 16-bit masks make one 64-bit word; escaped quotes are removed with simdjson's odd-backslash-run addition; the inside-a-string mask is the
;; prefix XOR of the quote bits by a shift/xor ladder (no carry-less multiply); positions leave the word with a count-trailing-zeros loop, ctz written as
;; popcount((x & -x) - 1) (there is no ctz builtin). The result is not yet what the tape builder consumes (it validates as it goes): this module is the measured
;; experiment of phase 2, and its output equals a scalar reference (specs/json-simd-spec.fib).
;;   (structural-index a n) -> (Pair (Array i64) i64)   the positions (ascending) in the first `count` words of the array; `a` holds n bytes of text
(ns fib.json.stage1 (:use fib.core fib.seq fib.coll fib.simd))

(def weights16: (Simd i32 16) <<1 2 4 8 16 32 64 128 256 512 1024 2048 4096 8192 16384 32768>>i32)
(def even-bits: i64 6148914691236517205)

;; The 16 mask lanes as the low 16 bits of an integer (lane 0 is bit 0).
(defun bits16 (m: (Simd bool 16)) -> i64
  (let [ones: (Simd i8 16) (simd/blend m (splat (Simd i8 16) 1i8) (splat (Simd i8 16) 0i8))
        wide: (Simd i32 16) (simd/convert ones)]
    (sext i64 (hsum (* wide weights16)))))

(defun cmp-eq (v: (Simd i8 16) c: i8) -> (Simd bool 16) (simd/eq v (splat (Simd i8 16) c)))

(defun structural16 (v: (Simd i8 16)) -> i64
  (bits16 (simd/or (simd/or (simd/or (cmp-eq v 123i8) (cmp-eq v 125i8)) (simd/or (cmp-eq v 91i8) (cmp-eq v 93i8))) (simd/or (cmp-eq v 58i8) (cmp-eq v 44i8)))))

;; The masks of the 64 bytes at i: quote, backslash and structural bits.
(defun classify64 (a: (Array i8) i: i64 &quote: i64 &bs: i64) -> i64
  (let [v0: (Simd i8 16) (simd-load a i)
        v1: (Simd i8 16) (simd-load a (+ i 16))
        v2: (Simd i8 16) (simd-load a (+ i 32))
        v3: (Simd i8 16) (simd-load a (+ i 48))]
    (do (set! quote (bit-or (bit-or (bits16 (cmp-eq v0 34i8)) (shl (bits16 (cmp-eq v1 34i8)) 16))
                            (bit-or (shl (bits16 (cmp-eq v2 34i8)) 32) (shl (bits16 (cmp-eq v3 34i8)) 48))))
        (set! bs (bit-or (bit-or (bits16 (cmp-eq v0 92i8)) (shl (bits16 (cmp-eq v1 92i8)) 16))
                         (bit-or (shl (bits16 (cmp-eq v2 92i8)) 32) (shl (bits16 (cmp-eq v3 92i8)) 48))))
        (bit-or (bit-or (structural16 v0) (shl (structural16 v1) 16)) (bit-or (shl (structural16 v2) 32) (shl (structural16 v3) 48))))))

(defun ult (x: i64 y: i64) -> bool (< (bit-xor x -9223372036854775808) (bit-xor y -9223372036854775808)))

;; simdjson's find_escaped: the bits of the characters that follow an odd-length run of backslashes; `carry` is whether the previous block ended on one.
(defun find-escaped (bs0: i64 &carry: i64) -> i64
  (let [bs (bit-and bs0 (bit-not @carry))
        follows (bit-or (shl bs 1) @carry)
        odd-starts (bit-and (bit-and bs (bit-not even-bits)) (bit-not follows))
        sum (unchecked-add odd-starts bs)]
    (do (set! carry (if (ult sum odd-starts) 1 0))
        (bit-and (bit-xor even-bits (shl sum 1)) follows))))

;; Bit i of the result is the XOR of bits 0..i of x (carry-less multiplication by all ones, as a ladder).
(defun prefix-xor (x: i64) -> i64
  (let [a (bit-xor x (shl x 1)) b (bit-xor a (shl a 2)) c (bit-xor b (shl b 4)) d (bit-xor c (shl c 8)) e (bit-xor d (shl d 16))]
    (bit-xor e (shl e 32))))

(defun ctz (x: i64) -> i64 (popcount (unchecked-subtract (bit-and x (unchecked-negate x)) 1)))

;; Writes the positions of the set bits of `mask`, offset by `base`, into out from index k; answers the new k.
(defun flatten-bits (&out: (Array i64) k: i64 mask: i64 base: i64) -> i64
  (loop [m mask j k]
    (if (= m 0) j
        (do (array-set! &out j (+ base (ctz m))) (recur (bit-and m (unchecked-subtract m 1)) (+ j 1))))))

(defun block-mask (q: i64 bs: i64 st: i64 &carry: i64 &instr: i64) -> i64
  (let [escaped (find-escaped bs &carry)
        quote (bit-and q (bit-not escaped))
        in-string (bit-xor (prefix-xor quote) @instr)]
    (do (set! instr (sar in-string 63))
        (bit-or quote (bit-and st (bit-not in-string))))))

(defun structural-index (a: (Array i8) n: i64) -> (Pair (Array i64) i64)
  (let [out (cell (array (+ n 64) 0))
        carry (cell 0) instr (cell 0)
        padded (cell (array 64 32i8))
        full (* 64 (quot n 64))
        q (cell 0) bs (cell 0)
        k1 (loop [i 0 k 0]
             (if (>= i full) k
                 (let [st (classify64 a i &q &bs)
                       m (block-mask @q @bs st &carry &instr)]
                   (recur (+ i 64) (flatten-bits &out k m i)))))]
    (if (= full n)
        (Pair @out k1)
        (do (dotimes (j (- n full)) (array-set! &padded j (array-get a (+ full j))))
            (let [st (classify64 @padded 0 &q &bs)
                  m (bit-and (block-mask @q @bs st &carry &instr) (unchecked-subtract (shl 1 (- n full)) 1))]
              (let [k2 (flatten-bits &out k1 m full)] (Pair @out k2)))))))
