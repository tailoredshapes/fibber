;; fib.json.schema: JSON Schema (draft 7) for fib.json's values (docs/design/json-schema.md). Explicit: `(:require [fib.json.schema :as js])`.
;;
;;   (js/compile-schema schema-json)            -> (Result JsonSchema str)   once: `$id`s indexed, regexes compiled, every `$ref` checked
;;   (js/compile-with schema-json (with (js/schema-options) (resources {"http://x/y.json" doc}) (formats false)))
;;   (js/validate s doc)                        -> (Vec SchemaViolation)     every violation, with its instance and schema locations
;;   (js/valid? s doc)  (js/violation-text v)   "/eggs: -1 is less than the minimum of 0"
;;
;; Draft 7's keywords, `$ref` by JSON Pointer, by `$id` and by "#name", the draft-07 meta-schema built in, `format` asserted (date, time,
;; date-time, email, hostname, ipv4, ipv6, uri, uri-reference, json-pointer, relative-json-pointer, regex, uri-template; unknown formats
;; pass). Regexes are fib.regex's, not ECMA 262's: they agree on the common syntax. Checked against the JSON-Schema-Test-Suite
;; (scripts/json-schema-suite.sh).
(ns fib.json.schema (:export-from fib.json.schema.types fib.json.schema.api))
