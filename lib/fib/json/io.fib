;; fib.json.io: files and descriptors (docs/design/json.md 5). `read-file-bytes` of fib.os appended element by element and was quadratic (linear since LIBFIX-1, but still a push per byte), so reading is the
;; builtin `read-file` (one read; it answers nil for an unreadable file or for text that is not UTF-8) and, only when that fails, a chunked read through
;; file descriptors into a growable buffer, which tells an I/O error (code 15) from invalid UTF-8 (code 6, with the offset).
;; Lines and bounded memory: `reduce-lines` reads a file of one document per line (NDJSON) in chunks of 4 MiB and holds one chunk and one document at a time.
(ns fib.json.io (:use fib.core fib.seq fib.coll fib.json.types fib.json.parse fib.json.write fib.json.buffer fib.json.utf8) (:require [fib.os :as os] [fib.json.domfast :as df] [fib.json.lines :as ln] [fib.json.stream :as sm]))

(defun io-error (what: str) -> JsonError (JsonError 15 (str "I/O error: " what) 0 1 1))

;; The whole file as bytes, in chunks of 1 MiB.
(defun read-bytes (path: str) -> (Result (Array i8) JsonError)
  (match (os/open-file path (os/default-file-options))
    ((Err e) (Err (io-error (. e message))))
    ((Ok fd)
     (let [buf (cell (new-buffer 65536)) len (cell 0)
           r (loop []
               (match (os/read-fd fd 1048576)
                 ((Err e) (if (= (. e kind) os/Interrupted) (recur) (some (io-error (. e message)))))
                 ((Ok chunk) (if (= (array-len chunk) 0) nil (do (put-bytes &buf &len chunk) (recur))))))]
       (do (os/close-fd fd)
           (if-some [e r] (Err e) (Ok (buffer-bytes @buf @len))))))))

(defun read-file-with (path: str o: JsonOptions) -> (Result Json JsonError)
  (match (read-file path)
    ((some s) (df/parse-with-fast s o))
    (nil (match (read-bytes path) ((Err e) (Err e)) ((Ok b) (df/parse-bytes-with-fast b o))))))

(defun read-file-json (path: str) -> (Result Json JsonError) (read-file-with path (default-options)))

;; Writes the compact text of j to the descriptor.
(defun write-to (fd: i64 j: Json) -> (Result unit os/OSError) (os/write-all fd (write-bytes j)))


;; Writes the compact text of j to any sink: a function that takes the next piece (an array of at most 64 KiB) and answers Ok, or an error that stops the write and is returned.
;; `(write-to fd j)` is this with `(os/write-all fd piece)`; a socket, a buffer, a compressor or a test double is another sink. The text is built whole first (the DOM is in memory anyway).
(defun write-sink (j: Json sink: (fn ((Array i8)) (Result unit os/OSError))) -> (Result unit os/OSError)
  (let [b (write-bytes j) n (array-len b)]
    (loop [i 0]
      (if (>= i n) (Ok ())
          (let [e (min n (+ i 65536))]
            (match (sink (array-copy b i e)) ((Ok _) (recur e)) ((Err x) (Err x))))))))

(defun write-file-json (path: str j: Json) -> (Result unit os/OSError) (os/write-file-bytes path (write-bytes j)))

;; Folds f over the documents of a file with one per line, each as a result; a blank line is skipped. Memory: one chunk (4 MiB) plus the document.
(defun reduce-lines (path: str o: JsonOptions f: (fn (a (Result Json JsonError)) a) init: a) -> (Result a JsonError)
  (match (os/open-file path (os/default-file-options))
    ((Err e) (Err (io-error (. e message))))
    ((Ok fd)
     (let [r (loop [acc init rest: (Array i8) (array 0 0i8)]
               (match (os/read-fd fd 4194304)
                 ((Err e) (Err (io-error (. e message))))
                 ((Ok chunk)
                  (if (= (array-len chunk) 0)
                      (Ok (if (> (array-len rest) 0) (fold-lines (str-from-bytes rest) o f acc) acc))
                      (let [all (let [b (cell (new-buffer (+ (array-len rest) (array-len chunk)))) l (cell 0)]
                                  (do (put-bytes &b &l rest) (put-bytes &b &l chunk) (buffer-bytes @b @l)))
                            cut (last-newline all)]
                        (if (< cut 0)
                            (recur acc all)
                            (recur (fold-lines (str-from-bytes (array-copy all 0 cut)) o f acc) (array-copy all (+ cut 1) (array-len all)))))))))]
       (do (os/close-fd fd) r)))))

(defun last-newline (b: (Array i8)) -> i64
  (loop [i (- (array-len b) 1)] (cond (< i 0) -1 (= (array-get b i) 10i8) i :else (recur (- i 1)))))

;; Every document of a text of lines (or of concatenated documents) through f.
(defun fold-lines (s: str o: JsonOptions f: (fn (a (Result Json JsonError)) a) init: a) -> a (ln/fold-lines-seq s o f init))

;; The same for a file of one document per line, each chunk of 32 MiB parsed on all cores (the results are folded in order, so f sees the file's order); memory: a chunk, its
;; documents and the result vector. A document that spans lines is an error here (use reduce-lines). `fib.json.stream/reduce-lines-par-map` does the work of a function in the task too.
(defun reduce-lines-par (path: str o: JsonOptions f: (fn (a (Result Json JsonError)) a) init: a) -> (Result a JsonError)
  (sm/reduce-lines-par-map path o (fn (r: (Result Json JsonError)) r) f init))

(defun fold-results (rs: (Vec (Result Json JsonError)) f: (fn (a (Result Json JsonError)) a) init: a) -> a
  (loop [i 0 acc init] (if (< i (count rs)) (recur (+ i 1) (f acc (nth rs i))) acc)))
