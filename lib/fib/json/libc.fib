;; The libc symbols fib.json calls (an extern is named for its C symbol, so it cannot share a module with a function of that name).
;; `memcpy` moves bytes between the data of two arrays or strings (24 bytes after their raw pointers, rt/array.lir, rt/str.lir); `strtod`
;; is the exact fallback of the float parser and the oracle of its tests; `snprintf` is the exact fallback of the float printer.
(ns fib.json.libc)
(extern strtod (ptr ptr) -> f64)
(extern memcpy (ptr ptr i64) -> ptr)
(extern snprintf (ptr i64 ptr f64) -> i32 :varargs :fixed 3)
