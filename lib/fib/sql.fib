;; fib.sql: SQL as data, HoneySQL 2's shape (docs/design/observability-and-databases.md 5). Explicit: `(:require [fib.sql :as sql])`,
;; as HoneySQL is required (`[honey.sql :as sql]`); the macros' templates name this library's functions bare, and a template resolves in
;; the module that defines the macro (syntax §3.16 "Names in a template"), so the alias is all a module needs.
;;
;;   (sql/format (sql/sql {:select [:a [:b :bee]] :from [:t] :where [:and [:= :id id] [:> :n 3]] :order-by [[:n :desc]] :limit 10}))
;;     => (Query "SELECT a, b AS bee FROM t WHERE (id = ?) AND (n > ?) ORDER BY n DESC LIMIT ?" [(DInt id) (DInt 3) (DInt 10)])
;;   (db/execute! conn (sql/format q))                                  ; fib.db
;;   (-> (sql/select :a :b) (sql/from :t) (sql/where [:= :id 1]) sql/format)   ; the helpers build the same value
;;   (sql/format-with q :ansi)                                          ; quoted identifiers: :ansi (PostgreSQL, SQLite) or :mysql
;;
;; `sql` turns literal data into a `SqlV` at compile time: keywords are identifiers and operators, numbers and strings are parameters, a
;; symbol or a call is a run-time value (`->sqlv`: a `SqlV`, so queries compose, or any ToDatum value, as a parameter). Through the alias
;; `sql/format` leaves the implicit fib.print `format` alone; a module that `:use`s fib.sql (which still works) gets this `format`
;; instead, and `fib.print/format` still names that one.
(ns fib.sql (:export-from fib.datum fib.sql.data fib.sql.format) (:use fib.core fib.seq fib.coll fib.datum fib.sql.data fib.sql.format)
  (:require [fib.db.core :as db]))

(defmacro sql (x)
  (match x
    ((Kw k) `(QKw ~(Str k)))
    ((Int _ _) `(QParam (DInt ~x)))
    ((Flt _ _) `(QParam (DFloat ~x)))
    ((Str _) `(QParam (DStr ~x)))
    ((Bool _) `(QParam (DBool ~x)))
    ((Nil) `QNil)
    ((Vec xs) `(QVec [~@(loop ((i 0) (out (vec-empty)))
                          (if (< i (vec-count xs)) (recur (+ i 1) (vec-conj out `(sql ~(vec-nth xs i)))) out))]))
    ((Map xs) `(QMap [~@(loop ((i 0) (out (vec-empty)))
                          (if (< (+ i 1) (vec-count xs))
                              (recur (+ i 2) (vec-conj out (match (vec-nth xs i)
                                                             ((Kw k) `(Pair ~(Str k) (sql ~(vec-nth xs (+ i 1)))))
                                                             (_ (trap "sql: a clause name is a keyword")))))
                              out))]))
    (_ `(->sqlv ~x))))

(defun dialect-of (name: keyword) -> Dialect
  (cond (= name :mysql) (Dialect "`") (= name :none) (Dialect "") :else (Dialect "\"")))

;; The statement and its parameters, unquoted identifiers (HoneySQL's default).
(defun format (q: SqlV) -> db/Query (format-with q :none))

(defun format-with (q: SqlV dialect: keyword) -> db/Query
  (let [ps (cell [])
        d (dialect-of dialect)
        text (match q ((QMap es) (query-text d es &ps)) (_ (expr d q &ps)))]
    (db/Query text @ps)))

;; ---- helpers: (select :a :b), (from q :t), (where q [:= :id 1]) .. as HoneySQL's honey.sql.helpers; a first argument that is a
;; keyword or a vector starts a new query, anything else is the query to add to.
(defmacro select (... args) `(helper-add "select" ~@args))
(defmacro from (... args) `(helper-add "from" ~@args))
(defmacro order-by (... args) `(helper-add "order-by" ~@args))
(defmacro where (q c) `(add-where ~q (sql ~c)))
(defmacro limit (q n) `(with-clause ~q "limit" (sql ~n)))

(defmacro helper-add (name ... args)
  (let ((fresh (if (> (vec-count args) 0)
                   (match (vec-nth args 0) ((Kw _) true) ((Vec _) true) (_ false))
                   true))
        (start (if fresh 0 1)))
    `(add-to-clause ~(if fresh `QNil (vec-nth args 0)) ~name
       [~@(loop ((i start) (out (vec-empty)))
            (if (< i (vec-count args)) (recur (+ i 1) (vec-conj out `(sql ~(vec-nth args i)))) out))])))
