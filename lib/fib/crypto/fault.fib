;; fib.crypto.fault: how a driver shows its contract run can fail (docs/design/crypto.md 8, method rule: a test that cannot fail is worse than none).
;; `(Faulty real fault)` wraps a REAL provider and breaks one thing, a decorator, not a driver: it does no cryptography of its own.
;; A driver repository runs the contract against each fault and expects `contract-failures` to be non-empty.
;;   :truncate    every digest and HMAC loses its last byte
;;   :flip-bit    every digest and HMAC has the low bit of its last byte flipped
;;   :wrong-alg   a request for SHA-256 is answered with SHA-512's start
;;   :zero-random random-bytes returns zeros
;;   :ct-true     the comparison says equal for any two arrays of one length
;;   :pbkdf2-plus PBKDF2 runs one iteration more than asked
;;   :fallback    an algorithm the provider lacks is answered by SHA-256 instead of an error
;;   :overclaim   the capability list names `:rot13`, which nothing implements
;; AEAD, key agreement and signatures (docs/design/crypto.md 9), each a way a real library or binding goes wrong; `fault-scenarios` names the scenario
;; of the contracts that must fail for each:
;;   :aead-skip-tag     open does not verify the tag: an error becomes a success with the ciphertext as the "plaintext" (the library skips the check)
;;   :aead-short-tag    seal drops the last byte of the tag (a wrong tag length)
;;   :aead-ignore-aad   seal and open pass an empty AAD
;;   :aead-fixed-nonce  seal and open use an all-zero nonce whatever the caller gave (nonce reuse)
;;   :aead-flip-tag     seal flips a bit of the tag
;;   :accept-bad-point  key agreement accepts an invalid or small-order peer and answers an all-zero secret
;;   :kex-flip          the shared secret has a bit flipped
;;   :public-flip       the public key of a generated or imported private key has a bit flipped
;;   :accept-bad-sig    verify answers Ok for a signature that does not verify
;;   :reject-good-sig   verify answers an error for a good signature
;;   :sign-flip         a signature has a bit flipped
(ns fib.crypto.fault
  (:use fib.core fib.seq fib.coll fib.test.core fib.crypto.types fib.crypto.ops))

(defun tampered (fault: keyword b: (Array i8)) -> (Array i8)
  (cond (= fault :truncate) (array-copy b 0 (max 0 (- (array-len b) 1)))
        (= fault :flip-bit)
          (let [c (cell (array-copy b 0 (array-len b)))]
            (do (when (> (array-len b) 0) (array-set! &c (- (array-len b) 1) (bit-xor (array-get b (- (array-len b) 1)) 1i8))) @c))
        :else b))

(defstruct FaultyHasher (inner: (dyn Hasher :send) fault: keyword))
(impl Hasher FaultyHasher
  (hasher-update (self data off len) (hasher-update (. self inner) data off len))
  (hasher-finish (self)
    (match (hasher-finish (. self inner))
      ((Ok b) (Ok (tampered (. self fault) b)))
      ((Err e) (Err e))))
  (hasher-close (self) (hasher-close (. self inner))))

(defstruct Faulty (inner: (dyn CryptoProvider :send) fault: keyword))

;; ---- key handles: the wrapper of a private or public key does what the real one does, then breaks one thing.
(defstruct FaultyPrivate (inner: (dyn PrivateKey :send) fault: keyword))
(impl PrivateKey FaultyPrivate
  (private-key-kind (self) (private-key-kind (. self inner)))
  (private-key-public (self)
    (match (private-key-public (. self inner))
      ((Ok b) (Ok (if (= (. self fault) :public-flip) (tampered :flip-bit b) b)))
      ((Err e) (Err e))))
  (private-key-agree (self peer)
    (match (private-key-agree (. self inner) peer)
      ((Ok b) (Ok (if (= (. self fault) :kex-flip) (tampered :flip-bit b) b)))
      ((Err e) (if (= (. self fault) :accept-bad-point) (Ok (array 32 0i8)) (Err e)))))
  (private-key-sign (self scheme msg)
    (match (private-key-sign (. self inner) scheme msg)
      ((Ok b) (Ok (if (= (. self fault) :sign-flip) (tampered :flip-bit b) b)))
      ((Err e) (Err e))))
  (private-key-close (self) (private-key-close (. self inner))))

(defstruct FaultyPublic (inner: (dyn PublicKey :send) fault: keyword))
(impl PublicKey FaultyPublic
  (public-key-kind (self) (public-key-kind (. self inner)))
  (public-key-verify (self scheme msg sig)
    (match (public-key-verify (. self inner) scheme msg sig)
      ((Ok _) (if (= (. self fault) :reject-good-sig) (Err (invalid-signature)) (Ok ())))
      ((Err e) (if (= (. self fault) :accept-bad-sig) (Ok ()) (Err e)))))
  (public-key-close (self) (public-key-close (. self inner))))

(defun wrap-private :private (f: Faulty r: (Result (dyn PrivateKey :send) CryptoError)) -> (Result (dyn PrivateKey :send) CryptoError)
  (match r ((Err e) (Err e)) ((Ok k) (Ok (dyn PrivateKey :send (FaultyPrivate k (. f fault)))))))

;; The nonce and AAD the faulty seal and open pass on.
(defun nonce-for :private (f: Faulty nonce: (Array i8)) -> (Array i8) (if (= (. f fault) :aead-fixed-nonce) (array (array-len nonce) 0i8) nonce))
(defun aad-for :private (f: Faulty aad: (Array i8)) -> (Array i8) (if (= (. f fault) :aead-ignore-aad) (array 0 0i8) aad))

;; A "successful" open of what failed to authenticate: the sealed bytes without the tag.
(defun without-tag :private (sealed: (Array i8)) -> (Array i8) (array-copy sealed 0 (max 0 (- (array-len sealed) 16))))

(defun faulty-seal :private (f: Faulty alg: keyword key: (Array i8) nonce: (Array i8) aad: (Array i8) pt: (Array i8)) -> (Result (Array i8) CryptoError)
  (match (provider-aead-seal (. f inner) alg key (nonce-for f nonce) (aad-for f aad) pt)
    ((Err e) (Err e))
    ((Ok b) (Ok (cond (= (. f fault) :aead-short-tag) (tampered :truncate b) (= (. f fault) :aead-flip-tag) (tampered :flip-bit b) :else b)))))

(defun faulty-open :private (f: Faulty alg: keyword key: (Array i8) nonce: (Array i8) aad: (Array i8) sealed: (Array i8)) -> (Result (Array i8) CryptoError)
  (match (provider-aead-open (. f inner) alg key (nonce-for f nonce) (aad-for f aad) sealed)
    ((Ok b) (Ok b))
    ((Err e) (if (= (. f fault) :aead-skip-tag) (Ok (without-tag sealed)) (Err e)))))

(defun wrap-hasher :private (f: Faulty r: (Result (dyn Hasher :send) CryptoError)) -> (Result (dyn Hasher :send) CryptoError)
  (match r
    ((Err e) (Err e))
    ((Ok h) (Ok (dyn Hasher :send (FaultyHasher h (. f fault)))))))

(defun swapped-alg :private (f: Faulty alg: keyword) -> keyword
  (cond (and (= (. f fault) :wrong-alg) (= alg :sha-256)) :sha-512
        (and (= (. f fault) :fallback) (not (supports? (. f inner) alg))) :sha-256
        :else alg))

(impl CryptoProvider Faulty
  (provider-name (self) (str "faulty " (provider-name (. self inner))))
  (provider-capabilities (self)
    (if (= (. self fault) :overclaim) (conj (provider-capabilities (. self inner)) :rot13) (provider-capabilities (. self inner))))
  (provider-digest-start (self alg) (wrap-hasher self (provider-digest-start (. self inner) (swapped-alg self alg))))
  (provider-hmac-start (self alg key) (wrap-hasher self (provider-hmac-start (. self inner) (swapped-alg self alg) key)))
  (provider-derive (self k)
    (match k
      ((KdfPbkdf2 alg pw salt n len)
       (provider-derive (. self inner) (KdfPbkdf2 alg pw salt (if (= (. self fault) :pbkdf2-plus) (+ n 1) n) len)))
      (_ (provider-derive (. self inner) k))))
  (provider-random (self n)
    (if (= (. self fault) :zero-random)
      (if (< n 0) (provider-random (. self inner) n) (Ok (array n 0i8)))
      (provider-random (. self inner) n)))
  (provider-ct-equal (self a b)
    (if (= (. self fault) :ct-true) (= (array-len a) (array-len b)) (provider-ct-equal (. self inner) a b)))
  (provider-aead-seal (self alg key nonce aad pt) (faulty-seal self alg key nonce aad pt))
  (provider-aead-open (self alg key nonce aad sealed) (faulty-open self alg key nonce aad sealed))
  (provider-generate-key (self alg) (wrap-private self (provider-generate-key (. self inner) alg)))
  (provider-import-private (self alg pkcs8) (wrap-private self (provider-import-private (. self inner) alg pkcs8)))
  (provider-import-public (self spki)
    (match (provider-import-public (. self inner) spki)
      ((Err e) (Err e))
      ((Ok k) (Ok (dyn PublicKey :send (FaultyPublic k (. self fault))))))))

(defun faults () -> (Vec keyword) [:truncate :flip-bit :wrong-alg :zero-random :ct-true :pbkdf2-plus :fallback :overclaim])

;; The faults of AEAD, key agreement and signatures.
(defun pk-faults () -> (Vec keyword)
  [:aead-skip-tag :aead-short-tag :aead-ignore-aad :aead-fixed-nonce :aead-flip-tag :accept-bad-point :kex-flip :public-flip :accept-bad-sig :reject-good-sig :sign-flip])

;; Words of the ids of the scenarios that must fail under a fault of `pk-faults` (a scenario's id is its text with dashes). A renamed scenario breaks
;; the shape spec, which checks that each word is in some scenario of the contracts.
(defun fault-scenarios (fault: keyword) -> (Vec str)
  (cond (= fault :aead-skip-tag) ["every-invalid-vector" "changed-in-one-place"]
        (or (= fault :aead-short-tag) (= fault :aead-ignore-aad) (= fault :aead-fixed-nonce) (= fault :aead-flip-tag)) ["AEAD-seal-gives-the-published"]
        (= fault :accept-bad-point) ["an-invalid-peer-is-an-error" "small-order-points"]
        (or (= fault :kex-flip) (= fault :public-flip)) ["key-agreement-reproduces"]
        (or (= fault :accept-bad-sig) (= fault :reject-good-sig)) ["verify-gives-the-verdict"]
        (= fault :sign-flip) ["signing-with-a-generated-key"]
        :else []))

;; The ids of the scenarios that did not hold when run: a step that broke is a failure. A scenario that traps ends the run (a driver
;; that traps has failed too; `fibc test` shows it as a trap row).
(defun contract-failures (scs: (Vec Scenario) seed: i64) -> (Vec str)
  (vec (map (fn (sc: Scenario) (. sc id))
            (filter (fn (sc: Scenario)
                      (some? (first (filter (fn (r: StepRun) (match (. r judged) ((Held) false) ((Broke _ _) true))) ((. sc run) seed)))))
                    scs))))
