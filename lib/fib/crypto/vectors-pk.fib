;; fib.crypto.vectors-pk: GENERATED by scripts/gen-crypto-vectors-pk.sh (do not edit): the published sources (RFC texts, Project Wycheproof at the commit named in
;; scripts/fetch-crypto-vectors.sh) are checksummed by specs/crypto-vectors.sha256, every RFC value is searched in its RFC, every vector is recomputed or
;; refused by python's `cryptography`, and the file is a SUBSET. Bytes are hex.
(ns fib.crypto.vectors-pk (:use fib.core fib.seq fib.coll))
;; KexVector: `private` is PKCS#8 DER, `public` the raw public key it has, `peer` the raw peer key, `shared` the secret. KexInvalid: agree must be an error.
;; KexIterated: RFC 7748 5.2's loop (k = u = 9; k, u = X25519(k, u), k) after `n` rounds. SigVector: `key` indexes `sig-keys` (SPKI DER), `valid` is the verdict.
;; SignVector: an Ed25519 key (PKCS#8 DER), a message and the signature RFC 8032 gives.
(defstruct KexVector (alg: keyword name: str private: str public: str peer: str shared: str))
(defstruct KexInvalid (alg: keyword name: str private: str peer: str))
(defstruct KexIterated (name: str n: i64 expected: str))
(defstruct SigVector (scheme: keyword name: str key: i64 msg: str sig: str valid: bool))
(defstruct SignVector (scheme: keyword name: str private: str msg: str sig: str))


