;; fib.crypto.vectors-rsa: GENERATED by scripts/gen-crypto-vectors-rsa.sh (do not edit): RSA keys made by python's `cryptography` (PKCS#8 and the SubjectPublicKeyInfo of each)
;; and the RSASSA-PSS signatures it makes over fixed messages (MGF1 with the same hash, salt length = digest length), each verified by python before it is written.
(ns fib.crypto.vectors-rsa (:use fib.core fib.seq fib.coll))
;; RsaKey: `bits` is the modulus size; a key under 2048 bits is one a provider refuses. RsaSigned: `key` indexes `rsa-keys`, `msg` and `sig` are hex.
(defstruct RsaKey (name: str bits: i64 pkcs8: str spki: str))
(defstruct RsaSigned (scheme: keyword key: i64 name: str msg: str sig: str))

(defun rsa-keys () -> (Vec RsaKey)
  [(RsaKey "rsa-2048-a" 2048 "" "")
   (RsaKey "rsa-2048-b" 2048 "" "")
   (RsaKey "rsa-3072" 3072 "" "")
   (RsaKey "rsa-1024-refused" 1024 "" "")])

(defun rsa-signed () -> (Vec RsaSigned)
  [(RsaSigned :rsa-pss-sha256 0 "empty" "" "")
   (RsaSigned :rsa-pss-sha256 0 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha256 0 "transcript-like-1000" "" "")
   (RsaSigned :rsa-pss-sha384 0 "empty" "" "")
   (RsaSigned :rsa-pss-sha384 0 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha384 0 "transcript-like-1000" "" "")
   (RsaSigned :rsa-pss-sha256 1 "empty" "" "")
   (RsaSigned :rsa-pss-sha256 1 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha256 1 "transcript-like-1000" "" "")
   (RsaSigned :rsa-pss-sha384 1 "empty" "" "")
   (RsaSigned :rsa-pss-sha384 1 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha384 1 "transcript-like-1000" "" "")
   (RsaSigned :rsa-pss-sha256 2 "empty" "" "")
   (RsaSigned :rsa-pss-sha256 2 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha256 2 "transcript-like-1000" "" "")
   (RsaSigned :rsa-pss-sha384 2 "empty" "" "")
   (RsaSigned :rsa-pss-sha384 2 "abc" "616263" "")
   (RsaSigned :rsa-pss-sha384 2 "transcript-like-1000" "" "")])
