;; fib.crypto.contract: what any CryptoProvider must do, whoever implements it (docs/design/crypto.md 8). A DRIVER repository runs it against
;; itself: `(implements CryptoContract "openssl" (fn () <a provider>))` in a spec file, and `fibc test` judges it. It names no driver. There
;; is no fake driver in fibber: this module has no cryptography, so a provider is what the contract needs to be run, and the published
;; vectors (fib.crypto.vectors, generated by scripts/gen-crypto-vectors.sh) are the oracle. Required of every driver: the capabilities in
;; `required-capabilities`; optional: the legacy digests, scrypt, argon2id (each is tested when the provider lists it, and a name it does not
;; list must be an `unsupported` error: honesty).
(ns fib.crypto.contract
  (:use fib.core fib.seq fib.coll fib.test.core fib.crypto.types fib.crypto.ops fib.crypto.encoding fib.crypto.vectors))

(defun required-capabilities () -> (Vec keyword) [:sha-256 :sha-384 :sha-512 :hmac :pbkdf2 :hkdf :random :ct-equal])
(defun all-capabilities () -> (Vec keyword)
  [:sha-256 :sha-384 :sha-512 :sha-1 :md5 :hmac :pbkdf2 :hkdf :scrypt :argon2id :random :ct-equal])
;; The capability names of AEAD, key agreement and signatures (fib.crypto.contract-aead, -kex, -sig run their honesty checks): known, so a list that holds
;; them is not an overclaim of something nothing implements.
(defun extra-capabilities () -> (Vec keyword)
  [:aes-128-gcm :aes-256-gcm :chacha20-poly1305 :x25519 :ecdh-p256 :ecdh-p384
   :rsa-pss-sha256 :rsa-pss-sha384 :rsa-pkcs1-sha256 :rsa-pkcs1-sha384 :ecdsa-p256-sha256 :ecdsa-p384-sha384 :ed25519
   :sign-ed25519 :sign-ecdsa-p256-sha256 :sign-ecdsa-p384-sha384 :sign-rsa-pss-sha256 :sign-rsa-pss-sha384])
(defun digest-names () -> (Vec keyword) [:sha-256 :sha-384 :sha-512 :sha-1 :md5])

;; ---- helpers over the vector data
(defun bytes-hex (h: str) -> (Array i8) (match (unhex h) ((Ok b) b) ((Err e) (trap (str "contract vector: " (. e message))))))

;; A message of a vector: hex, or "rep:61:N" for N copies of the byte 0x61.
(defun message-of (m: str) -> (Array i8)
  (if (and (> (str-len m) 7) (starts-with? m "rep:"))
    (array (unwrap-or (parse-long (str-slice m 7 (str-len m))) 0) 97i8)
    (bytes-hex m)))

(defun result-hex (r: (Result (Array i8) CryptoError)) -> str
  (match r ((Ok b) (hex b)) ((Err e) (str "ERR " (. e kind) ": " (. e message)))))

(defun first-n-hex (r: (Result (Array i8) CryptoError) n: i64) -> str
  (match r ((Ok b) (if (and (> n 0) (< n (array-len b))) (hex (array-copy b 0 n)) (hex b))) ((Err e) (result-hex r))))

(defun kind-of (r: (Result (Array i8) CryptoError)) -> str
  (match r ((Ok _) "ok") ((Err e) (. e kind))))

;; The names of the vectors for which `ok?` is false.
(defun failing (xs: (Vec x) name: (fn (x) str) ok: (fn (x) bool)) -> (Vec str)
  (vec (map name (filter (fn (x: x) (not (ok x))) xs))))

(defun digest-ok? (p: p v: DigestVector) :where ((CryptoProvider p)) -> bool
  (= (. v expected) (result-hex (digest p (. v alg) (message-of (. v msg))))))

(defun mac-ok? (p: p v: MacVector) :where ((CryptoProvider p)) -> bool
  (= (. v expected) (first-n-hex (hmac p (. v alg) (bytes-hex (. v key)) (bytes-hex (. v msg))) (. v truncate))))

(defun pbkdf2-ok? (p: p v: Pbkdf2Vector) :where ((CryptoProvider p)) -> bool
  (= (. v expected) (result-hex (pbkdf2 p :sha-256 (bytes-hex (. v password)) (bytes-hex (. v salt)) (. v iterations) (. v length)))))

(defun hkdf-ok? (p: p v: HkdfVector) :where ((CryptoProvider p)) -> bool
  (= (. v expected) (result-hex (hkdf p :sha-256 (bytes-hex (. v ikm)) (bytes-hex (. v salt)) (bytes-hex (. v info)) (. v length)))))

;; Streams `data` through a started hasher in pieces of `piece` bytes, by ranges of the one array (no copy), and finishes.
(defun streamed (started: (Result (dyn Hasher :send) CryptoError) data: (Array i8) piece: i64) -> (Result (Array i8) CryptoError)
  (match started
    ((Err e) (Err e))
    ((Ok h)
     (let [n (array-len data)
           failed (loop [off 0]
                    (if (>= off n) nil
                      (match (feed-range h data off (min piece (- n off)))
                        ((Err e) (some e))
                        ((Ok _) (recur (+ off piece))))))]
       (match failed ((some e) (do (hasher-close h) (Err e))) (nil (hasher-finish h)))))))

(defun stream-ok? (p: p v: DigestVector piece: i64) :where ((CryptoProvider p)) -> bool
  (= (. v expected) (result-hex (streamed (digest-start p (. v alg)) (message-of (. v msg)) piece))))

(defun distinct-bytes (b: (Array i8)) -> i64
  (let [seen (cell (array 256 false))]
    (do (dotimes (i (array-len b)) (array-set! &seen (bit-and (zext i64 (array-get b i)) 255) true))
        (count (filter (fn (x: bool) x) (vec (map (fn (i: i64) (array-get @seen i)) (range 256))))))))

(defun all-equal? (b: (Array i8)) -> bool
  (or (< (array-len b) 2) (every? (fn (i: i64) (= (array-get b i) (array-get b 0))) (range (array-len b)))))

(defun random-len (p: p n: i64) :where ((CryptoProvider p)) -> i64
  (match (random-bytes p n) ((Ok b) (array-len b)) ((Err _) -1)))

(defun random-kind (p: p n: i64) :where ((CryptoProvider p)) -> str
  (match (random-bytes p n) ((Err e) (. e kind)) ((Ok _) "ok")))

;; ---- the honesty probes: the call that names `what`, with arguments that are valid when the provider has it.
(defun probe (p: p what: keyword) :where ((CryptoProvider p)) -> str
  (let [k (str-bytes "key") s (str-bytes "salt") m (str-bytes "message")]
    (cond (= what :hmac) (kind-of (hmac p :sha-256 k m))
          (= what :pbkdf2) (kind-of (pbkdf2 p :sha-256 k s 2 16))
          (= what :hkdf) (kind-of (hkdf p :sha-256 k s s 16))
          (= what :scrypt) (kind-of (scrypt p k s 16 1 1 16))
          (= what :argon2id) (kind-of (argon2id p k (str-bytes "saltsaltsalt") 1 64 1 16))
          (= what :random) (kind-of (random-bytes p 8))
          (= what :ct-equal) (if (ct= p k k) "ok" "ct=")
          :else (kind-of (digest p what m)))))

(defun honest? (p: p what: keyword) :where ((CryptoProvider p)) -> bool
  (cond (= what :ct-equal) (or (not (supports? p what)) (= (probe p what) "ok"))   ; a bool cannot be an error: only a listed one is probed
        (supports? p what) (= (probe p what) "ok")
        :else (= (probe p what) "unsupported")))

;; A provider that cannot even start a hasher must fail the scenarios, not trap them: its "hasher" refuses everything.
(defstruct DeadHasher (n: i64))
(impl Hasher DeadHasher
  (hasher-update (self data off len) (Err (CryptoError "closed" "no hasher")))
  (hasher-finish (self) (Err (CryptoError "closed" "no hasher")))
  (hasher-close (self) ()))
(defun or-dead (r: (Result (dyn Hasher :send) CryptoError)) -> (dyn Hasher :send)
  (match r ((Ok h) h) ((Err _) (dyn Hasher :send (DeadHasher 0)))))
(defun or-empty (r: (Result (Array i8) CryptoError)) -> (Array i8) (match r ((Ok b) b) ((Err _) (array 0 0i8))))

;; ---- the contract
(defcontract CryptoContract [make]
  (scenario "the provider has a name and lists every required capability"
    (given [p (make)])
    (then (expect = true (> (str-len (provider-name p)) 0))
          (expect = [] (vec (filter (fn (c: keyword) (not (supports? p c))) (required-capabilities))))))
  (scenario "the digest vectors of FIPS 180-4 (SHA-256, SHA-384, SHA-512, the empty, abc, 448-bit, 896-bit and million-a messages)"
    (covers "digest")
    (given [p (make) vs (vec (filter (fn (v: DigestVector) (or (= (. v alg) :sha-256) (= (. v alg) :sha-384) (= (. v alg) :sha-512))) (digest-vectors)))])
    (then (expect = [] (failing vs (fn (v: DigestVector) (str (. v alg) " " (. v name))) (fn (v: DigestVector) (digest-ok? p v))))
          (expect = true (> (count vs) 14))))
  (scenario "the legacy digests (SHA-1, MD5: not for security) agree with RFC 3174 and RFC 1321 when the provider offers them"
    (given [p (make) vs (vec (filter (fn (v: DigestVector) (and (or (= (. v alg) :sha-1) (= (. v alg) :md5)) (supports? p (. v alg)))) (digest-vectors)))])
    (then (expect = [] (failing vs (fn (v: DigestVector) (str (. v alg) " " (. v name))) (fn (v: DigestVector) (digest-ok? p v))))))
  (scenario "a message fed in pieces of 1, 7, 64 and 65 bytes, as ranges of one array, gives the one-shot digest"
    (covers "digest-start" "feed-range")
    (given [p (make) vs (vec (filter (fn (v: DigestVector) (and (or (= (. v alg) :sha-256) (= (. v alg) :sha-384) (= (. v alg) :sha-512)) (not (= (. v name) "million")))) (digest-vectors)))])
    (then (expect = [] (failing vs (fn (v: DigestVector) (str (. v alg) " " (. v name))) (fn (v: DigestVector) (and (stream-ok? p v 1) (stream-ok? p v 7) (stream-ok? p v 64) (stream-ok? p v 65)))))
          (expect = true (> (count vs) 11))))
  (scenario "a million bytes streamed in pieces of 997 give the FIPS 180-4 digest"
    (given [p (make) vs (vec (filter (fn (v: DigestVector) (and (or (= (. v alg) :sha-256) (= (. v alg) :sha-384) (= (. v alg) :sha-512)) (= (. v name) "million"))) (digest-vectors)))])
    (then (expect = [] (failing vs (fn (v: DigestVector) (str (. v alg))) (fn (v: DigestVector) (stream-ok? p v 997))))
          (expect = 3 (count vs))))
  (scenario "a hasher is finished once: a second finish, a feed after it and a feed after close are `closed` errors, close is idempotent"
    (given [p (make) h (or-dead (digest-start p :sha-256))
            _ (feed h (str-bytes "abc"))
            first (hasher-finish h)])
    (upon [again (hasher-finish h) late (feed h (str-bytes "x"))
           h2 (or-dead (digest-start p :sha-256))
           _ (hasher-close h2) _ (hasher-close h2) after-close (hasher-finish h2)])
    (then (expect = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" (result-hex first))
          (expect = "closed" (match again ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = "closed" (match late ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = "closed" (match after-close ((Err e) (. e kind)) ((Ok _) "ok")))))
  (scenario "a range outside the bytes is an invalid-argument error and an empty feed changes nothing"
    (given [p (make) h (or-dead (digest-start p :sha-256)) data (str-bytes "abc")])
    (upon [bad1 (feed-range h data 2 5) bad2 (feed-range h data -1 1) bad3 (feed-range h data 0 -1) empty (feed h (str-bytes ""))
           _ (feed h data) done (hasher-finish h)])
    (then (expect = "invalid-argument" (match bad1 ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = "invalid-argument" (match bad2 ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = "invalid-argument" (match bad3 ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = true (match empty ((Ok _) true) ((Err _) false)))
          (expect = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" (result-hex done))))
  (scenario "HMAC against RFC 4231 test cases 1 to 7 (keys shorter, equal to and longer than the block) for SHA-256, SHA-384 and SHA-512"
    (covers "hmac")
    (given [p (make) vs (mac-vectors)])
    (then (expect = [] (failing vs (fn (v: MacVector) (str (. v alg) " " (. v name))) (fn (v: MacVector) (mac-ok? p v))))
          (expect = true (> (count vs) 20))))
  (scenario "a streamed HMAC in pieces of 5 bytes gives the RFC 4231 value"
    (given [p (make) vs (mac-vectors)])
    (then (expect = [] (failing vs (fn (v: MacVector) (str (. v alg) " " (. v name)))
                        (fn (v: MacVector) (= (. v expected) (first-n-hex (streamed (hmac-start p (. v alg) (bytes-hex (. v key))) (bytes-hex (. v msg)) 5) (. v truncate))))))))
  (scenario "PBKDF2-HMAC-SHA256 against RFC 7914 section 11, RFC 6070's inputs, and 100000 iterations"
    (covers "pbkdf2")
    (given [p (make) vs (pbkdf2-vectors)])
    (then (expect = [] (failing vs (fn (v: Pbkdf2Vector) (. v name)) (fn (v: Pbkdf2Vector) (pbkdf2-ok? p v))))
          (expect = true (> (count vs) 7))))
  (scenario "HKDF-SHA-256 against RFC 5869 appendix A.1 to A.3"
    (covers "hkdf")
    (given [p (make) vs (hkdf-vectors)])
    (then (expect = [] (failing vs (fn (v: HkdfVector) (. v name)) (fn (v: HkdfVector) (hkdf-ok? p v))))
          (expect = 3 (count vs))))
  (scenario "the key derivation functions refuse arguments that have no answer"
    (given [p (make) pw (str-bytes "pw") salt (str-bytes "salt")])
    (then (expect = "invalid-argument" (kind-of (pbkdf2 p :sha-256 pw salt 0 32)))
          (expect = "invalid-argument" (kind-of (pbkdf2 p :sha-256 pw salt 1 0)))
          (expect = "invalid-argument" (kind-of (pbkdf2 p :sha-256 pw salt -1 32)))
          (expect = "invalid-argument" (kind-of (hkdf p :sha-256 pw salt salt (+ (* 255 32) 1))))
          (expect = "invalid-argument" (kind-of (hkdf p :sha-256 pw salt salt 0)))))
  (scenario "random-bytes gives the length asked, and fresh bytes each time"
    (covers "random-bytes")
    (given [p (make)])
    (upon [a (or-empty (random-bytes p 32))
           b (or-empty (random-bytes p 32))
           big (or-empty (random-bytes p 4096))])
    (then (expect = [0 1 16 32 1000] (vec (map (fn (n: i64) (random-len p n)) [0 1 16 32 1000])))
          (expect = false (all-equal? a)) (expect = false (= (hex a) (hex b)))
          (expect = true (> (distinct-bytes big) 200))
          (expect = "invalid-argument" (random-kind p -1))))
  (scenario "ct= is true for equal bytes and false for any difference or length"
    (covers "ct=")
    (given [p (make) a (str-bytes "the quick brown fox") b (str-bytes "the quick brown fox") c (str-bytes "Che quick brown fox")
            d (str-bytes "the quick brown foy") e (str-bytes "the quick brown fo")])
    (then (expect = true (ct= p a b)) (expect = false (ct= p a c)) (expect = false (ct= p a d)) (expect = false (ct= p a e))
          (expect = false (ct= p e a)) (expect = true (ct= p (str-bytes "") (str-bytes ""))) (expect = false (ct= p (str-bytes "") a))))
  (scenario "capabilities are honest: a listed name works, an unlisted one is an `unsupported` error, never an answer"
    (given [p (make)])
    (then (expect = [] (vec (filter (fn (c: keyword) (not (honest? p c))) (all-capabilities))))
          (expect = "unsupported" (probe p :rot13))
          (expect = "unsupported" (match (digest-start p :whirlpool-9) ((Err e) (. e kind)) ((Ok _) "ok")))
          (expect = "unsupported" (kind-of (hmac p :sha-999 (str-bytes "k") (str-bytes "m"))))
          (expect = "unsupported" (kind-of (pbkdf2 p :sha-999 (str-bytes "k") (str-bytes "s") 1 16)))
          (expect = false (supports? p :rot13))
          (expect = [] (vec (filter (fn (c: keyword) (not (some? (first (filter (fn (a: keyword) (= a c)) (into (all-capabilities) (extra-capabilities))))))) (provider-capabilities p)))))))
