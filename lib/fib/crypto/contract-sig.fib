;; fib.crypto.contract-sig: what a provider that lists signature schemes must do (docs/design/crypto.md 9). VERIFY is the baseline (a TLS client only
;; verifies): RSA-PSS and RSASSA-PKCS1-v1_5 with SHA-256/384, ECDSA P-256/SHA-256 and P-384/SHA-384, Ed25519, all over keys imported from X.509
;; SubjectPublicKeyInfo DER, against Project Wycheproof's valid AND invalid signatures (malleability, bad DER, BER lengths, truncated, extended, modified)
;; and RFC 8032 7.1. Then the changes made here to each valid signature, message and key (one byte), and the scheme that does not fit the key. Signing is
;; a capability (`:sign-ed25519 :sign-ecdsa-p256-sha256 :sign-ecdsa-p384-sha384`): RFC 8032's deterministic signatures, then sign-and-verify on generated keys.
;; Policy where Wycheproof says "acceptable": ECDSA's high-S form (malleable, valid in TLS 1.3) is not a case of this contract, and no vector of it is in the data.
(ns fib.crypto.contract-sig
  (:use fib.core fib.seq fib.coll fib.test.core fib.crypto.types fib.crypto.ops fib.crypto.pk fib.crypto.der fib.crypto.encoding
        fib.crypto.contract fib.crypto.contract-aead fib.crypto.vectors-pk))

(defun verify-schemes () -> (Vec keyword)
  [:rsa-pss-sha256 :rsa-pss-sha384 :rsa-pkcs1-sha256 :rsa-pkcs1-sha384 :ecdsa-p256-sha256 :ecdsa-p384-sha384 :ed25519])
(defun sign-caps () -> (Vec keyword) [:sign-ed25519 :sign-ecdsa-p256-sha256 :sign-ecdsa-p384-sha384])

;; The key-agreement capability of a key kind (a P-256 key can both agree and sign).
(defun kex-cap-of (alg: keyword) -> keyword (cond (= alg :p-256) :ecdh-p256 (= alg :p-384) :ecdh-p384 (= alg :x25519) :x25519 :else :none))

(defun key-of (i: i64) -> str (nth (sig-keys) i))

;; "ok", or the kind of the error, of verifying `sig` over `msg` with the key of the SPKI hex (an import that fails is "import" + its kind).
(defun verdict (p: p scheme: keyword spki: str msg: (Array i8) sig: (Array i8)) :where ((CryptoProvider p)) -> str
  (match (import-public-key p (bytes-hex spki))
    ((Err e) (str "import " (. e kind)))
    ((Ok k) (let [r (public-key-verify k scheme msg sig)]
              (do (public-key-close k) (match r ((Ok _) "ok") ((Err e) (. e kind))))))))

(defun vector-verdict (p: p v: SigVector) :where ((CryptoProvider p)) -> str
  (verdict p (. v scheme) (key-of (. v key)) (bytes-hex (. v msg)) (bytes-hex (. v sig))))

;; Valid says "ok"; invalid is `invalid-signature` or `invalid-argument` (a signature that is not even well formed), never "ok".
(defun vector-ok? (p: p v: SigVector) :where ((CryptoProvider p)) -> bool
  (let [d (vector-verdict p v)]
    (if (. v valid) (= d "ok") (or (= d "invalid-signature") (= d "invalid-argument")))))

(defun refused-kind? (d: str) -> bool (or (= d "invalid-signature") (= d "invalid-argument")))

;; One change at a time to a valid signature and its message: (label message signature).
(defun sig-variants (v: SigVector) -> (Vec (Vec str))
  (let [m (. v msg) s (. v sig) n (quot (str-len s) 2)]
    [["first signature byte flipped" m (flip-hex s 0)] ["last signature byte flipped" m (flip-hex s (- n 1))]
     ["signature cut by one byte" m (cut-hex s 1)] ["signature extended by a byte" m (str s "00")] ["empty signature" m ""]
     ["message extended" (str m "00") s] ["message changed" (if (= m "") "00" (flip-hex m 0)) s]]))

(defun variant-failures (p: p v: SigVector) :where ((CryptoProvider p)) -> (Vec str)
  (vec (map (fn (x: (Vec str)) (str (. v scheme) " " (. v name) ": " (nth x 0)))
            (filter (fn (x: (Vec str)) (not (refused-kind? (verdict p (. v scheme) (key-of (. v key)) (bytes-hex (nth x 1)) (bytes-hex (nth x 2))))))
                    (sig-variants v)))))

;; A valid signature under any OTHER scheme (a key of another type, another hash, PSS for PKCS#1) does not verify.
(defun cross-scheme-failures (p: p v: SigVector) :where ((CryptoProvider p)) -> (Vec str)
  (vec (map (fn (s: keyword) (str (. v scheme) " " (. v name) " under " s))
            (filter (fn (s: keyword) (not (refused-kind? (verdict p s (key-of (. v key)) (bytes-hex (. v msg)) (bytes-hex (. v sig))))))
                    (filter (fn (s: keyword) (and (supports? p s) (not (= s (. v scheme))))) (verify-schemes))))))

;; Public keys that are not a SubjectPublicKeyInfo of a key: every one is an error from the import.
(defun bad-spkis (spki: str) -> (Vec (Pair str str))
  [(Pair "empty" "") (Pair "cut by one byte" (cut-hex spki 1)) (Pair "a byte appended" (str spki "00")) (Pair "first byte flipped" (flip-hex spki 0))
   (Pair "half" (cut-hex spki (quot (str-len spki) 4))) (Pair "zeros" "00000000") (Pair "not DER" "ffffffffffffffffffffffff")])

(defun spki-failures (p: p i: i64) :where ((CryptoProvider p)) -> (Vec str)
  (vec (map (fn (x: (Pair str str)) (str "key " i ": " (. x fst)))
            (filter (fn (x: (Pair str str)) (match (import-public-key p (bytes-hex (. x snd))) ((Ok k) (do (public-key-close k) true)) ((Err _) false)))
                    (bad-spkis (key-of i))))))

(defun listed-keys (p: p) :where ((CryptoProvider p)) -> (Vec i64)
  (vec (filter (fn (i: i64) (some? (first (filter (fn (v: SigVector) (and (= (. v key) i) (supports? p (. v scheme)))) (sig-vectors))))) (range (count (sig-keys))))))

;; The expected `public-key-kind` of the key a scheme verifies with.
(defun scheme-key-kind (s: keyword) -> keyword
  (cond (= s :ed25519) :ed25519 (= s :ecdsa-p256-sha256) :p-256 (= s :ecdsa-p384-sha384) :p-384 :else :rsa))

(defun kind-failures (p: p vs: (Vec SigVector)) :where ((CryptoProvider p)) -> (Vec str)
  (vec (map (fn (v: SigVector) (str (. v scheme) " " (. v name)))
            (filter (fn (v: SigVector) (match (import-public-key p (bytes-hex (key-of (. v key))))
                                         ((Err _) true)
                                         ((Ok k) (let [r (not (= (public-key-kind k) (scheme-key-kind (. v scheme))))] (do (public-key-close k) r)))))
                    vs))))

(defun sign-cap (s: keyword) -> keyword
  (cond (= s :ed25519) :sign-ed25519 (= s :ecdsa-p256-sha256) :sign-ecdsa-p256-sha256 (= s :ecdsa-p384-sha384) :sign-ecdsa-p384-sha384 :else :none))

(defun sign-kat-ok? (p: p v: SignVector) :where ((CryptoProvider p)) -> bool
  (match (import-private-key p :ed25519 (bytes-hex (. v private)))
    ((Err _) false)
    ((Ok k) (let [r (result-hex (private-key-sign k (. v scheme) (bytes-hex (. v msg))))] (do (private-key-close k) (= r (. v sig)))))))

;; Generated key of `kind`, signature under `scheme`, verified through the SPKI of its raw public key; then the message changed, and a scheme that does not fit.
(defun sign-roundtrip-failures (p: p kind: keyword scheme: keyword other: keyword) :where ((CryptoProvider p)) -> (Vec str)
  (match (generate-key p kind)
    ((Err e) (vec [(str "generate " (. e kind))]))
    ((Ok k)
     (let [msg (str-bytes "a message to sign") sig (private-key-sign k scheme msg) wrong (private-key-sign k other msg)
           spki (match (private-key-public k) ((Err e) (Err e)) ((Ok raw) (wrap-public kind raw)))
           r (match spki
               ((Err e) ["public key: " (. e kind)])
               ((Ok d) (match sig
                         ((Err e) [(str "sign " (. e kind) ": " (. e message))]) 
                         ((Ok sg) (vec (filter (fn (s: str) (not (= s "")))
                                  [(if (= "ok" (verdict p scheme (hex d) msg sg)) "" "the signature does not verify")
                                   (if (refused-kind? (verdict p scheme (hex d) (str-bytes "another message") sg)) "" "a changed message verifies")
                                   (if (refused-kind? (verdict p scheme (hex d) msg (flip-at sg 0))) "" "a changed signature verifies")
                                   (if (> (array-len sg) 60) "" "short signature")]))))))]
       (do (private-key-close k)
           (vec (concat r (match wrong ((Ok _) ["a scheme that does not fit the key signs"]) ((Err _) [])))))))))

(defcontract CryptoSignatureContract [make]
  (scenario "verify gives the verdict of every published vector (Wycheproof RSA-PSS, PKCS#1, ECDSA, Ed25519; RFC 8032): valid is Ok, invalid is an error"
    (covers "public-key-verify" "import-public-key")
    (given [p (make) vs (vec (filter (fn (v: SigVector) (supports? p (. v scheme))) (sig-vectors)))])
    (then (expect = [] (failing vs (fn (v: SigVector) (str (. v scheme) " " (. v name))) (fn (v: SigVector) (vector-ok? p v))))))
  (scenario "a scheme the provider does not list is `unsupported`, never a verdict"
    (given [p (make) vs (vec (filter (fn (v: SigVector) (not (supports? p (. v scheme)))) (sig-vectors)))])
    (then (expect = [] (failing vs (fn (v: SigVector) (str (. v scheme) " " (. v name)))
                         (fn (v: SigVector) (let [d (vector-verdict p v)] (or (= d "unsupported") (= d "import unsupported"))))))))
  (scenario "each valid signature changed in one place (a byte, cut, extended, emptied, the message) does not verify"
    (given [p (make) vs (vec (filter (fn (v: SigVector) (and (. v valid) (supports? p (. v scheme)))) (sig-vectors)))])
    (then (expect = [] (vec (mapcat (fn (v: SigVector) (variant-failures p v)) vs)))))
  (scenario "a valid signature does not verify under any other scheme the provider lists"
    (given [p (make) vs (vec (filter (fn (v: SigVector) (and (. v valid) (supports? p (. v scheme)))) (sig-vectors)))])
    (then (expect = [] (vec (mapcat (fn (v: SigVector) (cross-scheme-failures p v)) vs)))))
  (scenario "a SubjectPublicKeyInfo that is cut, extended, emptied or garbled is an import error, and an imported key knows its kind"
    (given [p (make) vs (vec (filter (fn (v: SigVector) (and (. v valid) (supports? p (. v scheme)))) (sig-vectors)))])
    (then (expect = [] (vec (mapcat (fn (i: i64) (spki-failures p i)) (listed-keys p))))
          (expect = [] (kind-failures p vs))))
  (scenario "signing reproduces RFC 8032's Ed25519 signatures"
    (given [p (make) vs (if (supports? p :sign-ed25519) (sign-vectors) [])])
    (then (expect = [] (failing vs (fn (v: SignVector) (. v name)) (fn (v: SignVector) (sign-kat-ok? p v))))))
  (scenario "signing with a generated key verifies, a changed message or signature does not, a scheme that does not fit the key is refused"
    (given [p (make)])
    (then (expect = [] (if (supports? p :sign-ed25519) (sign-roundtrip-failures p :ed25519 :ed25519 :ecdsa-p256-sha256) []))
          (expect = [] (if (supports? p :sign-ecdsa-p256-sha256) (sign-roundtrip-failures p :p-256 :ecdsa-p256-sha256 :ed25519) []))
          (expect = [] (if (supports? p :sign-ecdsa-p384-sha384) (sign-roundtrip-failures p :p-384 :ecdsa-p384-sha384 :ecdsa-p256-sha256) []))))
  (scenario "signing capabilities are honest: a key kind that cannot sign is `unsupported`"
    (given [p (make)])
    (then (expect = [] (vec (filter (fn (x: (Pair keyword keyword))
                                      (match (generate-key p (. x fst))
                                        ((Ok k) (do (private-key-close k) (not (or (supports? p (. x snd)) (supports? p (kex-cap-of (. x fst)))))))
                                        ((Err e) (or (supports? p (. x snd)) (not (= (. e kind) "unsupported"))))))
                                    [(Pair :ed25519 :sign-ed25519)]))))))
