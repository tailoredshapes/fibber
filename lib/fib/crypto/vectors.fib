;; fib.crypto.vectors: the published test vectors of the fib.crypto contract, as data. GENERATED by scripts/gen-crypto-vectors.sh (do not edit):
;; each published value is written from its document and the script stops when hashlib, hmac or openssl disagree. Bytes are hex; a message
;; "rep:61:1000000" is the byte 0x61 repeated 1000000 times (FIPS 180-4's million-'a' message).
(ns fib.crypto.vectors (:use fib.core fib.seq fib.coll))
(defstruct DigestVector (alg: keyword name: str msg: str expected: str))
(defstruct MacVector (alg: keyword name: str key: str msg: str truncate: i64 expected: str))
(defstruct Pbkdf2Vector (name: str password: str salt: str iterations: i64 length: i64 expected: str))
(defstruct HkdfVector (name: str ikm: str salt: str info: str length: i64 expected: str))

