;; fib.fmt: `(format-f64 x digits)` is x as fixed-point decimal text with `digits` places, as C's "%.*f" and, for every
;; value the n-body shootout prints, as Java's String.format("%.9f"). Stand-in for the `%f` directive of `format`
;; (stdlib §4.14), which has not landed; written over libc's snprintf (variadic, with one double), which rounds the exact binary value, so the
;; interpreter and the compiled program agree. Locale independent (the C locale is the default of a program that
;; never calls setlocale). The unsafe is here, in the library, not in the programs that call it. Difference from
;; Java: Java rounds the shortest decimal text of the double half up, C rounds the exact value, so they can differ
;; for a value whose shortest text ends in a 5 exactly at the last place (never seen in the benchmark: the three
;; outputs are compared byte for byte).
(ns fib.fmt (:use fib.core) (:require [fib.fmt.libc :as libc]))

;; fmt as a NUL-terminated copy, for the caller to free.
(defun c-string :private (s: str) -> ptr
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc (+ n 1))))
        (do (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
            (store-i8 (ptr+ p n) 0i8)
            p)))))

(defun format-f64 (x: f64 digits: i64) -> str
  (let ((cap (+ 330 digits)))
    (unsafe
      (let ((f (c-string (str "%." digits "f")))
            (buf (alloc cap)))
        (let ((n (sext i64 (libc/snprintf buf cap f x))))
          (let ((out (cell (array n 0i8))))
            (do (dotimes (i n) (array-set! &out i (load-i8 (ptr+ buf i))))
                (free buf)
                (free f)
                (str-from-bytes @out))))))))
