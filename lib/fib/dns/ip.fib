;; IP address literals as bytes and as text (RFC 4291, RFC 5952): strict parsing (no leading zeros in a dotted quad, no zone id, at most one "::", at most four hex digits a
;; group, an embedded dotted quad only as the last 32 bits) and the canonical text (lower case, the longest run of two or more zero groups as "::", the first run on a tie).
(ns fib.dns.ip (:use fib.core fib.seq fib.coll))
(defun byte-at :private (text: str i: i64) -> i64 (zext i64 (str-byte-at text i)))
(defun hex-value (b: i64) -> i64
  (cond (and (>= b 48) (<= b 57)) (- b 48) (and (>= b 97) (<= b 102)) (- b 87) (and (>= b 65) (<= b 70)) (- b 55) :else -1))
(defun split-on (text: str sep: i64) -> (Vec str)
  (loop [i 0 from 0 out: (Vec str) []]
    (cond (= i (str-len text)) (conj out (str-slice text from i))
          (= (byte-at text i) sep) (recur (+ i 1) (+ i 1) (conj out (str-slice text from i)))
          :else (recur (+ i 1) from out))))
;; the value of a run of digits (base 10 or 16) of 1..max-digits digits, or -1
(defun number-of (part: str base: i64 max-digits: i64) -> i64
  (if (or (= (str-len part) 0) (> (str-len part) max-digits)) -1
    (loop [i 0 n 0]
      (if (= i (str-len part)) n
        (let [d (hex-value (byte-at part i))]
          (if (or (< d 0) (>= d base)) -1 (recur (+ i 1) (+ (* n base) d))))))))
(defun quad-part :private (part: str) -> i64
  (if (and (> (str-len part) 1) (= (byte-at part 0) 48)) -1 (let [n (number-of part 10 3)] (if (> n 255) -1 n))))
(defun parse-ipv4 (text: str) -> (Option (Array i8))
  (let [parts (split-on text 46)]
    (if (!= (count parts) 4) nil
      (let [vals (vec (map quad-part parts))]
        (if (any-negative? vals) nil
          (some (let [out (cell (array 4 0i8))] (do (dotimes (i 4) (array-set! &out i (trunc i8 (nth vals i)))) @out))))))))
(defun any-negative? :private (xs: (Vec i64)) -> bool
  (loop [i 0] (cond (= i (count xs)) false (< (nth xs i) 0) true :else (recur (+ i 1)))))
;; groups of 16 bits of a colon-separated run; a dotted quad is allowed as the last element when last-quad? says so. nil on any error.
(defun groups-of :private (text: str last-quad?: bool) -> (Option (Vec i64))
  (if (= text "") (some [])
    (let [parts (split-on text 58) n (count parts)]
      (loop [i 0 out: (Vec i64) []]
        (if (= i n) (some out)
          (let [p (nth parts i)]
            (if (some? (str-find p "." 0))
              (if (and last-quad? (= i (- n 1)))
                (match (parse-ipv4 p) (nil nil)
                  ((some q) (recur (+ i 1) (conj (conj out (+ (* 256 (zext i64 (array-get q 0))) (zext i64 (array-get q 1))))
                                                 (+ (* 256 (zext i64 (array-get q 2))) (zext i64 (array-get q 3)))))))
                nil)
              (let [v (number-of p 16 4)] (if (< v 0) nil (recur (+ i 1) (conj out v)))))))))))
(defun to-bytes :private (gs: (Vec i64)) -> (Array i8)
  (let [out (cell (array 16 0i8))]
    (do (dotimes (i 8) (do (array-set! &out (* 2 i) (trunc i8 (shr (nth gs i) 8))) (array-set! &out (+ (* 2 i) 1) (trunc i8 (bit-and (nth gs i) 255))))) @out)))
(defun zeros :private (n: i64) -> (Vec i64) (loop [i 0 out: (Vec i64) []] (if (= i n) out (recur (+ i 1) (conj out 0)))))
(defun join-groups :private (hs: (Vec i64) ts: (Vec i64)) -> (Option (Array i8))
  (if (> (+ (count hs) (count ts)) 7) nil (some (to-bytes (into (into hs (zeros (- 8 (+ (count hs) (count ts))))) ts)))))
(defun compressed :private (head: str tail: str) -> (Option (Array i8))
  (if (some? (str-find tail "::" 0)) nil
    (match (groups-of head false) (nil nil)
      ((some hs) (match (groups-of tail true) (nil nil) ((some ts) (join-groups hs ts)))))))
(defun parse-ipv6 (text: str) -> (Option (Array i8))
  (match (str-find text "::" 0)
    (nil (match (groups-of text true) (nil nil) ((some gs) (if (= (count gs) 8) (some (to-bytes gs)) nil))))
    ((some k) (compressed (str-slice text 0 k) (str-slice text (+ k 2) (str-len text))))))
(defun literal (host: str) -> (Option (Array i8))
  (if (some? (str-find host ":" 0)) (parse-ipv6 host) (parse-ipv4 host)))
(defun format-ipv4 (b: (Array i8) off: i64) -> str
  (str (zext i64 (array-get b off)) "." (zext i64 (array-get b (+ off 1))) "." (zext i64 (array-get b (+ off 2))) "." (zext i64 (array-get b (+ off 3)))))
(defun hex16 :private (v: i64) -> str
  (let [d "0123456789abcdef" a (shr v 12) b (bit-and (shr v 8) 15) c (bit-and (shr v 4) 15) e (bit-and v 15)]
    (cond (> a 0) (str (str-slice d a (+ a 1)) (str-slice d b (+ b 1)) (str-slice d c (+ c 1)) (str-slice d e (+ e 1)))
          (> b 0) (str (str-slice d b (+ b 1)) (str-slice d c (+ c 1)) (str-slice d e (+ e 1)))
          (> c 0) (str (str-slice d c (+ c 1)) (str-slice d e (+ e 1)))
          :else (str-slice d e (+ e 1)))))
(defun group :private (b: (Array i8) i: i64) -> i64 (+ (* 256 (zext i64 (array-get b (* 2 i)))) (zext i64 (array-get b (+ (* 2 i) 1)))))
(defun zero-run :private (b: (Array i8)) -> (Pair i64 i64)
  (loop [i 0 best-at -1 best-len 0 run-at 0 run-len 0]
    (if (= i 8) (if (> run-len best-len) (Pair run-at run-len) (Pair best-at best-len))
      (if (= (group b i) 0)
        (let [at (if (= run-len 0) i run-at) len (+ run-len 1)] (recur (+ i 1) best-at best-len at len))
        (if (> run-len best-len) (recur (+ i 1) run-at run-len 0 0) (recur (+ i 1) best-at best-len 0 0))))))
(defun format-ipv6 (b: (Array i8)) -> str
  (let [z (zero-run b) at (. z fst) len (. z snd) skip (if (>= len 2) len 0)]
    (loop [i 0 out ""]
      (cond (= i 8) out
            (and (> skip 0) (= i at)) (recur (+ i skip) (str out "::"))
            :else (recur (+ i 1) (str out (if (or (= i 0) (and (> skip 0) (= i (+ at skip)))) "" ":") (hex16 (group b i))))))))
