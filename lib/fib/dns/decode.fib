;; Decoding a DNS message from untrusted bytes. Every read is bounds-checked, every count is checked against the bytes that remain before anything is allocated, a compression
;; pointer must point strictly before the start of the name being read and before every earlier pointer's target (so a name is read in a bounded number of steps and a loop is
;; an error), a name is at most 255 bytes and 126 jumps, the message ends where its last record ends (trailing bytes are an error). The result of a failure is text, never a trap.
(ns fib.dns.decode (:use fib.core fib.seq fib.coll fib.dns.types) (:require [fib.dns.ip :as ip]))
(def max-message: i64 65535)
(def max-jumps: i64 126)
(defun u8 :private (b: (Array i8) i: i64) -> i64 (zext i64 (array-get b i)))
(defun u16 :private (b: (Array i8) i: i64) -> i64 (+ (* 256 (u8 b i)) (u8 b (+ i 1))))
(defun u32 :private (b: (Array i8) i: i64) -> i64 (+ (* 65536 (u16 b i)) (u16 b (+ i 2))))
(defun label-ok? :private (b: (Array i8) from: i64 to: i64) -> bool
  (loop [i from] (if (= i to) true (let [c (u8 b i)] (if (and (>= c 33) (<= c 126) (!= c 46)) (recur (+ i 1)) false)))))
(defun join-name :private (out: str label: str) -> str (if (= out "") label (str out "." label)))
(defstruct Walk :private (p: i64 resume: i64 bound: i64 jumps: i64 wire: i64 name: str))
(defun step :private (b: (Array i8) w: Walk) -> (Result (Option Walk) str)
  (let [p (. w p)]
    (if (>= p (array-len b)) (Err "name runs past the end of the message")
      (let [len (u8 b p) kind (bit-and len 192)]
        (cond (= len 0) (Ok nil)
              (= kind 192) (pointer b w)
              (!= kind 0) (Err "reserved label type")
              (> (+ p 1 len) (array-len b)) (Err "label runs past the end of the message")
              (not (label-ok? b (+ p 1) (+ p 1 len))) (Err "label has a byte outside printable ASCII or a dot")
              (> (+ (. w wire) len 1) 254) (Err "name longer than 255 bytes")
              :else (Ok (some (with w (p (+ p 1 len)) (wire (+ (. w wire) len 1))
                                     (name (join-name (. w name) (str-from-bytes (array-copy b (+ p 1) (+ p 1 len)))))))))))))
(defun pointer :private (b: (Array i8) w: Walk) -> (Result (Option Walk) str)
  (let [p (. w p)]
    (if (>= (+ p 1) (array-len b)) (Err "compression pointer runs past the end of the message")
      (let [target (+ (* 256 (bit-and (u8 b p) 63)) (u8 b (+ p 1)))]
        (cond (>= (. w jumps) max-jumps) (Err "too many compression jumps")
              (>= target (. w bound)) (Err "compression pointer does not point backwards")
              :else (Ok (some (with w (p target) (bound target) (jumps (+ (. w jumps) 1)) (resume (if (< (. w resume) 0) (+ p 2) (. w resume)))))))))))
;; The name at pos and the offset of the byte after it in the message (after the first pointer when there is one).
(defun read-name (b: (Array i8) pos: i64) -> (Result (Pair str i64) str)
  (loop [w (Walk pos -1 pos 0 0 "")]
    (match (step b w)
      ((Err e) (Err e))
      ((Ok nil) (Ok (Pair (. w name) (if (< (. w resume) 0) (+ (. w p) 1) (. w resume)))))
      ((Ok (some next)) (recur next)))))
(defun ttl-of :private (raw: i64) -> i64 (if (>= raw 2147483648) 0 raw))
(defun raw-data :private (b: (Array i8) from: i64 to: i64) -> Rdata
  (RdRaw (vec (map (fn (i: i64) (u8 b i)) (range from to)))))
(defun soa-data :private (b: (Array i8) from: i64 to: i64) -> (Result Rdata str)
  (match (read-name b from)
    ((Err e) (Err e))
    ((Ok m) (match (read-name b (. m snd))
      ((Err e) (Err e))
      ((Ok r) (if (!= (+ (. r snd) 20) to) (Err "SOA data has the wrong length") (Ok (RdSoa (u32 b (+ (. r snd) 16))))))))))
(defun rdata :private (b: (Array i8) rtype: i64 from: i64 to: i64) -> (Result Rdata str)
  (cond (= rtype type-a) (if (= (- to from) 4) (Ok (RdA (ip/format-ipv4 b from))) (Err "A data is not 4 bytes"))
        (= rtype type-aaaa) (if (= (- to from) 16) (Ok (RdAAAA (ip/format-ipv6 (array-copy b from to)))) (Err "AAAA data is not 16 bytes"))
        (= rtype type-cname) (match (read-name b from)
                               ((Err e) (Err e))
                               ((Ok r) (if (= (. r snd) to) (Ok (RdCname (. r fst))) (Err "CNAME data has the wrong length"))))
        (= rtype type-soa) (soa-data b from to)
        :else (Ok (raw-data b from to))))
(defun read-rr :private (b: (Array i8) pos: i64) -> (Result (Pair Rr i64) str)
  (match (read-name b pos)
    ((Err e) (Err e))
    ((Ok n) (let [at (. n snd)]
      (if (> (+ at 10) (array-len b)) (Err "record header runs past the end of the message")
        (let [rtype (u16 b at) rclass (u16 b (+ at 2)) ttl (ttl-of (u32 b (+ at 4))) len (u16 b (+ at 8)) from (+ at 10)]
          (if (> (+ from len) (array-len b)) (Err "record data runs past the end of the message")
            (match (rdata b rtype from (+ from len))
              ((Err e) (Err e))
              ((Ok d) (Ok (Pair (Rr (. n fst) rtype rclass ttl d) (+ from len))))))))))))
(defun read-question :private (b: (Array i8) pos: i64) -> (Result (Pair Question i64) str)
  (match (read-name b pos)
    ((Err e) (Err e))
    ((Ok n) (if (> (+ (. n snd) 4) (array-len b)) (Err "question runs past the end of the message")
              (Ok (Pair (Question (. n fst) (u16 b (. n snd)) (u16 b (+ (. n snd) 2))) (+ (. n snd) 4)))))))
(defun read-many :private (b: (Array i8) pos: i64 n: i64 f: (fn ((Array i8) i64) (Result (Pair a i64) str))) -> (Result (Pair (Vec a) i64) str)
  (loop [i 0 at pos out: (Vec a) []]
    (if (= i n) (Ok (Pair out at))
      (match (f b at) ((Err e) (Err e)) ((Ok r) (recur (+ i 1) (. r snd) (conj out (. r fst))))))))
(defun section :private (b: (Array i8) pos: i64 n: i64) -> (Result (Pair (Vec Rr) i64) str) (read-many b pos n read-rr))
(defun decode (b: (Array i8)) -> (Result Message str)
  (let [size (array-len b)]
    (cond (< size 12) (Err "message shorter than a header")
          (> size max-message) (Err "message longer than 65535 bytes")
          :else (let [qd (u16 b 4) an (u16 b 6) ns (u16 b 8) ar (u16 b 10)]
            (if (> (+ (* qd 5) (* (+ an ns ar) 11)) (- size 12)) (Err "section counts exceed the message")
              (decode-sections b qd an ns ar))))))
(defun decode-sections :private (b: (Array i8) qd: i64 an: i64 ns: i64 ar: i64) -> (Result Message str)
  (match (read-many b 12 qd read-question)
    ((Err e) (Err e))
    ((Ok q) (match (section b (. q snd) an)
      ((Err e) (Err e))
      ((Ok a) (match (section b (. a snd) ns)
        ((Err e) (Err e))
        ((Ok n) (match (section b (. n snd) ar)
          ((Err e) (Err e))
          ((Ok x) (if (!= (. x snd) (array-len b)) (Err "trailing bytes after the last record")
                    (Ok (Message (u16 b 0) (u16 b 2) (. q fst) (. a fst) (. n fst) (. x fst)))))))))))))
