;; DNS values (RFC 1035, 3596, 6891). A name is text without the trailing dot (the root is ""); labels are 1..63 printable ASCII bytes other than ".", the name at most 255 bytes
;; on the wire. A record's data is decoded for the types a resolver reads (A, AAAA, CNAME, and the SOA minimum for negative caching); any other type keeps its bytes.
(ns fib.dns.types (:use fib.core fib.coll))
(def type-a: i64 1)
(def type-ns: i64 2)
(def type-cname: i64 5)
(def type-soa: i64 6)
(def type-aaaa: i64 28)
(def type-opt: i64 41)
(def class-in: i64 1)
(def rcode-ok: i64 0)
(def rcode-formerr: i64 1)
(def rcode-servfail: i64 2)
(def rcode-nxdomain: i64 3)
(defstruct Question (name: str qtype: i64 qclass: i64))
(defenum Rdata (RdA addr: str) (RdAAAA addr: str) (RdCname name: str) (RdSoa minimum: i64) (RdRaw data: (Vec i64)))
(defstruct Rr (name: str rtype: i64 rclass: i64 ttl: i64 data: Rdata))
(defstruct Message (id: i64 flags: i64 questions: (Vec Question) answers: (Vec Rr) authority: (Vec Rr) additional: (Vec Rr)))
(derive Eq Question)
(derive Eq Rdata)
(derive Eq Rr)
(derive Eq Message)
(derive Debug Question)
(derive Debug Rdata)
(derive Debug Rr)
(derive Debug Message)
(defun response? (m: Message) -> bool (!= (bit-and (. m flags) 32768) 0))
(defun truncated? (m: Message) -> bool (!= (bit-and (. m flags) 512) 0))
(defun rcode (m: Message) -> i64 (bit-and (. m flags) 15))
(defun opcode (m: Message) -> i64 (bit-and (shr (. m flags) 11) 15))
(defun make-flags (response: bool rd: bool truncated: bool rcode: i64) -> i64
  (+ (if response 32768 0) (if truncated 512 0) (if rd 256 0) (if response 128 0) rcode))
