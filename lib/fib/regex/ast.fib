;; fib.regex.ast: the syntax tree of a pattern (stdlib §4.9). `Set` holds a `fib.regex.charset` set;
;; `Rep` has `max` -1 for no upper bound; `Group` numbers from 1 in the order of the opening
;; parentheses; `Assert` is a zero-width test: 1 `^`, 2 `$`, 3 `\b`, 4 `\B`, 5 `\A`, 6 `\z`, 7 `\Z`.
(ns fib.regex.ast)

(defenum Node
  (NEmpty)
  (NSet cs: (Vec i64))
  (NCat items: (Vec Node))
  (NAlt items: (Vec Node))
  (NRep body: Node min: i64 max: i64 greedy: bool)
  (NGroup idx: i64 body: Node)
  (NAssert kind: i64))

;; a parsed pattern: the tree and the number of capturing groups
(defstruct Ast (node: Node groups: i64))
