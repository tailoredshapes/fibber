;; fib.regex.api: `Regex`, `Match` and the functions of stdlib §4.9 over the matchers (the Pike VM of
;; fib.regex.pike for the groups and for every pattern, the lazy DFA of fib.regex.dfa for finding where
;; a match lies in a pattern without assertions). Offsets are byte offsets into the UTF-8 `str`, always
;; at a character boundary, as `str-find` reports them. The match found is Java's: the leftmost, and
;; among the matches that start there the one a backtracking matcher would find first (greedy and lazy
;; quantifiers, the first alternative that works). Decided here, where the page is silent:
;;  - a `Regex` is immutable: the programs, and for a pattern small enough the whole DFA as a table (`Tab`), so it is
;;    `Send`, shared by tasks, and a `#"..."` literal is made by the compiler as static data (expand.regex). The lazy
;;    DFA of a pattern too big for a table is the state of a `Matcher`, made for one search (or one `re-seq`, `re-count`,
;;    `replace-all`, `replace-first` call) and dropped with it; `matcher-of` says `nil` when the `Regex` needs none.
;;  - `Match` has `start` and `end` (byte offsets of the whole match), `whole`, `groups` (group 1 on, `nil`
;;    for a group that took no part) and `spans` (the offsets of every group, 2g and 2g+1, -1 for none).
;;  - `re-seq` is eager: a `(Vec Match)`. After an empty match the search goes on one character later,
;;    as Java's `Matcher.find` does; unlike Java it never steps into the middle of a character, so an empty
;;    match is found once between the two halves of a supplementary character, not twice.
;;  - `re-groups` is the vector of Clojure's: the whole match, then the groups.
;;  - `replace-all` and `replace-first` take Java's replacement text: `$n` is group n (more digits are
;;    taken while the group exists), `\x` is `x`; anything else after `$` or a lone `\` traps.
;;  - a string longer than 2^31 - 1 bytes traps in the searches that return spans packed in one number.
;;  - package LIB-2: the inline flags `(?i) (?s) (?x) (?m)` are the parser's (fib.regex.parse); `(re-pattern-flags s "ims")` is `(re-pattern (str "(?ims)" s))`.
;;    A pattern with a BACKREFERENCE (`\1`) is run by the backtracking matcher of fib.regex.bt (`backtracking?` says so), whose time is not linear:
;;    it has a budget of steps per search, and a search that spends it is an error value in `try-re-find` and `try-re-matches`
;;    (`(Err "regex backtracking budget exceeded ..")`) and a trap in `re-find`, `re-matches`, `re-seq` and the replacements. The Pike VM, linear in
;;    the text for every pattern, stays the matcher of every pattern without a backreference.
(ns fib.regex.api
  (:use fib.core fib.seq fib.coll fib.string.utf8 fib.string.pattern
        fib.regex.ast fib.regex.parse fib.regex.prog fib.regex.pike fib.regex.dfa fib.regex.bt))

(defstruct Regex
  (pattern: str groups: i64 fwd: Prog rev: Prog ftab: Tab rtab: Tab use-dfa: bool fixed: i64 bt: bool))

;; the mutable state of searches over a `Regex` whose DFA did not fit a table: the lazy DFAs, forward and reverse
(defstruct Matcher (f: (Option Dfa) r: (Option Dfa)))

(defstruct Match (start: i64 end: i64 whole: str groups: (Vec (Option str)) spans: (Vec i64)))

(defun has-backref? (n: Node) -> bool
  (match n
    ((NBackref _ _) true)
    ((NCat items) (reduce (fn (b: bool x: Node) (or b (has-backref? x))) false items))
    ((NAlt items) (reduce (fn (b: bool x: Node) (or b (has-backref? x))) false items))
    ((NRep body _ _ _) (has-backref? body))
    ((NGroup _ body) (has-backref? body))
    (_ false)))

(defun try-re-pattern (s: str) -> (Result Regex str)
  (try-let [a (parse-regex s)]
    (if (has-backref? (. a node))
        (let [f (compile-forward a)]
          (if (. f too-big)
              (Err "pattern is too large")
              (Ok (Regex s (. a groups) f f (no-tab) (no-tab) false -1 true))))
        (let [f (compile-forward a)
              r (compile-reverse a)]
          (if (or (. f too-big) (. r too-big))
              (Err "pattern is too large")
              (let [dfa? (not (. f asserts))]
                (Ok (Regex s (. a groups) f r (if dfa? (freeze-dfa f true false) (no-tab)) (if dfa? (freeze-dfa r false true) (no-tab))
                           dfa? (fixed-len (. a node)) false))))))))

;; the pattern with the flags (letters of "imsx") switched on from its start: `(re-pattern-flags "a.c" "is")`
(defun try-re-pattern-flags (s: str flags: str) -> (Result Regex str)
  (try-re-pattern (str "(?" flags ")" s)))

(defun re-pattern-flags (s: str flags: str) -> Regex
  (match (try-re-pattern-flags s flags)
    ((Ok r) r)
    ((Err e) (trap (str "PatternSyntaxException: " e " in " s)))))

;; whether the pattern has a backreference, so that its searches are the backtracking matcher's (budgeted, not linear)
(defun backtracking? (rx: Regex) -> bool (. rx bt))

(defun budget-message :private () -> str
  (str "regex backtracking budget exceeded (" (default-budget) " steps): the pattern has a backreference and this text makes it exponential"))

;; the slots of a search by the backtracking matcher; a spent budget is a trap here (try-re-find and try-re-matches return it as a value)
(defun bt-caps :private (rx: Regex s: str from: i64 anchored: bool endreq: bool) -> (Array i64)
  (let [r (bt-run (. rx fwd) s from anchored endreq (default-budget))]
    (if (exceeded? r) (trap (budget-message)) r)))

(defun re-pattern (s: str) -> Regex
  (match (try-re-pattern s)
    ((Ok r) r)
    ((Err e) (trap (str "PatternSyntaxException: " e " in " s)))))

(defun pattern-of (rx: Regex) -> str (. rx pattern))

;; whether the DFAs of rx are tables (searches need no state); the most states the lazy DFA of the forward search will hold, and
;; how many it holds after a search of s with a matcher of its own; a search that needs more is done by the Pike VM (the same
;; answer, slower)
(defun dfa-tables? (rx: Regex) -> bool (and (. rx use-dfa) (. (. rx ftab) ok) (. (. rx rtab) ok)))
(defun dfa-cache-cap (rx: Regex) -> i64 (cap-for (. rx fwd)))
(defun dfa-cache-states (rx: Regex s: str) -> i64
  (let [m (matcher-of rx s)]
    (do (find-packed rx m s 0)
        (match m
          ((some mm) (match (. mm f) ((some d) @(. d count)) (nil 0)))
          (nil 0)))))

;; A lazy DFA starts cold, so for a text shorter than this the Pike VM does the search instead (the same answer): a DFA built
;; for forty characters costs about 20 microseconds against 0.2 for the Pike VM (measured, docs/shootout/regex-literals.md)
(def lazy-min: i64 256)

;; the state a search of s over rx needs: nil when its DFAs are tables, when it has none, or when s is too short for a lazy DFA
(defun matcher-of (rx: Regex s: str) -> (Option Matcher)
  (if (and (. rx use-dfa) (not (dfa-tables? rx)) (>= (str-len s) lazy-min))
      (some (Matcher (if (. (. rx ftab) ok) nil (some (new-dfa (. rx fwd) true false)))
                     (if (. (. rx rtab) ok) nil (some (new-dfa (. rx rev) false true)))))
      nil))

;; the end of the leftmost match at or after from by the forward DFA (-1 none, -2 it needs the Pike VM); the start of the match that
;; ends at e, by the reverse one
;; whether a search with state m uses the DFAs: they are tables, or there is a lazy one
(defun dfa-on? :private (rx: Regex m: (Option Matcher)) -> bool
  (and (. rx use-dfa) (or (dfa-tables? rx) (some? m))))

(defun fwd-end :private (rx: Regex m: (Option Matcher) s: str from: i64) -> i64
  (if (. (. rx ftab) ok)
      (tab-forward (. rx ftab) (. rx fwd) s from)
      (dfa-forward (unwrap (. (unwrap m) f)) s from)))

(defun rev-start :private (rx: Regex m: (Option Matcher) s: str e: i64 from: i64) -> i64
  (if (. (. rx rtab) ok)
      (tab-backward (. rx rtab) (. rx rev) s e from)
      (dfa-backward (unwrap (. (unwrap m) r)) s e from)))
(defun group-count (rx: Regex) -> i64 (. rx groups))

;; ---- finding ----

(defun pack-span :private (st: i64 e: i64) -> i64 (+ (shl st 32) e))
(defun span-start :private (x: i64) -> i64 (shr x 32))
(defun span-end :private (x: i64) -> i64 (bit-and x 4294967295))

(defun check-from :private (s: str from: i64) -> unit
  (if (or (< from 0) (> from (str-len s)))
      (trap "re-find: the offset is outside the string")
      (if (and (< from (str-len s)) (continuation? (byte-at s from)))
          (trap "re-find: the offset splits a character")
          ())))

;; the slots of the leftmost match at or after from; empty when none
(defun find-caps :private (rx: Regex m: (Option Matcher) s: str from: i64) -> (Array i64)
  (if (. rx bt)
      (bt-caps rx s from false false)
      (find-caps-fast rx m s from)))

(defun find-caps-fast :private (rx: Regex m: (Option Matcher) s: str from: i64) -> (Array i64)
  (if (dfa-on? rx m)
      (let [e (fwd-end rx m s from)]
        (cond (= e -1) (no-caps)
              (< e 0) (pike-run (. rx fwd) s from false false)
              :else (let [st (rev-start rx m s e from)]
                      (cond (< st 0) (pike-run (. rx fwd) s from false false)
                            (> (. rx groups) 0) (pike-run (. rx fwd) s st true false)
                            :else (let [c (cell (array 2 st))] (do (array-set! &c 1 e) @c))))))
      (pike-run (. rx fwd) s from false false)))

;; the span of the leftmost match at or after from, packed; -1 when none
(defun find-packed :private (rx: Regex m: (Option Matcher) s: str from: i64) -> i64
  (if (. rx bt)
      (caps-packed (bt-caps rx s from false false))
      (find-packed-fast rx m s from)))

(defun find-packed-fast :private (rx: Regex m: (Option Matcher) s: str from: i64) -> i64
  (if (dfa-on? rx m)
      (let [e (fwd-end rx m s from)]
        (cond (= e -1) -1
              (>= e 0) (let [st (if (>= (. rx fixed) 0) (back-chars s e (. rx fixed)) (rev-start rx m s e from))]
                         (if (>= st 0) (pack-span st e) (caps-packed (pike-run (. rx fwd) s from false false))))
              :else (caps-packed (pike-run (. rx fwd) s from false false))))
      (caps-packed (pike-run (. rx fwd) s from false false))))

;; k characters before byte offset i
(defun back-chars :private (s: str i: i64 k: i64) -> i64
  (if (> k 0) (back-chars s (start-before s i) (- k 1)) i))

(defun caps-packed :private (caps: (Array i64)) -> i64
  (if (= (array-len caps) 0) -1 (pack-span (array-get caps 0) (array-get caps 1))))

(defun make-match :private (s: str caps: (Array i64) ng: i64) -> Match
  (let [
        st (array-get caps 0)
        e (array-get caps 1)]
    (Match st e (str-slice s st e)
           (loop [g 1 out (vec-empty)]
             (if (<= g ng)
                 (let [a (array-get caps (* 2 g))
                       b (array-get caps (+ (* 2 g) 1))]
                   (recur (+ g 1) (conj out (if (and (>= a 0) (>= b 0)) (some (str-slice s a b)) nil))))
                 out))
           (loop [i 0 out (vec-empty)]
             (if (< i (* 2 (+ ng 1))) (recur (+ i 1) (conj out (array-get caps i))) out)))))

(defun caps-match :private (s: str caps: (Array i64) ng: i64) -> (Option Match)
  (if (= (array-len caps) 0) nil (some (make-match s caps ng))))

(defun re-find-from (rx: Regex s: str from: i64) -> (Option Match)
  (do (check-from s from) (caps-match s (find-caps rx (matcher-of rx s) s from) (. rx groups))))

(defun re-find (rx: Regex s: str) -> (Option Match) (re-find-from rx s 0))

;; the whole of s must match
(defun re-matches (rx: Regex s: str) -> (Option Match)
  (caps-match s (if (. rx bt) (bt-caps rx s 0 true true) (pike-run (. rx fwd) s 0 true true)) (. rx groups)))

;; the same as `re-find` and `re-matches` with the spent budget of the backtracking matcher an `Err` (every other pattern is `Ok`)
(defun try-re-find-from (rx: Regex s: str from: i64) -> (Result (Option Match) str)
  (if (. rx bt)
      (do (check-from s from)
          (let [r (bt-run (. rx fwd) s from false false (default-budget))]
            (if (exceeded? r) (Err (budget-message)) (Ok (caps-match s r (. rx groups))))))
      (Ok (re-find-from rx s from))))

(defun try-re-find (rx: Regex s: str) -> (Result (Option Match) str) (try-re-find-from rx s 0))

(defun try-re-matches (rx: Regex s: str) -> (Result (Option Match) str)
  (if (. rx bt)
      (let [r (bt-run (. rx fwd) s 0 true true (default-budget))]
        (if (exceeded? r) (Err (budget-message)) (Ok (caps-match s r (. rx groups)))))
      (Ok (re-matches rx s))))

;; where the search goes on after the match [st, e)
(defun next-from :private (s: str st: i64 e: i64) -> i64
  (if (= st e)
      (if (< e (str-len s)) (+ e (width-of (byte-at s e))) -1)
      e))

(defun seq-from :private (rx: Regex m: (Option Matcher) s: str from: i64 acc: (Vec Match)) -> (Vec Match)
  (if (< from 0)
      acc
      (let [caps (find-caps rx m s from)]
        (if (= (array-len caps) 0)
            acc
            (seq-from rx m s (next-from s (array-get caps 0) (array-get caps 1)) (conj acc (make-match s caps (. rx groups))))))))

(defun re-seq (rx: Regex s: str) -> (Vec Match) (seq-from rx (matcher-of rx s) s 0 (vec-empty)))

;; the number of matches, without making them
(defun re-count (rx: Regex s: str) -> i64
  (loop [from 0 n 0 m (matcher-of rx s)]
    (if (< from 0)
        n
        (let [x (find-packed rx m s from)]
          (if (< x 0) n (recur (next-from s (span-start x) (span-end x)) (+ n 1) m))))))

(defun re-groups (m: Match) -> (Vec (Option str))
  (vec (concat [(some (. m whole))] (. m groups))))

;; the text of group g (0 is the whole match), nil when it took no part
(defun re-group (m: Match g: i64) -> (Option str)
  (if (= g 0) (some (. m whole)) (nth (. m groups) (- g 1))))

(defun match-start (m: Match g: i64) -> i64 (nth (. m spans) (* 2 g)))
(defun match-end (m: Match g: i64) -> i64 (nth (. m spans) (+ (* 2 g) 1)))

;; ---- Pattern: a Regex searches for `split`, `index-of` and the rest of fib.string ----

(impl Pattern Regex
  (find-in (self s from)
    (let [x (find-packed self (matcher-of self s) s from)]
      (if (< x 0) nil (some (Pair (span-start x) (span-end x))))))
  (replace-by (self s to limit) (replace-limit self s to limit)))

;; ---- replacing ----

(defenum TPart :private (TLit text: str) (TGroup n: i64))

(defun digit-val :private (b: i8) -> i64 (- (zext i64 b) 48))

;; the digits after `$` at i: the group number (taking a further digit only while that group exists) and where it ends
(defun group-ref :private (t: str i: i64 ng: i64) -> (Pair i64 i64)
  (let [n (str-len t)
        d0 (digit-val (str-byte-at t i))]
    (if (> d0 ng)
        (trap (str "No group " d0))
        (loop [j (+ i 1) acc d0]
          (if (and (< j n) (digit? (str-byte-at t j))
                   (<= (+ (* acc 10) (digit-val (str-byte-at t j))) ng))
              (recur (+ j 1) (+ (* acc 10) (digit-val (str-byte-at t j))))
              (Pair acc j))))))

(defun digit? :private (b: i8) -> bool (and (>= b 48i8) (<= b 57i8)))

;; the end of the run of ordinary characters that starts at i
(defun lit-end :private (t: str i: i64) -> i64
  (loop [j i]
    (if (and (< j (str-len t)) (!= (str-byte-at t j) 92i8) (!= (str-byte-at t j) 36i8)) (recur (+ j 1)) j)))

(defun add-lit :private (out: (Vec TPart) text: str) -> (Vec TPart)
  (if (> (str-len text) 0) (conj out (TLit text)) out))

(defun parse-template :private (t: str ng: i64) -> (Vec TPart)
  (let [n (str-len t)]
    (loop [i 0 out (vec-empty)]
      (if (>= i n)
          out
          (let [b (str-byte-at t i)]
            (cond (= b 92i8)
                  (if (< (+ i 1) n)
                      (let [w (width-of (byte-at t (+ i 1)))]
                        (recur (+ i 1 w) (add-lit out (str-slice t (+ i 1) (+ i 1 w)))))
                      (trap "character to be escaped is missing"))
                  (= b 36i8)
                  (if (and (< (+ i 1) n) (digit? (str-byte-at t (+ i 1))))
                      (let [r (group-ref t (+ i 1) ng)]
                        (recur (. r snd) (conj out (TGroup (. r fst)))))
                      (trap "Illegal group reference"))
                  :else (let [j (lit-end t i)] (recur j (add-lit out (str-slice t i j))))))))))

;; the text a template makes for one match, appended to acc
(defun expand-parts :private (s: str caps: (Array i64) parts: (Vec TPart) acc: (Vec str)) -> (Vec str)
  (reduce (fn (a: (Vec str) part: TPart)
            (match part
              ((TLit text) (conj a text))
              ((TGroup g) (let [x (array-get caps (* 2 g))
                                y (array-get caps (+ (* 2 g) 1))]
                            (if (and (>= x 0) (>= y 0)) (conj a (str-slice s x y)) a)))))
          acc parts))

(defun needs-groups? :private (parts: (Vec TPart)) -> bool
  (reduce (fn (b: bool part: TPart) (match part ((TGroup _) true) ((TLit _) b))) false parts))

;; the pieces of s with each of the first `limit` matches (all when limit is -1) replaced; `last` is where the
;; text not yet copied starts, `from` where the search goes on (-1: nowhere)
(defun replace-pieces :private (rx: Regex m: (Option Matcher) s: str parts: (Vec TPart) groups?: bool from: i64 last: i64 limit: i64 acc: (Vec str))
  -> (Vec str)
  (if (or (< from 0) (= limit 0))
      (conj acc (str-slice s last (str-len s)))
      (let [caps (if groups?
                     (find-caps rx m s from)
                     (let [x (find-packed rx m s from)]
                       (if (< x 0) (no-caps) (let [c (cell (array 2 (span-start x)))] (do (array-set! &c 1 (span-end x)) @c)))))]
        (if (= (array-len caps) 0)
            (conj acc (str-slice s last (str-len s)))
            (let [st (array-get caps 0)
                  e (array-get caps 1)]
              (replace-pieces rx m s parts groups? (next-from s st e) e (- limit 1)
                              (expand-parts s caps parts (conj acc (str-slice s last st)))))))))

;; the pieces joined, built in one pass: the length is summed, one array is filled
(defun join-pieces :private (pieces: (Vec str)) -> str
  (let [total (reduce (fn (n: i64 p: str) (+ n (str-len p))) 0 pieces)
        buf (cell (array (max total 1) 0i8))
        pos (cell 0)]
    (do (reduce (fn (u: unit p: str)
                  (let [m (str-len p)
                        at @pos]
                    (do (dotimes (j m) (array-set! &buf (+ at j) (str-byte-at p j)))
                        (set! pos (+ at m)))))
                () pieces)
        (str-from-bytes (array-copy @buf 0 total)))))

;; the spans of the first `limit` matches (all when limit is -1) as [start end start end ..]
(defun collect-spans :private (rx: Regex s: str limit: i64) -> (Vec i64)
  (loop [from 0 k 0 acc (vec-empty) m (matcher-of rx s)]
    (if (or (< from 0) (= k limit))
        acc
        (let [x (find-packed rx m s from)]
          (if (< x 0)
              acc
              (recur (next-from s (span-start x) (span-end x)) (+ k 1) (conj (conj acc (span-start x)) (span-end x)) m))))))

(defun copy-range :private (buf: (Cell (Array i8)) pos: i64 src: (Array i8) lo: i64 hi: i64) -> i64
  (do (dotimes (j (- hi lo)) (array-set! &buf (+ pos j) (array-get src (+ lo j))))
      (+ pos (- hi lo))))

(defun matched-bytes :private (spans: (Vec i64)) -> i64
  (loop [i 0 n 0]
    (if (< i (count spans)) (recur (+ i 2) (+ n (- (nth spans (+ i 1)) (nth spans i)))) n)))

;; the replacement of a template that has no group in it: the same text for every match. The matches are found
;; first, then the result is written once into an array of the exact length, with no piece made per match.
(defun replace-literal :private (rx: Regex s: str lit: str limit: i64) -> str
  (let [spans (collect-spans rx s limit)
        k (quot (count spans) 2)
        total (+ (- (str-len s) (matched-bytes spans)) (* k (str-len lit)))
        src (str-bytes s)
        lb (str-bytes lit)
        buf (cell (array (max total 1) 0i8))]
    (loop [i 0 last 0 pos 0]
      (if (< i (count spans))
          (let [p1 (copy-range buf pos src last (nth spans i))
                p2 (copy-range buf p1 lb 0 (array-len lb))]
            (recur (+ i 2) (nth spans (+ i 1)) p2))
          (do (copy-range buf pos src last (array-len src))
              (str-from-bytes (array-copy @buf 0 total)))))))

(defun literal-of :private (parts: (Vec TPart)) -> str
  (join-pieces (vec (map (fn (p: TPart) (match p ((TLit t) t) ((TGroup _) ""))) parts))))

(defun replace-limit :private (rx: Regex s: str template: str limit: i64) -> str
  (let [parts (parse-template template (. rx groups))]
    (if (needs-groups? parts)
        (join-pieces (replace-pieces rx (matcher-of rx s) s parts true 0 0 limit (vec-empty)))
        (replace-literal rx s (literal-of parts) limit))))

;; every match replaced; the template is Java's (`$1`, `\$`)
(defun replace-all (rx: Regex s: str template: str) -> str (replace-limit rx s template -1))
(defun replace-first (rx: Regex s: str template: str) -> str (replace-limit rx s template 1))

;; Clojure's `re-quote-replacement`: the template that inserts s as it is
(defun re-quote-replacement (s: str) -> str
  (join-pieces (let [n (str-len s)]
                 (loop [i 0 out (vec-empty)]
                   (if (< i n)
                       (let [w (width-of (byte-at s i))
                             c (str-byte-at s i)]
                         (recur (+ i w) (conj (if (or (= c 92i8) (= c 36i8)) (conj out "\\") out) (str-slice s i (+ i w)))))
                       out)))))
