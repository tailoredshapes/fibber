;; fib.seq.lseq: the lazy seq as a source, and its cons (tranche 1 plan §4.2; owner P0, the adaptors L6).
;; to-lseq of an LSeq is the seq itself: the override that keeps a stack of lazy adaptors lazy (PC-13).
(ns fib.seq.lseq (:use fib.core fib.seq.types fib.seq.protocols))
(defun lcons (x: a s: (LSeq a)) -> (LSeq a) (LSeq (cell (Ready (LCons x s)))))
(impl (Reducible a) (LSeq a)
  (each-while (self k)
    (loop ((s self)) (match (lnode s) ((LNil) true) ((LCons h t) (if (k h) (recur t) false)))))
  (to-lseq (self) self))
