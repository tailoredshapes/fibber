;; fib.seq.protocols: Reducible, the pull side (Cursor, Cursable), Seqable, and `count` (stdlib §2.1, §2.3;
;; tranche 1 plan §4.2; owner P0, the instances for the other sources L5a, L7).
;; Replaces the prelude's Countable, Seq and the walk of Traversable, which the flip deleted. Decided here:
;;  - Reducible has a sixth method after the page's five, to-lseq (plan PC-13), with a default through
;;    to-vec and an override on LSeq itself, so two lazy adaptors do not realise their source in full.
;;  - the defaults trap with the function's name: `nth: index out of range`.
;;  - the default `last` keeps an (Option e) in a cell, so until C5 it allocates one per element; a source
;;    that knows its end overrides it (the Vec does), case 022.
;;  - the default to-vec is the prelude's bulk builder (vec-collect, L9), not a conj loop: about 2 heap objects
;;    for every 32 elements where a conj loop spends 2.09 for each one.
;;  - count is a function over size, not a method, so a user type implements Reducible only.
;;  - a module that does not see fib.seq (the library's own parts) has no count: the prelude has only vec-count, map-count and set-count.
(ns fib.seq.protocols (:use fib.core fib.seq.types))
;; internal iteration with early exit: false from k stops the walk; the result says whether it ran to the end
(defprotocol (Reducible s e)
  (each-while (self k: (fn (e) bool) :borrow) -> bool)
  (size (self) -> i64
    (let ((n (cell 0)))
      (do (each-while self (fn (x) (do (set! n (+ @n 1)) true))) @n)))
  (nth (self i: i64) -> e
    (let ((n (cell 0)) (r (cell nil)))
      (do (each-while self (fn (x) (if (= @n i) (do (set! r (some x)) false) (do (set! n (+ @n 1)) true))))
          (match @r (nil (trap "nth: index out of range")) ((some x) x)))))
  (last (self) -> (Option e)
    (let ((r (cell nil))) (do (each-while self (fn (x) (do (set! r (some x)) true))) @r)))
  (to-vec (self) -> (Vec e) (fib.prelude/vec-collect (fn (k) (each-while self k))))
  ;; the lazy seq of the elements: a lazy source overrides it, so two lazy adaptors stay lazy end to end
  (to-lseq (self) -> (LSeq e) (lseq-vec (to-vec self)))
  ;; the spans: a source whose elements are held in arrays says how many (a Vec its leaves and tail, an Array 1);
  ;; -1, the default, says the source has none. The fused `map` of the expander (compiler/expand/fuseinline.fib)
  ;; runs a counted loop over each span with the stage functions in line, and the recipe walk when there are none.
  (span-count (self) -> i64 -1)
  ;; span j, the array of the elements that follow those of the spans before it; only for 0 <= j < span-count
  (span-array (self j: i64) -> (Array e) (trap "span-array: the source has no spans")))
(defun count (c: c) :where ((Reducible c e)) -> i64 (size c))
;; (nth c i d): the clause beside the method, because the table of a name is read where its method is defined (L1)
(defun nth$3 (c: c i: i64 d: e) :where ((Reducible c e)) -> e
  (let ((n (cell 0))
        (r (cell d)))
    (do (each-while c
          (fn (x)
            (if (= @n i)
                (do (set! r x) false)
                (do (set! n (+ @n 1)) true))))
        @r)))
;; the pull side, for the lockstep walks of tranche 2
(defprotocol (Cursor c e) (advance! (self) -> bool) (current (self) -> e))
(defprotocol (Cursable s c) (cursor (self) -> c))
;; seq/rest/next: one closed seq type per collection, so recursion on rest is not polymorphic recursion
(defprotocol (Seqable c s) (seq (self) -> (Option s)) (rest (self) -> s))
;; seed instances (P0): Vec and Option. L5a adds List, Array, Map, Set, Range.
(impl (Reducible a) (Vec a)
  (each-while (self k) (fib.prelude/vec-each-from self 0 k))
  (size (self) (vec-count self))
  (nth (self i) (vec-nth self i))
  (last (self) (let ((n (vec-count self))) (if (> n 0) (some (vec-nth self (- n 1))) nil)))
  (to-vec (self) self)
  (span-count (self) (let ((n (vec-count self))) (if (= n 0) 0 (+ (shr (- n 1) 5) 1))))
  (span-array (self j) (vec-span self j)))

;; Span j of v: its leaf of the elements from 32 j on, or its tail for the last; a j out of range traps.
(defun vec-span :private (v: (Vec a) j: i64) -> (Array a)
  (match v
    ((VecEmpty) (trap "span-array: index out of range"))
    ((VecOf cnt _ _ tail)
     (let ((at (shl j 5)) (tailoff (- cnt (array-len tail))))
       (if (or (< j 0) (> at tailoff))
           (trap "span-array: index out of range")
           (if (= at tailoff) tail (fib.prelude/vec-leaf-at v at)))))))

;; The Vec of the cnt elements of spans, in order, without a copy when they are shaped as a Vec's spans (every one but the last
;; of 32 elements, the last of 1 to 32: they become the leaves and the tail); one span of any length is vec-from-array's. Any
;; other shape, or a cnt that is not their total, traps. The expander's in-line map (compiler/expand/fuseinline.fib) ends with it.
(defun vec-from-spans (spans: (Array (Array a)) cnt: i64) -> (Vec a)
  (let ((k (- (array-len spans) 1)))
    (cond (< k 0) (if (= cnt 0) (vec-empty) (trap "vec-from-spans: the spans do not hold cnt elements"))
          (= k 0) (if (= (array-len (array-get spans 0)) cnt)
                      (fib.prelude/vec-from-array (array-get spans 0))
                      (trap "vec-from-spans: the spans do not hold cnt elements"))
          :else (let ((tail (array-get spans k)))
                  (do (dotimes (i k)
                        (if (= (array-len (array-get spans i)) 32) () (trap "vec-from-spans: a span before the last does not hold 32 elements")))
                      (if (and (> (array-len tail) 0) (<= (array-len tail) 32) (= cnt (+ (shl k 5) (array-len tail))))
                          (fib.prelude/vec-of-leaves spans k tail cnt)
                          (trap "vec-from-spans: the spans do not hold cnt elements")))))))
;; A Vec built element by element from its first, for a walk of unknown length written out in line: the loops the expander
;; writes for a fused chain with a filter, remove, keep, take or take-while step (compiler/expand/fuseflow.fib). A buffer of 32
;; is filled in place; each full one goes on an array of spans that doubles; vec-from-spans makes the Vec of them, no copy.
(defstruct (VecSink a) :private (buf: (Cell (Array a)) n: (Cell i64) spans: (Cell (Array (Array a)))))

(defun vec-build-first (x: a) -> (VecSink a)
  (VecSink (cell (array 32 x)) (cell 1) (cell (array 4 (array 1 x)))))

;; the full buffer as span k, the array of spans doubled first when it is full
(defun sink-span :private (b: (VecSink a) k: i64) -> unit
  (let ((sc (. b spans)) (full @(. b buf)))
    (do (if (= k (array-len @sc))
            (let ((bigger (cell (array (shl k 1) full))))
              (do (dotimes (i k) (array-set! &bigger i (array-get @sc i))) (set! sc @bigger)))
            ())
        (array-set! &sc k full))))

(defun vec-build-push (b: (VecSink a) x: a) -> unit
  (let ((n @(. b n)) (buf (. b buf)))
    (do (if (= (bit-and n 31) 0)
            (do (sink-span b (- (shr n 5) 1)) (set! buf (array 32 x)))
            (array-set! &buf (bit-and n 31) x))
        (set! (. b n) (+ n 1)))))

(defun vec-build-done (b: (VecSink a)) -> (Vec a)
  (let ((n @(. b n)) (k (shr (- @(. b n) 1) 5)) (f (+ (bit-and (- @(. b n) 1) 31) 1)) (buf @(. b buf)) (sc @(. b spans)))
    (let ((out (cell (array (+ k 1) (if (= f 32) buf (array-copy buf 0 f))))))
      (do (dotimes (i k) (array-set! &out i (array-get sc i)))
          (vec-from-spans @out n)))))
(impl (Reducible a) (Option a)
  (each-while (self k) (match self (nil true) ((some x) (k x))))
  (size (self) (match self (nil 0) ((some _) 1))))
