;; fib.seq.sort: the materialisers that reorder or regroup (tranche 1 plan §4.2; owner L7).
;; Exports: sort sort-by sort-with sort-by-with reverse group-by frequencies.
;; Replaces nothing in the prelude (it has no sort); the prototype is `sort-with` of rrevise3/sl/coll.fib.
;;
;; Rules, each from stdlib.md and decided here where the page is silent:
;;  - sort is a stable bottom-up merge sort over two Array buffers held in cells, so the writes are
;;    in place (§2.5); it returns a `VSeq` (§4.4 row sort) over the sorted Vec, so `(vec (sort xs))` is
;;    that Vec itself and `(conj (sort xs) 0)` conses at the front. A collection of fewer than two
;;    elements is returned as it is.
;;  - a comparator is any function whose result is a `Cmp`: an i64, or Clojure's predicate form, where
;;    true means "before" and a false asks the swapped call (`resolve`, fib.core.protocols). Two
;;    elements that compare equal keep their input order: the left one is taken unless the comparator
;;    says it is strictly after the right one.
;;  - `sort` and `sort-by` compare with fib.core's `compare` (L1's: built on `<` alone, so a NaN compares 0
;;    against everything and `sort` over floats holding a NaN is memory safe with an unspecified order,
;;    §2.7).
;;  - `sort-by` calls the key twice per comparison, as Clojure's `(sort (fn [x y] (compare (key x)
;;    (key y))) c)` does (§4.4 row sort-by); `sort-by-cached` (tranche 3) decorates instead. The key
;;    is not declared :borrow, as the row says; the comparator is, for it is only called.
;;  - `reverse` returns a `List`, as Clojure's returns one: `(conj (reverse [1 2 3]) 0)` is `(0 3 2 1)`.
;;  - `group-by` and `frequencies` fill a Map held in a cell in one pass; each group is a Vec in
;;    encounter order. They go through the prelude's `map-get` and `map-assoc` (`fib.prelude/NAME`,
;;    plan §4.3 rule 4) because fib.coll's `get` and `assoc` are above this part.
;;  - the empty List is `(list)` and a cons onto it `fib.prelude/conj`, so the part names no List variant.
;;  - no `/` on integers (plan PC-14) and no `min`/`max` (L1's): the one clamp is `imin`.
(ns fib.seq.sort (:use fib.core fib.seq.types fib.seq.protocols fib.seq.lseq fib.seq.vseq))

(defun imin :private (a: i64 b: i64) -> i64 (if (< a b) a b))

;; the pass that merges the sorted runs of `width` elements of `cur` into runs of 2*width in `tmp`:
;; the left run's head wins a tie, which is what makes the sort stable
(defun merge-runs :private (cmp: (fn (e e) i64) :borrow cur: (Array e) tmp: (Cell (Array e)) n: i64 width: i64) -> unit
  (loop ((lo 0))
    (if (< lo n)
        (let ((mid (imin (+ lo width) n)) (hi (imin (+ lo (* 2 width)) n)))
          (do (loop ((i lo) (j mid) (k lo))
                (if (< k hi)
                    (if (if (< i mid) (if (< j hi) (<= (cmp (array-get cur i) (array-get cur j)) 0) true) false)
                        (do (array-set! &tmp k (array-get cur i)) (recur (+ i 1) j (+ k 1)))
                        (do (array-set! &tmp k (array-get cur j)) (recur i (+ j 1) (+ k 1))))
                    ()))
              (recur hi)))
        ())))

;; the elements of v in the order of the three-way comparator cmp, stable; fewer than two come back as v
(defun sort-vec :private (cmp: (fn (e e) i64) :borrow v: (Vec e)) -> (Vec e)
  (let ((n (fib.prelude/count v)))
    (if (< n 2)
        v
        (let ((cur (cell (array n (fib.prelude/nth v 0)))) (tmp (cell (array n (fib.prelude/nth v 0)))))
          (do (dotimes (i n) (array-set! &cur i (fib.prelude/nth v i)))
              (loop ((width 1))
                (if (< width n)
                    (do (merge-runs cmp @cur tmp n width)
                        (let ((t @cur)) (do (set! cur @tmp) (set! tmp t)))
                        (recur (* width 2)))
                    ()))
              (loop ((i 0) (out (vec-empty)))
                (if (< i n) (recur (+ i 1) (fib.prelude/conj out (array-get @cur i))) out)))))))

;; (sort-with cmp c): the 2-arity of Clojure's sort until L1 (arity overloading); the comparator's result is a Cmp
(defun sort-with (cmp: (fn (e e) r) :borrow c: c) :where ((Reducible c e) (Cmp r)) -> (VSeq e)
  (vseq-of (sort-vec (fn (a b) (resolve (cmp a b) (fn () (cmp b a)))) (to-vec c))))

(defun sort (c: c) :where ((Reducible c e) (Ord e)) -> (VSeq e)
  (vseq-of (sort-vec (fn (a b) (compare a b)) (to-vec c))))

;; (sort-by-with key cmp c): the 3-arity of Clojure's sort-by until L1; cmp compares two keys
(defun sort-by-with (key: (fn (e) k) cmp: (fn (k k) r) :borrow c: c) :where ((Reducible c e) (Cmp r)) -> (VSeq e)
  (vseq-of (sort-vec (fn (a b) (resolve (cmp (key a) (key b)) (fn () (cmp (key b) (key a))))) (to-vec c))))

(defun sort-by (key: (fn (e) k) c: c) :where ((Reducible c e) (Ord k)) -> (VSeq e)
  (vseq-of (sort-vec (fn (a b) (compare (key a) (key b))) (to-vec c))))

;; a List of the elements, last first
(defun reverse (c: c) :where ((Reducible c e)) -> (List e)
  (let ((acc (cell (list))))
    (do (each-while c (fn (x) (do (set! acc (fib.prelude/conj @acc x)) true)))
        @acc)))

;; one pass: the Vec of the elements for each key, in encounter order
(defun group-by (f: (fn (e) k) :borrow c: c) :where ((Reducible c e) (Hash k) (Eq k)) -> (Map k (Vec e))
  (let ((m (cell (fib.prelude/map-empty))))
    (do (each-while c
          (fn (x)
            (let ((key (f x)))
              (do (set! m (fib.prelude/map-assoc @m key
                            (fib.prelude/conj (match (fib.prelude/map-get @m key) (nil (vec-empty)) ((some g) g)) x)))
                  true))))
        @m)))

(defun frequencies (c: c) :where ((Reducible c e) (Hash e) (Eq e)) -> (Map e i64)
  (let ((m (cell (fib.prelude/map-empty))))
    (do (each-while c
          (fn (x)
            (do (set! m (fib.prelude/map-assoc @m x (+ 1 (match (fib.prelude/map-get @m x) (nil 0) ((some n) n)))))
                true)))
        @m)))
