;; fib.seq.sort: the materialisers that reorder or regroup (tranche 1 plan §4.2; owner L7).
;; Exports: sort sort-by reverse group-by frequencies.
;; Replaces nothing in the prelude (it has no sort); the prototype is `sort-with` of rrevise3/sl/coll.fib.
;;
;; Rules, each from stdlib.md and decided here where the page is silent:
;;  - sort is a stable bottom-up merge sort over two Array buffers held in cells, so the writes are
;;    in place (§2.5); it returns a `VSeq` (§4.4 row sort) over the sorted Vec, so `(vec (sort xs))` is
;;    that Vec itself and `(conj (sort xs) 0)` conses at the front. A collection of fewer than two
;;    elements is returned as it is.
;;  - a comparator is any function whose result is a `Cmp`: an i64, or Clojure's predicate form, where
;;    true means "before" and a false asks the swapped call (`resolve`, fib.core.protocols). Two
;;    elements that compare equal keep their input order: the left one is taken unless the comparator
;;    says it is strictly after the right one.
;;  - `sort` and `sort-by` compare with fib.core's `compare` (L1's: built on `<` alone, so a NaN compares 0
;;    against everything and `sort` over floats holding a NaN is memory safe with an unspecified order,
;;    §2.7).
;;  - `sort-by` calls the key twice per comparison, as Clojure's `(sort (fn [x y] (compare (key x)
;;    (key y))) c)` does (§4.4 row sort-by); `sort-by-cached` (tranche 3) decorates instead. The key
;;    is not declared :borrow, as the row says; the comparator is, for it is only called.
;;  - `reverse` returns a `List`, as Clojure's returns one: `(conj (reverse [1 2 3]) 0)` is `(0 3 2 1)`.
;;  - `group-by` and `frequencies` fill a Map held in a cell in one pass; each group is a Vec in
;;    encounter order. They go through the prelude's `map-get` and `map-assoc` (`fib.prelude/NAME`,
;;    plan §4.3 rule 4) because fib.coll's `get` and `assoc` are above this part.
;;  - the empty List is `(list)` and a cons onto it `fib.prelude/Cons`, the prelude's own variant.
;;  - no `/` on integers (plan PC-14) and no `min`/`max` (L1's): the one clamp is `imin`.
(ns fib.seq.sort (:use fib.core fib.seq.types fib.seq.protocols fib.seq.lseq fib.seq.vseq))

(defun imin :private (a: i64 b: i64) -> i64 (if (< a b) a b))

;; The merges are written branch-free on purpose: a step takes the head by a select and moves the two cursors by (if take 1 0) and
;; (if take 0 1), which are unconditional additions, so the machine code has no branch on the comparison, which a random input
;; mispredicts about every second step (with a branch per step the merge took 1.7 times as long). The left head wins a tie, which is
;; what makes the sort stable. When one run is used up the tail of the other is copied.

;; the tails of cur[i,mid) and cur[j,hi) into tmp from k
(defun merge-tails :private (cur: (Array e) tmp: (Cell (Array e)) i: i64 mid: i64 j: i64 hi: i64 k: i64) -> unit
  (loop ((x i) (y k))
    (if (< x mid)
        (do (array-set! &tmp y (array-get cur x)) (recur (+ x 1) (+ y 1)))
        (loop ((x2 j) (y2 y))
          (if (< x2 hi) (do (array-set! &tmp y2 (array-get cur x2)) (recur (+ x2 1) (+ y2 1))) ())))))

;; the pass that merges the sorted runs of `width` elements of `cur` into runs of 2*width in `tmp`, for a comparator function
(defun merge-runs :private (cmp: (fn (e e) i64) :borrow cur: (Array e) tmp: (Cell (Array e)) n: i64 width: i64) -> unit
  (loop ((lo 0))
    (if (< lo n)
        (let ((mid (imin (+ lo width) n)) (hi (imin (+ lo (* 2 width)) n)))
          (do (loop ((i lo) (j mid) (k lo))
                (if (if (< i mid) (< j hi) false)
                    (let ((a (array-get cur i)) (b (array-get cur j)) (take (<= (cmp a b) 0)))
                      (do (array-set! &tmp k (if take a b))
                          (recur (+ i (if take 1 0)) (+ j (if take 0 1)) (+ k 1))))
                    (merge-tails cur tmp i mid j hi k)))
              (recur hi)))
        ())))

;; the same pass for the natural order: `compare` is a call the compiler can see, where cmp is a closure
(defun merge-runs-ord :private (cur: (Array e) tmp: (Cell (Array e)) n: i64 width: i64) :where ((Ord e)) -> unit
  (loop ((lo 0))
    (if (< lo n)
        (let ((mid (imin (+ lo width) n)) (hi (imin (+ lo (* 2 width)) n)))
          (do (loop ((i lo) (j mid) (k lo))
                (if (if (< i mid) (< j hi) false)
                    (let ((a (array-get cur i)) (b (array-get cur j)) (take (<= (compare a b) 0)))
                      (do (array-set! &tmp k (if take a b))
                          (recur (+ i (if take 1 0)) (+ j (if take 0 1)) (+ k 1))))
                    (merge-tails cur tmp i mid j hi k)))
              (recur hi)))
        ())))

;; the elements of v as an array of n, and a second array of n to merge into
(defun sort-buffers :private (v: (Vec e) n: i64) -> (Cell (Array e))
  (let ((cur (cell (array n (vec-nth v 0)))))
    (do (dotimes (i n) (array-set! &cur i (vec-nth v i))) cur)))

;; the elements of v in the order of the three-way comparator cmp, stable; fewer than two come back as v. The sorted array becomes
;; the vector in one pass (vec-from-array: 2 objects for every 32 elements, where a conj loop spends 2 for each).
(defun sort-vec :private (cmp: (fn (e e) i64) :borrow v: (Vec e)) -> (Vec e)
  (let ((n (vec-count v)))
    (if (< n 2)
        v
        (let ((cur (sort-buffers v n)) (tmp (cell (array n (vec-nth v 0)))))
          (do (loop ((width 1))
                (if (< width n)
                    (do (merge-runs cmp @cur tmp n width)
                        (let ((t @cur)) (do (set! cur @tmp) (set! tmp t)))
                        (recur (* width 2)))
                    ()))
              (fib.prelude/vec-from-array @cur))))))

;; sort-vec for the natural order
(defun sort-vec-ord :private (v: (Vec e)) :where ((Ord e)) -> (Vec e)
  (let ((n (vec-count v)))
    (if (< n 2)
        v
        (let ((cur (sort-buffers v n)) (tmp (cell (array n (vec-nth v 0)))))
          (do (loop ((width 1))
                (if (< width n)
                    (do (merge-runs-ord @cur tmp n width)
                        (let ((t @cur)) (do (set! cur @tmp) (set! tmp t)))
                        (recur (* width 2)))
                    ()))
              (fib.prelude/vec-from-array @cur))))))

;; (sort c) is the natural order; (sort cmp c) is Clojure's 2-arity, whose comparator's result is a Cmp. Both are clauses of one name
;; (sort$1, sort$2). The Rust fusion tables know `sort` with one argument only, so a chain under `sort$2` is built as the seq it
;; is bound to, and `sort$1` still reads a fused chain in place.
(defn sort
  ([c: c] :where ((Reducible c e) (Ord e)) -> (VSeq e)
    (vseq-of (sort-vec-ord (to-vec c))))
  ([cmp: (fn (e e) r) :borrow c: c] :where ((Reducible c e) (Cmp r)) -> (VSeq e)
    (vseq-of (sort-vec (fn (a b) (resolve (cmp a b) (fn () (cmp b a)))) (to-vec c)))))

;; (sort-by key c) compares the keys in their natural order; (sort-by key cmp c) compares two keys with cmp (sort-by$2, sort-by$3)
(defn sort-by
  ([key: (fn (e) k) c: c] :where ((Reducible c e) (Ord k)) -> (VSeq e)
    (vseq-of (sort-vec (fn (a b) (compare (key a) (key b))) (to-vec c))))
  ([key: (fn (e) k) cmp: (fn (k k) r) :borrow c: c] :where ((Reducible c e) (Cmp r)) -> (VSeq e)
    (vseq-of (sort-vec (fn (a b) (resolve (cmp (key a) (key b)) (fn () (cmp (key b) (key a))))) (to-vec c)))))

;; a List of the elements, last first
(defun reverse (c: c) :where ((Reducible c e)) -> (List e)
  (let ((acc (cell (list))))
    (do (each-while c (fn (x) (do (set! acc (fib.prelude/Cons x @acc)) true)))
        @acc)))

;; one pass: the Vec of the elements for each key, in encounter order
(defun group-by (f: (fn (e) k) :borrow c: c) :where ((Reducible c e) (Hash k) (Eq k)) -> (Map k (Vec e))
  (let ((m (cell (fib.prelude/map-empty))))
    (do (each-while c
          (fn (x)
            (let ((key (f x)))
              (do (set! m (fib.prelude/map-assoc @m key
                            (vec-conj (match (fib.prelude/map-get @m key) (nil (vec-empty)) ((some g) g)) x)))
                  true))))
        @m)))

(defun frequencies (c: c) :where ((Reducible c e) (Hash e) (Eq e)) -> (Map e i64)
  (let ((m (cell (fib.prelude/map-empty))))
    (do (each-while c
          (fn (x)
            (do (set! m (fib.prelude/map-assoc @m x (+ 1 (match (fib.prelude/map-get @m x) (nil 0) ((some n) n)))))
                true)))
        @m)))
