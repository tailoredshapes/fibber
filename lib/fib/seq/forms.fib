;; owner: Y7
;; fib.seq.forms: a stub made by tranche 2's Z0 (spec/stdlib.md §8.2.1), it will hold the macros `doseq for lazy-cat`.
;; The owner writes the part and replaces this comment with its header: what the part replaces and every rule it decided where the
;; page is silent. The `:use` lines are the ones the layout rules allow (the facades above, the parts before it); the owner edits them freely.
(ns fib.seq.forms (:use fib.core fib.seq.types fib.seq.protocols fib.seq.lazy fib.seq.adaptors))

;; lazy-cat (Y6; the stub's `doseq` and `for` are Y7's). (lazy-cat c ..) is (lazy-seq (concat c ..)) with each collection
;; expression delayed: it nests, `(lazy-cat a b c)` is `(lazy-seq (concat a (lazy-cat b c)))`, so b and c are not evaluated
;; until the walk has used up a (a collection that is empty at once demands the next one). At least one collection, as
;; Clojure's useful form; the template names fib.seq/lazy-from, the function `lazy-seq` expands to, and fib.seq/concat.
(defmacro lazy-cat (c ... more)
  (if (= (vec-count more) 0)
      `(fib.seq/lazy-from (fn () ~c))
      `(fib.seq/lazy-from (fn () (fib.seq/concat ~c (fib.seq/lazy-cat ~@more))))))
