;; fib.seq.vseq: the seq of a Vec and what sort returns, with Reducible for List and Seqable for Vec
;; (tranche 1 plan §4.2; owner P0, the rest of the Seqable instances L7).
;; A VSeq is consed front elements over a Vec and an offset: nothing is copied. (vec (sort xs)) is the
;; sorted Vec itself, so to-vec of a VSeq with no front and offset 0 is the Vec. The List variants are
;; `Empty` and `Cons` (R2); the library's own `empty` is a method and `cons` a function.
(ns fib.seq.vseq (:use fib.core fib.seq.types fib.seq.protocols))
(defun vseq-of (v: (Vec a)) -> (VSeq a) (VSeq Empty v 0))
(defun vseq-to-vec :private (c: (VSeq a)) -> (Vec a)
  (let ((acc (cell (vec-empty)))) (do (each-while c (fn (x) (do (set! acc (vec-conj @acc x)) true))) @acc)))
(impl (Reducible a) (VSeq a)
  (each-while (self k)
    (if (each-while (. self front) k)
        (let ((v (. self v)) (n (vec-count (. self v))))
          (loop ((i (. self lo))) (if (< i n) (if (k (vec-nth v i)) (recur (+ i 1)) false) true)))
        false))
  ;; (vec (sort xs)) is the sorted Vec itself
  (to-vec (self)
    (if (= (. self lo) 0)
        (match (. self front) ((Empty) (. self v)) (_ (vseq-to-vec self)))
        (vseq-to-vec self))))
(impl (Reducible a) (List a)
  (each-while (self k) (match self ((Empty) true) ((Cons h t) (if (k h) (each-while t k) false)))))
(impl (Seqable (VSeq a)) (Vec a)
  (seq (self) (if (> (vec-count self) 0) (some (vseq-of self)) nil))
  (rest (self) (VSeq Empty self (if (> (vec-count self) 0) 1 0))))
