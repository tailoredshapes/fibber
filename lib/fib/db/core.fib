;; fib.db.core: the driver-independent part of fib.db (docs/design/observability-and-databases.md 4): errors as values, rows as maps, the
;; Connection protocol a driver implements, and the next.jdbc-shaped functions over it. The macros `execute!`, `execute-one!` and
;; `with-transaction` are in the facade `fib.db`.
;;
;; Rows are `(Map str Datum)` keyed by the column's label as the database reports it (next.jdbc's unqualified maps). They are not keyed by
;; keyword because the prelude cannot make a keyword at run time (no `keyword`, stdlib row 1505 is not built); `col` takes a keyword
;; for the reader's sake and looks its text up.
(ns fib.db.core (:use fib.core fib.seq fib.coll fib.datum fib.ex))

;; What a failed operation came to. `sqlstate` is the SQL standard's five-character class and code ("23505" a unique violation, "42601"
;; a syntax error, "08006" a lost connection); a driver whose database has none (SQLite) maps its codes onto them (fib.db.sqlite), and
;; `code` and `message` keep the database's own.
(defstruct DbError (sqlstate: str code: i64 message: str))
(derive Eq DbError)
(derive Debug DbError)

(defun db-error? (e: DbError class: str) -> bool (starts-with? (. e sqlstate) class))

;; A statement and its parameters, as `(fib.sql/format q)` returns it and `execute!` takes it.
(defstruct Query (sql: str params: (Vec Datum)))

;; What a driver's connection does. A connection is used by one task at a time (it may move between tasks: it is Send when its fields
;; are), and `conn-close` is called once, by `with-connection` or by the program; closing twice is the driver's no-op, never a crash.
(defprotocol Connection
  ;; Runs one statement with `?` parameters. A statement that yields columns returns its rows; one that does not (INSERT, UPDATE, DDL)
  ;; returns one row `{"update-count" n}`, as next.jdbc does.
  (conn-execute (self sql: str params: (Vec Datum)) -> (Result (Vec (Map str Datum)) DbError))
  (conn-close (self) -> (Result unit DbError))
  ;; Walks the rows of one statement, one at a time: `k` is called with each and answers false to stop (the walk then ends early). Ok is
  ;; whether the walk ran to the end; an Err is the statement's, at the start or after some rows. A driver whose database has a cursor
  ;; overrides it so that no row is kept after `k` has seen it and the statement is finished (finalized, closed) when the walk ends, however it
  ;; ends, a trap in `k` included. The default is `conn-execute` and a walk over the vector: right, but it holds every row.
  (conn-each (self sql: str params: (Vec Datum) k: (fn ((Map str Datum)) bool) :borrow) -> (Result bool DbError)
    (match (conn-execute self sql params)
      ((Err e) (Err e))
      ((Ok rows) (Ok (each-while rows k))))))

(defun col (row: (Map str Datum) k: keyword) -> (Option Datum) (get row (keyword-text k)))

(defun execute-query (c: c q: Query) :where ((Connection c)) -> (Result (Vec (Map str Datum)) DbError)
  (conn-execute c (. q sql) (. q params)))

;; The first row, or nil when there is none (next.jdbc's execute-one!).
(defun execute-one-query (c: c q: Query) :where ((Connection c)) -> (Result (Option (Map str Datum)) DbError)
  (match (conn-execute c (. q sql) (. q params))
    ((Err e) (Err e))
    ((Ok rows) (Ok (first rows)))))

;; The update count of a statement that has one: 0 for a statement that returned rows.
(defun update-count (rows: (Vec (Map str Datum))) -> i64
  (match (first rows) (nil 0) ((some r) (unwrap-or (and-then as-int (get r "update-count")) 0))))

(defun finish :private (c: c r: (Result a DbError)) :where ((Connection c)) -> (Result a DbError)
  (match r
    ((Ok v) (match (conn-execute c "COMMIT" [])
              ((Ok _) (Ok v))
              ((Err e) (do (conn-execute c "ROLLBACK" []) (Err e)))))
    ((Err e) (do (conn-execute c "ROLLBACK" []) (Err e)))))

;; BEGIN, the body, then COMMIT when it returned Ok and ROLLBACK when it returned Err (or the COMMIT failed). A body that traps or
;; throws is rolled back and the failure goes on outwards (exceptions stage 2, docs/design/exceptions.md 9: catching a trap here makes the
;; program one that catches, ADR 0009; case 7891).
(defun transact (c: c body: (fn (c) (Result a DbError)) :borrow) :where ((Connection c)) -> (Result a DbError)
  (match (conn-execute c "BEGIN" [])
    ((Err e) (Err e))
    ((Ok _) (finish c (try (body c) (catch x (do (conn-execute c "ROLLBACK" []) (throw x))))))))

;; Runs the body with the connection `opened` holds and closes it exactly once, whether the body returns, returns an Err or traps (the trap
;; goes on outwards after the close). An Err from `opened` is returned as it is and the body does not run. When the body gave Ok and the
;; close fails, the close's error is the result. Used as `(with-connection [c (open-x ..)] body ..)` (fib.db).
(defun call-with-connection (opened: (Result c DbError) body: (fn (c) (Result a DbError)) :borrow) :where ((Connection c)) -> (Result a DbError)
  (match opened
    ((Err e) (Err e))
    ((Ok conn)
     (let [r (try (body conn) (catch x (do (conn-close conn) (throw x))))]
       (match (conn-close conn)
         ((Err e) (match r ((Ok _) (Err e)) ((Err b) (Err b))))
         ((Ok _) r))))))

;; (plan conn q): what next.jdbc's `plan` is, the rows of a statement as a reducible that is not built first. Nothing runs until it is
;; walked, and each walk runs the statement again: `(reduce f init (plan c q))`, `(run! f (plan c q))`, `(take 10 ..)`, `(first ..)`.
;; The elements are `(Result (Map str Datum) DbError)`: errors are values here as everywhere in fib.db; an Err ends the walk, and a statement
;; that fails to start gives one Err. The statement is finished when the walk ends, on an early exit and on a trap in the consumer.
;; `plan` the macro (fib.db) takes the literal vector form as `execute!` does; this is its function.
(defstruct (Plan c) (conn: c query: Query))

(defun plan-query (c: c q: Query) :where ((Connection c)) -> (Plan c) (Plan c q))

(impl (Reducible (Result (Map str Datum) DbError)) (Plan c) :where ((Connection c))
  (each-while (self k)
    (match (conn-each (. self conn) (. (. self query) sql) (. (. self query) params) (fn (row: (Map str Datum)) (k (Ok row))))
      ((Ok done) done)
      ((Err e) (do (k (Err e)) false)))))
