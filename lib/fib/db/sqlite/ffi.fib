;; fib.db.sqlite.ffi: the part of SQLite's C interface the driver uses (sqlite.org/c3ref), as externs. Handles are i64 (LP64: a pointer
;; is a word, as fib.http.client.ffi does for libcurl). Linking: `-l sqlite3` where the development symlink exists, else
;; `-l:libsqlite3.so.0` (Debian and Ubuntu ship only the runtime package by default); under `fibc run` and `fibc test` the library must
;; already be in the process: `LD_PRELOAD=libsqlite3.so.0` (the JIT resolves externs against the process, compiler/native/jit.fib).
(ns fib.db.sqlite.ffi)

(extern sqlite3_open_v2 (ptr ptr i32 i64) -> i32)
(extern sqlite3_close_v2 (i64) -> i32)
(extern sqlite3_errmsg (i64) -> ptr)
(extern sqlite3_extended_errcode (i64) -> i32)
(extern sqlite3_prepare_v2 (i64 ptr i32 ptr i64) -> i32)
(extern sqlite3_finalize (i64) -> i32)
(extern sqlite3_step (i64) -> i32)
(extern sqlite3_changes (i64) -> i32)
(extern sqlite3_bind_null (i64 i32) -> i32)
(extern sqlite3_bind_int64 (i64 i32 i64) -> i32)
(extern sqlite3_bind_double (i64 i32 f64) -> i32)
(extern sqlite3_bind_text (i64 i32 ptr i32 i64) -> i32)
(extern sqlite3_bind_blob (i64 i32 ptr i32 i64) -> i32)
(extern sqlite3_column_count (i64) -> i32)
(extern sqlite3_column_name (i64 i32) -> ptr)
(extern sqlite3_column_type (i64 i32) -> i32)
(extern sqlite3_column_int64 (i64 i32) -> i64)
(extern sqlite3_column_double (i64 i32) -> f64)
(extern sqlite3_column_text (i64 i32) -> ptr)
(extern sqlite3_column_blob (i64 i32) -> ptr)
(extern sqlite3_column_bytes (i64 i32) -> i32)

(def SQLITE_OK: i32 0i32)
(def SQLITE_ROW: i32 100i32)
(def SQLITE_DONE: i32 101i32)
;; SQLITE_TRANSIENT, the destructor value that makes SQLite copy a bound buffer before the call returns.
(def SQLITE_TRANSIENT: i64 -1)
