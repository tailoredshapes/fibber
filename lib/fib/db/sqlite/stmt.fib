;; fib.db.sqlite.stmt: SQLite's statements for the driver: errors, preparing, and the per-connection statement cache (D1, docs/design/
;; observability-and-databases.md 4.9).
;;
;; A statement is prepared once per SQL text on a connection and kept, up to CACHE_MAX of them, the least recently used going when a new one
;; needs the room. `acquire` hands a statement out as a `Lease` and `release` takes it back (reset, bindings cleared); a statement that is
;; out is `busy`, so a second use of the same text while a walk is in progress (a `plan` consumer that runs its own query) gets a statement
;; of its own that is finalized when it is released. Only DML and transaction statements are kept: any other (DDL, PRAGMA, ..) can change
;; what a kept statement means, so it runs on a statement of its own and the unbusy ones are dropped after it. A connection is used by one
;; task at a time, so the cache is plain data in an Atom; the counters inside it are atoms so that a hit changes no map.
(ns fib.db.sqlite.stmt (:use fib.core fib.seq fib.coll fib.datum fib.db.core fib.db.sqlite.ffi) (:require [fib.os.native :as n]))

(def CACHE_MAX: i64 32)

(defstruct Cached (st: i64 used: (Atom i64) busy: (Atom bool) names: (Vec str)))
(defstruct StmtCache (entries: (Atom (Map str Cached)) tick: (Atom i64)))
;; a statement handed out: 0 when the text held no statement; `entry` is the cache entry it is, nothing for a statement of its own;
;; `flush` is set for DDL and the like
(defstruct Lease (st: i64 names: (Vec str) entry: (Option Cached) flush: bool))

(defun new-cache () -> StmtCache (StmtCache (atom {}) (atom 0)))

;; SQLite's primary and extended result codes as SQLSTATE: constraint violations by kind (PostgreSQL's codes, which programs test),
;; a busy or locked database as a serialization failure, cannot-open as a connection failure, everything else as a general error.
(defun sqlstate (code: i64) -> str
  (cond (or (= code 2067) (= code 1555)) "23505" (= code 1299) "23502" (= code 787) "23503" (= code 275) "23514"
        (= (bit-and code 255) 19) "23000" (= (bit-and code 255) 5) "40001" (= (bit-and code 255) 6) "40001"
        (= (bit-and code 255) 14) "08001" (= code 1) "42000" :else "HY000"))

(defun last-error (db: i64) -> DbError
  (let [code (sext i64 (unsafe (sqlite3_extended_errcode db)))]
    (DbError (sqlstate code) code (unsafe (n/c-string (sqlite3_errmsg db))))))

(defun column-names (st: i64) -> (Vec str)
  (vec (map (fn (i: i64) (unsafe (n/c-string (sqlite3_column_name st (trunc i32 i))))) (range (sext i64 (unsafe (sqlite3_column_count st)))))))

;; The statement of the text (0 when it holds none, a comment for one).
(defun prepare (db: i64 sql: str) -> (Result i64 DbError)
  (let [text (n/c-text sql) slot (unsafe (alloc 8))
        rc (unsafe (sqlite3_prepare_v2 db text -1i32 slot 0))
        st (unsafe (load-i64 slot))]
    (do (unsafe (do (free text) (free slot)))
        (if (= rc SQLITE_OK) (Ok st) (Err (last-error db))))))

;; the byte of s at i with the ASCII case bit set: a letter's lower case
(defun lower-byte :private (s: str i: i64) -> i64 (bit-or (bit-and (sext i64 (str-byte-at s i)) 255) 32))

;; the first word of the text (its letters, lower-cased), after any leading white space
(defun lower-word :private (s: str) -> str
  (let [n (str-len s)
        start (loop [i 0] (if (and (< i n) (<= (bit-and (sext i64 (str-byte-at s i)) 255) 32)) (recur (+ i 1)) i))]
    (loop [k start out ""]
      (if (and (< k n) (>= (lower-byte s k) 97) (<= (lower-byte s k) 122))
          (recur (+ k 1) (str out (subs "abcdefghijklmnopqrstuvwxyz" (- (lower-byte s k) 97) (- (lower-byte s k) 96))))
          out))))

;; A statement that does not change the schema: the only kind that is kept.
(defun keepable? (sql: str) -> bool
  (let [w (lower-word sql)]
    (or (= w "select") (= w "insert") (= w "update") (= w "delete") (= w "replace") (= w "with")
        (= w "begin") (= w "commit") (= w "rollback") (= w "savepoint") (= w "release") (= w "end"))))

(defun own-lease :private (db: i64 sql: str flush: bool) -> (Result Lease DbError)
  (match (prepare db sql)
    ((Err e) (Err e))
    ((Ok st) (Ok (Lease st (if (= st 0) [] (column-names st)) nil flush)))))

;; the entry of least use that is not busy: its text and use, or "" and -1 when every entry is busy
(defstruct Best (sql: str used: i64))
(defun victim :private (entries: (Map str Cached)) -> str
  (. (reduce-kv (fn (best: Best k: str e: Cached)
                  (if (and (not @(. e busy)) (or (= (. best used) -1) (< @(. e used) (. best used)))) (Best k @(. e used)) best))
                (Best "" -1) entries)
     sql))

(defun evict :private (c: StmtCache) -> bool
  (let [m @(. c entries) v (victim m)]
    (match (get m v)
      (nil false)
      ((some e) (do (unsafe (sqlite3_finalize (. e st))) (reset! (. c entries) (dissoc m v)) true)))))

(defun touch :private (c: StmtCache e: Cached) -> unit
  (reset! (. e used) (swap! (. c tick) (fn (t: i64) (+ t 1)))))

(defun keep :private (c: StmtCache db: i64 sql: str st: i64) -> Lease
  (let [e (Cached st (atom 0) (atom true) (column-names st))]
    (do (touch c e) (reset! (. c entries) (assoc @(. c entries) sql e)) (Lease st (. e names) (some e) false))))

(defun miss :private (c: StmtCache db: i64 sql: str) -> (Result Lease DbError)
  (cond (not (keepable? sql)) (own-lease db sql true)
        (and (>= (count @(. c entries)) CACHE_MAX) (not (evict c))) (own-lease db sql false)
        :else (match (prepare db sql)
                ((Err e) (Err e))
                ((Ok st) (if (= st 0) (Ok (Lease 0 [] nil false)) (Ok (keep c db sql st)))))))

;; A statement for the text, ready to bind: the kept one when it is free, a new one otherwise.
(defun acquire (c: StmtCache db: i64 sql: str) -> (Result Lease DbError)
  (match (get @(. c entries) sql)
    ((some e) (if @(. e busy)
                  (own-lease db sql false)
                  (do (reset! (. e busy) true) (touch c e)
                      (Ok (Lease (. e st) (if (= (count (. e names)) (sext i64 (unsafe (sqlite3_column_count (. e st))))) (. e names) (column-names (. e st))) (some e) false)))))
    (nil (miss c db sql))))

;; Drops every kept statement that is not out.
(defun flush :private (c: StmtCache) -> unit
  (reset! (. c entries)
          (reduce-kv (fn (m: (Map str Cached) k: str e: Cached) (if @(. e busy) (assoc m k e) (do (unsafe (sqlite3_finalize (. e st))) m)))
                     {} @(. c entries))))

;; Takes a statement back: a kept one is reset and free again, one of its own is finalized (and DDL drops the kept ones).
(defun release (c: StmtCache l: Lease) -> unit
  (if (= (. l st) 0)
      ()
      (match (. l entry)
        ((some e) (do (unsafe (do (sqlite3_reset (. l st)) (sqlite3_clear_bindings (. l st)))) (reset! (. e busy) false)))
        (nil (do (unsafe (sqlite3_finalize (. l st))) (if (. l flush) (flush c) ()))))))

;; Finalizes every kept statement (the connection is closing).
(defun close-cache (c: StmtCache) -> unit
  (do (reduce-kv (fn (u: unit k: str e: Cached) (unsafe (do (sqlite3_finalize (. e st)) ()))) () @(. c entries))
      (reset! (. c entries) {})))

(defun cache-size (c: StmtCache) -> i64 (count @(. c entries)))
(defun cached? (c: StmtCache sql: str) -> bool (some? (get @(. c entries) sql)))
