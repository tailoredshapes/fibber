(ns fib.logic.fd.engine (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify fib.logic.fd.domain fib.logic.fd.types fib.logic.fd.slots)
  (:require [fib.logic.fd.distinct :as d] [fib.logic.fd.arithmetic :as a]
            [fib.logic.fd.schedule :as q] [fib.logic.fd.sync :as sync]))
(defun apply-constraint :private (constraint: Constraint snapshot: Snapshot) -> (Option Snapshot)
  (match constraint
    ((In term domain) (restrict snapshot term domain))
    ((AllDifferent terms) (d/distinct-pass terms snapshot))
    ((NotEqual left right) (if (same-term? (walk left (. (. snapshot state) bindings)) (walk right (. (. snapshot state) bindings))) nil
                            (a/pair-pass left right false true snapshot)))
    ((Less left right strict) (a/pair-pass left right strict false snapshot))
    ((Sum left right result) (a/sum-pass left right result snapshot))))
(defun ground-distinct? :private (terms: (Vec Term) state: State) -> bool
  (loop ((i 0) (seen: (Set i64) #{}))
    (if (= i (count terms)) true
        (match (walk (nth terms i) (. state bindings))
          ((Integer n) (if (contains? seen n) false (recur (+ i 1) (conj seen n))))
          (_ false)))))
(defun ground? :private (term: Term state: State) -> bool
  (match (walk term (. state bindings)) ((Integer _) true) (_ false)))
(defun entailed? :private (constraint: Constraint snapshot: Snapshot) -> bool
  (match constraint
    ((In term domain) (match (known-domain term snapshot) ((some d) (= (intersection d domain) d)) (nil false)))
    ((AllDifferent terms) (ground-distinct? terms (. snapshot state)))
    ((NotEqual left right)
      (match (known-domain left snapshot)
        (nil false)
        ((some a) (match (known-domain right snapshot)
          (nil false) ((some b) (= (domain-size (intersection a b)) 0))))))
    ((Less left right strict)
      (match (known-domain left snapshot)
        (nil false)
        ((some a) (match (known-domain right snapshot)
          (nil false) ((some b) (if strict (< (maximum a) (minimum b)) (<= (maximum a) (minimum b))))))))
    ((Sum left right result)
      (and (ground? left (. snapshot state)) (ground? right (. snapshot state)) (ground? result (. snapshot state))))))
(defun run-constraint :private (snapshot: Snapshot id: i64 constraint: Constraint) -> (Option Snapshot)
  (let ((store (. snapshot store))
        (counted (Store (. store domains) (. store domain-ids) (. store dirty)
                        (. store scheduler) (+ (. store runs) 1) (. store updates))))
    (match (apply-constraint constraint (Snapshot (. snapshot state) counted))
      (nil nil)
      ((some next) (some (if (entailed? constraint next)
          (Snapshot (. next state) (with-scheduler (. next store) (q/retire (. (. next store) scheduler) id))) next))))))
(defun propagate (snapshot: Snapshot) -> (Option Snapshot)
  (loop ((current snapshot) (position 0))
    (match (sync/drain current)
      (nil nil)
      ((some ready)
        (let ((store (. ready store)) (scheduler (. store scheduler)))
          (if (= position (count (. scheduler queue)))
              (some (Snapshot (. ready state) (with-scheduler store (q/clear-queue scheduler))))
              (let ((id (nth (. scheduler queue) position))
                    (next (Snapshot (. ready state) (with-scheduler store (q/take-id scheduler id)))))
                (match (nth (. scheduler constraints) id)
                  (nil (recur next (+ position 1)))
                  ((some constraint) (match (run-constraint next id constraint)
                    (nil nil) ((some out) (recur out (+ position 1)))))))))))))
(defun after-unify (state: State store: Store ids: (Vec i64)) -> (Option Snapshot)
  (match (sync/bindings (Snapshot state store) ids)
    (nil nil) ((some next) (propagate next))))
(defun add-constraint :private (snapshot: Snapshot constraint: Constraint) -> (Option Snapshot)
  (match constraint
    ((In term domain) (restrict snapshot term domain))
    (_ (some (Snapshot (. snapshot state)
          (with-scheduler (. snapshot store) (q/add (. (. snapshot store) scheduler) (. snapshot state) constraint)))))))
(defun post (state: State store: Store constraint: Constraint) -> (Option Snapshot)
  (match (add-constraint (Snapshot state store) constraint)
    (nil nil) ((some next) (propagate next))))
(defun setup :private (snapshot: Snapshot step: Setup) -> (Option Snapshot)
  (match step
    ((Post constraint) (add-constraint snapshot constraint))
    ((Bind a b) (match (unify-changed a b (. (. snapshot state) bindings))
      (nil nil)
      ((some update) (sync/bindings
        (Snapshot (State (. update bindings) (. (. snapshot state) next-id)) (. snapshot store)) (. update changed)))))))
(defun post-all (state: State store: Store steps: (Vec Setup)) -> (Option Snapshot)
  (loop ((i 0) (out (Snapshot state store)))
    (if (= i (count steps)) (propagate out)
        (match (setup out (nth steps i))
          (nil nil) ((some next) (recur (+ i 1) next))))))
(defun choose (snapshot: Snapshot) -> (Option (Pair i64 Domain))
  (let ((store (. snapshot store)))
    (reduce (fn (best: (Option (Pair i64 Domain)) id: i64)
      (match (slot-get (. store domains) id)
        (nil best)
        ((some d) (if (<= (domain-size d) 1) best
          (match best (nil (some (Pair id d)))
            ((some old) (if (or (< (domain-size d) (domain-size (. old snd)))
                               (and (= (domain-size d) (domain-size (. old snd))) (< id (. old fst))))
                            (some (Pair id d)) best))))))) nil (. store domain-ids))))
(defun complete? (snapshot: Snapshot) -> bool
  (let ((state (. snapshot state)))
    (reduce (fn (ok: bool item: (Option Constraint))
      (and ok (match item (nil true) ((some c) (match c
        ((In term _) (match (walk term (. state bindings)) ((Integer _) true) (_ false)))
        ((AllDifferent terms) (reduce (fn (ok: bool term: Term) (and ok (match (walk term (. state bindings)) ((Integer _) true) (_ false)))) true terms))
        ((NotEqual a b) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false)))))
        ((Less a b _) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false)))))
        ((Sum a b c) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false))) (not (match (walk c (. state bindings)) ((Var _) true) (_ false)))))))))) true (. (. (. snapshot store) scheduler) constraints))))
