(ns fib.logic.fd.engine (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify fib.logic.fd.domain fib.logic.fd.types)
  (:require [fib.logic.fd.distinct :as d] [fib.logic.fd.arithmetic :as a]))

(defun normalize :private (snapshot: Snapshot) -> (Option Snapshot)
  (let ((entries (to-vec (. (. snapshot store) domains)))
        (initial (Snapshot (. snapshot state) (Store {} (. (. snapshot store) constraints)))))
    (loop ((i 0) (out initial))
      (if (= i (count entries)) (some out)
          (let ((entry (nth entries i)))
            (match (restrict out (Var (. entry fst)) (. entry snd))
              (nil nil) ((some next) (recur (+ i 1) next))))))))
(defun bind-singletons :private (snapshot: Snapshot) -> (Option Snapshot)
  (let ((entries (to-vec (. (. snapshot store) domains))))
    (loop ((i 0) (state (. snapshot state)))
      (if (= i (count entries)) (some (Snapshot state (. snapshot store)))
          (let ((entry (nth entries i)) (domain (. entry snd)))
            (if (= (domain-size domain) 1)
                (match (unify (Var (. entry fst)) (Integer (minimum domain)) (. state bindings))
                  (nil nil) ((some bindings) (recur (+ i 1) (State bindings (. state next-id)))))
                (recur (+ i 1) state)))))))
(defun apply-constraint :private (constraint: Constraint snapshot: Snapshot) -> (Option Snapshot)
  (match constraint
    ((In term domain) (restrict snapshot term domain))
    ((AllDifferent terms) (d/distinct-pass terms snapshot))
    ((NotEqual left right) (if (same-term? (walk left (. (. snapshot state) bindings)) (walk right (. (. snapshot state) bindings))) nil
                            (a/pair-pass left right false true snapshot)))
    ((Less left right strict) (a/pair-pass left right strict false snapshot))
    ((Sum left right result) (a/sum-pass left right result snapshot))))
(defun ground-distinct? :private (terms: (Vec Term) state: State) -> bool
  (loop ((i 0) (seen: (Set i64) #{}))
    (if (= i (count terms)) true
        (match (walk (nth terms i) (. state bindings))
          ((Integer n) (if (contains? seen n) false (recur (+ i 1) (conj seen n))))
          (_ false)))))
(defun ground? :private (term: Term state: State) -> bool
  (match (walk term (. state bindings)) ((Integer _) true) (_ false)))
(defun entailed? :private (constraint: Constraint snapshot: Snapshot) -> bool
  (match constraint
    ((In term domain) (match (known-domain term snapshot) ((some d) (= (intersection d domain) d)) (nil false)))
    ((AllDifferent terms) (ground-distinct? terms (. snapshot state)))
    ((NotEqual left right)
      (match (known-domain left snapshot)
        (nil false)
        ((some a) (match (known-domain right snapshot)
          (nil false) ((some b) (= (domain-size (intersection a b)) 0))))))
    ((Less left right strict)
      (match (known-domain left snapshot)
        (nil false)
        ((some a) (match (known-domain right snapshot)
          (nil false) ((some b) (if strict (< (maximum a) (minimum b)) (<= (maximum a) (minimum b))))))))
    ((Sum left right result)
      (and (ground? left (. snapshot state)) (ground? right (. snapshot state)) (ground? result (. snapshot state))))))
(defun pass :private (snapshot: Snapshot) -> (Option Snapshot)
  (let ((constraints (. (. snapshot store) constraints)))
    (loop ((i 0) (out snapshot) (remaining: (Vec Constraint) []))
      (if (= i (count constraints))
          (bind-singletons (Snapshot (. out state) (Store (. (. out store) domains) remaining)))
          (let ((constraint (nth constraints i)))
            (match (apply-constraint constraint out)
              (nil nil)
              ((some next) (if (entailed? constraint next)
                               (recur (+ i 1) next remaining)
                               (recur (+ i 1) next (conj remaining constraint))))))))))
(defun propagate (snapshot: Snapshot) -> (Option Snapshot)
  (loop ((current snapshot))
    (match (normalize current) (nil nil)
      ((some normalized) (match (pass normalized) (nil nil)
        ((some next)
          (if (and (= (. (. next state) bindings) (. (. current state) bindings))
                   (= (. (. next store) domains) (. (. current store) domains)))
              (some next) (recur next))))))))
(defun post (state: State store: Store constraint: Constraint) -> (Option Snapshot)
  (let ((snapshot (Snapshot state store)))
    (match constraint
      ((In term domain) (match (restrict snapshot term domain) (nil nil) ((some next) (propagate next))))
      (_ (propagate (Snapshot state (Store (. store domains) (conj (. store constraints) constraint))))))))
(defun choose (snapshot: Snapshot) -> (Option (Pair i64 Domain))
  (reduce (fn (best: (Option (Pair i64 Domain)) entry: (Pair i64 Domain))
            (if (<= (domain-size (. entry snd)) 1) best
                (match best (nil (some entry))
                  ((some old) (if (or (< (domain-size (. entry snd)) (domain-size (. old snd)))
                                      (and (= (domain-size (. entry snd)) (domain-size (. old snd))) (< (. entry fst) (. old fst))))
                                  (some entry) best))))) nil (. (. snapshot store) domains)))
(defun complete? (snapshot: Snapshot) -> bool
  (let ((state (. snapshot state)))
    (reduce (fn (ok: bool c: Constraint)
      (and ok (match c
        ((In term _) (match (walk term (. state bindings)) ((Integer _) true) (_ false)))
        ((AllDifferent terms) (reduce (fn (ok: bool term: Term) (and ok (match (walk term (. state bindings)) ((Integer _) true) (_ false)))) true terms))
        ((NotEqual a b) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false)))))
        ((Less a b _) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false)))))
        ((Sum a b c) (and (not (match (walk a (. state bindings)) ((Var _) true) (_ false))) (not (match (walk b (. state bindings)) ((Var _) true) (_ false))) (not (match (walk c (. state bindings)) ((Var _) true) (_ false)))))))) true (. (. snapshot store) constraints))))
