;; All-different propagates fixed values and detects duplicate variables/values.
(ns fib.logic.fd.distinct (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify fib.logic.fd.domain fib.logic.fd.types))

(defun fixed-values :private (terms: (Vec Term) snapshot: Snapshot) -> (Option (Vec i64))
  (loop ((i 0) (variables: (Set i64) #{}) (fixed: (Set i64) #{}))
    (if (= i (count terms)) (some (to-vec fixed))
        (match (walk (nth terms i) (. (. snapshot state) bindings))
          ((Integer n) (if (contains? fixed n) nil (recur (+ i 1) variables (conj fixed n))))
          ((Var id) (if (contains? variables id) nil (recur (+ i 1) (conj variables id) fixed)))
          (_ nil)))))
(defun prune :private (terms: (Vec Term) fixed: (Vec i64) snapshot: Snapshot) -> (Option Snapshot)
  (loop ((i 0) (current snapshot))
    (if (= i (count terms)) (some current)
        (let ((term (nth terms i)))
          (match (walk term (. (. current state) bindings))
            ((Integer _) (recur (+ i 1) current))
            (_ (match (known-domain term current)
              (nil (recur (+ i 1) current))
              ((some d) (match (restrict current term (reduce (fn (d: Domain n: i64) (remove-value d n)) d fixed))
                (nil nil) ((some next) (recur (+ i 1) next)))))))))))
(defun distinct-pass (terms: (Vec Term) snapshot: Snapshot) -> (Option Snapshot)
  (match (fixed-values terms snapshot)
    (nil nil)
    ((some fixed) (prune terms fixed snapshot))))
