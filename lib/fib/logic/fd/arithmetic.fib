(ns fib.logic.fd.arithmetic (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify fib.logic.fd.domain fib.logic.fd.types))

(defun pair-pass (a: Term b: Term strict: bool unequal: bool snapshot: Snapshot) -> (Option Snapshot)
  (if (or (not (numeric? a (. snapshot state))) (not (numeric? b (. snapshot state)))) nil
      (match (known-domain a snapshot)
        (nil (some snapshot))
        ((some da) (match (known-domain b snapshot)
          (nil (some snapshot))
          ((some db)
            (let ((av (values da)) (bv (values db))
                  (allowed (fn (x: i64 y: i64) (if unequal (!= x y) (if strict (< x y) (<= x y)))))
                  (left (domain (filterv (fn (x: i64) (reduce (fn (ok: bool y: i64) (or ok (allowed x y))) false bv)) av)))
                  (right (domain (filterv (fn (y: i64) (reduce (fn (ok: bool x: i64) (or ok (allowed x y))) false av)) bv))))
              (match (restrict snapshot a left) (nil nil) ((some next) (restrict next b right))))))))))
;; Arithmetic support excludes overflowing sums rather than wrapping or aborting a valid branch.
(defun valid-sum? :private (a: i64 b: i64) -> bool
  (cond (> b 0) (<= a (- 9223372036854775807 b))
        (< b 0) (>= a (- -9223372036854775808 b))
        :else true))
(defun sum-support :private (a: Domain b: Domain c: Domain) -> (Triple Domain Domain Domain)
  (let ((as (cell #{})) (bs (cell #{})) (cs (cell #{})) (av (values a)) (bv (values b)))
    (do (dotimes (i (count av)) (dotimes (j (count bv))
          (let ((x (nth av i)) (y (nth bv j)))
            (when (and (valid-sum? x y) (contains-value? c (+ x y)))
              (do (set! as (conj @as x)) (set! bs (conj @bs y)) (set! cs (conj @cs (+ x y))))))))
        (Triple (domain (to-vec @as)) (domain (to-vec @bs)) (domain (to-vec @cs))))))
(defun sum-pass (a: Term b: Term c: Term snapshot: Snapshot) -> (Option Snapshot)
  (if (or (not (numeric? a (. snapshot state))) (not (numeric? b (. snapshot state))) (not (numeric? c (. snapshot state)))) nil
      (match (known-domain a snapshot) (nil (some snapshot))
        ((some da) (match (known-domain b snapshot) (nil (some snapshot))
          ((some db) (match (known-domain c snapshot) (nil (some snapshot))
            ((some dc) (let ((support (sum-support da db dc)))
              (match (restrict snapshot a (. support fst)) (nil nil)
                ((some left) (match (restrict left b (. support snd)) (nil nil)
                  ((some right) (restrict right c (. support thd)))))))))))))))
