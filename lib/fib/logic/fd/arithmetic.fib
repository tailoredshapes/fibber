(ns fib.logic.fd.arithmetic (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify fib.logic.fd.domain fib.logic.fd.types))
;; Bound propagation follows the interval-support approach used by clojure.core.logic.fd (EPL-1.0).

(defun order-pass :private (a: Term b: Term strict: bool da: Domain db: Domain snapshot: Snapshot) -> (Option Snapshot)
  (let ((upper (maximum db)) (lower (minimum da)))
    (let ((left (at-most da upper strict)) (right (at-least db lower strict)))
      (match (restrict snapshot a left)
        (nil nil)
        ((some next) (restrict next b right))))))
(defun disequality-pass :private (a: Term b: Term da: Domain db: Domain snapshot: Snapshot) -> (Option Snapshot)
  (cond (= (domain-size da) 1)
        (restrict snapshot b (remove-value db (minimum da)))
        (= (domain-size db) 1)
        (restrict snapshot a (remove-value da (minimum db)))
        :else (some snapshot)))
(defun pair-pass (a: Term b: Term strict: bool unequal: bool snapshot: Snapshot) -> (Option Snapshot)
  (if (or (not (numeric? a (. snapshot state))) (not (numeric? b (. snapshot state)))) nil
      (match (known-domain a snapshot)
        (nil (some snapshot))
        ((some da)
         (match (known-domain b snapshot)
           (nil (some snapshot))
           ((some db)
            (if unequal
                (disequality-pass a b da db snapshot)
                (order-pass a b strict da db snapshot))))))))
;; Arithmetic support excludes overflowing sums rather than wrapping or aborting a valid branch.
(defun valid-sum? :private (a: i64 b: i64) -> bool
  (cond (> b 0) (<= a (- 9223372036854775807 b))
        (< b 0) (>= a (- -9223372036854775808 b))
        :else true))
(defun sum-bounds :private (a: Domain b: Domain c: Domain) -> (Triple Domain Domain Domain)
  (let ((min-a (minimum a)))
    (let ((max-a (maximum a)))
      (let ((min-b (minimum b)))
        (let ((max-b (maximum b)))
          (let ((min-c (minimum c)))
            (let ((max-c (maximum c)))
              (let ((left (domain (filterv (fn (x: i64)
                                   (if (and (valid-sum? x min-b) (valid-sum? x max-b))
                                       (and (<= (+ x min-b) max-c) (>= (+ x max-b) min-c))
                                       true)) (values a)))))
                (let ((right (domain (filterv (fn (y: i64)
                                    (if (and (valid-sum? min-a y) (valid-sum? max-a y))
                                        (and (<= (+ min-a y) max-c) (>= (+ max-a y) min-c))
                                        true)) (values b)))))
                  (let ((result (domain (filterv (fn (z: i64)
                                      (if (and (valid-sum? min-a min-b) (valid-sum? max-a max-b))
                                          (and (>= z (+ min-a min-b)) (<= z (+ max-a max-b)))
                                          true)) (values c)))))
                    (Triple left right result)))))))))))
(defun sum-support :private (a: Domain b: Domain c: Domain) -> (Triple Domain Domain Domain)
  (let ((as (cell #{})) (bs (cell #{})) (cs (cell #{})) (av (values a)) (bv (values b)))
    (do (dotimes (i (count av)) (dotimes (j (count bv))
          (let ((x (nth av i)) (y (nth bv j)))
            (when (and (valid-sum? x y) (contains-value? c (+ x y)))
              (do (set! as (conj @as x)) (set! bs (conj @bs y)) (set! cs (conj @cs (+ x y))))))))
        (Triple (domain (to-vec @as)) (domain (to-vec @bs)) (domain (to-vec @cs))))))
(defun sum-pass (a: Term b: Term c: Term snapshot: Snapshot) -> (Option Snapshot)
  (if (or (not (numeric? a (. snapshot state))) (not (numeric? b (. snapshot state))) (not (numeric? c (. snapshot state)))) nil
      (match (known-domain a snapshot) (nil (some snapshot))
        ((some da) (match (known-domain b snapshot) (nil (some snapshot))
          ((some db) (match (known-domain c snapshot) (nil (some snapshot))
            ((some dc) (let ((support (if (and (<= (domain-size da) 64) (<= (domain-size db) 64))
                                           (sum-support da db dc)
                                           (sum-bounds da db dc))))
              (match (restrict snapshot a (. support fst)) (nil nil)
                ((some left) (match (restrict left b (. support snd)) (nil nil)
                  ((some right) (restrict right c (. support thd)))))))))))))))
