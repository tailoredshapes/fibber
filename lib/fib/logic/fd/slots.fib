;; Indexed persistent storage for ordinary variable IDs; unusual IDs stay sparse.
;; Vec updates copy only the affected trie path when a branch shares it.
(ns fib.logic.fd.slots (:use fib.core fib.seq fib.coll))
(defstruct (Slots a) (dense: (Vec (Option a)) sparse: (Map i64 a)))
(defun empty-slots () -> (Slots a) (Slots [] {}))
(defun dense-id? :private (id: i64) -> bool (and (>= id 0) (< id 4096)))
(defun slot-get (slots: (Slots a) id: i64) -> (Option a)
  (if (dense-id? id)
      (if (< id (count (. slots dense))) (nth (. slots dense) id) nil)
      (get (. slots sparse) id)))
(defun slot-put (slots: (Slots a) id: i64 value: a) -> (Slots a)
  (if (dense-id? id)
      (let ((dense (loop ((out (. slots dense)))
                     (if (< (count out) id) (recur (conj out nil)) out))))
        (Slots (assoc dense id (some value)) (. slots sparse)))
      (Slots (. slots dense) (assoc (. slots sparse) id value))))
(defun slot-remove (slots: (Slots a) id: i64) -> (Slots a)
  (if (dense-id? id)
      (if (< id (count (. slots dense)))
          (Slots (assoc (. slots dense) id nil) (. slots sparse)) slots)
      (Slots (. slots dense) (dissoc (. slots sparse) id))))
