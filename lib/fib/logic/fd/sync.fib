;; Synchronize only the roots changed by unification, transferring alias watches.
(ns fib.logic.fd.sync (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.unify
                            fib.logic.fd.types fib.logic.fd.domain fib.logic.fd.slots)
  (:require [fib.logic.fd.schedule :as q]))
(defun alias :private (snapshot: Snapshot id: i64 root: i64) -> (Option Snapshot)
  (let ((store (. snapshot store)) (old (slot-get (. store domains) id))
        (moved (q/move-watch (. store scheduler) id root)))
    (let ((next (Snapshot (. snapshot state)
                  (Store (slot-remove (. store domains) id) (. store domain-ids)
                         (conj (. store dirty) root) moved (. store runs) (. store updates)))))
      (match old (nil (some next)) ((some d) (restrict next (Var root) d))))))
(defun one :private (snapshot: Snapshot id: i64) -> (Option Snapshot)
  (let ((store (. snapshot store)) (old (slot-get (. store domains) id)))
    (match (walk (Var id) (. (. snapshot state) bindings))
      ((Var root) (if (= id root) (some snapshot) (alias snapshot id root)))
      ((Integer n)
        (match old
          (nil (some (Snapshot (. snapshot state) (changed store id))))
          ((some d) (if (contains-value? d n)
              (some (Snapshot (. snapshot state)
                (if (= d (Small n 1)) (changed store id) (store-domain store id (Small n 1))))) nil))))
      (_ (match old ((some _) nil) (nil (some (Snapshot (. snapshot state) (changed store id)))))))))
(defun bindings (snapshot: Snapshot ids: (Vec i64)) -> (Option Snapshot)
  (loop ((i 0) (out snapshot))
    (if (= i (count ids)) (some out)
        (match (one out (nth ids i)) (nil nil) ((some next) (recur (+ i 1) next))))))
(defun drain (snapshot: Snapshot) -> (Option Snapshot)
  (if (= (count (. (. snapshot store) dirty)) 0) (some snapshot)
    (let ((store (. snapshot store)) (ids (. store dirty)))
    (loop ((i 0) (state (. snapshot state)) (scheduler (. store scheduler)))
      (if (= i (count ids))
          (some (Snapshot state (Store (. store domains) (. store domain-ids) [] scheduler (. store runs) (. store updates))))
          (let ((id (nth ids i)) (next (q/wake scheduler id)))
            (match (slot-get (. store domains) id)
              ((some d) (if (= (domain-size d) 1)
                  (match (walk (Var id) (. state bindings))
                    ((Var root) (recur (+ i 1) (State (assoc (. state bindings) root (Integer (minimum d))) (. state next-id)) next))
                    ((Integer n) (if (= n (minimum d)) (recur (+ i 1) state next) nil))
                    (_ nil))
                  (recur (+ i 1) state next)))
              (nil (recur (+ i 1) state next)))))))))
