(ns fib.logic.fd.api (:use fib.core fib.seq fib.coll fib.logic.terms fib.logic.search fib.logic.fd.types fib.logic.fd.domain))
(defun size (d: Domain) -> i64 (domain-size d))
(defun in (term: Term d: Domain) -> Goal (Constrain (In term d)))
(defun in-all (terms: (Vec Term) d: Domain) -> Goal
  (All (mapv (fn (term: Term) (in term d)) terms)))
(defun distinct (terms: (Vec Term)) -> Goal (Constrain (AllDifferent terms)))
(defun != (left: Term right: Term) -> Goal (Constrain (NotEqual left right)))
(defun < (left: Term right: Term) -> Goal (Constrain (Less left right true)))
(defun <= (left: Term right: Term) -> Goal (Constrain (Less left right false)))
(defun + (left: Term right: Term result: Term) -> Goal (Constrain (Sum left right result)))
