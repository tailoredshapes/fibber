(ns fib.logic.query (:use fib.core fib.seq fib.coll fib.print fib.logic.terms fib.logic.unify fib.logic.search))

(defun run-many (limit: i64 variables: i64 build: (fn ((Vec Term)) Goal)) -> (Vec (Vec Term))
  (do (when (< limit 0) (trap "logic: negative answer limit"))
      (when (< variables 0) (trap "logic: negative query variable count"))
      (if (= limit 0) []
          (let ((queries (loop ((i 0) (out: (Vec Term) []))
                           (if (< i variables) (recur (+ i 1) (conj out (Var i))) out)))
                (stream (start-in (build queries) (State {} variables))))
            (mapv (fn (state: State) (reify-many queries state)) (take-states limit stream))))))

(defun run (limit: i64 build: (fn (Term) Goal)) -> (Vec Term)
  (mapv (fn (row: (Vec Term)) (nth row 0))
       (run-many limit 1 (fn (queries: (Vec Term)) (build (nth queries 0))))))
