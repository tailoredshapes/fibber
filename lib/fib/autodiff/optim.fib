;; fib.autodiff.optim: optimiser steps over a vector of parameter tensors. Each step returns fresh tensors (values, not mutation):
;; the old parameters are released when the caller rebinds them, and the gradients are consumed. In-place updates through a
;; window (fib.view) are the stage-2 improvement named in docs/design/autodiff.md; the Adam update is one fused pass per parameter (t/adam-step).
(ns fib.autodiff.optim
  (:use fib.core fib.seq fib.coll fib.autodiff.real)
  (:require [fib.tensor :as t]))

;; p - lr g
(defun sgd-step (lr: f64 params: (Vec (t/Tensor a)) grads: (Vec (t/Tensor a))) -> (Vec (t/Tensor a))
  (vec (map-indexed (fn (i p) (let [k (lit (. p seed) (- 0.0 lr))] (t/axpby (one (. p seed)) p k (nth grads i)))) params)))

(defstruct (AdamState a) (m: (Vec (t/Tensor a)) v: (Vec (t/Tensor a)) steps: i64))
(defstruct (Stepped a) (params: (Vec (t/Tensor a)) state: (AdamState a)))

(defun adam-init (params: (Vec (t/Tensor a))) -> (AdamState a)
  (let [zs (fn (p: (t/Tensor a)) (t/full (t/shape p) (zero (. p seed))))]
    (AdamState (mapv zs params) (mapv zs params) 0)))

(defun ipow (x: f64 n: i64) -> f64 (loop [i 0 acc 1.0] (if (< i n) (recur (+ i 1) (* acc x)) acc)))

;; One fused pass over a parameter, its gradient and its two moments (`t/adam-step`, fib.tensor.optim): the same operations in the same order as the nine tensor calls it replaced
;; (axpby, mul, axpby, sqrt, scale, shift, div, axpby), so the results are bit-identical to them; PyTorch's placement of eps (after the square root and the bias correction).
(defun adam-one (lr: f64 b1: f64 b2: f64 eps: f64 c1: f64 c2: f64 p: (t/Tensor a) g: (t/Tensor a) m: (t/Tensor a) v: (t/Tensor a))
  -> (Vec (t/Tensor a))
  (t/adam-step lr b1 b2 eps c1 c2 p g m v))

;; Adam (Kingma and Ba) with bias correction folded into the step size and the denominator
(defun adam-step (lr: f64 b1: f64 b2: f64 eps: f64 st: (AdamState a) params: (Vec (t/Tensor a)) grads: (Vec (t/Tensor a))) -> (Stepped a)
  (let [n (+ (. st steps) 1) c1 (- 1.0 (ipow b1 n)) c2 (- 1.0 (ipow b2 n))
        rs (vec (map-indexed (fn (i p) (adam-one lr b1 b2 eps c1 c2 p (nth grads i) (nth (. st m) i) (nth (. st v) i))) params))]
    (Stepped (mapv (fn (r) (nth r 0)) rs) (AdamState (mapv (fn (r) (nth r 1)) rs) (mapv (fn (r) (nth r 2)) rs) n))))
