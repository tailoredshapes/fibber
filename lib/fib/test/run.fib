;; fib.test.run: the runner and the reporters of fib.test (docs/design/test-harness.md §4, §5). `run-main` takes the suites of a spec
;; file and the command line (`--only SUBSTR`, `--seed N`, `-j N`, `--format plain|json`, `--list`, `--no-isolate`, `--timeout SECS`)
;; and returns the exit status: 0 every scenario held, 1 one did not, 2 the command line or a selection that matches nothing.
;;
;; ISOLATION. A failed `expect` is a value (`Broke`) and never stops anything. A trap is the scenario's own, and there are two ways to keep it
;; from ending the run (`--isolate`):
;;   task (the default)  each scenario runs in a task (`spawn`) and `try-join` returns its trap, so a trap is a row, not the end. No process,
;;                       no files; a trap's message is the row's. What it cannot survive: a hang (nothing kills a thread), a stack that is
;;                       exhausted or memory that runs out (fatal for the process), a scenario that corrupts shared state.
;;   fork                each scenario runs in a child made by `fib.os.process/fork-start` (no exec: the scenario closure is simply called),
;;                       whose result, standard output and error come back in files; `--timeout SECS` (which selects fork) kills a hang
;;                       (status 142, reported `TIME`); a crash is the child's, so it is a row. Costs a process per scenario (docs/design/
;;                       test-harness.md 5.5) and is refused once this process has other threads (`fork-start`).
;;   none                everything in this thread; the first trap ends the run.
(ns fib.test.run
  (:use fib.core fib.seq fib.coll fib.print fib.test.core fib.test.gen)
  (:require [fib.os :as os] [fib.async :as as] [fib.string :as s]))

;; ---- what crosses the process boundary: one line per step, fields apart by a tab, `\`, tab and newline escaped ----------------------

(defun esc-char :private (c: char) -> str
  (cond (= c \\) "\\\\"
        (= c \tab) "\\t"
        (= c \newline) "\\n"
        :else (str c)))

(defun esc (s: str) -> str
  (reduce (fn (acc: str c: char) (str acc (esc-char c))) "" (s/chars s)))

(defun encode-step :private (s: StepRun) -> str
  (match (. s judged)
    ((Held) (str (esc (. s kind)) "\t" (esc (. s text)) "\tH\t\t\t" (esc (. s at)) "\n"))
    ((Broke e a) (str (esc (. s kind)) "\t" (esc (. s text)) "\tB\t" (esc e) "\t" (esc a) "\t" (esc (. s at)) "\n"))))

(defun encode (steps: (Vec StepRun)) -> str
  (str-join (mapv encode-step steps)))

;; The fields of every line of `text`: a tab ends a field, a newline a line, `\` followed by t, n or `\` is that character.
(defstruct WireCut (lines: (Vec (Vec str)) fields: (Vec str) cur: str esc: bool))

(defun cut-step :private (k: WireCut c: char) -> WireCut
  (cond (. k esc) (WireCut (. k lines) (. k fields) (str (. k cur) (cond (= c \t) "\t" (= c \n) "\n" :else (str c))) false)
        (= c \\) (WireCut (. k lines) (. k fields) (. k cur) true)
        (= c \tab) (WireCut (. k lines) (conj (. k fields) (. k cur)) "" false)
        (= c \newline) (WireCut (conj (. k lines) (conj (. k fields) (. k cur))) [] "" false)
        :else (WireCut (. k lines) (. k fields) (str (. k cur) c) false)))

(defun decode (text: str) -> (Vec StepRun)
  (mapv (fn (f: (Vec str))
          (StepRun (nth f 0) (nth f 1) (if (= (nth f 2) "H") Held (Broke (nth f 3) (nth f 4))) (nth f 5)))
        (. (reduce cut-step (WireCut [] [] "" false) (s/chars text)) lines)))

;; ---- one scenario, isolated -------------------------------------------------------------------------------------------------------

;; The report row of one scenario: what a reporter needs, nothing it must recompute.
(defstruct ScenarioRow (head: str impl: str id: str text: str covers: (Vec str) plan: (Vec str) status: str steps: (Vec StepRun) message: str at: str))

(defun broken? :private (steps: (Vec StepRun)) -> bool
  (some? (first (filter (fn (s: StepRun) (match (. s judged) ((Held) false) ((Broke _ _) true))) steps))))

(defun thens? :private (steps: (Vec StepRun)) -> bool
  (some? (first (filter (fn (s: StepRun) (= (. s kind) "Then")) steps))))

;; The status of a row from the steps it ran. A scenario with no Then cannot fail, and is refused as a failure.
(defun judged-row :private (sc: Scenario head: str impl: str steps: (Vec StepRun)) -> ScenarioRow
  (cond (not (thens? steps)) (ScenarioRow head impl (. sc id) (. sc text) (. sc covers) (. sc steps) "fail" steps "no Then step: a scenario that cannot fail" (. sc at))
        (broken? steps) (ScenarioRow head impl (. sc id) (. sc text) (. sc covers) (. sc steps) "fail" steps "" (. sc at))
        :else (ScenarioRow head impl (. sc id) (. sc text) (. sc covers) (. sc steps) "pass" steps "" (. sc at))))

(defun failed-row :private (sc: Scenario head: str impl: str status: str message: str) -> ScenarioRow
  (ScenarioRow head impl (. sc id) (. sc text) (. sc covers) (. sc steps) status [] message (. sc at)))

(defun last-line :private (text: str) -> str
  (let ((ls (filter (fn (l: str) (not (= l ""))) (s/split-lines text))))
    (if (empty? ls) "" (nth (vec ls) (- (count (vec ls)) 1)))))

;; What a finished child came to.
(defun row-of-child :private (sc: Scenario head: str impl: str f: os/Forked) -> ScenarioRow
  (cond (. f timed-out) (failed-row sc head impl "timeout" "killed by the alarm: the scenario did not finish in time")
        (not (= (. f status) 0)) (failed-row sc head impl "trap" (str "exit " (. f status) ": " (last-line (. f err))))
        :else (match (. f result)
                (nil (failed-row sc head impl "trap" "the scenario process left no result"))
                ((some text) (judged-row sc head impl (decode text))))))

;; ---- the run ----------------------------------------------------------------------------------------------------------------------

;; `isolate` is "task", "fork" or "none"; `secs` is the fork child's alarm.
(defstruct SpecOpts (only: str seed: i64 jobs: i64 format: str list: bool isolate: str secs: i64))

(defstruct ScenarioJob (suite: Suite sc: Scenario seed: i64))

;; The id a row is selected and reported by: the scenario's own, the implementation in brackets after the contract's slug.
(defun full-id (s: Suite sc: Scenario) -> str
  (if (= (. s impl) "")
      (. sc id)
      (let ((h (str-len (slugify (. s head)))))
        (str (str-slice (. sc id) 0 h) "[" (. s impl) "]" (str-slice (. sc id) h (str-len (. sc id)))))))

(defun jobs-of :private (suites: (Vec Suite) o: SpecOpts) -> (Vec ScenarioJob)
  (vec (filter (fn (j: ScenarioJob) (s/includes? (. (. j sc) id) (. o only)))
               (mapcat (fn (s: Suite)
                         (mapv (fn (sc: Scenario) (ScenarioJob s (Scenario (full-id s sc) (. sc text) (. sc covers) (. sc steps) (. sc run) (. sc at)) (stream-seed (. o seed) (hash (. sc id))))) (. s scenarios)))
                       suites))))

(defun run-here :private (j: ScenarioJob) -> ScenarioRow
  (judged-row (. j sc) (. (. j suite) head) (. (. j suite) impl) ((. (. j sc) run) (. j seed))))

;; ---- task isolation: a scenario in a task, its trap returned by `try-join` ----------------------------------------------------------

;; The row of a joined task: the steps it returned, or the trap that ended it.
(defun row-of-task :private (j: ScenarioJob r: (Result (Vec StepRun) as/Trap)) -> ScenarioRow
  (match r
    ((Ok steps) (judged-row (. j sc) (. (. j suite) head) (. (. j suite) impl) steps))
    ((Err trap) (failed-row (. j sc) (. (. j suite) head) (. (. j suite) impl) "trap" (str "trap: " (. trap message))))))

;; `jobs` scenarios at a time, each in a task; the rows in order.
(defun run-tasks (js: (Vec ScenarioJob) jobs: i64) -> (Vec ScenarioRow)
  (loop ((rest js) (rows []))
    (if (empty? rest)
        rows
        (let ((batch (vec (take jobs rest)))
              (tasks (mapv (fn (j: ScenarioJob) (let ((run (. (. j sc) run)) (seed (. j seed))) (spawn (fn () (run seed))))) batch)))
          (recur (vec (drop jobs rest))
                 (into rows (mapv (fn (i: i64) (row-of-task (nth batch i) (as/try-join (nth tasks i)))) (range (count batch)))))))))

;; ---- fork isolation: a scenario in a child process (fib.os.process/fork-start) -----------------------------------------------------

;; The result of a scenario written for the parent: the steps, one line each.
(defun child-result (sc: Scenario seed: i64) -> str
  (encode ((. sc run) seed)))

;; Rows of all jobs in order, `jobs` children at a time. A child's files are `tmp/N.res|out|err`.
(defun run-forked (js: (Vec ScenarioJob) tmp: str jobs: i64 secs: i64) -> (Vec ScenarioRow)
  (let ((rows (loop ((next 0) (running {}) (done {}))
                (cond (and (< next (count js)) (< (count running) jobs))
                        (let ((j (nth js next))
                              (sc (. j sc))
                              (seed (. j seed)))
                          (match (os/fork-start tmp (str next) secs (fn () (child-result sc seed)))
                            ((Err e) (recur (+ next 1) running (assoc done next (failed-row sc (. (. j suite) head) (. (. j suite) impl) "trap" (str "fork failed: " (. e message))))))
                            ((Ok c) (recur (+ next 1) (assoc running (. c pid) (Pair next c)) done))))
                      (empty? running) done
                      :else (let ((e (os/wait-any-child)))
                              (match (get running (. e pid))
                                (nil (recur next (if (< (. e pid) 0) {} running) done))
                                ((some p)
                                 (let ((j (nth js (. p fst))))
                                   (recur next (dissoc running (. e pid))
                                          (assoc done (. p fst) (row-of-child (. j sc) (. (. j suite) head) (. (. j suite) impl)
                                                                              (os/fork-collect (. p snd) (. e status))))))))))))
        (lost (fn (i: i64) (failed-row (. (nth js i) sc) (. (. (nth js i) suite) head) (. (. (nth js i) suite) impl) "trap" "its process was lost"))))
    (mapv (fn (i: i64) (unwrap-or (get rows i) (lost i))) (range (count js)))))

;; ---- reporters --------------------------------------------------------------------------------------------------------------------

(defun pad :private (s: str w: i64) -> str
  (loop ((o s)) (if (< (str-len o) w) (recur (str o " ")) o)))

(defun mark :private (status: str) -> str
  (cond (= status "pass") "pass"
        (= status "fail") "FAIL"
        (= status "trap") "TRAP"
        :else "TIME"))

(defun label (r: ScenarioRow) -> str
  (if (= (. r impl) "") (. r head) (str (. r head) "[" (. r impl) "]")))

(defun step-lines :private (r: ScenarioRow) -> str
  (str-join (mapv (fn (s: StepRun)
                    (match (. s judged)
                      ((Held) (str "        " (. s text) "\n"))
                      ((Broke e a) (str "      > " (. s text) "\n          expected: " e "\n          actual:   " a "\n"
                                         (if (= (. s at) "") "" (str "          at " (. s at) "\n"))))))
                  (. r steps))))

(defun row-plain :private (r: ScenarioRow) -> str
  (str (pad (mark (. r status)) 6) (. r text) "\n"
       (if (= (. r status) "pass") "" (str (step-lines r) (if (= (. r message) "") "" (str "        " (. r message) "\n"))
                                           "        id " (. r id) (if (= (. r at) "") "" (str "  (" (. r at) ")")) "\n"))))

(defun count-of (rows: (Vec ScenarioRow) status: str) -> i64
  (count (filter (fn (r: ScenarioRow) (= (. r status) status)) rows)))

(defun plain (rows: (Vec ScenarioRow) seed: i64) -> str
  (let ((groups (vec (distinct (mapv (fn (r: ScenarioRow) (label r)) rows)))))
    (str (str-join (mapv (fn (g: str)
                           (str g "\n" (str-join (mapv (fn (r: ScenarioRow) (str "  " (row-plain r))) (filter (fn (r: ScenarioRow) (= (label r) g)) rows)))))
                         groups))
         "\n" (count rows) " scenarios: " (count-of rows "pass") " pass, " (count-of rows "fail") " fail, " (count-of rows "trap") " trap, "
         (count-of rows "timeout") " timeout (seed " seed ")\n"
         (str-join (mapv (fn (r: ScenarioRow) (str "replay: --only '" (. r id) "' --seed " seed "\n"))
                         (filter (fn (r: ScenarioRow) (not (= (. r status) "pass"))) rows))))))

(defun json-char :private (c: char) -> str
  (cond (= c \") "\\\""
        (= c \\) "\\\\"
        (= c \newline) "\\n"
        (= c \tab) "\\t"
        (< (char->i32 c) 32i32) " "
        :else (str c)))

(defun js (s: str) -> str
  (str "\"" (reduce (fn (acc: str c: char) (str acc (json-char c))) "" (s/chars s)) "\""))

(defun js-list :private (xs: (Vec str)) -> str
  (str "[" (str-join (vec (interpose "," (mapv js xs)))) "]"))

(defun step-json :private (s: StepRun) -> str
  (match (. s judged)
    ((Held) (str "{\"kind\":" (js (. s kind)) ",\"text\":" (js (. s text)) ",\"status\":\"held\",\"at\":" (js (. s at)) "}"))
    ((Broke e a) (str "{\"kind\":" (js (. s kind)) ",\"text\":" (js (. s text)) ",\"status\":\"broke\",\"expected\":" (js e) ",\"actual\":" (js a) ",\"at\":" (js (. s at)) "}"))))

(defun row-json :private (r: ScenarioRow) -> str
  (str "{\"suite\":" (js (. r head)) ",\"impl\":" (js (. r impl)) ",\"id\":" (js (. r id)) ",\"text\":" (js (. r text))
       ",\"covers\":" (js-list (. r covers)) ",\"status\":" (js (. r status)) ",\"message\":" (js (. r message)) ",\"at\":" (js (. r at))
       ",\"steps\":[" (str-join (vec (interpose "," (mapv step-json (. r steps))))) "]}"))

;; The run as one JSON document; the schema is in the design, §5.
(defun json (rows: (Vec ScenarioRow) seed: i64) -> str
  (str "{\"schema\":1,\"seed\":" seed ",\"summary\":{\"total\":" (count rows) ",\"pass\":" (count-of rows "pass") ",\"fail\":" (count-of rows "fail")
       ",\"trap\":" (count-of rows "trap") ",\"timeout\":" (count-of rows "timeout") "},\"results\":["
       (str-join (vec (interpose "," (mapv row-json rows)))) "]}\n"))

(defun list-plain :private (js: (Vec ScenarioJob)) -> str
  (str-join (mapv (fn (j: ScenarioJob) (str (. (. j sc) id) "\n" (str-join (mapv (fn (l: str) (str "    " l "\n")) (. (. j sc) steps))))) js)))

;; ---- TAP: one `ok`/`not ok` line per scenario, a `#` line for what broke ------------------------------------------------------------

(defun tap-diag :private (r: ScenarioRow) -> str
  (str-join (mapv (fn (s: StepRun)
                    (match (. s judged)
                      ((Held) "")
                      ((Broke e a) (str "# " (. s text) ": expected " e ", actual " a "\n"))))
                  (. r steps))))

(defun tap-row :private (r: ScenarioRow n: i64) -> str
  (str (if (= (. r status) "pass") "ok " "not ok ") n " - " (. r id)
       (if (= (. r status) "pass") "" (str " # " (. r status) (if (= (. r message) "") "" (str ": " (. r message)))))
       "\n" (tap-diag r)))

;; TAP version 13: the plan first, a `# seed` line so a failure is replayable from the log.
(defun tap (rows: (Vec ScenarioRow) seed: i64) -> str
  (str "TAP version 13\n1.." (count rows) "\n# seed " seed "\n"
       (str-join (mapv (fn (i: i64) (tap-row (nth rows i) (+ i 1))) (range (count rows))))))

;; ---- the command line ---------------------------------------------------------------------------------------------------------------

(defun flag-with-value? :private (a: str) -> bool
  (some? (first (filter (fn (f: str) (= f a)) ["--only" "--seed" "-j" "--jobs" "--timeout" "--format" "--isolate"]))))

(defun canon-flag :private (a: str) -> str
  (cond (= a "-j") "jobs" (= a "--jobs") "jobs" :else (str-slice a 2 (str-len a))))

(defun int-flag :private (m: (Map str str) key: str default: i64) -> (Result i64 str)
  (match (get m key)
    (nil (Ok default))
    ((some v) (match (parse-long v) (nil (Err (str "--" key " wants an integer"))) ((some n) (Ok n))))))

(defun opts-of :private (m: (Map str str)) -> (Result SpecOpts str)
  (try-let ((seed (int-flag m "seed" 1))
            (jobs (int-flag m "jobs" 1))
            (secs (int-flag m "timeout" 60)))
    (let ((fmt (unwrap-or (get m "format") "plain"))
          (iso (unwrap-or (get m "isolate") (if (some? (get m "timeout")) "fork" "task"))))
      (cond (not (or (= fmt "plain") (or (= fmt "json") (= fmt "tap")))) (Err "--format is plain, tap or json")
            (not (or (= iso "task") (or (= iso "fork") (= iso "none")))) (Err "--isolate is task, fork or none")
            :else (Ok (SpecOpts (unwrap-or (get m "only") "") seed (max jobs 1) fmt (some? (get m "list")) iso secs))))))

(defun parse-args :private (as: (Vec str)) -> (Result SpecOpts str)
  (loop ((i 0) (m {}))
    (if (>= i (count as))
        (opts-of m)
        (let ((a (nth as i))
              (v (if (< (+ i 1) (count as)) (nth as (+ i 1)) "")))
          (cond (flag-with-value? a) (recur (+ i 2) (assoc m (canon-flag a) v))
                (= a "--list") (recur (+ i 1) (assoc m "list" "1"))
                (= a "--no-isolate") (recur (+ i 1) (assoc m "isolate" "none"))
                :else (Err (str "unknown argument " a)))))))

(defun report :private (rows: (Vec ScenarioRow) o: SpecOpts) -> i64
  (do (print (cond (= (. o format) "json") (json rows (. o seed))
                   (= (. o format) "tap") (tap rows (. o seed))
                   :else (plain rows (. o seed))))
      (if (= (count (filter (fn (r: ScenarioRow) (not (= (. r status) "pass"))) rows)) 0) 0 1)))

(defun run-forked-in :private (js: (Vec ScenarioJob) o: SpecOpts) -> i64
  (match (os/create-temp-directory (str (os/temp-directory) "/fibtest-XXXXXX"))
    ((Err _) (do (eprintln "fibc test: cannot make a scratch directory") 2))
    ((Ok tmp) (let ((rows (run-forked js tmp (. o jobs) (. o secs))))
                (do (os/remove-directory tmp)
                    (report rows o))))))

(defun run-jobs :private (js: (Vec ScenarioJob) o: SpecOpts) -> i64
  (cond (= (. o isolate) "none") (report (mapv run-here js) o)
        (= (. o isolate) "task") (report (run-tasks js (. o jobs)) o)
        :else (run-forked-in js o)))

;; The whole run of a spec file: its suites and the command line (`(args)`).
(defun run-main (suites: (Vec Suite)) -> i64
  (run-main-with suites (vec (args))))

;; The same with the command line given (a spec that is a case passes its own words).
(defun run-main-with (suites: (Vec Suite) argv: (Vec str)) -> i64
  (match (parse-args argv)
    ((Err m) (do (eprintln (str "fibc test: " m)) 2))
    ((Ok o)
     (let ((all (jobs-of suites (SpecOpts "" 1 1 "plain" false "none" 60)))
           (js (jobs-of suites o)))
       (cond (not (= (count (set (mapv (fn (j: ScenarioJob) (. (. j sc) id)) all))) (count all)))
               (do (eprintln "fibc test: two scenarios have the same id; give one an (id \"..\")") 2)
             (empty? js) (do (eprintln (str "fibc test: no scenario matches '" (. o only) "'; a run with nothing to run is not a pass")) 2)
             (. o list) (do (print (list-plain js)) 0)
             :else (run-jobs js o))))))
