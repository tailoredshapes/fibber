;; Shared test values and assertion logs; independent of the behaviour-spec macros.
(ns fib.test.data)

;; What one expectation came to: it held, or it did not, with both sides as text.
(defenum Judged
  (Held)
  (Broke expected: str actual: str))

;; One step as it ran: its kind (`Given`, `When`, `Then`), its text, what it came to (a Given and a When are Held) and where it is: "FILE:LINE:COL"
;; of its `expect` (`(call-pos)` of the macro), of the `scenario` or `prop` for a `then` item that is a plain boolean form, "" for a Given or When.
(defstruct StepRun (kind: str text: str judged: Judged at: str))

;; A scenario: `id` is stable (the slug of feature and text, or the `(id ..)` the author wrote), `covers` links it to spec rows, `steps`
;; is the plan (the text of each step), `run` takes the seed of the run and executes it, and `at` is "FILE:LINE:COL" of the `scenario` form.
(defstruct Scenario (id: str text: str covers: (Vec str) steps: (Vec str) run: (fn :send (i64) (Vec StepRun)) at: str))

;; A set of scenarios under one head: a feature (impl is "") or a contract run against one implementation.
(defstruct Suite (head: str impl: str scenarios: (Vec Scenario)))

(defstruct StepLog (log: (Cell (Vec StepRun))))

(defun new-rec () -> StepLog (StepLog (cell (vec-empty))))

(defun rec-steps (r: StepLog) -> (Vec StepRun) @(. r log))
