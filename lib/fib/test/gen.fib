;; fib.test.gen: generators with shrinking, and `prop` (docs/design/test-harness.md §3). A generator is a value of two functions: `make`
;; draws a value from a seeded generator and a size, `shrink` lists simpler values that might still fail, simplest first. The random
;; source is fib.rng's SplitMix64 (fibgen's too), so a seed means one stream in both.
;; A property runs `cases` values; the first failure is shrunk (greedily: the first candidate that still fails replaces the value) and
;; reported with the seed, so `--seed N --only ID` reproduces it exactly.
(ns fib.test.gen (:use fib.core fib.seq fib.coll fib.print fib.rng fib.test.core))

;; A number in 0..n (n > 0): the high bits, so no unsigned remainder is needed. (fib.rng's `rng-below` takes the low bits with an unsigned
;; remainder, as fibgen does; this one is what the replay seeds of fib.test reports have always meant, so it stays.)
(defun draw-below :private (r: Rng n: i64) -> i64
  (if (<= n 0) 0 (rem (shr (rng-next r) 1) n)))

;; A number in lo..=hi.
(defun rng-between (r: Rng lo: i64 hi: i64) -> i64
  (+ lo (draw-below r (+ (- hi lo) 1))))

;; The seed of stream `i` of a run: independent streams from one seed, the same whatever else runs.
(defun stream-seed (seed: i64 i: i64) -> i64
  (rng-next (rng-new (unchecked-add seed (unchecked-multiply (+ i 1) -7046029254386353131)))))

(defstruct (Gen a) (make: (fn :send (Rng i64) a) shrink: (fn :send (a) (Vec a))))

;; ---- the generators ---------------------------------------------------------------------------------------------------------

;; An integer between -4 size and 4 size; shrinks toward 0.
(defun shrink-i64 :private (n: i64) -> (Vec i64)
  (cond (= n 0) []
        (= n 1) [0]
        (= n -1) [0]
        :else (vec (distinct [0 (quot n 2) (if (> n 0) (- n 1) (+ n 1))]))))

(defun gen-i64 () -> (Gen i64)
  (Gen (fn (r: Rng size: i64) (rng-between r (* -4 size) (* 4 size))) shrink-i64))

(defun gen-i64-between (lo: i64 hi: i64) -> (Gen i64)
  (Gen (fn (r: Rng size: i64) (rng-between r lo hi))
       (fn (n: i64) (vec (filter (fn (m: i64) (and (>= m lo) (<= m hi))) (shrink-i64 n))))))

(defun gen-bool () -> (Gen bool)
  (Gen (fn (r: Rng size: i64) (= (draw-below r 2) 1)) (fn (b: bool) (if b [false] []))))

;; A vector of up to `size` elements; shrinks by dropping elements, then by shrinking one element.
(defun drop-at :private (v: (Vec a) i: i64) -> (Vec a)
  (vec (concat (take i v) (drop (+ i 1) v))))

(defun shrink-vec :private (g: (Gen a) v: (Vec a)) -> (Vec (Vec a))
  (let ((n (count v)))
    (into (into (into (if (> n 0) [[]] []) (if (> n 3) [(vec (take (quot n 2) v))] []))
                (mapv (fn (i: i64) (drop-at v i)) (range (min n 8))))
          (mapcat (fn (i: i64) (mapv (fn (x: a) (assoc v i x)) ((. g shrink) (nth v i)))) (range (min n 4))))))

(defun gen-vec (g: (Gen a)) -> (Gen (Vec a))
  (Gen (fn (r: Rng size: i64)
         (mapv (fn (i: i64) ((. g make) r size)) (range (draw-below r (+ size 1)))))
       (fn (v: (Vec a)) (shrink-vec g v))))

;; A lower-case ASCII string of up to `size` letters; shrinks by dropping characters.
(defun gen-str () -> (Gen str)
  (Gen (fn (r: Rng size: i64)
         (str-join (mapv (fn (i: i64) (let ((k (draw-below r 26))) (str-slice "abcdefghijklmnopqrstuvwxyz" k (+ k 1))))
                         (range (draw-below r (+ size 1))))))
       (fn (s: str) (if (= (str-len s) 0) [] [(str-slice s 1 (str-len s)) (str-slice s 0 (- (str-len s) 1))]))))

;; A pair of values: shrinks one side at a time.
(defun gen-pair (ga: (Gen a) gb: (Gen b)) -> (Gen (Pair a b))
  (Gen (fn (r: Rng size: i64) (Pair ((. ga make) r size) ((. gb make) r size)))
       (fn (p: (Pair a b))
         (vec (concat (mapv (fn (x: a) (Pair x (. p snd))) ((. ga shrink) (. p fst)))
                      (mapv (fn (y: b) (Pair (. p fst) y)) ((. gb shrink) (. p snd))))))))

;; ---- running a property -------------------------------------------------------------------------------------------------------

(def default-cases: i64 100)

;; The size of case i: it grows, so the first cases are small.
(defun case-size :private (i: i64) -> i64 (+ 1 (rem i 30)))

;; Shrinks `x`, which fails `holds`: the simplest value that still fails, and how many steps it took.
(defun shrink-failing (g: (Gen a) holds: (fn (a) bool) x: a) -> (Pair a i64)
  (loop ((cur x) (steps 0))
    (if (>= steps 500)
        (Pair cur steps)
        (match (first (filter (fn (c: a) (not (holds c))) ((. g shrink) cur)))
          (nil (Pair cur steps))
          ((some c) (recur c (+ steps 1)))))))

;; The first failing case of `n` cases of seed `seed`: its index and value; nil if every case held.
(defun first-failure (g: (Gen a) holds: (fn (a) bool) seed: i64 n: i64) -> (Option (Pair i64 a))
  (loop ((i 0))
    (if (>= i n)
        nil
        (let ((x ((. g make) (rng-new (stream-seed seed i)) (case-size i))))
          (if (holds x) (recur (+ i 1)) (some (Pair i x)))))))

;; The report of a property over `n` cases. `shw` turns a value into the text of the report: `pr-str` for `prop` (the type needs a Debug instance, which
;; `(derive Debug T)` gives a struct that is not recursive), a function of the author's for `prop-show` (a type with no Debug instance: the helper
;; of package LIB-2 item 5c).
(defun run-prop-with (g: (Gen a) holds: (fn (a) bool) seed: i64 n: i64 at: str shw: (fn (a) str)) -> (Vec StepRun)
  (match (first-failure g holds seed n)
    (nil [(StepRun "Then" (str "For all x, " n " cases") Held at)])
    ((some f)
     (let ((small (shrink-failing g holds (. f snd))))
       [(StepRun "Then" (str "For all x, " n " cases")
                 (Broke "the property to hold"
                        (str "it fails for x = " (shw (. small fst)) " (case " (. f fst) " drew " (shw (. f snd)) ", shrunk in " (. small snd)
                             " steps)"))
                 at)]))))

(defun run-prop (g: (Gen a) holds: (fn (a) bool) seed: i64 n: i64 at: str) -> (Vec StepRun)
  (run-prop-with g holds seed n at (fn (x: a) (pr-str x))))

;; A property as a scenario, so it is listed, selected, isolated and reported like any other.
(defun prop-scenario (text: str plan: str at: str g: (Gen a) holds: (fn (a) bool)) -> Scenario
  (Scenario (slugify text) text [] [(str "For all x in the generator: " plan)]
            (fn (seed: i64) (run-prop g holds seed default-cases at)) at))

(defun prop-scenario-with (text: str plan: str at: str g: (Gen a) holds: (fn (a) bool) shw: (fn (a) str)) -> Scenario
  (Scenario (slugify text) text [] [(str "For all x in the generator: " plan)]
            (fn (seed: i64) (run-prop-with g holds seed default-cases at shw)) at))

;; (prop "text" [x generator] body ..): body is a boolean form over x. (prop "text" [x gx y gy ..] body ..): one case draws every name; the
;; names are bound in the body, the failing tuple is shrunk component by component and printed as nested pairs [x [y z]].
(defmacro prop (text binding ... body)
  (match binding
    ((Vec bs)
     (let ((k (quot (vec-count bs) 2))
           (p (gensym "p")))
       (if (or (= k 0) (!= (vec-count bs) (* k 2)))
           (trap "prop: the binding is [x generator] or [x gx y gy ..]")
           (let ((gen (loop ((i (- k 2)) (g (vec-nth bs (- (* k 2) 1))))
                        (if (>= i 0) (recur (- i 1) `(gen-pair ~(vec-nth bs (+ (* i 2) 1)) ~g)) g)))
                 (lets (loop ((i 0) (acc (vec-empty)) (path p))
                         (if (< i k)
                             (if (= i (- k 1))
                                 (vec-conj (vec-conj acc (vec-nth bs (* i 2))) path)
                                 (recur (+ i 1) (vec-conj (vec-conj acc (vec-nth bs (* i 2))) `(. ~path fst)) `(. ~path snd)))
                             acc))))
             (if (= k 1)
                 `[(fib.test.gen/prop-scenario ~text (fib.test.core/form-text (quote (do ~@body))) (call-pos) ~gen
                                              (fn (~(vec-nth bs 0)) (do ~@body)))]
                 `[(fib.test.gen/prop-scenario ~text (fib.test.core/form-text (quote (do ~@body))) (call-pos) ~gen
                                              (fn (~p) (let ~(Vec lets) (do ~@body))))])))))
    (_ (trap "prop: the binding is [x generator] or [x gx y gy ..]"))))

;; (prop-show "text" shower [x generator ..] body ..): `prop` for values with no Debug instance: `shower` is a function from the value of the
;; generator (the nested pairs of several names) to the text the report prints.
(defmacro prop-show (text shower binding ... body)
  (match binding
    ((Vec bs)
     (let ((k (quot (vec-count bs) 2))
           (p (gensym "p")))
       (if (or (= k 0) (!= (vec-count bs) (* k 2)))
           (trap "prop-show: the binding is [x generator] or [x gx y gy ..]")
           (let ((gen (loop ((i (- k 2)) (g (vec-nth bs (- (* k 2) 1))))
                        (if (>= i 0) (recur (- i 1) `(gen-pair ~(vec-nth bs (+ (* i 2) 1)) ~g)) g)))
                 (lets (loop ((i 0) (acc (vec-empty)) (path p))
                         (if (< i k)
                             (if (= i (- k 1))
                                 (vec-conj (vec-conj acc (vec-nth bs (* i 2))) path)
                                 (recur (+ i 1) (vec-conj (vec-conj acc (vec-nth bs (* i 2))) `(. ~path fst)) `(. ~path snd)))
                             acc))))
             (if (= k 1)
                 `[(fib.test.gen/prop-scenario-with ~text (fib.test.core/form-text (quote (do ~@body))) (call-pos) ~gen
                                                   (fn (~(vec-nth bs 0)) (do ~@body)) ~shower)]
                 `[(fib.test.gen/prop-scenario-with ~text (fib.test.core/form-text (quote (do ~@body))) (call-pos) ~gen
                                                   (fn (~p) (let ~(Vec lets) (do ~@body))) ~shower)])))))
    (_ (trap "prop-show: the binding is [x generator] or [x gx y gy ..]"))))
