;; fib.db: database access in next.jdbc's shape over JDBC-like protocols (docs/design/observability-and-databases.md 4). Explicit:
;; `(:require [fib.db :as db])` then `db/execute!` (a `:use` works too): the macros' templates name this library's functions bare, and
;; a template resolves in the module that defines the macro (syntax §3.16 "Names in a template").
;;
;;   (match (open-sqlite ":memory:") ((Ok conn) ..) ((Err e) ..))           ; a driver's open: fib.db.sqlite
;;   (execute! conn ["select * from t where id = ?" id])                     ; (Result (Vec (Map str Datum)) DbError)
;;   (execute-one! conn ["select name from t where id = ?" id])              ; (Result (Option (Map str Datum)) DbError)
;;   (execute! conn q)                                                        ; q a Query: what fib.sql/format returns
;;   (with-transaction [tx conn] (try-let [_ (execute! tx [..]) ..] (Ok v)))  ; COMMIT on Ok, ROLLBACK on Err
;;
;; The parameters of a literal vector are converted with `->datum` (i64 f64 bool str keyword Datum), so `["... ?" 1 "x"]` reads as in
;; Clojure although fibber's vectors are homogeneous: the macro builds `(Query "..." [(->datum 1) (->datum "x")])`. Values are always
;; bound, never spliced into the text.
(ns fib.db (:export-from fib.datum fib.db.core fib.db.sqlite))

(defmacro execute! (conn q)
  (match q
    ((Vec items)
     `(execute-query ~conn
        (Query ~(vec-nth items 0)
          [~@(loop ((i 1) (out (vec-empty)))
               (if (< i (vec-count items)) (recur (+ i 1) (vec-conj out `(->datum ~(vec-nth items i)))) out))])))
    (_ `(execute-query ~conn ~q))))

(defmacro execute-one! (conn q)
  (match q
    ((Vec items)
     `(execute-one-query ~conn
        (Query ~(vec-nth items 0)
          [~@(loop ((i 1) (out (vec-empty)))
               (if (< i (vec-count items)) (recur (+ i 1) (vec-conj out `(->datum ~(vec-nth items i)))) out))])))
    (_ `(execute-one-query ~conn ~q))))

;; (with-transaction [tx conn] body ..): the body sees the connection as `tx` and returns a Result; Ok commits, Err rolls back.
(defmacro with-transaction (spec ... body)
  (match spec
    ((Vec items) `(transact ~(vec-nth items 1) (fn (~(vec-nth items 0)) (do ~@body))))
    (_ (trap "with-transaction: the spec is [tx conn]"))))
