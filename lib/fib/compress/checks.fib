;; fib.compress.checks: the helpers of the codec contract (fib.compress.contract): each takes a codec and returns the NAMES of the inputs it failed on (an empty vector is a pass),
;; so a failing scenario says which sample and which option set. Generic over the codec (`:where ((Codec c))`): a driver's value, or a `Faulty` over one.
(ns fib.compress.checks (:use fib.core fib.seq fib.coll fib.rng fib.compress.types fib.compress.ops fib.compress.corpus))

(defun same? (a: (Array i8) b: (Array i8)) -> bool
  (and (= (array-len a) (array-len b))
       (loop [i 0] (cond (>= i (array-len a)) true (= (array-get a i) (array-get b i)) (recur (+ i 1)) :else false))))

(defun kind-of (r: (Result (Array i8) CompressError)) -> str (match r ((Ok _) "ok") ((Err e) (str (. e kind)))))
(defun is-bytes? (r: (Result (Array i8) CompressError) want: (Array i8)) -> bool (match r ((Ok b) (same? b want)) ((Err _) false)))
(defun is-kind? (r: (Result (Array i8) CompressError) k: keyword) -> bool (match r ((Ok _) false) ((Err e) (= (. e kind) k))))
(defun failed? (r: (Result (Array i8) CompressError)) -> bool (match r ((Ok _) false) ((Err _) true)))

(defun failing (xs: (Vec x) name: (fn (x) str) ok: (fn (x) bool)) -> (Vec str)
  (vec (map name (filter (fn (x: x) (not (ok x))) xs))))

(defun sname (s: Sample) -> str (. s name))

;; ---- option sets a codec claims
(defstruct OptSet (name: str opts: Options))

(defun option-sets (c: c) -> (Vec OptSet) :where ((Codec c))
  (let [d (default-options)
        has (fn (k: keyword) (supports? c k))
        parts [[(OptSet "default" d)]
               (if (has :checksum) [(OptSet "checksum" (with-checksum d true)) (OptSet "no-checksum" (with-checksum d false))] [])
               (if (has :levels) [(OptSet "level-1" (with-level d 1)) (OptSet "level-3" (with-level d 3)) (OptSet "level-9" (with-level d 9))] [])
               (if (has :block-size) [(OptSet "block-65536" (with-block-size d 65536)) (OptSet "block-262144" (with-block-size d 262144))] [])
               (if (has :linked-blocks) [(OptSet "linked" (with-independent d false)) (OptSet "independent" (with-independent d true))] [])
               (if (has :content-size) [(OptSet "content-size" (with-record-size d true))] [])
               (if (and (has :checksum) (has :frame)) [(OptSet "block-checksum" (with-block-checksum (with-checksum d true) true))] [])]]
    (reduce (fn (a: (Vec OptSet) b: (Vec OptSet)) (into a b)) [] parts)))

(defun round-trip? (c: c o: Options s: Sample) -> bool :where ((Codec c))
  (match (compress c (. s data) o)
    ((Err _) false)
    ((Ok z) (is-bytes? (decompress c z o) (. s data)))))

(defun round-trips (c: c os: (Vec OptSet) samples: (Vec Sample)) -> (Vec str) :where ((Codec c))
  (vec (mapcat (fn (o: OptSet) (failing samples (fn (s: Sample) (str (. o name) " " (sname s))) (fn (s: Sample) (round-trip? c (. o opts) s)))) os)))

(defun compressed (c: c s: Sample) -> (Array i8) :where ((Codec c))
  (match (compress c (. s data) (default-options)) ((Ok z) z) ((Err _) (array 0 0i8))))

;; ---- determinism, bound
(defun deterministic? (c: c s: Sample) -> bool :where ((Codec c))
  (match (compress c (. s data) (default-options))
    ((Ok a) (match (compress c (. s data) (default-options)) ((Ok b) (same? a b)) ((Err _) false)))
    ((Err _) false)))

(defun within-bound? (c: c s: Sample) -> bool :where ((Codec c))
  (let [z (compressed c s)] (and (> (array-len z) 0) (<= (array-len z) (max-compressed-size c (array-len (. s data)))))))

;; ---- max-output: the limit exactly: the size succeeds, one under is :too-large (one-shot and streaming), a limit of 0 only for empty data
(defun max-exact? (c: c s: Sample) -> bool :where ((Codec c))
  (let [n (array-len (. s data)) z (compressed c s) o (default-options)
        stream-limit (fn (m: i64) (decompress-chunks c (with-max-output o m) (split-sizes z [3000])))]
    (and (is-bytes? (decompress c z (with-max-output o n)) (. s data))
         (is-bytes? (stream-limit n) (. s data))
         (or (= n 0) (and (is-kind? (decompress c z (with-max-output o (- n 1))) :too-large) (is-kind? (stream-limit (- n 1)) :too-large))))))

;; ---- truncation: every proper prefix of a frame is an error, one-shot and streamed; an error, never a partial success
(defun prefix-failures (c: c s: Sample) -> (Vec str) :where ((Codec c))
  (let [z (compressed c s)]
    (vec (filter (fn (x: str) (not (= x "")))
                 (map (fn (k: i64) (let [p (array-copy z 0 k)]
                                     (if (and (failed? (decompress c p (default-options))) (failed? (decompress-chunks c (default-options) [p]))) ""
                                       (str (sname s) " prefix " k))))
                      (range 0 (array-len z)))))))

;; ---- corruption: no trap; with a checksum an Ok result is the original; without, an Ok result is within the limit
(defun flip (z: (Array i8) i: i64 mask: i64) -> (Array i8)
  (let [c (cell (array-copy z 0 (array-len z)))]
    (do (array-set! &c i (bit-xor (array-get z i) (trunc i8 mask))) @c)))

(defun corrupt-failures (c: c s: Sample checked: bool) -> (Vec str) :where ((Codec c))
  (let [o (with-max-output (with-checksum (default-options) true) 1048576)
        z (match (compress c (. s data) o) ((Ok b) b) ((Err _) (array 0 0i8)))]
    (vec (filter (fn (x: str) (not (= x "")))
                 (mapcat (fn (i: i64)
                           (map (fn (mask: i64)
                                  (let [r (decompress c (flip z i mask) o)]
                                    (match r ((Err _) "")
                                      ((Ok b) (if (or (and checked (not (same? b (. s data)))) (> (array-len b) 1048576)) (str (sname s) " byte " i " mask " mask) "")))))
                                [1 128 255]))
                         (range 0 (array-len z)))))))

;; ---- concatenated frames: a then b decompresses to a ++ b
(defun concat2 (a: (Array i8) b: (Array i8)) -> (Array i8) (concat-bytes [a b]))

(defun concat-ok? (c: c a: Sample b: Sample) -> bool :where ((Codec c))
  (let [z (concat2 (compressed c a) (compressed c b))
        want (concat2 (. a data) (. b data))]
    (and (is-bytes? (decompress c z (default-options)) want)
         (is-bytes? (decompress-chunks c (default-options) (split-sizes z [5 1000])) want))))

;; ---- streaming equals one-shot, for chunkings of 1, of 7, and a seeded run of mixed sizes
(defun chunkings (seed: i64) -> (Vec (Vec i64))
  (let [r (rng-new seed)] [[1] [7] [4096] [65537] (vec (map (fn (k: i64) (+ 1 (rng-below r 5000))) (range 0 40)))]))

(defun stream-ok? (c: c s: Sample sizes: (Vec i64)) -> bool :where ((Codec c))
  (let [z (compressed c s) o (default-options)
        piece (split-sizes (. s data) sizes)]
    (and (is-bytes? (decompress-chunks c o (split-sizes z sizes)) (. s data))
         (match (compress-chunks c o piece) ((Ok zz) (is-bytes? (decompress c zz o) (. s data))) ((Err _) false)))))

(defun stream-failures (c: c samples: (Vec Sample)) -> (Vec str) :where ((Codec c))
  (vec (mapcat (fn (s: Sample)
                 (vec (mapcat (fn (sizes: (Vec i64))
                                (if (and (= (nth sizes 0) 1) (> (array-len (. s data)) 20000)) []
                                  (if (stream-ok? c s sizes) [] [(str (sname s) " chunks " (nth sizes 0))])))
                              (chunkings (array-len (. s data))))))
               samples)))

;; ---- the decompressor's per-call output stays within `step-bound`, whatever the input (a single chunk holding a whole stream)
(def step-bound: i64 4194304)

(defun pull-all (k: k step: DecStep sizes: (Vec i64) total: i64) -> i64 :where ((Decompressor k))
  (let [big (if (> (array-len (. step output)) step-bound) 1 0) t (+ total (array-len (. step output)))]
    (if (. step needs-input) (+ (* big 1000000000000) t)
      (match (decompressor-feed k (array 0 0i8))
        ((Err _) -1)
        ((Ok more) (+ (pull-all k more sizes t) (* big 1000000000000)))))))

(defun bounded-steps? (c: c s: Sample) -> bool :where ((Codec c))
  (let [z (compressed c s)]
    (match (codec-decompressor c (default-options))
      ((Err _) false)
      ((Ok k) (match (decompressor-feed k z) ((Err _) false) ((Ok st) (= (pull-all k st [] 0) (array-len (. s data)))))))))

(defun cat (xs: (Vec (Vec str))) -> (Vec str) (reduce (fn (a: (Vec str) b: (Vec str)) (into a b)) [] xs))

;; The corpus sample with this name ("text 4096", "zeros 1000000"); an empty sample when there is none (the scenario using it then fails).
(defun find-sample (name: str) -> Sample
  (match (first (filter (fn (s: Sample) (= (. s name) name)) (corpus))) ((some s) s) (nil (Sample name (array 0 0i8)))))

;; ---- THREADS: the result does not depend on the thread count (docs/design/compress.md 9)
(defun thread-counts () -> (Vec i64) [2 3 7 16])

;; Block sizes of 64 KiB (when the codec has them) make a 100 to 300 KB sample a few blocks, so a parallel codec has jobs to share.
(defun par-options (c: c) -> Options :where ((Codec c))
  (let [d (default-options)] (if (supports? c :block-size) (with-block-size d 65536) d)))

(defun par-samples () -> (Vec Sample) [(find-sample "text 262145") (find-sample "records 100000") (find-sample "run-noise 200000") (find-sample "zeros 300000") (find-sample "random 65537")])

(defun thread-sample-failures (c: c s: Sample) -> (Vec str) :where ((Codec c))
  (let [o (par-options c) z1 (match (compress c (. s data) (with-threads o 1)) ((Ok b) b) ((Err _) (array 0 0i8)))]
    (vec (mapcat (fn (t: i64)
                   (cat [(match (compress c (. s data) (with-threads o t)) ((Ok zt) (if (same? zt z1) [] [(str (sname s) " compress with " t " threads differs")])) ((Err _) [(str (sname s) " compress failed with " t)]))
                         (if (is-bytes? (decompress c z1 (with-threads o t)) (. s data)) [] [(str (sname s) " decompress with " t " threads differs")])]))
                 (thread-counts)))))

;; Streams: the same bytes for every thread count (compressed in chunks of 50000 and 7 bytes), and the decoder in chunks of 30000 gives the input.
(defun stream-thread-failures (c: c) -> (Vec str) :where ((Codec c))
  (let [s (find-sample "text 262145") o (par-options c)
        run (fn (t: i64 sizes: (Vec i64)) (compress-chunks c (with-threads o t) (split-sizes (. s data) sizes)))
        base (fn (sizes: (Vec i64)) (ok-of (run 1 sizes)))]
    (vec (mapcat (fn (t: i64)
                   (cat [(if (same? (ok-of (run t [50000])) (base [50000])) [] [(str "stream compress (50000 chunks) differs with " t " threads")])
                         (if (same? (ok-of (run t [7000 131 77777])) (base [7000 131 77777])) [] [(str "stream compress (mixed chunks) differs with " t " threads")])
                         (if (is-bytes? (decompress-chunks c (with-threads o t) (split-sizes (base [50000]) [30000])) (. s data)) [] [(str "stream decompress differs with " t " threads")])]))
                 (thread-counts)))))
(defun ok-of (r: (Result (Array i8) CompressError)) -> (Array i8) (match r ((Ok b) b) ((Err _) (array 0 0i8))))

(defun thread-failures (c: c) -> (Vec str) :where ((Codec c))
  (into (vec (mapcat (fn (s: Sample) (thread-sample-failures c s)) (par-samples))) (if (supports? c :streaming) (stream-thread-failures c) [])))

;; The same error kind and the same exact limit for every thread count, on a frame cut, corrupted in the middle, and at its limit.
(defun kinds-over-threads (c: c z: (Array i8) o: Options) -> (Vec str) :where ((Codec c))
  (vec (map (fn (t: i64) (kind-of (decompress c z (with-threads o t)))) (into [1] (thread-counts)))))

(defun error-thread-failures (c: c) -> (Vec str) :where ((Codec c))
  (let [s (find-sample "text 262145") o (with-max-output (with-checksum (par-options c) true) 10000000)
        z (match (compress c (. s data) (with-threads o 1)) ((Ok b) b) ((Err _) (array 0 0i8)))
        mid (flip z (quot (array-len z) 2) 255) late (flip z (- (array-len z) 9) 1) cut (array-copy z 0 (quot (* 3 (array-len z)) 4))
        n (array-len (. s data))
        same-all? (fn (zz: (Array i8)) (let [ks (kinds-over-threads c zz o)] (every? (fn (k: str) (= k (nth ks 0))) ks)))
        lim (fn (m: i64) (kinds-over-threads c z (with-max-output o m)))]
    (cat [(if (same-all? mid) [] ["a corrupt block in the middle: the error kind depends on the threads"])
          (if (= (nth (kinds-over-threads c mid o) 0) "ok") ["the corrupt frame was accepted"] [])
          (if (same-all? late) [] ["a corrupt tail: the error kind depends on the threads"])
          (if (same-all? cut) [] ["a cut frame: the error kind depends on the threads"])
          (if (every? (fn (k: str) (= k "ok")) (lim n)) [] ["max-output at the exact size fails under some thread count"])
          (if (every? (fn (k: str) (= k ":too-large")) (lim (- n 1))) [] ["max-output one under is not too-large under every thread count"])])))

;; ---- VERIFY: `Options.verify` decides whether the checksums in the data are checked, and the same for every thread count (DARWIN-2: the sequential decoder ignored it)
;; A frame with a content checksum and block checksums (LZ4: ..block data, block checksum, end mark, content checksum): the last byte of the content checksum is the last
;; byte of the frame, the last byte of the last block's checksum is 9 bytes before the end. Flipping one of them leaves the data sound: with verify true the frame is a
;; `checksum` error, with verify false the original comes back, whichever of 1, 2, 3, 7 and 16 threads decodes it.
(defun verify-failures (c: c) -> (Vec str) :where ((Codec c))
  (let [s (find-sample "text 262145") d (. s data)
        o (with-max-output (with-block-checksum (with-checksum (par-options c) true) true) 10000000)
        z (ok-of (compress c d (with-threads o 1)))
        n (array-len z)
        counts (into [1] (thread-counts))
        outs (fn (zz: (Array i8) on: bool) (vec (map (fn (t: i64) (decompress c zz (with-verify (with-threads o t) on))) counts)))
        one (fn (name: str zz: (Array i8))
              (cat [(if (every? (fn (k: str) (= k ":checksum")) (vec (map kind-of (outs zz true)))) [] [(str "verify true: a bad " name " checksum is not a checksum error under every thread count")])
                    (if (every? (fn (r: (Result (Array i8) CompressError)) (is-bytes? r d)) (outs zz false)) [] [(str "verify false: a bad " name " checksum is not ignored under every thread count")])]))]
    (cat [(if (every? (fn (r: (Result (Array i8) CompressError)) (is-bytes? r d)) (outs z true)) [] ["the sound frame does not decode under every thread count"])
          (one "content" (flip z (- n 1) 1))
          (one "block" (flip z (- n 9) 1))])))
