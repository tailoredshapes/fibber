;; fib.compress.lz4.hc: LZ4 high compression (docs/design/compress.md 6.3), levels 3 to 12: a hash chain over every position (a 32768-entry head table of positions and a
;; 65536-entry table of 16-bit distances to the previous position of the same hash, indexed by the position's low 16 bits, as liblz4's LZ4HC does) searched to a depth that
;; grows with the level (3: 4, 4: 8, 5: 16, 6: 32, 7: 64, 8: 128, 9: 256 as liblz4's table; 10, 11, 12: 512, 2048, 16384), parsed by fib.compress.lz4.hc3 (liblz4's three-match lazy parser; liblz4's optimal parser at 10 to 12 is not ported). Every match is checked against the bytes before it
;; is used, so a bug here costs ratio, never correctness.
;; Positions are `gen + index` as in fib.compress.lz4.blockenc; `nxt` (word 0 of the state words) is the next position (in that coordinate) not yet in the chain.
;; The parser is in fib.compress.lz4.hc3; this module has the tables, the insertion and the depth.
(ns fib.compress.lz4.hc (:use fib.core fib.seq fib.coll fib.compress.lz4.mem fib.compress.lz4.blockenc))

(def hc-hash-log: i64 15)

(defun hc-depth (level: i64) -> i64
  (cond (<= level 3) 4 (= level 4) 8 (= level 5) 16 (= level 6) 32 (= level 7) 64 (= level 8) 128 (= level 9) 256
        (= level 10) 512 (= level 11) 2048 :else 16384))

(defun hh (sp: ptr i: i64) -> i64 (hash4 (rd32 sp i) 17))

;; The positions from the next one not in the chain up to (not including) index `upto` go in.
(defun hc-insert (sp: ptr ht: ptr ct: ptr st: ptr gen: i64 lo: i64 upto: i64) -> unit
  (let [from (max lo (u- (rd64 st 0) gen))]
    (do (loop [i from]
          (if (< i upto)
            (let [h (hh sp i) a (u+ gen i) old (tget ht h) d (min 65535 (u- a old))]
              (do (wr16 ct (shl (bit-and a 65535) 1) d) (tput ht h a) (recur (u+ i 1))))
            ()))
        (when (> upto from) (wr64 st 0 (u+ gen upto))))))

(defun hc-tail (sp: ptr iend: i64 anchor: i64 dp: ptr op: i64) -> i64 (put-seq sp anchor (u- iend anchor) dp op 0 0))
