;; fib.compress.lz4.pframe: PARALLEL one-shot compression of an LZ4 frame with INDEPENDENT blocks (docs/design/compress.md 9). The input is cut into blocks as usual, the blocks into JOBS of about
;; `group-bytes` (1 MiB: a 64 KiB block frame has 16 blocks to a job, a 4 MiB block frame one), and the jobs are self-scheduled over the workers of fib.compress.par. A job codes its blocks
;; one after the other into a buffer of its own with an encoder of its own (a fresh table: nothing is shared), and returns the buffer and its length. THE OUTPUT DOES NOT DEPEND ON THE WORKER
;; COUNT: a block is coded from its own bytes alone (independent blocks: the history is the block, `lo` is its start), with the table size chosen from the whole input's size, so
;; whichever worker codes it, however the jobs are cut over workers, and whether or not the table carried entries from an earlier block of the job, the bytes are the same; the sequential
;; `frame-compress` is the same function over the same blocks, so `threads` 1 gives them too (a contract scenario and a property test check it for 1, 2, 3, 7 and 16 workers).
;; The content checksum (xxHash32 of the whole input, sequential by its nature) is job 0 and runs beside the others. The frame is then put together in order: header, the jobs' buffers (copied
;; into one array, in parallel above `copy-parallel-bytes`), end mark, content checksum.
;; Linked blocks, a dictionary and the streaming compressor stay sequential (a block that depends on the one before it cannot start before it ends; priming each job with a dictionary
;; would keep the output independent of the workers but is not done).
;;   (frame-compress-par src opts workers) -> (Result (Array i8) CompressError)
(ns fib.compress.lz4.pframe (:use fib.core fib.seq fib.coll fib.compress.types fib.compress.par fib.compress.lz4.mem fib.compress.lz4.enc fib.compress.lz4.header
                                   fib.compress.lz4.xxh32 fib.compress.lz4.frame))

(def group-bytes: i64 1048576)
(def copy-parallel-bytes: i64 8388608)

(defun group-blocks (bs: i64) -> i64 (max 1 (quot group-bytes bs)))

;; The blocks [j * gb, min(nb, (j + 1) * gb)) of the input, coded: the buffer and the bytes of it used.
(defun compress-group (src: (Array i8) o: Options bs: i64 gb: i64 j: i64) -> (Pair (Array i8) i64)
  (let [n (array-len src) from (* j gb bs) bytes (min (* gb bs) (- n from)) nbl (quot (+ bytes (- bs 1)) bs)
        dst (array (+ (+ bytes (* nbl 8)) (+ (quot bytes 255) 128)) 0i8)
        e (enc-new (. o level) (. o acceleration) n)]
    (loop [pos from op 0]
      (if (>= pos (+ from bytes)) (Pair dst op)
        (let [bn (min bs (- (+ from bytes) pos))]
          (recur (+ pos bn) (put-block e src pos pos bn dst op (. o block-checksum))))))))

(defun checksum-job (src: (Array i8)) -> (Pair (Array i8) i64)
  (let [a (array 4 0i8)] (do (wr32 (data a) 0 (xxh32 src 0)) (Pair a 4))))

;; Job 0 is the content checksum (when asked), jobs 1.. the groups.
(defun compress-job (src: (Array i8) o: Options bs: i64 gb: i64) -> (fn :send (i64) (Result (Pair (Array i8) i64) CompressError))
  (fn (j: i64) (Ok (if (= j 0) (if (. o checksum) (checksum-job src) (Pair (array 0 0i8) 0)) (compress-group src o bs gb (- j 1))))))

(defun total-len (parts: (Vec (Pair (Array i8) i64))) -> i64 (reduce (fn (a: i64 p: (Pair (Array i8) i64)) (+ a (. p snd))) 0 parts))

;; The parts copied one after the other from `at`; in parallel when there is much to copy (an address carries the output to the workers: they write disjoint ranges of an array the
;; caller keeps alive until `run-jobs` returns).
(defun place (out: (Array i8) at: i64 parts: (Vec (Pair (Array i8) i64)) workers: i64) -> (Result unit CompressError)
  (let [offs (vec (reductions (fn (a: i64 p: (Pair (Array i8) i64)) (+ a (. p snd))) at parts))
        addr (addr-of (data out)) n (count parts)
        r (run-jobs (if (> (total-len parts) copy-parallel-bytes) workers 1) n
            (fn (i: i64) (let [p (nth parts i)] (do (copy-exact (ptr-at-addr addr) (nth offs i) (data (. p fst)) 0 (. p snd)) (Ok ())))))]
    (match r ((Err e) (Err e)) ((Ok _) (Ok (do (array-len out) ()))))))

(defun frame-compress-par (src: (Array i8) o: Options workers: i64) -> (Result (Array i8) CompressError)
  (frame-compress-par-g src o workers (group-blocks (block-size-of o))))

;; With the number of blocks of a job given (1 makes every block a job: the specs use it to have many jobs on small inputs).
(defun frame-compress-par-g (src: (Array i8) o: Options workers: i64 gb: i64) -> (Result (Array i8) CompressError)
  (let [n (array-len src) bs (block-size-of o) groups (quot (+ (nblocks n bs) (- gb 1)) gb)]
    (match (run-jobs workers (+ groups 1) (compress-job src o bs gb))
      ((Err e) (Err e))
      ((Ok parts)
       (let [head (build-head true (. o block-checksum) (. o checksum) (if (. o record-size) n -1) -1 (block-id bs))
             blocks (vec (drop 1 parts))
             tail (array (if (. o checksum) 8 4) 0i8)
             _ (when (. o checksum) (wr32 (data tail) 4 (rd32 (data (. (nth parts 0) fst)) 0)))
             out (array (+ (array-len head) (+ (total-len blocks) (array-len tail))) 0i8)
             _ (copy-exact (data out) 0 (data head) 0 (array-len head))]
         (match (place out (array-len head) (conj blocks (Pair tail (array-len tail))) workers)
           ((Err e) (Err e))
           ((Ok _) (Ok out))))))))

;; The blocks of `data` (a multiple of the block size, except at the end of a stream) coded in parallel and put one after the other: what a streaming compressor returns for a batch.
(defun par-blocks (data: (Array i8) o: Options workers: i64 gb: i64) -> (Result (Array i8) CompressError)
  (let [bs (block-size-of o) groups (quot (+ (nblocks (array-len data) bs) (- gb 1)) gb)]
    (match (run-jobs workers groups (fn (j: i64) (Ok (compress-group data o bs gb j))))
      ((Err e) (Err e))
      ((Ok parts) (let [out (array (total-len parts) 0i8)] (match (place out 0 parts workers) ((Err e) (Err e)) ((Ok _) (Ok out))))))))
