;; fib.compress.lz4.blockdec: the LZ4 block decoder, safe on hostile input (docs/design/compress.md 5.3, 6). A block is a series of sequences: a token (literal length in the high
;; nibble, match length minus 4 in the low), the literal length's extension bytes (while a byte is 255), the literals, a 2-byte little-endian offset, the match length's extension.
;; The last sequence has literals only: the block ends when the input does, right after a literal run.
;;   (decode-block ip ilen dp dlen op lo cap) -> output end, or a negative code: -1 corrupt, -2 truncated (the input ended inside a sequence), -3 over the cap
;; ip/ilen: the input; dp/dlen: the output buffer and its real length; the output is written from index op, a match may reach back to index lo, no output byte at or past cap is
;; ever part of the result.
;;
;; TWO PATHS. The FAST path takes a sequence whose literal run is at most 14 and whose match is at most 18, when the input and output have room for the fixed-size vector copies it does
;; without looking at lengths again. Its SAFETY PROOF is the slack condition, written as `i <= ilim and op <= dlim`:
;;   ilim = min(ilen - 17, 2^31 - 1000): the token is at i, the 16-byte literal chunk reads [i+1, i+17) and the offset (at i+1+lit <= i+15) reads up to i+17: all inside the input;
;;   dlim = min(dlen - 46, cap - 32, 2^32 - 1000): the literal chunk writes [op, op+16); the match starts at op2 = op+lit <= op+14 and its chunks write at most [op2, op2+32) <= op+46 <= dlen,
;;     and its 18 bytes end at op2 + 18 <= op + 32 <= cap: inside the buffer and below the cap. (The wild bytes written past the sequence's end are inside the buffer, after the output's end,
;;     so they are overwritten by the next sequence or are beyond the result; a caller whose buffer continues past the cap passes dlen = cap, which this proof then respects.)
;;   the offset is checked by one unsigned compare: 1 <= off <= op2 - lo (zero wraps to a huge number), so a match reads only bytes in [lo, op2) and written bytes.
;; Anything the fast path does not take, or any check it fails, goes to `slow-seq`, which checks EVERY length and index and says which check failed. A length sum cannot overflow
;; (at most 255 times the input length). The packed result of the fast and slow paths is (i << 32) | op: inputs below 2 GiB and outputs below 4 GiB take the fast path; others only the slow.
(ns fib.compress.lz4.blockdec (:use fib.core fib.seq fib.coll fib.compress.lz4.mem fib.compress.lz4.xxh32))

(def e-corrupt: i64 -1)
(def e-truncated: i64 -2)
(def e-too-large: i64 -3)
(def done-flag: i64 4611686018427387904)

;; The index of the first byte at or after i that is not 255 (a length extension ends there), or -1 when the input ends first.
(defun ext-end (ip: ptr i: i64 ilen: i64) -> i64
  (loop [k i] (cond (>= k ilen) -1 (= (rd8 ip k) 255) (recur (u+ k 1)) :else k)))

;; The length of an extension: nib + 255 * (e - i) + the byte at e.
(defun ext-len (ip: ptr i: i64 e: i64 nib: i64) -> i64 (u+ nib (u+ (* 255 (u- e i)) (rd8 ip e))))

(defun copy-lits (ip: ptr i: i64 ilen: i64 dp: ptr op: i64 dlen: i64 n: i64) -> unit
  (if (and (<= n 16) (<= (u+ i 16) ilen) (<= (u+ op 16) dlen)) (cp16 dp op ip i) (copy-exact dp op ip i n)))

;; The sequence at i, op, checking everything: (i << 32 | op) of the next, or done-flag + output end when the block ends, or a negative code.
(defun slow-seq (ip: ptr ilen: i64 dp: ptr dlen: i64 lo: i64 cap: i64 i: i64 op: i64) -> i64
  (if (>= i ilen) e-truncated
    (let [tok (rd8 ip i) lnib (shr tok 4)
          le (if (= lnib 15) (ext-end ip (u+ i 1) ilen) (u+ i 0))]
      (if (< le 0) e-truncated
        (let [i1 (if (= lnib 15) (u+ le 1) (u+ i 1))
              lit (if (= lnib 15) (ext-len ip (u+ i 1) le 15) lnib)]
          (cond (> lit (u- ilen i1)) e-truncated
                (> lit (u- cap op)) e-too-large
                :else (slow-match ip ilen dp dlen lo cap tok (u+ i1 lit) op (u+ op lit) (copy-lits ip i1 ilen dp op dlen lit))))))))

;; After the literals (copied): the end of the block, or the offset and the match.
(defun slow-match (ip: ptr ilen: i64 dp: ptr dlen: i64 lo: i64 cap: i64 tok: i64 i2: i64 op: i64 op2: i64 u: unit) -> i64
  (cond (= i2 ilen) (u+ done-flag op2)
        (> (u+ i2 2) ilen) e-truncated
        :else
        (let [off (rd16 ip i2) i3 (u+ i2 2) mnib (bit-and tok 15)]
          (if (or (= off 0) (> off (u- op2 lo))) e-corrupt
            (let [me (if (= mnib 15) (ext-end ip i3 ilen) i3)]
              (if (< me 0) e-truncated
                (let [i4 (if (= mnib 15) (u+ me 1) i3) ml (u+ 4 (if (= mnib 15) (ext-len ip i3 me 15) mnib))]
                  (if (> ml (u- cap op2)) e-too-large
                    (do (copy-match dp op2 off ml (u- dlen op2)) (bit-or (shl i4 32) (u+ op2 ml)))))))))))

;; The match of the fast path (off >= 1, ml <= 18, room for 32 bytes): 16 or more apart, two 16-byte chunks; 8 to 15 apart, three 8-byte chunks; below 8 the pattern's first
;; eight bytes are written one at a time and the rest by 8-byte chunks from the distance of the first multiple of the period that is at least 8.
(defun fast-match (dp: ptr op2: i64 off: i64) -> unit
  (cond (>= off 16) (do (cp16 dp op2 dp (u- op2 off)) (cp16 dp (u+ op2 16) dp (u- (u+ op2 16) off)))
        (>= off 8) (do (cp8 dp op2 dp (u- op2 off)) (cp8 dp (u+ op2 8) dp (u- (u+ op2 8) off)) (cp8 dp (u+ op2 16) dp (u- (u+ op2 16) off)))
        :else
        (let [s (period8 off) src (u- op2 off)]
          (do (wr8 dp op2 (rd8 dp src)) (wr8 dp (u+ op2 1) (rd8 dp (u+ src 1))) (wr8 dp (u+ op2 2) (rd8 dp (u+ src 2))) (wr8 dp (u+ op2 3) (rd8 dp (u+ src 3)))
              (wr8 dp (u+ op2 4) (rd8 dp (u+ src 4))) (wr8 dp (u+ op2 5) (rd8 dp (u+ src 5))) (wr8 dp (u+ op2 6) (rd8 dp (u+ src 6))) (wr8 dp (u+ op2 7) (rd8 dp (u+ src 7)))
              (cp8 dp (u+ op2 8) dp (u- (u+ op2 8) s)) (cp8 dp (u+ op2 16) dp (u- (u+ op2 16) s))))))

;; ---- the MEDIUM path: a sequence with a long literal run or a long match (a nibble of 15, extension bytes), when the whole of it has room for wild copies.
;; It reads the lengths with the bounded `ext-end`, then checks, once, everything its copies need, and declines (0) when any check fails: `slow-seq` then redoes the sequence from its
;; start, so every error is the slow path's. Its SAFETY PROOF, with ilenm = min(ilen, 2^31), dlenm = min(dlen, 2^32 - 1000):
;;   the literals are lit bytes at i1 and the offset is at i2 = i1 + lit; i2 + 32 <= ilenm: the 32-byte chunks of the literal copy read at most i1 + lit + 31 = i2 + 31 < ilenm, and the 2-byte offset
;;     is inside; the match length's extension bytes are read by `ext-end`, which checks every index against ilen; the next position i4 < 2^31 fits the packed result.
;;   op2 = op + lit; end = op2 + ml; end <= cap (no result byte at or past cap) and end + 32 <= dlenm: the literal chunks write at most op + lit + 31 < end + 32 and the match chunks at most
;;     end + 31, all inside the buffer; the bytes written past `end` are not part of the result and are overwritten by the next sequence, as in the fast path; end < 2^32 fits the packed result.
;;   1 <= off <= op2 - lo (one unsigned compare): the match reads only bytes in [lo, op2) and bytes this sequence wrote, in chunks of 32 (off >= 32), 16 (>= 16), 8 (>= 8) so that every chunk
;;     reads bytes that are written by the chunks before it; below 8 the pattern's first 24 bytes are written by `fast-match` and the rest by 8-byte chunks from the least multiple of off that is >= 8.
(defun wild32 (d: ptr from: i64 s: ptr sfrom: i64 end: i64) -> unit
  (loop [k from] (when (< k end) (do (cp32 d k s (u+ sfrom (u- k from))) (recur (u+ k 32))))))
(defun far32 (dp: ptr to: i64 off: i64 end: i64) -> unit
  (loop [k to] (when (< k end) (do (cp32 dp k dp (u- k off)) (recur (u+ k 32))))))
(defun far16 (dp: ptr to: i64 off: i64 end: i64) -> unit
  (loop [k to] (when (< k end) (do (cp16 dp k dp (u- k off)) (recur (u+ k 16))))))
(defun far8 (dp: ptr to: i64 off: i64 end: i64) -> unit
  (loop [k to] (when (< k end) (do (cp8 dp k dp (u- k off)) (recur (u+ k 8))))))

(defun period8 (off: i64) -> i64 (bit-and (shr 1012195045879056384 (shl off 3)) 255))

(defun mid-match (dp: ptr op2: i64 off: i64 end: i64) -> unit
  (cond (>= off 32) (far32 dp op2 off end)
        (>= off 16) (far16 dp op2 off end)
        (>= off 8) (far8 dp op2 off end)
        :else (do (fast-match dp op2 off) (far8 dp (u+ op2 24) (period8 off) end))))

(defun mid-seq (ip: ptr ilen: i64 ilenm: i64 dp: ptr dlenm: i64 lo: i64 cap: i64 i: i64 op: i64) -> i64
  (let [tok (rd8 ip i) ln (shr tok 4) mn (bit-and tok 15)
        le (if (= ln 15) (ext-end ip (u+ i 1) ilen) (u+ i 0))]
    (if (< le 0) 0
      (let [i1 (if (= ln 15) (u+ le 1) (u+ i 1))
            lit (if (= ln 15) (ext-len ip (u+ i 1) le 15) ln)
            i2 (u+ i1 lit)]
        (if (> (u+ i2 32) ilenm) 0
          (let [off (rd16 ip i2) i3 (u+ i2 2) op2 (u+ op lit)
                me (if (= mn 15) (ext-end ip i3 ilen) i3)]
            (if (or (< me 0) (not (ult (u- off 1) (u- op2 lo)))) 0
              (let [i4 (if (= mn 15) (u+ me 1) i3)
                    ml (u+ 4 (if (= mn 15) (ext-len ip i3 me 15) mn))
                    end (u+ op2 ml)]
                (if (or (> end cap) (> (u+ end 32) dlenm) (>= i4 2147483648)) 0
                  (do (wild32 dp op ip i1 (u+ op lit)) (mid-match dp op2 off end)
                      (bit-or (shl i4 32) end)))))))))))

(defun fast? (ip: ptr i: i64 op: i64 ilim: i64 dlim: i64 lo: i64) -> bool
  (and (<= i ilim) (<= op dlim)
       (let [tok (rd8 ip i) lit (shr tok 4)]
         (and (< lit 15) (< (bit-and tok 15) 15) (ult (u- (rd16 ip (u+ (u+ i 1) lit)) 1) (u- (u+ op lit) lo))))))

(defun decode-block (ip: ptr ilen: i64 dp: ptr dlen: i64 op0: i64 lo: i64 cap: i64) -> i64
  (decode-block-h ip ilen dp dlen op0 lo cap dp 0))

;; ---- decoding with the content checksum of the PREVIOUS block hashed on the way (the sequential frame decoder: docs/shootout/lz4.md 2). xxHash32 is a chain of dependent multiplies
;; (about 7 cycles per 16-byte stripe, whatever the cache) while the decoder leaves most of the core idle, so one stripe of the earlier block's output is hashed in every turn of the loop
;; and the two instruction streams overlap in the core's window. `hs` points at words: 0 the next byte to hash (an index into dp), 1 the end of the range to hash, 2 to 5 the four lanes;
;; both are handed back (the lanes and the position reached, a multiple of 16 from where it began). The range lies before op0 in dp, so nothing the decoder writes touches it.
(defun hload (hs: ptr) -> (Simd i32 4)
  (with-lane (with-lane (with-lane (with-lane (vs 0) 0 (trunc i32 (rd64 hs 16))) 1 (trunc i32 (rd64 hs 24))) 2 (trunc i32 (rd64 hs 32))) 3 (trunc i32 (rd64 hs 40))))
(defun hfin (hs: ptr hend: i64 hp: i64 acc: (Simd i32 4) r: i64) -> i64
  (do (when (> hend 0) (do (wr64 hs 0 hp) (wr64 hs 16 (lane32 acc 0)) (wr64 hs 24 (lane32 acc 1)) (wr64 hs 32 (lane32 acc 2)) (wr64 hs 40 (lane32 acc 3)))) r))

(defun decode-block-h (ip: ptr ilen: i64 dp: ptr dlen: i64 op0: i64 lo: i64 cap: i64 hs: ptr hend: i64) -> i64
  (let [ilim (min (u- ilen 17) 2147483000) dlim (min (min (u- dlen 46) (u- cap 32)) 4294967000)
        ilenm (min ilen 2147483648) dlenm (min dlen 4294967000)]
    (loop [i 0 op op0 hp (if (> hend 0) (rd64 hs 0) 0) acc (if (> hend 0) (hload hs) (vs 0))]
      (let [go (<= (u+ hp 16) hend)
            acc2 (if go (vround acc (unsafe (load-simd (ptr+ dp hp)))) acc)
            hp2 (if go (u+ hp 16) hp)]
        (if (fast? ip i op ilim dlim lo)
          (let [tok (rd8 ip i) lit (shr tok 4) i2 (u+ (u+ i 1) lit) op2 (u+ op lit)]
            (do (cp16 dp op ip (u+ i 1)) (fast-match dp op2 (rd16 ip i2)) (recur (u+ i2 2) (u+ op2 (u+ (bit-and tok 15) 4)) hp2 acc2)))
          (let [m (if (< i ilim) (mid-seq ip ilen ilenm dp dlenm lo cap i op) 0)]
            (if (> m 0) (recur (shr m 32) (bit-and m 4294967295) hp2 acc2)
              (let [r (slow-seq ip ilen dp dlen lo cap i op)]
                (cond (< r 0) (hfin hs hend hp2 acc2 r)
                      (>= r done-flag) (hfin hs hend hp2 acc2 (u- r done-flag))
                      :else (recur (shr r 32) (bit-and r 4294967295) hp2 acc2))))))))))
