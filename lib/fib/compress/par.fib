;; fib.compress.par: the parallel engine under the codecs' `threads` option (docs/design/compress.md 9). Explicit module.
;; THE POOL. The runtime has no stealing pool yet (docs/design/parallelism.md 3.1 is a design and a prototype): a task is an OS thread. So the engine starts `workers` tasks and the
;; JOBS 0 .. n-1 are SELF-SCHEDULED: every worker takes the next unclaimed index from one atom (a fetch-and-add), runs it, and comes back: a slow job delays one worker and the
;; others take what is left (the balance of a stealing deque for jobs of one level, with one shared counter instead of deques). At most `workers` threads are live (the 64-thread cap
;; of fib.parallel.cpu bounds them).
;; ERRORS. A job is `(fn (i) (Result r CompressError))`. A worker that gets an error says so in `failed` and stops taking jobs; the others finish the job they are in and stop. EVERY task is
;; joined whatever happens (no task outlives the call). The error returned is that of the LOWEST job index that failed: jobs are claimed in increasing order and a claimed job always finishes,
;; so every index below the first failing one has been run, and the error is the one a sequential run would meet first: the same for every worker count. A worker that TRAPS (a bug in a
;; job: ADR 0001 isolates it at the thread's entry) is joined with `try-join` and becomes an `:internal` error, not a dead process.
;; RESULTS come back in index order. A job's result is moved between threads: arrays are fine, a `ptr` is not (not Send): `addr-of` and `ptr-at-addr` carry an address as an i64, which is
;; how a job writes into an output buffer its caller owns and keeps alive until the call returns (disjoint ranges: the caller's contract, stated where each use is).
(ns fib.compress.par (:use fib.core fib.seq fib.coll fib.async fib.compress.types fib.parallel.cpu fib.compress.lz4.mem))

(defun internal (m: str) -> CompressError (internal-error m))

(defun worker-count (threads: i64) -> i64
  (if (<= threads 0) (cpu-count) (min threads (max-workers))))

;; An address as a number, and back. UNSAFE: the buffer must outlive every use and the ranges written must be disjoint.
(defun addr-of (p: ptr) -> i64
  (let [slot (array 1 0)] (unsafe (do (store-ptr (ptr+ (raw slot) 24) p) (load-i64 (ptr+ (raw slot) 24))))))
(defun ptr-at-addr (a: i64) -> ptr
  (let [slot (array 1 a)] (unsafe (load-ptr (ptr+ (raw slot) 24)))))

(defstruct (Done r) (index: i64 value: (Result r CompressError)))

;; One worker: claims indices until none is left or somebody failed; its results in the order it ran them.
(defun work (next: (Atom i64) failed: (Atom bool) n: i64 job: (fn :send (i64) (Result r CompressError))) -> (Vec (Done r))
  (loop [out: (Vec (Done r)) []]
    (if @failed out
      (let [i (- (swap! next (fn (k: i64) (+ k 1))) 1)]
        (if (>= i n) out
          (let [r (job i)]
            (do (match r ((Err _) (reset! failed true)) ((Ok _) ()))
                (recur (conj out (Done i r))))))))))

(defun join-all (ts: (Vec (Task (Vec (Done r))))) -> (Result (Vec (Done r)) CompressError)
  (let [rs (vec (map (fn (t: (Task (Vec (Done r)))) (try-join t)) ts))
        trapped (first (filter (fn (x: (Result (Vec (Done r)) Trap)) (match x ((Err _) true) ((Ok _) false))) rs))]
    (match trapped
      ((some t) (match t ((Err e) (Err (internal (str "a worker trapped: " (. e message))))) ((Ok _) (Err (internal "unreachable")))))
      (nil (Ok (reduce (fn (a: (Vec (Done r)) x: (Result (Vec (Done r)) Trap)) (match x ((Ok v) (into a v)) ((Err _) a))) [] rs))))))

(defun first-failure (ds: (Vec (Done r))) -> (Option CompressError)
  (let [bad (vec (filter (fn (d: (Done r)) (match (. d value) ((Err _) true) ((Ok _) false))) ds))]
    (if (empty? bad) nil
      (let [best (reduce (fn (a: (Done r) d: (Done r)) (if (< (. d index) (. a index)) d a)) (first-of bad) bad)]
        (match (. best value) ((Err e) (some e)) ((Ok _) nil))))))
(defun first-of (xs: (Vec (Done r))) -> (Done r) (nth xs 0))

;; The values of the finished jobs in index order.
(defun ordered (ds: (Vec (Done r))) -> (Vec r)
  (vec (map (fn (d: (Done r)) (match (. d value) ((Ok v) v) ((Err _) (trap "ordered: a failed job")))) (sort-by (fn (d: (Done r)) (. d index)) ds))))

(defun sequential (n: i64 job: (fn :send (i64) (Result r CompressError))) -> (Result (Vec r) CompressError)
  (loop [i 0 out: (Vec r) []]
    (if (>= i n) (Ok out) (match (job i) ((Err e) (Err e)) ((Ok v) (recur (+ i 1) (conj out v)))))))

(defun parallel (w: i64 n: i64 job: (fn :send (i64) (Result r CompressError))) -> (Result (Vec r) CompressError)
  (let [next (atom 0) failed (atom false)
        ts (vec (map (fn (k: i64) (spawn (fn () (work next failed n job)))) (range w)))]
    (match (join-all ts)
      ((Err e) (Err e))
      ((Ok ds) (match (first-failure ds) ((some e) (Err e)) (nil (Ok (ordered ds))))))))

;; The results of jobs 0 .. n-1, in order, or the error of the lowest failing job.
(defun run-jobs (workers: i64 n: i64 job: (fn :send (i64) (Result r CompressError))) -> (Result (Vec r) CompressError)
  (if (or (<= workers 1) (<= n 1)) (sequential n job) (parallel (min workers n) n job)))
