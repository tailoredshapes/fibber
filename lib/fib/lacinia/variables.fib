(ns fib.lacinia.variables (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.input.core :as input]))
(defun compatible? (variable: GqlType expected: GqlType) -> bool
  (match expected
    ((NonNullType element) (match variable ((NonNullType actual) (compatible? actual element)) (_ false)))
    (_ (match variable
      ((NonNullType actual) (compatible? actual expected))
      (_ (match expected ((ListType element) (match variable ((ListType actual) (compatible? actual element)) (_ false)))
        (_ (= variable expected))))))))
(defun allowed? (definition: GqlArgument expected: GqlType has-default: bool) -> bool
  (let [default-present (match (. definition default-value) ((some value) (not (null? value))) (nil false))]
    (if (and (required? expected) (not (required? (. definition type))))
      (and (or default-present has-default)
        (match expected ((NonNullType element) (compatible? (. definition type) element)) (_ false)))
      (compatible? (. definition type) expected))))
(defun validate (state: input/GqlInputContext definitions: (Map str GqlVariable)) -> (Result unit GqlError)
  (let [names (vec (sort (keys definitions)))]
    (loop [i 0]
      (if (= i (count names)) (Ok ())
        (let [name (nth names i) variable (unwrap-or (get definitions name) (GqlVariable (argument (named "String")) (GqlLocation 1 1)))
              definition (. variable definition) pos (. variable location)]
          (if (not (input/input-type? (. state objects) (. definition type) 0))
            (Err (located-error ValidationFailure (str "Invalid variable type for $" name) pos))
            (match (. definition default-value)
              (nil (recur (+ i 1)))
              ((some value) (match (input/coerce state (. definition type) value)
                ((Err error) (Err (input/located error pos))) ((Ok _) (recur (+ i 1))))))))))))
(defun coerce (state: input/GqlInputContext definitions: (Map str GqlVariable) supplied: (Map str GqlValue)) -> (Result (Map str GqlValue) GqlError)
  (let [names (vec (sort (keys definitions)))]
    (loop [i 0 out: (Map str GqlValue) {}]
      (if (= i (count names)) (Ok out)
        (let [name (nth names i) variable (unwrap-or (get definitions name) (GqlVariable (argument (named "String")) (GqlLocation 1 1)))
              definition (. variable definition)
              value (match (get supplied name) ((some value) (some value)) (nil (. definition default-value)))]
          (match value
            (nil (if (required? (. definition type)) (Err (located-error ValidationFailure (str "Required variable $" name " is missing") (. variable location)))
              (recur (+ i 1) out)))
            ((some value) (match (input/coerce state (. definition type) value)
              ((Err error) (Err (input/located error (. variable location))))
              ((Ok coerced) (recur (+ i 1) (assoc out name coerced)))))))))))
