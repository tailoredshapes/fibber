;; Input expressions stay distinct from resolver values, preserving omission.
(ns fib.lacinia.syntax (:use fib.core fib.seq fib.coll fib.lacinia.types))
(defenum GqlInput (LiteralInput value: GqlValue) (VariableInput name: str)
  (ListInput values: (Vec GqlInput)) (ObjectInput fields: (Map str GqlInput)))
(derive Eq GqlInput)
(defstruct GqlDirective (name: str arguments: (Map str GqlInput) location: GqlLocation))
(defstruct GqlCondition (directives: (Vec GqlDirective) fragment: (Option str) occurrence: i64))
(defstruct GqlSelection (name: str response-key: str arguments: (Map str GqlInput)
  conditions: (Vec GqlCondition) children: (Vec GqlSelection) location: GqlLocation))
(defenum GqlNode
  (FieldNode name: str response-key: str arguments: (Map str GqlInput) directives: (Vec GqlDirective)
    children: (Vec GqlNode) location: GqlLocation)
  (SpreadNode name: str directives: (Vec GqlDirective) location: GqlLocation)
  (InlineNode condition: (Option str) directives: (Vec GqlDirective) children: (Vec GqlNode) location: GqlLocation))
(defstruct GqlVariable (definition: GqlArgument location: GqlLocation))
(defstruct GqlOperation (name: (Option str) variables: (Map str GqlVariable)
  directives: (Vec GqlDirective) selections: (Vec GqlNode) location: GqlLocation))
(defstruct GqlFragment (condition: str directives: (Vec GqlDirective) selections: (Vec GqlNode) location: GqlLocation))
(defstruct GqlDocument (operations: (Vec GqlOperation) fragments: (Map str GqlFragment)))
(defun constant (input: GqlInput) -> (Option GqlValue)
  (match input
    ((LiteralInput value) (some value)) ((VariableInput _) nil)
    ((ListInput values) (loop [i 0 out: (Vec GqlValue) []]
      (if (= i (count values)) (some (ListValue out))
        (match (constant (nth values i)) (nil nil) ((some value) (recur (+ i 1) (conj out value)))))))
    ((ObjectInput fields) (let [names (vec (sort (keys fields)))]
      (loop [i 0 out: (Map str GqlValue) {}]
        (if (= i (count names)) (some (object out))
          (let [name (nth names i)]
            (match (constant (get fields name (LiteralInput NullValue)))
              (nil nil) ((some value) (recur (+ i 1) (assoc out name value)))))))))))
