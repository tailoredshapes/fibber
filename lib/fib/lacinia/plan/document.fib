(ns fib.lacinia.plan.document (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.variables :as vars] [fib.lacinia.input.core :as input]
    [fib.lacinia.plan.expand :as expand] [fib.lacinia.plan.validate :as v] [fib.lacinia.plan.merge :as merge]))
(defun metadata :private (schema: GqlCompiledSchema document: GqlDocument) -> (Result unit GqlError)
  (try-let [_ (loop [i 0 seen: (Set str) #{}]
    (if (= i (count (. document operations))) (Ok ())
      (let [operation (nth (. document operations) i) name (. operation name) pos (. operation location)]
        (cond (not (empty? (. operation directives))) (Err (located-error ValidationFailure "Directives are not allowed on query operations" pos))
          (and (= name nil) (> (count (. document operations)) 1)) (Err (located-error ValidationFailure "Anonymous operation must be alone" pos))
          (and (some? name) (contains? seen (unwrap-or name ""))) (Err (located-error ValidationFailure "Duplicate operation name" pos))
          :else (recur (+ i 1) (if (some? name) (conj seen (unwrap-or name "")) seen))))))]
    (let [names (vec (sort (keys (. document fragments))))]
      (loop [i 0]
        (if (= i (count names)) (Ok ())
          (let [fragment (unwrap-or (get (. document fragments) (nth names i)) (GqlFragment "" [] [] (GqlLocation 1 1)))]
            (if (or (not (contains? (. schema objects) (. fragment condition))) (not (empty? (. fragment directives))))
              (Err (located-error ValidationFailure "Invalid fragment type or definition directive" (. fragment location))) (recur (+ i 1)))))))))
(defun validate (schema: GqlCompiledSchema document: GqlDocument) -> (Result (Vec (Vec GqlSelection)) GqlError)
  (try-let [_ (metadata schema document)]
    (let [expansion (expand/context (. document fragments)) state (input/context (. schema input-objects))]
      (try-let [all (loop [i 0 out: (Vec (Vec GqlSelection)) []]
        (if (= i (count (. document operations))) (Ok out)
          (let [operation (nth (. document operations) i) used: (Cell (Set str)) (cell #{})]
            (try-let [_ (vars/validate state (. operation variables))
              nodes (expand/selections expansion schema "Query" (. operation selections) [] #{} 0)
              _ (v/selections schema state "Query" nodes (. operation variables) used)
              _ (merge/validate nodes)]
              (let [unused (first (filter (fn (name: str) (not (contains? @used name))) (keys (. operation variables))))]
                (match unused
                  ((some name) (Err (located-error ValidationFailure (str "Unused variable $" name) (. operation location))))
                  (nil (recur (+ i 1) (conj out nodes)))))))))]
        (match (first (filter (fn (name: str) (not (contains? @(. expansion used) name))) (keys (. document fragments))))
          ((some name) (Err (located-error ValidationFailure (str "Unused fragment " name) (. (unwrap-or (get (. document fragments) name) (GqlFragment "" [] [] (GqlLocation 1 1))) location))))
          (nil (Ok all)))))))
(defun choose (document: GqlDocument name: (Option str)) -> (Result i64 GqlError)
  (match name
    (nil (if (= (count (. document operations)) 1) (Ok 0)
      (Err (located-error ValidationFailure "Operation name is required for multiple operations" (GqlLocation 1 1)))))
    ((some name) (loop [i 0]
      (if (= i (count (. document operations))) (Err (located-error ValidationFailure (str "Unknown operation " name) (GqlLocation 1 1)))
        (if (= (. (nth (. document operations) i) name) (some name)) (Ok i) (recur (+ i 1))))))))
