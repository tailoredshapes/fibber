(ns fib.lacinia.plan.collect (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.input.core :as input] [fib.lacinia.plan.directives :as dirs]))
(defun selections (state: input/GqlInputContext nodes: (Vec GqlSelection) variables: (Map str GqlValue)) -> (Result (Vec GqlSelection) GqlError)
  (let [visited: (Cell (Map str i64)) (cell {})]
    (loop [i 0 out: (Vec GqlSelection) []]
    (if (= i (count nodes)) (Ok out)
      (let [node (nth nodes i)]
        (match (dirs/included? state (. node conditions) variables visited)
          ((Err error) (Err (with error (kind (if (= (. error kind) ResourceLimit) ResourceLimit ArgumentFailure)))))
          ((Ok keep) (recur (+ i 1) (if keep (conj out node) out)))))))))
