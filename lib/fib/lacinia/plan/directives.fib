(ns fib.lacinia.plan.directives (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.input.core :as input] [fib.lacinia.input.validate :as v] [fib.lacinia.input.resolve :as r]))
(defun check-local (directives: (Vec GqlDirective)) -> (Result unit GqlError)
  (loop [i 0 seen: (Set str) #{}]
    (if (= i (count directives)) (Ok ())
      (let [directive (nth directives i) name (. directive name) args (. directive arguments) pos (. directive location)]
        (cond (not (or (= name "skip") (= name "include"))) (Err (located-error ValidationFailure (str "Unknown directive " name) pos))
          (contains? seen name) (Err (located-error ValidationFailure (str "Duplicate directive " name) pos))
          (or (!= (count args) 1) (not (contains? args "if"))) (Err (located-error ValidationFailure "Directive requires only its if argument" pos))
          :else (recur (+ i 1) (conj seen name)))))))
(defun validate (state: input/GqlInputContext variables: (Map str GqlVariable) groups: (Vec GqlCondition)
  used: (Cell (Set str))) -> (Result unit GqlError)
  (loop [i 0]
    (if (= i (count groups)) (Ok ())
      (let [directives (. (nth groups i) directives)]
        (try-let [_ (loop [j 0]
          (if (= j (count directives)) (Ok ())
            (let [directive (nth directives j)]
              (try-let [_ (v/value-at state variables (non-null (named "Boolean")) false
                (get (. directive arguments) "if" (LiteralInput NullValue)) used (. directive location) 0)] (recur (+ j 1))))))]
          (recur (+ i 1)))))))
(defun applies :private (state: input/GqlInputContext directive: GqlDirective variables: (Map str GqlValue)) -> (Result bool GqlError)
  (try-let [value (r/value-at state (non-null (named "Boolean"))
    (get (. directive arguments) "if" (LiteralInput NullValue)) variables (. directive location) 0)]
    (match value ((some (BooleanValue flag)) (Ok flag))
      (_ (Err (located-error ValidationFailure "Directive if value must be Boolean!" (. directive location)))))))
(defun group-included :private (state: input/GqlInputContext directives: (Vec GqlDirective) variables: (Map str GqlValue)) -> (Result bool GqlError)
  (try-let [skip (loop [i 0]
    (if (= i (count directives)) (Ok false)
      (let [directive (nth directives i)]
        (if (= (. directive name) "skip") (applies state directive variables) (recur (+ i 1))))))]
    (if skip (Ok false)
      (loop [i 0]
        (if (= i (count directives)) (Ok true)
          (let [directive (nth directives i)]
            (if (= (. directive name) "include") (applies state directive variables) (recur (+ i 1)))))))))
(defun condition-included :private (state: input/GqlInputContext group: GqlCondition variables: (Map str GqlValue)
  visited: (Cell (Map str i64))) -> (Result bool GqlError)
  (match (. group fragment)
    (nil (group-included state (. group directives) variables))
    ((some name) (match (get @visited name)
      ((some previous) (Ok (= previous (. group occurrence))))
      (nil (try-let [keep (group-included state (. group directives) variables)]
        (do (if keep (set! visited (assoc @visited name (. group occurrence))) ()) (Ok keep))))))))
(defun included? (state: input/GqlInputContext groups: (Vec GqlCondition) variables: (Map str GqlValue)
  visited: (Cell (Map str i64))) -> (Result bool GqlError)
  (loop [i 0]
    (if (= i (count groups)) (Ok true)
      (try-let [keep (condition-included state (nth groups i) variables visited)]
        (if keep (recur (+ i 1)) (Ok false))))))
