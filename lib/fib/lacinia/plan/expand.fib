;; Bound expansion before collection; conditional spreads still participate in validation.
(ns fib.lacinia.plan.expand (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.plan.fields :as fields] [fib.lacinia.plan.directives :as dirs]))
(defstruct GqlExpansion (fragments: (Map str GqlFragment) used: (Cell (Set str)) visits: (Cell i64)))
(defun context (fragments: (Map str GqlFragment)) -> GqlExpansion (GqlExpansion fragments (cell #{}) (cell 0)))
(defun condition :private (schema: GqlCompiledSchema owner: str expected: str location: GqlLocation) -> (Result unit GqlError)
  (if (and (contains? (. schema objects) expected) (= owner expected)) (Ok ())
    (Err (located-error ValidationFailure (str "Fragment type " expected " cannot apply to " owner) location))))
(defun node-location :private (node: GqlNode) -> GqlLocation
  (match node ((FieldNode _ _ _ _ _ location) location) ((SpreadNode _ _ location) location) ((InlineNode _ _ _ location) location)))
(defun node :private (state: GqlExpansion schema: GqlCompiledSchema owner: str item: GqlNode
  conditions: (Vec GqlCondition) path: (Set str) depth: i64) -> (Result (Vec GqlSelection) GqlError)
  (match item
    ((FieldNode name key args directives children location)
      (try-let [_ (dirs/check-local directives) field (fields/lookup schema owner name location)
        nested (selections state schema (base-name (. field type)) children [] path (+ depth 1))]
        (Ok [(GqlSelection name key args (conj conditions (GqlCondition directives nil 0)) nested location)])))
    ((InlineNode expected directives children location)
      (try-let [_ (dirs/check-local directives)
        _ (match expected (nil (Ok ())) ((some name) (condition schema owner name location)))]
        (selections state schema owner children (conj conditions (GqlCondition directives nil 0)) path (+ depth 1))))
    ((SpreadNode name directives location)
      (let [occurrence @(. state visits)]
        (try-let [_ (dirs/check-local directives)]
        (if (contains? path name) (Err (located-error ValidationFailure (str "Fragment cycle at " name) location))
          (match (get (. state fragments) name)
            (nil (Err (located-error ValidationFailure (str "Undefined fragment " name) location)))
            ((some fragment) (try-let [_ (condition schema owner (. fragment condition) location)]
              (do (set! (. state used) (conj @(. state used) name))
                (selections state schema owner (. fragment selections)
                  (conj conditions (GqlCondition directives (some name) occurrence)) (conj path name) (+ depth 1))))))))))))
(defun selections (state: GqlExpansion schema: GqlCompiledSchema owner: str nodes: (Vec GqlNode)
  conditions: (Vec GqlCondition) path: (Set str) depth: i64) -> (Result (Vec GqlSelection) GqlError)
  (loop [i 0 out: (Vec GqlSelection) []]
    (if (= i (count nodes)) (Ok out)
      (let [item (nth nodes i) location (node-location item)]
        (do (set! (. state visits) (+ @(. state visits) 1))
          (if (or (> depth 64) (> @(. state visits) 65536))
            (Err (located-error ResourceLimit "Fragment expansion exceeds depth or work limit" location))
            (try-let [next (node state schema owner item conditions path depth)]
              (recur (+ i 1) (reduce (fn (all: (Vec GqlSelection) selection: GqlSelection) (conj all selection)) out next)))))))))
