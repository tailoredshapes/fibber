(ns fib.lacinia.plan.fields (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax))
(defun lookup (schema: GqlCompiledSchema owner: str name: str location: GqlLocation) -> (Result GqlField GqlError)
  (cond (= name "__typename") (Ok (field (non-null (named "String"))))
    (or (= name "__schema") (= name "__type")) (Err (located-error UnsupportedFeature "Schema introspection is not implemented yet" location))
    :else (match (get (. schema objects) owner)
      (nil (Err (located-error ValidationFailure (str "Unknown object type " owner) location)))
      ((some object) (match (get (. object fields) name)
        ((some field) (Ok field))
        (nil (Err (located-error ValidationFailure (str "Unknown field " owner "/" name) location))))))))
