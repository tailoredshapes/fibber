(ns fib.lacinia.plan.validate (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.coerce :as c] [fib.lacinia.plan.fields :as fields]
    [fib.lacinia.plan.directives :as dirs] [fib.lacinia.input.validate :as input] [fib.lacinia.input.core :as core]))
(defun selection :private (schema: GqlCompiledSchema state: core/GqlInputContext owner: str item: GqlSelection
  variables: (Map str GqlVariable) used: (Cell (Set str))) -> (Result unit GqlError)
  (try-let [field (fields/lookup schema owner (. item name) (. item location))]
    (let [name (base-name (. field type)) scalar (c/scalar? name) children (. item children) pos (. item location)]
      (cond (and scalar (not (empty? children))) (Err (located-error ValidationFailure "A scalar field cannot have a selection set" pos))
        (and (not scalar) (empty? children)) (Err (located-error ValidationFailure "An object field requires a selection set" pos))
        :else (try-let [_ (input/arguments state variables (. field arguments) (. item arguments) used pos)
          _ (dirs/validate state variables (. item conditions) used)
          _ (selections schema state name children variables used)] (Ok ()))))))
(defun selections (schema: GqlCompiledSchema state: core/GqlInputContext owner: str nodes: (Vec GqlSelection)
  variables: (Map str GqlVariable) used: (Cell (Set str))) -> (Result unit GqlError)
  (loop [i 0]
    (if (= i (count nodes)) (Ok ())
      (try-let [_ (selection schema state owner (nth nodes i) variables used)] (recur (+ i 1))))))
