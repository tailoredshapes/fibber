(ns fib.lacinia.lexer (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.lex.cursor :as c] [fib.lacinia.lex.strings :as s]
            [fib.lacinia.lex.numbers :as num] [fib.lacinia.schema :as schema]))
(defun ignored :private (cursor: c/GqlCursor) -> unit
  (loop []
    (let [code (c/at cursor 0)]
      (cond (or (= code 9) (= code 10) (= code 13) (= code 32) (= code 44) (= code 65279)) (do (c/advance cursor) (recur))
        (= code 35) (do (c/take-while cursor (fn (n: i64) (and (>= n 0) (!= n 10) (!= n 13)))) (recur)) :else ()))))
(defun next-token :private (cursor: c/GqlCursor) -> (Result c/GqlToken GqlError)
  (let [code (c/at cursor 0) location (c/location cursor)]
    (cond (< code 0) (Ok (c/GqlToken "end" "" location))
      (schema/name-start? code) (Ok (c/GqlToken "name" (c/take-while cursor schema/name-part?) location))
      (= code 34) (try-let [text (s/read-string cursor)] (Ok (c/GqlToken "string" text location)))
      (or (= code 45) (num/digit? code)) (num/read-number cursor)
      (and (= code 46) (= (c/at cursor 1) 46) (= (c/at cursor 2) 46))
        (do (dotimes (i 3) (c/advance cursor)) (Ok (c/GqlToken "punct" "..." location)))
      (some? (str-find "{}():[]!=$@" (char->str (char code)) 0))
        (do (c/advance cursor) (Ok (c/GqlToken "punct" (char->str (char code)) location)))
      :else (Err (c/failure cursor "Unexpected character")))))
(defun tokenize (text: str) -> (Result (Vec c/GqlToken) GqlError)
  (if (> (str-len text) 1048576) (Err (located-error ResourceLimit "Document exceeds 1 MiB" (GqlLocation 1 1)))
    (let [cursor (c/cursor text)]
      (loop [tokens: (Vec c/GqlToken) []]
        (do (ignored cursor)
          (if (>= (count tokens) 16384) (Err (located-error ResourceLimit "Document exceeds token limit" (c/location cursor)))
            (try-let [token (next-token cursor)]
              (let [out (conj tokens token)]
                (if (= (. token kind) "end") (Ok out) (recur out))))))))))
