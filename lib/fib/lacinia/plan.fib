;; Validation is complete; collect active fields and prepare their arguments before resolving.
(ns fib.lacinia.plan (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.input.core :as input] [fib.lacinia.input.resolve :as values]
    [fib.lacinia.plan.fields :as fields] [fib.lacinia.plan.merge :as merge] [fib.lacinia.plan.collect :as collect]))
(defstruct GqlPreparedField (name: str response-key: str field: GqlField arguments: (Map str GqlValue)
  argument-error: (Option GqlError) children: (Vec GqlPreparedField)
  children-error: (Option GqlError) location: GqlLocation))
(defun prepare-field :private (schema: GqlCompiledSchema state: input/GqlInputContext owner: str
  selection: GqlSelection variables: (Map str GqlValue)) -> (Result GqlPreparedField GqlError)
  (try-let [field (fields/lookup schema owner (. selection name) (. selection location))]
    (match (values/object-fields state (. field arguments) (. selection arguments) variables (. selection location) 0)
      ((Err error) (if (= (. error kind) ResourceLimit) (Err error)
        (Ok (GqlPreparedField (. selection name) (. selection response-key) field {}
          (some (with error (kind ArgumentFailure))) [] nil (. selection location)))))
      ((Ok arguments) (match (prepare-fields schema state (base-name (. field type)) (. selection children) variables)
        ((Err error) (if (= (. error kind) ResourceLimit) (Err error)
          (Ok (GqlPreparedField (. selection name) (. selection response-key) field arguments nil [] (some error) (. selection location)))))
        ((Ok children) (Ok (GqlPreparedField (. selection name) (. selection response-key) field arguments nil children nil (. selection location)))))))))
(defun prepare-fields :private (schema: GqlCompiledSchema state: input/GqlInputContext owner: str
  selections: (Vec GqlSelection) variables: (Map str GqlValue)) -> (Result (Vec GqlPreparedField) GqlError)
  (try-let [active (collect/selections state selections variables) nodes (merge/fields active)]
    (loop [i 0 out: (Vec GqlPreparedField) []]
      (if (= i (count nodes)) (Ok out)
        (try-let [node (prepare-field schema state owner (nth nodes i) variables)]
          (recur (+ i 1) (conj out node)))))))
(defun prepare (schema: GqlCompiledSchema state: input/GqlInputContext selections: (Vec GqlSelection)
  variables: (Map str GqlValue)) -> (Result (Vec GqlPreparedField) GqlError)
  (prepare-fields schema state "Query" selections variables))
