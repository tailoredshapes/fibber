(ns fib.lacinia.parser (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.lexer :as lexer] [fib.lacinia.parse.cursor :as p] [fib.lacinia.parse.values :as v]
            [fib.lacinia.parse.variables :as vars]))
(defun selection :private (parser: p/GqlParser depth: i64) -> (Result GqlSelection GqlError)
  (let [location (. (p/token parser) location)]
    (try-let [first-name (p/name parser)
      field-name (if (p/at? parser ":") (do (p/advance parser) (p/name parser)) (Ok first-name))
      arguments (v/arguments parser)]
      (if (p/at? parser "@") (Err (p/unsupported parser "Directives are not implemented yet"))
        (try-let [children (if (p/at? parser "{") (selections parser (+ depth 1)) (Ok []))]
          (Ok (GqlSelection field-name first-name arguments children location)))))))
(defun selections :private (parser: p/GqlParser depth: i64) -> (Result (Vec GqlSelection) GqlError)
  (if (> depth 64) (Err (located-error ResourceLimit "Selection nesting exceeds 64" (. (p/token parser) location)))
    (try-let [_ (p/expect parser "{")]
      (if (p/at? parser "}") (Err (p/failure parser "Selection set cannot be empty"))
        (loop [out: (Vec GqlSelection) []]
          (try-let [item (selection parser depth)]
            (let [next (conj out item)]
              (if (p/at? parser "}") (do (p/advance parser) (Ok next)) (recur next)))))))))
(defun operation :private (parser: p/GqlParser) -> (Result GqlOperation GqlError)
  (let [location (. (p/token parser) location)]
    (cond (p/at? parser "{") (try-let [out (selections parser 0)] (Ok (GqlOperation "" {} out location)))
      (p/at? parser "query") (do (p/advance parser)
        (try-let [name (if (= (. (p/token parser) kind) "name") (p/name parser) (Ok ""))
          variables (vars/definitions parser)]
          (if (p/at? parser "@") (Err (p/unsupported parser "Directives are not implemented yet"))
            (try-let [out (selections parser 0)] (Ok (GqlOperation name variables out location))))))
      :else (Err (p/unsupported parser "Only query operations are implemented")))))
(defun parse-document (text: str) -> (Result (Vec GqlOperation) GqlError)
  (try-let [tokens (lexer/tokenize text)]
    (let [parser (p/parser tokens)]
      (loop [out: (Vec GqlOperation) []]
        (if (= (. (p/token parser) kind) "end")
          (if (empty? out) (Err (p/failure parser "Document must contain a query")) (Ok out))
          (try-let [item (operation parser)] (recur (conj out item))))))))
;; Compatibility entry point for callers that expect one selection set.
(defun parse (text: str) -> (Result (Vec GqlSelection) GqlError)
  (try-let [operations (parse-document text)]
    (if (= (count operations) 1) (Ok (. (nth operations 0) selections))
      (Err (located-error ValidationFailure "Expected a single query operation" (. (nth operations 1) location))))))
