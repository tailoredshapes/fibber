(ns fib.lacinia.parser (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.lexer :as lexer] [fib.lacinia.parse.cursor :as p]
    [fib.lacinia.parse.variables :as v] [fib.lacinia.parse.directives :as d] [fib.lacinia.parse.selections :as s]))
(defun operation :private (parser: p/GqlParser) -> (Result GqlOperation GqlError)
  (let [location (. (p/token parser) location)]
    (if (p/at? parser "{")
      (try-let [selections (s/selections parser 0)] (Ok (GqlOperation nil {} [] selections location)))
      (if (not (p/at? parser "query")) (Err (p/unsupported parser "Only query operations are implemented"))
        (do (p/advance parser)
          (try-let [name (if (= (. (p/token parser) kind) "name") (try-let [name (p/name parser)] (Ok (some name))) (Ok nil))
            variables (v/definitions parser) directives (d/directives parser) selections (s/selections parser 0)]
            (Ok (GqlOperation name variables directives selections location))))))))
(defun fragment :private (parser: p/GqlParser) -> (Result (Pair str GqlFragment) GqlError)
  (let [location (. (p/token parser) location)]
    (do (p/advance parser)
      (try-let [name (p/name parser)]
        (if (= name "on") (Err (p/failure parser "Fragment name cannot be on"))
          (try-let [_ (p/expect parser "on") condition (p/name parser) directives (d/directives parser) selections (s/selections parser 0)]
            (Ok (Pair name (GqlFragment condition directives selections location)))))))))
(defun parse (text: str) -> (Result GqlDocument GqlError)
  (try-let [tokens (lexer/tokenize text)]
    (let [parser (p/parser tokens)]
      (loop [operations: (Vec GqlOperation) [] fragments: (Map str GqlFragment) {}]
        (cond (= (. (p/token parser) kind) "end")
          (if (empty? operations) (Err (p/failure parser "Document requires an operation")) (Ok (GqlDocument operations fragments)))
          (p/at? parser "fragment") (try-let [pair (fragment parser)]
            (let [name (. pair fst) definition (. pair snd)]
              (if (contains? fragments name) (Err (located-error ValidationFailure (str "Duplicate fragment " name) (. definition location)))
                (recur operations (assoc fragments name definition)))))
          :else (try-let [next (operation parser)] (recur (conj operations next) fragments)))))))
