(ns fib.lacinia.parse.variables (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.parse.cursor :as p] [fib.lacinia.parse.values :as v]))
(defun type-ref (parser: p/GqlParser depth: i64) -> (Result GqlType GqlError)
  (if (> depth 64) (Err (located-error ResourceLimit "Variable type nesting exceeds 64" (. (p/token parser) location)))
    (try-let [type (if (p/at? parser "[")
      (do (p/advance parser) (try-let [element (type-ref parser (+ depth 1)) _ (p/expect parser "]")] (Ok (list-of element))))
      (try-let [name (p/name parser)] (Ok (named name))))]
      (Ok (if (p/at? parser "!") (do (p/advance parser) (non-null type)) type)))))
(defun default-value :private (parser: p/GqlParser) -> (Result (Option GqlValue) GqlError)
  (if (not (p/at? parser "=")) (Ok nil)
    (do (p/advance parser)
      (try-let [value (v/value parser 0)]
        (match (constant value) ((some value) (Ok (some value)))
          (nil (Err (p/failure parser "Variable defaults must be constant"))))))))
(defun definitions (parser: p/GqlParser) -> (Result (Map str GqlVariable) GqlError)
  (if (not (p/at? parser "(")) (Ok {})
    (do (p/advance parser)
      (if (p/at? parser ")") (Err (p/failure parser "Variable definitions cannot be empty"))
        (loop [out: (Map str GqlVariable) {}]
          (let [location (. (p/token parser) location)]
            (try-let [_ (p/expect parser "$") name (p/name parser) _ (p/expect parser ":")
              type (type-ref parser 0) default (default-value parser)]
              (cond (contains? out name) (Err (located-error ValidationFailure (str "Duplicate variable " name) location))
                (p/at? parser "@") (Err (p/unsupported parser "Variable-definition directives are not implemented"))
                :else (let [next (assoc out name (GqlVariable (GqlArgument type default) location))]
                  (if (p/at? parser ")") (do (p/advance parser) (Ok next)) (recur next)))))))))))
