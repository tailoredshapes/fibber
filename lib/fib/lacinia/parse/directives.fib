(ns fib.lacinia.parse.directives (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.parse.cursor :as p] [fib.lacinia.parse.values :as v]))
(defun directives (parser: p/GqlParser) -> (Result (Vec GqlDirective) GqlError)
  (loop [out: (Vec GqlDirective) []]
    (if (not (p/at? parser "@")) (Ok out)
      (let [location (. (p/token parser) location)]
        (do (p/advance parser)
          (try-let [name (p/name parser) args (v/arguments parser)]
            (recur (conj out (GqlDirective name args location)))))))))
