(ns fib.lacinia.parse.cursor (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.lex.cursor :as l]))
(defstruct GqlParser (tokens: (Vec l/GqlToken) index: (Cell i64)))
(defun parser (tokens: (Vec l/GqlToken)) -> GqlParser (GqlParser tokens (cell 0)))
(defun token (p: GqlParser) -> l/GqlToken (nth (. p tokens) (min @(. p index) (- (count (. p tokens)) 1))))
(defun at? (p: GqlParser text: str) -> bool (= (. (token p) text) text))
(defun advance (p: GqlParser) -> unit (set! (. p index) (+ @(. p index) 1)))
(defun failure (p: GqlParser message: str) -> GqlError (located-error ParseFailure message (. (token p) location)))
(defun unsupported (p: GqlParser message: str) -> GqlError (located-error UnsupportedFeature message (. (token p) location)))
(defun expect (p: GqlParser text: str) -> (Result unit GqlError)
  (if (at? p text) (do (advance p) (Ok ())) (Err (failure p (str "Expected " text)))))
(defun name (p: GqlParser) -> (Result str GqlError)
  (let [current (token p)]
    (cond (= (. current kind) "name") (do (advance p) (Ok (. current text)))
      (at? p "...") (Err (unsupported p "Fragments are not implemented yet"))
      (at? p "@") (Err (unsupported p "Directives are not implemented yet"))
      :else (Err (failure p "Expected a field or argument name")))))
