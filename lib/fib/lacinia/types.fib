;; Typed equivalents of Lacinia's schema data, resolved values, and errors.
(ns fib.lacinia.types (:use fib.core fib.seq fib.coll))
(defenum GqlValue (NullValue) (BooleanValue value: bool) (IntValue value: i64)
  (FloatValue value: f64) (StringValue value: str) (EnumValue value: str)
  (ListValue values: (Vec GqlValue)) (ObjectValue fields: (Map str GqlValue) order: (Vec str)))
(derive Eq GqlValue)
(defenum GqlType (NamedType name: str) (ListType element: GqlType) (NonNullType element: GqlType))
(derive Eq GqlType)
(defstruct GqlLocation (line: i64 column: i64))
(derive Eq GqlLocation)
(defenum GqlPath (FieldPath name: str) (IndexPath index: i64))
(derive Eq GqlPath)
(defenum GqlErrorKind ParseFailure SchemaFailure ValidationFailure ArgumentFailure ResolverFailure CompletionFailure UnsupportedFeature ResourceLimit)
(defstruct GqlError (kind: GqlErrorKind message: str locations: (Vec GqlLocation) path: (Vec GqlPath)))
(derive Eq GqlError)
(defstruct GqlResult (data: (Option GqlValue) errors: (Vec GqlError)))
(defstruct GqlArgument (type: GqlType default-value: (Option GqlValue)))
(defstruct GqlField (type: GqlType arguments: (Map str GqlArgument)
  resolver: (Option (fn :send (GqlValue (Map str GqlValue) GqlValue) (Result GqlValue str)))))
(defstruct GqlObjectType (fields: (Map str GqlField)))
(defstruct GqlInputObjectType (fields: (Map str GqlArgument)))
(defstruct GqlSchemaDefinition (objects: (Map str GqlObjectType) queries: (Map str GqlField)
  input-objects: (Map str GqlInputObjectType)))
(defstruct GqlCompiledSchema (objects: (Map str GqlObjectType) input-objects: (Map str GqlInputObjectType)))
(defun object (fields: (Map str GqlValue)) -> GqlValue (ObjectValue fields (vec (sort (keys fields)))))
(defun null? (value: GqlValue) -> bool (match value ((NullValue) true) (_ false)))
(defun field-value (value: GqlValue name: str) -> GqlValue
  (match value ((ObjectValue fields _) (unwrap-or (get fields name) NullValue)) (_ NullValue)))
(defun named (name: str) -> GqlType (NamedType name))
(defun list-of (element: GqlType) -> GqlType (ListType element))
(defun non-null (element: GqlType) -> GqlType (NonNullType element))
(defun required? (type: GqlType) -> bool (match type ((NonNullType _) true) (_ false)))
(defun base-name (type: GqlType) -> str
  (match type ((NamedType name) name) ((ListType element) (base-name element)) ((NonNullType element) (base-name element))))
(defun field (type: GqlType) -> GqlField (GqlField type {} nil))
(defun resolving (type: GqlType resolver: (fn :send (GqlValue (Map str GqlValue) GqlValue) (Result GqlValue str))) -> GqlField
  (GqlField type {} (some resolver)))
(defun argument (type: GqlType) -> GqlArgument (GqlArgument type nil))
(defun object-type (fields: (Map str GqlField)) -> GqlObjectType (GqlObjectType fields))
(defun input-object (fields: (Map str GqlArgument)) -> GqlInputObjectType (GqlInputObjectType fields))
(defun schema (objects: (Map str GqlObjectType) queries: (Map str GqlField)) -> GqlSchemaDefinition
  (GqlSchemaDefinition objects queries {}))
(defun located-error (kind: GqlErrorKind message: str location: GqlLocation) -> GqlError
  (GqlError kind message [location] []))
(defun schema-error (message: str) -> GqlError (GqlError SchemaFailure message [] []))
