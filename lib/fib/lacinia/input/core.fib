(ns fib.lacinia.input.core (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.coerce :as c]))
(defstruct GqlInputError (kind: GqlErrorKind message: str))
(defstruct GqlInputContext (objects: (Map str GqlInputObjectType) visits: (Cell i64)))
(defun context (objects: (Map str GqlInputObjectType)) -> GqlInputContext (GqlInputContext objects (cell 0)))
(defun failure (message: str) -> GqlInputError (GqlInputError ValidationFailure message))
(defun located (error: GqlInputError location: GqlLocation) -> GqlError
  (located-error (. error kind) (. error message) location))
(defun spend (state: GqlInputContext depth: i64) -> (Result unit GqlInputError)
  (do (set! (. state visits) (+ @(. state visits) 1))
    (if (or (> depth 64) (> @(. state visits) 65536))
      (Err (GqlInputError ResourceLimit "Input coercion exceeds depth or work limit")) (Ok ()))))
(defun input-type? (objects: (Map str GqlInputObjectType) type: GqlType depth: i64) -> bool
  (and (<= depth 64) (match type
    ((NamedType name) (or (c/scalar? name) (contains? objects name)))
    ((ListType element) (input-type? objects element (+ depth 1)))
    ((NonNullType element) (and (not (required? element)) (input-type? objects element (+ depth 1)))))))
(defun coerce-fields (state: GqlInputContext definitions: (Map str GqlArgument) supplied: (Map str GqlValue) depth: i64) -> (Result GqlValue GqlInputError)
  (if (some? (first (filter (fn (key: str) (not (contains? definitions key))) (keys supplied))))
    (Err (failure "Unknown input field or argument"))
    (let [names (vec (sort (keys definitions)))]
      (loop [i 0 out: (Map str GqlValue) {}]
        (if (= i (count names)) (Ok (object out))
          (let [name (nth names i) definition (get definitions name (argument (named "String")))
                value (match (get supplied name) ((some value) (some value)) (nil (. definition default-value)))]
            (match value
              ((some value) (try-let [coerced (value-at state (. definition type) value depth)]
                (recur (+ i 1) (assoc out name coerced))))
              (nil (if (required? (. definition type)) (Err (failure (str "Required input " name " is missing"))) (recur (+ i 1) out))))))))))
(defun list-value :private (state: GqlInputContext element: GqlType value: GqlValue depth: i64) -> (Result GqlValue GqlInputError)
  (let [items (match value ((ListValue items) items) (_ [value]))]
    (loop [i 0 out: (Vec GqlValue) []]
      (if (= i (count items)) (Ok (ListValue out))
        (try-let [item (value-at state element (nth items i) (+ depth 1))] (recur (+ i 1) (conj out item)))))))
(defun named-value :private (state: GqlInputContext name: str value: GqlValue depth: i64) -> (Result GqlValue GqlInputError)
  (if (c/scalar? name)
    (match (c/scalar-value name value true) ((Ok value) (Ok value)) ((Err message) (Err (failure message))))
    (match (get (. state objects) name)
      (nil (Err (failure (str "Unknown input type " name))))
      ((some definition) (match value
        ((ObjectValue fields _) (coerce-fields state (. definition fields) fields (+ depth 1)))
        (_ (Err (failure (str "Expected input object " name)))))))))
(defun value-at (state: GqlInputContext type: GqlType value: GqlValue depth: i64) -> (Result GqlValue GqlInputError)
  (try-let [_ (spend state depth)]
      (match type
        ((NonNullType element) (if (null? value) (Err (failure "A non-null input cannot be null")) (value-at state element value (+ depth 1))))
        (_ (if (null? value) (Ok NullValue)
          (match type ((NamedType name) (named-value state name value depth))
            ((ListType element) (list-value state element value depth)) (_ (Err (failure "Invalid input type")))))))))
(defun coerce (state: GqlInputContext type: GqlType value: GqlValue) -> (Result GqlValue GqlInputError)
  (value-at state type value 0))
