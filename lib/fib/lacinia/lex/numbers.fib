(ns fib.lacinia.lex.numbers (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.lex.cursor :as c] [fib.lacinia.schema :as s] [fib.lacinia.coerce :as co]
            [fib.os.native :as n]))
(extern strtod :private (ptr ptr) -> f64)
(defun digit? (code: i64) -> bool (and (>= code 48) (<= code 57)))
(defun digits :private (cursor: c/GqlCursor) -> (Result unit GqlError)
  (if (not (digit? (c/at cursor 0))) (Err (c/failure cursor "Expected a digit"))
    (do (c/take-while cursor digit?) (Ok ()))))
(defun fraction :private (cursor: c/GqlCursor) -> (Result bool GqlError)
  (if (= (c/at cursor 0) 46) (do (c/advance cursor) (try-let [_ (digits cursor)] (Ok true))) (Ok false)))
(defun exponent :private (cursor: c/GqlCursor) -> (Result bool GqlError)
  (if (or (= (c/at cursor 0) 101) (= (c/at cursor 0) 69))
    (do (c/advance cursor)
      (if (or (= (c/at cursor 0) 43) (= (c/at cursor 0) 45)) (c/advance cursor) ())
      (try-let [_ (digits cursor)] (Ok true))) (Ok false)))
(defun read-number (cursor: c/GqlCursor) -> (Result c/GqlToken GqlError)
  (let [start @(. cursor byte-offset) pos (c/location cursor)]
    (do (if (= (c/at cursor 0) 45) (c/advance cursor) ())
      (try-let [_ (if (= (c/at cursor 0) 48) (do (c/advance cursor) (Ok ())) (digits cursor))
                fractional (fraction cursor) exponential (exponent cursor)]
        (if (or (s/name-part? (c/at cursor 0)) (= (c/at cursor 0) 46))
          (Err (c/failure cursor "Invalid numeric token boundary"))
          (Ok (c/GqlToken (if (or fractional exponential) "float" "int") (c/text-between cursor start) pos)))))))
(defun float-value (token: c/GqlToken) -> (Result GqlValue GqlError)
  (unsafe (let [text (n/c-text (. token text)) end (alloc 8) value (strtod text end)
                consumed (- (n/address (load-ptr end)) (n/address text))]
    (do (free end) (free text)
      (if (and (= consumed (str-len (. token text))) (co/finite? value)) (Ok (FloatValue value))
        (Err (located-error ParseFailure "Invalid or non-finite Float literal" (. token location))))))))
