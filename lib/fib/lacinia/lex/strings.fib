(ns fib.lacinia.lex.strings (:use fib.core fib.seq fib.coll fib.lacinia.types)
  (:require [fib.lacinia.lex.cursor :as c]))
(defun hex :private (code: i64) -> i64
  (cond (and (>= code 48) (<= code 57)) (- code 48)
    (and (>= code 65) (<= code 70)) (- code 55) (and (>= code 97) (<= code 102)) (- code 87) :else -1))
(defun quad :private (cursor: c/GqlCursor) -> (Result i64 GqlError)
  (loop [i 0 value 0]
    (if (= i 4) (Ok value)
      (let [digit (hex (c/at cursor 0))]
        (if (< digit 0) (Err (c/failure cursor "Expected four hexadecimal digits"))
          (do (c/advance cursor) (recur (+ i 1) (+ (* value 16) digit))))))))
(defun code-string :private (cursor: c/GqlCursor value: i64) -> (Result str GqlError)
  (if (or (> value 1114111) (and (>= value 55296) (<= value 57343)))
    (Err (c/failure cursor "Invalid Unicode scalar")) (Ok (char->str (char value)))))
(defun braced :private (cursor: c/GqlCursor) -> (Result str GqlError)
  (do (c/advance cursor)
    (loop [digits 0 value 0]
      (let [code (c/at cursor 0) digit (hex code)]
        (cond (and (= code 125) (> digits 0)) (do (c/advance cursor) (code-string cursor value))
          (or (< digit 0) (>= digits 6)) (Err (c/failure cursor "Invalid braced Unicode escape"))
          :else (do (c/advance cursor) (recur (+ digits 1) (+ (* value 16) digit))))))))
(defun unicode :private (cursor: c/GqlCursor) -> (Result str GqlError)
  (if (= (c/at cursor 0) 123) (braced cursor)
    (try-let [high (quad cursor)]
      (if (and (>= high 55296) (<= high 56319))
        (if (and (= (c/at cursor 0) 92) (= (c/at cursor 1) 117))
          (do (c/advance cursor) (c/advance cursor)
            (try-let [low (quad cursor)]
              (if (and (>= low 56320) (<= low 57343))
                (code-string cursor (+ 65536 (+ (* (- high 55296) 1024) (- low 56320))))
                (Err (c/failure cursor "Expected a low surrogate")))))
          (Err (c/failure cursor "Unpaired high surrogate")))
        (code-string cursor high)))))
(defun escape :private (cursor: c/GqlCursor) -> (Result str GqlError)
  (let [code (c/at cursor 0)]
    (do (c/advance cursor)
      (cond (= code 117) (unicode cursor) (= code 110) (Ok "\n") (= code 114) (Ok "\r")
        (= code 116) (Ok "\t") (= code 98) (Ok (char->str (char 8))) (= code 102) (Ok (char->str (char 12)))
        (or (= code 34) (= code 92) (= code 47)) (Ok (char->str (char code)))
        :else (Err (c/failure cursor "Invalid string escape"))))))
(defun read-string (cursor: c/GqlCursor) -> (Result str GqlError)
  (if (and (= (c/at cursor 1) 34) (= (c/at cursor 2) 34))
    (Err (located-error UnsupportedFeature "Block strings are not implemented yet" (c/location cursor)))
    (do (c/advance cursor)
      (loop [parts: (Vec str) []]
        (let [code (c/at cursor 0)]
          (cond (= code 34) (do (c/advance cursor) (Ok (str-join parts)))
            (< code 32) (Err (c/failure cursor "Unterminated string or unescaped control character"))
            (= code 92) (do (c/advance cursor) (try-let [part (escape cursor)] (recur (conj parts part))))
            :else (do (c/advance cursor) (recur (conj parts (char->str (char code)))))))))))
