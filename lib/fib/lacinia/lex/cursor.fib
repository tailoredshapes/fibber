(ns fib.lacinia.lex.cursor (:use fib.core fib.seq fib.coll fib.lacinia.types))
(defstruct GqlCursor (text: str chars: (Vec char) index: (Cell i64) byte-offset: (Cell i64) line: (Cell i64) column: (Cell i64)))
(defstruct GqlToken (kind: str text: str location: GqlLocation))
(defun cursor (text: str) -> GqlCursor (GqlCursor text (str-chars text) (cell 0) (cell 0) (cell 1) (cell 1)))
(defun at (c: GqlCursor offset: i64) -> i64
  (let [i (+ @(. c index) offset)]
    (if (or (< i 0) (>= i (count (. c chars)))) -1 (long (nth (. c chars) i)))))
(defun location (c: GqlCursor) -> GqlLocation (GqlLocation @(. c line) @(. c column)))
(defun advance (c: GqlCursor) -> unit
  (let [code (at c 0) previous (at c -1)]
    (do (set! (. c index) (+ @(. c index) 1))
      (set! (. c byte-offset) (+ @(. c byte-offset) (cond (< code 0) 0 (< code 128) 1 (< code 2048) 2 (< code 65536) 3 :else 4)))
      (cond (= code 13) (do (set! (. c line) (+ @(. c line) 1)) (set! (. c column) 1))
            (= code 10) (do (if (!= previous 13) (set! (. c line) (+ @(. c line) 1)) ()) (set! (. c column) 1))
            :else (set! (. c column) (+ @(. c column) 1))))))
(defun text-between (c: GqlCursor start: i64) -> str
  (str-slice (. c text) start @(. c byte-offset)))
(defun failure (c: GqlCursor message: str) -> GqlError (located-error ParseFailure message (location c)))
(defun take-while (c: GqlCursor predicate: (fn (i64) bool)) -> str
  (let [start @(. c byte-offset)]
    (do (loop [] (if (predicate (at c 0)) (do (advance c) (recur)) ())) (text-between c start))))
