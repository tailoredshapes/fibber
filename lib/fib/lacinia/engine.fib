(ns fib.lacinia.engine (:use fib.core fib.seq fib.coll fib.lacinia.types fib.lacinia.syntax)
  (:require [fib.lacinia.parser :as parser] [fib.lacinia.plan :as plan]
    [fib.lacinia.plan.document :as document] [fib.lacinia.variables :as vars] [fib.lacinia.input.core :as input]
    [fib.lacinia.executor :as executor] [fib.lacinia.execute.state :as s]))
(defun prepare-request :private (schema: GqlCompiledSchema query: str supplied: (Map str GqlValue)
  name: (Option str)) -> (Result (Vec plan/GqlPreparedField) GqlError)
  (try-let [parsed (parser/parse query) selections (document/validate schema parsed) index (document/choose parsed name)]
    (let [operation (nth (. parsed operations) index) state (input/context (. schema input-objects))]
      (try-let [variables (vars/coerce state (. operation variables) supplied)]
        (plan/prepare schema state (nth selections index) variables)))))
(defun execute-selected :private (schema: GqlCompiledSchema query: str variables: (Map str GqlValue)
  context: GqlValue name: (Option str)) -> GqlResult
  (match (prepare-request schema query variables name)
    ((Err error) (GqlResult (if (= (. error kind) ArgumentFailure) (some NullValue) nil) [error]))
    ((Ok nodes) (let [state (s/execution context) value (executor/project state "Query" NullValue nodes [])]
      (GqlResult (some (unwrap-or value NullValue)) @(. state errors))))))
(defun execute (schema: GqlCompiledSchema query: str variables: (Map str GqlValue) context: GqlValue) -> GqlResult
  (execute-selected schema query variables context nil))
(defun execute-operation (schema: GqlCompiledSchema query: str variables: (Map str GqlValue)
  context: GqlValue name: str) -> GqlResult
  (execute-selected schema query variables context (some name)))
(defun execute-async (schema: GqlCompiledSchema query: str variables: (Map str GqlValue) context: GqlValue) -> (Task GqlResult)
  (spawn (fn () (execute schema query variables context))))
(defun execute-operation-async (schema: GqlCompiledSchema query: str variables: (Map str GqlValue)
  context: GqlValue name: str) -> (Task GqlResult)
  (spawn (fn () (execute-operation schema query variables context name))))
