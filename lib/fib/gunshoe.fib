       ((var fib.prelude/load-i32) ~p)))
(defmacro write-i32! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-i32) ~p ~value)))
(defmacro read-i64 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-i64) ~p)))
(defmacro write-i64! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-i64) ~p ~value)))
(defmacro read-ptr (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-ptr) ~p)))
(defmacro write-ptr! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-ptr) ~p ~value)))
(defmacro read-f32 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-f32) ~p)))
(defmacro write-f32! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-f32) ~p ~value)))
(defmacro read-f64 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-f64) ~p)))
(defmacro write-f64! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-f64) ~p ~value)))
