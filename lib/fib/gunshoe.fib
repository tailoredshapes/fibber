;; fib.gunshoe: explicit developer-responsibility operations.
;; Ordinary macros only: require this module explicitly and wrap calls in unsafe.
;; Public names differ from runtime primitives, so a value/var reference cannot
;; fall through namespace lookup to an unguarded builtin or imported function.
;; No macro supplies unsafe. Types, ownership and existing primitive checks apply.
;; The empty inline-LIR marker enforces caller lexical unsafe even when a caller
;; deliberately rebinds fib.prelude. It has no runtime effect after optimization.
;; var bypasses local capture; ordinary namespace alias resolution still applies.
;; Existing primitive and fib.atomic spellings remain available for compatibility.
(ns fib.gunshoe)

;; Raw allocation, ownership transfers, memory, uninitialized and unchecked arrays.
(defmacro allocate (bytes)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/alloc) ~bytes)))
(defmacro deallocate (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/free) ~p)))
(defmacro offset (p bytes)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/ptr+) ~p ~bytes)))
(defmacro borrow-address (value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/raw) ~value)))
(defmacro retain-address (value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/raw-retained) ~value)))
(defmacro release-address! (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/release-raw) ~p)))
(defmacro read-i8 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-i8) ~p)))
(defmacro write-i8! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-i8) ~p ~value)))
(defmacro read-i16 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-i16) ~p)))
(defmacro write-i16! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-i16) ~p ~value)))
(defmacro read-i32 (p)
