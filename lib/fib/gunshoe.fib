  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-f32x4) ~p)))
(defmacro write-f32x4! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-f32x4) ~p ~value)))
(defmacro read-f64x4 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-f64x4) ~p)))
(defmacro write-f64x4! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-f64x4) ~p ~value)))
(defmacro read-f32x8 (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-f32x8) ~p)))
(defmacro write-f32x8! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-f32x8) ~p ~value)))
(defmacro read-simd (p)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/load-simd) ~p)))
(defmacro write-simd! (p value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/store-simd) ~p ~value)))
(defmacro uninit-array-i8 (length)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/array-uninit-i8) ~length)))
(defmacro uninit-array-f32 (length)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/array-uninit-f32) ~length)))
(defmacro uninit-array-f64 (length)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/array-uninit-f64) ~length)))
(defmacro read-simd-unchecked (array index)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/simd-load-unchecked) ~array ~index)))
(defmacro write-simd-unchecked! (array index value)
  `(do (lir [] -> unit "(BLOCK entry (RET))")
       ((var fib.prelude/simd-store-unchecked!) ~array ~index ~value)))

;; Raw atomics and addresses. Callers provide lifetime, alignment and ordering.
;; Evaluate operands once into gensyms before fixed LIR names. Typed numeric
;; identity calls preserve the language's argument-literal width adoption.
(defmacro atomic-read-acquire-i64 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i64 "(BLOCK entry (RET (ATOMIC-LOAD ACQUIRE I64 gunshoe-p)))")))))
(defmacro atomic-read-relaxed-i64 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i64 "(BLOCK entry (RET (ATOMIC-LOAD MONOTONIC I64 gunshoe-p)))")))))
(defmacro atomic-read-seq-cst-i64 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i64 "(BLOCK entry (RET (ATOMIC-LOAD SEQ_CST I64 gunshoe-p)))")))))
(defmacro atomic-write-release-i64! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i64] -> unit "(BLOCK entry (ATOMIC-STORE RELEASE gunshoe-value gunshoe-p) (RET))")))))
(defmacro atomic-write-relaxed-i64! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i64] -> unit "(BLOCK entry (ATOMIC-STORE MONOTONIC gunshoe-value gunshoe-p) (RET))")))))
(defmacro atomic-write-seq-cst-i64! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i64] -> unit "(BLOCK entry (ATOMIC-STORE SEQ_CST gunshoe-value gunshoe-p) (RET))")))))
(defmacro atomic-read-acquire-i32 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i32 "(BLOCK entry (RET (ATOMIC-LOAD ACQUIRE I32 gunshoe-p)))")))))
(defmacro atomic-read-relaxed-i32 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i32 "(BLOCK entry (RET (ATOMIC-LOAD MONOTONIC I32 gunshoe-p)))")))))
(defmacro atomic-read-seq-cst-i32 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i32 "(BLOCK entry (RET (ATOMIC-LOAD SEQ_CST I32 gunshoe-p)))")))))
(defmacro atomic-write-release-i32! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i32) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i32] -> unit "(BLOCK entry (ATOMIC-STORE RELEASE gunshoe-value gunshoe-p) (RET))")))))
(defmacro atomic-write-relaxed-i32! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i32) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i32] -> unit "(BLOCK entry (ATOMIC-STORE MONOTONIC gunshoe-value gunshoe-p) (RET))")))))
(defmacro atomic-write-seq-cst-i32! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i32) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i32] -> unit "(BLOCK entry (ATOMIC-STORE SEQ_CST gunshoe-value gunshoe-p) (RET))")))))
(defmacro compare-exchange-i64! (p expected value)
  (let ((g-p (gensym "gunshoe-p")) (g-expected (gensym "gunshoe-expected")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-expected ((fn (gunshoe-operand: i64) gunshoe-operand) ~expected)) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-expected ~g-expected) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-expected: i64 gunshoe-value: i64] -> bool "(BLOCK entry (LET ((r (CMPXCHG ACQ_REL ACQUIRE gunshoe-p gunshoe-expected gunshoe-value))) (RET (EXTRACTVALUE r 1))))")))))
(defmacro fetch-add-i64! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i64] -> i64 "(BLOCK entry (RET (ATOMICRMW ADD ACQ_REL gunshoe-p gunshoe-value)))")))))
(defmacro exchange-i64! (p value)
  (let ((g-p (gensym "gunshoe-p")) (g-value (gensym "gunshoe-value")))
    `(let ((~g-p ~p) (~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-p ~g-p) (gunshoe-value ~g-value))
         (lir [gunshoe-p: ptr gunshoe-value: i64] -> i64 "(BLOCK entry (RET (ATOMICRMW XCHG ACQ_REL gunshoe-p gunshoe-value)))")))))
(defmacro acquire-fence ()
  `(lir [] -> unit "(BLOCK entry (FENCE ACQUIRE) (RET))"))
(defmacro release-fence ()
  `(lir [] -> unit "(BLOCK entry (FENCE RELEASE) (RET))"))
(defmacro seq-cst-fence ()
  `(lir [] -> unit "(BLOCK entry (FENCE SEQ_CST) (RET))"))
(defmacro pause ()
  `(lir [] -> unit "(BLOCK entry (SPIN-HINT) (RET))"))
(defmacro cache-line-bytes ()
  `(lir [] -> i64 "(BLOCK entry (RET (CACHE-LINE)))"))
(defmacro address->i64 (p)
  (let ((g-p (gensym "gunshoe-p")))
    `(let ((~g-p ~p))
       (let ((gunshoe-p ~g-p))
         (lir [gunshoe-p: ptr] -> i64 "(BLOCK entry (RET (PTRTOINT I64 gunshoe-p)))")))))
(defmacro i64->address (value)
  (let ((g-value (gensym "gunshoe-value")))
    `(let ((~g-value ((fn (gunshoe-operand: i64) gunshoe-operand) ~value)))
       (let ((gunshoe-value ~g-value))
         (lir [gunshoe-value: i64] -> ptr "(BLOCK entry (RET (INTTOPTR PTR gunshoe-value)))")))))
(defmacro inline (... arguments)
  `(lir ~@arguments))

