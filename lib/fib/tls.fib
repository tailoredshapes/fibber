;; fib.tls: a native TLS 1.3 CLIENT over fib.crypto (docs/design/tls.md, lib/fib/tls/README.md). UNAUDITED: written from the RFCs and tested against the RFC 8448 traces and
;; real servers, never reviewed by an independent cryptographer; every primitive is the crypto provider's. Explicit: `(:require [fib.tls :as tls])`.
;;
;;   (tls/https-options (default-options) provider trust)         ; registers the "https" Transport factory in fib.http.client options
;;   (tls/embedded-roots)   (tls/trust-from-file "/etc/ssl/certs/ca-certificates.crt")   (tls/system-trust)   ; trust stores, as values
;;   (tls/connect provider (tls/client-config host trust clock) io)                       ; a Session over any byte stream (an `Io`)
;;   (tls/tls-transport provider cfg transport)                                           ; a fib.http Transport over a Transport
;;
;; No global provider, no global trust, no downgrade, no revocation checking, no client certificates, no resumption, no 0-RTT, TLS 1.3 only. Errors are `TlsError` values.
(ns fib.tls (:export-from fib.tls.types fib.tls.pem fib.tls.hello fib.tls.record fib.tls.client fib.tls.conn fib.tls.http fib.tls.roots))
