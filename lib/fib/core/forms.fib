;; fib.core.forms: the binding macros of the library that are fibber macros (stdlib §4.3 rows partial2 as-> defonce; tranche 2
;; plan §5, package Y6). Exports the macros partial2, as-> and defonce. try-let, if-some, when-some and when-first are
;; Rust prelude macros since X3 (E1) and have no source here; their rows are judged by X3's cases. Replaces nothing in the
;; prelude. A macro body here uses prelude names and builtins only (`vec-count`, `vec-nth`, `gensym`, `loop`: the library
;; is not in the macro-time module, stdlib §6.3 and C2-25), and a template names a function through the facade.
;;
;; Decided here, where the page is silent:
;;  - (partial2 f a) is `(let ((gf f) (ga a)) (fn (b c) (gf ga b c)))` with all four names gensyms: f and a are evaluated
;;    once, when the closure is made, exactly as `partial` does, and b and c cannot capture a name the caller wrote in f
;;    or a. The two free parameters are fixed at two: a stand-in until L22 reads the arity from f's type (the row).
;;  - (as-> x v form ..) rebinds v in order, each form seeing the value of the one before: it expands to
;;    `(let ((v (let ((v x)) form1))) form2)`, the same shadowing a `let` of v in a row would give, so a form that uses v
;;    in two places sees one value, and x is evaluated outside the scope of v. With no form the answer is x (Clojure's).
;;    The macro does not check the name: one that is not a symbol is what `let` makes of it. A macro that traps is no
;;    check either, because under fibc a trap at expansion aborts the compiler where fibref says `macro NAME failed`.
;;  - (defonce name: T v) is `(def name: T v)`: a `def` is evaluated once before `main` (L15), so no guard is needed. The
;;    macro passes everything after the name to `def`, so the annotated and the plain spelling both work. A `def`
;;    initialiser that is not a constant is refused until L15 (X8), and so is defonce of it: case 2657.
(ns fib.core.forms (:use fib.core.base fib.core.protocols fib.core.opt fib.core.combinators))

;; (partial2 f a) is (fn (b c) (f a b c)) with f and a evaluated once
(defmacro partial2 (f a)
  (let ((gf (gensym "f")) (ga (gensym "a")) (b (gensym "b")) (c (gensym "c")))
    `(let ((~gf ~f) (~ga ~a))
       (fn (~b ~c) (~gf ~ga ~b ~c)))))

;; (as-> x v (f a v) ..): v is bound to x, then to each form in turn; the value of the last form is the answer
(defmacro as-> (x v ... forms)
  (loop ((i 0) (acc x))
    (if (< i (vec-count forms))
        (recur (+ i 1) `(let ((~v ~acc)) ~(vec-nth forms i)))
        acc)))

;; (defonce name: T v) is (def name: T v)
(defmacro defonce (name ... rest)
  `(def ~name ~@rest))

;; (wrapping e ..): inside the body, `+ - *` and `neg` wrap at the operand's width instead of trapping (spec/stdlib.md 7 L10, ADR 015; spec/types.md
;; 1.9 for vectors): each call headed by one of those symbols becomes `unchecked-add` `unchecked-subtract` `unchecked-multiply` `unchecked-negate`
;; (more than two operands fold to the left, one operand of `+` or `*` is the operand, one of `-` is the negation). The rewrite is of the written
;; code, so it reaches the arguments of a macro that is not yet expanded and a `let` or `loop` body, but not the inside of a `fn`, `quote` or
;; `quasiquote` form (a closure runs where the macro does not see it). It applies to integers and integer vectors; on a float the wrapping
;; operations are the plain ones; on any other type (a Ratio, a BigInt) it is a type error. A macro body here has no recursion and no
;; library, so the walk is a breadth-first flattening of the tree into a vector, then the rebuilding of the nodes from the last to the first.
(defmacro wrapping (... es)
  (let ((body (if (= (vec-count es) 1) (vec-nth es 0) `(do ~@es)))
        (skip? (fn (xs: (Vec Form))
                 (if (> (vec-count xs) 0)
                     (match (vec-nth xs 0) ((Sym s) (or (= s "fn") (or (= s "quote") (= s "quasiquote")))) (_ false))
                     false)))
        (op (fn (s: str) (if (= s "+") (Sym "unchecked-add") (if (= s "-") (Sym "unchecked-subtract") (Sym "unchecked-multiply"))))))
    (let ((kids-of (fn (x: Form)
                     (match x
                       ((List xs) (if (skip? xs) (vec-empty) xs))
                       ((Vec xs) xs)
                       ((Map xs) xs)
                       (_ (vec-empty)))))
          (rewrite (fn (kids: (Vec Form))
                     (match (vec-nth kids 0)
                       ((Sym s)
                        (let ((n (- (vec-count kids) 1)))
                          (cond (and (or (= s "+") (= s "*")) (= n 1)) (vec-nth kids 1)
                                (and (or (= s "-") (= s "neg")) (= n 1)) (List [(Sym "unchecked-negate") (vec-nth kids 1)])
                                (and (or (= s "+") (or (= s "-") (= s "*"))) (>= n 2))
                                  (loop ((i 3) (acc (List [(op s) (vec-nth kids 1) (vec-nth kids 2)])))
                                    (if (< i (vec-count kids)) (recur (+ i 1) (List [(op s) acc (vec-nth kids i)])) acc))
                                :else (List kids))))
                       (_ (List kids))))))
      (let ((t (loop ((ns [body]) (i 0) (starts (vec-empty)) (counts (vec-empty)))
                 (if (>= i (vec-count ns))
                     (Triple ns starts counts)
                     (let ((kids (kids-of (vec-nth ns i))))
                       (recur (loop ((j 0) (acc ns)) (if (< j (vec-count kids)) (recur (+ j 1) (vec-conj acc (vec-nth kids j))) acc))
                              (+ i 1) (vec-conj starts (vec-count ns)) (vec-conj counts (vec-count kids))))))))
        (let ((ns (. t fst)) (starts (. t snd)) (counts (. t thd)) (n (vec-count (. t fst))))
          (loop ((j (- n 1)) (rs (vec-empty)))
            (if (< j 0)
                (vec-nth rs (- n 1))
                (let ((node (vec-nth ns j)) (c (vec-nth counts j)))
                  (recur (- j 1)
                         (vec-conj rs
                                   (if (= c 0)
                                       node
                                       (let ((kids (loop ((k 0) (acc (vec-empty)))
                                                     (if (< k c)
                                                         (recur (+ k 1) (vec-conj acc (vec-nth rs (- (- n 1) (+ (vec-nth starts j) k)))))
                                                         acc))))
                                         (match node ((List _) (rewrite kids)) ((Vec _) (Vec kids)) (_ (Map kids)))))))))))))))
