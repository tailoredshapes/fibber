;; fib.core.protocols: the protocols of stdlib §2.3 that decide what a predicate, a comparator, a number
;; and a printed form are (tranche 1 plan §4.2; owner P0, the instances for the other types L1, L11).
;; Replaces nothing in the prelude. Decided here, where the page is silent:
;;  - payload of nil traps with the message `payload: nil` (it names the function, plan §4.3 rule 8; the
;;    page's sketch said `unwrap: nil`, which is L2's function).
;;  - Truthy over (Option a) is `some` and not Clojure's falsy `false` inside it: (Option bool) needs
;;    L20's checker rule, a library instance cannot tell (stdlib §2.4).
;;  - `/` is Div's method here and nowhere else: Num has no `/` since the flip (R3), the instances are
;;    fib.core.num's, so integer division is `quot` and library code never writes `/` on integers (plan PC-14).
(ns fib.core.protocols (:use fib.core.base))
;; a predicate's result is bool or an Option; Payload says what `some` returns
(defprotocol Truthy (truthy? (self) -> bool))
(impl Truthy bool (truthy? (self) self))
(impl Truthy (Option a) (truthy? (self) (match self (nil false) ((some _) true))))
(defprotocol (Payload s p) (payload (self) -> p))
(impl (Payload bool) bool (payload (self) self))
(impl (Payload a) (Option a) (payload (self) (match self ((some x) x) (nil (trap "payload: nil")))))
;; a comparator's result: an i64 (negative, zero, positive) or Clojure's predicate form
(defprotocol Cmp (resolve (self k: (fn () Self) :borrow) -> i64))
(impl Cmp i64 (resolve (self k) self))
(impl Cmp bool (resolve (self k) (if self -1 (if (k) 1 0))))
;; the witness inc, dec, abs, zero? take, because a literal has one type
(defprotocol Unit (zero (self) -> Self) (one (self) -> Self))
(impl Unit i8 (zero (self) 0i8) (one (self) 1i8))
(impl Unit i16 (zero (self) 0i16) (one (self) 1i16))
(impl Unit i32 (zero (self) 0i32) (one (self) 1i32))
(impl Unit i64 (zero (self) 0) (one (self) 1))
(impl Unit f32 (zero (self) 0.0f32) (one (self) 1.0f32))
(impl Unit f64 (zero (self) 0.0) (one (self) 1.0))
;; `/` is Div's method: the instance determines the result type (L30)
(defprotocol (Div a r) (/ (self y: a) -> r))
;; the printers: str is ToStr, pr is Debug, println is the builtin Show
(defprotocol ToStr (to-str (self) -> str))
(defprotocol Debug (debug (self) -> str))
(impl ToStr str (to-str (self) self))
;; Debug of a string is Clojure's pr: quoted, with the seven characters char-escape-string names written as
;; \" \\ \n \t \r \f \b and every other character, NUL and every scalar width included, as it is. Each escaped
;; character is one ASCII byte, which no byte of a longer UTF-8 sequence is, so the text is cut and joined on bytes.
(defun debug-escape :private (b: i8) -> str
  (cond (= b 34i8) "\\\""
        (= b 92i8) "\\\\"
        (= b 10i8) "\\n"
        (= b 9i8) "\\t"
        (= b 13i8) "\\r"
        (= b 12i8) "\\f"
        (= b 8i8) "\\b"
        true ""))
(defun debug-str :private (s: str) -> str
  (let ((bs (str-bytes s))
        (n (str-len s)))
    (loop ((i 0) (from 0) (parts (vec-conj (vec-empty) "\"")))
      (if (< i n)
          (let ((e (debug-escape (array-get bs i))))
            (if (= (str-len e) 0)
                (recur (+ i 1) from parts)
                (recur (+ i 1) (+ i 1) (vec-conj (vec-conj parts (str-slice s from i)) e))))
          (str-join (vec-conj (vec-conj parts (str-slice s from n)) "\""))))))
(impl Debug str (debug (self) (debug-str self)))
