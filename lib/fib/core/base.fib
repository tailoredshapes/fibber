;; fib.core.base: the types every part shares (tranche 1 plan §4.2; owner P0, stand-ins L4).
;; Pair, Triple and Result are the prelude's after L4; until L4 lands, the three stand-ins below are
;; here with the field names the prelude's will keep (fst snd thd; v e), and L4 deletes them in its
;; commit. Step is Clojure's `reduced` as a type: More goes on, Done is the value of a reduce-while
;; that stopped early (L5b writes the consumers over it).
(ns fib.core.base)
(defstruct (Pair a b) (fst: a snd: b))
(defstruct (Triple a b c) (fst: a snd: b thd: c))
(defenum (Result a b) (Ok v: a) (Err e: b))
;; the step of reduce-while (Clojure's reduced)
(defenum (Step a) (More v: a) (Done v: a))
(defun reduced (x: a) -> (Step a) (Done x))
