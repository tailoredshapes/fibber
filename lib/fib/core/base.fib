;; fib.core.base: the types every part shares (tranche 1 plan §4.2; owner P0).
;; Pair, Triple and Result are the prelude's (L4: lib/prelude.fib, with the field and
;; variant names fst snd thd and Ok v, Err e), so no part defines them. Step is
;; Clojure's `reduced` as a type: More goes on, Done is the value of a reduce-while
;; that stopped early (L5b writes the consumers over it).
(ns fib.core.base)
;; the step of reduce-while (Clojure's reduced)
(defenum (Step a) (More v: a) (Done v: a))
(defun reduced (x: a) -> (Step a) (Done x))
