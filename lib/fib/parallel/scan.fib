;; fib.parallel.scan: pscan, the inclusive prefix fold (P-struct, docs/design/parallelism.md 3.2).
;;
;;   (pscan combine init xs)       ; [(combine init x0) (combine (combine init x0) x1) ...]: a Vec as long as xs
;;   (pscan p combine init xs)
;;
;; Three steps, none of whose shape depends on the number of workers: (1) every chunk of the fixed grain (`reduce-grain`, 65 536, unless the
;; `Par` says otherwise) is folded from `init` in parallel, (2) the chunk totals are folded left to right on the calling thread into the
;; carry that enters each chunk, (3) every chunk is scanned in parallel, left to right, starting from its carry. So for a floating point
;; `combine` the result is the same for every worker count; it differs from the serial `reductions` in the bits, as the tree of `preduce` does
;; from `reduce`, and only the combination across chunk boundaries differs from a left to right scan when `combine` is not associative.
;; `combine` must be associative and `init` its identity. The data is read twice and written once: about 2x the memory traffic of a serial
;; scan, so the speedup is about workers / 2.
(ns fib.parallel.scan (:use fib.core fib.seq fib.coll fib.parallel.cpu fib.parallel.chunks fib.parallel.pmap))

(defun total-chunk (combine: (fn (r r) r) init: r xs: (Vec r) lo: i64 hi: i64) -> r
  (loop [i lo acc init] (if (< i hi) (recur (+ i 1) (combine acc (nth xs i))) acc)))

;; The chunk [lo, hi) scanned from `carry`, as an array.
(defun scan-chunk (combine: (fn (r r) r) carry: r xs: (Vec r) lo: i64 hi: i64) -> (Array r)
  (let [first (combine carry (nth xs lo))
        out (cell (array (- hi lo) first))]
    (do (loop [i (+ lo 1) acc first]
          (when (< i hi)
            (let [v (combine acc (nth xs i))] (do (array-set! &out (- i lo) v) (recur (+ i 1) v)))))
        @out)))

;; The carry into each chunk: carries[c] is init folded with the totals of the chunks before c.
(defun carries (combine: (fn (r r) r) init: r totals: (Vec r)) -> (Vec r)
  (loop [c 0 acc init out []]
    (if (< c (vec-count totals))
        (recur (+ c 1) (combine acc (nth totals c)) (conj out acc))
        out)))

(defun pscan-vec (p: Par combine: (fn :send (r r) r) init: r xs: (Vec r)) -> (Vec r)
  (let [n (vec-count xs)
        grain (if (> (. p grain) 0) (. p grain) (reduce-grain))]
    (if (= n 0)
        []
        (let [totals (run-chunks (. p workers) n grain (fn (lo hi) (total-chunk combine init xs lo hi)))
              cs (carries combine init totals)]
          (vec-from-array
            (concat-chunks
              (run-chunks (. p workers) n grain (fn (lo hi) (scan-chunk combine (nth cs (quot lo grain)) xs lo hi)))
              n))))))

(defn pscan
  ([combine: (fn :send (r r) r) init: r xs: (Vec r)] -> (Vec r) (pscan-vec (par) combine init xs))
  ([p: Par combine: (fn :send (r r) r) init: r xs: (Vec r)] -> (Vec r) (pscan-vec p combine init xs)))
