;; fib.parallel.chunks: the engine under pmap, pfor and the reductions (P-struct, docs/design/parallelism.md 3.2).
;;
;; `(run-chunks workers n grain body)` splits the index range [0, n) into chunks of `grain` indices (the last one is shorter),
;; runs `(body lo hi)` once for every chunk, and returns the chunk results in chunk order.
;;
;; The pool. At most `workers` tasks are ever live in one call, however many chunks there are: with W = min(workers, chunks)
;; > 1, W tasks are spawned and task w runs the chunks w, w+W, w+2W, ... (a fixed stride, so which worker runs which chunk is
;; a function of the numbers alone, and a run is repeatable). The caller only waits: it never runs a chunk itself, so a trap in
;; any chunk is isolated in a task and reaches the caller the same way whichever worker had it. W = 1 (one worker, or one chunk) runs
;; every chunk on the caller's thread with no task at all, which is what keeps one worker within a small factor of a plain loop.
;; Under `ulimit -v 16000000` about 250 live threads exhaust the address space (each allocating thread gets a 64 MB malloc arena),
;; so `fib.parallel.cpu/max-workers` (64) bounds `workers` in `par`.
;; Nested calls (a body that itself calls pmap) multiply: W x W tasks. The pool tier of docs/design/parallelism.md 3.1 will bound that;
;; until then a body of a parallel call should not start another.
;;
;; Failure. All W tasks are joined with `try-join` whatever happens, then the call traps with the message of the failed task of the
;; lowest worker number (the one that traps in a given run is not always the same one when several do, so a program that needs the
;; exact message makes one chunk fail). The chunks that did not run (a worker ends at its first trap) have no results; the call
;; has none either. What a trapped task owned is abandoned (stage 1 of exceptions).
(ns fib.parallel.chunks (:use fib.core fib.seq fib.coll fib.async fib.parallel.cpu))

;; How a call runs: the most workers it may use, the chunk size in indices (0: the call chooses), and `fast` (reductions: combine in
;; whatever order is cheapest, so the result may depend on the worker count; false by default).
(defstruct Par (workers: i64 grain: i64 fast: bool))

(defun par () -> Par (Par (cpu-count) 0 false))

;; The default grain of a reduction: the chunk of the fixed tree (docs/design/parallelism.md 3.5). A constant, never a function of
;; the worker count: that is what makes a reduction's result the same for every worker count.
(defun reduce-grain () -> i64 65536)

(defun chunk-count (n: i64 grain: i64) -> i64 (quot (+ n (- grain 1)) grain))

;; The results of the chunks w, w+step, w+2 step, ... (each chunk is [c grain, min(n, (c + 1) grain))).
(defun run-strided (body: (fn :send (i64 i64) r) n: i64 grain: i64 nc: i64 w: i64 step: i64) -> (Vec r)
  (loop [c w out []]
    (if (< c nc)
        (recur (+ c step) (conj out (body (* c grain) (min n (* (+ c 1) grain)))))
        out)))

;; The chunk results of all workers, put back in chunk order: chunk c is the (c / W)-th result of worker c mod W.
(defun interleave (parts: (Vec (Vec r)) nc: i64) -> (Vec r)
  (let [w (vec-count parts)]
    (loop [c 0 out []]
      (if (< c nc) (recur (+ c 1) (conj out (nth (nth parts (rem c w)) (quot c w)))) out))))

(defun run-chunks (workers: i64 n: i64 grain: i64 body: (fn :send (i64 i64) r)) -> (Vec r)
  (do (when (< grain 1) (trap "parallel: the grain is at least 1"))
      (let [nc (chunk-count n grain) w (max 1 (min workers nc))]
        (if (= w 1)
            (run-strided body n grain nc 0 1)
            (let [tasks (loop [k 0 ts []]
                          (if (< k w) (recur (+ k 1) (conj ts (spawn (fn () (run-strided body n grain nc k w))))) ts))
                  parts (cell [])
                  fails (cell [])]
              (do (doseq [t tasks]
                    (match (try-join t)
                      ((Ok v) (set! parts (conj @parts v)))
                      ((Err trap) (set! fails (conj @fails (. trap message))))))
                  (if (> (vec-count @fails) 0)
                      (trap (nth @fails 0))
                      (interleave @parts nc))))))))
