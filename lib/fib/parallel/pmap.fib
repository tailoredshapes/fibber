;; fib.parallel.pmap: chunked, order-preserving pmap and pfor (P-struct, docs/design/parallelism.md 3.2).
;;
;;   (pmap f xs)            ; a Vec, as Clojure's pmap but in chunks: at most (cpu-count) tasks, each running a stride of chunks
;;   (pmap par f xs)        ; the same with explicit workers and grain: (Par 8 512 false), or (with (par) (workers 8))
;;   (pmap-n f n)           ; (map f (range n)) as a Vec, in parallel
;;   (pfor n f)             ; (f i) for effect, i in [0, n), in chunks
;;
;; The result of a chunk is a Vec; the chunks are concatenated in order. (`pmap-array` of fib.parallel.tiles writes the
;; results of a numeric function straight into one pre-sized array through disjoint windows; the measurement of both is in
;; docs/design/parallelism.md 3.2.) `f` runs in a task: it is `:send`, so what it captures must be sendable (an array or a
;; Vec is shared, a Cell is refused), and its effects on shared state go through atoms. The result order is the input order, and
;; the results are the same as `(mapv f xs)`'s for any worker count and grain.
;; The default grain is max(1, n / (8 workers)): eight chunks per worker, so a slow chunk does not leave the others idle for long.
(ns fib.parallel.pmap (:use fib.core fib.seq fib.coll fib.parallel.cpu fib.parallel.chunks))

(defun auto-grain (p: Par n: i64) -> i64
  (cond (> (. p grain) 0) (. p grain)
        (<= (. p workers) 1) n
        :else (max 1 (quot n (* 8 (. p workers))))))

;; A closure that every worker calls is one object whose count each call touches (a call retains the closure and its body releases it): an atomic
;; pair on a SHARED count, 60 ns at 8 threads (P-count-b, docs/shootout/parallel.md). Each chunk function below calls a `private-copy` of the closure
;; it was given: a count of its own, 1 to 2 ns a call, and the values the closure captured are retained once per chunk, not once per call.
;; A chunk is thousands of elements, so the copy (an allocation and a retain per captured value) is noise.
;; A chunk's results as an array: the first result sizes it (an array needs an element), the rest are stored in place.
;; Arrays, not Vecs: filling an array is 3 ns an element and `vec-from-array` 5, a `conj` loop 60 (measured, docs/design/parallelism.md 3.2).
(defun map-chunk (f0: (fn (a) b) xs: (Vec a) lo: i64 hi: i64) -> (Array b)
  (let [f (private-copy f0)
        out (cell (array (- hi lo) (f (nth xs lo))))]
    (do (loop [i (+ lo 1)] (when (< i hi) (do (array-set! &out (- i lo) (f (nth xs i))) (recur (+ i 1)))))
        @out)))

(defun index-chunk (f0: (fn (i64) b) lo: i64 hi: i64) -> (Array b)
  (let [f (private-copy f0)
        out (cell (array (- hi lo) (f lo)))]
    (do (loop [i (+ lo 1)] (when (< i hi) (do (array-set! &out (- i lo) (f i)) (recur (+ i 1)))))
        @out)))

;; The chunk arrays, in order, as one array of n elements (n > 0).
(defun concat-chunks (parts: (Vec (Array b)) n: i64) -> (Array b)
  (if (= (vec-count parts) 1)
      (nth parts 0)
      (let [out (cell (array n (array-get (nth parts 0) 0)))]
        (do (loop [c 0 at 0]
              (when (< c (vec-count parts))
                (let [part (nth parts c)]
                  (do (dotimes (i (array-len part)) (array-set! &out (+ at i) (array-get part i)))
                      (recur (+ c 1) (+ at (array-len part)))))))
            @out))))

;; The engine of every map: `(chunk-fn lo hi)` makes the array of the results of the indices [lo, hi) (hi > lo), and the chunk arrays are put
;; together in order. `pmap`, `pmap-n` and the macros `pmap-each` and `pmap-range` of fib.parallel are this with a chunk function.
(defun pmap-chunks-array (p: Par n: i64 chunk-fn: (fn :send (i64 i64) (Array b))) -> (Array b)
  (concat-chunks (run-chunks (. p workers) n (auto-grain p n) chunk-fn) n))

;; A Vec result of many elements is built from leaves cut by the tasks that made the elements (`vec-chunk-leaves`, prelude): the grain is a multiple of 32 so that every
;; chunk but the last is whole leaves, and the serial part of the call is one pointer per 32 elements instead of two passes over every element (a copy into one array, and
;; `vec-from-array`: at 1e8 elements those two passes were most of the call, which is why pmap did not scale: docs/shootout/parallel.md). Below LEAF-MIN results the old path
;; is kept: the grain of a small call is its own (an 8-chunk call over 64 elements stays 8 chunks) and the serial part is nothing.
(def LEAF-MIN: i64 8192)

(defun leaf-grain (g: i64) -> i64 (shl (shr (+ g 31) 5) 5))

(defun pmap-chunks (p: Par n: i64 chunk-fn: (fn :send (i64 i64) (Array b))) -> (Vec b)
  (cond (<= n 0) []
        (< n LEAF-MIN) (vec-from-array (pmap-chunks-array p n chunk-fn))
        :else (vec-join-leaves (run-chunks (. p workers) n (leaf-grain (auto-grain p n))
                                           (fn (lo hi) (vec-chunk-leaves (chunk-fn lo hi) (>= hi n)))))))

(defn pmap
  ([f: (fn :send (a) b) xs: (Vec a)] -> (Vec b) (pmap-chunks (par) (vec-count xs) (fn (lo hi) (map-chunk f xs lo hi))))
  ([p: Par f: (fn :send (a) b) xs: (Vec a)] -> (Vec b) (pmap-chunks p (vec-count xs) (fn (lo hi) (map-chunk f xs lo hi)))))

(defn pmap-n
  ([f: (fn :send (i64) b) n: i64] -> (Vec b) (pmap-chunks (par) n (fn (lo hi) (index-chunk f lo hi))))
  ([p: Par f: (fn :send (i64) b) n: i64] -> (Vec b) (pmap-chunks p n (fn (lo hi) (index-chunk f lo hi)))))

(defun each-chunk (f0: (fn (i64) unit) lo: i64 hi: i64) -> unit
  (let [f (private-copy f0)]
    (loop [i lo] (when (< i hi) (do (f i) (recur (+ i 1)))))))

;; The engine of every for-effect call: `(chunk-fn lo hi)` runs the indices [lo, hi).
(defun pfor-chunks (p: Par n: i64 chunk-fn: (fn :send (i64 i64) unit)) -> unit
  (when (> n 0)
    (do (run-chunks (. p workers) n (auto-grain p n) chunk-fn) ())))

(defn pfor
  ([n: i64 f: (fn :send (i64) unit)] -> unit (pfor-chunks (par) n (fn (lo hi) (each-chunk f lo hi))))
  ([p: Par n: i64 f: (fn :send (i64) unit)] -> unit (pfor-chunks p n (fn (lo hi) (each-chunk f lo hi)))))

;; pmap over a lazy sequence (or any source), in windows: `workers x 8 x grain` items are realised on the CALLING thread into a Vec (a lazy
;; sequence holds a Cell and cannot cross a task, stdlib S10), mapped in chunks by the workers, and the next window is realised after
;; that. Memory in flight is one window, the order is the source's. The grain defaults to 64 here (a seq's items cost something to make).
;; The result is the Vec of all the results, so the source must be finite.
(defun pmap-seq (p: Par f: (fn :send (a) b) c: c) :where ((Reducible c a)) -> (Vec b)
  (let [g (if (> (. p grain) 0) (. p grain) 64)
        k (* (max 1 (. p workers)) 8 g)
        q (with p (grain g))]
    (loop [s (drop 0 c) out []]
      (let [chunk (vec (take k s))]
        (if (= (vec-count chunk) 0)
            out
            (recur (drop k s) (into out (pmap-chunks q (vec-count chunk) (fn (lo hi) (map-chunk f chunk lo hi))))))))))
