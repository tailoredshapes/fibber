;; fib.parallel.cpu: how many workers a parallel call may use (P-struct, docs/design/parallelism.md 3.2).
;;
;; `(cpu-count)` is the number of CPUs this process may run on, as far as it can be told without a C call that
;; only one platform has:
;;   1. `sysconf(_SC_NPROCESSORS_ONLN)` (`fib.os/available-cpus`): the CPUs the machine has online. It IGNORES the
;;      process's affinity mask and a cgroup quota, so by itself it over-counts under `taskset`, `docker --cpus` and
;;      most container runtimes.
;;   2. the affinity mask: the `Cpus_allowed_list:` line of /proc/self/status (what `sched_getaffinity` reports; read
;;      as text so that nothing but `fib.os` is linked and the module still builds where there is no /proc: the
;;      line is then absent and this step is skipped).
;;   3. a cgroup quota: cgroup v2 `/sys/fs/cgroup/cpu.max` ("max PERIOD" or "QUOTA PERIOD"), else cgroup v1
;;      `/sys/fs/cgroup/cpu/cpu.cfs_quota_us` and `cpu.cfs_period_us`; the quota is rounded UP to whole CPUs. Only the
;;      root of the cgroup tree is read, not the path of /proc/self/cgroup: a process in a nested group with its own,
;;      tighter cpu.max sees the root file and so can over-count. That is a known limit, documented rather than fixed.
;; The answer is the least of those that exist, never below 1 and never above `max-workers`.
;;
;; `max-workers` bounds the pool: under `ulimit -v 16000000` about 250 live threads exhaust the address space,
;; because every allocating thread gets a 64 MB malloc arena; a pool of at most `max-workers` threads never gets near that.
(ns fib.parallel.cpu (:use fib.core fib.seq fib.coll fib.os))

(defun max-workers () -> i64 64)

;; The runs of ASCII digits in the bytes, as numbers, in order ("200000 100000" is [200000 100000], "max 100000" is [100000]).
(defun digit-runs (b: (Array i8)) -> (Vec i64)
  (let [out (cell [])]
    (do (loop [i 0 cur -1]
          (if (< i (array-len b))
              (let [c (sext i64 (array-get b i))]
                (if (and (>= c 48) (<= c 57))
                    (recur (+ i 1) (+ (* (max cur 0) 10) (- c 48)))
                    (do (when (>= cur 0) (set! out (conj @out cur))) (recur (+ i 1) -1))))
              (when (>= cur 0) (set! out (conj @out cur)))))
        @out)))

;; The number of CPUs in a Linux cpu list: "0-3,8,10-11" is 4 + 1 + 2 = 7. A byte that is not a digit, '-' or ',' ends the list.
(defun cpu-list-count (b: (Array i8)) -> i64
  (loop [i 0 cur -1 lo -1 total 0]
    (let [c (if (< i (array-len b)) (sext i64 (array-get b i)) 10)]
      (cond (and (>= c 48) (<= c 57)) (recur (+ i 1) (+ (* (max cur 0) 10) (- c 48)) lo total)
            (= c 45) (recur (+ i 1) -1 cur total)
            (= c 44) (recur (+ i 1) -1 -1 (+ total (if (< cur 0) 0 (if (>= lo 0) (+ (- cur lo) 1) 1))))
            :else (+ total (if (< cur 0) 0 (if (>= lo 0) (+ (- cur lo) 1) 1)))))))

(defun file-bytes :private (path: str) -> (Option (Array i8))
  (match (read-file-bytes path 65536) ((Ok b) (some b)) ((Err e) nil)))

;; The CPUs the affinity mask allows, or 0 when /proc/self/status does not say.
(defun affinity-cpus () -> i64
  (match (file-bytes "/proc/self/status")
    ((some b)
      (let [text (str-from-bytes b) key "Cpus_allowed_list:"]
        (match (str-find text key 0)
          ((some at) (let [rest (str-bytes (subs text (+ at (str-len key))))] (cpu-list-count (array-drop-ws rest))))
          (nil 0))))
    (nil 0)))

;; The bytes without leading blanks (spaces and tabs).
(defun array-drop-ws (b: (Array i8)) -> (Array i8)
  (let [k (loop [i 0] (if (and (< i (array-len b)) (or (= (array-get b i) 32i8) (= (array-get b i) 9i8))) (recur (+ i 1)) i))]
    (let [out (cell (array (- (array-len b) k) 0i8))]
      (do (dotimes (i (- (array-len b) k)) (array-set! &out i (array-get b (+ k i)))) @out))))

;; ceil(quota / period) from a quota and a period in microseconds; 0 when there is none.
(defun quota-cpus (quota: i64 period: i64) -> i64
  (if (and (> quota 0) (> period 0)) (quot (+ quota (- period 1)) period) 0))

;; The cgroup CPU quota in whole CPUs, or 0 when there is none (or no cgroup files).
(defun cgroup-cpus () -> i64
  (match (file-bytes "/sys/fs/cgroup/cpu.max")
    ((some b) (let [n (digit-runs b)]
                (if (= (vec-count n) 2) (quota-cpus (nth n 0) (nth n 1)) 0)))
    (nil (match (file-bytes "/sys/fs/cgroup/cpu/cpu.cfs_quota_us")
           ((some q) (match (file-bytes "/sys/fs/cgroup/cpu/cpu.cfs_period_us")
                       ((some p) (let [qn (digit-runs q) pn (digit-runs p)]
                                   (if (and (= (vec-count qn) 1) (= (vec-count pn) 1)) (quota-cpus (nth qn 0) (nth pn 0)) 0)))
                       (nil 0)))
           (nil 0)))))

;; The lesser of `best` and `x`, where 0 means "not known" for `x`.
(defun lesser-known (best: i64 x: i64) -> i64 (if (and (> x 0) (< x best)) x best))

;; The least of the counts that are known (0 is not), clamped to [1, max-workers].
(defun least-known (online: i64 affinity: i64 quota: i64) -> i64
  (max 1 (min (max-workers) (lesser-known (lesser-known (if (> online 0) online (max-workers)) affinity) quota))))

(defun online-cpus () -> i64 (match (available-cpus) ((Ok n) n) ((Err e) 0)))

;; The number of workers a parallel call uses unless it is told otherwise.
(defun cpu-count () -> i64 (least-known (online-cpus) (affinity-cpus) (cgroup-cpus)))
