;; fib.string.view: `str/chars`, the explicit view of a string as a source of characters (owner L10b;
;; stdlib §4.7 row `chars`, §2.9; tranche 1 plan §6 L10b). `Chars` and its `Reducible char` instance are
;; L10a's (`fib.seq.chars`: a struct over the string, one decoder, no array per walk); this is the
;; one function that makes it, the `(Chars s)` that part's header promises. A `str` is itself a
;; `Reducible char`, so `str/chars` is the spelling that says "walk the characters" at a call site
;; that would otherwise pass a string to a function that wants a sequence of strings.
(ns fib.string.view (:use fib.seq))

(defun chars (s: str) -> Chars (Chars s))
