;; fib.string.case: `str/upper-case`, `str/lower-case` and `str/capitalize` (stdlib §4.7 rows; package LIB-2): Unicode full case mapping, locale
;; independent, over the tables of fib.string.unicode (generated from Unicode 16.0.0). The row says Unicode, so an ASCII-only version would be
;; a deviation; the cost is that a program requiring fib.string has the tables in its source (a program that reaches none of the three
;; functions does not have them in its binary: they are string literals inside functions). See fib.string.unicode for the rules (ß, final sigma).
(ns fib.string.case (:require [fib.string.unicode :as uc]))

(defun upper-case (s: str) -> str (uc/upper-case s))
(defun lower-case (s: str) -> str (uc/lower-case s))
(defun capitalize (s: str) -> str (uc/capitalize s))
