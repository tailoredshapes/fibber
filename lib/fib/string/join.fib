;; fib.string.join: `str/join` (owner L10b; stdlib §4.7, §3 N9; tranche 1 plan §6 L10b). Replaces the
;; prelude's `str-join`, which takes a `(Vec str)` only and which stays (M keeps it).
;; Decided here, where the page is silent:
;;  - `(str/join c)` is `(str/join "" c)` (package LIB-2: arity overloading landed with L1) and `(str/join sep c)` takes the separator and the source over any
;;    `(Reducible c e)` whose element is a `(ToStr e)`. The unqualified prelude `str-join` stays `(Vec str) -> str` with no separator: the compiler uses it
;;    in 1791 places and a prelude function cannot have clauses (the expander reads `NAME$N` clauses per module, and a bare `str-join` call in another module
;;    would be `unbound name`: tried, then reverted); the separator form is `str/join`.
;;  - the text is built in one pass over the source: each element is turned into its `to-str` text
;;    once and held, then the total length is known and one byte array is filled and made a `str`
;;    (the prelude's `str-join` idea): no `str-concat` per element, which would copy the text so far
;;    each time. The elements are read through `str-byte-at`, so no array is made per element.
;;  - the name is always qualified: an unqualified `join` is the task-wait builtin (§3 N9).
(ns fib.string.join (:use fib.core fib.seq))

;; the bytes of piece, written into buf from pos on; the next position
(defun write-piece :private (buf: (Cell (Array i8)) pos: i64 piece: str) -> i64
  (let ((n (str-len piece)))
    (do (dotimes (j n) (array-set! &buf (+ pos j) (str-byte-at piece j)))
        (+ pos n))))

;; the parts and the separators between them, written into one array of `total` bytes (the length of the parts and of the
;; separators), which becomes the str. The walk is leaf by leaf (vec-each-from), not an index and a descent of the trie per part.
(defun join-parts :private (sep: str parts: (Vec str) total: i64) -> str
  (let ((buf (cell (array total 0i8)))
        (pos (cell 0))
        (i (cell 0)))
    (do (fib.prelude/vec-each-from parts 0
          (fn (p) (do (set! pos (write-piece buf (if (> @i 0) (write-piece buf @pos sep) @pos) p))
                      (set! i (+ @i 1))
                      true)))
        (str-from-bytes @buf))))

;; The parts are collected by the bulk builder (vec-collect: two objects for every 32 parts), not by a conj onto a vector held
;; in a cell: the read of the cell makes the vector shared, so every conj copied the tail of up to 32 parts. The length of the
;; text is summed on the way, so there is no pass for it.
(defn join
  ([c: c] :where ((Reducible c e) (ToStr e)) -> str
  (join-with "" c))
  ([sep: str c: c] :where ((Reducible c e) (ToStr e)) -> str
  (join-with sep c)))

(defun join-with :private (sep: str c: c) :where ((Reducible c e) (ToStr e)) -> str
  (let ((len (cell 0))
        (n (cell 0))
        (parts (fib.prelude/vec-collect
                 (fn (k) (each-while c (fn (x) (let ((p (to-str x)))
                                                 (do (set! len (+ @len (str-len p))) (set! n (+ @n 1)) (k p)))))))))
    (join-parts sep parts (+ @len (* (str-len sep) (if (> @n 0) (- @n 1) 0))))))
