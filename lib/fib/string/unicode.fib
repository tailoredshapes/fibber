;; fib.string.unicode: the Unicode 16.0.0 character data behind `str/upper-case`, `str/lower-case`, `str/capitalize` and the `Character` module
;; (stdlib §4.7, §4.8; package LIB-2). An EXPLICIT module: `(:require [fib.string.unicode :as uc])`; a program that does not require it, or
;; reaches none of these functions, contains none of the tables (they are string literals inside the functions of fib.string.unicode.data,
;; generated by scripts/gen-unicode.py from the files scripts/fetch-unicode.sh pins by sha256; ADR 0020).
;; Everything takes and answers a code point as an i64 unless it says `char` or `str`. A lookup is a binary search over fixed-width records read
;; with `str-byte-at`: no allocation and no state (ADR 0013). Decided here, where the page is silent:
;;  - `category` is the two-letter general category ("Lu", "Nd", ..., "Cn" for an unassigned code point and "Cs" for a surrogate).
;;  - `upper-case` and `lower-case` are Java's `String.toUpperCase(Locale.ROOT)` and `toLowerCase(Locale.ROOT)`: the simple one-to-one
;;    mappings of UnicodeData.txt, the unconditional full mappings of SpecialCasing.txt first (ß is SS, İ is i and U+0307, ﬁ is FI, ..), and
;;    the one conditional rule Java applies without a locale, the final sigma: Σ lowercases to ς when a cased letter precedes it and none
;;    follows. "Cased" is Lu, Ll, Lt, Other_Uppercase or Other_Lowercase, and the characters skipped between are Mn, Me, Cf, Lm, Sk and the
;;    apostrophe, full stop, colon and middle dot, which is Java's rule for the cases that matter and not the whole of Case_Ignorable. The
;;    Turkish, Azeri and Lithuanian conditional mappings are not applied (locale independent, the row).
;;  - `capitalize` is Clojure's: the first character upper-cased as `upper-case` does and the rest lower-cased (not title case).
;;  - `white-space?` is Java's `Character.isWhitespace`: Zs, Zl and Zp except the no-break spaces U+00A0, U+2007, U+202F, and U+0009 to
;;    U+000D and U+001C to U+001F. `fib.char/whitespace?` is the Unicode White_Space property, a different set (docs there).
;;  - `upper?` and `lower?` are `isUpperCase` and `isLowerCase`: the category Lu (Ll) or the Other_Uppercase (Other_Lowercase) property.
(ns fib.string.unicode (:use fib.core fib.seq) (:require [fib.string.unicode.data :as d]))

(defun hex-digit :private (b: i8) -> i64
  (let ((c (zext i64 b))) (if (< c 58) (- c 48) (- c 87))))

;; the n hex digits of t at byte offset at
(defun hex-at :private (t: str at: i64 n: i64) -> i64
  (loop ((k 0) (v 0))
    (if (= k n) v (recur (+ k 1) (bit-or (shl v 4) (hex-digit (str-byte-at t (+ at k))))))))

;; the index of the last record of width w whose first 6 hex digits are <= cp, or -1
(defun last-at-or-before :private (t: str w: i64 cp: i64) -> i64
  (loop ((lo 0) (hi (- (quot (str-len t) w) 1)) (found -1))
    (if (> lo hi)
        found
        (let ((mid (quot (+ lo hi) 2)))
          (if (<= (hex-at t (* mid w) 6) cp)
              (recur (+ mid 1) hi mid)
              (recur lo (- mid 1) found))))))

;; the general category of the code point cp as the two bytes packed, first letter times 256 plus the second
(defun category-id (cp: i64) -> i64
  (if (or (< cp 0) (> cp 1114111))
      (cat-id "Cn")
      (let ((t (d/gc-table)))
        (let ((i (last-at-or-before t 8 cp)))
          (+ (* 256 (zext i64 (str-byte-at t (+ (* i 8) 6)))) (zext i64 (str-byte-at t (+ (* i 8) 7))))))))

;; "Lu" for 76 * 256 + 117 and so on
(defun category (cp: i64) -> str
  (let ((id (category-id cp)))
    (str-from-bytes (array-of-2 (trunc i8 (quot id 256)) (trunc i8 (rem id 256))))))

(defun array-of-2 :private (a: i8 b: i8) -> (Array i8)
  (let ((arr (cell (array 2 0i8))))
    (do (array-set! &arr 0 a) (array-set! &arr 1 b) @arr)))

(defun cat-id :private (name: str) -> i64
  (+ (* 256 (zext i64 (str-byte-at name 0))) (zext i64 (str-byte-at name 1))))

(defun major (cp: i64) -> i64 (quot (category-id cp) 256))

(defun letter? (cp: i64) -> bool (= (major cp) 76))
(defun digit? (cp: i64) -> bool (= (category-id cp) (cat-id "Nd")))
(defun letter-or-digit? (cp: i64) -> bool (or (letter? cp) (digit? cp)))

;; whether cp lies in one of the 12-byte (start, end) ranges of t
(defun in-ranges? :private (t: str cp: i64) -> bool
  (let ((i (last-at-or-before t 12 cp)))
    (and (>= i 0) (<= cp (hex-at t (+ (* i 12) 6) 6)))))

(defun upper? (cp: i64) -> bool (or (= (category-id cp) (cat-id "Lu")) (in-ranges? (d/other-upper-table) cp)))
(defun lower? (cp: i64) -> bool (or (= (category-id cp) (cat-id "Ll")) (in-ranges? (d/other-lower-table) cp)))

(defun white-space? (cp: i64) -> bool
  (or (and (>= cp 9) (<= cp 13))
      (and (>= cp 28) (<= cp 31))
      (and (!= cp 160) (and (!= cp 8199) (and (!= cp 8239)
           (let ((id (category-id cp))) (or (= id (cat-id "Zs")) (or (= id (cat-id "Zl")) (= id (cat-id "Zp"))))))))))

;; the simple one-to-one mapping of a 12-byte (code point, mapped) table
(defun simple-map :private (t: str cp: i64) -> i64
  (let ((i (last-at-or-before t 12 cp)))
    (if (and (>= i 0) (= (hex-at t (* i 12) 6) cp)) (hex-at t (+ (* i 12) 6) 6) cp)))

(defun upper-cp (cp: i64) -> i64 (simple-map (d/upper-table) cp))
(defun lower-cp (cp: i64) -> i64 (simple-map (d/lower-table) cp))

(defun upper-char (c: char) -> char (i32->char (trunc i32 (upper-cp (zext i64 (char->i32 c))))))
(defun lower-char (c: char) -> char (i32->char (trunc i32 (lower-cp (zext i64 (char->i32 c))))))

;; the three code points (000000 pads) of the SpecialCasing entry of cp at offset off (6 for lower, 24 for upper), or the empty vector
(defun special :private (cp: i64 off: i64) -> (Vec i64)
  (let ((t (d/special-table)))
    (let ((i (last-at-or-before t 42 cp)))
      (if (and (>= i 0) (= (hex-at t (* i 42) 6) cp))
          (loop ((k 0) (out (vec-empty)))
            (if (< k 3)
                (let ((v (hex-at t (+ (+ (* i 42) off) (* k 6)) 6)))
                  (recur (+ k 1) (if (= v 0) out (vec-conj out v))))
                out))
          (vec-empty)))))

(defun cased? :private (cp: i64) -> bool
  (let ((id (category-id cp)))
    (or (= id (cat-id "Lu")) (or (= id (cat-id "Ll")) (or (= id (cat-id "Lt")) (or (in-ranges? (d/other-upper-table) cp) (in-ranges? (d/other-lower-table) cp)))))))

(defun ignorable? :private (cp: i64) -> bool
  (let ((id (category-id cp)))
    (or (= id (cat-id "Mn")) (or (= id (cat-id "Me")) (or (= id (cat-id "Cf")) (or (= id (cat-id "Lm")) (or (= id (cat-id "Sk"))
        (or (= cp 39) (or (= cp 46) (or (= cp 58) (= cp 183)))))))))))

;; a cased letter before index i (skipping the ignorable), none after it
(defun final-sigma? :private (cps: (Vec i64) i: i64) -> bool
  (let ((before (loop ((j (- i 1)))
                  (if (< j 0) false (if (ignorable? (vec-nth cps j)) (recur (- j 1)) (cased? (vec-nth cps j))))))
        (after (loop ((j (+ i 1)))
                 (if (>= j (vec-count cps)) false (if (ignorable? (vec-nth cps j)) (recur (+ j 1)) (cased? (vec-nth cps j)))))))
    (and before (not after))))

(defun scalars :private (s: str) -> (Vec i64)
  (mapv (fn (c: char) (zext i64 (char->i32 c))) (str-chars s)))

(defun cp->str :private (cp: i64) -> str (char->str (i32->char (trunc i32 cp))))

(defun upper-case (s: str) -> str
  (let ((cps (scalars s)))
    (str-join (mapv (fn (cp: i64)
                      (let ((sp (special cp 24)))
                        (if (> (vec-count sp) 0) (str-join (mapv cp->str sp)) (cp->str (upper-cp cp)))))
                    cps))))

(defun lower-case (s: str) -> str
  (let ((cps (scalars s)))
    (str-join (loop ((i 0) (out (vec-empty)))
                (if (< i (vec-count cps))
                    (let ((cp (vec-nth cps i)))
                      (recur (+ i 1)
                             (vec-conj out
                               (if (and (= cp 931) (final-sigma? cps i))
                                   "ς"
                                   (let ((sp (special cp 6)))
                                     (if (> (vec-count sp) 0) (str-join (mapv cp->str sp)) (cp->str (lower-cp cp))))))))
                    out)))))

(defun capitalize (s: str) -> str
  (let ((cs (str-chars s)))
    (if (= (vec-count cs) 0)
        s
        (let ((first-cp (zext i64 (char->i32 (vec-nth cs 0)))))
          (str-concat (upper-case (cp->str first-cp))
                      (lower-case (str-join (mapv char->str (vec-between cs 1 (vec-count cs))))))))))

(defun vec-between :private (v: (Vec e) a: i64 b: i64) -> (Vec e)
  (loop ((i a) (acc (vec-empty)))
    (if (< i b) (recur (+ i 1) (vec-conj acc (vec-nth v i))) acc)))
