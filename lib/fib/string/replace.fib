;; fib.string.replace: `str/replace` and `str/replace-first` (stdlib §4.7 rows clojure.string/replace and replace-first; package FOLLOWUP-1). The cutting is `Pattern`'s
;; `replace-by` (part `fib.string.pattern`), so one function serves every pattern:
;;  - the match is a `str` or a `char` (taken literally) or a `Regex` (fib.regex);
;;  - the replacement is a `str`: for a `str` or `char` match it is the literal text, `$` and `\` mean nothing; for a `Regex` match it is Java's template (`$1`, `\$`),
;;    as Clojure's. `(str/replace s "." "$1")` puts the text `$1` in; `(str/replace s (re-pattern "(a)") "$1$1")` doubles an a. `re-quote-replacement` makes a template literal.
;;  - `replace` is every match, left to right and not overlapping, `replace-first` the first only; a text with no match comes back as it is.
;;  - an empty `str` matches between every two characters and at both ends, as Java's `"abc".replace("", "-")`: `-a-b-c-`; it never cuts inside a character.
;;  - byte offsets throughout, the cost linear in the text plus the replacements (one pass finds the matches, one array of the exact length is written).
;;  - a function replacement is `str/replace-with` (fib.regex) until L23, as the row says.
;; The names are always qualified (`str/replace`): an unqualified `replace` is Clojure's `(replace smap coll)` of the sequence library.
(ns fib.string.replace (:use fib.core fib.string.pattern))

(defun replace (s: str p: p to: str) :where ((Pattern p)) -> str (replace-by p s to -1))

(defun replace-first (s: str p: p to: str) :where ((Pattern p)) -> str (replace-by p s to 1))
