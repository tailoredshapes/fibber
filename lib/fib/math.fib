;; fib.math (alias `math`, stdlib §4.10): so far `sqrt` only, which the n-body shootout program needs.
;; sqrt is IEEE-exact (correctly rounded), so libm's `sqrt` gives the one answer in the interpreter and the
;; compiled program. The spec makes it a builtin (§7 L11); until that lands this is the library function:
;; the unsafe is here, in the library, never in a program that calls math/sqrt. Remove with the builtin.
(ns fib.math (:require [fib.math.libm :as libm]))

(defun sqrt (x: f64) -> f64 (unsafe (libm/sqrt x)))
