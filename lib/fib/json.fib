;; fib.json: JSON, fast, as plain data (docs/design/json.md). Explicit: `(:require [fib.json :as json])`.
;;
;;   (json/parse text)                  -> (Result Json JsonError)      the DOM: JNull JBool JInt JFloat JBig JStr JArr JObj, objects in source order
;;   (json/parse-bytes bytes)  (json/read-file path)  (json/parse-with text opts)         the same from bytes (UTF-8 checked), a file, with options
;;   (json/write j) (json/write-pretty j) (json/write-with j (WriteOptions indent ascii)) (json/write-bytes j) (json/write-to fd j) (json/write-file path j)
;;   (json/get-key j "k") (json/get-index j 2) (json/get-in j ["a" "0" "b"]) (json/pointer j "/a/0/b")           lookups: Options
;;   (json/tape text)                   -> (Result Doc JsonError)       the zero-copy front: one validating pass, no allocation per value
;;   (json/field d i "k") (json/elem d i 2) (json/path d ["a" "b"])    node indices (-1 when absent); (json/node-str d i) (json/node-i64 d i) (json/node-f64 d i) (json/node-bool d i) -> Option
;;   (json/node->json d i)              a subtree as a Json
;;   (json/doc-write d) (json/doc-write-node d i) (json/doc-write-bytes d i)   a Doc written back compact without a Json: strings and numbers are copied as the source spelled them
;;   (json/reduce-events d f init)      SAX: f gets (acc, JsonEvent) per token         (json/documents text) a text of several documents (NDJSON or concatenated)
;;   (json/reduce-lines path opts f init)   a file of one document per line in chunks: bounded memory   (json/reduce-lines-par path opts f init) the same on all cores (lines only)
;;   (json/parse-lines text opts)            the documents of a text of one per line, parsed in parallel, in order
;;   (->json x)  (json/json->datum j)  (json/datum->json d)                    plain data and fib.datum
;; Errors are values: a JsonError has a code, a message, the byte offset, the line and the column; nothing here traps on input.
(ns fib.json
  (:use fib.core fib.seq fib.coll fib.datum fib.json.types fib.json.convert)
  (:export-from fib.json.types)
  (:require [fib.os :as os] [fib.json.parse :as p] [fib.json.write :as w] [fib.json.access :as a] [fib.json.tapebuild :as tb] [fib.json.view :as v]
            [fib.json.events :as ev] [fib.json.io :as io] [fib.json.domfast :as df] [fib.json.lines :as ln] [fib.json.convert :as cv] [fib.json.tape :as tp] [fib.json.docwrite :as dw]))

(defun parse (s: str) -> (Result Json JsonError) (df/parse-fast-default s))
(defun parse-with (s: str o: JsonOptions) -> (Result Json JsonError) (df/parse-with-fast s o))
(defun parse-bytes (b: (Array i8)) -> (Result Json JsonError) (df/parse-bytes-with-fast b (default-options)))
(defun parse-bytes-with (b: (Array i8) o: JsonOptions) -> (Result Json JsonError) (df/parse-bytes-with-fast b o))
(defun read-file (path: str) -> (Result Json JsonError) (io/read-file-json path))
(defun read-file-with (path: str o: JsonOptions) -> (Result Json JsonError) (io/read-file-with path o))
(defun documents (s: str) -> (Vec (Result Json JsonError)) (io/fold-lines s (default-options) (fn (acc: (Vec (Result Json JsonError)) r: (Result Json JsonError)) (conj acc r)) []))
(defun reduce-lines (path: str o: JsonOptions f: (fn (a (Result Json JsonError)) a) init: a) -> (Result a JsonError) (io/reduce-lines path o f init))

(defun reduce-lines-par (path: str o: JsonOptions f: (fn (a (Result Json JsonError)) a) init: a) -> (Result a JsonError) (io/reduce-lines-par path o f init))
(defun parse-lines (s: str o: JsonOptions) -> (Vec (Result Json JsonError)) (ln/parse-lines s o))

(defun write (j: Json) -> str (w/write j))
(defun write-pretty (j: Json) -> str (w/write-pretty j))
(defun write-with (j: Json o: WriteOptions) -> str (w/write-with j o))
(defun write-bytes (j: Json) -> (Array i8) (w/write-bytes j))
(defun write-to (fd: i64 j: Json) -> (Result unit os/OSError) (io/write-to fd j))
(defun write-file (path: str j: Json) -> (Result unit os/OSError) (io/write-file-json path j))

(defun get-key (j: Json k: str) -> (Option Json) (a/json-get j k))
(defun get-index (j: Json i: i64) -> (Option Json) (a/json-nth j i))
(defun get-in (j: Json path: (Vec str)) -> (Option Json) (a/get-in j path))
(defun pointer (j: Json p: str) -> (Option Json) (a/pointer j p))
(defun type-name (j: Json) -> str (a/json-type j))

(defun tape (s: str) -> (Result Doc JsonError) (tb/tape-of s))
(defun tape-with (s: str o: JsonOptions) -> (Result Doc JsonError) (tb/build-tape s o))
(defun field (d: Doc i: i64 k: str) -> i64 (v/field d i k))
(defun elem (d: Doc i: i64 k: i64) -> i64 (v/elem d i k))
(defun path (d: Doc steps: (Vec str)) -> i64 (v/path d steps))
(defun node-str (d: Doc i: i64) -> (Option str) (v/node-str d i))
(defun node-i64 (d: Doc i: i64) -> (Option i64) (v/node-i64 d i))
(defun node-f64 (d: Doc i: i64) -> (Option f64) (v/node-f64 d i))
(defun node-bool (d: Doc i: i64) -> (Option bool) (v/node-bool d i))
(defun node->json (d: Doc i: i64) -> Json (v/node->json d i))
(defun doc-write (d: Doc) -> str (dw/doc-write d))
(defun doc-write-node (d: Doc i: i64) -> str (dw/doc-write-node d i))
(defun doc-write-bytes (d: Doc i: i64) -> (Array i8) (dw/doc-write-bytes d i))
(defun doc-write-with (d: Doc i: i64 o: WriteOptions) -> str (dw/doc-write-with d i o))
(defun reduce-events (d: Doc f: (fn (a JsonEvent) a) init: a) -> a (ev/reduce-events d f init))

(defun json->datum (j: Json) -> Datum (cv/json->datum j))
(defun datum->json (d: Datum) -> Json (cv/datum->json d))

;; Plain data as Json: any type with a `ToJson` instance (i64 f64 bool str keyword Datum Json, (Vec a), (Option a), and the records of `defjson`).
(defun to-json (x: a) -> Json :where ((ToJson a)) (->json x))
