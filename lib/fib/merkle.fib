;; fib.merkle: merkle trees (docs/design/merkle.md). Explicit: `(:require [fib.merkle :as mk])`. The hash is yours, a value of type
;; `(fn ((Array i8)) (Array i8))` (fibber has no cryptography of its own: wrap a fib.crypto provider's digest); digests are lowercase hex.
;;
;;   (mk/append tree hasher item-digest offset)  -> Appended: the new tree, the subtree root, every node made (keep them to prove later)
;;   (mk/root tree hasher)                       -> (Option str)
;;   (mk/proof tree hasher lookup offset)        -> (Option MerkleProof)   lookup: (fn (str) (Option MerkleNode)) over the nodes you kept
;;   (mk/verify hasher proof)                    -> bool                   needs no nodes: each sibling carries its digest, side and offsets
;;   (mk/merkle-log) (mk/log-append l hasher item) (mk/log-root l hasher) (mk/log-proof l hasher offset)   the same, nodes kept in memory
;;   (mk/node-bytes n) (mk/node-from-bytes b) (mk/node-hash hasher n)
;;
;; Node bytes are merkql's, so with SHA-256 the roots and proofs are merkql's (Rust) for the same items and offsets.
(ns fib.merkle (:export-from fib.merkle.node fib.merkle.tree fib.merkle.log))
