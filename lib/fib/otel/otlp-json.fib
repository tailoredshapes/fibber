;; OTLP/HTTP JSON payloads; no I/O or instrumentation (design 3.8).
(ns fib.otel.otlp-json (:use fib.core fib.datum fib.otel.trace fib.otel.metrics fib.log.core)
  (:require [fib.otel.otlp-json-common :as common] [fib.otel.otlp-json-traces :as traces]
            [fib.otel.otlp-json-metrics :as metrics] [fib.otel.otlp-json-logs :as logs]))

(defun spans-json (spans: (Vec SpanData)) -> str (traces/encode-spans spans))
(defun metrics-json (metrics: (Vec Metric)) -> str (metrics/encode-metrics metrics))
(defun logs-json (resource: Resource records: (Vec LogRecord)) -> str (logs/encode-logs resource records))
(defun attributes-json (attributes: (Vec (Pair str Datum))) -> str (common/attributes-json attributes))
