;; lib/lir/defun.lir: `defun`, the first macro library of lIR (spec/lir.md 4.6). A library holds macro definitions only and is loaded by
;; (require-macros "PATH/defun.lir"), the path relative to the requiring file.
;;
;;   (defun NAME ((P T)..) -> R BLOCK..)   expands to   (define (NAME R) ((T P)..) BLOCK..)
;;
;; The body is lIR over the s-expression objects: `name`, `params`, `arrow` and `ret` are the first four arguments, `body` the list of the
;; rest. Each parameter `(P T)` is turned round into `(T P)`; anything else is reported at the form at fault through `lir.sexp.fail`.
(define-macro defun (name params arrow ret body ...)
  (block entry
    (br (call @lir.sexp.is arrow (string "->")) arrow-ok bad-arrow))
  (block bad-arrow
    (ret (call @lir.sexp.fail arrow (string "defun: expected -> before the result type"))))
  (block arrow-ok
    (br (icmp eq (call @lir.sexp.tag params) (i64 5)) params-ok bad-params))
  (block bad-params
    (ret (call @lir.sexp.fail params (string "defun: expected a parameter list ((NAME T)..)"))))
  (block params-ok
    (let ((def (call @lir.sexp.list (i64 0)))
          (sig (call @lir.sexp.list (i64 0)))
          (ps (call @lir.sexp.list (i64 0)))
          (n (call @lir.sexp.count params)))
      (call @lir.sexp.push def (call @lir.sexp.symbol (string "define")))
      (call @lir.sexp.push sig name)
      (call @lir.sexp.push sig ret)
      (call @lir.sexp.push def sig)
      (call @lir.sexp.push def ps)
      (br params-loop)))
  (block params-loop
    (let ((i (phi i64 (params-ok (i64 0)) (param-ok i2))))
      (br (icmp ult i n) param params-done)))
  (block param
    (let ((p (call @lir.sexp.nth params i)))
      (br (icmp eq (call @lir.sexp.tag p) (i64 5)) param-list bad-param)))
  (block bad-param
    (ret (call @lir.sexp.fail p (string "defun: a parameter is (NAME T)"))))
  (block param-list
    (br (icmp eq (call @lir.sexp.count p) (i64 2)) param-ok bad-param))
  (block param-ok
    (let ((tp (call @lir.sexp.list (i64 0)))
          (i2 (add i (i64 1))))
      (call @lir.sexp.push tp (call @lir.sexp.nth p (i64 1)))
      (call @lir.sexp.push tp (call @lir.sexp.nth p (i64 0)))
      (call @lir.sexp.push ps tp)
      (br params-loop)))
  (block params-done
    (br body-loop))
  (block body-loop
    (let ((j (phi i64 (params-done (i64 0)) (body-push j2))))
      (br (icmp ult j (call @lir.sexp.count body)) body-push body-done)))
  (block body-push
    (let ((j2 (add j (i64 1))))
      (call @lir.sexp.push def (call @lir.sexp.nth body j))
      (br body-loop)))
  (block body-done
    (ret def)))
