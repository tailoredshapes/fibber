;; fib.db over the in-memory fake: the Driver contract (fib.db.contract) against fib.db.memory, in the gate with no C library. The
;; contract's own proof that it can fail is db-contract-spec.fib.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.db fib.db.memory fib.db.contract))

(defspecs specs
  (implements DriverContract "memory" open-memory))

(defun main () -> i64 (run-main (specs)))
