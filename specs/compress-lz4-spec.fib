;; fib.compress.lz4 against the codec contract (fib.compress.contract), and the LZ4-specific checks that have no place in a contract: the xxHash32 vectors, the published block and
;; frame examples, the format's edge cases (docs/design/compress.md 6, 8). `fibc test specs`.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.compress.contract fib.compress.lz4)
  (:require [fib.compress :as z]))

(defspecs specs
  (implements CompressContract "lz4" (fn () (lz4))))

(defun main () -> i64 (run-main (specs)))
