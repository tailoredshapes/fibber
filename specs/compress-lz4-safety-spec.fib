;; The SAFETY PROOF of the fast decoder (lib/fib/compress/lz4/blockdec.fib: the slack condition `i <= ilim, op <= dlim`) as an executable check: the decoder reads nothing past the
;; input length it is given and writes nothing outside the output range it is given, however the sequences fall near the two ends. The input side: a block is decoded from an array that
;; goes on after the block with bytes that look like a valid offset (1 0 1 0 ..): a read past the end would make the last sequence take a match that is not there and the output would have
;; extra bytes. The output side: the buffer is surrounded by 0xAA canaries and must come out with the data in the range and the canaries untouched, for blocks of text, random bytes, runs,
;; patterns of every period from 1 to 20 (every small-offset path) and records, fast and HC, at 1500 sizes. `scripts/mutant-lz4.sh` plants a wrong limit on each side; this kills it.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.rng fib.compress.types fib.compress.corpus fib.compress.lz4 fib.compress.lz4.mem fib.compress.lz4.blockdec))

(defun gens () -> (Vec (fn (i64 i64) (Array i8)))
  [(fn (seed: i64 n: i64) (text seed n)) (fn (seed: i64 n: i64) (random-bytes seed n)) (fn (seed: i64 n: i64) (runs seed n))
   (fn (seed: i64 n: i64) (pattern seed (+ 1 (rem seed 20)) n)) (fn (seed: i64 n: i64) (records seed n)) (fn (seed: i64 n: i64) (run-noise seed n))])

(defun block-of (d: (Array i8) hc: bool) -> (Array i8) (if hc (block-compress-hc d 4) (block-compress d 1)))

;; The block decoded from inside a longer array: the garbage after it is `1 0 1 0 ..`.
(defun input-side-ok? (d: (Array i8) hc: bool) -> bool
  (let [z (block-of d hc) za (cat2 z (fill 64 (fn (i: i64) (if (= (rem i 2) 0) 1 0)))) out (array (+ (array-len d) 400) 0i8)
        r (decode-block (data za) (array-len z) (data out) (array-len out) 0 0 (array-len d))]
    (and (= r (array-len d)) (bytes-eq (array-copy out 0 (array-len d)) d))))

(defun cat2 (a: (Array i8) b: (Array i8)) -> (Array i8)
  (let [o (array (+ (array-len a) (array-len b)) 0i8)] (do (copy-exact (data o) 0 (data a) 0 (array-len a)) (copy-exact (data o) (array-len a) (data b) 0 (array-len b)) o)))

;; The block decoded into dst[100, 100 + n + extra): nothing outside is written, the range holds the data.
(defun output-side-ok? (d: (Array i8) hc: bool extra: i64) -> bool
  (let [n (array-len d) dst (fill (+ n (+ 300 extra)) (fn (i: i64) -86)) z (block-of d hc)]
    (match (block-decompress-into z dst 100 (+ n extra))
      ((Err _) false)
      ((Ok k) (and (= k n) (bytes-eq (array-copy dst 100 (+ 100 n)) d)
                   (loop [i 0] (cond (>= i 100) true (not (= (array-get dst i) -86i8)) false :else (recur (+ i 1))))
                   (loop [i (+ 100 (+ n extra))] (cond (>= i (array-len dst)) true (not (= (array-get dst i) -86i8)) false :else (recur (+ i 1)))))))))

(defun failures (check: (fn (i64 i64 bool) bool) total: i64) -> i64 (failures-to check total 600))
(defun failures-to (check: (fn (i64 i64 bool) bool) total: i64 maxn: i64) -> i64
  (let [g (rng-new 77)]
    (loop [i 0 bad 0]
      (if (>= i total) bad
        (let [n (rng-below g maxn) seed (+ 1 (rng-below g 100000)) hc (= (rng-below g 3) 0)]
          (recur (+ i 1) (if (check seed n hc) bad (+ bad 1))))))))

(defspecs specs
  (feature "the decoder's slack proof"
    (scenario "input side: 1500 blocks decoded from inside a longer array give exactly the data (nothing is read past the length)"
      (then (expect = 0 (failures (fn (seed: i64 n: i64 hc: bool) (input-side-ok? ((nth (gens) (rem seed 6)) seed n) hc)) 1500))))
    (scenario "output side: 1500 blocks decoded into a range with canaries around it leave every canary alone, with the range exact and with 40 bytes of room to spare"
      (then (expect = 0 (failures (fn (seed: i64 n: i64 hc: bool) (let [d ((nth (gens) (rem seed 6)) seed n)] (and (output-side-ok? d hc 0) (output-side-ok? d hc 40)))) 1500))))
    (scenario "the medium path (long literal runs and matches, up to 6000 bytes): nothing is read past the input and nothing written outside the range, with none, 8, 33 and 40 bytes of room"
      (then (expect = 0 (failures-to (fn (seed: i64 n: i64 hc: bool) (let [d ((nth (mid-gens) (rem seed 6)) seed n)] (and (input-side-ok? d hc) (output-side-ok? d hc 0) (output-side-ok? d hc 8) (output-side-ok? d hc 33) (output-side-ok? d hc 40)))) 600 6000))))
    (scenario "a zero offset, or an offset beyond the output written so far, in any of the first sequences of a long block (200 blocks to 3000 bytes) is refused as corrupt, with exact room and with room to spare"
      (then (expect = 0 (failures-to (fn (seed: i64 n: i64 hc: bool) (let [d ((nth (gens) (rem seed 6)) seed (+ 200 n))] (and (= 0 (bad-offsets-accepted d 0)) (= 0 (bad-offsets-accepted d 65535))))) 200 2800))))
    (scenario "guard pages: 2000 blocks (up to 4000 bytes, fast and HC, every generator) placed to END at an inaccessible page are decoded without reading one byte past them, and decoded into a range that ends at one without writing one byte past it"
      (given [g (guarded)])
      (then (expect = 0 (failures-to (fn (seed: i64 n: i64 hc: bool) (let [d ((nth (mid-gens) (rem seed 6)) seed n) d2 ((nth (gens) (rem seed 6)) seed (rem n 700))]
                                                                          (and (guard-input-ok? g d hc) (guard-output-ok? g d hc) (guard-input-ok? g d2 hc) (guard-output-ok? g d2 hc)))) 2000 4000))))))

;; ---- GUARD PAGES: the strongest form of the two proofs. Two pages are mapped and the second is made inaccessible; a block is placed so that it ENDS at the guard (a read of one byte past it is a
;; SIGSEGV that kills this process, which is how `scripts/mutant-lz4.sh` kills a slack that is too small even when a wild read changes no byte of the result), and an output range is placed so that
;; it ends at the guard with no room to spare (a wild write past it is the same crash).
(extern mmap :private (ptr i64 i32 i32 i32 i64) -> ptr)
(extern mprotect :private (ptr i64 i32) -> i32)

(defun null-ptr () -> ptr (let [slot (array 1 0)] (unsafe (load-ptr (ptr+ (raw slot) 24)))))
(defun guarded () -> ptr
  (let [p (unsafe (mmap (null-ptr) 8192 3 34 -1 0))]
    (do (unsafe (mprotect (ptr+ p 4096) 4096 0)) p)))

;; The block of d placed to end at the guard, decoded into an ordinary array.
(defun guard-input-ok? (g: ptr d: (Array i8) hc: bool) -> bool
  (let [z (block-of d hc) zl (array-len z) at (- 4096 zl) out (array (+ (array-len d) 64) 0i8)]
    (if (> zl 4000) true
      (do (copy-exact g at (data z) 0 zl)
          (let [r (decode-block (unsafe (ptr+ g at)) zl (data out) (array-len out) 0 0 (array-len d))]
            (and (= r (array-len d)) (bytes-eq (array-copy out 0 (array-len d)) d)))))))

;; The block decoded into the range that ends at the guard (dlen = cap = the end of the page).
(defun guard-output-ok? (g: ptr d: (Array i8) hc: bool) -> bool
  (let [z (block-of d hc) n (array-len d) at (- 4096 n)]
    (if (> n 4000) true
      (let [r (decode-block (data z) (array-len z) g 4096 at at 4096)]
        (and (= r 4096) (bytes-eq (fill n (fn (i: i64) (unsafe (zext i64 (load-i8 (ptr+ g (+ at i))))))) d))))))


;; ---- BAD OFFSETS in long blocks (the fast and medium paths, not only the slow one): the positions of the offsets of a block are found by walking its sequences; a block with any ONE of
;; them set to 0, or to a distance beyond what has been written, must be refused as corrupt (-1) by `decode-block`, with exact room and with room to spare.
(defun walk-ext (z: (Array i8) i: i64) -> i64
  (loop [k i] (if (= (bit-and (zext i64 (array-get z k)) 255) 255) (recur (+ k 1)) (+ k 1))))
;; The index of the offset of each sequence that has one.
(defun offset-positions (z: (Array i8)) -> (Vec i64)
  (let [n (array-len z)]
    (loop [i 0 acc: (Vec i64) []]
      (if (>= i n) acc
        (let [tok (bit-and (zext i64 (array-get z i)) 255) ln (shr tok 4)
              p0 (if (= ln 15) (walk-ext z (+ i 1)) (+ i 1))
              lit (if (= ln 15) (+ 15 (+ (* 255 (- (- p0 (+ i 1)) 1)) (bit-and (zext i64 (array-get z (- p0 1))) 255))) ln)
              po (+ p0 lit)]
          (if (>= (+ po 2) n) acc
            (let [mn (bit-and tok 15)
                  nxt (if (= mn 15) (walk-ext z (+ po 2)) (+ po 2))]
              (recur nxt (conj acc po)))))))))

(defun with-offset (z: (Array i8) at: i64 off: i64) -> (Array i8)
  (let [c (cell (array-copy z 0 (array-len z)))] (do (array-set! &c at (trunc i8 (bit-and off 255))) (array-set! &c (+ at 1) (trunc i8 (shr off 8))) @c)))

(defun bad-offsets-accepted (d: (Array i8) off: i64) -> i64
  (let [z (block-compress d 1) ps (offset-positions z)]
    (loop [k 0 bad 0]
      (if (>= k (min 12 (count ps))) bad
        (let [zb (with-offset z (nth ps (* k (max 1 (quot (count ps) 12)))) off) n (array-len d)
              r1 (let [out (array (+ n 64) 0i8)] (decode-block (data zb) (array-len zb) (data out) (array-len out) 0 0 n))
              r2 (let [out (array n 0i8)] (decode-block (data zb) (array-len zb) (data out) (array-len out) 0 0 n))]
          (recur (+ k 1) (+ bad (if (and (= r1 -1) (= r2 -1)) 0 1))))))))

;; Blocks of up to 6000 bytes take the decoder's MEDIUM path (long literal runs, long matches, extension bytes): the same two proofs at the larger sizes.
(defun mid-gens () -> (Vec (fn (i64 i64) (Array i8)))
  [(fn (seed: i64 n: i64) (runs seed n)) (fn (seed: i64 n: i64) (run-noise seed n)) (fn (seed: i64 n: i64) (text seed n))
   (fn (seed: i64 n: i64) (cat2 (random-bytes seed (quot n 2)) (runs seed (- n (quot n 2))))) (fn (seed: i64 n: i64) (pattern seed (+ 1 (rem seed 40)) n)) (fn (seed: i64 n: i64) (records seed n))])

(defun main () -> i64 (run-main (specs)))
