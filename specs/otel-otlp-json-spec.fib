;; Independent OTLP/JSON wire expectations (design 3.8). No collector or clock.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run)
  (:require [fib.otel :as o] [fib.otel.otlp-json :as wire] [fib.json :as json]
            [fib.log.core :as log] [otel-otlp-fixtures :as fixture]))

(defun parsed (text: str) -> json/Json
  (match (json/parse text) ((Ok value) value) ((Err error) (trap (str "invalid wire JSON: " (. error message))))))
(defun at (value: json/Json path: (Vec str)) -> json/Json (unwrap-or (json/get-in value path) json/JNull))
(defun elements (value: json/Json) -> (Vec json/Json) (match value ((json/JArr items) items) (_ [])))
(defun string-value (value: json/Json) -> str (match value ((json/JStr text) text) (_ "<not a string>")))
(defun field (value: json/Json name: str) -> json/Json (unwrap-or (json/get-key value name) json/JNull))
(defun named (items: (Vec json/Json) name: str) -> json/Json
  (unwrap-or (first (filter (fn (item: json/Json) (= (field item "name") (json/JStr name))) items)) json/JNull))
(defun attribute (value: json/Json key: str) -> json/Json
  (let [found (first (filter (fn (item: json/Json) (= (field item "key") (json/JStr key))) (elements (field value "attributes"))))]
    (match found (nil json/JNull) ((some item) (field item "value")))))

(defun records (root: json/Json resource-key: str scope-key: str value-key: str) -> (Vec json/Json)
  (vec (mapcat (fn (resource: json/Json)
    (mapcat (fn (scope: json/Json) (elements (field scope value-key))) (elements (field resource scope-key))))
    (elements (field root resource-key)))))
(defun spans (root: json/Json) -> (Vec json/Json) (records root "resourceSpans" "scopeSpans" "spans"))
(defun metrics (root: json/Json) -> (Vec json/Json) (records root "resourceMetrics" "scopeMetrics" "metrics"))
(defun logs (root: json/Json) -> (Vec json/Json) (records root "resourceLogs" "scopeLogs" "logRecords"))

(defspecs specs
  (feature "OTLP scalar values"
    (scenario "every scalar has its AnyValue tag, bytes use padded base64 and nil is absent"
      (given [span (nth (spans (parsed (wire/spans-json [(fixture/sample-span "wire" 1)]))) 0)])
      (then (expect = (parsed "{\"stringValue\":\"a \\\"quote\\\"\\nλ\"}") (attribute span "text"))
            (expect = (parsed "{\"boolValue\":true}") (attribute span "bool"))
            (expect = (parsed "{\"intValue\":\"9007199254740993\"}") (attribute span "int"))
            (expect = (parsed "{\"doubleValue\":1.25}") (attribute span "float"))
            (expect = (parsed "{\"bytesValue\":\"aGVsbG8=\"}") (attribute span "bytes"))
            (expect = json/JNull (attribute span "nil"))
            (expect = 6 (count (elements (field span "attributes"))))
            (expect = (json/JFloat 1.5e308) (field (attribute span "finite") "doubleValue"))))
    (scenario "NaN and infinities are strings, while byte values are unsigned before base64"
      (given [attrs [(Pair "nan" (o/DFloat (fdiv 0.0 0.0))) (Pair "positive" (o/DFloat (fdiv 1.0 0.0)))
                    (Pair "negative" (o/DFloat (fdiv -1.0 0.0))) (Pair "bytes" (o/DBytes (array 2 -1i8)))]])
      (upon [value (parsed (str "{\"attributes\":" (wire/attributes-json attrs) "}"))])
      (then (expect = (json/JStr "NaN") (field (attribute value "nan") "doubleValue"))
            (expect = (json/JStr "Infinity") (field (attribute value "positive") "doubleValue"))
            (expect = (json/JStr "-Infinity") (field (attribute value "negative") "doubleValue"))
            (expect = (json/JStr "//8=") (field (attribute value "bytes") "bytesValue"))))
    (scenario "duplicate attribute names keep the final value and final nil removes an earlier value"
      (given [attrs [(Pair "k" (o/DStr "old")) (Pair "k" (o/DInt 7)) (Pair "gone" (o/DInt 1)) (Pair "gone" o/DNil)]])
      (then (expect = (parsed "[{\"key\":\"k\",\"value\":{\"intValue\":\"7\"}}]") (parsed (wire/attributes-json attrs))))))
  (feature "OTLP traces"
    (scenario "a complete child preserves hex IDs, exact nanoseconds, numeric enums, events and links"
      (given [root (parsed (wire/spans-json [(with (fixture/sample-span "work" 1) (parent-remote true))]))
              span (nth (spans root) 0) event (at span ["events" "0"]) link (at span ["links" "0"])])
      (then (expect = (json/JStr "00000000000000010000000000000002") (field span "traceId"))
            (expect = (json/JStr "000000000000002b") (field span "spanId"))
            (expect = (json/JStr "0000000000000007") (field span "parentSpanId"))
            (expect = (json/JStr "vendor=value") (field span "traceState"))
            (expect = (json/JStr "work") (field span "name"))
            (expect = (json/JInt 2) (field span "kind"))
            (expect = (json/JStr "1700000000000000123") (field span "startTimeUnixNano"))
            (expect = (json/JStr "1700000000000000456") (field span "endTimeUnixNano"))
            (expect = (parsed "{\"code\":2,\"message\":\"bad \\\"quote\\\"\"}") (field span "status"))
            (expect = (json/JInt 897) (field span "flags"))
            (expect = (json/JStr "checkpoint") (field event "name"))
            (expect = (json/JStr "1700000000000000300") (field event "timeUnixNano"))
            (expect = (parsed "{\"boolValue\":true}") (attribute event "event"))
            (expect = (json/JStr "00000000000000030000000000000004") (field link "traceId"))
            (expect = (json/JStr "0000000000000005") (field link "spanId"))
            (expect = (json/JStr "link=state") (field link "traceState"))
            (expect = (json/JInt 897) (field link "flags"))
            (expect = (parsed "{\"stringValue\":\"remote\"}") (attribute link "link"))
            (expect = (json/JStr "fixture.scope") (at root ["resourceSpans" "0" "scopeSpans" "0" "scope" "name"]))
            (expect = (parsed "{\"stringValue\":\"otlp-wire\"}") (attribute (at root ["resourceSpans" "0" "resource"]) "service.name"))))
    (scenario "roots omit parentSpanId; local flags, all kinds and status codes are numeric"
      (given [base (fixture/sample-span "root" 0)
              kinds [o/KindInternal o/KindServer o/KindClient o/KindProducer o/KindConsumer]
              actual (spans (parsed (wire/spans-json (mapv (fn (kind: o/SpanKind) (with base (kind kind))) kinds))))])
      (then (expect = [1 2 3 4 5] (mapv (fn (span: json/Json) (match (field span "kind") ((json/JInt n) n) (_ -1))) actual))
            (expect = nil (json/get-key (nth actual 0) "parentSpanId"))
            (expect = (json/JInt 385) (field (nth actual 0) "flags"))
            (expect = (parsed "{\"code\":0}") (field (nth actual 0) "status"))
            (expect = (parsed "{\"code\":1}") (field (nth (spans (parsed (wire/spans-json [(with base (status o/StatusOk))]))) 0) "status"))))
    (scenario "equivalent resources merge despite order, duplicate keys and nil; scopes stay separate"
      (given [base (fixture/sample-span "first" 0)
              reordered (o/Resource [(Pair "zone" (o/DStr "old")) (Pair "zone" (o/DStr "east"))
                         (Pair "ignored" o/DNil) (Pair "service.name" (o/DStr "otlp-wire"))])
              other (o/Resource [(Pair "service.name" (o/DStr "other"))])
              root (parsed (wire/spans-json [base (with base (name "second") (resource reordered))
                        (with base (name "other-scope") (scope "another")) (with base (name "other-resource") (resource other))]))
              groups (elements (field root "resourceSpans"))
              own (unwrap-or (first (filter (fn (group: json/Json)
                     (= (attribute (field group "resource") "service.name") (parsed "{\"stringValue\":\"otlp-wire\"}"))) groups)) json/JNull)
              scopes (elements (field own "scopeSpans"))
              primary (unwrap-or (first (filter (fn (scope: json/Json) (= (at scope ["scope" "name"]) (json/JStr "fixture.scope"))) scopes)) json/JNull)])
      (then (expect = 2 (count groups)) (expect = 2 (count scopes))
            (expect = ["first" "second"] (mapv (fn (span: json/Json) (string-value (field span "name"))) (elements (field primary "spans")))))))
  (feature "OTLP metrics"
    (scenario "sum values and times are decimal strings, temporality is cumulative and monotonicity is preserved"
      (given [root (parsed (wire/metrics-json (fixture/sample-metrics))) all (metrics root)
              sum (named all "requests") point (at sum ["sum" "dataPoints" "0"]) updown (named all "inflight")])
      (then (expect = 4 (count all)) (expect = (json/JStr "{request}") (field sum "unit"))
            (expect = (json/JStr "request count") (field sum "description"))
            (expect = (json/JInt 2) (at sum ["sum" "aggregationTemporality"]))
            (expect = (json/JBool true) (at sum ["sum" "isMonotonic"]))
            (expect = (json/JBool false) (at updown ["sum" "isMonotonic"]))
            (expect = (json/JStr "9007199254740993") (field point "asInt"))
            (expect = (json/JStr "-3") (at updown ["sum" "dataPoints" "0" "asInt"]))
            (expect = (json/JStr "1700000000000000123") (field point "startTimeUnixNano"))
            (expect = (json/JStr "1700000000000000456") (field point "timeUnixNano"))
            (expect = (parsed "{\"stringValue\":\"GET\"}") (attribute point "method"))
            (expect = (json/JStr "fixture.meter") (at root ["resourceMetrics" "0" "scopeMetrics" "0" "scope" "name"]))))
    (scenario "histogram bounds stay doubles and counts are strings; gauges carry asDouble without a start time"
      (given [all (metrics (parsed (wire/metrics-json (fixture/sample-metrics))))
              histogram (named all "latency") point (at histogram ["histogram" "dataPoints" "0"])
              gauge (at (named all "temperature") ["gauge" "dataPoints" "0"])])
      (then (expect = (json/JInt 2) (at histogram ["histogram" "aggregationTemporality"]))
            (expect = (json/JStr "5") (field point "count"))
            (expect = (parsed "[\"2\",\"1\",\"2\"]") (field point "bucketCounts"))
            (expect = (parsed "[10.0,20.0]") (field point "explicitBounds"))
            (expect = (json/JFloat 79.5) (field point "sum"))
            (expect = (json/JFloat 0.5) (field point "min"))
            (expect = (json/JFloat 30.0) (field point "max"))
            (expect = (json/JStr "1700000000000000123") (field point "startTimeUnixNano"))
            (expect = (json/JStr "1700000000000000456") (field point "timeUnixNano"))
            (expect = (json/JFloat 12.5) (field gauge "asDouble"))
            (expect = (json/JStr "1700000000000000456") (field gauge "timeUnixNano"))
            (expect = nil (json/get-key gauge "startTimeUnixNano"))))
    (scenario "metrics also group by equivalent resource and instrumentation scope"
      (given [base (nth (fixture/sample-metrics) 0)
              same (o/Resource [(Pair "zone" (o/DStr "east")) (Pair "service.name" (o/DStr "otlp-wire"))])
              root (parsed (wire/metrics-json [base (with base (name "same") (resource same)) (with base (scope "other"))]))
              resource (at root ["resourceMetrics" "0"])])
      (then (expect = 1 (count (elements (field root "resourceMetrics"))))
            (expect = 2 (count (elements (field resource "scopeMetrics"))))
            (expect = 3 (count (metrics root))))))
  (feature "OTLP logs"
    (scenario "every severity maps to its numeric range, body and nanoseconds survive, IDs move out of attributes"
      (given [root (parsed (wire/logs-json (fixture/sample-resource) (fixture/sample-logs))) all (logs root) first-log (nth all 0)])
      (then (expect = [1 5 9 13 17 21] (mapv (fn (record: json/Json) (match (field record "severityNumber") ((json/JInt n) n) (_ -1))) all))
            (expect = ["TRACE" "DEBUG" "INFO" "WARN" "ERROR" "FATAL"] (mapv (fn (record: json/Json) (string-value (field record "severityText"))) all))
            (expect = (parsed "{\"stringValue\":\"message 0\"}") (field first-log "body"))
            (expect = (json/JStr "1700000000000000123") (field first-log "timeUnixNano"))
            (expect = (json/JStr "1700000000000000123") (field first-log "observedTimeUnixNano"))
            (expect = (json/JStr "111111111111111111111111111111af") (field first-log "traceId"))
            (expect = (json/JStr "00000000000000ab") (field first-log "spanId"))
            (expect = json/JNull (attribute first-log "trace_id")) (expect = json/JNull (attribute first-log "span_id"))
            (expect = (parsed "{\"intValue\":\"9\"}") (attribute first-log "keep"))
            (expect = 1 (count (elements (field first-log "attributes"))))
            (expect = (json/JStr "fixture.logs") (at root ["resourceLogs" "0" "scopeLogs" "0" "scope" "name"]))))
    (scenario "malformed, zero and wrongly typed correlation IDs stay attributes and are not promoted"
      (given [base (nth (fixture/sample-logs) 0)
              invalid [(Pair :trace_id (o/DStr "not a trace")) (Pair :span_id (o/DStr "0000000000000000"))]
              typed [(Pair :trace_id (o/DInt 7)) (Pair :span_id (o/DStr "000000000000000g"))]
              all (logs (parsed (wire/logs-json (fixture/sample-resource) [(with base (fields invalid)) (with base (fields typed))])))])
      (then (expect = nil (json/get-key (nth all 0) "traceId")) (expect = nil (json/get-key (nth all 0) "spanId"))
            (expect = (parsed "{\"stringValue\":\"not a trace\"}") (attribute (nth all 0) "trace_id"))
            (expect = (parsed "{\"stringValue\":\"0000000000000000\"}") (attribute (nth all 0) "span_id"))
            (expect = nil (json/get-key (nth all 1) "traceId")) (expect = nil (json/get-key (nth all 1) "spanId"))
            (expect = (parsed "{\"intValue\":\"7\"}") (attribute (nth all 1) "trace_id"))
            (expect = 2 (count (elements (field (nth all 1) "attributes"))))))
    (scenario "logger names produce separate scopeLogs and empty batches have no resource entries"
      (given [base (nth (fixture/sample-logs) 0)
              root (parsed (wire/logs-json (fixture/sample-resource) [base (with base (logger "other.logger"))]))])
      (then (expect = 2 (count (elements (at root ["resourceLogs" "0" "scopeLogs"]))))
            (expect = 2 (count (logs root)))
            (expect = (parsed "{\"resourceLogs\":[]}") (parsed (wire/logs-json (fixture/sample-resource) [])))
            (expect = (parsed "{\"resourceMetrics\":[]}") (parsed (wire/metrics-json [])))
            (expect = (parsed "{\"resourceSpans\":[]}") (parsed (wire/spans-json [])))))))

(defun main () -> i64 (run-main (specs)))
