;; The Vec contract against the library's persistent vector and against a linked-list vector written for the test. `fibc test specs`.
(ns main (:use fib.test.core fib.test.run vec-contract listvec))

(defspecs specs
  (implements VecContract "Vec" (fn () (vec-empty)))
  (implements VecContract "ListVec" (fn () (lv-empty))))

(defun main () -> i64 (run-main (specs)))
