(ns main)
;; parallel mergesort of N i64: fork-join by `spawn` down to depth d (2^d leaves), sequential below; args: N D RUNS
(defun fill-input (n: i64) -> (Array i64)
  (let ((buf (cell (array n 0))))
    (do (dotimes (i n) (array-set! &buf i (rem (* (+ i 1) 2654435761) 1000003)))
        @buf)))

(defun isort (a: (Array i64) lo: i64 hi: i64) -> (Array i64)
  (let ((m (- hi lo)) (out (cell (array (- hi lo) 0))))
    (do (dotimes (i m)
          (let ((x (array-get a (+ lo i))))
            (loop ((j i))
              (if (and (> j 0) (> (array-get @out (- j 1)) x))
                  (do (array-set! &out j (array-get @out (- j 1))) (recur (- j 1)))
                  (array-set! &out j x)))))
        @out)))

(defun merge2 (l: (Array i64) r: (Array i64)) -> (Array i64)
  (let ((nl (array-len l)) (nr (array-len r)) (out (cell (array (+ (array-len l) (array-len r)) 0))))
    (do (loop ((i 0) (j 0) (k 0))
          (cond (and (< i nl) (< j nr))
                (let ((x (array-get l i)) (y (array-get r j)))
                  (if (<= x y)
                      (do (array-set! &out k x) (recur (+ i 1) j (+ k 1)))
                      (do (array-set! &out k y) (recur i (+ j 1) (+ k 1)))))
                (< i nl) (do (array-set! &out k (array-get l i)) (recur (+ i 1) j (+ k 1)))
                (< j nr) (do (array-set! &out k (array-get r j)) (recur i (+ j 1) (+ k 1)))
                :else 0))
        @out)))

(defun msort (a: (Array i64) lo: i64 hi: i64 d: i64) -> (Array i64)
  (if (<= (- hi lo) 64)
      (isort a lo hi)
      (let ((mid (quot (+ lo hi) 2)))
        (if (> d 0)
            (let ((t (spawn (fn () (msort a lo mid (- d 1))))) (r (msort a mid hi (- d 1))))
              (merge2 (join t) r))
            (merge2 (msort a lo mid 0) (msort a mid hi 0))))))

(defun check (s: (Array i64)) -> i64
  (loop ((i 1) (bad 0) (sum 0))
    (if (< i (array-len s))
        (recur (+ i 1) (if (> (array-get s (- i 1)) (array-get s i)) (+ bad 1) bad) (+ sum (array-get s i)))
        (+ (* bad 1000000000000) sum))))

(defun main () -> i64
  (let ((n (unwrap (parse-long (nth (args) 0)))) (d (unwrap (parse-long (nth (args) 1)))) (runs (unwrap (parse-long (nth (args) 2)))))
    (let ((a (fill-input n)))
      (do (dotimes (r runs)
            (let ((t0 (sys-clock-now)))
              (let ((s (msort a 0 n d)))
                (let ((t1 (sys-clock-now)))
                  (do (println "t " (- t1 t0)) (println "v " (check s)))))))
          0))))
