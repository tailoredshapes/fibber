;; expect: accept
;; out: dup 0 lost 0
;; Chase-Lev deque (Le, Pop, Cohen, Nardelli 2013) in lIR with a stress test: the owner (main) pushes the items 1..N, pops every fourth push and drains at the
;; end; three thieves steal. Every item must be taken exactly once: seen[i] counts the takers of item i. dup = items taken more than once, lost = never taken.
(DECLARE pthread_create I32 (PTR PTR PTR PTR))
(DECLARE pthread_join I32 (I64 PTR))
(DECLARE printf I32 (PTR ...))
(DECLARE calloc PTR (I64 I64))
(GLOBAL top I64 (I64 0))
(GLOBAL bottom I64 (I64 0))
(GLOBAL buf PTR (PTR NULL))
(GLOBAL seen PTR (PTR NULL))
(GLOBAL done I32 (I32 0))

(DEFINE (push VOID) ((I64 v))
  (BLOCK entry
    (LET ((b (ATOMIC-LOAD MONOTONIC I64 (GLOBAL bottom)))
          (slot (GETELEMENTPTR I64 (LOAD PTR (GLOBAL buf)) (AND b (I64 16383)))))
      (ATOMIC-STORE MONOTONIC v slot)
      (FENCE RELEASE)
      (ATOMIC-STORE MONOTONIC (ADD b (I64 1)) (GLOBAL bottom))
      (RET))))

(DEFINE (pop I64) ()
  (BLOCK entry
    (LET ((b (SUB (ATOMIC-LOAD MONOTONIC I64 (GLOBAL bottom)) (I64 1))))
      (ATOMIC-STORE MONOTONIC b (GLOBAL bottom))
      (FENCE SEQ_CST)
      (LET ((t (ATOMIC-LOAD MONOTONIC I64 (GLOBAL top))))
        (BR (ICMP SLE t b) nonempty empty))))
  (BLOCK empty
    (ATOMIC-STORE MONOTONIC (ADD b (I64 1)) (GLOBAL bottom))
    (RET (I64 0)))
  (BLOCK nonempty
    (LET ((x (ATOMIC-LOAD MONOTONIC I64 (GETELEMENTPTR I64 (LOAD PTR (GLOBAL buf)) (AND b (I64 16383))))))
      (BR (ICMP EQ t b) last more)))
  (BLOCK more (RET x))
  (BLOCK last
    (LET ((r (CMPXCHG SEQ_CST MONOTONIC (GLOBAL top) t (ADD t (I64 1)))))
      (ATOMIC-STORE MONOTONIC (ADD b (I64 1)) (GLOBAL bottom))
      (RET (SELECT (EXTRACTVALUE r 1) x (I64 0))))))

(DEFINE (steal I64) ()
  (BLOCK entry
    (LET ((t (ATOMIC-LOAD ACQUIRE I64 (GLOBAL top))))
      (FENCE SEQ_CST)
      (LET ((b (ATOMIC-LOAD ACQUIRE I64 (GLOBAL bottom))))
        (BR (ICMP SLT t b) some none))))
  (BLOCK none (RET (I64 0)))
  (BLOCK some
    (LET ((x (ATOMIC-LOAD MONOTONIC I64 (GETELEMENTPTR I64 (LOAD PTR (GLOBAL buf)) (AND t (I64 16383)))))
          (r (CMPXCHG SEQ_CST MONOTONIC (GLOBAL top) t (ADD t (I64 1)))))
      (RET (SELECT (EXTRACTVALUE r 1) x (I64 0))))))

(DEFINE (take VOID) ((I64 x))
  (BLOCK entry (BR (ICMP NE x (I64 0)) yes no))
  (BLOCK yes (ATOMICRMW ADD SEQ_CST (GETELEMENTPTR I32 (LOAD PTR (GLOBAL seen)) x) (I32 1)) (BR no))
  (BLOCK no (RET)))

(DEFINE (thief PTR) ((PTR arg))
  (BLOCK entry (BR loop))
  (BLOCK loop
    (LET ((x (CALL (GLOBAL steal))))
      (CALL (GLOBAL take) x)
      (BR (ICMP EQ x (I64 0)) idle loop)))
  (BLOCK idle
    (BR (ICMP EQ (ATOMIC-LOAD ACQUIRE I32 (GLOBAL done)) (I32 1)) out loop))
  (BLOCK out (RET (PTR NULL))))

(DEFINE (main I32) ()
  (BLOCK entry
    (STORE (CALL (GLOBAL calloc) (I64 16384) (I64 8)) (GLOBAL buf))
    (STORE (CALL (GLOBAL calloc) (I64 4000002) (I64 4)) (GLOBAL seen))
    (LET ((ids (ALLOCA I64 (I32 3))))
      (CALL (GLOBAL pthread_create) (GETELEMENTPTR I64 ids (I32 0)) (PTR NULL) (GLOBAL thief) (PTR NULL))
      (CALL (GLOBAL pthread_create) (GETELEMENTPTR I64 ids (I32 1)) (PTR NULL) (GLOBAL thief) (PTR NULL))
      (CALL (GLOBAL pthread_create) (GETELEMENTPTR I64 ids (I32 2)) (PTR NULL) (GLOBAL thief) (PTR NULL))
      (BR produce)))
  (BLOCK produce
    (LET ((i (PHI I64 (entry (I64 1)) (cont i2))))
      (BR (ICMP SLE i (I64 4000000)) step drain)))
  (BLOCK step
    (LET ((size (SUB (ATOMIC-LOAD MONOTONIC I64 (GLOBAL bottom)) (ATOMIC-LOAD MONOTONIC I64 (GLOBAL top)))))
      (BR (ICMP SLT size (I64 8000)) dopush dopop)))
  (BLOCK dopush (CALL (GLOBAL push) i) (BR maybe))
  (BLOCK dopop (CALL (GLOBAL take) (CALL (GLOBAL pop))) (CALL (GLOBAL push) i) (BR maybe))
  (BLOCK maybe
    (BR (ICMP EQ (AND i (I64 3)) (I64 0)) popnow cont))
  (BLOCK popnow (CALL (GLOBAL take) (CALL (GLOBAL pop))) (BR cont))
  (BLOCK cont (LET ((i2 (ADD i (I64 1)))) (BR produce)))
  (BLOCK drain
    (LET ((x (CALL (GLOBAL pop))))
      (CALL (GLOBAL take) x)
      (BR (ICMP EQ x (I64 0)) finish drain)))
  (BLOCK finish
    (ATOMIC-STORE RELEASE (I32 1) (GLOBAL done))
    (CALL (GLOBAL pthread_join) (LOAD I64 (GETELEMENTPTR I64 ids (I32 0))) (PTR NULL))
    (CALL (GLOBAL pthread_join) (LOAD I64 (GETELEMENTPTR I64 ids (I32 1))) (PTR NULL))
    (CALL (GLOBAL pthread_join) (LOAD I64 (GETELEMENTPTR I64 ids (I32 2))) (PTR NULL))
    (BR check))
  (BLOCK check
    (LET ((k (PHI I64 (finish (I64 1)) (next k2)))
          (dup (PHI I64 (finish (I64 0)) (next dup2)))
          (lost (PHI I64 (finish (I64 0)) (next lost2))))
      (BR (ICMP SLE k (I64 4000000)) body report)))
  (BLOCK body
    (LET ((c (LOAD I32 (GETELEMENTPTR I32 (LOAD PTR (GLOBAL seen)) k)))
          (dup2 (SELECT (ICMP UGT c (I32 1)) (ADD dup (I64 1)) dup))
          (lost2 (SELECT (ICMP EQ c (I32 0)) (ADD lost (I64 1)) lost))
          (k2 (ADD k (I64 1))))
      (BR next)))
  (BLOCK next (BR check))
  (BLOCK report
    (CALL (GLOBAL printf) (STRING "dup %lld lost %lld\n") dup lost)
    (RET (I32 0))))
