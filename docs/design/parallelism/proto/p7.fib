(ns main (:use fib.view fib.view.tiles))
;; with-tiles on its own, timed around the with-tiles call only: args N K H RUNS
;; each element of the output gets H steps of a dependent f64 chain (H=0: a plain store: bandwidth-bound; H=30: compute-bound)
(defun poly (x: f64 h: i64) -> f64
  (loop ((j 0) (a x)) (if (< j h) (recur (+ j 1) (+ (* a 0.999999) 0.5)) a)))

(defun main () -> i64
  (let ((n (unwrap (parse-long (nth (args) 0)))) (k (unwrap (parse-long (nth (args) 1)))) (h (unwrap (parse-long (nth (args) 2)))) (runs (unwrap (parse-long (nth (args) 3)))))
    (do (dotimes (r runs)
          (let ((out (cell (array n 0.0))))
            (let ((t0 (sys-clock-now)))
              (do (with-tiles [w out k] (dotimes (i (vlen w)) (vset! w i (poly (double i) h))))
                  (let ((t1 (sys-clock-now)))
                    (do (println "t " (- t1 t0))
                        (println "v " (+ (array-get @out 0) (array-get @out (- n 1))))))))))
        0)))
