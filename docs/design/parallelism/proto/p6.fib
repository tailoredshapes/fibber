(ns main)
;; what share-marking costs: the first `spawn` of a closure that captures a Vec of N Nodes walks every node (fib.share); the second finds the root SHARED
(defstruct Node (a: i64 b: i64))
(defun make-nodes (k: i64) -> (Vec Node)
  (loop ((i 0) (v (vec-empty))) (if (< i k) (recur (+ i 1) (vec-conj v (Node i (* i 2)))) v)))
(defun main () -> i64
  (let ((n (unwrap (parse-long (nth (args) 0)))))
    (let ((v (make-nodes n)))
      (do (dotimes (r 3)
            (let ((t0 (sys-clock-now)))
              (let ((x (join (spawn (fn () (vec-count v))))))
                (println "spawn+join with capture of " x " nodes: ns " (- (sys-clock-now) t0)))))
          0))))
