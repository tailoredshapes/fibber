(ns main)
(extern fork () -> i32)
(extern waitpid (i32 ptr i32) -> i32)
(extern _exit (i32) -> unit)
(defun child-or-wait (st: ptr) -> i64
  (unsafe
    (let [pid (fork)]
      (if (= pid 0i32)
        (do (_exit 0i32) 0)
        (do (waitpid pid st 0i32) 1)))))
(defun main () -> i64
  (let [a (array 1200000 7)
        st (unsafe (alloc 8))]
    (loop [i 0 acc 0]
      (if (>= i 5000)
        (do (println acc (array-get a 5)) 0)
        (recur (+ i 1) (+ acc (child-or-wait st)))))))
