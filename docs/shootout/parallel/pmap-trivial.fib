;; pmap over 1e6 trivial items (* x 2): the sequential Vec loop (conj), the library's chunked forms at 1, 8 and 28 workers, and the
;; pre-sized array written through tiles. Run: ulimit -v 16000000; MALLOC_ARENA_MAX=2 flock /tmp/fibsuite.lock fibc run pmap-trivial.fib -I lib
(ns main (:use fib.core fib.parallel fib.os fib.view fib.view.tiles))
(defun unwrap-ok (r: (Result i64 OSError)) -> i64 (match r ((Ok v) v) ((Err e) 0)))
(defun now-us () -> i64 (quot (unwrap-ok (monotonic-ns)) 1000))
(defun seq-map (xs: (Vec i64)) -> (Vec i64)
  (loop [i 0 out []] (if (< i (vec-count xs)) (recur (+ i 1) (conj out (* 2 (nth xs i)))) out)))

;; the pre-sized array written in place: k tasks, each stores the doubled elements of its range through the raw pointer (the trusted kernel
;; of fib.view.tiles does the same), no copies and no concatenation; the Vec is made from the array at the end as pmap's result is
(defun tiled (xs: (Vec i64) k: i64) -> (Array i64)
  (let [a (cell (array (vec-count xs) 0))]
    (do (run-tiles! (& a) k
          (fn (arr lo hi)
            (loop [i lo]
              (when (< i hi)
                (do (unsafe (store-i64 (ptr+ (raw arr) (+ 24 (* 8 i))) (* 2 (nth xs i)))) (recur (+ i 1)))))))
        @a)))

(defun ms (a: i64 b: i64) -> i64 (quot (- b a) 1000))
(defun main () -> i64
  (let [xs (vec (range 1000000))
        t0 (now-us) a (seq-map xs)
        t1 (now-us) b (pmap-each [x xs] (* x 2) )
        t2 (now-us) c (pmap-each [x xs (with (par) (workers 1))] (* x 2))
        t3 (now-us) d (pmap-each [x xs (with (par) (workers 8))] (* x 2))
        t4 (now-us) e (pmap-each [x xs (with (par) (workers 28))] (* x 2))
        t5 (now-us) f (pmap (fn (x) (* x 2)) xs)
        t6 (now-us) g (vec-from-array (tiled xs 8))
        t7 (now-us) h (tiled xs 28)
        t8 (now-us)]
    (do (println "sequential conj loop" (ms t0 t1) "ms")
        (println "pmap-each default workers" (cpu-count) ":" (ms t1 t2) "ms; 1 worker:" (ms t2 t3) "; 8:" (ms t3 t4) "; 28:" (ms t4 t5))
        (println "pmap (shared closure, default workers)" (ms t5 t6) "ms")
        (println "tiles array + vec-from-array, 8 tiles" (ms t6 t7) "ms; array only, 28 tiles" (ms t7 t8) "ms")
        (println "equal" (= a b) (= a c) (= a d) (= a e) (= a f) (= a g) (= (array-get h 999999) 1999998))
        0)))
