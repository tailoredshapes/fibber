;; the prelude's pmap (a thread per element) over 100 000 trivial items, the bug of this package; at 1e6 it took 8.4 s (docs/design/parallelism.md 1)
;; Run: ulimit -v 16000000; MALLOC_ARENA_MAX=2 flock /tmp/fibsuite.lock fibc run pmap-prelude-baseline.fib -I lib
(ns main (:use fib.core fib.os))
(defun unwrap-ok (r: (Result i64 OSError)) -> i64 (match r ((Ok v) v) ((Err e) 0)))
(defun now-us () -> i64 (quot (unwrap-ok (monotonic-ns)) 1000))
(defun main () -> i64
  (let [xs (vec (range 100000))
        t0 (now-us) a (pmap (fn (x) (* x 2)) xs) t1 (now-us)]
    (do (println "prelude pmap, 100000 items:" (quot (- t1 t0) 1000) "ms" (vec-count a)) 0)))
