;; spec:   stdlib §7 L30 (`/` leaves Num), tranche 1 plan L1 (the delegate), §6 M
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: /
;; Until the plan's step M takes `/` out of Num, the builtin protocol still has
;; a method of that name, and a module that does not :use fib.core (so that
;; Div's `/` does not shadow it) reaches it: Num's `/` of a ratio is the ratio
;; division, 1/2 over 3/4 being 2/3. The library's Num instance of Ratio
;; defines it as a delegate to the Div one; the step that removes `/` from Num
;; deletes the delegate, and THIS CASE WITH IT.
(ns main (:require [fib.core :as c]) (:use tl.check))

(defun main () -> i64
  (let ((k (checks))
        (r (/ (c/Ratio 1 2) (c/Ratio 3 4)))
        (s (/ (c/Ratio -3 4) (c/Ratio 3 2))))
    (do (check k (= (c/numerator r) 2))
        (check k (= (c/denominator r) 3))
        (check k (= (c/numerator s) -1))
        (check k (= (c/denominator s) 2))
        (checks-result k))))
