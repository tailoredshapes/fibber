;; spec: spec/syntax.md 3.15; native-stage float/vector memory extension
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (unsafe
          (let ((base (alloc 81)) (p (ptr+ base 1)) (q (ptr+ base 41)))
            (do (store-f64x4 p <<1.0 2.0 3.0 4.0>>)
                (check c (= (load-f64 p) 1.0))
                (store-f64 (ptr+ p 8) -7.0)
                (check c (= (load-f64x4 p) <<1.0 -7.0 3.0 4.0>>))
                (store-f32x4 q <<1.0f32 2.0f32 3.0f32 4.0f32>>)
                (check c (= (load-f32 q) 1.0f32))
                (store-f32 (ptr+ q 12) -5.0f32)
                (check c (= (load-f32x4 q) <<1.0f32 2.0f32 3.0f32 -5.0f32>>))
                (free base))))
        (checks-result c))))
