;; spec:   types §2.8 (exhaustiveness), syntax §3.6
;; expect: reject
;; error:  non-exhaustive match: missing _
;; roots:  ../../lib support
;; Integers, characters and strings have no finite set of values: a `match` on literals is exhaustive only with a default arm (`_` or a variable).
;; Killed by: an exhaustiveness check that takes the literals written for all there are.
(ns main)

(defun name (n: i64) -> str
  (match n
    (0 "zero")
    (1 "one")))

(defun main () -> i64
  (count (name 0)))
