;; spec:   stdlib §2.5 (about n/32 allocations instead of 2.09 per element), §8.1 item 5 (count cases)
;; expect: accept
;; result: 10240
;; audit:  clean
;; allocs: <= 704
;; roots:  ../../lib support
;; The known-length builder, vec-from-array, over an array of 10240: 664 objects (measured), the bound
;; n/16 + 64 = 704. The leaves are sliced out of the array with array-copy and the branches stacked
;; three levels deep (320 leaves, 10 branches, 1 root). Loose by design (`bound-`): see 490.
(ns main)

(defun main () -> i64
  (let ((v (vec-from-array (array 10240 0))))
    (vec-count v)))
