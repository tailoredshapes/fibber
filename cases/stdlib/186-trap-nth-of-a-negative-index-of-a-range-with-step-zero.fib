;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §4.4 (row range: a step of 0 repeats the start)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: range-by
;; The nth of a range with step 0 is the start at every index (case 164), so it does not walk and does not go
;; through range-nth, which checks the index; a negative index must still be refused, as for every other range.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (nth (range-by 3 10 0) -1))
