;; spec:   stdlib §7 L15, §2.11, types §8.2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; The value a `def` makes is live until exit and is not a leak: an atom
;; made by the init function, then a vector in it replaced twice by `main`
;; (the first value is the initialiser's, the others are main's and the
;; last is held by the atom at the end). The audit has to be clean.
(ns main (:use tl.check))

(def log: (Atom (Vec i64)) (atom [1 2]))

(defun main () -> i64
  (let ((c (checks)))
    (do (swap! log (fn (v) (conj v 3)))
        (swap! log (fn (v) (conj v 4)))
        (check c (= (count @log) 4))
        (check c (= (nth @log 3) 4))
        (checks-result c))))
