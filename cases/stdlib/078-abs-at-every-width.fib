;; spec:   stdlib §4.3 (row abs), §2.8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: abs
;; abs is the negation of a negative number, at the six types; the least
;; value that can be negated is the smallest plus one (the smallest itself is case
;; 054). -0.0 becomes 0.0 as Java's Math.abs, which the case reads through
;; the sign of the reciprocal, and a NaN stays a NaN.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0)))
    (do (check c (= (abs -5i8) 5i8))
        (check c (= (abs 5i8) 5i8))
        (check c (= (abs -127i8) 127i8))
        (check c (= (abs -300i16) 300i16))
        (check c (= (abs -32767i16) 32767i16))
        (check c (= (abs -70000i32) 70000i32))
        (check c (= (abs -2147483647i32) 2147483647i32))
        (check c (= (abs -5) 5))
        (check c (= (abs 0) 0))
        (check c (= (abs -9223372036854775807) 9223372036854775807))
        (check c (= (abs -2.5) 2.5))
        (check c (= (abs 2.5) 2.5))
        (check c (= (abs -2.5f32) 2.5f32))
        (check c (> (/ 1.0 (abs -0.0)) 1.7e308))
        (check c (> (/ 1.0 (abs 0.0)) 1.7e308))
        (check c (!= (abs nan) (abs nan)))
        (checks-result c))))
