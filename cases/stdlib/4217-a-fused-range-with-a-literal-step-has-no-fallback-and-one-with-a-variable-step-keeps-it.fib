;; spec:   stdlib §2.1 rule 2; spec/types.md §6.5 (an argument to an escaping parameter is a use of kind (d)); compiler/expand/fusegen.fib `fg-step-nonzero?`, fuserange.fib, fuseflow.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: mapv vec into map filter take range range-by range-walk-kind
;; A fused chain over a `range` call whose step the text fixes and is not zero (`(range n)`, a literal step, a negative one, a
;; float one) has no branch for a walk that never ends, so its stage literal is never an argument of the library's call and what
;; it captures stays borrowed (the allerbees cutter's `soft-alpha`: Vecs, a cell and a let-bound literal captured by the stages).
;; A step that is a variable keeps the branch: with a step of zero, `(vec (take 3 (map f (range a b s))))` takes it and ends, and
;; the stage literal there is a heap closure that owns what it captures. Each result is compared with an eager twin; the audit sees
;; every capture counted right on both paths.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun twin (lo: i64 hi: i64 by: i64 f: (fn (i64) i64)) -> (Vec i64)
  (loop ((x lo) (acc [])) (if (if (> by 0) (< x hi) (> x hi)) (recur (+ x by) (conj acc (f x))) acc)))

(defun stepped (c: Checks s: i64 v: (Vec i64) name: str) -> unit
  (do (check c (= (vec (take 3 (map (fn (i) (+ i (nth v 0) (str-len name))) (range 5 10 s))))
                  (if (= s 0) [11 11 11] (vec (take 3 (twin 5 10 s (fn (i) (+ i (nth v 0) (str-len name)))))))))
      (check c (= (mapv (fn (i) (* i (count v))) (range 0 (* s 4) (if (= s 0) 1 s)))
                  (twin 0 (* s 4) (if (= s 0) 1 s) (fn (i) (* i (count v))))))))

(defun main () -> i64
  (let ((c (checks)) (v [3 1 4 1 5]) (name (str-concat "ab" "c")) (log (cell 0)))
    (let ((at (fn (i: i64) (nth v (rem i 5)))))
      (do (check c (= (mapv (fn (i) (+ (at i) (str-len name))) (range 7)) (twin 0 7 1 (fn (i) (+ (at i) (str-len name))))))
          (check c (= (mapv (fn (i) (* 2 (at i))) (range 10 0 -3)) (twin 10 0 -3 (fn (i) (* 2 (at i))))))
          (check c (= (vec (map (fn (i) (+ i (count v))) (range 0 9 2))) (twin 0 9 2 (fn (i) (+ i (count v))))))
          (check c (= (mapv (fn (x: f64) (* x 2.0)) (range-by 0.0 1.0 0.25)) [0.0 0.5 1.0 1.5]))
          (check c (= (vec (filter (fn (i) (> (at i) 2)) (range 0 20 3))) [0 9 12 15]))
          (check c (= (mapv (fn (i) (do (set! log (+ (* @log 10) (+ i 1))) i)) (range 3)) [0 1 2]))
          (check c (= @log 123))
          (stepped c 2 v name)
          (stepped c -1 v name)
          (stepped c 0 v name)
          (checks-result c)))))
