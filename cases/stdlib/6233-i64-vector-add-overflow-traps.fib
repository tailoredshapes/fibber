;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in + at i64x2
;; stage:  2
;; roots:  ../../lib support
;; i64 lanes.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i64x2 <<9223372036854775807 1>>))
    (do (println (lane (+ a <<1 1>>) 1)) 0)))
