;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: reject
;; error:  recur outside loop
;; stage:  2
;; roots:  ../../lib support
;; Rule (iv) of the design: a try's body is a closure that catch-run calls, so a `recur` in it cannot jump to a loop outside the try (the
;; frame must stay to run the catch and the finally): the program is rejected as any `recur` outside its loop is.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (loop ((i 0))
    (if (= i 3) i
        (try (recur (+ i 1)) (catch e 0)))))
