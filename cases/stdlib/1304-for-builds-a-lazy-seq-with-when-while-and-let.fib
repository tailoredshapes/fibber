;; spec:   stdlib §4.4 (row for), §2.1 rule 2, §6.3 (D2)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: for
;; (for [x xs :when p :while q :let [y e] z zs] body) is a lazy seq (an LSeq): the body does not run until
;; the seq is read. :when and :while before a :let filter and cut the source in the order written; a :when
;; after a :let sees the let's names and guards the level's body (keep over an Option for the innermost
;; level) or the inner levels (an empty `take 0` of them); a second binding is a nested level, the inner
;; one fastest.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (n (atom 0))
        (s (for [x [1 2 3]] (do (swap! n + 1) x))))
    (do (check c (= @n 0))
        (check c (= (count s) 3))
        (check c (= @n 3))
        (check c (= (vec (for [x [1 2 3]] (* x x))) [1 4 9]))
        (check c (= (vec (for [x [1 2 3 4 5 6] :when (even? x)] x)) [2 4 6]))
        (check c (= (vec (for [x [1 2 3 4 5 6] :while (< x 4)] x)) [1 2 3]))
        (check c (= (vec (for [x [1 2 3 4 5 6] :when (> x 1) :while (< x 5)] x)) [2 3 4]))
        (check c (= (vec (for [x [1 2 3] :let [y (* x 10)]] (+ x y))) [11 22 33]))
        (check c (= (vec (for [x [1 2 3 4] :let [y (* x 10)] :when (> y 20)] y)) [30 40]))
        (check c (= (vec (for [x [1 2] y [10 20]] (+ x y))) [11 21 12 22]))
        (check c (= (vec (for [x [1 2 3] y [10 20] :when (not= x 2)] (+ x y))) [11 21 13 23]))
        (check c (= (vec (for [x [1 2 3] :let [m (rem x 2)] :when (= m 1) y [10 20]] (+ x y)))
                    [11 21 13 23]))
        (check c (= (vec (for [x [1 2 3] :when (odd? x) y [x (+ x 1)] :when (odd? y)] (* x y))) [1 9]))
        (check c (= (vec (for [x (range 0 5) :let [a (* x x) b (+ a 1)] :when (even? b)] [x b])) [[1 2] [3 10]]))
        (check c (= (count (for [x [1 2 3] y [1 2 3] :while (<= y x)] 0)) 6))
        (checks-result c))))
