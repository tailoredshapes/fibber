;; spec:   stdlib §4.3 (row unwrap: `(Option a) -> a`), §1.2 P5
;; expect: reject
;; error:  cannot unify i64 with (Option a)
;; roots:  ../../lib
;; covers: unwrap
;; unwrap is the sure case of an Option, and an i64 is not one: the program
;; that has a value already does not unwrap it, and the checker says so
;; instead of passing the value through.
(ns main (:use fib.core))

(defun main () -> i64
  (unwrap 5))
