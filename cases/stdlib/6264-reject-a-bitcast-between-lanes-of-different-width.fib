;; spec:   types §1.9 (simd/bitcast)
;; expect: reject
;; error:  simd/bitcast: the lanes of
;; stage:  2
;; roots:  ../../lib support
;; A bitcast keeps the lane count and the width of a lane: f64x4 is not reinterpretable as i32x4.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: f64x4 (splat f64x4 1.0)))
    (let ((b: i32x4 (simd/bitcast a)))
      (do (println (hsum b)) 0))))
