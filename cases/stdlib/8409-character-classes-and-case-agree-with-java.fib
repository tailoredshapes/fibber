;; spec: spec/stdlib.md section 4.8 rows Character/isDigit Character/isLetter Character/isLetterOrDigit Character/isWhitespace Character/isUpperCase Character/isLowerCase Character/toUpperCase Character/toLowerCase Character/digit Character/forDigit
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; covers: Character/isDigit Character/isLetter Character/isLetterOrDigit Character/isWhitespace Character/isUpperCase Character/isLowerCase Character/toUpperCase Character/toLowerCase Character/digit Character/forDigit
;; Package LIB-2. Java's values for the edges (all 1112064 scalar values were compared with Java 25 for the five classes and both simple mappings: 0 differences): isDigit is Unicode Nd (the Arabic-Indic ٣ is a digit),
;; isWhitespace is Java's (the no-break space U+00A0 is not, U+001F is, U+2028 is), isUpperCase counts the circled capital Ⓐ (Other_Uppercase) and isLowerCase the feminine ordinal ª (Other_Lowercase), toUpperCase of ß is
;; ß (the simple mapping; str/upper-case makes SS), `digit` is an Option where Java answers -1 and reads the digits of other scripts in their decimal value, forDigit is an Option where Java answers NUL.
(ns main (:use tl.check) (:require [Character :as Character]))

(defun cp (n: i64) -> char (i32->char (trunc i32 n)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (Character/isDigit \5))
        (check c (not (Character/isDigit \a)))
        (check c (Character/isDigit \٣))
        (check c (Character/isLetter \é))
        (check c (Character/isLetter \λ))
        (check c (not (Character/isLetter \5)))
        (check c (Character/isLetterOrDigit \5))
        (check c (not (Character/isLetterOrDigit \_)))
        (check c (Character/isWhitespace \space))
        (check c (Character/isWhitespace \newline))
        (check c (not (Character/isWhitespace (cp 160))))
        (check c (Character/isWhitespace (cp 8232)))
        (check c (Character/isWhitespace (cp 31)))
        (check c (Character/isUpperCase \A))
        (check c (not (Character/isUpperCase \a)))
        (check c (Character/isUpperCase (cp 9398)))
        (check c (Character/isLowerCase \a))
        (check c (Character/isLowerCase (cp 170)))
        (check c (= (Character/toUpperCase \a) \A))
        (check c (= (Character/toLowerCase \Ä) \ä))
        (check c (= (Character/toUpperCase \ß) \ß))
        (check c (= (Character/digit \7 10) (some 7)))
        (check c (= (Character/digit \f 16) (some 15)))
        (check c (= (Character/digit \F 16) (some 15)))
        (check c (nil? (Character/digit \g 16)))
        (check c (nil? (Character/digit \7 5)))
        (check c (nil? (Character/digit \7 1)))
        (check c (= (Character/digit \٣ 10) (some 3)))
        (check c (= (Character/forDigit 11 16) (some \b)))
        (check c (= (Character/forDigit 3 10) (some \3)))
        (check c (nil? (Character/forDigit 16 16)))
        (check c (nil? (Character/forDigit 1 40)))
        (checks-result c))))
