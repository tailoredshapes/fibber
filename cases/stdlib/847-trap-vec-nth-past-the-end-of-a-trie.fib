;; spec:   stdlib §5 (nth is the lookup that throws on a bad index, P5), types §2.13
;; expect: trap
;; trap:   nth: index out of range
;; A Vec of 1057 elements has a trie (one root branch, a leaf of the second
;; level, a tail of one element): index 1056 is its last element and 1057 is
;; one past it. The trie, not the tail, is where a bounds test is easiest to
;; get wrong: an index at or past the count must trap with the function's name
;; and not read a leaf slot that happens to exist. The value of the last
;; element is added first, so the trap is the second read.
(defun build (n: i64) -> (Vec i64)
  (loop ((i 0) (v (vec-empty)))
    (if (< i n) (recur (+ i 1) (conj v (* i 3))) v)))

(defun main () -> i64
  (let ((v (build 1057)))
    (+ (nth v 1056) (nth v 1057))))
