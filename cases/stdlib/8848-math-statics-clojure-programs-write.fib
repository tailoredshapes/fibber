;; spec:   stdlib §4.10 ("the Java spellings Math/sqrt, Math/pow, .. are modules of that name"), rows clojure.math/PI clojure.math/E
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: Math/exp Math/log10 Math/log1p Math/expm1 Math/sin Math/cos Math/tan Math/asin Math/acos Math/atan Math/atan2 Math/sinh Math/cosh Math/tanh Math/hypot Math/cbrt Math/rint Math/PI Math/E Math/max Math/min Math/signum Math/toDegrees Math/toRadians math/pi math/e math/PI math/E
;; The allerbees report: (Math/exp 1.0), (Math/sin 1.0), Math/PI and math/PI were unbound. The Math statics are fib.math's (libm);
;; the values that depend on libm's last digit are checked to 1e-15 relative (Java's values, which glibc's equal), the exact ones
;; for equality. PI and E are Java's Math.PI and Math.E; math/pi and math/e are the page's spelling of clojure.math/PI and /E.
(ns main (:use tl.check) (:require [fib.math :as math] [Math :as Math]))

(defun close? (a: f64 b: f64) -> bool (<= (abs (- a b)) (* 1e-15 (max 1.0 (abs b)))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= Math/PI 3.141592653589793))
        (check c (= Math/E 2.718281828459045))
        (check c (= math/PI Math/PI))
        (check c (= math/pi Math/PI))
        (check c (= math/E Math/E))
        (check c (= math/e Math/E))
        (check c (close? (Math/exp 1.0) 2.718281828459045))
        (check c (= (Math/exp 0.0) 1.0))
        (check c (close? (Math/sin 1.0) 0.8414709848078965))
        (check c (close? (Math/cos 1.0) 0.5403023058681398))
        (check c (close? (Math/tan 1.0) 1.5574077246549023))
        (check c (close? (Math/asin 1.0) 1.5707963267948966))
        (check c (close? (Math/acos 0.0) 1.5707963267948966))
        (check c (close? (Math/atan 1.0) 0.7853981633974483))
        (check c (close? (Math/atan2 1.0 1.0) 0.7853981633974483))
        (check c (close? (Math/atan2 -1.0 -1.0) -2.356194490192345))
        (check c (close? (Math/sinh 1.0) 1.1752011936438014))
        (check c (close? (Math/cosh 1.0) 1.5430806348152437))
        (check c (close? (Math/tanh 1.0) 0.7615941559557649))
        (check c (close? (Math/log 10.0) 2.302585092994046))
        (check c (= (Math/log10 1000.0) 3.0))
        (check c (close? (Math/expm1 1e-10) 1.00000000005e-10))
        (check c (close? (Math/log1p 1e-10) 9.999999999500001e-11))
        (check c (= (Math/hypot 3.0 4.0) 5.0))
        (check c (= (Math/cbrt 27.0) 3.0))
        (check c (= (Math/rint 2.5) 2.0))
        (check c (= (Math/max 2 7) 7))
        (check c (= (Math/min 2.5 -1.0) -1.0))
        (check c (= (Math/signum -3.0) -1.0))
        (check c (= (Math/toDegrees Math/PI) 180.0))
        (check c (= (Math/toRadians 180.0) Math/PI))
        (check c (close? (Math/sin Math/PI) 1.2246467991473532e-16))
        (checks-result c))))
