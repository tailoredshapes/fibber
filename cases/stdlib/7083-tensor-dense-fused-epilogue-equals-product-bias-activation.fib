;; spec: lib/fib/tensor/README.md (Fused dense layers): (dense x w b act) = act(x*w + b), bias and activation applied exactly once per output element
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; The oracle is the ordered fma reference product (gemm-fma-f32/fma-reference, scalar and checked), plus the bias, plus a scalar activation written here
;; (relu and identity exactly; gelu, silu, sigmoid and tanh from libm in f64 within a relative 1e-6). A fault that drops the bias or the activation on
;; tail tiles, applies either twice (every inner block instead of the last), reads the bias at the wrong column block, or mishandles a view changes
;; some element of these shapes: m = 110 spans two row blocks, n = 1030 two column blocks, k = 700 two inner blocks, the others every tail length.
(ns main (:require [fib.tensor :as t] [fib.tensor.gemm-fma-f32 :as g]) (:use tl.check))
(extern exp (f64) -> f64)
(extern tanh (f64) -> f64)

(defun gen (n: i64 seed: i64) -> (t/Tensor f32)
  (let ((buf (cell (array n 0.0f32))))
    (do (dotimes (i n) (array-set! &buf i (fdiv (float (- (rem (+ (* i 7919) (* seed 104729)) 1013) 500)) 37.0f32)))
        (t/from-array [n] @buf 0.0f32))))
(defun mat (m: i64 n: i64 seed: i64) -> (t/Tensor f32) (t/reshape [m n] (gen (* m n) seed)))

(defun act (name: keyword x: f32) -> f32
  (let ((d (double x)))
    (cond (= name :identity) x
          (= name :relu) (if (> x 0.0f32) x 0.0f32)
          (= name :tanh) (float (unsafe (tanh d)))
          (= name :sigmoid) (float (fdiv 1.0 (+ 1.0 (unsafe (exp (- 0.0 d))))))
          (= name :silu) (float (fdiv d (+ 1.0 (unsafe (exp (- 0.0 d))))))
          :else (float (* (* 0.5 d) (+ 1.0 (unsafe (tanh (* 0.7978845608028654 (+ d (* (* 0.044715 d) (* d d))))))))))))

(defun close? (name: keyword got: f32 want: f32) -> bool
  (if (or (= name :identity) (= name :relu)) (= got want)
      (let ((e (abs (- (double got) (double want))))) (<= e (+ 1.0e-30 (* 1.0e-6 (abs (double want))))))))

;; every element of `got` against act(product + bias)
(defun matches? (name: keyword got: (t/Tensor f32) prod: (t/Tensor f32) bias: (t/Tensor f32)) -> bool
  (let ((want (t/map (fn (v: f32) (act name v)) (t/add prod bias))) (g (t/to-vec got)) (w (t/to-vec want)))
    (and (= (t/shape got) (t/shape want))
         (loop ((i 0)) (if (< i (count g)) (if (close? name (nth g i) (nth w i)) (recur (+ i 1)) false) true)))))

(defun names () -> (Vec keyword) [:identity :relu :tanh :sigmoid :silu :gelu])

(defun main () -> i64
  (let ((c (checks)))
    (do ;; relu on every tail shape, bias of every kind
        (let ((ms [1 5 6 7 13 97 110]) (ns [1 7 8 9 17 40 1030]) (ks [1 3 300 513 700]))
          (dotimes (mi (count ms))
            (dotimes (ni (count ns))
              (dotimes (ki (count ks))
                (let ((m (nth ms mi)) (n (nth ns ni)) (k (nth ks ki)) (a (mat m k 1)) (b (mat k n 2)) (bias (gen n 3)))
                  (check c (matches? :relu (t/dense a b bias :relu) (g/fma-reference a b) bias)))))))
        ;; every activation on a shape with tails in all three directions and two inner blocks
        (let ((a (mat 13 700 1)) (b (mat 700 40 2)) (bias (gen 40 3)) (ns (names)))
          (dotimes (i (count ns))
            (check c (matches? (nth ns i) (t/dense a b bias (nth ns i)) (g/fma-reference a b) bias))))
        ;; a scalar bias, a stepped slice and a broadcast row as bias, mmul-bias
        (let ((a (mat 7 9 4)) (b (mat 9 21 5)) (p (g/fma-reference a b)))
          (do (check c (matches? :relu (t/dense a b (t/full [] -0.5f32) :relu) p (t/full [] -0.5f32)))
              (let ((wide (gen 42 6)) (sl (t/slice 0 1 42 2 wide)))
                (check c (matches? :identity (t/mmul-bias a b sl) p sl)))
              (let ((row (t/broadcast-to [1 21] (gen 21 7))))
                (check c (matches? :relu (t/dense a b (t/reshape [21] (t/copy row)) :relu) p (t/copy row))))))
        ;; views as operands: transposed, flipped, a slice
        (let ((a (mat 19 23 5)) (b (mat 23 21 6)) (at (t/transpose (mat 23 19 5))) (bt (t/transpose (mat 21 23 6))) (bias (gen 21 8)))
          (do (check c (matches? :relu (t/dense at b bias :relu) (g/fma-reference at b) bias))
              (check c (matches? :gelu (t/dense a bt bias :gelu) (g/fma-reference a bt) bias))
              (let ((fa (t/flip 1 a)) (fb (t/flip 0 b)))
                (check c (matches? :silu (t/dense fa fb bias :silu) (g/fma-reference fa fb) bias)))
              (let ((sa (t/slice 1 1 23 2 a)) (sb (t/slice 0 1 23 2 b)))
                (check c (matches? :relu (t/dense sa sb bias :relu) (g/fma-reference sa sb) bias)))))
        ;; negative pre-activations stay negative for identity and become +0.0 for relu (the sign of zero is part of `where`)
        (let ((a (t/full [3 4] -1.0f32)) (b (t/full [4 5] 1.0f32)) (bias (t/full [5] 0.0f32)))
          (do (check c (= (t/to-vec (t/dense a b bias :relu)) (t/to-vec (t/zeros-f32 [3 5]))))
              (check c (= (t/flat-at (t/dense a b bias :identity) 0) -4.0f32))))
        ;; the f64 path (composed) agrees with the same oracle idea
        (let ((a (t/reshape [3 4] (t/linspace -1.0 1.0 12))) (b (t/reshape [4 2] (t/linspace -2.0 2.0 8))) (bias (t/tensor [0.5 -0.5])))
          (check c (= (t/to-vec (t/dense a b bias :relu)) (t/to-vec (t/relu (t/add (t/mmul a b) bias))))))
        (check c (= (checks-made c) 261))
        (checks-result c))))
