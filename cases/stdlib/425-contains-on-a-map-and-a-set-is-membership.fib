;; spec:   stdlib §2.3 (Keyed), §4.5 (row contains?)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: contains? set
;; contains? on a Map asks for a key and on a Set for a member; a value of the
;; map is no key, and a key whose value is zero is still there (it is the
;; presence that is asked, never the truthiness of the value). The
;; Vec's index form of contains? is L8a's case.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (empty {1 0}) 1 0) 2 20))
        (s (set ["a" "b" "a"])))
    (do (check c (contains? m 1))
        (check c (contains? m 2))
        (check c (not (contains? m 20)))
        (check c (not (contains? m 3)))
        (check c (not (contains? (dissoc m 1) 1)))
        (check c (not (contains? (empty m) 1)))
        (check c (contains? s "a"))
        (check c (contains? s "b"))
        (check c (not (contains? s "c")))
        (check c (not (contains? (empty s) "a")))
        (check c (contains? (conj s "c") "c"))
        (check c (not (contains? s "c")))
        (checks-result c))))
