;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types fib.http.testing))
(defun refused? (text: str) -> bool (match (request-of [(str-bytes text)]) ((Err _) true) (_ false)))
(defun main () -> i64
  (let [c (checks) h "POST / HTTP/1.1\r\nHost: x\r\n"]
    (do (check c (refused? (str h "Content-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")))
        (check c (refused? (str h "Transfer-Encoding: xchunked\r\n\r\n0\r\n\r\n")))
        (check c (refused? (str h "Transfer-Encoding : chunked\r\n\r\n0\r\n\r\n")))
        (check c (refused? (str h "Content-Length: 3\r\nContent-Length: 3\r\n\r\nabc")))
        (check c (refused? (str h "Content-Length: -1\r\n\r\n")))
        (check c (refused? "GET / HTTP/1.1\nHost: x\n\n"))
        (check c (refused? (str h "X: a\r\n b\r\n\r\n")))
        (check c (refused? (str h "Transfer-Encoding: chunked\r\n\r\nffffffffffffffffff\r\n")))
        (check c (not (refused? (str h "Transfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n0\r\n\r\n"))))
        (checks-result c))))
