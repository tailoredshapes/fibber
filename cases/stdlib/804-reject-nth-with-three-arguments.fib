;; spec:   stdlib §7 D1, §4.4 (rows nth, nth-or), §5.5 S7
;; expect: reject
;; error:  nth takes 2 argument(s), got 3; use nth-or
;; roots:  ../../lib
;; covers: nth
;; `(nth c i d)`, Clojure's default when the index is out of range, is `nth-or`
;; until arity overloading lands (§7 L1); `nth` traps out of range (§2.4).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (nth [1 2] 1 0))
