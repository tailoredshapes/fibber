;; spec:   types §2.13.3 (array-blit!)
;; expect: trap
;; trap:   is out of range
;; roots:  ../../lib support
;; covers: array-blit!
;; A negative source offset is out of range even when the count is zero and the sum would fit.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((d (cell (array 6 0i8))) (s (array 10 1i8)))
    (do (array-blit! &d 0 s -1 0) 0)))
