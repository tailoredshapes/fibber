;; spec:   stdlib §4.15 (row future), §2.11, §5 M1 (the failing program), syntax §3.12
;; expect: reject
;; error:  cell cannot be shared between threads: closure capture c has type (Cell i64)
;; roots:  ../../lib
;; covers: future
;; A future runs on another thread, so its closure must be sendable, and a Cell is not: two tasks
;; writing one cell race (stdlib §5.1). The refusal is the checker's own, at the future, quoted by
;; the row of the table (A11 t41); an Atom is the shared state that may cross.
(ns main (:use fib.core fib.async))

(defun main () -> i64
  (let ((c (cell 1)))
    (let ((f (future (set! c 2) 3)))
      (join f))))
