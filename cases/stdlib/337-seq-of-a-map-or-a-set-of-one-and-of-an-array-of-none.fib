;; spec:   stdlib §2.1 rule 8 (seq is nil exactly when the collection is empty), §4.4 (rows seq, rest, next)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: seq rest next
;; The boundary of the emptiness test of each seq: a Map and a Set of exactly
;; one entry have a seq with that entry (cases 328 and 335 stop at three and
;; at none), an Array of none has none (case 329 only has an Array of one),
;; and the rest of the one-entry collections is empty so that `next` is nil.
(ns main (:use fib.core fib.seq tl.check))

(defun len (xs: c) :where ((Seqable c s) (Seqable s s)) -> i64
  (match (seq xs) (nil 0) ((some s) (+ 1 (len (rest s))))))

(defun is-empty (s: (Option t)) -> bool (match s (nil true) ((some _) false)))

(defun main () -> i64
  (let ((c (checks))
        (m {4 40})
        (st (conj (set-empty) 9))
        (none: (Array i64) (array 0 0))
        (two: (Array i64) (array 2 8)))
    (do (check c (not (is-empty (seq m))))
        (check c (not (is-empty (seq st))))
        (check c (is-empty (seq none)))
        (check c (= (len m) 1))
        (check c (= (len st) 1))
        (check c (= (len none) 0))
        (check c (= (len two) 2))
        (check c (is-empty (next m)))
        (check c (is-empty (next st)))
        (check c (is-empty (next none)))
        (check c (not (is-empty (next two))))
        (check c (match (seq m) (nil false) ((some s) (= (. (nth s 0) fst) 4))))
        (check c (match (seq st) (nil false) ((some s) (= (nth s 0) 9))))
        (check c (is-empty (seq (rest m))))
        (check c (is-empty (seq (rest st))))
        (check c (is-empty (seq (rest none))))
        (checks-result c))))
