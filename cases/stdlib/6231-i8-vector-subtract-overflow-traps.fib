;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in - at i8x16
;; stage:  2
;; roots:  ../../lib support
;; i8 lanes: -128 - 1.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i8x16 (with-lane (splat i8x16 0i8) 9 -128i8)))
    (do (println (lane (- a (splat i8x16 1i8)) 0)) 0)))
