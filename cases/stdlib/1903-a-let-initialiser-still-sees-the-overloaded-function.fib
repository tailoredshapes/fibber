;; spec:   stdlib §7 L1 (a name a form binds is not the clause set), expander scope
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; covers: defn
;; In `(let ((pick (pick 1 2))) ..)` the initialiser is evaluated before the name is bound, so it
;; is the call of the two-parameter clause; the body then has the local, an `i64`, and so has the
;; second binding of the same `let`.
(defn pick
  ([a: i64] -> i64 (* a 10))
  ([a: i64 b: i64] -> i64 (+ a b)))

(defun main () -> i64
  (let ((pick (pick 1 2))
        (other (+ pick 1)))
    (if (= pick 3) (if (= other 4) 0 2) 1)))
