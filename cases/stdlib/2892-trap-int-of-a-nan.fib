;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int
;; A NaN has no integer: every integer conversion of one traps (the page is silent, the header of
;; the part decides it; the other widths are the same code).
(defun main () -> i64 (sext i64 (int (/ 0.0 0.0))))
