;; spec:   stdlib §7 L7 (a defun takes `(PAT :as p: T)`), §5 D5
;; expect: accept
;; result: 111
;; audit:  clean
;; roots:  ../../lib support
;; A top-level function states its types, so its pattern parameter is `(PAT :as p: T)`: the
;; parameter is p at T and the pattern is matched against it at the start of the body, here
;; [a b] against a (Vec i64) of three (a prefix, as a let's) and (Pair x y) against a Pair.
(ns main (:use fib.core fib.coll))

(defun f (n: i64 ([a b] :as v: (Vec i64)) ((Pair x y) :as q: (Pair i64 i64))) -> i64
  (+ n (+ (* 10 (+ a b)) (+ x (+ y (count v))))))

(defun main () -> i64
  (f 1 [3 4 5] (Pair 20 17)))
