;; spec:   stdlib §6.3 (E3); syntax §3.3, §3.18
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: let loop
;; (let [a 1 b 2] ..) and (loop [i 0 acc 0] ..) are (let ((a 1) (b 2)) ..) and (loop ((i 0) (acc 0)) ..):
;; sequential, patterns on the left, and a name that ends in a colon takes a type and then the value.
(ns main (:use tl.check))

(defun main () -> i64
  (let [c (checks)
        a 1
        b (+ a 1)
        n: i64 40
        v: (Vec i64) [1 2 3]
        [x y] [10 20]]
    (do (check c (= (+ a b) 3))
        (check c (= n 40))
        (check c (= (count v) 3))
        (check c (= (+ x y) 30))
        (check c (= (loop [i 0 acc 0]
                      (if (< i 5) (recur (+ i 1) (+ acc i)) acc))
                    10))
        (check c (= (loop [i: i64 3 acc 1]
                      (if (> i 0) (recur (- i 1) (* acc 2)) acc))
                    8))
        (check c (= (let [] 7) 7))
        (checks-result c))))
