;; spec:   syntax §3.15a (lir), docs/design/inline-lir.md, lir.md 6.6 and 6.6a
;; expect: accept
;; result: 7
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A body is blocks, so a loop is blocks and a phi. A `ptr` may not cross a thread, so a cell is passed as the i64 of its address and turned back inside the lIR (`inttoptr`): one task spins
;; with `(spin-hint)` until the other publishes with a release store.
(ns main (:use fib.core tl.check))

(defun address (p: ptr) -> i64 (unsafe (lir [p: ptr] -> i64 "(BLOCK entry (RET (PTRTOINT I64 p)))")))
(defun publish (h: i64 v: i64) -> unit
  (unsafe (lir [h: i64 v: i64] -> unit "(BLOCK entry (ATOMIC-STORE RELEASE v (INTTOPTR PTR h)) (RET))")))
(defun wait-for-it (h: i64) -> i64
  (unsafe (lir [h: i64] -> i64
    "(BLOCK entry (BR look))
     (BLOCK look
       (LET ((v (ATOMIC-LOAD ACQUIRE I64 (INTTOPTR PTR h))))
         (BR (ICMP NE v (I64 0)) got again)))
     (BLOCK again (SPIN-HINT) (BR look))
     (BLOCK got (RET v))")))

(defun main () -> i64
  (unsafe (let [h (address (alloc 8))
                t (spawn (fn () (wait-for-it h)))]
            (do (publish h 7) (join t)))))
