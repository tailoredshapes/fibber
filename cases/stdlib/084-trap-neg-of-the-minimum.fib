;; spec:   stdlib §4.3 (row neg), types §2.12 (overflow traps at every width)
;; expect: trap
;; trap:   integer overflow in neg at i8
;; roots:  ../../lib
;; covers: neg
;; The smallest i8 has no negation that fits an i8, and the builtin neg traps
;; naming the width; abs of it is the same trap (case 054 at i64).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (neg -128i8)))
    (if (= x 0i8) 1 2)))
