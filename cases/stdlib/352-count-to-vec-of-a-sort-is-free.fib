;; spec:   stdlib §2.1 rule 4 and §4.4 (row sort: `(vec (sort xs))` is the sorted Vec itself), §8.1 item 5 (count cases)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 1053
;; roots:  ../../lib support
;; covers: sort
;; to-vec of a VSeq with no front and offset 0 is the sorted Vec it holds, not
;; a copy: sorting 500 integers once and asking for the Vec 30 times
;; allocates exactly what case 350 does, which asks once. A copy per call
;; would add about 1000 objects to each of the 30. The bound is the count of
;; case 350, measured here too; it is the only reading of "allocates
;; nothing beyond the sort".
(ns main (:use fib.core fib.seq tl.check))

(def input: (Vec i64) [13 210 407 101 298 495 189 386 80 277 474 168 365 59 256 453 147 344 38 235 432 126 323 17 214 411 105 302 499 193 390 84 281 478 172 369 63 260 457 151 348 42 239 436 130 327 21 218 415 109 306 0 197 394 88 285 482 176 373 67 264 461 155 352 46 243 440 134 331 25 222 419 113 310 4 201 398 92 289 486 180 377 71 268 465 159 356 50 247 444 138 335 29 226 423 117 314 8 205 402 96 293 490 184 381 75 272 469 163 360 54 251 448 142 339 33 230 427 121 318 12 209 406 100 297 494 188 385 79 276 473 167 364 58 255 452 146 343 37 234 431 125 322 16 213 410 104 301 498 192 389 83 280 477 171 368 62 259 456 150 347 41 238 435 129 326 20 217 414 108 305 502 196 393 87 284 481 175 372 66 263 460 154 351 45 242 439 133 330 24 221 418 112 309 3 200 397 91 288 485 179 376 70 267 464 158 355 49 246 443 137 334 28 225 422 116 313 7 204 401 95 292 489 183 380 74 271 468 162 359 53 250 447 141 338 32 229 426 120 317 11 208 405 99 296 493 187 384 78 275 472 166 363 57 254 451 145 342 36 233 430 124 321 15 212 409 103 300 497 191 388 82 279 476 170 367 61 258 455 149 346 40 237 434 128 325 19 216 413 107 304 501 195 392 86 283 480 174 371 65 262 459 153 350 44 241 438 132 329 23 220 417 111 308 2 199 396 90 287 484 178 375 69 266 463 157 354 48 245 442 136 333 27 224 421 115 312 6 203 400 94 291 488 182 379 73 270 467 161 358 52 249 446 140 337 31 228 425 119 316 10 207 404 98 295 492 186 383 77 274 471 165 362 56 253 450 144 341 35 232 429 123 320 14 211 408 102 299 496 190 387 81 278 475 169 366 60 257 454 148 345 39 236 433 127 324 18 215 412 106 303 500 194 391 85 282 479 173 370 64 261 458 152 349 43 240 437 131 328 22 219 416 110 307 1 198 395 89 286 483 177 374 68 265 462 156 353 47 244 441 135 332 26 223 420 114 311 5 202 399 93 290 487 181 378 72 269 466 160 357 51 248 445 139 336 30 227 424 118 315 9 206 403 97 294 491 185 382 76 273 470 164 361 55 252 449 143 340 34 231])

(defun main () -> i64
  (let ((c (checks))
        (s (sort input))
        (first-out (to-vec s)))
    (do (dotimes (i 30) (check c (= (fib.prelude/count (to-vec s)) 500)))
        (check c (= (fib.prelude/nth (to-vec s) 499) (fib.prelude/nth first-out 499)))
        (check c (= (fib.prelude/nth first-out 0) 0))
        (checks-result c))))
