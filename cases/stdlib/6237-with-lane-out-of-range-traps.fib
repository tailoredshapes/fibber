;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   lane index out of range
;; stage:  2
;; roots:  ../../lib support
;; with-lane at index -1 (a huge unsigned index) traps.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i32x3 <<1 2 3>>i32) (i (- 0 (hsum <<1 0>>i64))))
    (do (println (lane (with-lane a i 5i32) 0)) 0)))
