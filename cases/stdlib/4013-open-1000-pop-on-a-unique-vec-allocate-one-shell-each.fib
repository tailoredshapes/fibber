;; spec:   design/in-place-update.md §6 T9 (counts), §5 L3, stdlib §2.5, §8.1 item 5 (count cases)
;; expect: accept
;; result: 99007
;; audit:  clean
;; allocs: <= 7626
;; roots:  ../../lib support
;; open:   L3
;; covers: pop
;; 1000 `pop` from the Vec of 100000 that `(vec (range 100000))` builds (6476 objects). Today a pop copies the tail without its last
;; element (`array-copy`) and makes a new `VecOf`: 8629 objects in all (measured with `fibc run --trace`), 2.15 per pop. In place (L3,
;; `array-pop!`) a pop allocates its `VecOf` shell and, every 32 pops, the tail that the last leaf becomes: the bound is the build, 1000
;; shells and 150. OPEN for L3; case 4014 is its L5 form (no shell).
(ns main (:use fib.core fib.seq fib.coll))

(defun big () -> (Vec i64) (vec (range 100000)))

;; 1000 pop on a vector that nobody else holds
(defun main () -> i64
  (let ((v (loop ((i 0) (v (big))) (if (>= i 1000) v (recur (+ i 1) (pop v))))))
    (+ (count v) (nth v 7))))
