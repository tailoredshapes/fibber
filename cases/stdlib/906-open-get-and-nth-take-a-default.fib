;; spec:   stdlib §5.5 S7, §7 L1 (arity overloading)
;; expect: accept
;; result: 16
;; audit:  clean
;; open:   L1
;; Clojure's (get m k default) and (nth v i default): the third argument is
;; what a missing key or an index out of range gives. Today the builtins
;; take two: `get takes 2 argument(s), got 3`. The stand-ins get-or and
;; nth-or run (stdlib §2.3); L1 deletes them with this case's flip.
(defun main () -> i64
  (let ((m (assoc (map-empty) 1 10)))
    (+ (get m 2 7) (nth [1 2] 5 9))))
