;; spec: lib/fib/parallel/pmap.fib (pmap-chunks), lib/prelude.fib (vec-chunk-leaves, vec-join-leaves); docs/shootout/parallel.md (the serial assembly of a Vec result)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; covers: pmap pmap-n pmap-each
;; From 8192 results a call builds its Vec from leaves that the workers cut (the grain is a multiple of 32; the last chunk's last 1 to 32 elements are the tail). For every size around the
;; switch (8191, 8192) and around a leaf boundary (a tail of 1, of 31, of 32 elements; 32 x 257, 32 x 257 + 1), every worker count (1, 2, 3, 8) and grains that are and are not
;; multiples of 32, the Vec equals `(mapv f (range n))`, its count is n, `nth` is right at the leaf and chunk boundaries, and the Vec behaves as any other afterwards (`conj`, `assoc`, `pop`
;; leave the original as it was). A join that dropped the tail, repeated a leaf, or left a chunk in the wrong place fails the equality.
(ns main (:use fib.core fib.parallel tl.check))

(defun f (i: i64) -> i64 (+ (* i 3) 1))

(defun check-size (c: Checks n: i64 w: i64 grain: i64) -> unit
  (let ((want (mapv f (range n))) (got (pmap-n (Par w grain false) f n)))
    (do (check c (= got want))
        (check c (= (count got) n))
        (dotimes (k 6)
          (let ((i (nth [0 31 32 (- n 1) (quot n 2) (- n 33)] k)))
            (when (and (>= i 0) (< i n)) (check c (= (nth got i) (f i))))))
        (check c (= (count (conj got 7)) (+ n 1)))
        (check c (= (nth (conj got 7) n) 7))
        (check c (= (nth (assoc got 5 -1) 5) -1))
        (check c (= (nth got 5) (f 5)))
        (check c (= (count (pop got)) (- n 1)))
        (check c (= got want)))))

(defun main () -> i64
  (let ((c (checks)) (q (checks)))
    (do (doseq (n [8191 8192 8193 8223 8224 8225 8256 10000])
          (doseq (w [1 2 3 8])
            (doseq (g [0 1 100 4096])
              (check-size c n w g))))
        ;; the closure form over a Vec: the same engine
        (let ((xs (vec (range 9000))))
          (check c (= (pmap (Par 4 0 false) f xs) (mapv f xs)))
          (check c (= (pmap-each [x xs (Par 3 700 false)] (f x)) (mapv f xs))))
        ;; planted: a Vec one element short must be detected
        (check q (= (pmap-n (Par 4 0 false) f 9000) (mapv f (range 9001))))
        (check-detects c q)
        (checks-result c))))
