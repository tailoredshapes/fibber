;; spec:   stdlib §2.3 (Truthy), §4.4 (rows every? not-any?), A11 t05
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: every? not-any?
;; A predicate result is a Truthy: a bool, or an Option (nil is false, a
;; value is true), as Clojure's `(every? #(get m %) ks)` works with a map
;; lookup that answers the value or nil. Here the lookup is the prelude's
;; map-get (case 219 is the same program over the generic `get` of fib.coll);
;; an Option-valued function of the program's own does the same. Even a stored value that is falsy to Clojure (0) is truthy
;; here, because it is a `some`.
(ns main (:use fib.core fib.seq tl.check))

(defun big (x: i64) -> (Option i64) (if (> x 2) (some (* x 2)) nil))

(defun main () -> i64
  (let ((c (checks))
        (m (fib.prelude/map-assoc (fib.prelude/map-assoc (map-empty) 1 10) 2 0)))
    (do (check c (every? (fn (k) (fib.prelude/map-get m k)) [1 2]))
        (check c (not (every? (fn (k) (fib.prelude/map-get m k)) [1 2 3])))
        (check c (not-any? (fn (k) (fib.prelude/map-get m k)) [7 8 9]))
        (check c (not (not-any? (fn (k) (fib.prelude/map-get m k)) [7 2 9])))
        (check c (every? big [3 4 5]))
        (check c (not (every? big [3 2 5])))
        (check c (not-any? big (list 1 2)))
        (check c (not (not-any? big (list 1 5))))
        (checks-result c))))
