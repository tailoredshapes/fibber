;; spec:   stdlib §4.4 (rows count empty?), §2.1 rule 4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: count empty?
;; count is size: 0 for every kind of empty source, 1 for an Option that
;; holds a value, and a walk for a source that keeps no count (a lazy seq
;; and a user type) and a closed form for a Range of integers, which is empty
;; when its start is its end or its step points away from it; it agrees with the
;; length of to-vec, and with empty?.
(ns main (:use fib.core fib.seq tl.check))

(defstruct Upto (n: i64))

(impl (Reducible i64) Upto
  (each-while (self k)
    (loop ((i 0)) (if (< i (. self n)) (if (k i) (recur (+ i 1)) false) true))))

(defun agrees (c: Checks s: s n: i64) :where ((Reducible s i64)) -> unit
  (do (check c (= (count s) n))
      (check c (= (size s) n))
      (check c (= (count (to-vec s)) n))
      (check c (= (empty? s) (= n 0)))))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil)
        (ev: (Vec i64) (vec-empty))
        (el: (List i64) (list)))
    (do (agrees c ev 0)
        (agrees c el 0)
        (agrees c none 0)
        (agrees c (Upto 0) 0)
        (agrees c (VSeq (list) (vec-empty) 0) 0)
        (agrees c (lazy-node (fn () LNil)) 0)
        (agrees c (range 0) 0)
        (agrees c (range-by 5 5 1) 0)
        (agrees c (range-by 5 9 -1) 0)
        (agrees c (some 4) 1)
        (agrees c (range 1) 1)
        (agrees c (range 3) 3)
        (agrees c (range-by 0 10 3) 4)
        (agrees c (range-by 10 0 -3) 4)
        (agrees c [7] 1)
        (agrees c (Upto 3) 3)
        (agrees c (list 1 2 3 4) 4)
        (agrees c (lcons 1 (lcons 2 (lazy-node (fn () LNil)))) 2)
        (agrees c (VSeq (list 1) [2 3 4] 1) 3)
        (checks-result c))))
