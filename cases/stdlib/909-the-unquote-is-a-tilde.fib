;; spec:   stdlib §5.5 S12, syntax §1.1, §7 E14 (Clojure's reader)
;; expect: accept
;; result: 8
;; audit:  clean
;; Clojure's unquote is ~x. The reader reads ~x and ~@x as (unquote x) and
;; (unquote-splicing x), and the comma is whitespace, so a macro template
;; is written with ~.
(defmacro twice (x) `(+ ~x ~x))

(defun main () -> i64 (twice 4))
