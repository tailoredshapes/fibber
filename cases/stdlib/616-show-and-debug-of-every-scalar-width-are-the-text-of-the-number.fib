;; spec:   stdlib §2.7 (Show, Debug and ToStr of the scalars), §2.3
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; Each of the eight scalar types has an instance of each of the three printers
;; (fib.print.show), and the three give the text of the number: the instances
;; of ToStr are case 600's, these are Show and Debug at i8, i16, i32, i64, f32,
;; f64 and bool, at the ends of each range (the text of a negative number
;; keeps its sign), and through the generic callers that the other printed
;; types use: a Vec, a Pair, a Triple and an Option of each width print the
;; text of its elements, so a missing Debug or Show instance of one width is
;; a program the checker refuses and a wrong one a wrong text. The floats are
;; the ones whose text is the same before and after C12.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks))
        (b8: i8 -128i8)
        (b16: i16 -32768i16)
        (b32: i32 -2147483648i32)
        (b64: i64 (- -9223372036854775807 1))
        (none: (Option i8) nil))
    (do (check c (= (show 127i8) "127"))
        (check c (= (debug 127i8) "127"))
        (check c (= (show b8) "-128"))
        (check c (= (debug b8) "-128"))
        (check c (= (show 32767i16) "32767"))
        (check c (= (debug 32767i16) "32767"))
        (check c (= (show b16) "-32768"))
        (check c (= (debug b16) "-32768"))
        (check c (= (show 2147483647i32) "2147483647"))
        (check c (= (debug 2147483647i32) "2147483647"))
        (check c (= (show b32) "-2147483648"))
        (check c (= (debug b32) "-2147483648"))
        (check c (= (show 0) "0"))
        (check c (= (debug 0) "0"))
        (check c (= (show b64) "-9223372036854775808"))
        (check c (= (debug b64) "-9223372036854775808"))
        (check c (= (show 0.25f32) "0.25"))
        (check c (= (debug 0.25f32) "0.25"))
        (check c (= (debug -1.5f32) "-1.5"))
        (check c (= (show 1.5) "1.5"))
        (check c (= (debug 1.5) "1.5"))
        (check c (= (debug -100.0) "-100.0"))
        (check c (= (show true) "true"))
        (check c (= (debug true) "true"))
        (check c (= (show false) "false"))
        (check c (= (debug false) "false"))
        (check c (= (debug [1i8 -2i8]) "[1 -2]"))
        (check c (= (show [1i16 -2i16]) "[1 -2]"))
        (check c (= (debug [3i32]) "[3]"))
        (check c (= (debug [0.5f32 1.5f32]) "[0.5 1.5]"))
        (check c (= (show [0.5 1.5]) "[0.5 1.5]"))
        (check c (= (debug [true false]) "[true false]"))
        (check c (= (debug (Pair 1i8 true)) "[1 true]"))
        (check c (= (show (Triple 2i16 3i32 0.5f32)) "[2 3 0.5]"))
        (check c (= (debug (Triple 2i16 3i32 0.5f32)) "[2 3 0.5]"))
        (check c (= (debug (some 7i8)) "7"))
        (check c (= (debug none) "nil"))
        (check c (= (str (Pair 1i8 true)) "[1 true]"))
        (checks-result c))))
