;; spec:   stdlib §4.1 (row ==), §2.8 (Variables), §7 L26 (b)
;; expect: accept
;; result: 1
;; audit:  clean
;; roots:  ../../lib
;; open:   L26
;; covers: ==
;; Clojure's == compares numbers of different types by value: (== 3 3.0) is true, whichever of the two is a
;; variable. The operator-level promotion of L26 (b) makes the integer a float where the two meet.
;; Today `==` is = on one type: `cannot unify f64 with i64` (A11 n1). For a literal operand the rule
;; is L19's, tranche 2.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((n 3))
    (if (== n 3.0) 1 0)))
