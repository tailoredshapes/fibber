;; spec:   docs/design/stack.md, docs/adr/0009 (fatal list), types §2.11
;; expect: trap
;; trap:   stack overflow
;; roots:  ../../lib support
;; Package LANG-2 (fixed): a non-tail recursion that outruns the main stack used to end the process with SIGSEGV and no word (status 139 under `fibc run`, nothing on
;; standard error). It is now `trap: stack overflow` and status 134, as every trap. The depth is far past the main stack's 256 MiB (16 bytes a frame is
;; 16 million frames; this asks for a billion). Killed by: scripts/mutant-stack-guard.sh `no-handler`, `any-fault` and `window`.
(ns main)

(defun climb (n: i64) -> i64
  (if (= n 0) 0 (- (* 2 n) (climb (- n 1)))))

(defun main () -> i64
  (climb 1000000000))
