;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see); docs/design/vec-performance.md item 2; compiler/expand/fuseinline.fib, fuseflow.fib
;; expect: trap
;; trap:   predicate refused 40
;; roots:  ../../lib support
;; covers: vec filter map
;; A predicate put in line in a filter chain (case 4214) traps as the closure did: at the element that makes it trap (here the
;; 42nd, in the second leaf of the Vec, after outputs before it), with its own message.
(ns main (:use fib.core fib.seq))

(defun upto (n: i64) -> (Vec i64)
  (loop ((i 0) (acc [])) (if (< i n) (recur (+ i 1) (conj acc i)) acc)))

(defun main () -> i64
  (count (vec (filter (fn (x: i64) (if (= x 40) (trap (str "predicate refused " x)) (= (rem x 2) 0))) (map (fn (x) (- x 1)) (upto 70))))))
