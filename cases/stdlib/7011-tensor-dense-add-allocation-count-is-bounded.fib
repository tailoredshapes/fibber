;; spec: docs/design/numerical-library.md; dense arithmetic must not allocate per element
;; expect: accept
;; result: 12288
;; audit: clean
;; allocs: <= 55
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.tensor :as t]))
(def a (t/full [4096] 1.0))
(def b (t/full [4096] 2.0))
(defun main () -> i64 (long (t/sum-fast (t/add a b))))
