;; spec:   stdlib §4.4 (rows iterate, count), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   count: never ends
;; roots:  ../../lib support
;; covers: iterate count
;; Count of an iterate: no walk of it reaches an end, so the size method traps where the default would hang.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (count (iterate inc 0)))
