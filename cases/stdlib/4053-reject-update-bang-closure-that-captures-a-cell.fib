;; spec:   stdlib §2.5 (update!: f is a Send closure, so it cannot touch the cell it updates)
;; expect: reject
;; error:  cell cannot be shared between threads
;; roots:  ../../lib support
;; covers: update!
;; While f runs the cell holds nothing, so f must not be able to read the cell: f is `(fn :send (a) a)` and a Cell is
;; not Send, so a closure that captures the cell (or any cell) is refused where it is written.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((c (cell [1 2])))
    (do (update! c (fn (x) (conj x (count @c))))
        0)))
