;; spec:   syntax §5 (a local definition shadows an implicit name), stdlib §6.1, owner's rule of 2026-10-01
;; expect: accept
;; result: 0
;; audit:  clean
;; A program's own `map`, `first` and `get` are not an error and are not the library's:
;; own definitions come first, then `:use`s, then the implicit library, then the prelude.
;; The program's `map` answers -1 where the library's would answer a seq, its `first`
;; takes no Option, and `count`, which it does not define, is still the library's.
(defun map (f: (fn (i64) i64) v: (Vec i64)) -> i64 -1)
(defun first (v: (Vec i64)) -> i64 (vec-nth v 0))
(defun get (m: (Map i64 i64) k: i64) -> i64 (unwrap-or (map-get m k) 0))

(defun main () -> i64
  (+ (+ (map inc [1 2]) 1)
     (+ (- (first [5 6]) 5)
        (+ (- (get {1 7} 1) 7)
           (- (count [1 2 3]) 3)))))
