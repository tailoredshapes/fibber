;; spec:   stdlib §5.5 S2, §7 L14, §4.2 row `:k` (`(:k m)`), §8.2.1 item 6
;; expect: accept
;; result: 103
;; audit:  clean
;; roots:  ../../lib support
;; covers: :k
;; The keyword half of S2 (case 901 keeps the collections): a keyword is a function of a struct, where it is the field
;; read, and of a (Map keyword v), where it is the `get`; `(:k x d)` supplies a default; and a keyword is a function
;; where one is expected, `(map :age ps)`.
;; The result: 30 + 61 + 7 + 5.
(defstruct Person (name: str age: i64))

(defun main () -> i64
  (let ((p (Person "ann" 30))
        (ps [(Person "ann" 30) (Person "bob" 31)])
        (m (assoc (map-empty) :a 7)))
    (+ (+ (:age p) (reduce + 0 (map :age ps)))
       (+ (match (:a m) ((some x) x) (nil 0)) (:z m 5)))))
