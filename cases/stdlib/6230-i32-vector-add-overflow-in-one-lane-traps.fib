;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in + at i32x4
;; stage:  2
;; roots:  ../../lib support
;; Only lane 3 overflows: the check is lanewise, any lane traps.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i32x4 <<1 2 3 2147483647>>i32) (b: i32x4 <<1 1 1 1>>i32))
    (do (println (lane (+ a b) 0)) 0)))
