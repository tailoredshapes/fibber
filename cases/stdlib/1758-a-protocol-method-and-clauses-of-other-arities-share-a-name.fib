;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; The method is the one-argument `size`; the clauses of two and three arguments
;; are functions of the same name. The call picks by count: a count that is a
;; clause's is the clause, the method's count is left to the protocol.
(ns main (:use tl.check))

(defprotocol Sized (size (self) -> i64))
(defstruct Box (n: i64))
(impl Sized Box (size (self) (. self n)))

(defn size
  ([a: Box b: Box] -> i64 (+ (size a) (size b)))
  ([a: Box b: Box c: Box] -> i64 (+ (size a b) (size c))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (size (Box 4)) 4))
        (check c (= (size (Box 1) (Box 2)) 3))
        (check c (= (size (Box 1) (Box 2) (Box 4)) 7))
        (checks-result c))))
