;; spec:   stdlib §2.1 rule 1 and 3 (each-while's result says whether the walk ran to the end), tranche 1 plan §5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: take take-while concat
;; each-while answers false exactly when the visitor stopped the walk. A
;; recipe that ends by its own rule has run to the end and answers true: a
;; Taken at its n-th element, a TakenWhile at the first element that fails.
;; A visitor that says false stops every recipe at once, at its n-th element
;; of a Taken as well (the visitor, not the Taken, ended that walk), through
;; a Mapcat's inner source and from the first part of a Cat, and the source
;; is not asked for another element after it.
(ns main (:use fib.core fib.seq tl.check))

;; visits until it has seen `limit` elements, saying false at the limit-th;
;; the result is [what each-while answered, how many elements it saw]
(defun walk (c: c limit: i64) :where ((Reducible c i64)) -> (Pair bool i64)
  (let ((seen (cell 0)))
    (let ((done (each-while c (fn (x) (do (set! seen (+ @seen 1)) (< @seen limit))))))
      (Pair done @seen))))

(defun main () -> i64
  (let ((c (checks))
        (v [1 2 3 4 5]))
    (do ;; run to the end: true
        (check c (. (walk (Mapped v (fn (x: i64) x)) 99) fst))
        (check c (. (walk (Filtered v (fn (x: i64) (> x 2))) 99) fst))
        (check c (. (walk (Taken v 3) 99) fst))
        (check c (. (walk (Taken v 99) 99) fst))
        (check c (. (walk (Taken v 0) 99) fst))
        (check c (. (walk (Dropped v 2) 99) fst))
        (check c (. (walk (TakenWhile v (fn (x: i64) (< x 3))) 99) fst))
        (check c (. (walk (TakenWhile v (fn (x: i64) true)) 99) fst))
        (check c (. (walk (Mapcat v (fn (x: i64) [x x])) 99) fst))
        (check c (. (walk (Cat v v) 99) fst))
        ;; the visitor stops at its third element: false, with three seen
        (check c (not (. (walk (Mapped v (fn (x: i64) x)) 3) fst)))
        (check c (not (. (walk (Filtered v (fn (x: i64) (> x 1))) 3) fst)))
        (check c (not (. (walk (Taken v 3) 3) fst)))
        (check c (not (. (walk (Taken v 5) 3) fst)))
        (check c (not (. (walk (Dropped v 1) 3) fst)))
        (check c (not (. (walk (TakenWhile v (fn (x: i64) (< x 4))) 3) fst)))
        (check c (not (. (walk (Mapcat v (fn (x: i64) [x x])) 3) fst)))
        (check c (not (. (walk (Cat v v) 3) fst)))
        (check c (not (. (walk (Cat v v) 7) fst)))
        (check c (. (walk (Cat v v) 11) fst))
        (check c (= (. (walk (Taken v 3) 3) snd) 3))
        (check c (= (. (walk (Taken v 3) 99) snd) 3))
        (check c (= (. (walk (TakenWhile v (fn (x: i64) (< x 3))) 99) snd) 2))
        (check c (= (. (walk (Mapcat v (fn (x: i64) [x x])) 3) snd) 3))
        (check c (= (. (walk (Cat v v) 7) snd) 7))
        ;; the same through the lazy forms
        (check c (. (walk (take 3 v) 99) fst))
        (check c (not (. (walk (take 3 v) 3) fst)))
        (check c (. (walk (take-while (fn (x: i64) (< x 3)) v) 99) fst))
        (check c (not (. (walk (concat v v) 4) fst)))
        (checks-result c))))
