;; spec:   stdlib §2.3 (Lookup), §1.2 P5 (nil is an Option)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; get on a Vec by index is (some x) in range and nil out of it, below zero
;; included: Clojure's (get [10 20] 5) is nil, never a trap. nth is the
;; one that traps (case 016).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (v [10 20]))
    (do (check c (match (get v 0) ((some x) (= x 10)) (nil false)))
        (check c (match (get v 1) ((some x) (= x 20)) (nil false)))
        (check c (match (get v 2) ((some _) false) (nil true)))
        (check c (match (get v -1) ((some _) false) (nil true)))
        (check c (match (get (empty v) 0) ((some _) false) (nil true)))
        (checks-result c))))
