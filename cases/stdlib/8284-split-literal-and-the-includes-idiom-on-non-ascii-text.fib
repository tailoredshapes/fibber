;; spec: spec/stdlib.md section 4.7 (`str/split-literal` new, `str/split`, `str/includes?`), section 4.5 (`includes?` the element test, `contains?` the key test)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Package FOLLOWUP-1. `str/split-literal` is `split` for a separator that is a str, taken literally (a "." is a dot, not a regex), with Java's limit; an empty separator cuts into characters; offsets
;; are bytes inside and the pieces are whole characters. The idiom the library has for "is it in there": `str/includes?` for a substring (clojure.string's, string only), `includes?` for an element of any
;; Reducible (a Vec, a Set's members, the characters of a str), `contains?` for a key or index (Clojure's), so a program asks for the one it means; each is pinned on non-ASCII text.
(ns main (:use tl.check fib.coll) (:require [fib.string :as s]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (s/split-literal "a.b.c" ".") ["a" "b" "c"]))
        (check c (= (s/split-literal "a.b.c" "." 2) ["a" "b.c"]))
        (check c (= (s/split-literal "a,b,," ",") ["a" "b"]))
        (check c (= (s/split-literal "a,b,," "," -1) ["a" "b" "" ""]))
        (check c (= (s/split-literal "abc" "") ["a" "b" "c"]))
        (check c (= (s/split-literal "" ",") [""]))
        (check c (= (s/split-literal "nosep" ",") ["nosep"]))
        (check c (= (s/split-literal "a||b" "||") ["a" "b"]))
        (check c (= (s/split-literal "caf\u{e9},\u{20ac}uro,x" ",") ["caf\u{e9}" "\u{20ac}uro" "x"]))
        (check c (= (s/split-literal "\u{e9}\u{20ac}\u{1f600}" "") ["\u{e9}" "\u{20ac}" "\u{1f600}"]))
        (check c (= (s/split-literal "a\u{20ac}b\u{20ac}c" "\u{20ac}" 2) ["a" "b\u{20ac}c"]))
        (check c (= (s/split-literal "a.b" ".") (s/split "a.b" ".")))
        (check c (s/includes? "caf\u{e9}s" "\u{e9}s"))
        (check c (s/includes? "caf\u{e9}s" ""))
        (check c (not (s/includes? "caf\u{e9}s" "e")))
        (check c (includes? 3 [1 2 3]))
        (check c (not (includes? 4 [1 2 3])))
        (check c (includes? "b" ["a" "b"]))
        (check c (includes? (char 233) "caf\u{e9}"))
        (check c (not (includes? (char 101) "caf\u{e9}")))
        (check c (contains? {:a 1} :a))
        (check c (contains? [10 20] 1))
        (check c (not (contains? [10 20] 2)))
        (checks-result c))))
