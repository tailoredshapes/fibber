;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: trap
;; trap:   BigInt: divide by zero
;; roots:  ../../lib
;; The truncated quotient of a BigInt by zero traps, a big operand included (the divisor is the one the
;; limb loops would otherwise divide by); Java throws ArithmeticException "BigInteger divide by zero".
(ns main (:use fib.bigint))

(defun main () -> i64
  (let [a (expt (bigint 10) 50)
        z (- a a)]
    (do (println (quot a z)) 0)))
