;; spec:   stdlib §7 L19 (L26 is not in this rule)
;; expect: reject
;; error:  cannot unify i64 with i32
;; roots:  support
;; covers: +
;; The adoption is for the float types only: (+ x 1) with x an i32 is still the mismatch
;; (case n3c of the audit).
(ns main (:use tl.check))

(defun bump (x: i32) -> i32
  (+ x 1))

(defun main () -> i64
  (if (= (bump 1i32) 2i32) 1 0))
