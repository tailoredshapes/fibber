;; spec:   stdlib §2.8 ((Ratio t): Ord), Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: /
;; < <= > >= on ratios compare the numbers, not the fields: 1/3 < 1/2, and
;; -1/2 < -1/3 although the denominator 2 is smaller than 3. The pairs with
;; equal integer parts (7/3 and 9/4, both between 2 and 3; and -2/5 and -1/2,
;; both between -1 and 0, where the fractional part is the distance above the
;; integer below) are the ones that send the comparison to the fractional parts.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (< (/ 1 3) (/ 1 2)))
        (check c (not (< (/ 1 2) (/ 1 3))))
        (check c (> (/ 1 2) (/ 1 3)))
        (check c (<= (/ 1 3) (/ 1 2)))
        (check c (<= (/ 1 2) (/ 2 4)))
        (check c (>= (/ 1 2) (/ 2 4)))
        (check c (>= (/ 1 2) (/ 1 3)))
        (check c (not (< (/ 1 2) (/ 2 4))))
        (check c (not (> (/ 1 2) (/ 2 4))))
        (check c (< (/ -1 2) (/ -1 3)))
        (check c (< (/ -1 2) (/ 1 3)))
        (check c (> (/ 1 3) (/ -1 2)))
        (check c (< (/ -7 2) (/ -10 3)))
        (check c (> (/ 7 3) (/ 9 4)))
        (check c (< (/ 9 4) (/ 7 3)))
        (check c (< (/ 5 2) (/ 8 3)))
        (check c (< (/ -8 3) (/ -5 2)))
        (check c (< (/ 0 1) (/ 1 100)))
        (check c (> (/ 0 1) (/ -1 100)))
        (check c (> (/ -2 5) (/ -1 2)))
        (check c (< (/ -1 2) (/ -2 5)))
        (check c (> (/ -3 7) (/ -1 2)))
        (check c (> (/ -2 7) (/ -1 3)))
        (check c (< (/ 2 1) (/ 5 2)))
        (check c (< (/ -5 2) (/ -2 1)))
        (checks-result c))))
