;; spec:   stdlib §2.3 (Cmp), §2.1 (Clojure's comparator rule)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; A comparator returns an i64 (negative, zero, positive) or a bool, which
;; is Clojure's predicate form: true means "a before b" (-1); false asks the
;; swapped call, and if that is true then b is before a (1), else they are
;; equal (0). resolve runs the swapped call only for a false, so a counter
;; shows it is made once then and never for an i64 or a true.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (swaps (cell 0)))
    (do (check c (= (resolve 5 (fn () (do (set! swaps (+ @swaps 1)) 0))) 5))
        (check c (= (resolve -3 (fn () 0)) -3))
        (check c (= (resolve 0 (fn () 1)) 0))
        (check c (= @swaps 0))
        (check c (= (resolve true (fn () (do (set! swaps (+ @swaps 1)) true))) -1))
        (check c (= @swaps 0))
        (check c (= (resolve false (fn () (do (set! swaps (+ @swaps 1)) true))) 1))
        (check c (= @swaps 1))
        (check c (= (resolve false (fn () false)) 0))
        (checks-result c))))
