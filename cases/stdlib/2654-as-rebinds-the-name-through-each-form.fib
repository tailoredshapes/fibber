;; spec:   stdlib §4.3 (row as->), §6.3, tranche 2 plan Y6
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: as->
;; (as-> x v form ..) binds v to x, then to the value of each form in turn, each form seeing the one before; the
;; value of the last form is the answer, and with no form the answer is x. The placeholder may stand anywhere in a
;; form: first, last, in two places or nested deeper. x is evaluated once and outside the scope of v, so
;; (as-> v v ..) means the caller's v; the forms run in order, which a counter shows.
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (log (cell 0)))
    (do (check c (= (as-> 5 v (+ v 1) (* v v) (- v 3)) 33))
        (check c (= (as-> 5 v) 5))
        (check c (= (as-> 5 v (+ v v)) 10))
        (check c (= (as-> 3 v (+ v 1) (* v v)) 16))
        (check c (= (as-> 2 v (- 10 v) (- v 1) (* v v)) 49))
        (check c (= (as-> [1 2 3] v (conj v 4) (count v)) 4))
        (check c (= (as-> "ab" s (str s s) (str "<" s ">")) "<abab>"))
        (check c (= (as-> 4 v (if (> v 3) (* v 10) v) (+ v 1)) 41))
        (let ((v 7))
          (check c (= (as-> v v (+ v 1)) 8)))
        (check c (= (as-> (do (set! log (+ (* @log 10) 1)) 1)
                          v
                          (do (set! log (+ (* @log 10) 2)) (+ v 1))
                          (do (set! log (+ (* @log 10) 3)) (+ v 1)))
                    3))
        (check c (= @log 123))
        (check c (= (as-> (as-> 1 a (+ a 1)) b (* b 10)) 20))
        (checks-result c))))
