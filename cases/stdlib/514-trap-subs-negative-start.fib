;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; A negative start is out of range, not counted from the end: the call before
;; it, with start 0, is fine.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 0 2))
       (count (subs s (- 0 1) 2)))))
