;; spec:   stdlib §2.3 (Unit), §2.8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; zero and one take a value of the type as witness, because a literal
;; has one type and the library cannot ask a result type of nobody: inc,
;; dec, abs and zero? are written over them. Six instances, each answering
;; at its own width (a 1i8 and a 1 are different types, never compared).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (zero 5i8) 0i8))
        (check c (= (one 5i8) 1i8))
        (check c (= (zero 5i16) 0i16))
        (check c (= (one -5i16) 1i16))
        (check c (= (zero 5i32) 0i32))
        (check c (= (one 5i32) 1i32))
        (check c (= (zero 5) 0))
        (check c (= (one 9) 1))
        (check c (= (zero 2.5f32) 0.0f32))
        (check c (= (one 2.5f32) 1.0f32))
        (check c (= (zero 2.5) 0.0))
        (check c (= (one -2.5) 1.0))
        (checks-result c))))
