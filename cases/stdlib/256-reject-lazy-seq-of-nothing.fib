;; spec:   stdlib §4.4 row lazy-seq (macro body -> (LSeq a))
;; expect: reject
;; error:  macro lazy-seq takes at least 1 argument(s), got 0
;; roots:  ../../lib support
;; covers: lazy-seq
;; Clojure's (lazy-seq) with no body is the empty seq; here the seq's element
;; type comes from the body, and a body of nothing has none, so the macro asks
;; for at least one form and the expander says so, naming the macro.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (count (lazy-seq)))
