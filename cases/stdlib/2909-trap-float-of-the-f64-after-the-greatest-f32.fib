;; spec:   stdlib §4.3 (row float), §2.8 (conversions are checked)
;; expect: trap
;; trap:   float: value out of range
;; roots:  ../../lib support
;; covers: float
;; The test is on the f64: the f64 whose bits are those of the greatest f32 plus one is beyond it,
;; though `fptrunc` would round it back down to the greatest f32; the greatest f32 itself is a
;; float (case 2855).
(defun main () -> i64 (fptosi i64 (fpext f64 (float (bits->f64 (+ (f64->bits 3.4028234663852886e38) 1))))))
