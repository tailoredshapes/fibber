;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types) (:require [fib.http.uri :as u]))
(defun shown (base: u/Url r: str) -> str (match (u/resolve-reference base r) ((Ok x) (u/url-string x)) ((Err _) "ERR")))
(defun main () -> i64
  (let [c (checks)]
    (match (u/parse-url "http://a/b/c/d;p?q")
      ((Err _) 1)
      ((Ok base)
        (do (check c (= (shown base "g") "http://a/b/c/g")) (check c (= (shown base "../g") "http://a/b/g"))
            (check c (= (shown base "../../../g") "http://a/g")) (check c (= (shown base "//g") "http://g/"))
            (check c (= (shown base "?y") "http://a/b/c/d;p?y")) (check c (= (shown base "g;x=1/../y") "http://a/b/c/y"))
            (check c (= (shown base "#s") "http://a/b/c/d;p?q#s")) (check c (= (shown base "./g/.") "http://a/b/c/g/"))
            (check c (match (u/parse-url "http://[::1]:8080/x") ((Ok x) (and (= (. x host) "::1") (= (u/authority x) "[::1]:8080"))) (_ false)))
            (check c (match (u/parse-url "http://h:99999/") ((Err _) true) (_ false)))
            (checks-result c))))))
