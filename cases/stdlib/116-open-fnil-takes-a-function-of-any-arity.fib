;; spec:   stdlib §4.3 (row fnil: `(fn (A..) b) a -> (fn ((Option a) ..) b)`), §2.2, §7 L22
;; expect: accept
;; result: 111
;; audit:  clean
;; open:   L22
;; roots:  ../../lib
;; covers: fnil
;; Clojure's `(fnil f d)` makes the first argument of a function of any arity
;; default to d when it is nil: `((fnil + 100) nil 5)` is 105. The arity comes
;; from the type of f (L22). Tranche 1 ships the unary form (case 104) and
;; `(fnil add2 100)` of a binary function is today `cannot unify (fn :send (i64
;; i64) i64) with (fn (a) b)`. When L22 lands this case passes and its `open:`
;; goes. 105 + 6 = 111.
(ns main (:use fib.core))

(defun add2 (a: i64 b: i64) -> i64 (+ a b))

(defun main () -> i64
  (let ((none: (Option i64) nil))
    (+ ((fnil add2 100) none 5)
       ((fnil add2 100) (some 1) 5))))
