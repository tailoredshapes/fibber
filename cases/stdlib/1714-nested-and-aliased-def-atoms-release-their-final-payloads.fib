;; spec:   stdlib §7 L15, §2.11, types §8.2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; The same atom is reachable from two immortal roots. A task installs a
;; counted payload; normal shutdown releases it once after tasks have joined.
(ns main (:use tl.check))

(def nested: (Vec (Atom (Vec str))) [(atom ["initial"])])
(def alias: (Atom (Vec str)) (nth nested 0))

(defun main () -> i64
  (let ((c (checks)))
    (do (reset! alias ["replaced"])
        (join (spawn (fn () (reset! (nth nested 0) [(str "final" " value")]))))
        (check c (= @alias ["final value"]))
        (checks-result c))))
