;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; bit-and bit-or bit-xor bit-not popcount shl shr sar on i16 vectors equal the scalar operations lane by lane, with random bit patterns and shift counts up to the width plus 4 (a count is masked to the width as the scalar's is).
(ns main (:use fib.core tl.check))

(defun bits-i16-1 (c: Checks) -> unit
  (let ((a: i16x1 <<-17765>>i16) (b: i16x1 <<-11391>>i16) (s: i16x1 <<0>>i16))
    (do (let ((r (bit-and a b)))
      (do
        (check c (= (lane r 0) (bit-and -17765i16 -11391i16)))
        ()))
        (let ((r (bit-or a b)))
      (do
        (check c (= (lane r 0) (bit-or -17765i16 -11391i16)))
        ()))
        (let ((r (bit-xor a b)))
      (do
        (check c (= (lane r 0) (bit-xor -17765i16 -11391i16)))
        ()))
        (let ((r (bit-not a)))
      (do
        (check c (= (lane r 0) (bit-not -17765i16)))
        ()))
        (let ((r (popcount a)))
      (do
        (check c (= (lane r 0) (popcount -17765i16)))
        ()))
        (let ((r (shl a s)))
      (do
        (check c (= (lane r 0) (shl -17765i16 0i16)))
        ()))
        (let ((r (shr a s)))
      (do
        (check c (= (lane r 0) (shr -17765i16 0i16)))
        ()))
        (let ((r (sar a s)))
      (do
        (check c (= (lane r 0) (sar -17765i16 0i16)))
        ()))
        ())))

