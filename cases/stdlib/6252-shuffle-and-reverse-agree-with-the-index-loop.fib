;; spec:   types §1.9 (shuffles), docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; (simd/shuffle a b <<i0 i1 ..>>) takes lane k of the result from lane ik of the concatenation of a and b (the result may have a different lane count); simd/reverse reverses the lanes. Compared with the index loop written here, for f64x4, i32x4 and i8x8, with indices into both operands.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (let ((a: f64x4 <<1.0 2.0 3.0 4.0>>) (b: f64x4 <<10.0 20.0 30.0 40.0>>))
          (let ((s: (Simd f64 6) (simd/shuffle a b <<7 0 5 3 3 4>>)) (idx [7 0 5 3 3 4]))
            (do (doseq [k (range 6)]
                  (let ((i (nth idx k))) (check c (= (lane s k) (if (< i 4) (lane a i) (lane b (- i 4)))))))
                (let ((r (simd/reverse a)))
                  (doseq [k (range 4)] (check c (= (lane r k) (lane a (- 3 k)))))))))
        (let ((a: i32x4 <<1 2 3 4>>i32) (b: i32x4 <<5 6 7 8>>i32))
          (let ((s: (Simd i32 2) (simd/shuffle a b <<4 3>>)) (t: i32x4 (simd/shuffle a a <<0 0 1 1>>)))
            (do (check c (= (lane s 0) 5i32)) (check c (= (lane s 1) 4i32))
                (check c (= (lane t 0) (lane a 0))) (check c (= (lane t 1) (lane a 0))) (check c (= (lane t 2) (lane a 1))) (check c (= (lane t 3) (lane a 1)))
                (check c (= (simd/reverse (simd/reverse a)) a)))))
        (let ((a: i8x8 <<1 2 3 4 5 6 7 8>>i8))
          (let ((r (simd/reverse a)))
            (doseq [k (range 8)] (check c (= (lane r k) (lane a (- 7 k)))))))
        (let ((p (checks)) (a: i32x4 <<1 2 3 4>>i32))
          (do (check p (= (simd/reverse a) a)) (check-detects c p)))
        (checks-result c))))
