;; spec:   stdlib §4.3 (rows defonce *command-line-args*), §7 L15, tranche 2 plan Y6
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defonce *command-line-args*
;; open:   X8
;; (defonce a: (Atom i64) (atom 0)) is a top-level atom made once before main, and *command-line-args* is the
;; library's (def *command-line-args*: (Vec str) (args)): both need a def initialiser that is a call, which is
;; `initialiser is not a constant expression` until L15 lands (package X8). The program is worked out by hand
;; for that day: run with no arguments, *command-line-args* is the empty Vec (Clojure's nil), and the atom is
;; swapped twice by main, so it counts 2.
(ns main (:use fib.core fib.seq tl.check))

(defonce hits: (Atom i64) (atom 0))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (count *command-line-args*) 0))
        (check c (= (to-vec *command-line-args*) []))
        (swap! hits inc)
        (swap! hits inc)
        (check c (= @hits 2))
        (checks-result c))))
