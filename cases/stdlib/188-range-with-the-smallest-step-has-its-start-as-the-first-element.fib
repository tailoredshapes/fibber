;; spec:   stdlib §4.4 (row range-by), §2.8 (overflow traps at every width), tranche 1 plan §6 L5a and MUT-L5a
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: range-by
;; The step of the smallest i64 cannot be negated, so the descending closed forms (which negate the step and
;; walk the complement) cannot take it; count and nth have a form of their own for it, a range of one element
;; or two. Case 163 reads the second element (index 1) and the counts; the first element, index 0, is the
;; start itself, and the sum `start + step` that the second element is made of must not be computed for it:
;; for a start below zero it would overflow. So index 0 is read at starts above and below zero, at an end
;; that lies below the first sum (two elements) and one that lies above it (one).
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (bottom -9223372036854775808))
    (do (check c (= (nth (range-by 5 bottom bottom) 0) 5))
        (check c (= (nth (range-by 0 bottom bottom) 0) 0))
        (check c (= (nth (range-by 1 bottom bottom) 0) 1))
        (check c (= (nth (range-by -1 bottom bottom) 0) -1))
        (check c (= (nth (range-by -9223372036854775807 bottom bottom) 0) -9223372036854775807))
        (check c (= (nth (range-by 9223372036854775807 bottom bottom) 0) 9223372036854775807))
        (check c (= (nth (range-by 9223372036854775807 bottom bottom) 1) -1))
        (check c (= (nth (range-by 9223372036854775807 -5 bottom) 0) 9223372036854775807))
        (check c (= (nth (range-by 6 -9223372036854775803 bottom) 0) 6))
        (check c (= (count (range-by 6 -9223372036854775803 bottom)) 2))
        (check c (= (count (range-by -1 bottom bottom)) 1))
        (checks-result c))))
