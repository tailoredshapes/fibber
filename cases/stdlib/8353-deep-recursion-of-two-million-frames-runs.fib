;; spec:   docs/design/stack.md
;; expect: accept
;; result: 2000001000000
;; audit:  clean
;; roots:  ../../lib support
;; Package LANG-2 (fixed): the depth a recursion may reach no longer depends on `ulimit -s` (8 MiB, about 500,000 of these frames, and a program that went past it died
;; with no message): `main` runs on a stack of 256 MiB (FIB_STACK_MB), so two million frames, which the old limit refused, run. The sum of 1..n by
;; plain recursion (a non-tail call: the `+` waits for the result).
(ns main)

(defun total (n: i64) -> i64
  (if (= n 0) 0 (+ n (total (- n 1)))))

(defun main () -> i64
  (total 2000000))
