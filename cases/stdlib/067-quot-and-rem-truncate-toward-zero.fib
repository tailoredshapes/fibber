;; spec:   stdlib §4.1 (rows quot, rem), §2.8, Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: quot rem
;; The builtins that `/` was on integers: quot truncates toward zero and rem
;; has the dividend's sign, so (quot -7 2) is -3 and (rem -7 2) is -1, at
;; every width; on floats quot is the truncated quotient and rem is fmod
;; (the page's (quot 7.5 2.0) is 3.0 and (rem 7.5 2.0) is 1.5). In a module
;; that uses fib.core `/` is Div's, so this is also the only way to
;; write the machine's integer division there.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (quot 7 2) 3))
        (check c (= (quot -7 2) -3))
        (check c (= (quot 7 -2) -3))
        (check c (= (quot -7 -2) 3))
        (check c (= (rem 7 2) 1))
        (check c (= (rem -7 2) -1))
        (check c (= (rem 7 -2) 1))
        (check c (= (rem -7 -2) -1))
        (check c (= (quot 1 2) 0))
        (check c (= (quot -9223372036854775807 2) -4611686018427387903))
        (check c (= (quot 7i8 2i8) 3i8))
        (check c (= (rem -7i8 2i8) -1i8))
        (check c (= (quot -7i16 2i16) -3i16))
        (check c (= (rem 7i32 -2i32) 1i32))
        (check c (= (quot 7.5 2.0) 3.0))
        (check c (= (rem 7.5 2.0) 1.5))
        (check c (= (quot -7.5 2.0) -3.0))
        (check c (= (rem -7.5 2.0) -1.5))
        (check c (= (quot 7.5f32 2.0f32) 3.0f32))
        (check c (= (rem 7.5f32 2.0f32) 1.5f32))
        (checks-result c))))
