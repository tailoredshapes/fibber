;; spec: docs/design/numerical-library.md; native kernels vs ordered reference on exact dyadic inputs
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun data64 (rows: i64 cols: i64) -> (t/Tensor f64)
  (t/reshape [rows cols] (t/map-as (fn (x: i64) (fdiv (double (- (rem (* x 7) 19) 9)) 4.0))
                                 0.0 (t/arange 0 (* rows cols) 1))))
(defun data32 (rows: i64 cols: i64) -> (t/Tensor f32)
  (t/reshape [rows cols] (t/map-as (fn (x: i64) (fdiv (float (- (rem (* x 7) 19) 9)) 4.0f32))
                                 0.0f32 (t/arange 0 (* rows cols) 1))))

(defun matrices (c: Checks :borrow m: i64 k: i64 n: i64) -> unit
  (let ((a (data64 m k)) (b (data64 k n)) (x (data32 m k)) (y (data32 k n)))
    (do (check c (= (t/to-vec (t/mmul a b)) (t/to-vec (t/mmul-scalar a b))))
        (check c (= (t/to-vec (t/mmul x y)) (t/to-vec (t/mmul-scalar x y))))
        (check c (= (t/to-vec (t/mmul (t/flip 1 a) (t/flip 0 b))) (t/to-vec (t/mmul-scalar a b)))))))

(defun main () -> i64
  (let ((c (checks)) (inner [0 1 3 4 5 63 64 65]))
    (do (dotimes (m 10) (dotimes (n 10) (dotimes (j 8) (matrices c m (nth inner j) n))))
        (matrices c 33 65 35)
        (matrices c 35 67 33)
        (dotimes (n 18)
          (let ((a (t/reshape [n] (data64 1 n))) (x (t/reshape [n] (data32 1 n))))
            (do (check c (= (t/to-vec (t/add a (t/full [] 2.0)))
                            (t/to-vec (t/map (fn (v: f64) (+ v 2.0)) a))))
                (check c (= (t/to-vec (t/div x (t/full [] 2.0f32)))
                            (t/to-vec (t/map (fn (v: f32) (fdiv v 2.0f32)) x))))
                (check c (= (t/sum-fast x) (t/sum x)))
                (check c (= (t/dot-fast x x) (t/dot x x)))
                (check c (= (t/sum-fast (t/flip 0 x)) (t/sum x)))
                (let ((offset (t/slice 0 1 (+ n 1) 1 (t/linspace 0.0 (double n) (+ n 1)))))
                  (check c (= (t/to-vec (t/square offset))
                              (t/to-vec (t/map (fn (v: f64) (* v v)) offset))))))))
        (check c (= (checks-made c) 2514))
        (checks-result c))))
