;; spec:   stdlib §4.4 row map (the overloads by arity, L1), §2.1 rule 5 (lockstep walks)
;; expect: accept
;; result: 1353
;; audit:  clean
;; roots:  ../../lib support
;; covers: map
;; Clojure's (map f c1 c2) walks two collections in step and stops at the
;; shorter: here the sums 11, 22 and 33, as a number 1353. `map` has the
;; one-collection clause (`map$2`) and this one (`map$3`).
(ns main (:use fib.core fib.seq))

(defun digits (c: c) :where ((Reducible c i64)) -> i64
  (let ((acc (cell 0)))
    (do (each-while c (fn (x) (do (set! acc (+ (* @acc 10) x)) true))) @acc)))

(defun main () -> i64
  (digits (map (fn (a: i64 b: i64) (+ a b)) [1 2 3] [10 20 30])))
