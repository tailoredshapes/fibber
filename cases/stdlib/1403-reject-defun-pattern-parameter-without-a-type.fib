;; spec:   stdlib §7 L7 (a defun's pattern parameter is `(PAT :as p: T)`), §5 D5
;; expect: reject
;; error:  defun: a pattern parameter is (pattern :as name: type)
;; roots:  ../../lib support
;; A `fn` literal infers the type of a pattern parameter; a `defun` states every type, so a
;; pattern parameter without one, written bare or with `:as p` alone, is refused.
(ns main (:use fib.core))

(defun f (n: i64 ([a b] :as v)) -> i64
  (+ n (+ a b)))

(defun main () -> i64
  (f 1 [2 3]))
