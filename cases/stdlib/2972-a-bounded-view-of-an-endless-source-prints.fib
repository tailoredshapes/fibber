;; spec:   stdlib §4.4 (rows iterate repeat cycle), §2.7 (a seq prints in parentheses), §14 D7 of the tranche 2 plan
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: print-str pr-str println-str
;; What D7 leaves a program, once the endless sources have no printer of their own (cases 2963 to 2965): a
;; finite view of one, `take` of it, is an `LSeq`, which prints in parentheses like every seq of the
;; table, through each of the twins. `(take 3 (iterate inc 5))` is `(5 6 7)`, `(take 2 (repeat "a"))` is
;; `(a a)` under Show and `("a" "a")` under Debug, `(take 5 (cycle [1 2]))` is `(1 2 1 2 1)`, and the take
;; of an empty source is `()`. This is the idiom the error of the three reject cases points to.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (print-str (take 3 (iterate inc 5))) "(5 6 7)"))
        (check c (= (pr-str (take 3 (iterate inc 5))) "(5 6 7)"))
        (check c (= (print-str (take 2 (repeat "a"))) "(a a)"))
        (check c (= (pr-str (take 2 (repeat "a"))) "(\"a\" \"a\")"))
        (check c (= (print-str (take 5 (cycle [1 2]))) "(1 2 1 2 1)"))
        (check c (= (println-str (take 0 (iterate inc 0))) "()\n"))
        (check c (= (print-str (take 2 (map inc (iterate inc 0)))) "(1 2)"))
        (checks-result c))))
