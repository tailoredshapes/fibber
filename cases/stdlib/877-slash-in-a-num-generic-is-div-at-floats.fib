;; spec:   stdlib §2.3 (Div), §7 L30, plan R3 (Num loses `/`)
;; expect: accept
;; result: 0
;; audit:  clean
;; The function of case 873, which the checker takes with an added `Div` bound, called at the
;; types whose `Div` answers the type itself: `f64` and `f32` divide as IEEE does, so `(d 6.0 3.0)`
;; is 2.0, and `quot` stays the integer quotient: `(quot 7 2)` is 3 and `(/ 7 2)` is the ratio 7/2.
(defun d (a: t b: t) :where ((Num t)) -> t (/ a b))

(defun miss (bit: i64 ok: bool) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (miss 1 (= (d 6.0 3.0) 2.0))
     (+ (miss 2 (= (d 1.0f32 4.0f32) 0.25f32))
        (+ (miss 4 (= (quot 7 2) 3))
           (miss 8 (= (show (/ 7 2)) "7/2"))))))
