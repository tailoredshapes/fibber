;; spec:   stdlib §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: if or and when
;; The test of an Option whose payload is an object (a str here, from a map) is a temporary
;; that is released after the test, and `or` takes the payload out of the Option or the
;; default: the audit finds no leak and no double release.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (map-empty) "a" "alpha")))
    (do (check c (if (get m "a") true false))
        (check c (not (if (get m "b") true false)))
        (check c (= (or (get m "a") "none") "alpha"))
        (check c (= (or (get m "b") "none") "none"))
        (check c (and (get m "a") (> (str-len (or (get m "a") "")) 3)))
        (check c (match (when (get m "a") "yes") ((some s) (= s "yes")) (nil false)))
        (checks-result c))))
