;; spec:   stdlib §4.4 (row product), §7 L4 (the static one), tranche 2 plan Y4
;; expect: reject
;; error:  cannot unify f64 with i64
;; roots:  ../../lib support
;; covers: product
;; product is for i64 only, as T1's sum: the generic one needs a static `one` (item L4 of §7, tranche
;; 3), so a source of floats is refused at the checker and nothing is computed at the wrong type.
;; The day the generic product lands this case flips to accept.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((p (product [1.5 2.5])))
    (if (> p 3.0) 1 0)))
