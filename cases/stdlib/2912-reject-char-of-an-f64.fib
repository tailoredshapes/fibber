;; spec:   stdlib §4.3 (row char: `i32` and `i64`), §2.3 (ToChar)
;; expect: reject
;; error:  no implementation of ToChar for f64
;; roots:  ../../lib support
;; covers: char
;; `char` takes an i32 or an i64, as its row says; an f64 (or an i8, an i16, an f32) is no code
;; point. A program that means one writes `(char (int x))`, where `int` cuts and checks.
(defun main () -> i64 (sext i64 (char->i32 (char 65.0))))
