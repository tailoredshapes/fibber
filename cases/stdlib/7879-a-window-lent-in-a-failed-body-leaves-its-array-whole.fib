;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 10
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Test 9 of the design: a writable window over an array (fib.view) is written, then read out of range inside a try; after the catch the
;; array is whole and holds the write (a window is a base and a length into the array, which never left its place). Killed by:
;; scripts/mutant-catch.sh `no-catch`.
(ns main (:use fib.core fib.ex fib.view))

(defun poke (&a: (Array i64)) -> i64
  (with-view [w (array-window! &a 0 4)]
    (do (win-set! &w 0 5) (win-get @w 9))))

(defun main () -> i64
  (let ((c (cell (array 4 1))))
    (let ((r (try (poke &c) (catch e 1))))
      (+ r (+ (array-get @c 0) (array-len @c))))))
