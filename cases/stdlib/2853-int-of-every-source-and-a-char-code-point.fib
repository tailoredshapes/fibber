;; spec:   stdlib §4.3 (row int), §2.3 (ToInt), §2.8 (a char gives its code point)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: int
;; `(int x)` over an i8 and an i16 (widened), an i32 (itself), an i64, an f32, an f64 and a
;; char. The limits of an i32 are ints from an i64 and from an f64; a float is range-checked
;; before it is cut, so 2147483647.0 is an int and 2147483647.9 is not (case 2916); a char is its
;; code point, which makes `(- (int c) (int \0))` Clojure's text for the value of a digit.
(ns main (:use tl.check))

(defun digit-value (c: char) -> i32 (- (int c) (int \0)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (int 2147483647) 2147483647i32))
        (check c (= (int -2147483648) -2147483648i32))
        (check c (= (int 0) 0i32))
        (check c (= (int 127i8) 127i32))
        (check c (= (int -128i8) -128i32))
        (check c (= (int 32767i16) 32767i32))
        (check c (= (int -32768i16) -32768i32))
        (check c (= (int -2147483648i32) -2147483648i32))
        (check c (= (int 2147483647i32) 2147483647i32))
        (check c (= (int 2147483647.0) 2147483647i32))
        (check c (= (int -2147483648.0) -2147483648i32))
        (check c (= (int 2147483647.0) 2147483647i32))
        (check c (= (int -2147483648.0) -2147483648i32))
        (check c (= (int 2.7) 2i32))
        (check c (= (int -2.7) -2i32))
        (check c (= (int 0.9) 0i32))
        (check c (= (int -0.9) 0i32))
        (check c (= (int 16777216.0f32) 16777216i32))
        (check c (= (int -2.7f32) -2i32))
        (check c (= (int \a) 97i32))
        (check c (= (int \0) 48i32))
        (check c (= (int \é) 233i32))
        (check c (= (int \😀) 128512i32))
        (check c (= (digit-value \7) 7i32))
        (check c (= (digit-value \0) 0i32))
        (check c (= (int (char 1114111)) 1114111i32))
        (checks-result c))))
