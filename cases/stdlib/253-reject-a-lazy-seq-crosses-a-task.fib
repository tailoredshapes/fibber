;; spec:   stdlib §2.1 rule 2 and §5 S10 (an LSeq holds a Cell, so it does not cross a task), types §6 (Send)
;; expect: reject
;; error:  cannot be shared between threads
;; roots:  ../../lib support
;; covers: map
;; An LSeq keeps its memo in a Cell, and a Cell is never Send: a lazy seq
;; made by map and captured by a spawned task is refused, with the cell
;; named. (Case 908 is the same program for the day the run-once cell of
;; C9 lets it through; a chain built inside the task is fine, because
;; nothing crosses.)
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s (map (fn (x: i64) (+ x 1)) [1 2 3])))
    (let ((t (spawn (fn () (count s)))))
      (join t))))
