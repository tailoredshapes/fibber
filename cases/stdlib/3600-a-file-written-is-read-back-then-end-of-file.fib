;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: fd-open fd-write fd-read fd-close fd-unlink
;; A file written and read back: the bytes, then the empty array at end of file; a read larger than the file
;; gives only the file's bytes.
(ns main (:use tl.check tl.sysx fib.unix))

(defun main () -> i64
  (let ((c (checks))
        (path "/tmp/fib-s5-3600")
        (w (creat path)))
    (do (check c (> w 2))
        (check c (= (put w "hello") 5))
        (check c (= (num (fd-close w)) 0))
        (let ((r (open-ro path)))
          (do (check c (> r 2))
              (check c (= (text r 1000000) "hello"))
              (check c (= (text r 10) ""))
              (check c (= (num (fd-close r)) 0))))
        (check c (= (num (fd-unlink path)) 0))
        (check c (= (num (fd-unlink path)) -2))
        (checks-result c))))
