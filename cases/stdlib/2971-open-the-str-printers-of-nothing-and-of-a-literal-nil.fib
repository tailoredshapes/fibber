;; spec:   stdlib §4.14 (rows print-str pr-str println-str prn-str), §2.7 (a literal nil prints the word nil)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: print-str pr-str println-str prn-str
;; open:   X3
;; A function of one argument cannot be called with none, and a bare `nil` has no type (`ambiguous
;; constraint Show a`, spec §2.7), so two cases of the four names exist only as macros: `(print-str)` and
;; `(pr-str)` are the empty text, `(println-str)` and `(prn-str)` the newline alone (the plan's X3: "`(print-str)`
;; is `""`"), and a literal `nil` among the arguments is the word `nil`, as in `println` and `prn` (R5, case
;; 751): the macros see the literal, so the type problem does not arise. Until X3 lands the twins refuse
;; both: `print-str takes 1 argument(s), got 0`.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (print-str) ""))
        (check c (= (pr-str) ""))
        (check c (= (println-str) "\n"))
        (check c (= (prn-str) "\n"))
        (check c (= (print-str nil) "nil"))
        (check c (= (pr-str nil) "nil"))
        (check c (= (println-str "a" nil 2) "a nil 2\n"))
        (check c (= (prn-str nil "b") "nil \"b\"\n"))
        (checks-result c))))
