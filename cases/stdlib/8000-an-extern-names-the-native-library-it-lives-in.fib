;; spec:   syntax §3.15 (extern, the option :lib), docs/design/static-linking.md 3
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `:lib "NAME"` on an extern says which native library the C function lives in; the compiler links that library when the program reaches the extern (`fibc build`), by the
;; mode of the build. Here the library is libm, which the process has: the option changes nothing about the call, and may sit beside `:varargs :fixed`.
(ns main (:use fib.core tl.check))

(extern hypot (f64 f64) -> f64 :lib "m")
(extern ldexp (f64 i32) -> f64 :lib "m")
(extern snprintf (ptr i64 ptr f64) -> i32 :varargs :fixed 3 :lib "c")

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (unsafe (hypot 3.0 4.0)) 5.0))
        (check c (= (unsafe (ldexp 1.5 3i32)) 12.0))
        (checks-result c))))
