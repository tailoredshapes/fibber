;; spec:   docs/design/stack-check.md, docs/adr/0027, docs/adr/0009, docs/design/exceptions.md 1.2
;; expect: accept
;; result: 7
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Inside `try` a stack overflow is a trap like the others (it was on the fatal list until 2026-10-22; the owner reversed the rule, docs/adr/0027): a function of a program
;; that catches tests its stack on entry, so the `catch` runs and answers 7 instead of the process saying `trap: stack overflow` and ending with 134. Killed by:
;; FIB_STACK_CHECK=0 (the check is not emitted: the old fatal overflow, status 134) and scripts/mutant-stack-check.sh.
(ns main (:use fib.core fib.ex))

(defun climb (n: i64) -> i64
  (if (= n 0) 0 (- (* 2 n) (climb (- n 1)))))

(defun main () -> i64
  (try (climb 1000000000)
       (catch e 7)))
