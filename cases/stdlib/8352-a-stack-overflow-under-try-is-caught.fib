;; spec:   docs/design/stack.md, docs/adr/0009, docs/design/exceptions.md 1.2
;; expect: trap
;; trap:   stack overflow
;; roots:  ../../lib support
;; Inside `try` a trap is caught, but a stack overflow is on the fatal list: there is no stack left to unwind, so the `catch` never runs (it would answer 7)
;; and the process says `trap: stack overflow` and ends with status 134.
(ns main (:use fib.core fib.ex))

(defun climb (n: i64) -> i64
  (if (= n 0) 0 (- (* 2 n) (climb (- n 1)))))

(defun main () -> i64
  (try (climb 1000000000)
       (catch e 7)))
