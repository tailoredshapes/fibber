;; spec: spec/types.md section 2.13.1 (array-push!: in place iff unique, ROOMY and with a free slot; the copy doubles the room from 32 on)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Package LIBFIX-1: an array of 32 elements or more was copied by every `array-push!` (exactly one more slot, no flag), so a loop of pushes was quadratic.
;; Now the copy makes room for the next power of two and the pushes after it are in place. Pinned: (1) the contents after pushing across every size where the
;; room changes (0, 31, 32, 33, 63, 64, 65, 127, 128, 129, 1023, 1024, 1025), checked element by element; (2) a shared array is never written: the copy is pushed
;; to, the other holder keeps its length and elements, also at 32, 64 and 100 elements; (3) `array-pop!` then push at a power of two, where the block
;; is fuller than its length says it is; (4) the property that matters: 3,000,000 pushes finish in under 10 s (the quadratic code copies 3e6 * 1.5e6 * 8
;; bytes: it does not finish, and the harness's alarm kills it); (5) a boxed element type (str) across the same boundaries, so the copy retains and the release
;; counts are right (a leak or a double release shows as a wrong string or a trap).
(ns main (:use tl.check fib.coll) (:require [fib.os :as os]))

(defun pushed (n: i64) -> (Array i64)
  (let [a (cell (array 0 0))] (do (dotimes (i n) (array-push! &a (* i 3))) @a)))

(defun ok-ints? (a: (Array i64) n: i64) -> bool
  (and (= (array-len a) n)
       (loop [i 0] (cond (= i n) true (= (array-get a i) (* i 3)) (recur (+ i 1)) :else false))))

(defun sizes-ok? () -> bool
  (every? (fn (n: i64) (ok-ints? (pushed n) n)) [0 1 31 32 33 63 64 65 127 128 129 1023 1024 1025 4097]))

;; the holder keeps `base`, the pushed copy gets `more` further elements
(defun shared-ok? (n: i64 more: i64) -> bool
  (let [base (pushed n) c (cell base)]
    (do (dotimes (i more) (array-push! &c (- 0 i)))
        (and (ok-ints? base n) (= (array-len @c) (+ n more))
             (= (array-get @c (- (+ n more) 1)) (- 0 (- more 1)))
             (if (> n 0) (= (array-get @c (- n 1)) (* (- n 1) 3)) true)))))

(defun pop-push-ok? (n: i64) -> bool
  (let [a (cell (pushed n))]
    (do (array-pop! &a) (array-push! &a 7) (array-push! &a 8)
        (and (= (array-len @a) (+ n 1)) (= (array-get @a (- n 1)) 7) (= (array-get @a n) 8)
             (if (> n 1) (= (array-get @a (- n 2)) (* (- n 2) 3)) true)))))

(defun strs (n: i64) -> (Array str)
  (let [a (cell (array 0 ""))] (do (dotimes (i n) (array-push! &a (str "s" i))) @a)))

(defun strs-ok? (n: i64) -> bool
  (let [a (strs n) b (cell a)]
    (do (array-push! &b "tail")
        (and (= (array-len a) n) (= (array-len @b) (+ n 1)) (= (array-get @b n) "tail")
             (loop [i 0] (cond (= i n) true (and (= (array-get a i) (str "s" i)) (= (array-get @b i) (str "s" i))) (recur (+ i 1)) :else false))))))

(defun main () -> i64
  (let [c (checks)]
    (do (check c (sizes-ok?))
        (check c (every? (fn (n: i64) (shared-ok? n 70)) [0 31 32 33 64 100]))
        (check c (every? pop-push-ok? [2 32 33 64 65 128]))
        (check c (every? strs-ok? [0 31 32 33 64 65 200]))
        (let [t0 (os/clock-now) big (pushed 3000000) t1 (os/clock-now)]
          (do (check c (ok-ints? big 3000000))
              (check c (< (- t1 t0) 10000000000))))
        (checks-result c))))
