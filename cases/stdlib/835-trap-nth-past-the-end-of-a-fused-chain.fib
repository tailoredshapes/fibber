;; spec:   stdlib §4.4 (row nth: a walk that traps past the end), §2.1 rule 2, tranche 1 plan R9
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: nth map filter
;; The trap of `nth` is the same through the recipes: the collection of `nth` is its first argument
;; (the others take it last), the chain is fused, and the walk of the recipes ends before the 5th element
;; of a chain that has three.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (nth (map (fn (x: i64) (* x 2)) (filter (fn (x: i64) (> x 1)) [1 2 3 4])) 4))
