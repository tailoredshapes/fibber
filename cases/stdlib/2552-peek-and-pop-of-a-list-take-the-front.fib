;; spec:   stdlib §2.3 (Stack), §4.4 (rows peek pop)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: peek pop
;; A List is a stack at its front, the end conj adds at: (peek (list 1 2 3)) is (some 1), (pop (list 1 2 3)) is (2 3). The
;; front is the opposite end from a Vec's, so the same three elements give a different answer: the checks put both side by
;; side. pop of a list of one is the empty list, and conj then pop is the list itself.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (l (list 1 2 3))
        (v [1 2 3]))
    (do (check c (= (peek l) (some 1)))
        (check c (= (pop l) (list 2 3)))
        (check c (= (peek (pop l)) (some 2)))
        (check c (= (pop (pop l)) (list 3)))
        (check c (= (pop (pop (pop l))) Empty))
        (check c (= (peek (pop (pop (pop l)))) nil))
        (check c (= (count (pop l)) 2))
        (check c (= (peek (conj l 9)) (some 9)))
        (check c (= (pop (conj l 9)) l))
        (check c (not (= (peek l) (peek v))))
        (check c (= (peek (list 7)) (some 7)))
        (checks-result c))))
