;; spec:   stdlib §4.14 (row prn), §2.10 (the function twins), syntax §4.5 (println writes its text and a newline)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: prn run!
;; The twin of prn, the one a program holds when it passes `prn` as a value,
;; writes the Debug text of its argument and then a newline, as the twin of
;; println does for Show (case 622, whose argument this case repeats: the last
;; line of standard output must be the result, so a twin that left its
;; newline off fails under `fibc cases` as "\"x\"0", which the interpreter's
;; runner cannot see).
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (do (run! prn ["x"])
      0))
