;; spec:   types §2.11; docs/design/exceptions.md 4.1 test 7
;; expect: trap
;; trap:   main failed
;; stage:  2
;; roots:  ../../lib support
;; Only a spawned task's thread isolates a trap: a trap in main, with a task still running, ends the process as it always did,
;; `trap: main failed` and Aborted. Killed by: scripts/mutant-task-trap.sh `isolate-everywhere` (a trap on any thread is isolated: main
;; would not stop).
(ns main (:use fib.async) (:require [fib.os :as os]))

(defun main () -> i64
  (let ((t (spawn (fn () (do (os/sleep-ns 300000000) 1)))))
    (do (trap "main failed")
        (join t))))
