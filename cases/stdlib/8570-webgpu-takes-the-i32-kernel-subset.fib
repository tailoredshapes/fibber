;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/webgpu
;; webgpu-target = accept | fib.kernel-sig k: ptr ptr i32
;; A kernel over i32 indices, f32 elements, a checked +, a loop and fma is the WGSL subset -- the module has its entry.
;; The host builds and runs this program (nothing calls the kernel); compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [fib.gpu :as gpu] [gpu32 :as g]))
(defkernel k (a: ptr b: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n)
      (g/f32-set! b i (loop ((j 0i32) (acc 0.0f32))
                        (if (>= j 4i32) acc (recur (+ j 1i32) (simd/fma (g/f32-at a i) 2.0f32 acc))))))))
(defun main () -> i64 0)
