;; spec:   syntax §3.6 (literal patterns), types §1.1
;; expect: reject
;; error:  the literal 200 does not fit i8 (-128..127)
;; roots:  ../../lib support
;; A literal pattern on an `i8` scrutinee has the scrutinee's type if it fits, and a literal that does not is the error that names the range.
(ns main)

(defun kind (x: i8) -> i64
  (match x
    (200 1)
    (_ 0)))

(defun main () -> i64
  (kind 1i8))
