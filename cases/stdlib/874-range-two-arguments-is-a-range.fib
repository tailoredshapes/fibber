;; spec:   syntax §4.4 (row range), stdlib §4.4 (rows range, range-by)
;; expect: accept
;; result: 0
;; audit:  clean
;; covers: range range-by
;; `(range a b)` is the prelude macro's rewrite to `(fib.seq/range-by a b 1)`: a `Range`, not
;; the `Vec` it was before the flip. It shows as `(2 3 4)`, is empty when `b <= a`, counts
;; its elements, and (range n) is the library function, which is also `range` as a value.
(defun miss (bit: i64 ok: bool) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (miss 1 (= (show (range 2 5)) "(2 3 4)"))
     (+ (miss 2 (= (count (range 5 2)) 0))
        (+ (miss 4 (= (count (range 2 5)) 3))
           (+ (miss 8 (= (show (range 3)) "(0 1 2)"))
              (+ (miss 16 (= (show (range-by 2 8 3)) "(2 5)"))
                 (miss 32 (let ((r range)) (= (show (r 2)) "(0 1)")))))))))
