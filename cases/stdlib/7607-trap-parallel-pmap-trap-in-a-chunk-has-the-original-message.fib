;; spec:   docs/design/parallelism.md 3.2, docs/design/exceptions.md 8 (try-join); lib/fib/parallel/chunks.fib
;; expect: trap
;; trap:   element 37 is not allowed
;; stage:  2
;; roots:  ../../lib support
;; A trap in one chunk of a `pmap` on four workers reaches the caller as a trap with the message the body gave, after every worker was joined.
;; A pmap that swallows the trap returns a Vec and the case ends with a result instead of a trap.
(ns main (:use fib.core fib.parallel))

(defun check-element (x: i64) -> i64
  (if (= x 37) (trap "element 37 is not allowed") (* x 2)))

(defun main () -> i64
  (vec-count (pmap (Par 4 8 false) check-element (vec (range 100)))))
