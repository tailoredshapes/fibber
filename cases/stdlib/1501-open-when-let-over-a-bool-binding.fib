;; spec:   stdlib §4.2 (row when-let), §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; open:   L20
;; roots:  support
;; covers: when-let
;; The binding of `when-let` may be a bool as well as an Option (x is the bool): the
;; value is `(some 7)` when it is true. Not done by X5: `when-let` expands to a match on
;; `(some p)`, so a bool binding is `cannot unify bool with (Option a)`; it needs the
;; checker to read the binding's type, a form of its own (compiler/mirror-pending/X5.md).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (match (when-let (b (> 2 1)) 7) ((some y) (= y 7)) (nil false)))
        (check c (match (when-let (b (> 1 2)) 7) ((some _) false) (nil true)))
        (checks-result c))))
