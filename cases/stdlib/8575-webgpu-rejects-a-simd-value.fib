;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name)
;; expect: reject
;; error:  Simd value
;; stage:  2
;; roots:  ../../lib ../../examples/webgpu
;; webgpu-target = reject | Simd value
;; A kernel is scalar code (the GPU supplies the lanes) -- a (Simd f32 4) value in a kernel is refused.
;; GPU-2's source-level kernel checker (own.kernel) refuses it on the host already, at its position; the WebGPU target says the same.
;; wgsl-emit.sh also builds this program for the target and checks the refusal there; compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [fib.gpu :as gpu] [gpu32 :as g]))
(defkernel k (a: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n)
      (let ((v: f32x4 (splat f32x4 (g/f32-at a i))))
        (g/f32-set! a i (lane (* v v) 0))))))
(defun main () -> i64 0)
