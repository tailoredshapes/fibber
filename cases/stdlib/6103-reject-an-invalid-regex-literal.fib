;; spec:   stdlib §4.9 (the row `#"regex"`: a pattern error is a compile error), syntax §1.1
;; expect: reject
;; error:  malformed regex literal: Unclosed group near index 5 in #"ab(cd"
;; stage:  2
;; roots:  ../../lib support
;; A `#"..."` the library refuses is an error at the literal, at compile time, with the library's message: the same text that
;; `try-re-pattern` gives, here an unclosed group. The error position is the literal's (line 11, column 13).
(ns main (:use fib.core fib.regex))

(defun main () -> i64
  (re-count #"ab(cd" "abcd"))
