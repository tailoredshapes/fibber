;; spec:   spec/types.md 8.2 (freeze); docs/design/parallelism.md 3.6
;; expect: trap
;; trap:   freeze: a task is reachable from the value
;; stage:  2
;; roots:  ../../lib support
;; covers: freeze
(ns main)

(defun main () -> i64
  (let ((t (spawn (fn () 7))))
    (let ((v (freeze [t])))
      (join (nth v 0)))))
