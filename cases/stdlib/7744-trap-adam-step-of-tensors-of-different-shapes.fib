;; spec: lib/fib/tensor/optim.fib; the optimiser steps take tensors of one shape (no broadcasting) and trap otherwise
;; expect: trap
;; trap: tensor: optimiser step needs tensors of one shape
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.tensor :as t]))

(defun main () -> i64
  (do (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 (t/zeros [4]) (t/zeros [3]) (t/zeros [4]) (t/zeros [4])) 0))
