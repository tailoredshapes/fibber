;; spec:   stdlib §7 L1, syntax §5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../../lib ../support
;; covers: defn
;; The arity table travels with the module: a `:use`d module's clauses are picked
;; by the bare name, a `:require`d one's by `alias/name`, and a re-exporting
;; facade's through its `:export-from`.
(ns main (:require [shapes :as s]) (:use tl.check facade))

(defn twice [x: i64] -> i64 (* x 2))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (s/area 3) 9))
        (check c (= (s/area 3 4) 12))
        (check c (= (area 5) 25))
        (check c (= (area 5 6) 30))
        (check c (= (twice (area 2)) 8))
        (checks-result c))))
