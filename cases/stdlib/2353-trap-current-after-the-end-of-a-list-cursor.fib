;; spec:   stdlib §2.3 (Cursor), tranche 2 plan Y3 (the convention of the part)
;; expect: trap
;; trap:   current: the cursor has no element
;; roots:  ../../lib support
;; The cursor of a List stands on a node, and past the end there is none: after advance! has said false, `current`
;; traps instead of answering the last element again (case 2351 holds that advance! stays false; this one that
;; current stays unreadable).
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((c (cursor (list 1 2))))
    (do (advance! c) (advance! c) (advance! c)
        (current c))))
