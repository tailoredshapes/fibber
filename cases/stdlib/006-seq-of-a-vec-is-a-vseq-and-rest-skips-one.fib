;; spec:   stdlib §2.3 (Seqable), §2.1 rule 8 (one closed seq type per collection)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; seq of a Vec is (some VSeq) when there is an element and nil when there
;; is none, as Clojure's (seq []) is nil; rest is a VSeq that has skipped
;; one and is empty, not nil, at the end ((rest []) is () in Clojure). The
;; VSeq shares the Vec: nothing is copied.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (v [10 20 30])
        (e: (Vec i64) []))
    (do (check c (match (seq v) (nil false) ((some s) (= (count s) 3))))
        (check c (match (seq v) (nil false) ((some s) (= (nth s 0) 10))))
        (check c (match (seq e) (nil true) ((some _) false)))
        (check c (match (seq [5]) (nil false) ((some s) (= (count s) 1))))
        (check c (= (count (rest v)) 2))
        (check c (= (nth (rest v) 0) 20))
        (check c (= (nth (rest v) 1) 30))
        (check c (= (count (rest [5])) 0))
        (check c (= (count (rest e)) 0))
        (checks-result c))))
