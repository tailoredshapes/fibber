;; spec:   stdlib §7 L1 (a name a form binds is not the clause set), expander scope
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; covers: defn
;; A `loop` variable and a `match` pattern variable called `pick` are locals, here functions of three
;; parameters, and are called. Each is out of scope again after its form.
(defn pick
  ([a: i64] -> i64 (* a 10))
  ([a: i64 b: i64] -> i64 (+ a b)))

(defun main () -> i64
  (let ((l (loop ((pick (fn (a: i64 b: i64 c: i64) -> i64 (+ a (+ b c)))) (n 0))
             (if (< n 2) (recur pick (+ n 1)) (pick n n n))))
        (m (match (some (fn (a: i64 b: i64 c: i64) -> i64 (* a (* b c))))
             ((some pick) (pick 2 3 4))
             (nil 0))))
    (if (= l 6)
        (if (= m 24) (if (= (pick 1 2) 3) 0 3) 2)
        1)))
