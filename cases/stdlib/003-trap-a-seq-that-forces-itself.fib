;; spec:   stdlib §2.1 rule 2 (the memoised lazy seq), tranche 1 plan §5 (lnode)
;; expect: trap
;; trap:   lazy-seq: a seq forced itself
;; roots:  ../../lib
;; A thunk that demands the very node it is computing has no value to
;; give: lnode marks the node as being forced and traps on the second
;; demand, naming the function, instead of looping. (Clojure's own lazy seq
;; throws IllegalStateException here.) The node is reached through a cell
;; set after the node is made.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((r: (Cell (Option (LSeq i64))) (cell nil)))
    (let ((s (lazy-node (fn () (match @r (nil LNil) ((some t) (lnode t)))))))
      (do (set! r (some s))
          (count s)))))
