;; spec:   stdlib §2.3 (Emptyable), §4.5 (row empty)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: empty
;; (empty c) is the empty collection of c's own type: a Map stays a Map (the
;; key and value types kept, so assoc of the same types type-checks), a Set a
;; Set. It does not change c, and filling the result leaves c as it was.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option str) n: str) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (empty {1 ""}) 1 "one") 2 "two"))
        (s (set [10 20 30]))
        (em (empty m))
        (es (empty s))
        (m2 (assoc em 9 "nine"))
        (s2 (conj es 40)))
    (do (check c (= (count em) 0))
        (check c (= (count es) 0))
        (check c (= (count m) 2))
        (check c (= (count s) 3))
        (check c (= (count m2) 1))
        (check c (is (get m2 9) "nine"))
        (check c (not (contains? em 9)))
        (check c (= (count s2) 1))
        (check c (contains? s2 40))
        (check c (not (contains? es 40)))
        (check c (is (get m 1) "one"))
        (check c (= (count (empty (empty m))) 0))
        (checks-result c))))
