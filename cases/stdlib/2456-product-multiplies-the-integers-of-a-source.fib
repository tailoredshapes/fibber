;; spec:   stdlib §4.4 (row product), §2.8, tranche 2 plan Y4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: product
;; (product c) multiplies the i64 elements of any source; the product of nothing is 1, and a zero
;; anywhere is zero. It is for i64 only (decided here, as `sum`: the generic one needs a static `one`,
;; item L4 of §7), and an overflow traps as the builtin * does (case 2457).
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (empty: (Vec i64) (vec-empty)))
    (do (check c (= (product [2 3 4]) 24))
        (check c (= (product empty) 1))
        (check c (= (product [5]) 5))
        (check c (= (product [3 0 7]) 0))
        (check c (= (product [-2 3]) -6))
        (check c (= (product [-2 -3]) 6))
        (check c (= (product (list 2 5)) 10))
        (check c (= (product (Range 1 6 1)) 120))
        (check c (= (product (map inc [1 2 3])) 24))
        (check c (= (product (some 7)) 7))
        (check c (= (product (rest [9 2 3])) 6))
        (check c (= (product [3037000499 3037000499]) 9223372030926249001))
        (check c (= (product [4611686018427387904 1 1]) 4611686018427387904))
        (check c (= (product [4611686018427387904 -2]) -9223372036854775808))
        (checks-result c))))
