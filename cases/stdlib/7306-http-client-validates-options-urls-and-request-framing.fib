;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll) (:require [fib.http :as h] [fib.http.client :as c] [fib.http.client.setup :as setup]))
(defun invalid? (r: h/ClientRequest) -> bool (match (setup/validate-request r) ((Err _) true) (_ false)))
(defun main () -> i64
  (let [checks (checks) empty (array 0 0i8) request (h/ClientRequest "GET" "https://example.com/x" {} empty)]
    (do (check checks (c/valid-options? (c/default-options)))
        (check checks (not (c/valid-options? (with (c/default-options) (timeout-ms -1)))))
        (check checks (not (c/valid-options? (with (c/default-options) (max-response-bytes 67108865)))))
        (check checks (not (c/valid-options? (with (c/default-options) (ca-file (some "/cert\0extra"))))))
        (check checks (match (setup/validate-request request) ((Ok _) true) (_ false)))
        (check checks (invalid? (with request (url "file:///etc/passwd"))))
        (check checks (invalid? (with request (url "http://example.com/\r\nInjected"))))
        (check checks (invalid? (with request (method "bad method"))))
        (check checks (invalid? (with request (headers {"content-length" ["0"]}))))
        (check checks (invalid? (with request (headers {"Transfer-Encoding" ["chunked"]}))))
        (check checks (invalid? (with request (headers {"x" ["a\r\nb: c"]}))))
        (checks-result checks))))
