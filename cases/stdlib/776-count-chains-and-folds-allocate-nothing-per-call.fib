;; spec:   stdlib §6.3 (R6a), method rule 3 (allocs), cost principle §1.2
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 0
;; roots:  ../../lib support
;; covers: + < = max
;; A hundred rounds of a comparison chain over three string literals, an equality chain, a
;; maximum and a sum of four integers: no heap object at all, so the expansions cost what the
;; hand-written (and (< a b) (< b c)) and (+ (+ a b) c) cost. The total, 10706, is worked out by
;; hand: per round 1 + 1 + (max i 2 3) + (i + 6), summed over i from 0 to 99.
(ns main (:use fib.core))

(defun main () -> i64
  (loop ((i 0) (acc 0))
    (if (< i 100)
        (recur (+ i 1)
               (+ acc (if (< "a" "b" "c") 1 0) (if (= "k" "k" "k") 1 0) (max i 2 3) (+ i 1 2 3)))
        (if (= acc 10706) 0 1))))
