;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (check c (= (f/member (g/execute schema "{ filter(input: {limit: 3, text: null}) }" {} g/NullValue) "filter")
          (g/StringValue "{\"input\":{\"limit\":3,\"text\":null}}")))
        (check c (= (f/member (g/execute schema "query($terms: [String!], $text: String!, $limit: Int) { filter(input: {terms: $terms, nested: {text: $text}, limit: $limit}) }"
          {"terms" (g/StringValue "one") "text" (g/StringValue "leaf")} g/NullValue) "filter")
          (g/StringValue "{\"input\":{\"limit\":10,\"nested\":{\"limit\":10,\"text\":\"leaf\"},\"terms\":[\"one\"],\"text\":\"base\"}}")))
        (check c (= (f/member (g/execute schema "query($input: Filter = {limit: 7}) { filter(input: $input) }" {} g/NullValue) "filter")
          (g/StringValue "{\"input\":{\"limit\":7,\"text\":\"base\"}}")))
        (check c (= (f/member (g/execute schema "{ empty(input: {}) }" {} g/NullValue) "empty") (g/StringValue "{\"input\":{}}")))
        (check c (= (f/member (g/execute schema "query($x: String = \"yes\") { required(text: $x) }" {} g/NullValue) "required") (g/StringValue "yes")))
        (let [failed (g/execute schema "query($x: String = \"yes\") { required(text: $x) }" {"x" g/NullValue} g/NullValue)]
          (do (check c (= (. failed data) (some (g/object {"required" g/NullValue}))))
            (check c (= (count (. failed errors)) 1)))))))
      (checks-result c))))
