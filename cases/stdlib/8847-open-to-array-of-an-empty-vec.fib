;; spec:   stdlib §4.1 rows to-array into-array (a typed (MArray e) from any source; an empty source keeps its type)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: to-array into-array
;; open:   empty-array
;; Clojure's (to-array []) is an empty array. An (Array e) is made by (array n x), which needs an x: an empty source that is not
;; an Array has no element to give, and no builtin makes an empty array of any type, so fib.coll.marray traps
;; `to-array: an empty source` today. The program is what the page promises, for the day an empty array can be made.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (alength (to-array [])) 0))
        (check c (= (alength (into-array (list))) 0))
        (check c (= (vec (to-array (filter odd? [2 4]))) []))
        (checks-result c))))
