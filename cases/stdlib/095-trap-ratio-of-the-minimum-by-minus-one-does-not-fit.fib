;; spec:   stdlib §2.8 (the components trap on overflow at their width), review finding of L1
;; expect: trap
;; trap:   integer overflow in / at i8
;; roots:  ../../lib
;; covers: /
;; -128/-1 is 128/1, which does not fit an i8, so it still traps (case 093's
;; -128/-2 is 64/1 and does not). The trap is the exact division of the
;; numerator by the common divisor, which names the width; the gcd steps never
;; call rem with a divisor of -1, so Rust's `rem` overflow is not what fires.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (numerator (/ -128i8 -1i8))))
    (if (= x 0i8) 1 2)))
