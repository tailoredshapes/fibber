;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int
;; A float that cuts to 2147483648 does not fit an i32, where 2147483647.9 cuts to 2147483647 and
;; does (case 2857).
(defun main () -> i64 (sext i64 (int 2147483648.0)))
