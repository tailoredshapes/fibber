;; spec:   stdlib §2.1 rule 2, §4.4 rows partition partition-all iterate, §7 L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: partition partition-all iterate
;; Nothing runs until a node is demanded: the first two groups of an endless source are the answer, and a counter on the
;; source shows how far each call read (a group of n reads n elements, and the next window is found only when asked for).
(ns main (:use fib.core fib.seq fib.coll tl.check))

;; the groups as vectors, in order
(defun groups (s: (LSeq (VSeq a))) -> (Vec (Vec a))
  (vec (map (fn (g: (VSeq a)) (to-vec g)) s)))

(defun none () -> (Vec i64) [])

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (groups (take 2 (partition 2 (iterate inc 0)))) [[0 1] [2 3]]))
        (check c (= (groups (take 2 (partition-all 3 2 (iterate inc 0)))) [[0 1 2] [2 3 4]]))
        (check c (= (groups (take 2 (partition 2 (map (fn (x: i64) (* x x)) (iterate inc 1))))) [[1 4] [9 16]]))
        (check c (= (groups (take 1 (partition 2 5 (none) (iterate inc 7)))) [[7 8]]))
        
        (checks-result c))))
