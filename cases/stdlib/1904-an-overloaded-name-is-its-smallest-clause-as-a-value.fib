;; spec:   stdlib §7 L1 (the bare name denotes the clause of the fewest parameters)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; covers: defn
;; `pick` as a value, in a `let` initialiser and as an argument, is the clause of one parameter,
;; `pick$1`; calling the value takes one argument. A name with one clause is a function of that
;; clause's own name and counts.
(defn pick
  ([a: i64 b: i64] -> i64 (+ a b))
  ([a: i64] -> i64 (* a 10)))

(defun twice (f: (fn (i64) i64) x: i64) -> i64 (f (f x)))

(defun main () -> i64
  (let ((r pick))
    (if (= (r 2) 20)
        (if (= (twice pick 1) 100) (if (= (pick 1 2) 3) 0 3) 2)
        1)))
