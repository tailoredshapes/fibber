        (check c (= (lane r 5) (- 7.0 -2.5)))
        (check c (= (lane r 6) (- 7.0 1.25)))
        (check c (= (lane r 7) (- 7.0 -3.75)))
        ()))
        ())))

(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: f64x2 <<-3.75 0.0>>f64) (b: f64x2 <<0.5 3.0>>f64))
    (do (check p (= (lane (+ a b) 1) (- 0.0 3.0)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-f64-1 c)
        (arith-f64-2 c)
        (arith-f64-3 c)
        (arith-f64-4 c)
        (arith-f64-5 c)
        (arith-f64-8 c)
        (planted c)
        (checks-result c))))
