(defun arith-f64-8 (c: Checks) -> unit
  (let ((a: f64x8 <<-3.75 0.0 3.75 -1.25 2.5 -2.5 1.25 -3.75>>f64) (b: f64x8 <<0.5 3.0 2.5 2.0 1.5 1.0 0.5 3.0>>f64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -3.75 0.5)))
        (check c (= (lane r 1) (+ 0.0 3.0)))
        (check c (= (lane r 2) (+ 3.75 2.5)))
        (check c (= (lane r 3) (+ -1.25 2.0)))
        (check c (= (lane r 4) (+ 2.5 1.5)))
        (check c (= (lane r 5) (+ -2.5 1.0)))
        (check c (= (lane r 6) (+ 1.25 0.5)))
        (check c (= (lane r 7) (+ -3.75 3.0)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -3.75 0.5)))
        (check c (= (lane r 1) (- 0.0 3.0)))
        (check c (= (lane r 2) (- 3.75 2.5)))
        (check c (= (lane r 3) (- -1.25 2.0)))
        (check c (= (lane r 4) (- 2.5 1.5)))
        (check c (= (lane r 5) (- -2.5 1.0)))
        (check c (= (lane r 6) (- 1.25 0.5)))
        (check c (= (lane r 7) (- -3.75 3.0)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -3.75 0.5)))
        (check c (= (lane r 1) (* 0.0 3.0)))
        (check c (= (lane r 2) (* 3.75 2.5)))
        (check c (= (lane r 3) (* -1.25 2.0)))
        (check c (= (lane r 4) (* 2.5 1.5)))
        (check c (= (lane r 5) (* -2.5 1.0)))
        (check c (= (lane r 6) (* 1.25 0.5)))
        (check c (= (lane r 7) (* -3.75 3.0)))
        ()))
        (let ((r (fdiv a b)))
      (do
        (check c (= (lane r 0) (fdiv -3.75 0.5)))
        (check c (= (lane r 1) (fdiv 0.0 3.0)))
        (check c (= (lane r 2) (fdiv 3.75 2.5)))
        (check c (= (lane r 3) (fdiv -1.25 2.0)))
        (check c (= (lane r 4) (fdiv 2.5 1.5)))
        (check c (= (lane r 5) (fdiv -2.5 1.0)))
        (check c (= (lane r 6) (fdiv 1.25 0.5)))
        (check c (= (lane r 7) (fdiv -3.75 3.0)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75)))
        (check c (= (lane r 1) (neg 0.0)))
        (check c (= (lane r 2) (neg 3.75)))
        (check c (= (lane r 3) (neg -1.25)))
        (check c (= (lane r 4) (neg 2.5)))
        (check c (= (lane r 5) (neg -2.5)))
        (check c (= (lane r 6) (neg 1.25)))
        (check c (= (lane r 7) (neg -3.75)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75 2.0)))
        (check c (= (lane r 1) (+ 0.0 2.0)))
        (check c (= (lane r 2) (+ 3.75 2.0)))
        (check c (= (lane r 3) (+ -1.25 2.0)))
        (check c (= (lane r 4) (+ 2.5 2.0)))
        (check c (= (lane r 5) (+ -2.5 2.0)))
        (check c (= (lane r 6) (+ 1.25 2.0)))
        (check c (= (lane r 7) (+ -3.75 2.0)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0 -3.75)))
        (check c (= (lane r 1) (- 7.0 0.0)))
        (check c (= (lane r 2) (- 7.0 3.75)))
        (check c (= (lane r 3) (- 7.0 -1.25)))
