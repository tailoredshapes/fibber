;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg and fdiv on f64 vectors of [1, 2, 3, 4, 5, 8] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-f64-1 (c: Checks) -> unit
  (let ((a: f64x1 <<-3.75>>f64) (b: f64x1 <<0.5>>f64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -3.75 0.5)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -3.75 0.5)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -3.75 0.5)))
        ()))
        (let ((r (fdiv a b)))
      (do
        (check c (= (lane r 0) (fdiv -3.75 0.5)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75 2.0)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0 -3.75)))
        ()))
        ())))

(defun arith-f64-2 (c: Checks) -> unit
  (let ((a: f64x2 <<-3.75 0.0>>f64) (b: f64x2 <<0.5 3.0>>f64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -3.75 0.5)))
        (check c (= (lane r 1) (+ 0.0 3.0)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -3.75 0.5)))
        (check c (= (lane r 1) (- 0.0 3.0)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -3.75 0.5)))
        (check c (= (lane r 1) (* 0.0 3.0)))
        ()))
        (let ((r (fdiv a b)))
      (do
        (check c (= (lane r 0) (fdiv -3.75 0.5)))
        (check c (= (lane r 1) (fdiv 0.0 3.0)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75)))
        (check c (= (lane r 1) (neg 0.0)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75 2.0)))
        (check c (= (lane r 1) (+ 0.0 2.0)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0 -3.75)))
        (check c (= (lane r 1) (- 7.0 0.0)))
        ()))
        ())))

(defun arith-f64-3 (c: Checks) -> unit
  (let ((a: f64x3 <<-3.75 0.0 3.75>>f64) (b: f64x3 <<0.5 3.0 2.5>>f64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -3.75 0.5)))
        (check c (= (lane r 1) (+ 0.0 3.0)))
        (check c (= (lane r 2) (+ 3.75 2.5)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -3.75 0.5)))
        (check c (= (lane r 1) (- 0.0 3.0)))
        (check c (= (lane r 2) (- 3.75 2.5)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -3.75 0.5)))
        (check c (= (lane r 1) (* 0.0 3.0)))
        (check c (= (lane r 2) (* 3.75 2.5)))
        ()))
        (let ((r (fdiv a b)))
      (do
        (check c (= (lane r 0) (fdiv -3.75 0.5)))
        (check c (= (lane r 1) (fdiv 0.0 3.0)))
        (check c (= (lane r 2) (fdiv 3.75 2.5)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75)))
        (check c (= (lane r 1) (neg 0.0)))
        (check c (= (lane r 2) (neg 3.75)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75 2.0)))
        (check c (= (lane r 1) (+ 0.0 2.0)))
        (check c (= (lane r 2) (+ 3.75 2.0)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0 -3.75)))
        (check c (= (lane r 1) (- 7.0 0.0)))
        (check c (= (lane r 2) (- 7.0 3.75)))
        ()))
        ())))

