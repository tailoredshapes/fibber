;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types fib.http.bytes fib.http.testing fib.http.client.types) (:require [fib.http.client :as cl] [fib.http.server.types :as st]))
(defun handler (r: Request) -> st/Reply (st/Whole (text-response 200 (str-from-bytes (. r body)))))
(defun main () -> i64
  (let [c (checks) o (with-factory (default-options) "http" (loopback-factory handler (st/default-options)))]
    (match (cl/build-http-client o)
      ((Err _) 1)
      ((Ok client)
        (do (dotimes (i 4)
              (check c (match (cl/request-with client (ClientRequest "POST" "http://x/" {} (str-bytes "same")))
                         ((Ok r) (= (str-from-bytes (. r body)) "same")) (_ false))))
            (let [s (cl/pool-stats client)] (do (check c (= (. s opened) 1)) (check c (= (. s reused) 3)) (check c (= (. s idle) 1))))
            (cl/close-http-client client)
            (checks-result c))))))
