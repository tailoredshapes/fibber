;; spec:   docs/design/parallelism.md 3.2 (P-struct); lib/fib/parallel/pmap.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `pmap`, `pmap-n`, `pmap-each` and `pmap-range` give what `map` gives, in order, for seeded random vectors, 1 to 28 workers, and grains that
;; divide n, do not divide it, are 1, or exceed n. The results are strings (heap values, counted, crossing a task) in the second group.
;; A pmap that scrambles the order, loses a chunk, repeats one or cuts the tail short fails every row; a pmap that spawns more tasks than
;; workers is case 7606's. Empty and singleton inputs, and a pmap of a function that traps, are here and in 7607.
(ns main (:use fib.core fib.parallel tl.check tl.rng))

(defun slow-square (x: i64) -> i64 (* x x))

(defun main () -> i64
  (let [c (checks) r (rng 7604)]
    (do (doseq [n [0 1 2 5 63 64 65 1000 4097]]
          (let [xs (rng-vec r n 1000) want (mapv slow-square xs)]
            (doseq [w [1 2 3 4 7 8 16 28]]
              (doseq [grain [0 1 7 64 100000]]
                (let [p (Par w grain false)]
                  (do (check c (= (pmap p slow-square xs) want))
                      (check c (= (pmap-each [x xs p] (* x x)) want))
                      (check c (= (pmap-n p (fn (i) (* i i)) n) (mapv slow-square (vec (range n)))))
                      (check c (= (pmap-range [i n p] (* i i)) (mapv slow-square (vec (range n)))))))))))
        (let [xs (rng-vec r 300 100000) want (mapv str xs)]
          (doseq [w [1 3 8]]
            (do (check c (= (pmap (Par w 0 false) str xs) want))
                (check c (= (pmap-each [x xs (Par w 5 false)] (str x)) want)))))
        (check c (= (pmap slow-square [7]) [49]))
        (check c (= (pmap (Par 4 0 false) slow-square (vec-empty)) (vec-empty)))
        (checks-result c))))
