;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 36
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; An exception thrown inside a closure that the library calls (reduce, mapv) unwinds through the library's frames to the try around the
;; call; the partial results the library had built are freed (audit clean). Killed by: scripts/mutant-catch.sh `no-release`.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (let ((xs [1 2 3 4]))
    (+ (try (reduce (fn (acc: i64 x: i64) (if (= x 3) (throw (ex "three")) (+ acc x))) 0 xs)
            (catch e (if (= (ex-message e) "three") 30 0)))
       (try (count (mapv (fn (x: i64) (if (= x 4) (nth xs 9) (* x 2))) xs))
            (catch e 6)))))
