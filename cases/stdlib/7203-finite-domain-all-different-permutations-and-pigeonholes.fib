;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (answers (l/run-many 10 3 (fn (qs) (l/all [(fd/in-all qs (fd/interval 1 3)) (fd/distinct qs)])))))
    (do (check c (= (count answers) 6))
        (dotimes (i (count answers)) (check c (= (count (set (mapv (fn (t: l/Term) (l/term-text t)) (nth answers i)))) 3)))
        (check c (= (l/run-many 1 3 (fn (qs) (l/all [(fd/in-all qs (fd/interval 1 2)) (fd/distinct qs)]))) []))
        (check c (= (l/run-many 1 2 (fn (qs) (l/all [(fd/distinct qs) (fd/in-all qs (fd/interval 1 2)) (l/== (nth qs 0) (nth qs 1))]))) []))
        (check c (= (l/run 1 (fn (q) (fd/distinct [(l/integer 1) (l/integer 1)]))) []))
        (checks-result c))))
