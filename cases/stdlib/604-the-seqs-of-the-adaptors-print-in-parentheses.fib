;; spec:   stdlib §2.7 (a seq prints in parentheses), §2.1 rule 2 (the adaptors return an LSeq)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; (show (map inc [1 2 3])) is (2 3 4) and (show (take 3 ..)) is (5 6 7): the
;; lazy forms of the adaptors are LSeqs, which print in parentheses, where a
;; Vec prints in brackets (the page's showseq program). The prelude's own
;; Vec-only `map` is shadowed by L6's in a module that uses fib.seq. The LSeq
;; instances themselves are case 601's.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (show (take 3 [5 6 7 8])) "(5 6 7)"))
        (check c (= (show (map (fn (x) (+ x 1)) [1 2 3])) "(2 3 4)"))
        (check c (= (str (filter (fn (x) (> x 1)) [1 2 3])) "(2 3)"))
        (check c (= (debug (take 2 ["a" "b" "c"])) "(\"a\" \"b\")"))
        (check c (= (show (take 0 [1 2])) "()"))
        (checks-result c))))
