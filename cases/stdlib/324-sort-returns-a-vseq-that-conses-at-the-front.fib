;; spec:   stdlib §4.4 (rows sort, VSeq), §2.1 rule 8 (sort returns a seq, as Clojure's does)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sort VSeq
;; sort's result is a VSeq: front elements consed over the sorted Vec and an
;; offset, so conj puts the new element at the front ((conj (sort [3 1 2]) 0)
;; is (0 1 2 3), where a Vec would take it at the end), rest skips one, it is
;; a Reducible (count, nth, last, to-vec), and to-vec of a sort that nothing
;; was consed onto hands back the sorted Vec itself, with no copy: the
;; allocation side of that is count-351.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun same (a: (Vec e) b: (Vec e)) :where ((Eq e)) -> bool
  (if (= (vec-count a) (vec-count b))
      (loop ((i 0))
        (if (< i (vec-count a))
            (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false)
            true))
      false))

;; a function of the seq type itself: the sorted Vec of 3 1 2 is a (VSeq i64)
(defun smallest (s: (VSeq i64)) -> i64 (nth s 0))

(defun main () -> i64
  (let ((c (checks))
        (s (sort [3 1 2]))
        (s0 (conj (sort [3 1 2]) 0))
        (r (rest (sort [3 1 2]))))
    (do (check c (same (to-vec s) [1 2 3]))
        (check c (same (to-vec s0) [0 1 2 3]))
        (check c (same (to-vec (conj s0 -1)) [-1 0 1 2 3]))
        (check c (same (to-vec s) [1 2 3]))
        (check c (= (smallest s) 1))
        (check c (= (smallest s0) 0))
        (check c (= (count s) 3))
        (check c (= (count s0) 4))
        (check c (= (nth s 2) 3))
        (check c (= (nth s0 0) 0))
        (check c (match (last s0) (nil false) ((some x) (= x 3))))
        (check c (same (to-vec r) [2 3]))
        (check c (same (to-vec (sort s0)) [0 1 2 3]))
        (check c (same (to-vec (sort (conj s 0))) [0 1 2 3]))
        (check c (= (count (sort (sort [2 1]))) 2))
        (checks-result c))))
