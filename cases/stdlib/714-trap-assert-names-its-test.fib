;; spec:   stdlib §4.2 (row assert), syntax §4.4
;; expect: trap
;; trap:   (= (+ 1 1) 3)
;; covers: assert
;; (assert c) has no message of its own: the default one names the place
;; of the call and the test as written, `assert failed at POS: TEST`, so
;; a failed assertion says which one it was. The first assertion holds
;; and the program goes on; the text expected is the second one's test.
(defun main () -> i64
  (do (assert (= (+ 1 1) 2))
      (assert (= (+ 1 1) 3))
      0))
