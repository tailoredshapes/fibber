;; spec:   spec/types.md 8.2 (freeze); docs/design/parallelism.md 3.6
;; expect: trap
;; trap:   freeze: an atom is reachable from the value (an atom is mutable in place)
;; stage:  2
;; roots:  ../../lib support
;; covers: freeze
;; An atom is `Send`, so the type does not refuse it; the run-time check does, when the walk reaches the atom inside the Vec.
(ns main)

(defun main () -> i64
  (let ((v (freeze [(atom 1) (atom 2)])))
    (count v)))
