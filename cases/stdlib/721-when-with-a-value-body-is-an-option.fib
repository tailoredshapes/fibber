;; spec:   stdlib §4.2 (row when), §2.4, §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: when
;; (when c body) is unit when the body is, and otherwise `(Option T)` with
;; `some` around the body: (when (even? n) (* n 2)) is Clojure's text for
;; a value or nil. Today a `when` is (if c body ()) and a value body is
;; `cannot unify unit with i64` (A11 t82).
(ns main (:use tl.check))

(defun doubled-when-even (n: i64) -> (Option i64)
  (when (= (rem n 2) 0) (* n 2)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (match (doubled-when-even 4) ((some x) (= x 8)) (nil false)))
        (check c (match (doubled-when-even 3) ((some _) false) (nil true)))
        (checks-result c))))
