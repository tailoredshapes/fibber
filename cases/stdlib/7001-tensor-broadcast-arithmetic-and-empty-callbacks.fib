;; spec: docs/design/numerical-library.md; eager scalar elementwise kernels
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (a (t/reshape [2 3] (t/arange 0 6 1))) (b (t/tensor-i64 [10 20 30])))
    (do (check c (= (t/to-vec (t/add a b)) [10 21 32 13 24 35]))
        (check c (= (t/to-vec (t/sub b a)) [10 19 28 7 16 25]))
        (check c (= (t/to-vec (t/mul a (t/full [] 2))) [0 2 4 6 8 10]))
        (check c (= (t/to-vec (t/scale 3 (t/flip 1 a))) [6 3 0 15 12 9]))
        (check c (= (t/to-vec (t/square (t/tensor-i64 [-2 0 3]))) [4 0 9]))
        (check c (= (t/to-vec (t/neg (t/tensor-i64 [-2 0 3]))) [2 0 -3]))
        (check c (= (t/to-vec (t/div (t/tensor [2.0 6.0]) (t/full [] 2.0))) [1.0 3.0]))
        (check c (= (t/to-vec (t/add (t/full [2] 1i32) (t/full [] 2i32))) [3i32 3i32]))
        (check c (= (t/to-vec (t/mul (t/full [2] 1.5f32) (t/full [] 2.0f32))) [3.0f32 3.0f32]))
        (check c (= (t/dtype (t/zeros-f32 [0])) :f32))
        (check c (= (t/dtype (t/zeros-i32 [0])) :i32))
        (let ((left (t/reshape [2 1 3] (t/arange 0 6 1)))
              (right (t/reshape [1 4 1] (t/tensor-i64 [10 20 30 40]))))
          (do (check c (= (t/shape (t/add left right)) [2 4 3]))
              (check c (= (t/to-vec (t/add left right))
                          [10 11 12 20 21 22 30 31 32 40 41 42 13 14 15 23 24 25 33 34 35 43 44 45]))))
        (let ((calls (cell 0)) (empty (t/zeros [0 3])))
          (do (check c (= (t/size (t/map (fn (x: f64) (do (set! calls (+ @calls 1)) x)) empty)) 0))
              (check c (= @calls 0))
              (check c (= (t/shape (t/add empty (t/ones [1 3]))) [0 3]))))
        (let ((calls (cell 0)))
          (do (check c (= (t/to-vec (t/map-as (fn (x: i64) (do (set! calls (+ @calls 1)) (double x)))
                                              0.0 (t/tensor-i64 [1 2 3]))) [1.0 2.0 3.0]))
              (check c (= @calls 3))))
        (check c (= (t/size (t/full [9223372036854775807 9223372036854775807 0] 0)) 0))
        (checks-result c))))
