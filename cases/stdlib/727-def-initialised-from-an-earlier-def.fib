;; spec:   stdlib §4.2 (row def), syntax §3.19, compiler.md §8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: def
;; A constant may name an earlier `def`: syntax §3.19's grammar has `name`
;; ("an earlier def") among the constants, and compiler.md §8 (answer 4)
;; says each initialiser sees the ones before it. `fibc` said `unsupported:
;; a def read before its value was made` for the simplest program of the
;; kind, `(def a: i64 1) (def b: i64 a)`, because it stored the values of
;; the defs only after all had been evaluated; the JIT backend of
;; crates/fibc/src/defs now records each value as it is made
;; (cases/ownership/222 is the same without the library).
(ns main (:use tl.check))

(def limit: i64 1000)
(def alias: i64 limit)
(def table: (Vec i64) [10 20 30])
(def again: (Vec i64) table)
(def pair: (Vec i64) [limit 2])

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= alias 1000))
        (check c (= (nth again 1) 20))
        (check c (= (nth pair 0) 1000))
        (checks-result c))))
