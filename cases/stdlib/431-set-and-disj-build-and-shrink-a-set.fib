;; spec:   stdlib §4.5 (rows set disj), §2.3 (Dissoc)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: set disj contains?
;; (set c) is the distinct elements of any Reducible; (disj s x) is s without x,
;; and an x s does not hold is no error. disj is the Dissoc method under
;; Clojure's name, so it removes a key from a Map too (more lenient than
;; Clojure, which rejects it: no program Clojure accepts is rejected, the
;; page's §2.3). Strings and integers are elements (the library's Hash).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (s (set [3 1 2 3 1]))
        (t (disj s 1))
        (u (disj t 7))
        (w (set ["x" "y" "x"]))
        (m (assoc (assoc (empty {1 0}) 1 10) 2 20)))
    (do (check c (= (count s) 3))
        (check c (contains? s 1))
        (check c (= (count t) 2))
        (check c (not (contains? t 1)))
        (check c (contains? t 2))
        (check c (contains? s 1))
        (check c (= (count u) 2))
        (check c (= (count (set (empty [0]))) 0))
        (check c (= (count w) 2))
        (check c (contains? w "x"))
        (check c (not (contains? (disj w "x") "x")))
        (check c (= (count (disj (disj (disj s 1) 2) 3)) 0))
        (check c (not (contains? (disj m 1) 1)))
        (check c (is (get (disj m 1) 2) 20))
        (check c (= (count (set (set [5 6 5]))) 2))
        (check c (= (count (set (some 4))) 1))
        (checks-result c))))
