;; spec:   syntax §3.19, types §2.16 (the dependency order), stdlib §7 L15
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; `a` is written first and calls `read-b`, which reads `b`: `b` is typed
;; and made first, since a `def` is a node of the dependency order after
;; the functions it names and the `def`s they read.
(ns main (:use tl.check))

(defun twice (n: i64) -> i64 (* n 2))
(def a: i64 (read-b 1))
(defun read-b (n: i64) -> i64 (+ n b))
(def b: i64 (twice 5))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= b 10))
        (check c (= a 11))
        (checks-result c))))
