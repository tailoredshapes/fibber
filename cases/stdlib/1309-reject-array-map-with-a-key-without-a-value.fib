;; spec:   stdlib §4.8 (row array-map), §6.3 (E1)
;; expect: reject
;; error:  malformed array-map: a key without a value
;; roots:  ../../lib support
;; covers: array-map
;; (array-map k v ..) is the literal {k v ..}, which has an even count; the odd call is refused where it is
;; written, as assoc's is (case 770).
(ns main (:use tl.check))

(defun main () -> i64
  (count (array-map 1 10 2)))
