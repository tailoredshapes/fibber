;; spec:   stdlib §2.1 rule 3 (consumers stop through the bool), tranche 2 plan Y4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: second ffirst fnext not-empty
;; second, fnext, ffirst and not-empty look at one or two elements and stop, so each ends on a
;; source that never ends: a Range of step 0 repeats its start for ever (the stand-in for the
;; endless sources of tranche 2's streams). The Range is the whole collection in not-empty's answer,
;; and the walk that follows it is the caller's own (first stops at once).
(ns main (:use fib.core fib.seq tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (is (second (Range 7 8 0)) 7))
        (check c (is (fnext (Range 7 8 0)) 7))
        (check c (is (ffirst [(Range 3 4 0) (Range 5 6 0)]) 3))
        (check c (match (not-empty (Range 9 10 0)) (nil false) ((some r) (is (first r) 9))))
        (check c (is (second (map inc (Range 1 2 0))) 2))
        (check c (is (ffirst (list (Range 4 5 0))) 4))
        (checks-result c))))
