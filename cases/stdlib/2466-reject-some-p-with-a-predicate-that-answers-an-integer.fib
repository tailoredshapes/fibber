;; spec:   stdlib §2.3 (a predicate result is a Truthy: bool or Option, and no other type), tranche 2 plan Y4
;; expect: reject
;; error:  no implementation of Truthy for i64
;; roots:  ../../lib support
;; An integer is never false (Clojure's 0 is truthy), so it is not a condition here: a predicate
;; of some-p that answers one is refused with the protocol's name, as every?'s is.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (match (some-p (fn (x) (* x 2)) [1 2 3])
    (nil 0)
    ((some v) v)))
