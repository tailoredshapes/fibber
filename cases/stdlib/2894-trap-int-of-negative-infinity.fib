;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int
;; An infinity is out of every integer range, the negative one included (`fptosi` alone would
;; saturate it to the minimum).
(defun main () -> i64 (sext i64 (int (/ -1.0 0.0))))
