;; spec:   stdlib §5 (nth traps on a bad index, P5), §2.5 (bulk builder, L9)
;; expect: trap
;; trap:   nth: index out of range
;; A Vec of 33 elements made by vec from a range has one full leaf in the trie and one
;; element in the tail. Its last element is read first (the value is added to the index
;; afterwards, so the trap is the second read), then index 33, one past it, which the
;; bulk builder's count and tail must refuse as a conj-built vector's do: the trap names the
;; function.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (vec (range 33))))
    (+ (nth v 32) (nth v 33))))
