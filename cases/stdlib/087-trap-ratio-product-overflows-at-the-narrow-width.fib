;; spec:   stdlib §2.8 (the components trap on overflow at their width)
;; expect: trap
;; trap:   integer overflow in * at i8
;; roots:  ../../lib
;; covers: /
;; The components of a ratio of i8s are i8s: 100/3 + 100/7 needs 100 * 7,
;; which does not fit, and the trap names i8, where case 064 names i64.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (numerator (+ (/ 100i8 3i8) (/ 100i8 7i8)))))
    (if (= x 0i8) 1 2)))
