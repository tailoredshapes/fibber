;; spec:   stdlib §4.2 (row when-let), §2.4, §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: when-let
;; (when-let (x e) body) over an Option (x is the payload): its value is unit when
;; the body is, else `(Option T)` with `some` around the body, as `when`. Today the
;; body is unit: a value body is `cannot unify unit with i64`. The bool binding of
;; the row is case 1501.
(ns main (:use tl.check))

(defun plus-one (o: (Option i64)) -> (Option i64)
  (when-let (x o) (+ x 1)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (match (plus-one (some 4)) ((some y) (= y 5)) (nil false)))
        (check c (match (plus-one nil) ((some _) false) (nil true)))
        (checks-result c))))
