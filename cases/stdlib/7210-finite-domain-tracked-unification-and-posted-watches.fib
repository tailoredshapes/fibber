;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check) (:require [fib.logic :as l] [fib.logic.fd :as fd]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (l/run-many 1 3 (fn (qs) (l/all
          [(fd/+ (nth qs 0) (nth qs 1) (nth qs 2))
           (l/== (l/pair (nth qs 0) (nth qs 1)) (l/pair (l/integer 1) (l/integer 2)))
           (fd/in (nth qs 2) (fd/interval 0 5))])))
          [[(l/integer 1) (l/integer 2) (l/integer 3)]]))
        (check c (= (l/run-many 1 3 (fn (qs) (l/all
          [(fd/< (nth qs 0) (nth qs 2))
           (l/== (nth qs 0) (nth qs 1))
           (fd/in (nth qs 1) (fd/interval 2 3))
           (fd/in (nth qs 2) (fd/interval 1 3))])))
          [[(l/integer 2) (l/integer 2) (l/integer 3)]]))
        (check c (= (l/run-many 1 2 (fn (qs) (l/all
          [(fd/in-all qs (fd/interval 1 3))
           (l/== (l/pair (nth qs 0) (nth qs 1)) (l/pair (l/integer 2) (l/symbol "bad")))]))) []))
        (check c (= (l/run-many 1 2 (fn (qs) (fd/batch
          [(fd/< (nth qs 0) (nth qs 1)) (fd/in-all qs (fd/interval 1 4))
           (l/== (nth qs 0) (nth qs 1))]))) []))
        (check c (= (l/run-many 1 2 (fn (qs) (fd/batch
          [(fd/in-all qs (fd/interval 1 4))
           (l/== (l/pair (nth qs 0) (nth qs 1)) (l/pair (nth qs 1) (l/integer 3)))])))
          [[(l/integer 3) (l/integer 3)]]))
        (check c (= (l/run 1 (fn (q) (l/all
          [(fd/in q (fd/interval 1 3)) (l/== q (l/pair q (l/nil-term)))]))) []))
        (checks-result c))))
