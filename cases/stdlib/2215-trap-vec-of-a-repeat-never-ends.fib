;; spec:   stdlib §4.4 (rows repeat, vec), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   to-vec: never ends
;; roots:  ../../lib support
;; covers: repeat vec
;; Vec of a repeat: the to-vec method traps.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (count (vec (repeat 4))))
