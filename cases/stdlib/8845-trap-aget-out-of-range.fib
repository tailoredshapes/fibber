;; spec:   stdlib §4.1 row aget (traps out of range)
;; expect: trap
;; trap:   array index 3 out of range 0..3
;; roots:  ../../lib
;; covers: aget
;; aget of an index past the end traps with array-get's message, where Clojure throws ArrayIndexOutOfBoundsException.
(ns main)

(defun main () -> i64
  (let ((a (long-array 3)))
    (aget a 3)))
