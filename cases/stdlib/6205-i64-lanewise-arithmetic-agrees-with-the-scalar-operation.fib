(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: i64x2 <<-989 -952>>i64) (b: i64x2 <<-993 -940>>i64))
    (do (check p (= (lane (+ a b) 1) (- -952 -940)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-i64-1 c)
        (arith-i64-2 c)
        (arith-i64-3 c)
        (arith-i64-4 c)
        (arith-i64-5 c)
        (arith-i64-8 c)
        (planted c)
        (checks-result c))))
