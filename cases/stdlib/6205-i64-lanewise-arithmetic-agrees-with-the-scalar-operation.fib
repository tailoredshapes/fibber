;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg on i64 vectors of [1, 2, 3, 4, 5, 8] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-i64-1 (c: Checks) -> unit
  (let ((a: i64x1 <<-989>>i64) (b: i64x1 <<-993>>i64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -989 -993)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -989 -993)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -989 -993)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -989)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ -989 2)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7 -989)))
        ()))
        ())))

(defun arith-i64-2 (c: Checks) -> unit
  (let ((a: i64x2 <<-989 -952>>i64) (b: i64x2 <<-993 -940>>i64))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -989 -993)))
        (check c (= (lane r 1) (+ -952 -940)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -989 -993)))
        (check c (= (lane r 1) (- -952 -940)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -989 -993)))
        (check c (= (lane r 1) (* -952 -940)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -989)))
        (check c (= (lane r 1) (neg -952)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ -989 2)))
        (check c (= (lane r 1) (+ -952 2)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7 -989)))
        (check c (= (lane r 1) (- 7 -952)))
        ()))
        ())))

