;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g]))
(defun main () -> i64
  (let [c (checks) calls (atom 0) text (g/named "String")
        definition (g/schema {} {"echo" (with (g/resolving text
          (fn (context: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
            (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (unwrap-or (get args "text") g/NullValue)))))
          (arguments {"text" (with (g/argument (g/non-null text)) (default-value (some (g/StringValue "default"))))}))})]
    (do (match (g/compile-schema definition)
      ((Err _) (check c false))
      ((Ok compiled) (do
        (doseq [query ["{ missing }" "{ echo(bad: 1) }" "{ echo(text: 2) }" "{ echo(text: null) }" "{ echo { nested } }"]]
          (let [result (g/execute compiled query {} g/NullValue)]
            (do (check c (= (. result data) nil)) (check c (> (count (. result errors)) 0)))))
        (check c (= @calls 0))
        (check c (= (g/result-json (g/execute compiled "{ echo }" {} g/NullValue)) "{\"data\":{\"echo\":\"default\"}}"))
        (check c (= (g/result-json (g/execute compiled "{ echo(text: \"hi\") }" {} g/NullValue)) "{\"data\":{\"echo\":\"hi\"}}"))
        (check c (= @calls 2)))))
      (checks-result c))))
