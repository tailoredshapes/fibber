;; spec:   stdlib §4.14 (row slurp), §1.2 P5 (a function Clojure throws from traps), plan §4.3 rule 8
;; expect: trap
;; trap:   slurp: cannot read /fibstdlib-609-no-such-directory/none.txt
;; roots:  ../../lib support
;; covers: slurp
;; Clojure's (slurp "missing") throws FileNotFoundException; until exceptions land
;; this traps, with a message that names the function and the path. A program that
;; must recover calls try-slurp (case 610).
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (str-len (slurp "/fibstdlib-609-no-such-directory/none.txt")))
