;; spec:   types §1.9, docs/design/simd-and-tensors.md 1.9
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A (Vec f64x4) and an Array of vectors: conj, nth, assoc and a reduce read every element back; the element stride and alignment are the layout`s of 8 bytes.
(ns main (:use fib.core fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (let ((v (loop ((i 0) (acc: (Vec f64x4) [])) (if (< i 20) (recur (+ i 1) (conj acc (splat f64x4 (sitofp f64 i)))) acc))))
          (do (check c (= (count v) 20)) (check c (= (lane (nth v 7) 3) 7.0)) (check c (= (hsum (nth v 19)) 76.0))
              (check c (= (hsum (reduce (fn (a: f64x4 b: f64x4) (+ a b)) (splat f64x4 0.0) v)) 760.0))
              (let ((w (assoc v 3 <<9.0 8.0 7.0 6.0>>f64)))
                (do (check c (= (lane (nth w 3) 1) 8.0)) (check c (= (lane (nth v 3) 1) 3.0))))))
        (let ((a (array 3 (splat i8x3 2i8))))
          (do (check c (= (hsum (array-get a 2)) 6i8))))
        (let ((vs (conj (conj [] <<1 2 3>>i16) <<4 5 6>>i16)))
          (check c (= (lane (nth vs 1) 2) 6i16)))
        (let ((p (checks)))
          (do (check p (= (lane (nth (conj [] <<1.0 2.0>>f64) 0) 1) 3.0)) (check-detects c p)))
        (checks-result c))))
