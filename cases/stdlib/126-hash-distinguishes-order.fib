;; spec:   stdlib §2.7 (hash-combine "tells [\"ab\" \"c\"] from [\"a\" \"bc\"] and [\"a\" \"b\"] from [\"b\" \"a\"]", A10 hash)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: hash
;; The hash of a vector depends on the elements and on their order, and on
;; where one element ends and the next begins: a combiner that added or xored
;; the element hashes would give `[1 2]` and `[2 1]` one number, and one that
;; hashed the concatenation would give `["ab" "c"]` and `["a" "bc"]` one. The
;; page names those two pairs (A10 hash). Also the boundaries between empty
;; and nested vectors (`[]`, `[[]]`, `[[] []]`, `[0]`, `[0 0]`), where a fold
;; that skips an empty element or forgets the count would fall together. The
;; equalities are the other half: the same vector built twice hashes alike.
;; These are checks of this mixer's values, as the page's are: a hash does
;; not promise that unequal values differ, the library's rotate-and-xor
;; mixer just does on every one of these.
(ns main (:use fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (e: (Vec i64) (vec-empty))
        (ee: (Vec (Vec i64)) (vec-empty)))
    (do (check c (!= (hash ["ab" "c"]) (hash ["a" "bc"])))
        (check c (!= (hash ["a" "b"]) (hash ["b" "a"])))
        (check c (!= (hash [1 2]) (hash [2 1])))
        (check c (!= (hash [1 2 3]) (hash [3 2 1])))
        (check c (!= (hash [1 2 3]) (hash [1 3 2])))
        (check c (!= (hash ["abc"]) (hash ["a" "bc"])))
        (check c (!= (hash ["abc"]) (hash ["ab" "c"])))
        (check c (!= (hash ["" "a"]) (hash ["a" ""])))
        (check c (!= (hash [""]) (hash ["" ""])))
        (check c (!= (hash e) (hash [0])))
        (check c (!= (hash [0]) (hash [0 0])))
        (check c (!= (hash [0 0]) (hash [0 0 0])))
        (check c (!= (hash ee) (hash [e])))
        (check c (!= (hash [e]) (hash [e e])))
        (check c (!= (hash [[1] [2 3]]) (hash [[1 2] [3]])))
        (check c (!= (hash [[1 2 3]]) (hash [[1] [2] [3]])))
        (check c (!= (hash [1 2 3]) (hash [1 2 4])))
        (check c (= (hash [1 2 3]) (hash [1 2 3])))
        (check c (= (hash ["ab" "c"]) (hash ["ab" "c"])))
        (check c (= (hash e) (hash e)))
        (check c (= (hash [[1] [2 3]]) (hash [[1] [2 3]])))
        (check c (= (checks-made c) 21))
        (checks-result c))))
