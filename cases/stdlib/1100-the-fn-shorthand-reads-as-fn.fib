;; spec:   syntax §1.2 (`#(..)`), stdlib §7 E8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; Clojure's #(f % %2) is (fn (%1 %2) (f %1 %2)): `%` is `%1`, the parameters
;; go up to the largest index used, and an index never used is still a
;; parameter, so #(f %2) takes two. The body is one call.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (vec (map #(* % 2) [1 2 3])) [2 4 6]))
        (check c (= (vec (map #(+ %1 1) [1 2 3])) [2 3 4]))
        (check c (= (reduce #(+ %1 %2) 0 [1 2 3 4]) 10))
        (check c (= (reduce #(- %1 %2) 10 [1 2 3]) 4))
        (check c (= (#(+ %2 %1) 3 10) 13))
        (check c (= (#(first-of-two %2 %1) 1 2) 2))
        (check c (= (#(do 7)) 7))
        (checks-result c))))

(defun first-of-two (a: i64 b: i64) -> i64 a)
