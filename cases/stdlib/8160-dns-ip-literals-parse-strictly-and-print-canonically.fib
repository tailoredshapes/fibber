;; spec: docs/design/dns.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll) (:require [fib.dns.ip :as ip]))
(defun canon (t: str) -> str (match (ip/literal t) (nil "") ((some b) (if (= (array-len b) 4) (ip/format-ipv4 b 0) (ip/format-ipv6 b)))))
(defun main () -> i64
  (let [c (checks)]
    (do (check c (= (canon "1.2.3.4") "1.2.3.4"))
        (check c (= (canon "2001:0DB8:0000:0000:0000:0000:0000:0001") "2001:db8::1"))
        (check c (= (canon "1:0:0:2:0:0:0:3") "1:0:0:2::3"))
        (check c (= (canon "::ffff:1.2.3.4") "::ffff:102:304"))
        (check c (= (canon "::") "::"))
        (check c (= (canon "01.2.3.4") ""))
        (check c (= (canon "256.1.1.1") ""))
        (check c (= (canon "1::2::3") ""))
        (check c (= (canon "fe80::1%eth0") ""))
        (check c (= (canon "12345::1") ""))
        (check c (= (canon "example.com") ""))
        (checks-result c))))
