;; spec:   stdlib §4.3 (rows complement constantly), tranche 2 plan Y6
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: complement constantly
;; (complement p) answers the opposite of p's truthiness for any Truthy answer, and is always a bool: of a bool
;; predicate it negates, of an Option predicate a nil result is kept and a some result is dropped (the way filter
;; reads the predicate). (constantly x) is the unary function that ignores its argument: map over it repeats x, and
;; of a collection or a string it answers the same value each call. Unary only: the arity-reading forms are L22.
(ns main (:use fib.core fib.seq tl.check))

(defun big (x: i64) -> (Option i64) (if (> x 2) (some x) nil))

(defun main () -> i64
  (let ((c (checks))
        (odd (complement even?)))
    (do (check c (= (to-vec (filter odd [1 2 3 4 5])) [1 3 5]))
        (check c (= (odd 3) true))
        (check c (= (odd 4) false))
        (check c (= (to-vec (filter (complement big) [1 2 3 4])) [1 2]))
        (check c (= ((complement big) 5) false))
        (check c (= ((complement big) 1) true))
        (check c (= (to-vec (remove (complement even?) [1 2 3 4 5 6])) [2 4 6]))
        (check c (= (to-vec (filter (complement (complement even?)) [1 2 3 4])) [2 4]))
        (check c (= (to-vec (map (constantly 7) [1 2 3])) [7 7 7]))
        (check c (= (to-vec (map (constantly "z") ["a" "b"])) ["z" "z"]))
        (check c (= ((constantly [1 2]) 0) [1 2]))
        (check c (= ((constantly 1) "ignored") 1))
        (check c (= (count (to-vec (map (constantly 0) (Range 0 10 1)))) 10))
        (check c (= (reduce + 0 (map (constantly 5) [9 9 9 9])) 20))
        (checks-result c))))
