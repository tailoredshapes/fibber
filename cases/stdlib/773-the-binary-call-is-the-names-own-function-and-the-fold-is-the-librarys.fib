;; spec:   stdlib §6.3 (the expansion names its functions by qualified heads; the binary call is declined), §4.5 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: max min conj assoc dissoc merge
;; The program defines max, min, conj, assoc, dissoc and merge of its own, each with
;; the binary (or the three-argument) shape the library function has, answering a marker.
;; The program's own definition beats the prelude macro of the same name (R14, the owner's
;; rule of 2026-10-01: own definitions, then :use, then the library, then the prelude), so
;; (max 1 2) is its own -1 and the macro does not answer a longer call written bare. The
;; fold is reached by the qualified head fib.prelude/max, whose expansion names fib.core/max,
;; fib.coll/conj and the others by qualified heads that no definition of the program's can
;; capture: (fib.prelude/max 1 5 3) is 5, the library's. The same hygiene as cases 755 and 791.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun max (a: i64 b: i64) -> i64 -1)
(defun min (a: i64 b: i64) -> i64 -1)
(defun conj (v: (Vec i64) x: i64) -> (Vec i64) v)
(defun assoc (m: (Map i64 i64) k: i64 v: i64) -> (Map i64 i64) m)
(defun dissoc (m: (Map i64 i64) k: i64) -> (Map i64 i64) m)
(defun merge (a: (Map i64 i64) b: (Map i64 i64)) -> (Map i64 i64) a)

(defun main () -> i64
  (let ((c (checks))
        (m {1 10 2 20}))
    (do (check c (= (max 1 2) -1))
        (check c (= (min 1 2) -1))
        (check c (= (fib.prelude/max 1 5 3) 5))
        (check c (= (fib.prelude/min 4 2 3) 2))
        (check c (= (count (conj [1] 2)) 1))
        (check c (= (count (fib.prelude/conj [1] 2 3)) 3))
        (check c (= (count (assoc m 3 30)) 2))
        (check c (= (count (fib.prelude/assoc m 3 30 4 40)) 4))
        (check c (= (count (dissoc m 1)) 2))
        (check c (= (count (fib.prelude/dissoc m 1 2)) 0))
        (check c (= (count (merge m {3 30})) 2))
        (check c (= (count (fib.prelude/merge m {3 30} {4 40})) 4))
        (checks-result c))))
