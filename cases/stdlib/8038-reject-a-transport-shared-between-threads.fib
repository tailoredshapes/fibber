;; spec: docs/design/http.md
;; expect: reject
;; error: cannot be shared between threads
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.http.tcp :as tcp] [fib.http.transport :as t]))
(defun main () -> i64
  (match (tcp/pipe-pair)
    ((Err _) 1)
    ((Ok p) (let [a (. p fst)] (join (spawn (fn () (do (t/t-close a) 0))))))))
