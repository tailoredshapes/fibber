;; spec:   stdlib §2.8 (the components trap on overflow), Appendix A12 ratio
;; expect: trap
;; trap:   integer overflow in * at i64
;; roots:  ../../lib
;; covers: /
;; The page's own example: 1/3037000500 + 1/3037000501 needs the product of
;; the two denominators, which is just above the largest i64, and the
;; builtin * traps, naming the width. Clojure's ratio is exact and has no
;; such limit: (Ratio BigInt) is tranche 5 (§2.8).
(ns main (:use fib.core))

(defun main () -> i64
  (numerator (+ (/ 1 3037000500) (/ 1 3037000501))))
