;; spec:   stdlib §4.4 row zipmap (`Cursable c2 k2, Cursor k2 v`), §2.1 rule 5, tranche 2 plan Y3
;; expect: reject
;; error:  no implementation of Cursable for (Tree i64)
;; roots:  ../../lib support
;; covers: zipmap
;; The values of `zipmap` are walked by a cursor, so they must be Cursable, as the row says (`Cursable c2 k2`). A user's tree has
;; `each-while` and nothing else, so it is a source for every adaptor and consumer but not for this one, and the checker says which
;; instance is missing: a one-line buffering impl of Cursable (`(cursor (self) (cursor (to-vec self)))`) is the user's to add. As the keys,
;; the same tree is fine: the keys are walked by each-while. The lockstep seqs `zip`, `zip-with` and `interleave` take it either side
;; (case 2356), because they read the lazy seqs of their operands.
(ns main (:use fib.core fib.seq fib.coll))

(defenum (Tree a) Leaf (Node l: (Tree a) v: a r: (Tree a)))
(defun tree-each (t: (Tree a) k: (fn (a) bool) :borrow) -> bool
  (match t
    ((Leaf) true)
    ((Node l v r) (if (tree-each l k) (if (k v) (tree-each r k) false) false))))
(impl (Reducible a) (Tree a) (each-while (self k) (tree-each self k)))

(defun main () -> i64
  (count (zipmap [1 2] (Node Leaf 7 (Node Leaf 8 Leaf)))))
