;; spec:   stdlib §4.3 (row mod), §2.8, Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: mod
;; mod is rem and then a step towards the divisor when the remainder is not
;; zero and the signs differ, as Clojure's: (mod -7 2) is 1 and (mod 7 -2)
;; is -1 where rem gives -1 and 1. A remainder of zero stays zero (and a
;; float one keeps its sign: (mod -4.0 2.0) is -0.0, as Clojure's, which
;; takes (rem num div) as it stands when that is zero). On floats a zero
;; divisor is a NaN, not a trap, as Clojure's; the integer one is case 053.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (mod 5.0 0.0)))
    (do (check c (= (mod -7 2) 1))
        (check c (= (mod 7 -2) -1))
        (check c (= (mod 7 2) 1))
        (check c (= (mod -7 -2) -1))
        (check c (= (mod 0 5) 0))
        (check c (= (mod -6 3) 0))
        (check c (= (mod 6 -3) 0))
        (check c (= (mod 5 5) 0))
        (check c (= (mod -7i8 3i8) 2i8))
        (check c (= (mod 7i8 -3i8) -2i8))
        (check c (= (mod -7i16 3i16) 2i16))
        (check c (= (mod -7i32 3i32) 2i32))
        (check c (= (mod -9223372036854775807 2) 1))
        (check c (= (mod 5.5 2.0) 1.5))
        (check c (= (mod -5.5 2.0) 0.5))
        (check c (= (mod 5.5 -2.0) -0.5))
        (check c (= (mod -5.5 -2.0) -1.5))
        (check c (= (mod -5.5f32 2.0f32) 0.5f32))
        (check c (< (/ 1.0 (mod -4.0 2.0)) 0.0))
        (check c (> (/ 1.0 (mod 4.0 -2.0)) 0.0))
        (check c (!= nan nan))
        (checks-result c))))
