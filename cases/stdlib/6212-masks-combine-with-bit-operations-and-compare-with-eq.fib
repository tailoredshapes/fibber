;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A mask is `(Mask n)`: lanes read as bool, simd/and simd/or simd/xor simd/not act lanewise, simd/any and simd/all reduce, simd/blend selects, `=` is every lane equal, `splat` and `with-lane` take bools. `planted` expects a lane to be true that is false and the comparison must see it.
(ns main (:use fib.core tl.check))

(defun masks (c: Checks) -> unit
  (let ((a: i32x8 <<1 5 3 7 2 6 4 8>>i32) (b: i32x8 <<4 4 4 4 4 4 4 4>>i32))
    (let ((lt (simd/lt a b)) (gt (simd/gt a b)))
      (do (check c (= (lane lt 0) true)) (check c (= (lane lt 1) false)) (check c (= (lane lt 2) true)) (check c (= (lane lt 3) false))
          (let ((both (simd/and lt gt)) (either (simd/or lt gt)) (odd (simd/xor lt gt)) (inv (simd/not lt)))
            (do (check c (= (lane both 0) false)) (check c (= (lane both 4) false))
                (check c (= (lane either 0) true)) (check c (= (lane either 4) true)) (check c (= (lane either 6) false))
                (check c (= (lane odd 0) true)) (check c (= (lane odd 6) false))
                (check c (= (lane inv 0) false)) (check c (= (lane inv 1) true))
                (check c (= lt lt)) (check c (!= lt gt)) (check c (= inv (simd/not lt))) (check c (!= lt inv))
                (check c (simd/any lt)) (check c (not (simd/all lt))) (check c (simd/all (simd/or lt (simd/not lt)))) (check c (not (simd/any (simd/and lt (simd/not lt)))))
                (check c (= (hsum (simd/blend lt a b)) 26i32)) (check c (= (lane (simd/blend lt a b) 1) 4i32))
                (check c (= (lane (simd/lt <<1 2 3>>i8 <<2 2 2>>i8) 0) true))
                (check c (= (lane (with-lane lt 1 true) 1) true))
                (check c (= (lane (splat (Mask 5) true) 4) true))
                (check c (= (lane (splat (Mask 5) false) 4) false))
                (check c (= (hsum <<1 2 3>>i8) 6i8))
                ()))))))

(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: i32x4 <<1 2 3 4>>i32))
    (do (check p (= (lane (simd/lt a <<3 3 3 3>>i32) 3) true))
        (check-detects c p))))

(defun main () -> i64 (let ((c (checks))) (do (masks c) (planted c) (checks-result c))))
