;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; simd/lt le gt ge eq ne on ['f32', 'f64'] vectors give the mask whose lane k is the scalar comparison of lane k (ordered as the scalar `<`: false on a NaN, `ne` true on a NaN; -0.0 equals 0.0).
(ns main (:use fib.core tl.check))

(defun cmp-f32-1 (c: Checks) -> unit
  (let ((a: f32x1 <<-3.75>>f32) (b: f32x1 <<-3.75>>f32))
    (do (let ((r (simd/lt a b)))
      (do
        (check c (= (lane r 0) (< -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/le a b)))
      (do
        (check c (= (lane r 0) (<= -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/gt a b)))
      (do
        (check c (= (lane r 0) (> -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/ge a b)))
      (do
        (check c (= (lane r 0) (>= -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/eq a b)))
      (do
        (check c (= (lane r 0) (= -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/ne a b)))
      (do
        (check c (= (lane r 0) (!= -3.75f32 -3.75f32)))
        ()))
        (let ((r (simd/lt a 2.5)))
      (do
        (check c (= (lane r 0) (< -3.75f32 2.5f32)))
        ()))
        ())))

(defun cmp-f32-3 (c: Checks) -> unit
  (let ((a: f32x3 <<-3.75 0.0 3.75>>f32) (b: f32x3 <<-3.75 3.0 2.5>>f32))
    (do (let ((r (simd/lt a b)))
      (do
        (check c (= (lane r 0) (< -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (< 0.0f32 3.0f32)))
        (check c (= (lane r 2) (< 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/le a b)))
      (do
        (check c (= (lane r 0) (<= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (<= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (<= 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/gt a b)))
      (do
        (check c (= (lane r 0) (> -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (> 0.0f32 3.0f32)))
        (check c (= (lane r 2) (> 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/ge a b)))
      (do
        (check c (= (lane r 0) (>= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (>= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (>= 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/eq a b)))
      (do
        (check c (= (lane r 0) (= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (= 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/ne a b)))
      (do
        (check c (= (lane r 0) (!= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (!= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (!= 3.75f32 2.5f32)))
        ()))
        (let ((r (simd/lt a 2.5)))
      (do
        (check c (= (lane r 0) (< -3.75f32 2.5f32)))
        (check c (= (lane r 1) (< 0.0f32 2.5f32)))
        (check c (= (lane r 2) (< 3.75f32 2.5f32)))
        ()))
        ())))

