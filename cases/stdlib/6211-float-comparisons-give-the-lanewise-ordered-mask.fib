(defun nan-lanes (c: Checks) -> unit
  (let ((nan (/ 0.0 0.0)) (a: f64x4 <<1.0 0.0 1.0 -0.0>>f64))
    (let ((b: f64x4 (with-lane (with-lane (splat f64x4 1.0) 0 (/ 0.0 0.0)) 3 0.0)))
      (do (check c (= (lane (simd/lt a b) 0) false)) (check c (= (lane (simd/ge a b) 0) false))
          (check c (= (lane (simd/eq a b) 0) false)) (check c (= (lane (simd/ne a b) 0) true))
          (check c (= (lane (simd/eq a b) 3) true)) (check c (= (lane (simd/lt a b) 3) false))
          (check c (= (lane (simd/eq a b) 2) true)) (check c (= (lane (simd/ne a b) 1) true))
          ()))))

(defun main () -> i64
  (let ((c (checks)))
    (do (cmp-f32-1 c)
        (cmp-f32-3 c)
        (cmp-f32-4 c)
        (cmp-f32-8 c)
        (cmp-f64-1 c)
        (cmp-f64-3 c)
        (cmp-f64-4 c)
        (cmp-f64-8 c)
        (nan-lanes c)
        (checks-result c))))
