        (check c (= (lane r 3) (< -1.25 -1.25)))
        (check c (= (lane r 4) (< 2.5 1.5)))
        (check c (= (lane r 5) (< -2.5 1.0)))
        (check c (= (lane r 6) (< 1.25 1.25)))
        (check c (= (lane r 7) (< -3.75 3.0)))
