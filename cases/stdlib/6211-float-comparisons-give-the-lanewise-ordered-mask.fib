(defun cmp-f32-8 (c: Checks) -> unit
  (let ((a: f32x8 <<-3.75 0.0 3.75 -1.25 2.5 -2.5 1.25 -3.75>>f32) (b: f32x8 <<-3.75 3.0 2.5 -1.25 1.5 1.0 1.25 3.0>>f32))
