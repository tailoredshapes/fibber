        (check c (= (lane r 2) (> 3.75f32 2.5f32)))
        (check c (= (lane r 3) (> -1.25f32 -1.25f32)))
        (check c (= (lane r 4) (> 2.5f32 1.5f32)))
        (check c (= (lane r 5) (> -2.5f32 1.0f32)))
        (check c (= (lane r 6) (> 1.25f32 1.25f32)))
        (check c (= (lane r 7) (> -3.75f32 3.0f32)))
        ()))
        (let ((r (simd/ge a b)))
      (do
        (check c (= (lane r 0) (>= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (>= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (>= 3.75f32 2.5f32)))
        (check c (= (lane r 3) (>= -1.25f32 -1.25f32)))
        (check c (= (lane r 4) (>= 2.5f32 1.5f32)))
        (check c (= (lane r 5) (>= -2.5f32 1.0f32)))
        (check c (= (lane r 6) (>= 1.25f32 1.25f32)))
        (check c (= (lane r 7) (>= -3.75f32 3.0f32)))
        ()))
        (let ((r (simd/eq a b)))
      (do
        (check c (= (lane r 0) (= -3.75f32 -3.75f32)))
        (check c (= (lane r 1) (= 0.0f32 3.0f32)))
        (check c (= (lane r 2) (= 3.75f32 2.5f32)))
        (check c (= (lane r 3) (= -1.25f32 -1.25f32)))
        (check c (= (lane r 4) (= 2.5f32 1.5f32)))
        (check c (= (lane r 5) (= -2.5f32 1.0f32)))
        (check c (= (lane r 6) (= 1.25f32 1.25f32)))
        (check c (= (lane r 7) (= -3.75f32 3.0f32)))
