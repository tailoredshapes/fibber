;; spec:   stdlib §4.3 (row cond), §6.3 (E4); syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: cond
;; Clojure's flat cond: (cond t1 e1 t2 e2 :else d). The tests are tried in order, the first true one
;; answers, and a keyword test is always true, so :else (or any keyword) is the default. A clause is two
;; forms: an expression of several steps is a (do ..).
(ns main (:use tl.check))

(defun grade (n: i64) -> str
  (cond (< n 10) "low"
        (< n 20) "mid"
        (< n 30) "high"
        :else "off"))

(defun sign (n: i64) -> i64
  (cond (< n 0) -1
        (= n 0) 0
        true 1))

(defun main () -> i64
  (let [c (checks)]
    (do (check c (= (grade 5) "low"))
        (check c (= (grade 15) "mid"))
        (check c (= (grade 25) "high"))
        (check c (= (grade 99) "off"))
        (check c (= (sign -4) -1))
        (check c (= (sign 0) 0))
        (check c (= (sign 7) 1))
        (check c (= (cond :else 3) 3))
        (check c (= (cond false 1 :otherwise 2) 2))
        (checks-result c))))
