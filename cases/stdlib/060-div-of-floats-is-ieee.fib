;; spec:   stdlib §2.8 (Division), §4.1 (row /), types §2.12 (fdiv)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: /
;; On f32 and f64 `/` is the Div instance that wraps fdiv, IEEE division at
;; the width, with the result the same type: a zero divisor gives an
;; infinity or a NaN and never a trap. (No float is printed: the text of
;; an infinity is the owner's C12, in flight.)
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0))
        (nan32 (/ 0.0f32 0.0f32)))
    (do (check c (= (/ 1.0 2.0) 0.5))
        (check c (= (/ 7.0 2.0) 3.5))
        (check c (= (/ -7.0 2.0) -3.5))
        (check c (= (/ 1.0 3.0) 0.3333333333333333))
        (check c (= (/ 1.0f32 4.0f32) 0.25f32))
        (check c (= (/ 7.0f32 2.0f32) 3.5f32))
        (check c (= (/ 1.0f32 3.0f32) 0.33333334f32))
        (check c (> (/ 1.0 0.0) 1.7e308))
        (check c (< (/ -1.0 0.0) -1.7e308))
        (check c (> (/ 1.0f32 0.0f32) 3.0e38f32))
        (check c (!= nan nan))
        (check c (!= nan32 nan32))
        (check c (= (/ 0.0 5.0) 0.0))
        (checks-result c))))
