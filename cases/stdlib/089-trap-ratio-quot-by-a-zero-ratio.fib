;; spec:   stdlib §2.8 ((Ratio t): Num)
;; expect: trap
;; trap:   ratio: divide by zero
;; roots:  ../../lib
;; covers: quot
;; quot of a ratio by a zero ratio traps with the ratio's message, not the
;; integer builtin's: the library checks the divisor before it divides.
(ns main (:use fib.core))

(defun main () -> i64
  (numerator (quot (/ 1 2) (/ 0 5))))
