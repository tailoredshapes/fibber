;; spec:   stdlib §5.5 S6, §2.8, §7 L26 (a)
;; expect: accept
;; result: 42
;; audit:  clean
;; Clojure's (+ x 1) for an x of any width: the literal takes the other
;; operand's type (L26 a, landed with LANG-2: by range, types §1.1). It was `cannot unify i64 with i32` (A11 n3c).
(defun succ (x: i32) -> i32 (+ x 1))

(defun main () -> i64 (zext i64 (succ 41i32)))
