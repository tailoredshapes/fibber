;; spec:   stdlib §6.3 (E3); syntax §3.2, §3.3, §3.18
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: let loop fn
;; E3 is additive: the parenthesised let, loop and fn of the syntax spec read as they did, beside the
;; bracket ones, and the two spellings nest in each other.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (f (fn (x y) (+ x y))))
    (do (check c (= (f 1 2) 3))
        (check c (= (let ((a 1) (b: i64 2)) (+ a b)) 3))
        (check c (= (loop ((i 0) (acc 0)) (if (< i 4) (recur (+ i 1) (+ acc i)) acc)) 6))
        (check c (= (let [a 1] (loop ((i a)) (let ((j (+ i 1))) (if (< j 5) (recur j) j)))) 5))
        (check c (= (let ((a 2)) (loop [i a] (if (< i 7) (recur (+ i 1)) i))) 7))
        (checks-result c))))
