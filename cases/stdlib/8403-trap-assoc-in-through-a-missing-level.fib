;; spec: spec/stdlib.md section 4.5 row assoc-in (the deviation: an intermediate level that is missing traps)
;; expect: trap
;; trap: update: no key
;; roots: ../../lib support
(ns main)
(defun main () -> i64
  (let ((m: (Map str (Map str i64)) {"a" {"x" 1}}))
    (count (assoc-in m ["zz" "x"] 9))))
