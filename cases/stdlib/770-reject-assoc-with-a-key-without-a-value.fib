;; spec:   stdlib §4.5 (row assoc), §6.3 (R6a)
;; expect: reject
;; error:  malformed assoc: a key without a value
;; roots:  ../../lib support
;; covers: assoc
;; Clojure's (assoc m k1 v1 k2) is an arity exception; here the expansion
;; refuses it, naming the form: the last key has no value.
(ns main (:use fib.core fib.coll))

(defun main () -> i64
  (count (assoc {} 1 10 2)))
