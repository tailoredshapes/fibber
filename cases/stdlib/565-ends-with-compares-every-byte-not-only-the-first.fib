;; spec:   stdlib §4.7 (row clojure.string/ends-with?), §2.9, plan §6 L10b, MUT-L10b
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.string/ends-with?
;; Found by the mutation review (fibmut, `fib.string.search` line 28: a walk over the suffix that
;; steps two bytes at a time passed every case of 559, because each `not` check there differs from
;; the text at the suffix's first byte). Here the suffix agrees with the end of the text at its
;; first byte and differs at a LATER one: in the middle, at the last byte, and at an odd and an even
;; distance from the start, so a comparison that looks at fewer bytes than the suffix has says true.
;; The same pairs through the equal text (true) show that the checks differ in one byte and nothing
;; else. Characters of two, three and four bytes: "é" (C3 A9) and "ñ" (C3 B1) share their first
;; byte; "€" (E2 82 AC) and "₭" (E2 82 AD) share their first two; "😀" (F0 9F 98 80) and "😁"
;; (F0 9F 98 81) share their first three.
(ns main (:use fib.core tl.check) (:require [fib.string :as str]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (not (str/ends-with? "xab" "aa")))
        (check c (str/ends-with? "xab" "ab"))
        (check c (not (str/ends-with? "abc" "axc")))
        (check c (str/ends-with? "abc" "abc"))
        (check c (not (str/ends-with? "hello" "lxo")))
        (check c (not (str/ends-with? "hello" "llp")))
        (check c (str/ends-with? "hello" "llo"))
        (check c (not (str/ends-with? "abcde" "cxexx")))
        (check c (not (str/ends-with? "zabcdef" "bcdxf")))
        (check c (not (str/ends-with? "zabcdef" "bcxef")))
        (check c (not (str/ends-with? "é" "ñ")))
        (check c (str/ends-with? "é" "é"))
        (check c (not (str/ends-with? "aé" "ñ")))
        (check c (not (str/ends-with? "a€" "a₭")))
        (check c (not (str/ends-with? "a€" "₭")))
        (check c (str/ends-with? "a€" "€"))
        (check c (not (str/ends-with? "😀" "😁")))
        (check c (str/ends-with? "😀" "😀"))
        (check c (not (str/ends-with? "b😀" "😁")))
        (checks-result c))))
