;; spec:   stdlib §2.7 (println-str is Show), §4.3 (row print-method: the type needs both instances), §4.14 (row println-str)
;; expect: reject
;; error:  no implementation of Show for Pt
;; roots:  ../../lib support
;; covers: println-str print-method
;; The other way round from case 2961: a type that defined only `impl Debug` (what `pr` and `prn` print)
;; has no `println-str`, and `(map println-str ps)` says which instance is missing, with the checker's own
;; words. The twin over Show is what the rows `print-str` and `println-str` give, so a program that
;; prints a user type with `prn` and `println` defines both instances.
(ns main)

(defstruct Pt (x: i64 y: i64))
(impl Debug Pt (debug (self) "Pt"))

(defun main () -> i64 (count (map println-str [(Pt 1 2)])))
