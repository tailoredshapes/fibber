;; spec: spec/syntax.md 3.15; wider SIMD accesses require complete unaligned byte ranges
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check))
(defun main () -> i64
  (let ((c (checks)))
    (do (unsafe
          (let ((base (alloc 33)) (p (ptr+ base 1)))
            (do (store-f32x8 p <<0.0f32 1.0f32 2.0f32 3.0f32 4.0f32 5.0f32 6.0f32 7.0f32>>)
                (check c (= (load-f32x8 p) <<0.0f32 1.0f32 2.0f32 3.0f32 4.0f32 5.0f32 6.0f32 7.0f32>>))
                (store-f32 (ptr+ p 28) 9.0f32)
                (check c (= (lane (load-f32x8 p) 7) 9.0f32)) (free base))))
        (checks-result c))))
