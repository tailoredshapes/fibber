;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:7:34: kernel k: the builtin spawn: a kernel allocates nothing, runs no task
;; A kernel runs no task: `spawn` is refused at the call.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)) (t (spawn (fn () 1))))
    (when (< i n) (gpu/f32-set! a i (sitofp f32 (join t))))))
(defun main () -> i64 0)
