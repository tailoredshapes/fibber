;; spec:   design/in-place-update.md §6 T9 (counts), §5 L5, stdlib §2.5, §8.1 item 5 (count cases)
;; expect: accept
;; result: 1007
;; audit:  clean
;; allocs: <= 190
;; roots:  ../../lib support
;; covers: conj
;; The same program as case 4011 with the bound of L5, the shell reuse: a unique `VecOf` that a `conj` takes apart and rebuilds is
;; given its own memory back (design §5, L5), so the 1000 conj allocate only the tail arrays and leaves that every 32 elements need
;; (about 100) and no shell at all: at most 150. Today 2094. OPEN for L5; it also fails after L3 alone (about 1100).
;; LANDED (L8): measured 190, see case 4011 (the shell reuse landed with the in-place paths).
(ns main (:use fib.core fib.seq fib.coll))

;; 1000 conj on a vector that nobody else holds
(defun main () -> i64
  (let ((v (loop ((i 0) (v (vec-empty))) (if (>= i 1000) v (recur (+ i 1) (conj v i))))))
    (+ (count v) (if (> (count v) 7) (nth v 7) 0))))
