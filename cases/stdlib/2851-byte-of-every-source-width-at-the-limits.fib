;; spec:   stdlib §4.3 (row byte), §2.3 (ToByte), §2.8 (conversions are checked; `trunc` wraps)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: byte
;; `(byte x)` over an i8 (itself), an i16, an i32, an i64, an f32 and an f64: 127 and
;; -128 are the limits and are bytes from every source, a float is cut toward zero (so
;; 127.9 and -128.9 are still bytes, which is why the limits of a float are not the
;; limits of the integer), and `(trunc i8 x)` is the wrapping form beside it: 128 and 300
;; wrap where `(byte 128)` traps (cases 2880 to 2884).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (byte 127) 127i8))
        (check c (= (byte -128) -128i8))
        (check c (= (byte 0) 0i8))
        (check c (= (byte 5i8) 5i8))
        (check c (= (byte -128i8) -128i8))
        (check c (= (byte 127i16) 127i8))
        (check c (= (byte -128i16) -128i8))
        (check c (= (byte 127i32) 127i8))
        (check c (= (byte -128i32) -128i8))
        (check c (= (byte 127.0) 127i8))
        (check c (= (byte -128.0) -128i8))
        (check c (= (byte 127.0f32) 127i8))
        (check c (= (byte -128.0f32) -128i8))
        (check c (= (byte 127.9) 127i8))
        (check c (= (byte -128.9) -128i8))
        (check c (= (byte 2.7) 2i8))
        (check c (= (byte -2.7) -2i8))
        (check c (= (byte -0.5) 0i8))
        (check c (= (byte 100) (trunc i8 100)))
        (check c (= (trunc i8 128) -128i8))
        (check c (= (trunc i8 300) 44i8))
        (checks-result c))))
