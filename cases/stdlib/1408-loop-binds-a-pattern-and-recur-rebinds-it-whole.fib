;; spec:   stdlib §7 L7 (patterns in `loop`), syntax §3.18
;; expect: accept
;; result: 5
;; audit:  clean
;; roots:  ../../lib support
;; `(loop (([a b] [1 2]) (n 0)) ..)` binds one loop variable for the vector; `recur` passes the
;; next vector for it whole and the pattern splits it again at the top of the body:
;; [1 2] [2 3] [3 5] [5 8], a is 5 at n = 3.
(ns main (:use fib.core fib.coll))

(defun main () -> i64
  (loop (([a b] [1 2]) (n 0))
    (if (< n 3)
        (recur [b (+ a b)] (+ n 1))
        a)))
