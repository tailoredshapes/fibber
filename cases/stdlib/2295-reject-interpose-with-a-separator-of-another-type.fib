;; spec:   stdlib §4.4 row interpose (e c -> (LSeq e): the separator has the element type)
;; expect: reject
;; error:  cannot unify i64 with str
;; roots:  ../../lib support
;; covers: interpose
;; The separator of interpose is an element of the seq it makes, so it has the type of the source's
;; elements: a string between integers is refused. (Join the strings of mapped integers instead.)
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (count (interpose "a" [1 2])))
