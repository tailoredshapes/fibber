;; spec:   stdlib §4.14 (rows print newline), §2.10; method.md rule 3 (allocs)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 11
;; roots:  ../../lib support
;; covers: print newline prn
;; What a printer writes is not a case's result, but how often it writes is in the
;; free trace: every write of a string allocates its bytes once, and println writes
;; twice (the text, then the newline) where print, pr and newline write once. The
;; bound is the measured count, 11 under both tools, and println in the place of print
;; or newline adds an object per call: the same program with each call replaced by
;; its newline-writing twin (println, println "", prn) allocates 18. The numbers are
;; of the interpreter's trace and of the compiled run's FIB_TRACE=1 trace, which are the
;; same lines (method rule 3). The program writes nothing that is not a whole line.
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (do (print "a")
      (newline)
      (print 7)
      (pr 7)
      (newline)
      (prn 7)
      0))
