;; spec:   stdlib §2.9 (character offsets), §4.3 (row subs)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: subs
;; `subs` takes character offsets, as `count` does: the page's string "aé€😀z"
;; has the characters a é € 😀 z, so (subs s 1 3) is é€, which is five bytes,
;; and (subs s 0 (count s)) is the whole string, where byte offsets would
;; slice it wrongly or trap. The bounds are inclusive at the front and exclusive
;; at the back, an empty range is the empty string at any offset from 0 to the
;; count, and the result is an ordinary string (its byte length and its own
;; count are checked).
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (s "aé€😀z"))
    (do (check c (= (subs s 1 3) "é€"))
        (check c (= (str-len (subs s 1 3)) 5))
        (check c (= (count (subs s 1 3)) 2))
        (check c (= (subs s 0 (count s)) s))
        (check c (= (subs s 0 1) "a"))
        (check c (= (subs s 3 4) "😀"))
        (check c (= (subs s 4 5) "z"))
        (check c (= (subs s 2 4) "€😀"))
        (check c (= (subs s 0 0) ""))
        (check c (= (subs s 5 5) ""))
        (check c (= (subs s 3 3) ""))
        (check c (= (subs "" 0 0) ""))
        (check c (= (subs "hello" 1 4) "ell"))
        (check c (= (subs "hello" 0 5) "hello"))
        (check c (= (subs (subs s 1 4) 1 2) "€"))
        (check c (= (subs "héllo wörld" 6 11) "wörld"))
        (checks-result c))))
