;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: inc dec abs neg zero? pos? neg? max min compare
;; BigInt is a `Num`, `Ord`, `Eq`, `Unit` and `Hash` type, so the library's generic numeric functions work on it
;; unchanged; zero has one representation (-0 is 0, a difference of equals is 0, equal values hash equally).
(ns main (:use tl.check fib.bigint))

(defun main () -> i64
  (let [c (checks)
        p (checks)
        a (bigint "340282366920938463463374607431768211456")
        b (bigint "-340282366920938463463374607431768211456")
        z (bigint 0)]
    (do
      (check c (= (inc a) (bigint "340282366920938463463374607431768211457")))
      (check c (= (dec z) (bigint -1)))
      (check c (= (inc (bigint "-1")) z))
      (check c (= (abs b) a))
      (check c (= (abs a) a))
      (check c (= (neg z) z))
      (check c (= (hash (neg z)) (hash z)))
      (check c (= (hash (- a a)) (hash z)))
      (check c (= (hash (bigint "12345678901234567890")) (hash (bigint "12345678901234567890"))))
      (check c (zero? (- a a)))
      (check c (not (zero? a)))
      (check c (pos? a))
      (check c (neg? b))
      (check c (not (pos? z)))
      (check c (not (neg? z)))
      (check c (< b a))
      (check c (> a b))
      (check c (<= a a))
      (check c (>= a a))
      (check c (= (max a b) a))
      (check c (= (min a b) b))
      (check c (= (compare a b) 1))
      (check c (= (compare b a) -1))
      (check c (= (compare a (+ a z)) 0))
      (check p (= (compare a b) -1))
      (check-detects c p)
      (checks-result c))))
