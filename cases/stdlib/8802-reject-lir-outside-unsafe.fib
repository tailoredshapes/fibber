;; spec:   syntax §3.15a (lir)
;; expect: reject
;; error:  lir may only be used inside unsafe
;; stage:  2
;; roots:  ../../lib support
;; The hoop: a `lir` form is for code that has left the checker's care, and says so by sitting in `unsafe`.
(ns main (:use fib.core))

(defun f (p: ptr) -> i64 (lir [p: ptr] -> i64 "(BLOCK entry (RET (ATOMIC-LOAD ACQUIRE I64 p)))"))

(defun main () -> i64 0)
