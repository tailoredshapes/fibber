;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; The qualifier after the type of the last parameter, and of one in the middle.
(ns main (:use tl.check))

(defn fold2
  ([x: i64 f: (fn (i64) i64) :borrow] -> i64 (f x))
  ([x: i64 f: (fn (i64) i64) :borrow y: i64] -> i64 (+ (f x) y))
  ([x: i64 f: (fn (i64) i64) :borrow y: i64 g: (fn (i64) i64) :borrow] -> i64 (+ (f x) (g y))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (fold2 3 (fn (n) (+ n 1))) 4))
        (check c (= (fold2 3 (fn (n) (+ n 1)) 10) 14))
        (check c (= (fold2 3 (fn (n) (+ n 1)) 10 (fn (n) (* n n))) 104))
        (checks-result c))))
