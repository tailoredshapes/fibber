;; spec:   stdlib §7 L15, syntax §3.19
;; expect: trap
;; trap: def too-big:
;; roots:  ../../lib support
;; covers: def
;; Nothing reads `too-big`; its initialiser overflows an i64 (checked arithmetic traps): it still runs before `main`.
(def seed: i64 9223372036854775807)
(def too-big: i64 (+ seed 1))

(defun main () -> i64 0)
