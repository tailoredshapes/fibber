;; spec:   syntax §3.15a (lir), docs/design/inline-lir.md
;; expect: accept
;; result: 42
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `(lir [p: T ..] -> R "body")` is a call of a function the compiler makes from the lIR text: here an acquire load, which fibber's own atoms (all seq_cst) cannot say. Its operands are the variables of the same names.
(ns main (:use fib.core tl.check))

(defun load-acquire (p: ptr) -> i64
  (unsafe (lir [p: ptr] -> i64 "(block entry (ret (atomic-load acquire i64 p)))")))

(defun main () -> i64
  (unsafe (let [cell (alloc 16)]
            (do (store-i64 cell 41)
                (+ 1 (load-acquire cell))))))
