;; spec:   stdlib §4.3 (row compare), §5.6, Appendix A11 nan
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: compare
;; compare is (if (< a b) -1 (if (< b a) 1 0)), as Clojure's is built on <:
;; so a NaN compares equal to everything, two NaNs 0, and 0.0 and -0.0 are
;; equal. The first five checks are the page's own list [0 0 0 -1 0]. It
;; works on every Ord type (strings by code point: é, U+00E9, is after z).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0)))
    (do (check c (= (compare nan nan) 0))
        (check c (= (compare nan 1.0) 0))
        (check c (= (compare 1.0 nan) 0))
        (check c (= (compare 1.0 2.0) -1))
        (check c (= (compare 0.0 -0.0) 0))
        (check c (= (compare 2.0 1.0) 1))
        (check c (= (compare 3 3) 0))
        (check c (= (compare 2 3) -1))
        (check c (= (compare 3 2) 1))
        (check c (= (compare -9223372036854775807 9223372036854775807) -1))
        (check c (= (compare 3i8 -3i8) 1))
        (check c (= (compare "a" "b") -1))
        (check c (= (compare "b" "a") 1))
        (check c (= (compare "ab" "ab") 0))
        (check c (= (compare "a" "ab") -1))
        (check c (= (compare "z" "é") -1))
        (check c (= (compare \a \b) -1))
        (checks-result c))))
