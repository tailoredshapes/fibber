;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6 (abs traps on the minimum, like neg)
;; expect: trap
;; trap:   integer overflow in abs at i32x4
;; stage:  2
;; roots:  ../../lib support
;; One lane of the vector is the minimum of i32, whose absolute value does not fit: the vector abs traps, as the checked neg does.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i32x4 <<1 -2 3 -2147483648>>i32))
    (do (println (hsum (simd/abs a))) 0)))
