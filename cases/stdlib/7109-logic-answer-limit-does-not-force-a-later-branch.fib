;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (calls (cell 0))
        (answers (l/run 1 (fn (q)
          (l/any [(l/== q (l/integer 1))
                  (l/delay-goal (fn () (do (set! calls (+ @calls 1)) (l/== q (l/integer 2)))))])))))
    (do (check c (= answers [(l/integer 1)]))
        (check c (= @calls 0))
        (checks-result c))))
