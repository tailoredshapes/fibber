;; spec:   stdlib §4.1 (rows bit-and bit-or bit-xor), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bit-and bit-or bit-xor
;; The three bit operations are binary builtins; the macro folds three or more
;; from the left over the builtin: (bit-and a b c) is (bit-and (bit-and a b) c).
;; They are associative, so the answers are the same as any order's; the check
;; is that the fold exists at every width and keeps its type.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m 255))
    (do (check c (= (bit-and 15 7 3) 3))
        (check c (= (bit-and m 126 63 31) 30))
        (check c (= (bit-or 1 2 4 8) 15))
        (check c (= (bit-or 1 2 m) 255))
        (check c (= (bit-xor 5 3 1) 7))
        (check c (= (bit-xor 5 5 5) 5))
        (check c (= (bit-xor 6 3 3 6) 0))
        (check c (= (bit-and 12i8 10i8 14i8) 8i8))
        (check c (= (bit-or 1i16 2i16 4i16) 7i16))
        (check c (= (bit-xor 1i32 3i32 7i32) 5i32))
        (check c (= (bit-and 6 3) 2))
        (checks-result c))))
