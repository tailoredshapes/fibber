;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:7:34: kernel k: the builtin array: a kernel allocates nothing
;; An `array` in a kernel body reaches the allocator: refused at the call, naming the builtin.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)) (v (array 4 0.0f32)))
    (when (< i n) (gpu/f32-set! a i (array-get v 0)))))
(defun main () -> i64 0)
