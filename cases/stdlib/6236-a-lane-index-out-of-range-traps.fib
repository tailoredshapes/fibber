;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   lane index out of range
;; stage:  2
;; roots:  ../../lib support
;; A dynamic index at or above the lane count traps, never a poison read.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: f64x4 <<1.0 2.0 3.0 4.0>>f64) (i (+ 3 (sext i64 (trunc i8 (+ 1 (hsum <<0 0>>i64)))))))
    (do (println (lane a i)) 0)))
