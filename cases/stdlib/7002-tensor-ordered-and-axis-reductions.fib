;; spec: docs/design/numerical-library.md; scalar reductions and empty-axis identities
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (a (t/reshape [2 3] (t/arange 0 6 1))))
    (do (check c (= (t/sum a) 15))
        (check c (= (t/sum (t/transpose a)) 15))
        (check c (= (t/to-vec (t/sum-axis 0 false a)) [3 5 7]))
        (check c (= (t/to-vec (t/sum-axis -1 false a)) [3 12]))
        (check c (= (t/shape (t/sum-axis -1 true a)) [2 1]))
        (check c (= (t/to-vec (t/sum-axis 1 false (t/transpose a))) [3 5 7]))
        (check c (= (t/to-vec (t/sum-axis 0 false (t/flip 0 a))) [3 5 7]))
        (check c (= (t/sum (t/zeros [0])) 0.0))
        (check c (= (t/prod (t/tensor [])) 1.0))
        (check c (= (t/to-vec (t/sum-axis 1 false (t/zeros [3 0]))) [0.0 0.0 0.0]))
        (check c (= (t/shape (t/sum-axis 0 false (t/zeros [3 0]))) [0]))
        (check c (= (t/item (t/sum-axis 0 false (t/tensor-i64 [1 2 3]))) 6))
        (check c (= (t/maximum a) 5))
        (check c (= (t/minimum a) 0))
        (check c (= (t/mean (t/tensor [1.0 2.0 3.0])) 2.0))
        (check c (= (t/fold (fn (acc: i64 x: i64) (+ (* acc 10) x)) 0 (t/tensor-i64 [1 2 3])) 123))
        (check c (= (t/sum (t/full [2] 3i32)) 6i32))
        (check c (= (t/sum (t/full [2] 1.5f32)) 3.0f32))
        (let ((cube (t/reshape [2 3 4] (t/arange 0 24 1))))
          (do (check c (= (t/to-vec (t/sum-axis 1 false cube)) [12 15 18 21 48 51 54 57]))
              (check c (= (t/shape (t/sum-axis 1 true cube)) [2 1 4]))))
        (checks-result c))))
