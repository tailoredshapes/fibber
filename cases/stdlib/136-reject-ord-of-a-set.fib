;; spec:   stdlib §2.7 ("Ord for Vec Pair Triple Option List, not for Map and Set")
;; expect: reject
;; error:  no implementation of Ord for (Set i64)
;; roots:  ../../lib support
;; The same as case 129 for a Set: `Eq` and `Hash` (case 124), no `Ord`.
(ns main (:use fib.seq))

(defun main () -> i64
  (let ((a (conj (set-empty) 1)) (b (conj (set-empty) 2)))
    (if (< a b) 1 0)))
