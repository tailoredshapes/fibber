;; spec:   stdlib §2.7 (a field-less enum shows as its variant's name), §7 L17; types §2.12
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; An enum none of whose variants has a field gets Eq, Ord, Hash and Show from the
;; compilers, so `(derive Eq C)` writes nothing; it gets no Debug or ToStr from
;; them, so `(derive Debug C)` and `(derive ToStr C)` write an instance whose text
;; is the variant's bare name (no module, no braces).
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check))

(defenum Colour Red Green (Blue))
(derive Eq Colour)
(derive Debug Colour)
(derive ToStr Colour)

;; one variant is enough
(defenum Only Solo)
(derive Debug Only)

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (debug Red) "Red"))
        (check c (= (debug Green) "Green"))
        (check c (= (debug Blue) "Blue"))
        (check c (= (to-str Green) "Green"))
        (check c (= (debug Solo) "Solo"))
        (check c (= Red Red))
        (check c (!= Red Blue))
        (checks-result c))))
