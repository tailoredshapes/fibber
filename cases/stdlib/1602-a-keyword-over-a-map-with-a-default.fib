;; spec:   stdlib §7 L14
;; expect: accept
;; result: 1007
;; audit:  clean
;; roots:  ../../lib support
;; covers: :k
;; `(:k m)` over a (Map keyword i64) is the Option `get` gives; `(:k m d)` is the value or the default,
;; and the default is not evaluated into the answer when the key is present: 7 + 1000.
(defun main () -> i64
  (let ((m (assoc (assoc (map-empty) :a 7) :b 8)))
    (+ (+ (:a m 0) (match (:z m) ((some x) x) (nil 1000)))
       (- (:b m 0) 8))))
