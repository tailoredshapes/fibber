;; spec:   stdlib §6.3 (R5: one write), method.md rule 3 (allocs), §4.14 (row print)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 6
;; roots:  ../../lib support
;; covers: print newline
;; (print a b) is one write of the joined text, not one write per argument: the two
;; integers are shown (one text each), joined with the separator by two concats, and
;; written once (the bytes of a write are one object, case 614), then (newline)'s
;; write: 2 + 2 + 1 + 1 = 6 objects under both tools. A macro that wrote each argument
;; and the space apart would allocate more.
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (let ((n 12) (m 345))
    (do (print n m)
        (newline)
        0)))
