;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see); docs/design/vec-performance.md item 2; compiler/expand/fuseinline.fib
;; expect: trap
;; trap:   stage refused 40
;; roots:  ../../lib support
;; covers: mapv
;; A stage put in line by the expander (case 4208) traps as the closure did: at the element that makes it trap (here the 41st, in
;; the second leaf of the Vec), with its own message, after the elements before it and before any after it.
(ns main (:use fib.core fib.seq))

(defun upto (n: i64) -> (Vec i64)
  (loop ((i 0) (acc [])) (if (< i n) (recur (+ i 1) (conj acc i)) acc)))

(defun main () -> i64
  (count (mapv (fn (x: i64) (if (= x 40) (trap (str "stage refused " x)) (* x 2))) (upto 70))))
