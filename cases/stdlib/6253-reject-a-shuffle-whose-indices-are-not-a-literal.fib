;; spec:   types §1.9 (shuffles)
;; expect: reject
;; error:  simd/shuffle: the indices must be a vector literal of integer literals
;; stage:  2
;; roots:  ../../lib support
;; The shuffle mask is a compile-time constant of lIR: indices that are a variable (even one holding a literal) are refused with a message that says what is wanted.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i32x4 <<1 2 3 4>>i32) (idx: (Simd i64 4) <<3 2 1 0>>))
    (let ((s: i32x4 (simd/shuffle a a idx)))
      (do (println (hsum s)) 0))))
