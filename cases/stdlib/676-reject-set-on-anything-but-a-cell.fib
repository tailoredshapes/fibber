;; spec:   stdlib §4.1 (row set!), syntax §3.11 (variables are immutable; set! on anything but a cell is an error)
;; expect: reject
;; error:  cannot unify i64 with (Cell a)
;; roots:  ../../lib
;; covers: set!
;; A variable is immutable: set! stores into a Cell, and a plain binding is no cell. Mutable state is
;; written (cell ..) at the binding, or an atom when tasks share it (syntax §3.11).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x 1))
    (do (set! x 2)
        x)))
