;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (check c (= (g/result-json (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {} g/NullValue "A"))
          "{\"data\":{\"echo\":\"a\"}}"))
        (check c (= (g/result-json (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {"x" (g/StringValue "s")} g/NullValue "A"))
          "{\"data\":{\"echo\":\"s\"}}"))
        (check c (= (g/result-json (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {"x" (g/IntValue 9)} g/NullValue "B"))
          "{\"data\":{\"filter\":\"{\\\"input\\\":{\\\"limit\\\":9,\\\"text\\\":\\\"base\\\"}}\"}}"))
        (check c (= @calls 3))
        (doseq [result [(g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {} g/NullValue "B")
          (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {"x" (g/IntValue 9)} g/NullValue "A")
          (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {"x" (g/StringValue "s")} g/NullValue "B")]]
          (check c (f/request-error? result)))
        ;; Merge decision: an operation name is an Option; "" is not a name, so it selects nothing, even for a single operation.
        (check c (f/request-error? (g/execute-operation schema "{ count }" {} g/NullValue "")))
        (check c (f/request-error? (g/execute-operation schema "query A($x: String = \"a\") { echo(text: $x) } query B($x: Int!) { filter(input: {limit: $x}) }" {} g/NullValue "")))
        (check c (= @calls 3))))) (checks-result c))))
