;; spec:   stdlib §4.14 (rows print pr), §2.10 (the function twins); method.md rule 3 (allocs)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 19
;; roots:  ../../lib support
;; covers: print pr run!
;; Case 614 counts the writes of the macros, which expand in head position to
;; print-str and never reach the function twins. The twins are what a program
;; holds when it passes `print` or `pr` as a value, and they must write once
;; as the macros do: every write of a string allocates its bytes once, and
;; println's twin writes twice (the text, then the newline). The bound is the
;; measured count, and a twin that wrote its newline too, as println does,
;; would add an object per call. What the twins write is not a case's result;
;; the (newline) ends the line the result is read from.
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (do (run! print ["a" "b"])
      (run! pr [7 8])
      (newline)
      0))
