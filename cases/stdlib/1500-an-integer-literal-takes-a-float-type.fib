;; spec:   stdlib §7 L19, types §1.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: *
;; An integer literal in an argument position whose value a float holds exactly takes
;; the float type it unifies with: (* 2 1.5) is 3.0, and (/ x 2) on an f64 is a float
;; division. A literal that unifies with nothing is still an i64 (case 1502 for a
;; variable, which never adopts).
(ns main (:use tl.check))

(defun half (x: f64) -> f64
  (/ x 2))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (* 2 1.5) 3.0))
        (check c (= (+ 1 0.5) 1.5))
        (check c (= (half 5.0) 2.5))
        (check c (= (+ 40 2) 42))
        (checks-result c))))
