;; spec:   stdlib §7 D1, §4.4 (rows sort, sort-with), §5.5 S7
;; expect: reject
;; error:  sort takes 1 argument(s), got 2; use sort-with
;; roots:  ../../lib
;; covers: sort
;; `(sort cmp c)` is `sort-with` until arity overloading lands (§7 L1).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (count (sort > [3 1 2])))
