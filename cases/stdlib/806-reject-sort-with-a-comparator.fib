;; spec:   stdlib §4.4 (rows sort, sort-with), §5.5 S7
;; expect: reject
;; error:  sort takes 1 argument(s), got 2
;; roots:  ../../lib
;; covers: sort
;; `(sort cmp c)` is `sort-with` for now: the Rust fusion tables (expand/fuse/tables.rs) know the head `sort` and
;; `map` but not the clause names `sort$1` and `map$2` that X9's pick gives them, so these clauses wait for them (Y11 report).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (count (sort > [3 1 2])))
