;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see, errors included), tranche 1 plan R9
;; expect: reject
;; error:  cannot unify (fn (i64 i64) bool) with (fn
;; roots:  ../../lib support
;; covers: reduce filter
;; A chain that is wrong is still refused: the predicate of this `filter` takes two arguments and the
;; elements are one at a time. Rewritten into `Filtered`, the error is the same unification, at the
;; position of the predicate in the source (a form the rewrite takes keeps its own position), and
;; says (fn :local ..) where the lazy form said (fn ..) for the function it was compared with.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (reduce (fn (a: i64 x: i64) (+ a x)) 0 (filter (fn (x: i64 y: i64) (> x 1)) [1 2 3])))
