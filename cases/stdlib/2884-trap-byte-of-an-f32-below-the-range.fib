;; spec:   stdlib §4.3 (row byte), §2.8 (conversions are checked)
;; expect: trap
;; trap:   byte: value out of range
;; roots:  ../../lib support
;; covers: byte
;; An f32 source is widened to an f64 (exactly) and tested as one: -129.0 is below an i8.
(defun main () -> i64 (sext i64 (byte -129.0f32)))
