;; spec:   stdlib §7 L7 (a bare pattern item in a fn literal), §7 L3b; tranche 2 plan probe P04
;; expect: accept
;; result: 58
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce
;; `(fn (acc [k v]) ..)` was `a fn parameter is sym or sym: type`. The bare item is sugar for a
;; plain parameter and a `let` of the pattern around the body, so over a vector of vectors it
;; binds the first two elements (2 + 12 + 30 = 44) and over a Map, whose entries are Pairs, it
;; binds the two fields (1 * 2 + 3 * 4 = 14): the same literal, two element types.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((pairs [[1 2] [3 4] [5 6]])
        (m (assoc (assoc (map-empty) 1 2) 3 4)))
    (+ (reduce (fn (acc [k v]) (+ acc (* k v))) 0 pairs)
       (reduce (fn (acc [k v]) (+ acc (* k v))) 0 m))))
