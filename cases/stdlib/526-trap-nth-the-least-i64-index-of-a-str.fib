;; spec:   stdlib §2.9 (nth of a str), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; The least i64 as an index is out of range, with the function's own message:
;; the walk that finds a character's byte must not count a negative index
;; down (it would overflow, and trap as an arithmetic overflow instead).
(ns main (:use fib.core fib.seq))

(defun least () -> i64 (- (- 0 (+ (shl 1 62) (- (shl 1 62) 1))) 1))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (zext i64 (char->i32 (nth s 0)))
       (zext i64 (char->i32 (nth s (least)))))))
