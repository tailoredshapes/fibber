;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg on i16 vectors of [1, 2, 5, 8, 16, 32] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-i16-1 (c: Checks) -> unit
  (let ((a: i16x1 <<-89>>i16) (b: i16x1 <<-93>>i16))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -89i16 -93i16)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -89i16 -93i16)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -89i16 -93i16)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -89i16)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ -89i16 2i16)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7i16 -89i16)))
        ()))
        ())))

