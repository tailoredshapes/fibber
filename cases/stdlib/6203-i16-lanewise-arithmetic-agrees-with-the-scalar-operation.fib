(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: i16x2 <<-89 -52>>i16) (b: i16x2 <<-93 -40>>i16))
    (do (check p (= (lane (+ a b) 1) (- -52i16 -40i16)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-i16-1 c)
        (arith-i16-2 c)
        (arith-i16-5 c)
        (arith-i16-8 c)
        (arith-i16-16 c)
        (arith-i16-32 c)
        (planted c)
        (checks-result c))))
