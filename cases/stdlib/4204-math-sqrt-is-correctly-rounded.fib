;; spec:   stdlib §4.10 (row clojure.math/sqrt)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: math/sqrt
;; sqrt is IEEE-exact: perfect squares come out exact, sqrt 2 is the double nearest the root (compared by bits
;; against 1.4142135623730951), the root of 0.0 is 0.0, of +Infinity is +Infinity, and of a negative is NaN
;; (the only value not equal to itself). Squaring the root of 1e300 loses nothing it should not.
(ns main (:use tl.check) (:require [fib.math :as math]))

(defun main () -> i64
  (let ((c (checks))
        (nan (math/sqrt -1.0)))
    (do (check c (= (math/sqrt 0.0) 0.0))
        (check c (= (math/sqrt 1.0) 1.0))
        (check c (= (math/sqrt 4.0) 2.0))
        (check c (= (math/sqrt 144.0) 12.0))
        (check c (= (math/sqrt 2.0) 1.4142135623730951))
        (check c (= (math/sqrt 0.25) 0.5))
        (check c (= (math/sqrt 1e300) 1e150))
        (check c (> (math/sqrt 1e308) 1e153))
        (check c (not (= nan nan)))
        (check c (> (math/sqrt (/ 1.0 0.0)) 1e308))
        (checks-result c))))
