;; spec:   stdlib §4.4 (rows iterate, nth), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: iterate nth
;; Nth of an index below zero: a walk would look for it for ever, so it is out of range at once, as a Vec's is.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (nth (iterate inc 0) -1))
