;; spec:   stdlib §4.1 (row swap!), Appendix A10 (swap: 30 under both tools), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: swap!
;; (swap! a f x y) is (swap! a (fn (v) (f v x y))): the atom's value and then
;; the extra arguments. (swap! a + 5) on an atom of 25 gives 30, the page's
;; example; a function of the program's own, a literal fn and a function that
;; takes the value last through a closure all work, and the call returns the new
;; value. The two-argument call is the builtin's, so the macro and the builtin
;; coexist.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun add3 (v: i64 x: i64 y: i64) -> i64 (+ v x y))

(defun main () -> i64
  (let ((c (checks))
        (a (atom 25))
        (b (atom 1))
        (v (atom [1])))
    (do (check c (= (swap! a + 5) 30))
        (check c (= @a 30))
        (check c (= (swap! a add3 1 2) 33))
        (check c (= (swap! a (fn (v x y z) (+ v x y z)) 1 1 1) 36))
        (check c (= (swap! a (fn (o) (* o 2))) 72))
        (check c (= (swap! a - 2 2 2) 66))
        (check c (= (swap! b max 5 9) 9))
        (check c (= (swap! b min 4 7 3) 3))
        (check c (= (count (swap! v conj 2 3)) 3))
        (check c (= @v [1 2 3]))
        (checks-result c))))
