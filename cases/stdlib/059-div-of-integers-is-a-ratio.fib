;; spec:   stdlib §2.8 (Division, Q40), §4.1 (row /), §7 L30, Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: /
;; `/` on two integers is exact, as Clojure's: (/ 7 2) is the ratio 7/2 and
;; (/ 6 3) is 2, written the way Clojure writes them (show is the builtin
;; text of the Show instance of Ratio). The result type is fixed by the
;; instance of Div, at every integer width. numerator and denominator are
;; the page's [3 2] for (/ 6 4).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (show (/ 7 2)) "7/2"))
        (check c (= (show (/ 6 3)) "2"))
        (check c (= (show (/ -3 2)) "-3/2"))
        (check c (= (show (/ 1 2)) "1/2"))
        (check c (= (show (/ 0 2)) "0"))
        (check c (= (show (/ 1 3)) "1/3"))
        (check c (= (show (/ (+ 2 3) 2)) "5/2"))
        (check c (= (numerator (/ 6 4)) 3))
        (check c (= (denominator (/ 6 4)) 2))
        (check c (= (show (/ 7i8 2i8)) "7/2"))
        (check c (= (show (/ 7i16 2i16)) "7/2"))
        (check c (= (show (/ 100i32 -8i32)) "-25/2"))
        (check c (= (show (/ 9223372036854775807 2)) "9223372036854775807/2"))
        (checks-result c))))
