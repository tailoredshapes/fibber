;; spec:   syntax §3.15a (lir)
;; expect: reject
;; error:  expected (lir [name: type ..] -> type "body")
;; stage:  2
;; roots:  ../../lib support
;; The shape is the extern's with a body: operands as `name: type`, an arrow, the result type, the lIR text.
(ns main (:use fib.core))

(defun f (p: ptr) -> i64 (unsafe (lir [p: ptr] to i64 "(block entry (ret (i64 0)))")))

(defun main () -> i64 0)
