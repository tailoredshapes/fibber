;; spec:   stdlib §4.14 (rows print-str pr-str println-str prn-str: macros), §2.10 (a macro and its twin coexist), §6.3
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: print-str pr-str println-str prn-str
;; open:   X3
;; In head position the four names are X3's macros: the arguments' texts joined by one space, `println-str`
;; and `prn-str` with the newline of the plan's judge, "`(println-str 1 2)` is `1 2\n`". Until they land
;; the name is the function twin, which takes one argument, so `(println-str 1 2)` is refused with
;; `println-str takes 1 argument(s), got 2`: the failure that keeps this case open. The twin stays in
;; value position after the macro lands (the last two checks, as case 752 does for `str` and `println`), so
;; the macro and the twin are one name each.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (lines (vec (map println-str [1 2]))))
    (do (check c (= (println-str 1 2) "1 2\n"))
        (check c (= (print-str 1 2) "1 2"))
        (check c (= (print-str "a" 1 \b) "a 1 b"))
        (check c (= (pr-str "a" 1 \b) "\"a\" 1 \\b"))
        (check c (= (prn-str "a" 1) "\"a\" 1\n"))
        (check c (= (println-str "a" ["b"]) "a [b]\n"))
        (check c (= (pr-str ["a"] (some "b")) "[\"a\"] \"b\""))
        (check c (= (println-str 5) "5\n"))
        (check c (and (= (count lines) 2) (= (nth lines 1) "2\n")))
        (check c (= (pr-str "q") "\"q\""))
        (checks-result c))))
