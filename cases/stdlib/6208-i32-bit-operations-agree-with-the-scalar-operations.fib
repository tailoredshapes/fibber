;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; bit-and bit-or bit-xor bit-not popcount shl shr sar on i32 vectors equal the scalar operations lane by lane, with random bit patterns and shift counts up to the width plus 4 (a count is masked to the width as the scalar's is).
(ns main (:use fib.core tl.check))

(defun bits-i32-1 (c: Checks) -> unit
  (let ((a: i32x1 <<1281505947>>i32) (b: i32x1 <<-2147200127>>i32) (s: i32x1 <<0>>i32))
    (do (let ((r (bit-and a b)))
      (do
        (check c (= (lane r 0) (bit-and 1281505947i32 -2147200127i32)))
        ()))
        (let ((r (bit-or a b)))
      (do
        (check c (= (lane r 0) (bit-or 1281505947i32 -2147200127i32)))
        ()))
        (let ((r (bit-xor a b)))
      (do
        (check c (= (lane r 0) (bit-xor 1281505947i32 -2147200127i32)))
        ()))
        (let ((r (bit-not a)))
      (do
        (check c (= (lane r 0) (bit-not 1281505947i32)))
        ()))
        (let ((r (popcount a)))
      (do
        (check c (= (lane r 0) (popcount 1281505947i32)))
        ()))
        (let ((r (shl a s)))
      (do
        (check c (= (lane r 0) (shl 1281505947i32 0i32)))
        ()))
        (let ((r (shr a s)))
      (do
        (check c (= (lane r 0) (shr 1281505947i32 0i32)))
        ()))
        (let ((r (sar a s)))
      (do
        (check c (= (lane r 0) (sar 1281505947i32 0i32)))
        ()))
        ())))

