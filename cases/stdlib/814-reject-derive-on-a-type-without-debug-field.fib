;; spec:   stdlib §2.7, §7 L17: a derived Debug needs the Debug of each field
;; expect: reject
;; error:  no implementation of Debug for Inner
;; roots:  ../../lib support
;; Outer derives Debug over a field whose type has no Debug (Inner derives
;; nothing), so the instance is refused when it is checked, naming the field's
;; type: the derive does not paper over a missing instance, and a program cannot
;; print what its author never said how to print.
(ns main (:use fib.core fib.print))

(defstruct Inner (a: i64))
(defstruct Outer (i: Inner))
(derive Debug Outer)

(defun main () -> i64
  (if (= (debug (Outer (Inner 1))) "") 1 0))
