;; spec:   stdlib §5.5 S5, §2.7, §7 L24 (joins and families)
;; expect: accept
;; result: 1
;; audit:  clean
;; roots:  ../../lib support
;; open:   L24
;; Clojure's (= [1] (list 1)) is true: two sequential collections are equal
;; when their elements are. `=` has one type today: `cannot unify (Vec
;; i64) with (List i64)`; L24 elaborates it to a sequence comparison when
;; both operands are of one family (A11 n4). Eq of a Vec is L3's, loaded here
;; by fib.seq, so the refusal is the family rule's alone, and the case stays
;; open until that has landed.
(ns main (:use fib.seq))

(defun main () -> i64
  (if (= [1] (list 1)) 1 0))
