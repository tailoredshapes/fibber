;; spec:   stdlib §7 D1, §4.4 (rows range, range-by), §5.5 S7
;; expect: reject
;; error:  range takes 1 argument(s), got 3; use range-by
;; roots:  ../../lib
;; covers: range
;; `(range a b step)` is `range-by` until arity overloading lands (§7 L1). The
;; prelude macro `range` rewrites `(range a b)` and leaves the three-argument call
;; alone, so the arity error is the library function's and says what to write.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (count (range 0 10 2)))
