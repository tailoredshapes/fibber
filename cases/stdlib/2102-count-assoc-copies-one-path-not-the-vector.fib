;; spec:   stdlib §2.5 (assoc copies the path), §8.1 item 5 (count cases), task P1 item 1
;; expect: accept
;; result: 197
;; audit:  clean
;; allocs: <= 429
;; roots:  ../../lib support
;; covers: assoc
;; 100 assocs, alternately at index 40 (in the trie, under a root of 32 leaves) and at 1050 (in the tail), of a
;; Vec of 1056 built by the bulk builder. Measured by the interpreter's count: building the vector and the two
;; reads at the end are 79 objects (the same run with no assoc), so the 100 assocs are 350, 3.5 each: an assoc in the
;; tail is 2 objects (the copy of the tail and the new header), one in the trie of two levels is 5 (the path's two
;; arrays and two nodes, and the header). 200 assocs measure 779, 3.5 each again: a constant, not a function of the
;; size. The Vec instance of assoc before vec-assoc rebuilt the vector, and the same run allocated 220979 (measured by
;; putting that instance back), so the bound fails by a factor of five hundred.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (vec (range 1056))))
    (loop ((w v) (k 0))
      (if (< k 100)
          (recur (assoc w (if (= (rem k 2) 0) 40 1050) k) (+ k 1))
          (+ (nth w 40) (nth w 1050))))))
