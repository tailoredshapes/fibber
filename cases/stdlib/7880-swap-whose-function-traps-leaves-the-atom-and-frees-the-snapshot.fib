;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 5
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Test 10 of the design: swap!'s function traps; the atom keeps its value, the snapshot swap! held and the function's own argument are
;; freed, no lock is left held (the second swap! succeeds). Killed by: scripts/mutant-catch.sh `swap-keeps-snapshot` (the snapshot's count
;; is not released: a leak).
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (let ((a (atom [1 2 3])))
    (let ((r (try (do (swap! a (fn (v: (Vec i64)) (if (= (count v) 3) (trap "swap refused") v))) 0)
                  (catch e 1))))
      (do (swap! a (fn (v: (Vec i64)) (conj v 4)))
          (+ r (count @a))))))
