;; spec:   stdlib §4.4 row distinct (Hash e, Eq e), §2.1 rule 2
;; expect: reject
;; error:  no implementation of Hash for P
;; roots:  ../../lib support
;; covers: distinct
;; distinct keeps a set of what it has seen, so its element type needs Hash and Eq. A struct that
;; derives neither is refused at the call, with the type named; with (derive Hash P) and (derive Eq P)
;; the same program is accepted.
(ns main (:use fib.core fib.seq))

(defstruct P (x: i64))

(defun main () -> i64
  (count (distinct [(P 1) (P 2)])))
