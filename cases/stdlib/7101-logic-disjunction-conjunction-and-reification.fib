;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do
      (check c (= (l/run 3 (fn (q) (l/any [(l/== q (l/integer 1)) (l/== q (l/integer 2))]))) [(l/integer 1) (l/integer 2)]))
      (check c (= (l/run 1 (fn (q) (l/all []))) [(l/Var 0)]))
      (check c (= (l/run 1 (fn (q) (l/any []))) []))
      (check c (= (l/run-many 1 2 (fn (qs) (l/== (nth qs 0) (nth qs 1)))) [[(l/Var 0) (l/Var 0)]]))
      (check c (= (l/run-many 1 2 (fn (qs) (l/all []))) [[(l/Var 0) (l/Var 1)]]))
      (check c (= (l/run 1 (fn (q) (l/call-fresh (fn (x) (l/== q (l/pair x x)))))) [(l/pair (l/Var 0) (l/Var 0))]))
      (checks-result c))))
