;; spec:   design/in-place-update.md §6 T9 (counts), §5 L4, stdlib §2.5, §8.1 item 5 (count cases)
;; expect: accept
;; result: 1753
;; audit:  clean
;; allocs: <= 8936
;; roots:  ../../lib support
;; open:   L4
;; covers: assoc get
;; A Map of 1000 integer keys (the fill allocates 7936 objects, counted with `fibc run --trace`: the A lines with no assoc after it), then
;; 1000 `assoc` of keys that are present, the map held by one name. Today each update copies the path of the trie and builds the
;; entry again: 16936 objects in all, 9 per assoc. L4 updates the existing key in place when the map is unique (design §5) and descends
;; by `array-take!`: at most one object per update (the new entry) is the bound, 7936 + 1000. A new key stays a copy of the level it joins and
;; is not counted here. OPEN for L4.
(ns main (:use fib.core fib.seq fib.coll))

(defun fill (n: i64) -> (Map i64 i64)
  (loop ((k 0) (m (map-empty))) (if (< k n) (recur (+ k 1) (assoc m k 0)) m)))

;; 1000 assoc of keys the map already has, on a map that nobody else holds
(defun main () -> i64
  (let ((m (loop ((i 0) (m (fill 1000))) (if (>= i 1000) m (recur (+ i 1) (assoc m (rem (* i 7919) 1000) i))))))
    (+ (count m) (match (get m 7) ((some x) x) (nil -1)))))
