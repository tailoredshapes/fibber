;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check fib.logic))

(defun appendo (x: l/Term y: l/Term z: l/Term) -> l/Goal
  (l/conde
    [(l/== x (l/nil-term)) (l/== y z)]
    [(l/fresh [h tail rest]
       (l/== x (l/pair h tail))
       (l/== z (l/pair h rest))
       (l/zzz (appendo tail y rest)))]))

(defun main () -> i64
  (let ((c (checks)) (input (l/list-term [(l/integer 1) (l/integer 2)])))
    (do
      (check c (= (l/run 1 (fn (q) (l/fresh [x y] (l/== x (l/integer 7)) (l/== y x) (l/== q y)))) [(l/integer 7)]))
      (check c (= (l/run 3 (fn (q) (l/conde [(l/== q (l/integer 1))] ((l/== q (l/integer 2)))))) [(l/integer 1) (l/integer 2)]))
      (check c (= (l/run 1 (fn (q) (l/conde))) []))
      (check c (= (l/run 1 (fn (q) (l/fresh [] (l/== q (l/symbol "yes"))))) [(l/symbol "yes")]))
      (check c (= (l/run 1 (fn (q) (l/fresh [tail] (appendo q tail input) (l/== tail (l/list-term [(l/integer 2)]))))) [(l/list-term [(l/integer 1)])]))
      (checks-result c))))
