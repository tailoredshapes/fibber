;; spec:   stdlib §4.4 (row repeat), §2.1 rules 1 and 3
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: repeat take vec nth first reduce every?
;; (repeat x) is x for ever. Taken, folded, found at an index and tested, it stops where the
;; consumer stops; the element is any value: a string and a Vec are shared by every
;; element, not copied, and the run ends with a clean audit. `nth` of any index
;; is the element (no walk), `first` is the element, and a fold of the first four of a repeated 3
;; is 12. The (repeat n x) clause, an LSeq of n copies, is Y11's (L1), not read here.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (vec (take 3 (repeat "ab"))) ["ab" "ab" "ab"]))
        (check c (= (str-join (vec (take 3 (repeat "ab")))) "ababab"))
        (check c (= (vec (take 2 (repeat [1 2]))) [[1 2] [1 2]]))
        (check c (= (nth (repeat "x") 1000) "x"))
        (check c (= (first (repeat 7)) (some 7)))
        (check c (= (reduce (fn (a x) (+ a x)) 0 (take 4 (repeat 3))) 12))
        (check c (every? (fn (x: i64) (= x 3)) (take 50 (repeat 3))))
        (check c (not (every? (fn (x: i64) (< x 3)) (repeat 3))))
        (checks-result c))))
