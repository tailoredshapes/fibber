;; spec:   stdlib §5.5 S8, §2.11, §7 L15 (def initialisers)
;; expect: accept
;; result: 3
;; audit:  clean
;; Clojure's (def counter (atom 0)): a top-level atom, the commonest
;; global. Today the initialiser of a def must be a constant: `def
;; counter: initialiser is not a constant expression` (A11 t56). An Atom
;; is Send, so L15 allows it; a def may not hold a Cell (stdlib §5 M1).
(def counter: (Atom i64) (atom 0))

(defun main () -> i64
  (do (swap! counter (fn (x) (+ x 1)))
      (swap! counter (fn (x) (+ x 2)))
      @counter))
