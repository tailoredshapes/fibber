;; spec:   stdlib §2.3 (Unit: i8..i64, f32, f64), §4.3 (row inc: Num t, Unit t)
;; expect: reject
;; error:  no implementation of Num for char
;; roots:  ../../lib
;; covers: inc
;; inc needs Num and Unit, and a char has neither (Clojure's (inc \a) is a
;; ClassCastException): the program is refused when it is compiled. The
;; checker names Num, the first of the two bounds it fails to solve; the
;; missing Unit instance is case 091. (The plan expected the Unit text
;; here: it is what a type with Num and no Unit gets.)
(ns main (:use fib.core))

(defun main () -> i64
  (let ((c (inc \a)))
    0))
