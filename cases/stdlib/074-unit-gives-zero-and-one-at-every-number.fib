;; spec:   stdlib §2.3 (Unit), §4.3 (row Unit)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Unit zero? pos? neg? inc dec abs mod
;; (zero x) and (one x) take a value of the type as witness. P0's case 009
;; reads them at the six builtin widths; the ratio, which the library adds,
;; has an instance too, so every function written over Unit works on a
;; ratio: zero? pos? neg? inc dec abs and mod, with the ratio arithmetic
;; the ratios have (the page's mod over -7/2 and 3 is 5/2).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (zero (/ 3 4)) (/ 0 1)))
        (check c (= (one (/ 3 4)) (/ 1 1)))
        (check c (= (show (zero (/ 3 4))) "0"))
        (check c (= (show (one (/ 3 4))) "1"))
        (check c (= (zero 7i8) 0i8))
        (check c (= (one 7) 1))
        (check c (= (one 0.5f32) 1.0f32))
        (check c (zero? (/ 0 3)))
        (check c (not (zero? (/ 1 3))))
        (check c (pos? (/ 1 3)))
        (check c (neg? (/ -1 3)))
        (check c (not (pos? (/ -1 3))))
        (check c (= (show (inc (/ 1 2))) "3/2"))
        (check c (= (show (dec (/ 1 2))) "-1/2"))
        (check c (= (show (abs (/ -3 4))) "3/4"))
        (check c (= (show (abs (/ 3 4))) "3/4"))
        (check c (= (show (mod (/ 7 2) (/ 3 1))) "1/2"))
        (check c (= (show (mod (/ -7 2) (/ 3 1))) "5/2"))
        (check c (= (show (mod (/ 7 2) (/ -3 1))) "-5/2"))
        (checks-result c))))
