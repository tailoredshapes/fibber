;; spec: spec/types.md 1.9 (scalar-generic chunk): `(size-of a)` in a function generic over `a` puts `(Num a)` on it and is the byte width of the type `a` is at each instance
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; One generic function returns the size of its argument's type and another the span of n elements of it; they are called at f32, f64, i8 and i32 and must give 4, 8, 1 and 4
;; (an emitter that used one size for every instance, or 8 for f32, fails). The exit code is the bit of the first wrong call.
(ns main)

(defun sz (x: a) -> i64 (size-of a))
(defun span (x: a n: i64) -> i64 (* n (size-of a)))

(defun bad (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (bad (= (sz 1.5f32) 4) 1)
     (bad (= (sz 1.5) 8) 2)
     (bad (= (sz 3i8) 1) 4)
     (bad (= (sz 3i32) 4) 8)
     (bad (= (span 1.5f32 10) 40) 16)
     (bad (= (span 1.5 10) 80) 32)
     (bad (= (span 3i8 10) 10) 64)))
