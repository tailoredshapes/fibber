;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; lane and with-lane with a loop variable as the index, for every element type and several lane counts: the lane read equals the element of the reference vector, a lane written reads back, and the other lanes are untouched (hsum). Out-of-range indexes trap: cases 6234 and 6235.
(ns main (:use fib.core fib.coll tl.check))

(defun lanes-f32-1 (c: Checks) -> unit
  (let ((a: f32x1 <<-3.75>>f32) (ref: (Vec f32) [-3.75f32]) (z 0.0f32))
    (loop ((i 0) (v a))
      (if (< i 1)
          (do (check c (= (lane a i) (nth ref i)))
              (check c (= (lane (with-lane a i z) i) z))
              (check c (= (hsum (with-lane a i z)) (+ (- (hsum a) (nth ref i)) z)))
              (recur (+ i 1) v))
          ()))))

