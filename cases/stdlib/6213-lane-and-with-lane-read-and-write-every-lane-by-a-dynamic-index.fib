(defun main () -> i64
  (let ((c (checks)))
    (do (lanes-f32-1 c)
        (lanes-f32-3 c)
        (lanes-f32-4 c)
        (lanes-f32-8 c)
        (lanes-f64-1 c)
        (lanes-f64-3 c)
        (lanes-f64-4 c)
        (lanes-f64-8 c)
        (lanes-i8-1 c)
        (lanes-i8-3 c)
        (lanes-i8-4 c)
        (lanes-i8-8 c)
        (lanes-i16-1 c)
        (lanes-i16-3 c)
        (lanes-i16-4 c)
        (lanes-i16-8 c)
        (lanes-i32-1 c)
        (lanes-i32-3 c)
        (lanes-i32-4 c)
        (lanes-i32-8 c)
        (lanes-i64-1 c)
        (lanes-i64-3 c)
        (lanes-i64-4 c)
        (lanes-i64-8 c)
        (checks-result c))))
