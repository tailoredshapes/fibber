;; spec: fib.os.net (explicit latency-sensitive socket policy)
;; expect: accept
;; result: 42
;; audit: clean
;; stage: 2
;; roots: ../../lib
(ns main (:use fib.core) (:require [fib.os.net :as net] [fib.os.io :as io] [fib.os.abi :as abi]))
(extern getsockopt (i32 i32 i32 ptr ptr) -> i32)
(defun bit (fd: i64) -> i64
  (unsafe (let [value (alloc 4) size (alloc 4)]
    (do (store-i32 size 4i32)
      (let [rc (getsockopt (trunc i32 fd) (trunc i32 (. abi/host tcp-level)) (trunc i32 (. abi/host tcp-no-delay)) value size)
            out (if (= rc 0i32) (sext i64 (load-i32 value)) -1)]
        (do (free value) (free size) out))))))
(defun main () -> i64
  (match (net/listen-tcp "127.0.0.1" 0 8)
    ((Err _) 0)
    ((Ok listener) (match (net/connect-tcp "127.0.0.1" (. listener port) 1000)
      ((Err _) (do (io/close-fd (. listener fd)) 0))
      ((Ok fd) (let [on (net/set-tcp-nodelay fd true) yes (bit fd) off (net/set-tcp-nodelay fd false) no (bit fd)
                    bad (net/set-tcp-nodelay -1 true)]
        (do (io/close-fd fd) (io/close-fd (. listener fd))
            (if (and (= yes 1) (= no 0) (match on ((Ok _) true) (_ false)) (match off ((Ok _) true) (_ false))
                     (match bad ((Err _) true) (_ false))) 42 0))))))))
