;; spec:   syntax §5 (implicit modules), stdlib §6.2, §8.3 C
;; expect: accept
;; result: 0
;; audit:  clean
;; covers: count map sort str get into println
;; A program with no `ns` form and no `:use` sees the library: `fib.core`, `fib.seq`,
;; `fib.coll` and `fib.print` are the implicit modules, as the prelude is. `count`,
;; `map`, `sort`, `str`, `get`, `into` and `println` all resolve, with the library's
;; meaning (a seq, an Option, a ratio-free `inc`), and the answer is the mask of the
;; checks that failed.
(defun miss (bit: i64 ok: bool) -> i64 (if ok 0 bit))

(defun main () -> i64
  (do (println "the library is implicit")
      (+ (miss 1 (= (count [1 2 3]) 3))
         (+ (miss 2 (= (vec (map inc [1 2 3])) [2 3 4]))
            (+ (miss 4 (= (vec (sort [3 1 2])) [1 2 3]))
               (+ (miss 8 (= (str "a" 1) "a1"))
                  (+ (miss 16 (= (get {1 10} 1) (some 10)))
                     (miss 32 (= (into [] (range 3)) [0 1 2])))))))))
