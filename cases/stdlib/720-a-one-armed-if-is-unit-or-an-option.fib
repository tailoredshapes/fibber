;; spec:   stdlib §4.2 (row if), §2.4, §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: if
;; Clojure's (if c a): the else arm may be left out. The value is unit when
;; the arm is unit and `(Option T)` with `some` around the arm otherwise,
;; so (if c 5) is `(some 5)` or nil. Today `if` takes exactly three
;; operands: `malformed if: wrong number of operands`, for both.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (n (cell 0)))
    (do (if (> 2 1) (set! n 5))
        (if (> 1 2) (set! n 99))
        (check c (= @n 5))
        (check c (match (if (> 2 1) 5) ((some x) (= x 5)) (nil false)))
        (check c (match (if (> 1 2) 5) ((some _) false) (nil true)))
        (checks-result c))))
