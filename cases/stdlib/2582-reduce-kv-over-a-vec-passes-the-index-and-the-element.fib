;; spec:   stdlib §4.4 row reduce-kv, §2.3 (KeyReducible: Vec, index and element)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce-kv
;; The Vec's keys are its indexes, in order: f gets the accumulator, the index (0 first) and the element. A sum of index times
;; element over [5 6 7] is 0 + 6 + 14 = 20, and a fold that depends on the order, a number whose digits are each element plus its
;; index, 10 a step, over [5 5 5] gives 5, then 56, then 567: it is 567 only if the walk goes from index 0 to the last, once
;; each. The accumulator may be of another type than the elements: a Vec of the pairs (index, element) built by conj.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (reduce-kv (fn (acc i x) (+ acc (* i x))) 0 [5 6 7]) 20))
        (check c (= (reduce-kv (fn (acc i x) (+ (* acc 10) (+ x i))) 0 [5 5 5]) 567))
        (check c (= (reduce-kv (fn (acc i x) (conj acc (Pair i x))) (vec-empty) [7 8 9])
                    [(Pair 0 7) (Pair 1 8) (Pair 2 9)]))
        (check c (= (reduce-kv (fn (acc i x) (+ acc 1)) 0 [1 2 3 4 5]) 5))
        (check c (= (reduce-kv (fn (acc i x) (+ acc i)) 0 (vec (range 100))) 4950))
        (checks-result c))))
