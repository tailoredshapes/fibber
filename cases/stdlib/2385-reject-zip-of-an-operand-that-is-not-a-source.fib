;; spec:   stdlib §4.4 row zip (`Reducible c1 x, Reducible c2 y`), §2.1 rule 1
;; expect: reject
;; error:  no implementation of Reducible for i64
;; roots:  ../../lib support
;; covers: zip
;; The operands of `zip` are sources: a number is none, and the checker names the missing instance rather than treating the
;; operand as a one-element collection (Clojure's `(map vector 5 [1])` throws at run time, "Don't know how to create ISeq from:
;; java.lang.Long", recalled and not run: here it is refused before the program runs, for the same reason).
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (count (zip 5 [1 2])))
