;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int
;; The range is checked before the float is cut, as Clojure's intCast does: 2147483647.0 is an int (case
;; 2857), 2147483647.9 is not although it would cut to 2147483647.
(defun main () -> i64 (sext i64 (int 2147483647.9)))
