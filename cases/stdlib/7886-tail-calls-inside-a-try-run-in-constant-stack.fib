;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 10000007
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A program that catches compiles its functions to return a failure next to their value; tail calls still jump: ten million tail calls
;; inside a try, one returning an integer and one an unboxed option (whose failure travels in a slot, not in the result), finish without
;; growing the stack. Killed by: a convention that turns those tail calls into calls (a stack overflow).
(ns main (:use fib.core fib.ex))

(defun count-down (n: i64 acc: i64) -> i64 (if (= n 0) acc (count-down (- n 1) (+ acc 1))))
(defun find-at (n: i64) -> (Option i64) (if (= n 0) (some 7) (find-at (- n 1))))

(defun main () -> i64
  (try (+ (count-down 10000000 0) (unwrap-or (find-at 10000000) 0))
       (catch e -1)))
