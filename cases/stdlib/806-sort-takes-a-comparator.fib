;; spec:   stdlib §4.4 (row sort: the overloads by arity, L1), §5.5 S7
;; expect: accept
;; result: 321
;; audit:  clean
;; roots:  ../../lib
;; covers: sort
;; `(sort cmp c)` is the second clause of `sort` (`sort$2`; `(sort c)` is `sort$1`). `>` is a predicate comparator: the
;; sorted [3 1 2] is [3 2 1], read as a number.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((s (sort > [3 1 2])))
    (+ (* 100 (nth s 0)) (* 10 (nth s 1)) (nth s 2))))
