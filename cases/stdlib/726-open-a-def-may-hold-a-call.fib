;; spec:   stdlib §4.2 (row def), syntax §3.19, §7 L15
;; expect: accept
;; result: 0
;; audit:  clean
;; open:   L15
;; roots:  support
;; covers: def
;; After L15 the initialiser of a `def` is any expression, evaluated once
;; before `main` in module order: a call of a function, a computation over
;; an earlier constant (case 907 is an atom). Today the initialiser must be
;; a constant expression: `def limit: initialiser is not a constant
;; expression`.
(ns main (:use tl.check))

(defun twice (n: i64) -> i64 (* n 2))

(def limit: i64 (twice 500))
(def bigger: i64 (+ limit 1))
(def table: (Vec i64) (conj (conj [] 1) (twice 3)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= limit 1000))
        (check c (= bigger 1001))
        (check c (= (nth table 1) 6))
        (checks-result c))))
