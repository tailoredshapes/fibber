;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; A start past the count is out of range, and that is checked before the
;; order of the two bounds: (subs s 5 4) has a start after its end too, but
;; 5 is outside "aé€" (three characters, so offset 3 is its end and is fine),
;; and the message says so, not "start after end".
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 3 3))
       (count (subs s 5 4)))))
