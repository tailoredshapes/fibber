;; spec:   stdlib §6.2 (layout: facades), syntax §5 (:export-from)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; fib.seq and fib.coll are facades: each re-exports the names of its
;; parts. One module reaches both through aliases (s/count of the first,
;; c/get of the second) and, in the same module, a name of fib.core
;; unqualified; the names of a part are the facade's, never the part's.
(ns main (:use fib.core tl.check)
         (:require [fib.seq :as s] [fib.coll :as c]))

(defun main () -> i64
  (let ((k (checks))
        (v [1 2 3]))
    (do (check k (= (s/count v) 3))
        (check k (= (s/nth v 1) 2))
        (check k (match (c/get v 2) ((some x) (= x 3)) (nil false)))
        (check k (= (s/count (c/empty v)) 0))
        (check k (= (s/count (c/conj v 4)) 4))
        (check k (truthy? (c/get v 0)))
        (checks-result k))))
