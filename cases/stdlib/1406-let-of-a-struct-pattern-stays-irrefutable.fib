;; spec:   stdlib §7 L8 (an irrefutable pattern is unchanged: no trap clause, so no redundant clause); probe P05b
;; expect: accept
;; result: 17
;; audit:  clean
;; roots:  ../../lib support
;; A `let` of a struct pattern is not refutable, so the checker keeps it a plain `let` and the
;; exhaustiveness check never sees a clause after it. A refutable binding next to it (a Pair
;; read as [a b]) is the match with a trap clause that the rewrite adds; the one after it is
;; a plain `let` again.
(defstruct Point (x: i64 y: i64))

(defun main () -> i64
  (let (((Point x y) (Point 3 4))
        ([a b] (Pair 5 2))
        ((Point u _) (Point 0 0)))
    (+ (+ x y) (+ (* a b) u))))
