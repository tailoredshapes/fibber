;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g]))
(defun main () -> i64
  (let [c (checks) text (g/named "String")
        valid (g/schema {"User" (g/object-type {"name" (g/field text) "friend" (g/field (g/named "User"))})}
          {"user" (g/field (g/named "User"))})]
    (do (check c (match (g/compile-schema valid) ((Ok _) true) (_ false)))
      (doseq [bad [(g/schema {} {})
        (g/schema {} {"bad" (g/field (g/named "Missing"))})
        (g/schema {} {"__reserved" (g/field text)})
        (g/schema {} {"bad" (g/field (g/non-null (g/non-null text)))})
        (g/schema {} {"bad" (with (g/field text) (arguments {"n" (with (g/argument (g/named "Int")) (default-value (some (g/StringValue "x"))))}))})]]
        (check c (match (g/compile-schema bad) ((Err errors) (> (count errors) 0)) (_ false))))
      (checks-result c))))
