;; spec:   stdlib §4.4 (row for), §6.3 (D2)
;; expect: reject
;; error:  malformed for: :while after :let is not supported; write it before the :let
;; roots:  ../../lib support
;; covers: for
;; A :while ends the whole level, which a guard inside the level's function cannot say, and a :while before
;; the :let cannot see the let's names; the macro refuses the one form it cannot expand rather than cut the
;; seq in the wrong place.
(ns main (:use tl.check))

(defun main () -> i64
  (count (for [x [1 2 3] :let [y (* x x)] :while (< y 5)] y)))
