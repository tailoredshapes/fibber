;; spec:   stdlib §4.10 (row clojure.math/to-int-exact), §4.3 (row int)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.math/to-int-exact
;; `clojure.math/to-int-exact` is `(int x)` over an i64: the checked narrowing, the same
;; function (not an alias of `trunc`). Every i32 is an int from an i64, at the two limits and
;; either side of zero, and the result is an i32. The two values just outside trap
;; (cases 2889 and 2890).
(ns main (:use tl.check))

;; the narrowing a program of Clojure's `(math/to-int-exact n)` writes
(defun to-int-exact (n: i64) -> i32 (int n))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (to-int-exact 2147483647) 2147483647i32))
        (check c (= (to-int-exact -2147483648) -2147483648i32))
        (check c (= (to-int-exact 0) 0i32))
        (check c (= (to-int-exact 1) 1i32))
        (check c (= (to-int-exact -1) -1i32))
        (check c (= (to-int-exact 65536) 65536i32))
        (check c (= (to-int-exact 2147483646) 2147483646i32))
        (check c (= (to-int-exact -2147483647) -2147483647i32))
        (check c (= (sext i64 (to-int-exact 123456789)) 123456789))
        (checks-result c))))
