;; spec:   stdlib §5 M1, §9.2 Q41, §7 L15
;; expect: reject
;; error: def s: a def may not hold a Cell or a Weak
;; roots:  ../../lib support
;; covers: def
;; An LSeq holds a Cell (the realisation of a node), so a global lazy seq
;; waits for the run-once cell of C9 (Q41): rejected by the same test.
(ns main (:use fib.core fib.seq))

(def s: (LSeq i64) (lazy-node (fn () LNil)))

(defun main () -> i64 0)
