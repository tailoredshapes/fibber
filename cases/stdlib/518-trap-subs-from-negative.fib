;; spec:   stdlib §4.3 (rows subs subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; A negative offset is out of range for subs as for subs.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 0))
       (count (subs s (- 0 1))))))
