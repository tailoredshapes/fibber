;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int clojure.math/to-int-exact
;; The first i64 below an i32: -2147483648 is an int, -2147483649 is not.
(defun main () -> i64 (sext i64 (int -2147483649)))
