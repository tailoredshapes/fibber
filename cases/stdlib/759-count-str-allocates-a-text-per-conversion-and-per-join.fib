;; spec:   stdlib §6.3 (R5: the fold), method.md rule 3 (allocs), §4.14 (row str)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 5
;; roots:  ../../lib support
;; covers: str
;; (str "a=" n "," m) is a right fold of str-concat over its pieces: the two integers are
;; converted (one text each), a string literal is used as it is (no call), and the
;; three joins allocate one text each: 2 + 3 = 5 objects under both tools (the A lines of
;; the free trace). An expansion that copied a piece, converted a string literal
;; through a function that allocates, or evaluated an argument twice would cost more.
;; The bound is the measured count; the harness lowers it by one and requires the
;; failure (a_stdlib_count_bound_one_below_the_count_fails).
(ns main (:use fib.core fib.seq fib.print))

(defun main () -> i64
  (let ((n 12) (m 345)
        (s (str "a=" n "," m)))
    (if (= s "a=12,345") 0 1)))
