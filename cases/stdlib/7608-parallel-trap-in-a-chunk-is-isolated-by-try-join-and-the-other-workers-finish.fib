;; spec:   docs/design/parallelism.md 3.2, docs/design/exceptions.md 8; lib/fib/parallel/chunks.fib
;; expect: accept
;; result: 0
;; audit:  abandoned
;; leaks:  83
;; stage:  2
;; roots:  ../../lib support
;; A task that runs a pmap whose chunk traps is itself a task that trapped: `try-join` returns the original message, and the siblings of the
;; failing chunk were joined first (the effects of the other workers, counted in an atom, are visible: at least 8 chunks ran). `pfor` and a
;; `pfold-chunks` do the same. What the trapped tasks owned is abandoned (stage 1 of exceptions): 83 objects here, the same on every run
;; (the captured vectors, closures and chunk results of the tasks that trapped, two levels of them for each of the three calls, and, since
;; P-count-b, the private copy of the closure that the chunk of a pmap and the chunk of a pfor were calling: 86 before, 88 with those; 83
;; since P-sched, where a chunk runs in a pool task (rt/sched.lir) whose runner puts each result in a shared slot vector as it goes, so the
;; runner that traps holds only the chunk it was in, whichever chunks it ran before).
(ns main (:use fib.core fib.async fib.parallel tl.check))

(defun msg (r: (Result i64 Trap)) -> str (match r ((Err t) (. t message)) ((Ok v) "no trap")))

(defun main () -> i64
  (let [c (checks)
        ran (atom 0)
        r1 (try-join (spawn (fn () (vec-count (pmap (Par 4 1 false)
                                       (fn (x) (do (swap! ran inc) (if (= x 3) (trap "chunk 3 failed") x)))
                                       (vec (range 10)))))))
        r2 (try-join (spawn (fn () (do (pfor (Par 3 2 false) 20 (fn (i) (if (= i 11) (trap "index 11 failed") ()))) 1))))
        r3 (try-join (spawn (fn () (pfold-chunks (Par 4 1 false) 10 + 0 (fn (lo hi) (if (= lo 5) (trap "fold chunk 5 failed") lo))))))]
    (do (check c (= (msg r1) "chunk 3 failed"))
        (check c (= (msg r2) "index 11 failed"))
        (check c (= (msg r3) "fold chunk 5 failed"))
        (check c (>= @ran 8))
        (checks-result c))))
