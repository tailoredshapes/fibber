;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 11
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Test 3 of the design, the other half: a finally clause that runs because the body returned, and traps, is an ordinary trap: the outer
;; try catches it (its message is the finally's), and what the finally set before it trapped stays set. Killed by: scripts/mutant-catch.sh
;; `finally-catchable` does not apply; `no-catch` (catch-run answers 0 for a failure) does: the outer catch never runs.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (let ((log (cell 0)))
    (try (try 5 (finally (do (set! log 1) (trap "normal-path cleanup"))))
         (catch e (+ (* 10 @log) (if (= (ex-message e) "normal-path cleanup") 1 0))))))
