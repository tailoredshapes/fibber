;; spec: docs/design/numerical-library.md; element access must not allocate metadata
;; expect: accept
;; result: 3500
;; audit: clean
;; allocs: <= 0
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.tensor :as t]))

;; Constants' construction does not count toward runtime allocation bounds.
(def data (t/tensor-i64 [0 1 2 3 4 5 6 7]))

(defun main () -> i64
  (loop ((i 0) (total 0))
    (if (< i 1000) (recur (+ i 1) (+ total (t/flat-at data (rem i 8)))) total)))
