;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: trap
;; trap:   in a finally clause run while unwinding: cleanup failed
;; stage:  2
;; roots:  ../../lib support
;; Test 3 of the design (decision of 2026-10-05): a finally clause that runs because the body trapped, and traps itself, ends the program
;; with the second trap's message, even inside an outer try that would catch. Killed by: scripts/mutant-catch.sh `finally-catchable` (a
;; finally clause run while unwinding is an ordinary region: the outer catch answers and the program ends with 0).
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (try (try (trap "first") (finally (trap "cleanup failed")))
       (catch e 0)))
