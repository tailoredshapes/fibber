;; spec:   stdlib §4.4 row reduce-kv, §2.3 (KeyReducible), §3 N3 (the collection last)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce-kv
;; (reduce-kv f init m) calls f with the accumulator, the key and the value of every entry: a sum of key times value over
;; {1 10 2 20 3 30} is 10 + 40 + 90 = 140. The three are three arguments, not an entry. The accumulator may be of another
;; type than the map's: the length of the keys (an i64 over str keys), and a Map built from the entries, the map turned
;; inside out, {10 1 20 2 30 3}. The folds here are all independent of the order the entries come in, which is the hash's
;; today and insertion order for a small map after task P1.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m {1 10 2 20 3 30}))
    (do (check c (= (reduce-kv (fn (acc k v) (+ acc (* k v))) 0 m) 140))
        (check c (= (reduce-kv (fn (acc k v) (+ acc v)) 5 m) 65))
        (check c (= (reduce-kv (fn (acc k v) (+ acc (str-len k))) 0 {"ab" 1 "c" 2 "def" 3}) 6))
        (check c (= (reduce-kv (fn (acc k v) (assoc acc v k)) (empty {10 1}) m) {10 1 20 2 30 3}))
        (check c (= (reduce-kv (fn (acc k v) (+ acc 1)) 0 m) (count m)))
        (check c (= (reduce-kv (fn (acc k v) (+ acc k)) 0 (assoc m 4 40)) 10))
        (checks-result c))))
