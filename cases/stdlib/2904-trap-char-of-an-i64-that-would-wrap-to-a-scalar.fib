;; spec:   stdlib §4.3 (row char), §2.8 (conversions are checked)
;; expect: trap
;; trap:   char: value out of range
;; roots:  ../../lib support
;; covers: char
;; 2^32 + 65 is no scalar, though `(trunc i32 x)` of it is 65, the code point of A: the range is
;; tested on the i64 before anything is narrowed.
(defun main () -> i64 (sext i64 (char->i32 (char 4294967361))))
