;; spec:   stdlib §2.3 (Collection: the result type is the instance's)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; conj's result type is determined by the instance: a Vec stays a Vec and
;; takes the element at the end; a VSeq (the seq of a Vec) is a seq, and
;; takes it at the front, as Clojure's (conj (seq [2 3]) 1) is (1 2 3).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun first-of (c: c d: i64) :where ((Reducible c i64)) -> i64
  (let ((r (cell d)))
    (do (each-while c (fn (x) (do (set! r x) false))) @r)))

(defun main () -> i64
  (let ((c (checks))
        (v (conj [1 2] 3))
        (s (conj (vseq-of [2 3]) 1))
        (s2 (conj s 0)))
    (do (check c (= (count v) 3))
        (check c (= (nth v 2) 3))
        (check c (= (first-of v 9) 1))
        (check c (= (count s) 3))
        (check c (= (first-of s 9) 1))
        (check c (= (nth s 1) 2))
        (check c (= (nth s 2) 3))
        (check c (= (count s2) 4))
        (check c (= (first-of s2 9) 0))
        (check c (= (count (conj (conj [] 1) 2)) 2))
        (checks-result c))))
