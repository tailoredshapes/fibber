;; spec:   stdlib §4.2 (row with), §8.1 item 5 (count cases), plan Y8
;; expect: accept
;; result: 133
;; audit:  clean
;; allocs: <= 2
;; roots:  ../../lib support
;; covers: defrecord ->Name with
;; `with` of three fields costs one object, not one per field: the run allocates two in all, the Acct that ->Acct builds
;; and one for `with` (the three updates go through a cell that holds the copy, types §6.6). The string literals are
;; immortal. A bound of 1 fails, which the lowered-bound test of allocs.rs requires.
(ns main)

(defrecord Acct [id: i64 owner: str bal: i64])

(defun main () -> i64
  (let ((a (->Acct 1 "ann" 10)))
    (let ((b (with a (id 100) (bal 20) (owner "bob"))))
      (+ (. a bal) (+ (. a id) (+ (. b id) (+ (. b bal) (- (str-len (. b owner)) 1))))))))
