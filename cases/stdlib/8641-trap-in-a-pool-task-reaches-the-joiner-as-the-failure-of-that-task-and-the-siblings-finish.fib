;; spec:   types §8.8 (amended 2026-10-07, P-sched: traps in pool tasks); docs/adr/0001; docs/design/parallelism.md 3.1 (trap policy); rt/sched.lir
;; expect: accept
;; result: 0
;; audit:  abandoned
;; leaks:  8
;; stage:  2
;; roots:  ../../lib support
;; A trap in a pool task is that task's failure, exactly as a spawned task's: `try-join` answers `(Err (Trap message))` with the original
;; message, a task that did not trap is unaffected, a task that traps inside a nested join fails the task that was joining it (its joiner
;; would have trapped on it), and the pool goes on: the worker that ran the trapping task is replaced and later tasks run (the pool's count
;; of live workers is still the worker count; the tasks-run counter counts exactly the tasks that ran on a worker, the trapped ones
;; included). Which thread runs a task is not pinned: here, in a program that does not catch, the joiner parks and every task runs on a
;; worker, but in a catching program a joiner that is not a worker runs the task it claims itself (types §8.8), so each task notes at
;; its entry whether a worker ran it and the counter is checked against that count, not against a schedule. The program does not catch,
;; so the trap cannot unwind: the worker's thread ends and what the trapped tasks' frames owned is abandoned (8 objects: what the three
;; failed tasks' frames held, the share-marked messages and the two atoms their closures capture among them), the same on every run.
(ns main (:use fib.core fib.async fib.parallel fib.os tl.check))

(defun msg (r: (Result i64 Trap)) -> str (match r ((Err t) (. t message)) ((Ok v) "no trap")))

;; at the entry of a task: counts it when a worker runs it (before anything in the task can trap)
(defun on-worker (w: (Atom i64)) -> i64 (if (pool-worker?) (swap! w inc) @w))

(defun main () -> i64
  (let [c (checks)
        hits (atom 0)
        w (atom 0)
        bad (fork-task (fn () (do (on-worker w) (swap! hits inc) (trap "pool boom") 0)))
        good (fork-task (fn () (do (on-worker w) (sleep-ns 2000000) (swap! hits inc) 42)))
        rb (try-join bad)
        rg (try-join good)
        ;; a task whose join of a trapping child is not under try: its own failure is the child's message
        outer (fork-task (fn () (do (on-worker w)
                                    (+ 1 (join (fork-task (fn () (do (on-worker w) (quot 7 (- (vec-count [1]) 1)) 2))))))))
        ro (try-join outer)
        after (join (fork-task (fn () (do (on-worker w) (swap! hits inc) 7))))]
    (do (check c (= (msg rb) "pool boom"))
        (check c (match rg ((Ok v) (= v 42)) ((Err _) false)))
        (check c (= (msg ro) "integer / by zero"))
        (check c (= after 7))
        (check c (= @hits 3))
        (check c (= (pool-live-workers) (pool-workers)))
        (check c (= (pool-tasks-run) @w))
        (checks-result c))))
