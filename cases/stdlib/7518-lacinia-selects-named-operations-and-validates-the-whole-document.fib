;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0) query "query First { a: count } query Second { b: count }"]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (check c (f/request-error? (g/execute schema query {} g/NullValue)))
        (check c (= (g/result-json (g/execute-operation schema query {} g/NullValue "Second")) "{\"data\":{\"b\":0}}"))
        (check c (= (g/result-json (join (g/execute-operation-async schema query {} g/NullValue "First"))) "{\"data\":{\"a\":0}}"))
        (doseq [bad ["query First { count } query Second { missing }" "query First { count } query First { count }" "{ count } query Other { count }"]]
          (check c (f/request-error? (g/execute-operation schema bad {} g/NullValue "First"))))
        (check c (f/request-error? (g/execute-operation schema query {} g/NullValue "Missing")))
        (check c (= @calls 2))))) (checks-result c))))
