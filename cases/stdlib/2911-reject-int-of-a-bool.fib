;; spec:   stdlib §2.3 (the conversions are over the numeric types and, for int and long, char), §4.3 (row int)
;; expect: reject
;; error:  no implementation of ToInt for bool
;; roots:  ../../lib support
;; covers: int
;; A bool is no number here: the conversions are protocols with an instance per numeric type,
;; and the program that asks for one that does not exist is refused when it is compiled, not
;; when it runs.
(defun main () -> i64 (sext i64 (int true)))
