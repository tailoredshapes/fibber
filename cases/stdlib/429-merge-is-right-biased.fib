;; spec:   stdlib §4.5 (row merge)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: merge
;; (merge a b) is a with every entry of b, and the value of b wins a key both
;; have (Clojure's: the later map wins). Neither argument is changed. The
;; empty map is the identity on either side, a map merged with itself is the
;; same map, and (merge a b) has as many keys as the union. The variadic
;; macro that nests merge is R6a's case.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (e (empty {1 0}))
        (a (assoc (assoc (assoc e 1 10) 2 20) 3 30))
        (b (assoc (assoc (assoc e 3 33) 4 44) 5 55))
        (ab (merge a b))
        (ba (merge b a)))
    (do (check c (= (count ab) 5))
        (check c (is (get ab 1) 10))
        (check c (is (get ab 2) 20))
        (check c (is (get ab 3) 33))
        (check c (is (get ab 4) 44))
        (check c (is (get ab 5) 55))
        (check c (is (get ba 3) 30))
        (check c (= (count ba) 5))
        (check c (is (get a 3) 30))
        (check c (is (get b 3) 33))
        (check c (= (count a) 3))
        (check c (= (count (merge a e)) 3))
        (check c (is (get (merge a e) 2) 20))
        (check c (= (count (merge e b)) 3))
        (check c (is (get (merge e b) 5) 55))
        (check c (= (count (merge e e)) 0))
        (check c (= (count (merge a a)) 3))
        (check c (is (get (merge a a) 3) 30))
        (checks-result c))))
