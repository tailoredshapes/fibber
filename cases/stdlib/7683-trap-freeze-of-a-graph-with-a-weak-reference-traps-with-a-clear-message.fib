;; spec:   spec/types.md 8.2 (freeze); docs/design/parallelism.md 3.6
;; expect: trap
;; trap:   freeze: a weak reference is reachable from the value
;; stage:  2
;; roots:  ../../lib support
;; covers: freeze
(ns main)
(defstruct Leaf (a: i64))
(defstruct Holder (w: (Weak Leaf)))

(defun main () -> i64
  (let ((leaf (Leaf 1)))
    (let ((h (freeze (Holder (weak leaf)))))
      (. leaf a))))
