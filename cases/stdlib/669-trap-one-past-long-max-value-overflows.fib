;; spec:   stdlib §4.3 (row Long/MAX_VALUE), §2.8, types §2.12 (overflow traps)
;; expect: trap
;; trap:   integer overflow in + at i64
;; roots:  ../../lib
;; covers: Long/MAX_VALUE
;; The constant is the largest i64 and not merely a large one: adding one to it traps, which is what
;; Clojure's + does at that value (Math.addExact would, and `+` throws an ArithmeticException).
(ns main (:use fib.core) (:require [Long :as Long]))

(defun main () -> i64
  (+ Long/MAX_VALUE 1))
