;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (l/run 3 (fn (q) (l/all [(fd/in q (fd/interval -2 2)) (fd/+ q (l/integer 1) (l/integer 2))]))) [(l/integer 1)]))
        (check c (= (l/run 5 (fn (q) (l/all [(fd/in q (fd/interval 1 5)) (fd/< q (l/integer 4)) (fd/!= q (l/integer 2))]))) [(l/integer 1) (l/integer 3)]))
        (check c (= (l/run 3 (fn (q) (l/all [(fd/<= q (l/integer 2)) (fd/in q (fd/interval 1 3))]))) [(l/integer 1) (l/integer 2)]))
        (check c (= (l/run 1 (fn (q) (fd/+ (l/integer 1) (l/integer 2) (l/integer 4)))) []))
        (checks-result c))))
