;; spec:   stdlib §2.5 (a bulk vec builds the trie in one pass), §8.1 item 5 (count cases)
;; expect: accept
;; result: 64
;; audit:  clean
;; allocs: <= 7
;; roots:  ../../lib support
;; vec-from-array (L9) of a known-length array of 64 elements allocates 7 objects: no state, no buffer, a
;; leaf per 32 elements sliced out of the array. The bound is the count (the trace's, which includes the
;; array the case makes), and the harness's own test lowers it by one and requires the failure.
(ns main)

(defun main () -> i64
  (let ((v (vec-from-array (array 64 0))))
    (vec-count v)))
