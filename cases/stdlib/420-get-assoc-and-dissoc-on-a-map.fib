;; spec:   stdlib §2.3 (Lookup Assoc Dissoc), §4.5 (rows get assoc dissoc)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: get assoc dissoc
;; The three methods on a Map: assoc adds a key and replaces the value of one
;; it has, dissoc removes one (and a key the map lacks is no error), get
;; answers an Option, and none of them changes the map it was given
;; (persistence: the old value still answers as it did). Keys are i64 and str
;; (the library's Hash for both), the values are i64.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))
(defun is-nil (o: (Option i64)) -> bool (match o (nil true) ((some _) false)))

(defun main () -> i64
  (let ((c (checks))
        (m0 (empty {1 0}))
        (m1 (assoc m0 1 10))
        (m2 (assoc m1 2 20))
        (m3 (assoc m2 1 11))
        (m4 (dissoc m3 2))
        (m5 (dissoc m4 99))
        (s0 (assoc (empty {"a" 0}) "a" 1))
        (s1 (assoc s0 "b" 2)))
    (do (check c (is-nil (get m0 1)))
        (check c (is (get m1 1) 10))
        (check c (is-nil (get m1 2)))
        (check c (is (get m2 1) 10))
        (check c (is (get m2 2) 20))
        (check c (is (get m3 1) 11))
        (check c (is (get m2 1) 10))
        (check c (is (get m4 1) 11))
        (check c (is-nil (get m4 2)))
        (check c (is (get m2 2) 20))
        (check c (is (get m5 1) 11))
        (check c (= (count m3) 2))
        (check c (= (count m4) 1))
        (check c (= (count m5) 1))
        (check c (is (get s1 "a") 1))
        (check c (is (get s1 "b") 2))
        (check c (is-nil (get s1 "c")))
        (check c (is-nil (get (dissoc s1 "a") "a")))
        (check c (is-nil (get (dissoc (dissoc m4 1) 1) 1)))
        (checks-result c))))
