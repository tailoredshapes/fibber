;; spec:   stdlib §4.3 (row float), §2.8 (conversions are checked)
;; expect: trap
;; trap:   float: value out of range
;; roots:  ../../lib support
;; covers: float
;; An f64 beyond the greatest f32 overflows it: `(fptrunc f32 x)` alone would give an infinity,
;; `float` traps.
(defun main () -> i64 (fptosi i64 (fpext f64 (float 1e300))))
