;; spec:   stdlib §2.6 (atoms), types §8.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: atom, swap!, compare-and-set!
;; An atom that holds an object (here a `Vec`) is not lock-free: a reader must retain what it loads while no writer releases it, so the
;; load, the retain and the store of a swap are taken under the atom's lock (rt/atom.lir fib.lock: test-and-test-and-set, spinning a bounded
;; number of loads and then yielding). Six tasks add to one atom's Vec, three with `swap!` (`conj` of their id, 300 times) and three with a
;; `compare-and-set!` loop (read the Vec, try it -> `conj` of the id), while a seventh keeps reading it and takes the count: every add
;; is in the end (1 800 elements, and the sum of the ids is what the ids add up to), what the reader saw was always a whole Vec (its count
;; never fell), and the audit is clean: every Vec the swaps and the failed compare-and-sets made was released exactly once.
;; Without the lock the swaps lose updates or release a Vec a reader is retaining.
(ns main (:use tl.check fib.async))

(defun add-swap (a: (Atom (Vec i64)) id: i64 n: i64) -> i64
  (do (dotimes (i n) (swap! a (fn (v) (conj v id)))) n))

(defun add-cas (a: (Atom (Vec i64)) id: i64 n: i64) -> i64
  (do (dotimes (i n)
        (loop ((done false))
          (if done
              true
              (let ((v @a)) (recur (compare-and-set! a v (conj v id)))))))
      n))

;; 1 when the count never fell, until the Vec has `limit` elements
(defun watch (a: (Atom (Vec i64)) limit: i64 stop: (Atom bool)) -> i64
  (loop ((last 0) (ok 1))
    (let ((k (count @a)))
      (if (or (>= k limit) @stop) ok (recur k (if (< k last) 0 ok))))))

(defun main () -> i64
  (let ((c (checks)) (a (atom (vec-empty))) (stop (atom false)))
    (let ((reader (future (watch a 1800 stop)))
          (ws [(future (add-swap a 1 300)) (future (add-swap a 2 300)) (future (add-swap a 3 300))
               (future (add-cas a 4 300)) (future (add-cas a 5 300)) (future (add-cas a 6 300))]))
      (do (dotimes (i 6) (join (nth ws i)))
          (reset! stop true)
          (check c (= (count @a) 1800))
          (check c (= (reduce + 0 @a) (* 300 21)))
          (check c (= (join reader) 1))
          (checks-result c)))))
