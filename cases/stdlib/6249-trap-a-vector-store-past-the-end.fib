;; spec:   types §1.9 (stores), docs/design/simd-and-tensors.md 2.7
;; expect: trap
;; trap:   simd-store!: lanes out of range of the array
;; stage:  2
;; roots:  ../../lib support
;; The store of four lanes at index 3 of a 6-element array would write element 6: it traps and writes nothing.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (cell (array 6 0i32))))
    (do (simd-store! &a 3 <<1 2 3 4>>i32) (println (array-get @a 3)) 0)))
