;; spec:   stdlib §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: if or and
;; (Option bool) is Clojure's true, false and nil: truthy when (some true), so (some false)
;; takes the else arm of `if` and the next operand of `or`. `cond` without a default is
;; nil, or (some v) for a value, as `when` is.
(ns main (:use tl.check))

(defun pick (o: (Option bool)) -> i64
  (if o 1 2))

(defun size (n: i64) -> (Option str)
  (cond (< n 10) "small"
        (< n 100) "medium"))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (pick (some true)) 1))
        (check c (= (pick (some false)) 2))
        (check c (= (pick nil) 2))
        (check c (or (some false) true))
        (check c (not (and (some false) true)))
        (check c (match (size 5) ((some s) (= s "small")) (nil false)))
        (check c (match (size 50) ((some s) (= s "medium")) (nil false)))
        (check c (match (size 500) ((some _) false) (nil true)))
        (checks-result c))))
