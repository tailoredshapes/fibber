;; spec:   stdlib §7 L15, §4.2 (row def)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; The second program of the L15 examples: a global lookup set. `set` is a
;; function, so this `def` is made at run time, and what it reaches is
;; immortal (never freed, never written in place), readable from a task
;; without a capture.
(ns main (:use fib.core fib.async tl.check))

(def stopwords: (Set str) (set ["a" "the"]))

(defun stop? (w: str) -> bool (contains? stopwords w))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (stop? "the"))
        (check c (not (stop? "cat")))
        (check c (= (join (future (stop? "a"))) true))
        (checks-result c))))
