;; spec:   stdlib §2.1 rule 2 (a chain consumed in place is fused), §2.5, §8.1 item 5 (count cases)
;; expect: accept
;; result: 640
;; audit:  clean
;; allocs: <= 55
;; roots:  ../../lib support
;; covers: vec map range
;; vec of a map over a range of 640: the expander fuses the chain into one walk and the walk is
;; the bulk builder's, so the count grows with the leaves and not the elements: 20 leaves are 40
;; objects, and 15 are the constants (the same 15 as in case 483). The conj loop that was the default
;; allocated 1340 here, measured with the compiler built before the builder. The bound is the count.
(ns main (:use fib.core fib.seq fib.coll))

(defun triple (x: i64) -> i64 (* 3 x))

(defun main () -> i64
  (let ((v (vec (map triple (range 640)))))
    (count v)))
