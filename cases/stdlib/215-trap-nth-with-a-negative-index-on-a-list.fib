;; spec:   stdlib §4.4 (row nth), §2.3 (the default nth is a walk that traps past the end), §1.2 P5
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: nth
;; A List has no nth of its own in fib.seq: the default walks with
;; each-while, and an index that no position equals (a negative one, as
;; well as one past the end) ends the walk with nothing found, which is the
;; trap, not a wrong element. A good index answers first, so the trap is the
;; last call's.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((xs (list 4 5 6)))
    (+ (nth xs 2) (nth xs -1))))
