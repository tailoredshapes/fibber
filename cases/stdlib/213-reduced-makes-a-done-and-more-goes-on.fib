;; spec:   stdlib §4.4 (rows Step reduced), §2.1 rule 3
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Step reduced reduce-while
;; Step is the type of what reduce-while's function returns: (More v) and
;; (Done v), and `reduced` is the function that makes a Done, so
;; (reduced 5) is (Done 5). A function that returns the Step of two
;; different arms, one reduced and one More, has the one type (Step a).
(ns main (:use fib.core fib.seq tl.check))

(defun unwrap-step (s: (Step i64)) -> i64 (match s ((Done v) (+ v 1000)) ((More v) v)))

(defun pick (x: i64) -> (Step i64) (if (> x 3) (reduced x) (More x)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (match (reduced 5) ((Done v) (= v 5)) ((More _) false)))
        (check c (match (reduced "s") ((Done v) (= v "s")) ((More _) false)))
        (check c (= (unwrap-step (reduced 5)) 1005))
        (check c (= (unwrap-step (More 5)) 5))
        (check c (= (unwrap-step (pick 9)) 1009))
        (check c (= (unwrap-step (pick 2)) 2))
        (check c (= (reduce-while (fn (a x) (pick (+ a x))) 0 [1 1 1 1 1]) 4))
        (check c (= (reduce-while (fn (a x) (pick x)) 0 [1 2 7 9]) 7))
        (checks-result c))))
