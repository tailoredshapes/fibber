;; spec:   stdlib §2.8 ((Ratio t): Ord), §4.3 (rows compare, max, min)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / compare max min
;; Ordering two ratios by n1 d2 against n2 d1 overflows when the ratios
;; are close to the limit of the width though each fits: 3037000501/3037000500
;; against 3037000500/3037000499 needs a product above the largest i64. The
;; library's Ord compares integer parts and then the reciprocals of the
;; fractional parts instead, so it answers, and compare, max and min with
;; it (the answers were worked out outside fibber with exact fractions).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (a (/ 3037000501 3037000500))
        (b (/ 3037000500 3037000499))
        (m 9223372036854775807))
    (do (check c (< a b))
        (check c (> b a))
        (check c (not (< b a)))
        (check c (= (compare a b) -1))
        (check c (= (compare b a) 1))
        (check c (= (compare a a) 0))
        (check c (= (max a b) b))
        (check c (= (min a b) a))
        (check c (< (/ (- m 1) m) (/ m (- m 1))))
        (check c (< (/ (neg m) 3) (/ m 3)))
        (check c (< (/ 1 m) (/ 1 (- m 1))))
        (check c (< (/ (- m 2) m) (/ (- m 1) m)))
        (check c (> (/ 4294967297 4294967296) (/ 4294967299 4294967298)))
        (check c (> (/ m 4294967296) (/ (- m 1) 4294967296)))
        (check c (< (/ (neg m) 2) (/ (neg m) 3)))
        (check c (< (/ 6148914691236517205 m) (/ 6148914691236517206 m)))
        (check c (= (/ m 3) (/ m 3)))
        (checks-result c))))
