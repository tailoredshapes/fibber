;; spec:   stdlib §4.6 (row max-key), §6.3 (E1)
;; expect: reject
;; error:  macro max-key takes at least 2 argument(s), got 1
;; roots:  ../../lib support
;; covers: max-key
;; Clojure's (max-key k) is an arity exception; here the macro refuses a call that has a key function and
;; no element, naming the macro and the count. The collection form is (apply max-key k c).
(ns main (:use tl.check))

(defun main () -> i64
  (max-key (fn (x: i64) x)))
