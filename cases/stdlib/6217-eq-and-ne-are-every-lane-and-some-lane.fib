;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `=` on vectors is every lane equal and returns bool; `!=` is some lane unequal. A NaN lane is unequal to itself, -0.0 equals 0.0, a mask is compared like any vector.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (let ((a: i16x5 <<1 2 3 4 5>>i16))
          (do (check c (= a a)) (check c (= a <<1 2 3 4 5>>i16)) (check c (!= a <<1 2 3 4 6>>i16)) (check c (!= a <<0 2 3 4 5>>i16))
              (check c (not (= a <<1 2 3 4 6>>i16))) (check c (not (!= a a)))
              (check c (= (with-lane a 4 6i16) <<1 2 3 4 6>>i16))))
        (let ((nan (/ 0.0 0.0)) (f: f64x2 <<1.0 2.0>>f64))
          (do (check c (not (= (with-lane f 1 nan) (with-lane f 1 nan)))) (check c (!= (with-lane f 1 nan) (with-lane f 1 nan)))
              (check c (= <<0.0 1.0>>f64 <<-0.0 1.0>>f64)) (check c (not (!= <<0.0 1.0>>f64 <<-0.0 1.0>>f64)))))
        (let ((m (simd/lt <<1 2>>i32 <<2 1>>i32)))
          (do (check c (= m m)) (check c (!= m (simd/not m)))))
        (let ((p (checks)))
          (do (check p (= <<1 2>>i8 <<1 3>>i8)) (check-detects c p)))
        (checks-result c))))
