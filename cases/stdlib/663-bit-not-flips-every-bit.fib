;; spec:   stdlib §4.1 (row bit-not), types §2.12 (Bits)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bit-not
;; The builtin bit-not flips every bit of its operand, so it is -1 - x at every width: 0 gives -1,
;; -1 gives 0, the maximum gives the minimum, and applying it twice gives the operand back. It
;; cannot overflow, and at a narrow width it flips only that many bits.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (bit-not 0) -1))
        (check c (= (bit-not -1) 0))
        (check c (= (bit-not 5) -6))
        (check c (= (bit-not -6) 5))
        (check c (= (bit-not 12345) (- -1 12345)))
        (check c (= (bit-not 9223372036854775807) -9223372036854775808))
        (check c (= (bit-not -9223372036854775808) 9223372036854775807))
        (check c (= (bit-not (bit-not 12345)) 12345))
        (check c (= (bit-not 0i8) -1i8))
        (check c (= (bit-not 127i8) -128i8))
        (check c (= (bit-not -128i8) 127i8))
        (check c (= (bit-not 0i16) -1i16))
        (check c (= (bit-not 0i32) -1i32))
        (check c (= (bit-not 255i32) -256i32))
        (checks-result c))))
