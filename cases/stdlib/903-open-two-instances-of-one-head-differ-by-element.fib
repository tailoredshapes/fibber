;; spec:   stdlib §5.5 S4, §2.3, §7 L23 (multi-parameter dispatch)
;; expect: accept
;; result: 2
;; audit:  clean
;; roots:  ../../lib
;; open:   L23
;; A Map takes a Pair entry and takes a Kv entry (a second entry type, as
;; Clojure's (into {} [[1 2]]) takes a vector beside the map entry). Two
;; instances of one head that differ only in the parameter the instance
;; determines are one overlap today: `overlapping instances: Take for (Map
;; k v) is already implemented` (A11 t70, t71). Dispatch on the heads of
;; every dispatch parameter lifts it.
(ns main (:use fib.core))

(defstruct (Kv k v) (key: k val: v))

(defprotocol (Take s e) (take-one (self x: e) -> Self))

(impl (Take (Pair k v)) (Map k v)
  (take-one (self x) (assoc self (. x fst) (. x snd))))

(impl (Take (Kv k v)) (Map k v)
  (take-one (self x) (assoc self (. x key) (. x val))))

(defun main () -> i64
  (count (take-one (take-one (map-empty) (Pair 1 2)) (Kv 3 4))))
