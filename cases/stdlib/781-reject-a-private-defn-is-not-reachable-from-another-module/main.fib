;; spec:   stdlib §4.2 (row defn-), syntax §5
;; expect: reject
;; error:  secret is private to util; it is not exported
;; roots:  ../../../lib ../support
;; covers: defn-
;; defn- is defn with :private, so the module that holds it exports every other
;; name and not this one: util's public defn is called, util's defn- by its
;; qualified name is the error syntax §5 gives for any private definition, naming
;; the module that owns it (cases/modules/002 is the same error for a defun).
(ns main (:require [util :as u]) (:use fib.core))

(defn- one [] -> i64 1)

(defn main [] -> i64 (+ (u/open (one)) (u/secret 1)))
