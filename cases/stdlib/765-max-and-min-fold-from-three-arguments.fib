;; spec:   stdlib §4.3 (rows max and min), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: max min
;; (max a b c ..) is (max (max a b) c ..): the largest of any number of
;; arguments of one ordered type, and (min ..) the smallest. A NaN argument
;; gives NaN wherever it stands, as Clojure's does (the binary function says so,
;; the fold keeps it, case 055).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0))
        (a 4))
    (do (check c (= (max 1 2) 2))
        (check c (= (max 1 5 3) 5))
        (check c (= (max 5 1 3) 5))
        (check c (= (max 1 3 5) 5))
        (check c (= (max a 9 -2 7) 9))
        (check c (= (max -1 -2 -3) -1))
        (check c (= (min 3 1 2) 1))
        (check c (= (min 1 2 3) 1))
        (check c (= (min 2 3 1) 1))
        (check c (= (min a 9 -2 7) -2))
        (check c (= (max 1i8 3i8 2i8) 3i8))
        (check c (= (min 1.5 0.5 2.5) 0.5))
        (check c (= (max "b" "c" "a") "c"))
        (check c (= (min \b \c \a) \a))
        (check c (!= (max 1.0 nan 3.0) (max 1.0 nan 3.0)))
        (check c (!= (min nan 1.0 3.0) (min nan 1.0 3.0)))
        (check c (!= (max 1.0 3.0 nan) (max 1.0 3.0 nan)))
        (checks-result c))))
