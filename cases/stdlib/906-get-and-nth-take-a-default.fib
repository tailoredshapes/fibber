;; spec:   stdlib §5.5 S7, §7 L1 (arity overloading)
;; expect: accept
;; result: 16
;; audit:  clean
;; roots:  ../../lib
;; Clojure's (get m k default) and (nth v i default): the third argument is
;; what a missing key or an index out of range gives. L1 made them clauses
;; of three arguments of the library's get and nth.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((m (assoc (map-empty) 1 10)))
    (+ (get m 2 7) (nth [1 2] 5 9))))
