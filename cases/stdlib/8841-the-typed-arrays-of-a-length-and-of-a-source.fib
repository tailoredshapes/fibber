;; spec:   stdlib §2.11 (Arrays), §4.1 rows long-array double-array float-array short-array int-array byte-array boolean-array char-array object-array make-array
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: long-array double-array float-array short-array int-array byte-array boolean-array char-array object-array make-array
;; Each typed constructor takes a length (an array of zeros, false, the NUL char or nil) or a source whose elements it copies,
;; converted as Clojure's are: (long-array [1.5 2.5]) is [1 2]. make-array reads its type argument: a scalar gives zeros, any other
;; type an array of nil.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (vec (long-array 2)) [0 0]))
        (check c (= (vec (long-array [5 6 7])) [5 6 7]))
        (check c (= (vec (long-array [1.5 2.5])) [1 2]))
        (check c (= (vec (long-array (range 3))) [0 1 2]))
        (check c (= (vec (double-array 2)) [0.0 0.0]))
        (check c (= (vec (double-array (list 1 2))) [1.0 2.0]))
        (check c (= (vec (float-array [0.5])) [0.5f32]))
        (check c (= (vec (short-array [300])) [300i16]))
        (check c (= (vec (int-array 1)) [0i32]))
        (check c (= (vec (byte-array [1 2])) [1i8 2i8]))
        (check c (= (vec (boolean-array 2)) [false false]))
        (check c (= (vec (boolean-array [true false])) [true false]))
        (check c (= (vec (char-array "hé")) [\h \é]))
        (check c (= (alength (char-array 3)) 3))
        (let ((o (object-array 2)))
          (do (aset o 1 (some 7))
              (check c (= (vec o) [nil (some 7)]))))
        (check c (= (vec (make-array i64 2)) [0 0]))
        (check c (= (vec (make-array f64 1)) [0.0]))
        (check c (= (vec (make-array bool 1)) [false]))
        (let ((s (make-array str 2)))
          (do (aset s 0 (some "a"))
              (check c (= (vec s) [(some "a") nil]))))
        (checks-result c))))
