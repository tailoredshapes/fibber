;; spec:   stdlib §4.4 row reduce-kv
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce-kv
;; An empty map or an empty vector has no entries, so f is not called and the answer is init, as Clojure's: a function that traps
;; shows it is never called, and the initial value may be of any type (here a str and an i64). A map that was emptied by dissoc
;; and a vector that was emptied by pop are empty in the same way.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun never (acc: str k: i64 v: i64) -> str (trap "reduce-kv: f was called"))
(defun never-vec (acc: i64 i: i64 x: i64) -> i64 (trap "reduce-kv: f was called"))

(defun main () -> i64
  (let ((c (checks))
        (m (empty {1 1})))
    (do (check c (= (reduce-kv never "init" m) "init"))
        (check c (= (reduce-kv never "init" (dissoc {1 2} 1)) "init"))
        (check c (= (reduce-kv never-vec 42 (vec-empty)) 42))
        (check c (= (reduce-kv never-vec 42 (pop [1])) 42))
        (checks-result c))))
