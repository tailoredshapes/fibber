;; spec:   stdlib §4.5 (row get), §7 L1
;; expect: accept
;; result: 2
;; audit:  clean
;; roots:  ../../lib
;; covers: get
;; Clojure's `(get m k d)`: the clause of three arguments of `get` (L1; the method of two is Lookup's). The
;; stand-in `get-or` and its arity hint (D1) are gone.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (get {1 2} 1 0))
