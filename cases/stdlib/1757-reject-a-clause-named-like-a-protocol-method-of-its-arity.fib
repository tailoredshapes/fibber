;; spec:   stdlib §7 L1
;; expect: reject
;; error:  a clause of size takes 1 argument(s), as the protocol method size does
;; roots:  ../../lib support
;; covers: defn
;; `(size x)` of one argument would be the method and the clause at once.
(ns main)

(defprotocol Sized (size (self) -> i64))
(defstruct Box (n: i64))
(impl Sized Box (size (self) (. self n)))

(defn size
  ([a: Box] -> i64 1)
  ([a: Box b: Box] -> i64 2))

(defun main () -> i64 (size (Box 1)))
