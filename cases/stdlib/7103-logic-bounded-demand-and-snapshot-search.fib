;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (calls (cell 0))
        (builder (fn (q: l/Term) (do (set! calls (+ @calls 1)) (l/== q (l/integer 9)))))
        (s (l/start (l/== (l/Var 0) (l/integer 9)))))
    (do (check c (= (l/run 0 builder) []))
        (check c (= @calls 0))
        (check c (= (l/run 1 builder) [(l/integer 9)]))
        (check c (= @calls 1))
        (check c (= (count (l/take-states 1 s)) 1))
        (check c (= (count (l/take-states 1 s)) 1))
        (checks-result c))))
