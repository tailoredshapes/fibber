;; spec: docs/design/http.md
;; expect: reject
;; error: cannot be shared between threads
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.http.client :as c]))
(defun main () -> i64
  (match (c/build-http-client (c/default-options))
    ((Err _) 1)
    ((Ok client) (join (spawn (fn () (do (c/close-http-client client) 0)))))))
