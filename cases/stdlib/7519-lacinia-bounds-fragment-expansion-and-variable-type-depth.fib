;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun limited? (result: g/GqlResult) -> bool
  (and (f/request-error? result) (= (. (nth (. result errors) 0) kind) g/ResourceLimit)))
(defun main () -> i64
  (let [c (checks) calls (atom 0)
    deep-type (str "query($x: " (str-join (vec (repeat 66 "["))) "String" (str-join (vec (repeat 66 "]"))) ") { echo(text: $x) }")
    chain (str "{ ...F0 } " (str-join (mapv (fn (i: i64) (str "fragment F" i " on Query { ...F" (+ i 1) " } ")) (vec (range 70)))) "fragment F70 on Query { count }")
    expansion (str "{ ...F0 } " (str-join (mapv (fn (i: i64) (str "fragment F" i " on Query { ...F" (+ i 1) " ...F" (+ i 1) " } ")) (vec (range 18)))) "fragment F18 on Query { count }")]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do (doseq [query [deep-type chain expansion]] (check c (limited? (g/execute schema query {} g/NullValue))))
        (check c (= @calls 0))))) (checks-result c))))
