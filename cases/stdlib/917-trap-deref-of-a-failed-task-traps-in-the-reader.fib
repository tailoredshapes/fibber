;; spec:   stdlib §2.10 (step 2); types §2.9 (`@t` is join)
;; expect: trap
;; trap:   no such thing
;; stage:  2
;; roots:  ../../lib support
;; `@t` is `join` (the Deref instance of a Task, case 658), so it traps in the reader with the task's message when the task trapped.
;; Killed by: scripts/mutant-task-trap.sh `join-ignores`.
(ns main (:use fib.async))

(defun main () -> i64
  (let ((t (future-call (fn () (trap "no such thing")))))
    (+ 1 @t)))
