;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.core fib.seq fib.coll)
  (:require [fib.logic :as l] [fib.logic.fd :as fd] [fib.logic.fd.domain :as d]
            [fib.logic.fd.slots :as slots]))

(defun main () -> i64
  (let ((c (checks)) (base (d/interval -2 4))
        (banned (d/domain [-3 -1 1 3 5]))
        (indexed (slots/slot-put (slots/slot-put (slots/slot-put (slots/empty-slots) 0 10) -5 20) 1000000000 30)))
    (do (check c (= (d/values (d/difference base banned)) [-2 0 2 4]))
        (check c (= (d/values (d/difference (d/interval 2 6) (d/interval 0 3))) [4 5 6]))
        (check c (= (d/difference (d/interval -9223372036854775808 -9223372036854775806)
                               (d/interval 9223372036854775805 9223372036854775807))
                    (d/interval -9223372036854775808 -9223372036854775806)))
        (check c (= (d/values (d/difference (d/domain [-1000 0 1000]) (d/interval -1 1))) [-1000 1000]))
        (check c (= (d/values (d/difference (d/interval 0 64) (d/domain [0 32 64])))
                    (filterv (fn (n: i64) (and (!= n 0) (!= n 32) (!= n 64))) (to-vec (range 65)))))
        (check c (= (d/difference (d/interval 0 1000000000) (d/domain [])) (d/interval 0 1000000000)))
        (check c (= (d/difference (d/interval 0 1000000000) (d/domain [0])) (d/interval 1 1000000000)))
        (check c (= (d/intersection (d/interval 0 1000000000) (d/interval 4 6)) (d/interval 4 6)))
        (check c (= (d/adjoin-value (d/adjoin-value (d/domain []) 4) 2) (d/domain [2 4])))
        (check c (= (d/adjoin-value (d/domain [4]) 1000) (d/domain [4 1000])))
        (check c (= (slots/slot-get indexed 0) (some 10)))
        (check c (= (slots/slot-get indexed -5) (some 20)))
        (check c (= (slots/slot-get indexed 1000000000) (some 30)))
        (check c (= (count (. indexed dense)) 1))
        (check c (= (slots/slot-get (slots/slot-remove indexed 0) 0) nil))
        (check c (= (slots/slot-get indexed 0) (some 10)))
        (check c (= (count (l/take-states 2 (l/start (fd/in (l/Var 1000000000) (fd/interval 1 2))))) 2))
        (check c (= (l/run-many 1 2 (fn (qs) (fd/batch
          [(fd/in-all qs (fd/interval 1 3))
           (fd/distinct [(l/integer -9223372036854775808) (l/integer 9223372036854775807)
                         (nth qs 0) (nth qs 1)])
           (l/== (nth qs 0) (l/integer 1)) (l/== (nth qs 1) (l/integer 2))])))
          [[(l/integer 1) (l/integer 2)]]))
        (checks-result c))))
