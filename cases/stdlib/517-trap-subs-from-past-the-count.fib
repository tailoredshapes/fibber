;; spec:   stdlib §4.3 (rows subs subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; subs is the 2-arity of subs until L1 and traps as subs does: offset 3
;; of "aé€" is its end and gives the empty string, offset 4 is out of range.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 3))
       (count (subs s 4)))))
