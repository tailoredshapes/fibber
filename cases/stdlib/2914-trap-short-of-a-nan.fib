;; spec:   stdlib §4.3 (row short), §2.8 (conversions are checked)
;; expect: trap
;; trap:   short: value out of range
;; roots:  ../../lib support
;; covers: short
;; Unlike `int` and `long` (case 2892), `short` of a NaN traps, as Clojure's (short ##NaN) throws.
(defun main () -> i64 (sext i64 (short (/ 0.0 0.0))))
