;; spec:   stdlib §6.3 (E4); syntax §4.4
;; expect: reject
;; error:  malformed cond: a keyword test must be the last
;; roots:  ../../lib support
;; covers: cond
;; A keyword test is always true, so a pair after it could never be taken; the expander refuses it
;; rather than drop the code (Clojure drops it silently, a checked language does not).
(ns main (:use fib.core))

(defun main () -> i64
  (cond :else 1
        (> 1 0) 2))
