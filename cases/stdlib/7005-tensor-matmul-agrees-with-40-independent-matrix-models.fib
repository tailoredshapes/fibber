(defun main () -> i64
  (let ((c (checks)) (planted (checks)))
    (do (batch-0 c) (batch-1 c) (batch-2 c) (batch-3 c) (batch-4 c)
        (check planted (= (t/to-vec (t/mmul (t/full [1 1] 2) (t/full [1 1] 3))) [5]))
        (check-detects c planted)
        (checks-result c))))
