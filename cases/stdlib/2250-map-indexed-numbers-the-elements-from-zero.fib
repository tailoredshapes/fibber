;; spec:   stdlib §4.4 row map-indexed, §2.1 rule 2 (the lazy form), tranche 2 plan §5 Y2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map-indexed
;; (map-indexed f c) is (f 0 x0), (f 1 x1) .. over the elements it is given: the index counts the
;; elements of the source it reads, so over a filtered seq it numbers the elements that passed.
;; The index is a parameter of each node and not a counter shared by two walks, so a bound seq
;; walked twice shows the same indexes. Over an empty source it is empty.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do ;; the index starts at 0, whatever the element is
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (+ (* i 10) x)) [5 6 7])) [5 16 27]))
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) i) [9 9 9 9])) [0 1 2 3]))
        (check c (= (vec (map-indexed (fn (i: i64 s: str) (str-concat (show i) s)) ["a" "b"])) ["0a" "1b"]))
        (check c (empty? (map-indexed (fn (i: i64 x: i64) i) [])))
        ;; every kind of source
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (* i x)) (range 4))) [0 1 4 9]))
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (+ i x)) (list 10 20))) [10 21]))
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (+ i x)) (some 7))) [7]))
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (+ i x)) (lcons 1 (lcons 2 (lazy-node (fn () LNil)))))) [1 3]))
        ;; the index counts what the source gives: after a filter, the filtered elements
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (+ (* i 100) x)) (filter odd? [1 2 3 4 5]))) [1 103 205]))
        ;; the function sees both the index and the element, in that order
        (check c (= (vec (map-indexed (fn (i: i64 x: i64) (- i x)) [10 20])) [-10 -19]))
        ;; a bound seq walked twice: the same indexes, the same elements
        (let ((s (map-indexed (fn (i: i64 x: i64) (+ i x)) [1 1 1])))
          (do (check c (= (vec s) [1 2 3]))
              (check c (= (vec s) [1 2 3]))
              (check c (= (count s) 3))))
        (checks-result c))))
