;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; A parameter written `f: (fn (a) b) :borrow` is ONE parameter: the clauses below take
;; two and three, and each call picks its clause by that count.
(ns main (:use tl.check))

(defn apply-to
  ([f: (fn (i64) i64) :borrow x: i64] -> i64 (f x))
  ([f: (fn (i64) i64) :borrow x: i64 y: i64] -> i64 (+ (f x) (f y))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (apply-to (fn (n) (* n 2)) 5) 10))
        (check c (= (apply-to (fn (n) (* n 2)) 5 7) 24))
        (checks-result c))))
