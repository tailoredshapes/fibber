;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do
      (check c (= (l/run 1 (fn (q) (l/== q (l/integer 42)))) [(l/integer 42)]))
      (check c (= (l/run 1 (fn (q) (l/all [(l/== q (l/integer 1)) (l/== q (l/integer 2))]))) []))
      (check c (= (l/run 1 (fn (q) (l/call-fresh (fn (x) (l/all [(l/== q x) (l/== x (l/symbol "tea"))]))))) [(l/symbol "tea")]))
      (check c (= (l/run 1 (fn (q) (l/== q (l/pair (l/integer 1) q)))) []))
      (check c (= (l/run 1 (fn (q) (l/call-fresh (fn (x) (l/all [(l/== q x) (l/== x (l/pair q (l/nil-term)))]))))) []))
      (check c (= (l/run 1 (fn (q) (l/== (l/integer 1) (l/symbol "1")))) []))
      (checks-result c))))
