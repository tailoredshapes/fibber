;; spec:   stdlib §2.7, §7 L17: Debug and ToStr are two protocols; deriving one is not deriving the other
;; expect: reject
;; error:  no implementation of Debug for P
;; roots:  ../../lib support
;; P derives ToStr, which is built from its fields' Debug, so `to-str` of a P
;; works (case 812); P itself has no Debug instance, and `debug` of a P is
;; refused rather than answered from the ToStr text.
(ns main (:use fib.core fib.print))

(defstruct P (x: i64))
(derive ToStr P)

(defun main () -> i64
  (if (= (debug (P 1)) "") 1 0))
