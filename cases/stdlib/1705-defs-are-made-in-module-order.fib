;; spec:   syntax §3.19, stdlib §7 L15 (one init function per module)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; A `def` of this module reads a `def` of tl.x8registry (made by a call)
;; and calls a function of it that writes its atom `def`. Both need that
;; module's init function to run before this one's: modules in dependency
;; order, then source order.
(ns main (:use tl.x8registry tl.check))

(def mine: i64 (+ base 1))
(def seen: i64 (note 7))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= base 101))
        (check c (= mine 102))
        (check c (= seen 7))
        (check c (= (noted) 1))
        (checks-result c))))
