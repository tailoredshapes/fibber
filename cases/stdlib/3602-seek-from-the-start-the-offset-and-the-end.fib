;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: fd-seek
;; Seek from the start, the current offset and the end; a negative resulting offset or a bad whence is EINVAL (22).
;; The file is named by the process id, so runs of the case at once do not share it.
(ns main (:use tl.check tl.sysx fib.unix) (:require [fib.os.process :as proc]))

(defun main () -> i64
  (let ((c (checks))
        (path (str "/tmp/fib-s5-3602-" (proc/process-id)))
        (w (creat path)))
    (do (put w "0123456789")
        (fd-close w)
        (let ((r (open-ro path)))
          (do (check c (= (num (fd-seek r 3 SEEK_SET)) 3))
              (check c (= (text r 4) "3456"))
              (check c (= (num (fd-seek r 0 SEEK_CUR)) 7))
              (check c (= (num (fd-seek r -2 SEEK_CUR)) 5))
              (check c (= (num (fd-seek r 0 SEEK_END)) 10))
              (check c (= (text r 4) ""))
              (check c (= (num (fd-seek r -1 SEEK_SET)) -22))
              (check c (= (num (fd-seek r 0 99)) -22))
              (fd-close r)))
        (fd-unlink path)
        (checks-result c))))
