;; spec:   stdlib §4.5 (row select-keys)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: select-keys
;; (select-keys m ks) builds its result from an empty Map, as Clojure's does, so a source that is not a Map
;; still gives a Map: the entries of a Vec are index to value, (select-keys [10 20 30] [0 2]) is {0 10, 2 30}
;; (found by differential testing against Clojure 1.12: it used to trap or return a Vec).
(ns main (:use tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (v (select-keys [10 20 30] [0 2]))
        (w (select-keys [10 20 30] [0 1 2 9])))
    (do (check c (= (count v) 2))
        (check c (is (get v 0) 10))
        (check c (is (get v 2) 30))
        (check c (not (contains? v 1)))
        (check c (= (count w) 3))
        (check c (is (get w 1) 20))
        (checks-result c))))
