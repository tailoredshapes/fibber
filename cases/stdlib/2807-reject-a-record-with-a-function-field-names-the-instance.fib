;; spec:   stdlib §4.2 (row defrecord: the macro writes the derives), §8.2.1 item 5, plan Y8 (PC2-5)
;; expect: reject
;; error:  no implementation of Eq for (fn (i64) i64)
;; roots:  ../../lib support
;; A record has `Eq Ord Hash Show Debug ToStr`, and a function has none of them, so a field of function type
;; is the checker's refusal, naming the type and the first instance that is missing (Eq; the same message
;; follows for Ord, Hash and Show). The macro does not paper over it and does not skip the derive: the way out
;; is a `defstruct` with the derives the author chooses (the default derive is not in tranche 2). No `Debug`
;; message is added by the library.
(ns main)

(defrecord Op [name: str f: (fn (i64) i64)])

(defun main () -> i64
  (let ((o (->Op "inc" (fn (x) (+ x 1)))))
    ((. o f) 1)))
