;; spec:   stdlib §2.8 ((Ratio t): normalised), §4.1 (row /), review finding of L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / numerator denominator
;; Case 093 at the other three widths: the minimum of i16, i32 and i64 over
;; -2 is the positive 2^(w-2) over 1 and fits, and over the minimum itself is
;; 1, though the negated minimum would not fit. The rows that need a sign
;; change of a component whose value fits (the minimum over a positive odd
;; divisor, a numerator over a negative minimum that reduces) stay in lowest
;; terms with the positive denominator.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m16 (- -32767i16 1i16))
        (m32 (- -2147483647i32 1i32))
        (m64 (- -9223372036854775807 1)))
    (do (check c (= (numerator (/ m16 -2i16)) 16384i16))
        (check c (= (denominator (/ m16 -2i16)) 1i16))
        (check c (= (numerator (/ m16 m16)) 1i16))
        (check c (= (denominator (/ m16 m16)) 1i16))
        (check c (= (numerator (/ m16 3i16)) m16))
        (check c (= (denominator (/ m16 3i16)) 3i16))
        (check c (= (numerator (/ m32 -2i32)) 1073741824i32))
        (check c (= (denominator (/ m32 -2i32)) 1i32))
        (check c (= (numerator (/ m32 m32)) 1i32))
        (check c (= (denominator (/ m32 m32)) 1i32))
        (check c (= (numerator (/ m32 3i32)) m32))
        (check c (= (denominator (/ m32 3i32)) 3i32))
        (check c (= (numerator (/ m64 -2)) 4611686018427387904))
        (check c (= (denominator (/ m64 -2)) 1))
        (check c (= (numerator (/ m64 m64)) 1))
        (check c (= (denominator (/ m64 m64)) 1))
        (check c (= (numerator (/ m64 3)) m64))
        (check c (= (denominator (/ m64 3)) 3))
        (check c (= (numerator (/ 0 m64)) 0))
        (check c (= (denominator (/ 0 m64)) 1))
        (check c (= (checks-made c) 20))
        (checks-result c))))
