;; spec:   stdlib §7 L8 (a vector pattern in a binding position takes a prefix); probe P05
;; expect: accept
;; result: 915
;; audit:  clean
;; roots:  ../../lib support
;; `(let (([a b] [1 2 3])) ..)` was `a let pattern must be irrefutable`. A vector pattern in a
;; binding position is `[a b & _]`, at every depth: it binds the first two of three (a 1,
;; b 2), the first of each of two inner vectors (10 and 400), and `& r` still takes the rest.
(ns main (:use fib.core fib.coll))

(defun main () -> i64
  (let (([a b] [1 2 3])
        ([[c _] [d e & r]] [[10 11] [400 500 600 700]]))
    (+ (+ a b) (+ (+ c d) (+ e (count r))))))
