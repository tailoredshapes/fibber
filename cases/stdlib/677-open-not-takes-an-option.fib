;; spec:   stdlib §4.1 (row not), §7 L20 (truthiness, typed)
;; expect: accept
;; result: 111
;; audit:  clean
;; roots:  ../../lib
;; open:   L20
;; covers: not
;; With L20 a test is a bool or an (Option T): truthy when it is (some _), as Clojure's nil is falsy,
;; so (not nil) is true and (not (some 1)) false, the row's own example being (not (get m k)).
;; Today `not` is on bool only: `cannot unify (Option i64) with bool` (A11 t01).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((none: (Option i64) nil)
        (one (some 1)))
    (+ (if (not none) 100 0)
       (+ (if (not one) 0 10) 1))))
