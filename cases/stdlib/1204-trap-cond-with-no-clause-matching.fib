;; spec:   stdlib §6.3 (E4); syntax §4.4
;; expect: trap
;; trap:   cond: no clause matched
;; roots:  ../../lib support
;; covers: cond
;; Without a default, falling off the end of a cond is a trap that names the cond's position (X5 is
;; to change it to nil). The same cond with a true test answers.
(ns main (:use tl.check))

(defun pick (n: i64) -> i64
  (cond (< n 0) 1
        (> n 0) 2))

(defun main () -> i64
  (+ (pick 3) (pick 0)))
