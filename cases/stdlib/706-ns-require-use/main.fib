;; spec:   stdlib §4.2 (row ns), syntax §5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../support
;; covers: ns
;; (ns a.b (:require [c.d :as d]) (:use e)) in the form that runs today.
;; `:require` makes `d/x` name x of c.d, in every space of names: a
;; function (pt/norm1), a struct, its constructor and its fields (pt/Point,
;; (. p x)), an enum's constructor and its variant in a pattern
;; (sh/Circle). `:use` brings the exported names in unqualified (double,
;; and offset, a `def`), and a name this module defines itself shadows a
;; used one (triple is also util's; main's own wins, util's is still
;; u/triple). A dotted name is a path, geo.point at geo/point.fib, and
;; a module may be both required (u) and used (util): one module, one
;; set of names.
(ns main (:require [geo.point :as pt] [geo.shape :as sh] [util :as u])
         (:use util tl.check))

(defun triple (n: i64) -> i64 (* n 30))

(defun area (s: sh/Shape) -> i64
  (match s
    ((sh/Circle r) (* 3 (* r r)))
    ((sh/Square w) (* w w))))

(defun main () -> i64
  (let ((c (checks))
        (p (pt/Point 3 4)))
    (do (check c (= (pt/norm1 p) 7))
        (check c (= (. p x) 3))
        (check c (= (double 5) 10))
        (check c (= offset 100))
        (check c (= (triple 1) 30))
        (check c (= (u/triple 1) 3))
        (check c (= u/offset offset))
        (check c (= (area (sh/Circle 2)) 12))
        (check c (= (area (sh/Square 5)) 25))
        (check c (= (sh/side (sh/Square 5)) 5))
        (check c (= (pt/base) (sh/base)))
        (check c (= (pt/base) 100))
        (checks-result c))))
