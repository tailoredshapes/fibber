;; spec:   stdlib §6.3 (E3); syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: if-let when-let dotimes
;; (if-let [x e] ..), (when-let [x e] ..) and (dotimes [i n] ..) are the parenthesised pairs under
;; the bracket spelling; both spellings meet in one program.
(ns main (:use tl.check))

(defun main () -> i64
  (let [c (checks)
        hits (atom 0)]
    (do (check c (= (if-let [x (second [5 6])] x 0) 6))
        (check c (= (if-let [x (second [5])] x 0) 0))
        (check c (= (if-let (x (second [5 6])) x 0) 6))
        (check c (= (if-let [[a b] (second [[1 2] [3 4]])] (+ a b) 0) 7))
        (when-let [x (second [5 6])] (do (swap! hits + (* x 100)) ()))
        (when-let [x (second [5])] (do (swap! hits + 1000) ()))
        (dotimes [i 4] (swap! hits + i))
        (dotimes (i 3) (swap! hits + 10))
        (check c (= @hits 636))
        (checks-result c))))
