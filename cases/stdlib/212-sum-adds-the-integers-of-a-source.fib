;; spec:   stdlib §4.4 (row sum: i64 until the generic one needs L4's static zero)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sum
;; (sum c) is (reduce + 0 c) over an i64 source: 0 for nothing, the element
;; for a source of one, and the same total from every kind of source.
(ns main (:use fib.core fib.seq tl.check))

(defstruct Upto (n: i64))

(impl (Reducible i64) Upto
  (each-while (self k)
    (loop ((i 0)) (if (< i (. self n)) (if (k (+ i 1)) (recur (+ i 1)) false) true))))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil)
        (ev: (Vec i64) (vec-empty)))
    (do (check c (= (sum ev) 0))
        (check c (= (sum none) 0))
        (check c (= (sum (list)) 0))
        (check c (= (sum [5]) 5))
        (check c (= (sum (some 5)) 5))
        (check c (= (sum [1 2 3 4]) 10))
        (check c (= (sum [-3 3 -4]) -4))
        (check c (= (sum (list 1 2 3 4)) 10))
        (check c (= (sum (Upto 100)) 5050))
        (check c (= (sum (VSeq (list 1 2) [3 4] 0)) 10))
        (check c (= (sum (lcons 1 (lcons 2 (lcons 3 (lazy-node (fn () LNil)))))) 6))
        (checks-result c))))
