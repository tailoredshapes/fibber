;; spec:   stdlib §4.1 (row atom: "an atom of a type that is not Send is a compile error"), §5 M1
;; expect: reject
;; error:  cell cannot be shared between threads: type argument a of atom has type (Cell i64)
;; roots:  ../../lib
;; covers: atom
;; An atom may be held by any task, so what it holds must be Send, and a Cell is not: two tasks
;; writing one cell race (stdlib §5.1). The refusal is at the atom, naming the type argument.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (atom (cell 1))))
    0))
