;; spec:   stdlib §6.3 (E3); syntax §3.2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: fn
;; (fn [x y] ..) is (fn (x y) ..), named, typed or destructuring as the parenthesised list is.
(ns main (:use tl.check))

(defun main () -> i64
  (let [c (checks)
        add (fn [x y] (+ x y))
        inc (fn [x: i64] -> i64 (+ x 1))
        fact (fn go [n: i64] -> i64 (if (< n 2) 1 (* n (go (- n 1)))))
        thunk (fn [] 5)]
    (do (check c (= (add 2 3) 5))
        (check c (= (inc 9) 10))
        (check c (= (fact 5) 120))
        (check c (= (thunk) 5))
        (check c (= (reduce (fn [acc [k v]] (+ acc (* k v))) 0 [[1 2] [3 4]]) 14))
        (check c (= (reduce (fn [a x] (+ a x)) 0 (map (fn [x] (* x x)) [1 2 3])) 14))
        (checks-result c))))
