;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; The valid bounds are 0 to the count of the string, in characters: "aé€" has
;; three, so (subs s 1 3) is fine and an end of 4 is out of range, whatever
;; its bytes (the string is six bytes long, so a byte-offset check would let 4
;; through). The first call is made and answered before the second traps, so
;; the trap is not a refusal of every call.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 1 3))
       (count (subs s 1 4)))))
