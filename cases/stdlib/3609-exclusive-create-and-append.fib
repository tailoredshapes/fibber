;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: fd-open
;; O_CREAT with O_EXCL on a file that exists is EEXIST (17); O_APPEND writes after what is there; O_TRUNC
;; empties the file; a read-only descriptor cannot write (EBADF, 9) and a write-only one cannot read.
(ns main (:use tl.check tl.sysx fib.unix))

(defun main () -> i64
  (let ((c (checks))
        (path "/tmp/fib-s5-3609")
        (w (creat path)))
    (do (put w "one")
        (fd-close w)
        (check c (= (num (fd-open path (bit-or O_WRONLY (bit-or O_CREAT O_EXCL)) 420)) -17))
        (let ((a (num (fd-open path (bit-or O_WRONLY O_APPEND) 0))))
          (do (check c (> a 2))
              (check c (= (put a "two") 3))
              (check c (= (nread (fd-read a 4)) -9))
              (fd-close a)))
        (let ((r (open-ro path)))
          (do (check c (= (text r 100) "onetwo"))
              (check c (= (put r "x") -9))
              (fd-close r)))
        (let ((t (num (fd-open path (bit-or O_RDWR O_TRUNC) 0))))
          (do (check c (= (text t 100) ""))
              (check c (= (put t "ab") 2))
              (check c (= (num (fd-seek t 0 SEEK_SET)) 0))
              (check c (= (text t 100) "ab"))
              (fd-close t)))
        (fd-unlink path)
        (checks-result c))))
