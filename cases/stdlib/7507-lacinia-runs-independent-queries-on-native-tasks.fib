;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g]))
(defun main () -> i64
  (let [c (checks) calls (atom 0) definition (g/schema {} {"hello" (g/resolving (g/named "String")
    (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
      (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/field-value ctx "greeting")))))})]
    (do (match (g/compile-schema definition)
      ((Err _) (check c false))
      ((Ok compiled) (let [context (g/object {"greeting" (g/StringValue "hello")})
        tasks (mapv (fn (i: i64) (g/execute-async compiled "{ hello }" {} context)) [0 1 2 3])]
        (do (doseq [task tasks] (check c (= (g/result-json (join task)) "{\"data\":{\"hello\":\"hello\"}}")))
          (check c (= @calls 4)))))) (checks-result c))))
