;; spec:   stdlib §4.3 (row map-opt: `(fn (a) b) (Option a) -> (Option b)`), §1.2 P5
;; expect: reject
;; error:  cannot unify i64 with (Option i64)
;; roots:  ../../lib
;; covers: map-opt unwrap-or
;; map-opt takes an Option. Clojure's `(some-> 5 inc)` works on any value
;; because a value may be nil; here nil is the empty variant of Option and
;; nothing else (stdlib §5 T1), so a plain i64 is refused at the checker
;; instead of being wrapped without a word.
(ns main (:use fib.core))

(defun bump (x: i64) -> i64 (+ x 1))

(defun main () -> i64
  (unwrap-or (map-opt bump 5) 0))
