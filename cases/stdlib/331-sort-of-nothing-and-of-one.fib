;; spec:   stdlib §4.4 (rows sort, sort-by, sort-with, sort-by-with)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sort sort-by sort-with sort-by-with
;; A collection of fewer than two elements has nothing to compare: sorting
;; it gives it back as a VSeq (the empty collection one with no element,
;; the one-element one with that element), and the comparator and the key
;; are never called. Two elements are the smallest case that does compare.
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (calls (cell 0))
        (none: (Vec i64) [])
        (nothing: (Option i64) nil))
    (do (check c (= (count (sort none)) 0))
        (check c (= (count (sort [7])) 1))
        (check c (= (nth (sort [7]) 0) 7))
        (check c (= (count (sort nothing)) 0))
        (check c (= (nth (sort (some 5)) 0) 5))
        (check c (= (count (sort-with (fn (a b) (do (set! calls (+ @calls 1)) (< a b))) none)) 0))
        (check c (= (nth (sort-with (fn (a b) (do (set! calls (+ @calls 1)) (< a b))) [3]) 0) 3))
        (check c (= (count (sort-by (fn (x) (do (set! calls (+ @calls 1)) x)) none)) 0))
        (check c (= (nth (sort-by (fn (x) (do (set! calls (+ @calls 1)) x)) [3]) 0) 3))
        (check c (= (count (sort-by-with (fn (x) (do (set! calls (+ @calls 1)) x)) < none)) 0))
        (check c (= (nth (sort-by-with (fn (x) (do (set! calls (+ @calls 1)) x)) < [3]) 0) 3))
        (check c (= @calls 0))
        (check c (= (nth (sort-with (fn (a b) (do (set! calls (+ @calls 1)) (< a b))) [4 2]) 0) 2))
        (check c (> @calls 0))
        (check c (= (nth (sort [2 1]) 0) 1))
        (check c (= (nth (sort [2 1]) 1) 2))
        (checks-result c))))
