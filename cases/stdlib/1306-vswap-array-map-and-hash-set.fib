;; spec:   stdlib §4.9 (row vswap!), §4.8 (rows array-map hash-set), §6.3 (E1)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: vswap! array-map hash-set
;; (vswap! v f a ..) is (reset! v (f @v a ..)) and answers the new value; the atom is read once, and f may be
;; a literal fn. (array-map k v ..) is the literal {k v ..}; (hash-set a ..) is one conj per element over the
;; empty set, so a repeated element is one.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (v (atom 1))
        (m (array-map "a" 1 "b" 2))
        (s (hash-set 1 2 2 3))
        (e: (Set i64) (hash-set))
        (z: (Map str i64) (array-map)))
    (do (check c (= (vswap! v + 5) 6))
        (check c (= @v 6))
        (check c (= (vswap! v - 1 2) 3))
        (check c (= @v 3))
        (check c (= (vswap! v (fn (x: i64) (* x 10))) 30))
        (check c (= @v 30))
        (check c (= (count m) 2))
        (check c (= (get m "b") (some 2)))
        (check c (= (count z) 0))
        (check c (= (count s) 3))
        (check c (= (count e) 0))
        (checks-result c))))
