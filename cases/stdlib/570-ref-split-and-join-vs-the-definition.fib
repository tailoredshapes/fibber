;; spec:   stdlib §4.7 (rows clojure.string/split, str/split-limit, clojure.string/join), §2.9, plan §6 L10b
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.string/split str/split-limit clojure.string/join
;; `str/split` and `str/split-limit` against the definition of Java's `Pattern.split`, over 300 seeded
;; (text, separator, limit) triples. The separator is one of ten (the empty string, a multi-byte
;; one, two that overlap themselves, "aa" and ",,"); the limit one of -1, 0, 1, 2, 3, 5; the text
;; is up to ten pieces, each one of six characters (the three multi-byte widths among them) or the
;; separator itself, so that matches are common, touch the ends, sit side by side and overlap
;; ("a" in "aaa" cut at "aa"). By Java's count 162 of the 300 triples are cut into two or more
;; pieces, 79 into three or more, and 15 have empty pieces at the end to drop for limit 0.
;; The reference below does not look like the library: it finds every match of the separator in
;; the vector of characters the prelude's `str-chars` decodes (leftmost, not overlapping, an empty
;; match one character on), drops a zero-width match at the start, keeps the first `limit - 1`
;; matches for a positive limit, cuts the characters at those matches, and drops the empty pieces
;; at the end for limit 0: the sentences of Java's documentation, one step each.
;; Four checks: (1) no triple differs from the reference; (2) with limit -1, `str/join` of the
;; pieces with the separator is the text again, for every triple; (3) a fingerprint of the library's
;; answers, `h = (h * 131 + x) mod 1000000007` over, for each triple, the number of pieces and then,
;; for each piece, its length and the codes of its characters, equals the number that a Java program
;; printed (the same generator, `Pattern.compile(Pattern.quote(sep)).split(text, limit)`, JDK 27);
;; (4) the PLANTED FAULT: the same comparison against a reference that forgets to drop the trailing
;; empty pieces for limit 0 must find a difference, in a second `Checks`, or the case fails.
;; One place where Java is not the oracle as it stands: for the EMPTY separator Java cuts between
;; the two UTF-16 units of a supplementary character ("😀".split("") is two lone surrogates),
;; where the library's unit is the scalar (spec §2.9, §5 T10: the two agree on the Basic
;; Multilingual Plane). The Java program therefore maps "😀" to one private-use BMP character
;; before the split and back after it, so that it is Java's `split` on text with no surrogates.
(ns main (:use fib.core tl.rng tl.check) (:require [fib.string :as str]))

(defun alphabet (i: i64) -> str
  (match i (0 "a") (1 "b") (2 ",") (3 "é") (4 "😀") (_ "€")))

(defun separator (i: i64) -> str
  (match i (0 ",") (1 "a") (2 "é") (3 "😀") (4 "ab") (5 "aa") (6 "a,") (7 "€") (8 "") (_ ",,")))

(defun limit-of (i: i64) -> i64
  (match i (0 -1) (1 0) (2 1) (3 2) (4 3) (_ 5)))

(defun make-text (r: Rng sep: str) -> str
  (let ((n (rng-below r 11)))
    (loop ((i 0) (acc ""))
      (if (< i n)
          (let ((e (rng-below r 7)))
            (recur (+ i 1) (str-concat acc (if (= e 6) sep (alphabet e)))))
          acc))))

;; ---- the reference, over vectors of characters ----

(defun at-match? (cs: (Vec char) ps: (Vec char) i: i64) -> bool
  (loop ((k 0))
    (if (< k (fib.prelude/vec-count ps))
        (if (= (fib.prelude/vec-nth cs (+ i k)) (fib.prelude/vec-nth ps k)) (recur (+ k 1)) false)
        true)))

;; the matches as [start end start end ..], in character indexes
(defun ref-matches (cs: (Vec char) ps: (Vec char)) -> (Vec i64)
  (let ((n (fib.prelude/vec-count cs))
        (m (fib.prelude/vec-count ps)))
    (loop ((i 0) (acc (vec-empty)))
      (if (> (+ i m) n)
          acc
          (if (at-match? cs ps i)
              (recur (if (= m 0) (+ i 1) (+ i m))
                     (fib.prelude/vec-conj (fib.prelude/vec-conj acc i) (+ i m)))
              (recur (+ i 1) acc))))))

;; the matches the split uses: not the zero-width one at the start, and at most limit - 1 when positive
(defun ref-used (ms: (Vec i64) limit: i64) -> (Vec i64)
  (let ((from (if (> (fib.prelude/vec-count ms) 0)
                  (if (= (fib.prelude/vec-nth ms 0) 0) (if (= (fib.prelude/vec-nth ms 1) 0) 2 0) 0)
                  0))
        (most (if (> limit 0) (* 2 (- limit 1)) (fib.prelude/vec-count ms))))
    (loop ((i from) (acc (vec-empty)))
      (if (< i (fib.prelude/vec-count ms))
          (if (< (fib.prelude/vec-count acc) most)
              (recur (+ i 2) (fib.prelude/vec-conj (fib.prelude/vec-conj acc (fib.prelude/vec-nth ms i)) (fib.prelude/vec-nth ms (+ i 1))))
              acc)
          acc))))

(defun chars-between (cs: (Vec char) a: i64 b: i64) -> str
  (loop ((i a) (acc ""))
    (if (< i b) (recur (+ i 1) (str-concat acc (char->str (fib.prelude/vec-nth cs i)))) acc)))

;; the text cut at the used matches
(defun ref-cut (cs: (Vec char) used: (Vec i64)) -> (Vec str)
  (loop ((i 0) (prev 0) (acc (vec-empty)))
    (if (< i (fib.prelude/vec-count used))
        (recur (+ i 2) (fib.prelude/vec-nth used (+ i 1))
               (fib.prelude/vec-conj acc (chars-between cs prev (fib.prelude/vec-nth used i))))
        (fib.prelude/vec-conj acc (chars-between cs prev (fib.prelude/vec-count cs))))))

(defun ref-drop-tail (v: (Vec str)) -> (Vec str)
  (let ((n (loop ((n (fib.prelude/vec-count v)))
             (if (> n 0) (if (= (str-len (fib.prelude/vec-nth v (- n 1))) 0) (recur (- n 1)) n) n))))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n) (recur (+ i 1) (fib.prelude/vec-conj acc (fib.prelude/vec-nth v i))) acc))))

;; keep-tail is the planted fault when true: the pieces that end the result are not dropped for limit 0
(defun ref-split (s: str sep: str limit: i64 keep-tail: bool) -> (Vec str)
  (let ((cs (fib.prelude/str-chars s))
        (ps (fib.prelude/str-chars sep)))
    (let ((used (ref-used (ref-matches cs ps) limit)))
      (if (= (fib.prelude/vec-count used) 0)
          (fib.prelude/vec-conj (vec-empty) s)
          (let ((pieces (ref-cut cs used)))
            (if (if (= limit 0) (not keep-tail) false) (ref-drop-tail pieces) pieces))))))

;; ---- the comparison ----

(defun same? (v: (Vec str) w: (Vec str)) -> bool
  (if (= (fib.prelude/vec-count v) (fib.prelude/vec-count w))
      (loop ((i 0))
        (if (< i (fib.prelude/vec-count v))
            (if (= (fib.prelude/vec-nth v i) (fib.prelude/vec-nth w i)) (recur (+ i 1)) false)
            true))
      false))

(defun fp (h: i64 x: i64) -> i64 (rem (+ (* h 131) x) 1000000007))

(defun fp-str (h: i64 s: str) -> i64
  (let ((cs (fib.prelude/str-chars s)))
    (loop ((i 0) (acc (fp h (fib.prelude/vec-count cs))))
      (if (< i (fib.prelude/vec-count cs))
          (recur (+ i 1) (fp acc (zext i64 (char->i32 (fib.prelude/vec-nth cs i)))))
          acc))))

(defun fp-pieces (h: i64 v: (Vec str)) -> i64
  (loop ((i 0) (acc (fp h (fib.prelude/vec-count v))))
    (if (< i (fib.prelude/vec-count v)) (recur (+ i 1) (fp-str acc (fib.prelude/vec-nth v i))) acc)))

;; the library's answer: str/split for limit 0, str/split-limit for the rest
(defun lib-split (s: str sep: str limit: i64) -> (Vec str)
  (if (= limit 0) (str/split s sep) (str/split-limit s sep limit)))

;; [triples that differ from the reference, from the planted reference, whose round trip fails] and the fingerprint
(defstruct Tally (bad: (Cell i64) planted: (Cell i64) trip: (Cell i64) print: (Cell i64)))

(defun run (t: Tally n: i64) -> unit
  (let ((r (rng 570)))
    (dotimes (i n)
      (let ((sep (separator (rng-below r 10)))
            (limit (limit-of (rng-below r 6))))
        (let ((s (make-text r sep)))
          (let ((got (lib-split s sep limit)))
            (do (if (same? got (ref-split s sep limit false)) () (set! (. t bad) (+ @(. t bad) 1)))
                (if (same? got (ref-split s sep limit true)) () (set! (. t planted) (+ @(. t planted) 1)))
                (if (= (str/join sep (str/split-limit s sep -1)) s) () (set! (. t trip) (+ @(. t trip) 1)))
                (set! (. t print) (fp-pieces @(. t print) got)))))))))

(defun main () -> i64
  (let ((c (checks))
        (p (checks))
        (t (Tally (cell 0) (cell 0) (cell 0) (cell 0))))
    (do (run t 300)
        (check c (= @(. t bad) 0))
        (check c (= @(. t trip) 0))
        (check c (= @(. t print) 670272599))
        (check p (= @(. t planted) 0))
        (check-detects c p)
        (checks-result c))))

