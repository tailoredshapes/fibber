;; spec:   stdlib §2.7 (str is ToStr), §6.3 (R5), §4.14 (row str)
;; expect: reject
;; error:  no implementation of ToStr for Pt
;; roots:  ../../lib support
;; covers: str
;; (str p) is (fib.core/to-str p): a struct that has no ToStr instance is refused when the
;; program is checked, with the checker's own words, so the macro adds no error of
;; its own and hides none. (A struct gets Show, Debug and ToStr only by deriving or
;; writing them, §2.7.)
(ns main (:use fib.core fib.seq fib.print))

(defstruct Pt (x: i64 y: i64))

(defun main () -> i64 (str-len (str "p=" (Pt 1 2))))
