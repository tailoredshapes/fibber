;; spec: docs/design/numerical-library.md; independent NumPy 2.3.5 float oracle (dyadic inputs)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(def expected-f32 [-14.21875f32 -5.5625f32 11.0f32 0.25f32 -4.75f32 -8.3125f32 6.09375f32 -5.875f32 -13.46875f32 1.9375f32 2.25f32 9.75f32 -10.0625f32 -10.46875f32 1.875f32 2.375f32 -13.65625f32 -5.25f32 11.78125f32 0.0625f32 -4.46875f32 0.125f32 11.6875f32 -5.5f32 -13.34375f32 2.53125f32 1.875f32 9.84375f32 -9.9375f32 9.71875f32 2.0625f32 2.3125f32 -13.25f32 -5.8125f32 11.6875f32])
(def expected-f64 [-14.21875 -5.5625 11.0 0.25 -4.75 -8.3125 6.09375 -5.875 -13.46875 1.9375 2.25 9.75 -10.0625 -10.46875 1.875 2.375 -13.65625 -5.25 11.78125 0.0625 -4.46875 0.125 11.6875 -5.5 -13.34375 2.53125 1.875 9.84375 -9.9375 9.71875 2.0625 2.3125 -13.25 -5.8125 11.6875])

(defun main () -> i64
  (let ((c (checks))
        (a (t/reshape [5 65] (t/map-as (fn (x: i64) (fdiv (double (- (rem (* x 7) 19) 9)) 4.0)) 0.0 (t/arange 0 325 1))))
        (b (t/reshape [65 7] (t/map-as (fn (x: i64) (fdiv (double (- (rem (* x 5) 23) 11)) 8.0)) 0.0 (t/arange 0 455 1))))
        (x (t/map-as (fn (v: f64) (float v)) 0.0f32 a))
        (y (t/map-as (fn (v: f64) (float v)) 0.0f32 b)))
    (do (check c (= (t/to-vec (t/mmul a b)) expected-f64))
        (check c (= (t/to-vec (t/mmul x y)) expected-f32))
        (let ((planted (checks)))
          (do (check planted (= (t/to-vec (t/mmul a b)) (assoc expected-f64 0 999.0)))
              (check-detects c planted)))
        (checks-result c))))
