;; spec:   syntax §1.1 (the vector literal `<<..>>`), docs/design/simd-and-tensors.md 2.3
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: <<..>>T
;; A suffix touching the `>>` (`i8 i16 i32 i64 f32 f64`) reads each number literal at that width, as if it had been written with
;; the suffix: `<<0.1 0.2>>f32` is `(simd 0.1f32 0.2f32)` (the forms hold the f32 nearest 0.1, which shows as 0.10000000149011612); an integer literal for a float width is an exact conversion; a literal
;; that already has the suffix is accepted. The suffix is part of the literal: a space makes it a symbol.
(ns main (:use fib.core tl.check))

;; `shape` shows how the reader read its argument: the head and the elements of a list form, each as the text of its kind and, for a
;; number, its width. The typing of `(simd ..)` is not under test (the macro's argument is a form, never typed), only the reader.
(defmacro shape (f)
  (match f
    ((List items)
     (Str (loop ((i 0) (acc ""))
            (if (< i (vec-count items))
                (recur (+ i 1)
                       (str-join [acc " "
                                  (match (vec-nth items i)
                                    ((Sym s) s)
                                    ((Int v w) (str-join [(show v) (cond (= w :i8) "i8" (= w :i16) "i16" (= w :i32) "i32" :else "i64")]))
                                    ((Flt v w) (str-join [(show v) (if (= w :f32) "f32" "f64")]))
                                    ((Bool b) (if b "true" "false"))
                                    ((List xs) (str-join ["(" (show (vec-count xs)) ")"]))
                                    (_ "?"))]))
                acc))))
    (_ (Str "not a list"))))

(defun main () -> i64
  (let ((c (checks)))
    (do
      (check c (= (shape <<0.1 0.2>>f32) " simd 0.10000000149011612f32 0.20000000298023224f32"))
      (check c (= (shape <<1 2 3>>i8) " simd 1i8 2i8 3i8"))
      (check c (= (shape <<1 -2>>i16) " simd 1i16 -2i16"))
      (check c (= (shape <<127 -128>>i8) " simd 127i8 -128i8"))
      (check c (= (shape <<1 2>>i32) " simd 1i32 2i32"))
      (check c (= (shape <<1 2>>i64) " simd 1i64 2i64"))
      (check c (= (shape <<1 2>>f32) " simd 1.0f32 2.0f32"))
      (check c (= (shape <<1 2.5>>f64) " simd 1.0f64 2.5f64"))
      (check c (= (shape <<16777216 -16777216>>f32) " simd 1.6777216E7f32 -1.6777216E7f32"))
      (check c (= (shape <<1.5f32 2>>f32) " simd 1.5f32 2.0f32"))
      (check c (= (shape <<1i8 2i8>>i8) " simd 1i8 2i8"))
      (check c (= (shape (<<1 2>> f32)) " (3) f32")))
    (checks-result c)))
