;; spec:   types §2.17 (the gpu builtins: atomics are typed by their element)
;; expect: reject
;; error:  .fib:7:33: cannot unify f32 with i32
;; `gpu/atomic-add-i32` takes an i32; an f32 is `gpu/atomic-add-f32`, the other builtin.
(ns main (:require [fib.gpu :as gpu]))
(defun bump (p: ptr) -> i32
  (unsafe (gpu/atomic-add-i32 p 1.0f32)))
(defun main () -> i64 0)
