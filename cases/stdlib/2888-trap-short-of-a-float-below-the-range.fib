;; spec:   stdlib §4.3 (row short), §2.8 (conversions are checked)
;; expect: trap
;; trap:   short: value out of range
;; roots:  ../../lib support
;; covers: short
;; A float below -32768 after the cut: -32768.9 is a short (case 2852), -32769.0 is not.
(defun main () -> i64 (sext i64 (short -32769.0)))
