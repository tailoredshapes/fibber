;; spec:   stdlib §8.1 item 2 (a differential test against a naive reference), §4.4 (rows group-by, frequencies)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: group-by frequencies
;; 300 seeded vectors of 0 to 40 integers in [0, 30) are grouped by `rem x 5`
;; and counted, and every answer is read back with `get` and compared with a
;; plain loop: for each of the five keys, the group is the elements with
;; that key in input order (and absent when there is none); for each of the
;; 30 values, the frequency is how many elements equal it (absent when none),
;; and the Map's size is the number of keys present. Planted fault (method
;; §9.4): the same comparison against a reference that collects its groups
;; backwards and counts one too many must set a bit, else this case fails.
(ns main (:use fib.core fib.seq tl.rng tl.check))

(defun same (a: (Vec i64) b: (Vec i64)) -> bool
  (if (= (vec-count a) (vec-count b))
      (loop ((i 0))
        (if (< i (vec-count a))
            (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false)
            true))
      false))

;; the elements of v whose rem 5 is k, in input order (backwards when `fault`)
(defun members (v: (Vec i64) k: i64 fault: bool) -> (Vec i64)
  (let ((n (vec-count v)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n)
          (let ((x (vec-nth v (if fault (- (- n 1) i) i))))
            (recur (+ i 1) (if (= (rem x 5) k) (vec-conj acc x) acc)))
          acc))))

(defun occurrences (v: (Vec i64) x: i64) -> i64
  (loop ((i 0) (n 0)) (if (< i (vec-count v)) (recur (+ i 1) (if (= (vec-nth v i) x) (+ n 1) n)) n)))

(defun group-matches (g: (Map i64 (Vec i64)) v: (Vec i64) k: i64 fault: bool) -> bool
  (let ((want (members v k fault)))
    (match (get g k)
      (nil (= (vec-count want) 0))
      ((some got) (if (> (vec-count want) 0) (same got want) false)))))

(defun freq-matches (f: (Map i64 i64) v: (Vec i64) x: i64 fault: bool) -> bool
  (let ((want (+ (occurrences v x) (if (if fault (> (occurrences v x) 0) false) 1 0))))
    (match (get f x)
      (nil (= want 0))
      ((some got) (= got want)))))

(defun run (c: Checks fault: bool) -> unit
  (let ((r (rng 341)))
    (dotimes (t 300)
      (let ((v (rng-vec r (rng-below r 41) 30))
            (g (group-by (fn (x) (rem x 5)) v))
            (f (frequencies v)))
        (do (dotimes (k 5) (check c (group-matches g v k fault)))
            (dotimes (x 30) (check c (freq-matches f v x fault)))
            (check c (= (count f)
                        (loop ((x 0) (n 0)) (if (< x 30) (recur (+ x 1) (if (> (occurrences v x) 0) (+ n 1) n)) n))))
            (check c (= (count g)
                        (loop ((k 0) (n 0)) (if (< k 5) (recur (+ k 1) (if (> (vec-count (members v k false)) 0) (+ n 1) n)) n)))))))))

(defun main () -> i64
  (let ((c (checks)) (p (checks)))
    (do (run c false)
        (run p true)
        (check c (= (checks-made c) 11100))
        (check-detects c p)
        (checks-result c))))
