;; spec:   stdlib §4.3 (row short), §2.3 (ToShort), §2.8 (conversions are checked)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: short
;; `(short x)` over an i8 (widened), an i16 (itself), an i32, an i64, an f32 and an f64:
;; 32767 and -32768 are the limits and are shorts from every source; a float is range-checked
;; before it is cut, so 32767.0 is a short and 32767.9 is not (a trap, as Clojure's).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (short 32767) 32767i16))
        (check c (= (short -32768) -32768i16))
        (check c (= (short 0) 0i16))
        (check c (= (short 127i8) 127i16))
        (check c (= (short -128i8) -128i16))
        (check c (= (short -32768i16) -32768i16))
        (check c (= (short 32767i16) 32767i16))
        (check c (= (short 32767i32) 32767i16))
        (check c (= (short -32768i32) -32768i16))
        (check c (= (short 32767.0) 32767i16))
        (check c (= (short -32768.0) -32768i16))
        (check c (= (short 32767.0f32) 32767i16))
        (check c (= (short -32768.0f32) -32768i16))
        (check c (= (short 32767.0) 32767i16))
        (check c (= (short -32768.0) -32768i16))
        (check c (= (short 2.7) 2i16))
        (check c (= (short -2.7) -2i16))
        (check c (= (short 200) (trunc i16 200)))
        (check c (= (trunc i16 32768) -32768i16))
        (checks-result c))))
