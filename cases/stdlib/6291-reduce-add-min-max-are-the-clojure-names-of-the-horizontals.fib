;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; fib.simd reduce-add, reduce-min and reduce-max are hsum, hmin and hmax.
(ns main (:use fib.core fib.simd tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (reduce-add <<1 2 3 4>>i32) 10i32)) (check c (= (reduce-min <<4.5 2.5 3.0>>f64) 2.5)) (check c (= (reduce-max <<4 9 3>>i16) 9i16))
        (let ((p (checks)))
          (do (check p (= (reduce-add <<1 2>>i8) 4i8)) (check-detects c p)))
        (checks-result c))))
