;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: trap
;; trap:   out of memory
;; stage:  2
;; roots:  ../../lib support
;; Test 11 of the design (the fatal list): out of memory is never caught (a handler and the unwinding allocate): the program of
;; ownership/195 inside a try still ends with `trap: out of memory`. A regression guard: no mutant of this package reaches it.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (try (unsafe (let ((p (alloc 1000000000000000))) (do (free p) 7)))
       (catch e 0)))
