;; spec:   types §3.3 (the liberal coverage condition: determination starts at the head), stdlib §7 L16
;; expect: reject
;; error:  type variable k is not a parameter of the impl head
;; `(Cur k j)` would determine `j` from `k` and `(Cur j k)` `k` from `j`, but neither starts at a head variable, so neither is determined.
(ns main (:use fib.core))

(defprotocol (Cur s c) (cur (self) -> c))
(defstruct (Box c) (inner: c))
(impl (Cur c) (Box c) :where ((Cur k j) (Cur j k))
  (cur (self) (. self inner)))

(defun main () -> i64 0)
