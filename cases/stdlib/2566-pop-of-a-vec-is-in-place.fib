;; spec:   stdlib §1.2 P3 (in place when unique), §2.5, §4.4 row pop, tranche 2 plan Y5 and P1
;; expect: accept
;; result: 600
;; audit:  clean
;; allocs: <= 1272
;; roots:  ../../lib support
;; covers: pop
;; 600 pops from a Vec of 640, by the prelude's vec-pop: the run allocates 1272 objects (measured, the interpreter's count), which
;; after the vector's own objects is about 2 a pop (a new tail array and a new header; a pop that takes the last leaf out of the trie
;; copies one path as well). Before P1 each pop rebuilt the rest of the vector: 20773 for the same run, and the bound
;; fails by a factor of sixteen.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (loop ((v (vec (range 640))) (n 0))
    (if (< n 600) (recur (pop v) (+ n 1)) (- 640 (count v)))))
