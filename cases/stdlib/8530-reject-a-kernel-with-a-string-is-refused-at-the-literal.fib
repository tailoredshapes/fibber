;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:7:34: kernel k: a string literal: a kernel has no strings
;; A kernel has no strings: the literal is refused where it is written (not at the lIR level: the position is the source's).
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)) (s "no"))
    (when (< i n) (gpu/f32-set! a i 1.0f32))))
(defun main () -> i64 0)
