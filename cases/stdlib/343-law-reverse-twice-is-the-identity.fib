;; spec:   stdlib §8.1 item 4 (laws), §4.4 (row reverse)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reverse
;; On 300 seeded vectors of 0 to 40 integers: reversing twice gives the
;; vector back, a reverse has the same length, its element i is the source's
;; element n-1-i, and reversing a sort gives the descending order (each
;; element at least the next). The planted fault (method §9.4) reverses once
;; where the law says twice, which must set a bit, else this case fails.
(ns main (:use fib.core fib.seq tl.rng tl.check))

(defun same (a: (Vec i64) b: (Vec i64)) -> bool
  (if (= (vec-count a) (vec-count b))
      (loop ((i 0))
        (if (< i (vec-count a))
            (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false)
            true))
      false))

;; the law's twice, or once when `fault`
(defun back-again (v: (Vec i64) fault: bool) -> (Vec i64)
  (if fault (to-vec (reverse v)) (to-vec (reverse (reverse v)))))

(defun mirrored (v: (Vec i64) r: (Vec i64)) -> bool
  (let ((n (vec-count v)))
    (and (= (vec-count r) n)
         (loop ((i 0)) (if (< i n) (if (= (vec-nth r i) (vec-nth v (- (- n 1) i))) (recur (+ i 1)) false) true)))))

(defun descending (v: (Vec i64)) -> bool
  (loop ((i 1)) (if (< i (vec-count v)) (if (>= (vec-nth v (- i 1)) (vec-nth v i)) (recur (+ i 1)) false) true)))

(defun run (c: Checks fault: bool) -> unit
  (let ((r (rng 343)))
    (dotimes (t 300)
      (let ((v (rng-vec r (rng-below r 41) 100)))
        (do (check c (same (back-again v fault) v))
            (check c (mirrored v (to-vec (reverse v))))
            (check c (descending (to-vec (reverse (sort v)))))
            (check c (= (count (reverse v)) (count v))))))))

(defun main () -> i64
  (let ((c (checks)) (p (checks)))
    (do (run c false)
        (run p true)
        (check c (= (checks-made c) 1200))
        (check-detects c p)
        (checks-result c))))
