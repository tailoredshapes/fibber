;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g] [fib.lacinia.parser :as p]))
(defun main () -> i64
  (let [c (checks) huge (str-from-bytes (array 1048577 97i8))
        deep (str "{" (str-join (vec (repeat 66 "x {"))) "x" (str-join (vec (repeat 67 "}"))))]
    (do (check c (match (p/parse huge) ((Err error) (= (. error kind) g/ResourceLimit)) (_ false)))
      (check c (match (p/parse deep) ((Err error) (= (. error kind) g/ResourceLimit)) (_ false)))
      (let [type (str "query Q($x: " (str-join (vec (repeat 33 "["))) "Int" (str-join (vec (repeat 33 "]!"))) ") { items }")]
        (check c (match (p/parse-document type) ((Err error) (= (. error kind) g/ResourceLimit)) (_ false))))
      (match (g/compile-schema (g/schema {} {"items" (g/resolving (g/list-of (g/named "Int"))
        (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue) (Ok (g/ListValue (vec (repeat 70000 (g/IntValue 1)))))))}))
        ((Err _) (check c false))
        ((Ok compiled) (let [result (g/execute compiled "{ items }" {} g/NullValue)]
          (do (check c (= (count (. result errors)) 1))
            (check c (g/null? (g/field-value (unwrap-or (. result data) g/NullValue) "items")))
            (check c (= (. (nth (. result errors) 0) kind) g/ResourceLimit))))))
      (checks-result c))))
