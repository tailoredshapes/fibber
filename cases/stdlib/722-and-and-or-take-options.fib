;; spec:   stdlib §4.2 (rows and, or), §2.4, §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: and or
;; `and` and `or` are typed by their operands, and an operand may be an
;; Option (truthy when it is a `some`): (and (get m k) (> x 0)) and
;; (or (get m k) (get m j)) are Clojure's text, and `(or (get m k) d)` is
;; the value or the default (case 900 is the `if` and the one `or`). Today
;; the operands are bool: `cannot unify (Option i64) with bool`
;; (A11 t01, t02).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (map-empty) 1 10) 2 20)))
    (do (check c (and (get m 1) (> 5 1)))
        (check c (not (and (get m 3) (> 5 1))))
        (check c (if (or (get m 3) (get m 2)) true false))
        (check c (not (if (or (get m 3) (get m 4)) true false)))
        (check c (= (or (get m 3) 7) 7))
        (check c (= (or (get m 2) 7) 20))
        (checks-result c))))
