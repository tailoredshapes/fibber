;; spec: spec/types.md 1.9 (scalar-generic chunk): (convert e) between integer widths: sext, trunc, identity
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; A narrow negative integer sign-extends (-5i8 is -5 as i64, not 251), a wide one keeps its low bits (300 as i8 is 44, 65537 as i16 is 1), the same type is itself.
(ns main (:use tl.check))

(defun i8->i64 (x: i8) -> i64 (convert x))
(defun i64->i8 (x: i64) -> i8 (convert x))
(defun i32->i16 (x: i32) -> i16 (convert x))
(defun i64->i64 (x: i64) -> i64 (convert x))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (i8->i64 -5i8) -5))
        (check c (= (i8->i64 100i8) 100))
        (check c (= (i64->i8 300) 44i8))
        (check c (= (i64->i8 -1) -1i8))
        (check c (= (i32->i16 65537i32) 1i16))
        (check c (= (i32->i16 -70000i32) -4464i16))
        (check c (= (i64->i64 -9) -9))
        (check c (= (checks-made c) 7))
        (checks-result c))))
