;; spec: spec/syntax.md (Width-generic scalar memory): only the Num types are stored; a bool has no fixed width in memory
;; expect: reject
;; error: no implementation of Num for bool
;; roots: ../../lib
(ns main (:use fib.core))

(defun main () -> i64
  (unsafe
    (let ((p (raw (array 4 0.0))))
      (do (store-scalar p true) 0))))
