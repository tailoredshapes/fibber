;; spec:   stdlib §4.4 (row range), §7 L1
;; expect: accept
;; result: 5
;; audit:  clean
;; roots:  ../../lib
;; covers: range
;; `(range a b step)`: the prelude macro `range` declines a call of three arguments, so the clause `range$3` of the
;; library answers it (L1): 0 2 4 6 8.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (count (range 0 10 2)))
