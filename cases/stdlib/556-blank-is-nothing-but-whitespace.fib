;; spec:   stdlib §4.7 (row clojure.string/blank?), §2.9, plan §6 L10b, C-22
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.string/blank?
;; `(str/blank? s)` is true for the empty string and for a string of nothing but whitespace, in
;; Java's sense (`Character/isWhitespace`, as Clojure's `blank?` has it: so the no-break spaces
;; are not whitespace and a string of them is not blank). One character that is not whitespace,
;; anywhere, makes it false, at the start, in the middle or at the end, whatever its width.
;; Expected values are Java's (`isWhitespace` over every character), not the library's.
(ns main (:use fib.core tl.check) (:require [fib.string :as str]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (str/blank? ""))
        (check c (str/blank? " "))
        (check c (str/blank? "   "))
        (check c (str/blank? " \t\n\r\x0b\x0c "))
        (check c (str/blank? "\x1c\x1d\x1e\x1f"))
        (check c (str/blank? "\u{2003}\u{3000}\u{2028}\u{2029}\u{205f}\u{1680}"))
        (check c (str/blank? "\u{2000}\u{2001}\u{2002}\u{2003}\u{2004}\u{2005}\u{2006}\u{2008}\u{2009}\u{200a}"))
        (check c (not (str/blank? "a")))
        (check c (not (str/blank? " a")))
        (check c (not (str/blank? "a ")))
        (check c (not (str/blank? "  a  ")))
        (check c (not (str/blank? " \t a \n ")))
        (check c (not (str/blank? "0")))
        (check c (not (str/blank? "é")))
        (check c (not (str/blank? " € ")))
        (check c (not (str/blank? "  😀")))
        (check c (not (str/blank? "\u{a0}")))
        (check c (not (str/blank? " \u{a0} ")))
        (check c (not (str/blank? "\u{2007}")))
        (check c (not (str/blank? "\u{202f}")))
        (check c (not (str/blank? "\u{85}")))
        (check c (not (str/blank? "\u{200b}")))
        (check c (not (str/blank? "\u{180e}")))
        (checks-result c))))
