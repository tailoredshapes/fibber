;; spec:   stdlib §2.1 rule 3, §6.3 (R6b: the macro reads a literal (fn (acc x) body+))
;; expect: reject
;; error:  cannot unify i64 with (Step i64)
;; roots:  ../../lib support
;; covers: reduce reduced
;; A literal fn with a `-> R` result type is not the shape the macro rewrites (the type
;; would have to become (Step R)): the call is the library function, whose f is a
;; (fn (a e) a), and the checker refuses the Step the reduced makes. The same fn
;; without the annotation is case 784's.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (reduce (fn (a: i64 x: i64) -> i64 (if (> a 3) (reduced a) (+ a x))) 0 [1 2 3 4]))
