;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (doseq [query ["{ ...Missing @skip(if: true) }" "{ ...A } fragment A on Query { ...A }"
          "{ ...A } fragment A on Query { ...B } fragment B on Query { ...A }"
          "{ person { ...A } } fragment A on Person { friend { ...A } }"
          "{ ...A } fragment A on String { count }" "{ ...A } fragment A on Missing { count }"
          "{ ...A } fragment A on Person { name }" "{ ... on Person { name } }"
          "{ count } fragment Unused on Query { count }"
          "{ ...A } fragment A on Query { count } fragment A on Query { count }"
          "query One($x: String) { ...A } query Two { ...A } fragment A on Query { echo(text: $x) }"]]
          (check c (f/request-error? (g/execute schema query {} g/NullValue))))
        (check c (= @calls 0))))) (checks-result c))))
