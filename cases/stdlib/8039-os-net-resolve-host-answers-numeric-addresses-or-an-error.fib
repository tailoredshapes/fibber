;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll) (:require [fib.os.net :as net]))
(defun main () -> i64
  (let [c (checks)]
    (do (check c (match (net/resolve-host "localhost") ((Ok xs) (> (count xs) 0)) (_ false)))
        (check c (match (net/resolve-host "no-such-host.invalid") ((Err _) true) (_ false)))
        (check c (match (net/resolve-host "") ((Err _) true) (_ false)))
        (check c (match (net/resolve-host "127.0.0.1") ((Ok xs) (= xs ["127.0.0.1"])) (_ false)))
        (checks-result c))))
