;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  kernel k: a call of the extern getpid: a kernel calls no C function
;; A kernel calls no libc: the extern call is refused at the call, naming the extern.
(ns main (:require [fib.gpu :as gpu]))
(extern getpid () -> i32)
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)) (p (sext i64 (getpid))))
    (when (< i n) (gpu/f32-set! a i (sitofp f32 p)))))
(defun main () -> i64 0)
