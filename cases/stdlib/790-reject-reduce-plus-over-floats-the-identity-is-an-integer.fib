;; spec:   stdlib §4.4 (row reduce: the identity table), §6.3 (R6b), §7 L19
;; expect: reject
;; error:  cannot unify f64 with i64
;; roots:  ../../lib support
;; covers: reduce
;; (reduce + c) is (reduce + 0 c): the 0 the macro writes is an i64 literal, which takes
;; its type from nothing (the literal that adopts its type is the item L19), so a sum
;; over f64 is refused where Clojure's (reduce + [1.5 2.5]) is 4.0. The two-argument
;; form with a lambda has no identity and works over any type (case 786).
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (> (reduce + [1.5 2.5]) 3.0) 1 0))
