;; spec:   stdlib §5 M1, §7 L15, types §2.16
;; expect: reject
;; error: def h: a def may not hold a Cell or a Weak: field slot of Holder has type (Cell i64); use an Atom
;; roots:  ../../lib support
;; covers: def
;; The test is on the whole type, through the fields of a struct.
(defstruct Holder (slot: (Cell i64)))

(def h: Holder (Holder (cell 0)))

(defun main () -> i64 0)
