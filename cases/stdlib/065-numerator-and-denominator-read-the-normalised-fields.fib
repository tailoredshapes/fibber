;; spec:   stdlib §4.3 (rows numerator, denominator, Ratio)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: numerator denominator Ratio
;; numerator and denominator give the fields of the normalised ratio, at
;; the width the ratio has: the page's [3 2] for (/ 6 4), a negative
;; numerator and a positive denominator for (/ 6 -4), and a ratio of ratios
;; (the quotient is (1*4)/(2*3) = 2/3). A function over (Ratio t) takes any
;; width.
(ns main (:use fib.core tl.check))

(defun both (r: (Ratio t)) -> (Pair t t) (Pair (numerator r) (denominator r)))

(defun main () -> i64
  (let ((c (checks))
        (a (both (/ 6 4)))
        (b (both (/ 6 -4)))
        (e (both (/ 100i8 -20i8)))
        (f (both (/ (/ 1 2) (/ 3 4)))))
    (do (check c (= (. a fst) 3))
        (check c (= (. a snd) 2))
        (check c (= (. b fst) -3))
        (check c (= (. b snd) 2))
        (check c (= (. e fst) -5i8))
        (check c (= (. e snd) 1i8))
        (check c (= (. f fst) 2))
        (check c (= (. f snd) 3))
        (check c (= (numerator (/ 7i32 14i32)) 1i32))
        (check c (= (denominator (/ 7i32 14i32)) 2i32))
        (checks-result c))))
