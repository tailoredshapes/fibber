;; spec:   stdlib §4.1 (row -), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: -
;; (- a) is the negation (Num's neg), (- a b) the builtin, (- a b c ..) the
;; left fold: (- 10 1 2 3) is 4, not 10 - (1 - 2 - 3). The negation works at
;; every width and on floats.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (a 10))
    (do (check c (= (- 5) -5))
        (check c (= (- -5) 5))
        (check c (= (- 0) 0))
        (check c (= (- a) -10))
        (check c (= (- 7i8) -7i8))
        (check c (= (- 7i16) -7i16))
        (check c (= (- 7i32) -7i32))
        (check c (= (- 2.5) -2.5))
        (check c (= (- 10 3) 7))
        (check c (= (- 10 1 2 3) 4))
        (check c (= (- a 1 2 3 4) 0))
        (check c (= (- 100 (- 1 2 3) 5) 99))
        (check c (= (- 1.5 0.25 0.25) 1.0))
        (check c (= (- (- a) a) -20))
        (checks-result c))))
