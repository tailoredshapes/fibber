;; spec: docs/design/merkle.md
;; expect: trap
;; trap: fib.merkle/append: offset 3 is not after 3
;; roots: ../../lib support
(ns main (:require [fib.merkle :as mk]))
(defun h (b: (Array i8)) -> (Array i8) b)
(defun main () -> i64
  (let [t (. (mk/append (mk/empty-tree) h (array 4 1i8) 3) tree)] (mk/tree-count (. (mk/append t h (array 4 2i8) 3) tree))))
