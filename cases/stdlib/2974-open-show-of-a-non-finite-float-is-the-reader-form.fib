;; spec:   stdlib §2.7 (floats), §4.14 (rows print println)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; open:   X3
;; covers: println
;; Clojure's print and println write a non-finite double as ##Inf ##-Inf ##NaN, and [##Inf] inside a collection
;; (found by differential testing against Clojure 1.12; only (str x) of a bare double says Infinity). The builtin
;; Show of a float writes Infinity, -Infinity, NaN, and a library `impl Show f64` would overlap it, so the
;; change is in the builtin (the interpreter's float text and `show-fp` in fib.rt); X3 owns the printers.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (inf: f64 (/ 1.0 0.0))
        (nan: f64 (/ 0.0 0.0)))
    (do (check c (= (show inf) "##Inf"))
        (check c (= (show nan) "##NaN"))
        (check c (= (show [inf]) "[##Inf]"))
        (println inf)
        (checks-result c))))
