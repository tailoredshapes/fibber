;; spec:   stdlib §4.3 (row unwrap), §1.2 P5, tranche 1 plan §4.3 rule 8
;; expect: trap
;; trap:   unwrap: nil
;; roots:  ../../lib
;; covers: unwrap
;; (unwrap nil) has no payload to give and Clojure would throw, so it
;; traps with a message that names the function (`unwrap: nil`); the program
;; that must recover asks `(unwrap-or o d)` or matches. The Option is a
;; scalar one, a heap object until C5, so the trap leaves a live object that
;; is no leak (method.md rule 3: a trap aborts the program).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((none: (Option i64) nil))
    (unwrap none)))
