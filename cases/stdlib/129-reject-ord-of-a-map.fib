;; spec:   stdlib §2.7 ("Ord for Vec Pair Triple Option List, not for Map and Set: Clojure's compare throws on a map")
;; expect: reject
;; error:  no implementation of Ord for (Map i64 i64)
;; roots:  ../../lib support
;; fib.seq.hash gives a Map `Eq` and `Hash` but no `Ord`: Clojure's `compare`
;; throws on two maps (ClassCastException), and an order that the page does
;; not offer must not appear by accident. The refusal is the checker's, at
;; the `<`; the same program with two Vecs is accepted (case 121).
(ns main (:use fib.seq))

(defun main () -> i64
  (let ((a (assoc (map-empty) 1 2)) (b (assoc (map-empty) 1 3)))
    (if (< a b) 1 0)))
