;; spec:   types §1.9 (tails), docs/design/simd-and-tensors.md 2.7
;; expect: trap
;; trap:   simd-load-tail: index out of range of the array
;; stage:  2
;; roots:  ../../lib support
;; A tail starts at an index from 0 to the length; 11 is past the length of 10 and traps (10 itself is the empty tail, case 6245).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (array 10 1i32)))
    (let ((v: i32x4 (simd-load-tail a 11)))
      (do (println (hsum v)) 0))))
