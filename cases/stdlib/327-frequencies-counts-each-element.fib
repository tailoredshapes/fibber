;; spec:   stdlib §4.4 (row frequencies)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: frequencies
;; frequencies makes a Map from each distinct element to how many times it
;; occurs: strings, integers and chars (all Hash and Eq), from any Reducible
;; source; a source of nothing gives an empty Map, and an element that
;; does not occur is absent (nil), not 0.
(ns main (:use fib.core fib.seq tl.check))

(defun times (m: (Map k i64) k: k) :where ((Hash k) (Eq k)) -> i64
  (match (get m k) (nil -1) ((some n) n)))

(defun main () -> i64
  (let ((c (checks))
        (none: (Vec i64) [])
        (words (frequencies ["a" "b" "a" "c" "b" "a"]))
        (nums (frequencies [3 1 3 3 2 1 100000 -5 -5]))
        (letters (frequencies (str-chars "mississippi"))))
    (do (check c (= (times words "a") 3))
        (check c (= (times words "b") 2))
        (check c (= (times words "c") 1))
        (check c (= (times words "d") -1))
        (check c (= (count words) 3))
        (check c (= (times nums 3) 3))
        (check c (= (times nums 1) 2))
        (check c (= (times nums 2) 1))
        (check c (= (times nums -5) 2))
        (check c (= (times nums 100000) 1))
        (check c (= (count nums) 5))
        (check c (= (times letters \s) 4))
        (check c (= (times letters \i) 4))
        (check c (= (times letters \p) 2))
        (check c (= (times letters \m) 1))
        (check c (= (count letters) 4))
        (check c (= (count (frequencies none)) 0))
        (check c (= (times (frequencies (reverse [1 1 2])) 1) 2))
        (check c (= (times (frequencies (lseq-vec [7 7 7])) 7) 3))
        (check c (= (times (frequencies (some 4)) 4) 1))
        (checks-result c))))
