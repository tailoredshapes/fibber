;; spec:   stdlib §4.3 (rows even? odd?)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: even? odd?
;; even? and odd? look at the lowest bit through Bits, so they are defined
;; for the integer types only and a negative number is right in two's
;; complement: -1 and -3 are odd, -2 and the smallest i8 even.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (even? 0i8))
        (check c (odd? 1i8))
        (check c (odd? -1i8))
        (check c (even? -2i8))
        (check c (odd? 127i8))
        (check c (even? -128i8))
        (check c (not (odd? -128i8)))
        (check c (even? 100i16))
        (check c (odd? -32767i16))
        (check c (even? 2147483646i32))
        (check c (odd? 2147483647i32))
        (check c (even? 0))
        (check c (not (even? 7)))
        (check c (odd? -3))
        (check c (not (odd? -4)))
        (check c (odd? 9223372036854775807))
        (check c (even? -9223372036854775806))
        (checks-result c))))
