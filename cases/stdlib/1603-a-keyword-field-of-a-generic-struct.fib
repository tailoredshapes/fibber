;; spec:   stdlib §7 L14
;; expect: accept
;; result: 42
;; audit:  clean
;; roots:  ../../lib support
;; covers: :k map
;; The field's type is read at the struct's arguments: `:v` of a (Box i64) is an i64, in call position and as
;; the function of `map`.
(defstruct (Box a) (v: a))

(defun main () -> i64
  (let ((bs [(Box 20) (Box 21)]))
    (+ (:v (Box 1)) (- (reduce + 0 (map :v bs)) 0))))
