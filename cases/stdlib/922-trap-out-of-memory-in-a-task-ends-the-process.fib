;; spec:   docs/design/exceptions.md 1.2 (fatal), 4.1 test 8; cases/ownership 195
;; expect: trap
;; trap:   out of memory
;; stage:  2
;; roots:  ../../lib support
;; Out of memory is not a trap a task survives (a handler allocates; the runtime may be half way through an object): the same program as
;; ownership/195 on a task's thread aborts the process, `trap: out of memory`, and `try-join` never sees it. Killed by:
;; scripts/mutant-task-trap.sh `oom-isolated`.
(ns main (:use fib.async))

(defun main () -> i64
  (let ((t (spawn (fn () (unsafe (let ((p (alloc 1000000000000000))) (do (free p) 7)))))))
    (match (try-join t)
      ((Ok v) v)
      ((Err _) 1))))
