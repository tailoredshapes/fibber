;; spec:   stdlib §4.2 (row with), syntax §3.16 (set-field!), plan Y8
;; expect: reject
;; error:  P has no field z
;; roots:  ../../lib support
;; `with` expands to `set-field!`, so a field that the struct does not have is the checker's refusal of set-field!,
;; not a library message: the field name is written in the update and nothing in the macro looks it up
;; (decided here: the macro does not read the struct, which it could not do for a type of another module).
(ns main)

(defrecord P [x: i64 y: i64])

(defun main () -> i64
  (let ((p (->P 1 2)))
    (. (with p (z 3)) y)))
