;; spec: docs/design/gunshoe.md; explicit caller unsafe boundary
;; expect: accept
;; result: 42
;; audit: clean
;; stage: 2
;; roots: ../../lib

(ns main (:require [fib.gunshoe :as g]))
(defun main () -> i64
  (unsafe
    (let [a (cell (g/uninit-array-i8 2)) b (cell (g/uninit-array-f32 2))
          c (cell (g/uninit-array-f64 2))]
      (do (array-set! &a 0 7i8) (array-set! &a 1 8i8)
          (array-set! &b 0 1.5f32) (array-set! &b 1 2.5f32)
          (array-set! &c 0 3.5) (array-set! &c 1 4.5)
          (if (and (= (array-get @a 0) 7i8) (= (array-get @a 1) 8i8)
                   (= (array-get @b 0) 1.5f32) (= (array-get @b 1) 2.5f32)
                   (= (array-get @c 0) 3.5) (= (array-get @c 1) 4.5)) 42 1)))))
