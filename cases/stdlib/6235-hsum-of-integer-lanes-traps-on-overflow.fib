;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in hsum at i8x4
;; stage:  2
;; roots:  ../../lib support
;; The checked left-to-right sum overflows.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i8x4 <<100 100 1 1>>i8))
    (do (println (hsum a)) 0)))
