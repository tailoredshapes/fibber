;; spec:   stdlib §4.1 (row -: (-) is an arity error, as Clojure's), §6.3 (R6a)
;; expect: reject
;; error:  macro - takes at least 1 argument(s), got 0
;; roots:  ../../lib support
;; covers: -
;; Clojure's (-) is an arity exception; here it is an error of the
;; expansion, naming the macro and the count, at the position of the call.
(ns main (:use fib.core))

(defun main () -> i64 (-))
