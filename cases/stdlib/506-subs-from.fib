;; spec:   stdlib §4.3 (row subs, the 2-arity of subs until L1)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: subs
;; `(subs s a)` is `(subs s a (count s))`: from character a to the end.
;; For "aé€😀z", offset 3 is "😀z", offset 0 is the whole string, offset 5, the
;; count, is the empty string (the same boundary subs allows), and the empty
;; string at offset 0 is empty. The two agree at every offset of two strings,
;; compared against `subs` with the count written out.
(ns main (:use fib.core fib.seq tl.check))

(defun agrees (s: str) -> bool
  (loop ((a 0))
    (if (<= a (count s))
        (if (= (subs s a) (subs s a (count s))) (recur (+ a 1)) false)
        true)))

(defun main () -> i64
  (let ((c (checks))
        (s "aé€😀z"))
    (do (check c (= (subs s 3) "😀z"))
        (check c (= (subs s 0) s))
        (check c (= (subs s 5) ""))
        (check c (= (subs s 1) "é€😀z"))
        (check c (= (subs s 4) "z"))
        (check c (= (subs "" 0) ""))
        (check c (= (subs "hello" 2) "llo"))
        (check c (= (count (subs s 2)) 3))
        (check c (agrees s))
        (check c (agrees "héllo wörld, €100 😀"))
        (checks-result c))))
