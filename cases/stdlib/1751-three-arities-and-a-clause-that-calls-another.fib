;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; Three clauses, the third and second written in terms of the others (a clause
;; calls its siblings by the plain name; the expander picks by count), and a
;; clause reached from a function defined above the definition.
(ns main (:use tl.check))

(defun early () -> i64 (volume 2 3 4))

(defn volume
  ([s: i64] -> i64 (volume s s s))
  ([w: i64 h: i64] -> i64 (volume w h 1))
  ([w: i64 h: i64 d: i64] -> i64 (* w (* h d))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (volume 2) 8))
        (check c (= (volume 2 5) 10))
        (check c (= (early) 24))
        (checks-result c))))
