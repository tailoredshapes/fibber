;; spec:   stdlib §7 L19
;; expect: reject
;; error:  cannot unify f64 with i64
;; roots:  support
;; covers: *
;; Only a literal adopts a float type; a variable that holds an integer never does, so
;; (* n 1.5) with n bound to 2 is the old mismatch.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((n 2))
    (if (> (* n 1.5) 2.0) 1 0)))
