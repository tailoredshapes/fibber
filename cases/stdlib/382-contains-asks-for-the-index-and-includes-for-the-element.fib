;; spec:   stdlib §2.3 (Keyed), §4.5 (contains?), Appendix A11 e6 and A12 keyed
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: contains? includes?
;; Clojure's contains? on a vector is the index test: (contains? [10 20] 1)
;; is true and (contains? [10 20] 20) is false, the number being a place and
;; not a member. The same on an array. includes? is the library's element test
;; for the other question, and the two disagree on [10 20] and 20, which is the
;; point of having both. The sizes 32, 33 and 100 are the trie's boundaries.
(ns main (:use fib.core fib.seq fib.coll tl.check))

;; the array 0 10 20 .. 10(n-1)
(defun tens (n: i64) -> (Array i64)
  (let ((c (cell (array n 0))))
    (do (dotimes (i n) (array-set! &c i (* 10 i)))
        @c)))

(defun hundreds (n: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i n) (recur (+ i 1) (conj acc (* 100 i))) acc)))

(defun main () -> i64
  (let ((c (checks))
        (v [10 20])
        (a (tens 3))
        (e (hundreds 0)))
    (do (check c (contains? v 0))
        (check c (contains? v 1))
        (check c (not (contains? v 2)))
        (check c (not (contains? v 20)))
        (check c (not (contains? v -1)))
        (check c (includes? 20 v))
        (check c (not (includes? 1 v)))
        (check c (not (contains? e 0)))
        (check c (not (contains? e -1)))
        (check c (contains? (hundreds 32) 31))
        (check c (not (contains? (hundreds 32) 32)))
        (check c (contains? (hundreds 33) 32))
        (check c (not (contains? (hundreds 33) 33)))
        (check c (contains? (hundreds 100) 99))
        (check c (not (contains? (hundreds 100) 100)))
        (check c (contains? a 0))
        (check c (contains? a 2))
        (check c (not (contains? a 3)))
        (check c (not (contains? a 20)))
        (check c (not (contains? a -1)))
        (check c (not (contains? (tens 0) 0)))
        (checks-result c))))
