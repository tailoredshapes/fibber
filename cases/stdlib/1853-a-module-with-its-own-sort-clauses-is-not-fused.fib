;; spec:   stdlib §2.1 rule 2 (a head the module defines is not the library's), §7 L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sort count defn
;; Same for a terminal: the module's own `sort` (one and two arguments) over a library `map` chain. The
;; library chain under the program's own consumer is left lazy, and the answers are the program's.
(ns main (:use tl.check))

(defn sort
  ([s: (LSeq i64)] -> i64 (count s))
  ([k: i64 s: (LSeq i64)] -> i64 (+ k (count s))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (sort (map (fn (x: i64) x) [3 1 2])) 3))
        (check c (= (sort 10 (map (fn (x: i64) x) [3 1 2])) 13))
        (check c (= (count (fib.seq/sort (map (fn (x: i64) (- 0 x)) [3 1 2]))) 3))
        (checks-result c))))
