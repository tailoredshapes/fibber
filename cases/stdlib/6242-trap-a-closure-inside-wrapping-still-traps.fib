;; spec:   stdlib §7 L10 (the macro `wrapping`)
;; expect: trap
;; trap:   integer overflow in + at i8
;; stage:  2
;; roots:  ../../lib support
;; wrapping does not reach into a fn literal (the closure runs where the macro does not see it): the + in the closure is the checked one and traps.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((r (wrapping (let ((f (fn (x: i8) (+ x 1i8)))) (f 127i8)))))
    (do (println r) 0)))
