;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  kernel k: recursion: even? is on the path k -> even? -> odd? -> even?
;; Mutual recursion through two helpers is a cycle in the kernel's call graph: refused where the cycle closes, with the path.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n) (gpu/f32-set! a i (if (even? i) 1.0f32 0.0f32)))))
(defun even? (n: i64) -> bool
  (if (= n 0) true (odd? (- n 1))))
(defun odd? (n: i64) -> bool
  (if (= n 0) false (even? (- n 1))))
(defun main () -> i64 0)
