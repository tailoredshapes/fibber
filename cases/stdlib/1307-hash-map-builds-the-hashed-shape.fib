;; spec:   stdlib §4.8 (row hash-map), §2.7, §6.3 (E1)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: hash-map
;; (hash-map k v ..) is one map-assoc per pair over the empty hashed Map, `fib.prelude/map-empty-hashed`, the constructor of
;; P1 (today the same value as map-empty, every Map being hashed). The expansion itself is quoted by the Rust test
;; `hash_map_assocs_over_the_hashed_map`.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (hash-map "a" 1 "b" 2 "c" 3)))
    (do (check c (= (count m) 3))
        (check c (= (get m "b") (some 2)))
        (check c (= (count (assoc m "a" 9)) 3))
        (checks-result c))))
