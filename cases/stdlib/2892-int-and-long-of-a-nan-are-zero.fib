;; spec:   stdlib §4.3 (rows int long), §2.8 (conversions are checked)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: int long
;; A NaN converts to 0 for `int` and `long`, as Clojure's casts do (found by differential testing against
;; Clojure 1.12, where (int ##NaN) and (long ##NaN) are 0); `byte` and `short` of a NaN trap (cases 2913, 2914),
;; and so does every infinity (2907 for float; 2893 and 2899 for the integers).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan: f64 (/ 0.0 0.0)))
    (do (check c (= (int nan) 0i32))
        (check c (= (long nan) 0))
        (check c (= (long (neg nan)) 0))
        (checks-result c))))
