;; spec:   stdlib §2.1 rule 5 (the bufferless cursors after L16), §7 L16; cursors.fib header (a cursor that says false stays at the end)
;; expect: accept
;; result: 143
;; audit:  clean
;; roots:  ../../lib support
;; Four walks and a counter. a: a `Dropped` of 2 over four elements pairs the first operand with 30 and 40: (1+30) + (2+40) = 73. b: a `Taken` of 10 over a
;; 7-element source ends when the source does: 7 * 10 = 70. c: `(Taken s 0)` never asks its source for an element, so the counter stays 0 and the sum is 0.
;; d: a `Dropped` past the end of its source is empty: 0. 73 + 70 + 0 + 0 + 0 = 143.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((calls (cell 0)))
    (let ((a (reduce + 0 (ZipWith [1 2] (Dropped [10 20 30 40] 2) (fn (x: i64 y: i64) (+ x y)))))
          (b (reduce + 0 (ZipWith [1 2 3 4 5 6 7] (Taken [10 10 10 10 10 10 10] 10) (fn (x: i64 y: i64) y))))
          (c (reduce + 0 (ZipWith [1 2 3] (Taken (Mapped [1 2 3] (fn (v: i64) (do (set! calls (+ @calls 1)) v))) 0) (fn (x: i64 y: i64) y))))
          (d (reduce + 0 (ZipWith [1 2 3] (Dropped [1 2] 5) (fn (x: i64 y: i64) y)))))
      (+ a (+ b (+ c (+ d @calls)))))))
