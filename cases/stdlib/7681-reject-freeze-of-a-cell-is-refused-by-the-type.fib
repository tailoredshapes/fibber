;; spec:   spec/types.md 5.1, 8.2 (freeze needs Send)
;; expect: reject
;; error:  cell cannot be shared between threads
;; stage:  2
;; roots:  ../../lib support
;; covers: freeze
;; A cell is never `Send` (a published graph is read by every thread with no lock): `freeze` carries the bound `(Send a)`, so the type
;; shows it, here a cell inside a Vec.
(ns main)

(defun main () -> i64
  (let ((v (freeze [(cell 1) (cell 2)])))
    (count v)))
