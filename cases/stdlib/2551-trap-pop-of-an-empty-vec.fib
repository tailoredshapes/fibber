;; spec:   stdlib §2.3 (Stack), §4.4 row pop, §1.2 P5
;; expect: trap
;; trap:   pop: empty
;; roots:  ../../lib support
;; covers: pop
;; Clojure's (pop []) throws, so here it traps, with the function's name in the message (tranche 1 plan §4.3 rule 8). The
;; vector comes from popping the only element of [7], so the program has a stack that was not empty a moment ago;
;; peek of the same empty vector is nil and does not trap (case 2554).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((emptied (pop [7])))
    (count (pop emptied))))
