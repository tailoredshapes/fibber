;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §1.2 P5
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: range
;; A negative index is out of range, not the last element and not the first: (range 5) has indexes 0 to 4.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (nth (range 5) -1))
