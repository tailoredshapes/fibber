;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (doseq [query ["{ missing @skip(if: true) }" "{ required @skip(if: true) }"
          "{ count @skip(if: \"yes\") }" "{ count @skip }" "{ count @skip(if: true, extra: 1) }"
          "{ count @skip(if: false) @skip(if: true) }" "{ count @unknown(if: true) }"
          "query @skip(if: true) { count }" "{ ...A } fragment A on Query @include(if: true) { count }"
          "{ same: count @skip(if: true) same: echo }"
          "query($x: String, $y: String) { same: echo(text: $x) same: echo(text: $y) }"]]
          (check c (f/request-error? (g/execute schema query {"x" (g/StringValue "equal") "y" (g/StringValue "equal")} g/NullValue))))
        (check c (= @calls 0))))) (checks-result c))))
