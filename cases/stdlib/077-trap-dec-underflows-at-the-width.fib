;; spec:   stdlib §4.3 (row dec: traps on overflow), §2.8
;; expect: trap
;; trap:   integer overflow in - at i8
;; roots:  ../../lib
;; covers: dec
;; dec is the builtin - with a one, so the smallest i8 less one traps with the
;; builtin's text, naming the width (case 051 is the other end of inc).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (dec -128i8)))
    (if (= x 0i8) 1 2)))
