;; spec:   stdlib §7 L14
;; expect: reject
;; error:  Person has no field :salary
;; roots:  ../../lib support
;; covers: :k
;; A keyword over a struct that has no such field is refused, quoting the struct and the keyword.
(defstruct Person (name: str age: i64))

(defun main () -> i64
  (:salary (Person "ann" 30)))
