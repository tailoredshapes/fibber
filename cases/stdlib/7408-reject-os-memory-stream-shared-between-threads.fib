;; spec: docs/design/os.md
;; expect: reject
;; error: cannot be shared between threads
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.os.memory-stream :as m]))
(defun main () -> i64
  (match (m/open-stream 8)
    ((Err _) 1)
    ((Ok stream) (join (spawn (fn () (do (m/close-stream stream) 0)))))))
