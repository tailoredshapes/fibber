;; spec:   stdlib §6.3 (E3); syntax §3.18
;; expect: reject
;; error:  malformed loop: a binding is a pattern and an expression, or name: a type and an expression
;; roots:  ../../lib support
;; covers: loop
;; A name that ends in a colon takes the next form as its type and the one after as its value, three
;; items; two are not a binding.
(ns main (:use fib.core))

(defun main () -> i64
  (loop [i: i64]
    i))
