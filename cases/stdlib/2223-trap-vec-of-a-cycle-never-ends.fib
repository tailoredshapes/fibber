;; spec:   stdlib §4.4 (rows cycle, vec), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   to-vec: never ends
;; roots:  ../../lib support
;; covers: cycle vec
;; Vec of a cycle of a source that has elements: the to-vec method traps. The cycle of an empty source is [] (case 2218).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (count (vec (cycle [1 2 3]))))
