;; spec:   stdlib §2.3 (Emptyable)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; empty takes a collection and returns the empty one of its type: the
;; witness form of Clojure's (empty c), which has no type to ask of nobody.
;; The Vec's instance is P0's; L8a and L8b add the rest.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (e (empty [1 2 3])))
    (do (check c (= (count e) 0))
        (check c (= (count (conj e 4)) 1))
        (check c (= (count (empty (empty [9]))) 0))
        (checks-result c))))
