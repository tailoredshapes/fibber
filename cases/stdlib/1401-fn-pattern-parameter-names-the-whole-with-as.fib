;; spec:   stdlib §7 L7 (`(PAT :as p)` in a fn literal)
;; expect: accept
;; result: 33
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce
;; `([k v] :as e)` binds the pattern's names and `e` to the whole argument: each element adds
;; k, v and the length of e (2), so [1 2] [3 4] gives 5 + 9 = 14 on top of the start 19.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (reduce (fn (acc ([k v] :as e)) (+ acc (+ k (+ v (count e))))) 19 [[1 2] [3 4]]))
