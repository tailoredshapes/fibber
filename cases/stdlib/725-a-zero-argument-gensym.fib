;; spec:   stdlib §4.3 (row gensym), §7 L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: gensym
;; Clojure's (gensym) makes a symbol with a default prefix, and
;; (gensym prefix) one with the prefix: two clauses of one name, which is
;; arity overloading (L1): the expander gives the call the default prefix, G__.
(ns main (:use tl.check))

(defmacro fresh-one ()
  (let ((t (gensym)))
    `(let ((~t 1)) (+ ~t 1))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (fresh-one) 2))
        (checks-result c))))
