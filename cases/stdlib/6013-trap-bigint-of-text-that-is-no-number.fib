;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: trap
;; trap:   bigint: not a number
;; roots:  ../../lib
;; covers: bigint
;; `(bigint "12x4")` traps where Clojure's throws NumberFormatException; `parse-bigint` is the Option form
;; (case 6014).
(ns main (:use fib.bigint))

(defun main () -> i64 (do (println (bigint "12x4")) 0))
