;; spec:   stdlib §4.4 row reduce-kv, §2.3 (KeyReducible has one method, each-kv-while)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce-kv
;; reduce-kv is written over (KeyReducible m k v), so a type of the program's own that implements each-kv-while has it. A Pile
;; of n holds the numbers 0 .. n-1 under the keys 0 .. n-1 as 10 times the key (as in case 019); a sum of key plus value over a
;; Pile of 4 is (0 + 0) + (1 + 10) + (2 + 20) + (3 + 30) = 66, and over an empty pile is the initial value.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defstruct Pile (n: i64))

(impl (KeyReducible i64 i64) Pile
  (each-kv-while (self k)
    (loop ((i 0)) (if (< i (. self n)) (if (k i (* 10 i)) (recur (+ i 1)) false) true))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (reduce-kv (fn (acc k v) (+ acc (+ k v))) 0 (Pile 4)) 66))
        (check c (= (reduce-kv (fn (acc k v) (+ acc (+ k v))) 7 (Pile 0)) 7))
        (check c (= (reduce-kv (fn (acc k v) (+ acc 1)) 0 (Pile 12)) 12))
        (checks-result c))))
