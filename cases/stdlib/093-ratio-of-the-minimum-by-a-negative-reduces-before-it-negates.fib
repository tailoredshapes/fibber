;; spec:   stdlib §2.8 ((Ratio t): normalised), §4.1 (row /), review finding of L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / numerator denominator
;; (/ -128i8 -2i8) is 64/1 and fits an i8, but a normaliser that negates both
;; components before it divides by the gcd negates -128, which does not fit,
;; and traps `integer overflow in neg at i8`. The ratio is reduced first and
;; the sign is fixed last, so a ratio traps only when its normalised
;; components do not fit the width. Around the minimum of i8: the minimum by
;; itself, by a negative divisor that goes in evenly and one that does not,
;; and the minimum under a zero numerator.
(ns main (:use fib.core tl.check))

(defun is (r: (Ratio i8) n: i8 d: i8) -> bool
  (and (= (numerator r) n) (= (denominator r) d)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (is (/ -128i8 -2i8) 64i8 1i8))
        (check c (is (/ -128i8 -4i8) 32i8 1i8))
        (check c (is (/ -128i8 -64i8) 2i8 1i8))
        (check c (is (/ -128i8 -128i8) 1i8 1i8))
        (check c (is (/ -128i8 -6i8) 64i8 3i8))
        (check c (is (/ -126i8 -3i8) 42i8 1i8))
        (check c (is (/ -128i8 2i8) -64i8 1i8))
        (check c (is (/ -128i8 5i8) -128i8 5i8))
        (check c (is (/ -128i8 127i8) -128i8 127i8))
        (check c (is (/ 0i8 -128i8) 0i8 1i8))
        (check c (is (/ 64i8 -128i8) -1i8 2i8))
        (check c (is (/ 127i8 -127i8) -1i8 1i8))
        (check c (is (/ -127i8 -127i8) 1i8 1i8))
        (check c (is (/ -1i8 -1i8) 1i8 1i8))
        (check c (= (checks-made c) 14))
        (checks-result c))))
