;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:10:12: kernel k: heap data of type (Vec i64): a kernel allocates nothing (reached through k -> helper)
;; The rules apply to every function a kernel reaches (`:kernel-pure` is inferred): a helper that binds a Vec is refused at the binding, and the message names the path from the kernel.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n) (gpu/f32-set! a i (sitofp f32 (helper i))))))
(defun helper (i: i64) -> i64
  (let ((v [1 2 3]))
    (+ i (count v))))
(defun main () -> i64 0)
