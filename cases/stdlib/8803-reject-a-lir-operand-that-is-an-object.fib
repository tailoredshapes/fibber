;; spec:   syntax §3.15a (lir), §3.15 (extern positions)
;; expect: reject
;; error:  extern positions are scalars, ptr or unit
;; stage:  2
;; roots:  ../../lib support
;; Operands are scalars and `ptr`, as an extern's are: an object never crosses into lIR, so ownership has nothing to track there.
(ns main (:use fib.core))

(defun f (v: (Vec i64)) -> i64 (unsafe (lir [v: (Vec i64)] -> i64 "(block entry (ret (i64 0)))")))

(defun main () -> i64 (f [1]))
