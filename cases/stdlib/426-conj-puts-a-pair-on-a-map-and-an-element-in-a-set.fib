;; spec:   stdlib §2.3 (Collection: Map of Pair, Set), §4.5 (row conj)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: conj key val
;; conj on a Map takes a Pair (Clojure's map entry; a two-element Vec waits
;; for L23): the key and the value land as assoc would put them, a pair for a
;; key that is there replaces its value, and conj of an element a Set holds is
;; the same Set. The result type is the collection's own (Collection s r e
;; with r = s), so the chain of conj needs no annotation. key and val read a
;; Pair back (the page's map entry).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (m (conj (conj (conj (empty {1 0}) (Pair 1 10)) (Pair 2 20)) (Pair 1 11)))
        (s (conj (conj (conj (empty (set [0])) 3) 4) 3))
        (p (Pair "k" 7)))
    (do (check c (= (count m) 2))
        (check c (is (get m 1) 11))
        (check c (is (get m 2) 20))
        (check c (= (count s) 2))
        (check c (contains? s 3))
        (check c (contains? s 4))
        (check c (not (contains? s 0)))
        (check c (= (key p) "k"))
        (check c (= (val p) 7))
        (check c (= (key (Pair 5 6)) 5))
        (checks-result c))))
