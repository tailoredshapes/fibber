;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: trap
;; trap:   long: value out of range
;; roots:  ../../lib
;; covers: long
;; `(long x)` of a BigInt that does not fit an i64 traps, as Clojure's `(long (bigint ..))` throws: 2^63 is the
;; first value above the maximum (the minimum, -2^63, converts: case 6014).
(ns main (:use fib.bigint))

(defun main () -> i64 (long (expt (bigint 2) 63)))
