;; spec:   stdlib §4.2 (row assert), syntax §4.4
;; expect: trap
;; trap:   balance went negative: 3
;; covers: assert
;; (assert c msg) is (if c () (trap msg)): always on, never compiled out,
;; and the message is built when the assertion fails and not before. The
;; first two withdrawals hold their assertions and the program goes on;
;; the third breaks the second assertion and stops the program with its
;; message, which names the balance the third call was given (3), so
;; that an assertion that fired earlier, or on a call that held, would
;; say another number.
(defun withdraw (balance: i64 amount: i64) -> i64
  (do (assert (>= amount 0) "negative amount")
      (assert (>= balance amount) (str-concat "balance went negative: " (show balance)))
      (- balance amount)))

(defun main () -> i64
  (do (assert (= (withdraw 10 4) 6) "withdraw 10 4 is not 6")
      (assert (= (withdraw 5 5) 0) "withdraw 5 5 is not 0")
      (withdraw 3 4)))
