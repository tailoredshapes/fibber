;; spec:   stdlib §4.4 (row repeatedly: memoised, f runs once per element across traversals), §2.1 rule 2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: repeatedly take first reduce vec
;; (repeatedly f) is an LSeq: a node is made when it is first demanded and read ever after. f counts its
;; calls and answers the count. Nothing runs when the seq is made; `first` runs f once; the first three
;; elements summed twice, 1 + 2 + 3 each time, make three calls in all and not six; a longer take
;; adds only the new elements. The elements never change from one traversal to the next.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (calls (cell 0)))
    (let ((s (repeatedly (fn () (do (set! calls (+ @calls 1)) @calls)))))
      (let ((three (take 3 s)))
        (do (check c (= @calls 0))
            (check c (= (first s) (some 1)))
            (check c (= @calls 1))
            (check c (= (reduce (fn (a x) (+ a x)) 0 three) 6))
            (check c (= (reduce (fn (a x) (+ a x)) 0 three) 6))
            (check c (= @calls 3))
            (check c (= (vec (take 5 s)) [1 2 3 4 5]))
            (check c (= @calls 5))
            (check c (= (vec (take 5 s)) [1 2 3 4 5]))
            (check c (= @calls 5))
            (checks-result c))))))
