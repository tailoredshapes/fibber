;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §1.2 P5
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib
;; nth is the one of Clojure's lookups that throws on a bad index, so here
;; it traps, with a message that names the function. The default nth walks
;; with each-while, so a user type that gave only each-while gets the trap
;; too: the index is one past the last element of a two-element tree.
(ns main (:use fib.core fib.seq))

(defenum (Tree a) Leaf (Node l: (Tree a) v: a r: (Tree a)))

(defun tree-each (t: (Tree a) k: (fn (a) bool) :borrow) -> bool
  (match t
    ((Leaf) true)
    ((Node l v r) (if (tree-each l k) (if (k v) (tree-each r k) false) false))))

(impl (Reducible a) (Tree a) (each-while (self k) (tree-each self k)))

(defun main () -> i64 (nth (Node (Node Leaf 1 Leaf) 2 Leaf) 2))
