;; spec:   stdlib §7 L3b (tuple patterns), §2.3; probe P14
;; expect: accept
;; result: 8363
;; audit:  clean
;; roots:  ../../lib support
;; `(match (Pair 1 2) ([a b] ..))` was `cannot unify (Pair i64 i64) with (Vec a)`. A vector
;; pattern against a Pair or Triple matches the fields in order and exactly, so one clause is
;; exhaustive with no `_` after it; a literal inside it is a refutable field, so the second
;; match needs its `_`. The same patterns run in a let.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((p (Pair 1 2))
        (t (Triple 3 4 5)))
    (+ (+ (match p ([a b] (+ a b)))
          (match t ([a b c] (+ (* a 100) (+ (* b 10) c)))))
       (+ (match (Pair 7 8) ([7 y] (* y 1000)) (_ 0))
          (let (([a b] p) ([x y z] t)) (+ a (+ b (+ x (+ y z)))))))))
