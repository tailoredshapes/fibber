;; spec:   stdlib §2.8 (the components trap on overflow at their width), review finding of L1
;; expect: trap
;; trap:   integer overflow in / at i64
;; roots:  ../../lib
;; covers: /
;; Case 095 at i64: the minimum over -1 is 2^63, which does not fit.
(ns main (:use fib.core))

(defun main () -> i64
  (numerator (/ (- -9223372036854775807 1) -1)))
