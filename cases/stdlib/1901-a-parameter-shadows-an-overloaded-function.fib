;; spec:   stdlib §7 L1 (a name a form binds is not the clause set), expander scope
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; covers: defn
;; A parameter called `pick` is the caller's function, in a `defun` and in a `fn`, whatever
;; its argument count; and it is passed on as a value, which is the local and not a clause.
(defn pick
  ([a: i64] -> i64 (* a 10))
  ([a: i64 b: i64] -> i64 (+ a b)))

(defun apply3 (pick: (fn (i64 i64 i64) i64)) -> i64
  (pick 1 2 3))

(defun hand-on (pick: (fn (i64) i64)) -> i64
  (apply3 (fn (a: i64 b: i64 c: i64) -> i64 (+ (pick a) (+ b c)))))

(defun main () -> i64
  (let ((viafn ((fn (pick: (fn (i64 i64 i64) i64)) -> i64 (pick 4 5 6)) (fn (a: i64 b: i64 c: i64) -> i64 (* a (* b c))))))
    (if (= (apply3 (fn (a: i64 b: i64 c: i64) -> i64 (+ a (+ b c)))) 6)
        (if (= viafn 120)
            (if (= (hand-on pick) 15) 0 3)
            2)
        1)))
