;; spec:   stdlib §7 D1, §2.4 (the condition rows), §5.5 S1
;; expect: reject
;; error:  a value of type i64 is always true; write the test
;; roots:  ../../lib
;; covers: if
;; Clojure's `(if n ..)` tests for nil and false; here a condition is a bool
;; (or, after §7 L20, an Option), and a primitive that is not a bool can never
;; be false. The error says so instead of `cannot unify i64 with bool`; `when`,
;; `while`, `cond`, `and` and `or` expand to `if` and say it too. A condition of
;; any other type, an Option today, is still the plain mismatch (case 900).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((n 5))
    (if n 1 2)))
