;; spec: docs/design/relational-search.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (empty: (Map i64 l/Term) {})
        (aliases (l/unify (l/Var 0) (l/Var 1) empty)))
    (do (check c (= (l/unify (l/Var 0) (l/pair (l/integer 1) (l/Var 0)) empty) nil))
        (check c (= (l/unify (l/Var 0) (l/Var 0) empty) (some empty)))
        (match aliases
          ((some bindings)
            (do (check c (= (l/walk (l/Var 0) bindings) (l/Var 1)))
                (check c (= (l/unify (l/Var 1) (l/pair (l/Var 0) (l/nil-term)) bindings) nil))
                (check c (= (l/walk (l/Var 0) empty) (l/Var 0)))
                (check c (= (l/unify (l/pair (l/Var 0) (l/integer 2))
                                    (l/pair (l/integer 1) (l/integer 3)) bindings) nil))
                (check c (= (l/walk (l/Var 0) bindings) (l/Var 1)))))
          (nil (check c false)))
        (checks-result c))))
