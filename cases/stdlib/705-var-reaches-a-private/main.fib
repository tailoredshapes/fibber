;; spec:   stdlib §4.2 (row var), syntax §3.20, §5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../support
;; covers: var
;; (var m/x) is the one reference that sees a private definition of another
;; module, and the one that names a top-level definition only. Here it
;; reaches a private function and a private `def` of util, beside a public
;; function of the same module; a local binding of the name of a function
;; does not hide it from `var` (the plain symbol sees the local); and in
;; the head of a call `((var f) x)` is the direct call `(f x)`.
(ns main (:require [util :as u]) (:use tl.check))

(defun double (n: i64) -> i64 (* n 2))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= ((var u/secret) 1) 41))
        (check c (= (var u/limit) 7))
        (check c (= (u/open) 42))
        (check c (= ((var u/secret) (var u/limit)) 47))
        (let ((double 100))
          (do (check c (= ((var double) 4) 8))
              (check c (= double 100))))
        (checks-result c))))
