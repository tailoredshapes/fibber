;; spec:   stdlib §7 L14
;; expect: reject
;; error:  is a struct, a default needs a map
;; roots:  ../../lib support
;; covers: :k
;; A field is always there, so `(:k p d)` over a struct has no use for d: refused rather than ignored.
(defstruct Person (name: str age: i64))

(defun main () -> i64
  (:age (Person "ann" 30) 0))
