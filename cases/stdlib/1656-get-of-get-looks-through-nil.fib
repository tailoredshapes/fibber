;; spec:   stdlib §2.3 (row Lookup: `(Option s)` after L16), §7 L16, types §3.3
;; expect: accept
;; result: 32
;; audit:  clean
;; roots:  ../../lib support
;; `(get (get m :a) :b)` is `get` on an `(Option (Map ..))`: the impl `(impl (Lookup k v) (Option s) :where ((Lookup s k v)) ..)` names `k` and `v`, which
;; the inner Lookup determines. A present path answers its value (30 here); a miss at either step is nil, which `unwrap-or` turns into 1: 30 + 1 + 1.
(ns main (:use fib.core fib.coll))

(defun main () -> i64
  (let ((m {:a {:b 30} :c {}}))
    (+ (unwrap-or (get (get m :a) :b) 0)
       (+ (unwrap-or (get (get m :z) :b) 1)
          (unwrap-or (get (get m :c) :b) 1)))))
