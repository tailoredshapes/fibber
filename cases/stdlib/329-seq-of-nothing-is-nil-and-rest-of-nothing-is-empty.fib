;; spec:   stdlib §4.4 (rows seq, rest, next), §2.4 (nil is Option's empty variant)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: seq rest next
;; Clojure's `(seq [])` is nil and `(rest [])` is `()`, not nil: so here `seq`
;; of an empty collection is nil, `rest` is the empty seq of its type, rest
;; again stays empty, and `next` is nil for a collection of none or one.
;; Checked on every collection that has a seq today: an empty Vec, List
;; (the reverse of nothing), sort (a VSeq), lazy seq, Array and Option; and
;; on the end of a Vec walked to its last element.
(ns main (:use fib.core fib.seq tl.check))

(defun is-empty (s: (Option t)) -> bool (match s (nil true) ((some _) false)))

(defun main () -> i64
  (let ((c (checks))
        (v: (Vec i64) [])
        (l: (List i64) (reverse (vec-empty)))
        (sv: (VSeq i64) (sort (vec-empty)))
        (ls: (LSeq i64) (lseq-vec (vec-empty)))
        (a: (Array i64) (array 1 0))
        (nothing: (Option i64) nil)
        (one [4]))
    (do (check c (is-empty (seq v)))
        (check c (is-empty (seq l)))
        (check c (is-empty (seq sv)))
        (check c (is-empty (seq ls)))
        (check c (is-empty (seq nothing)))
        (check c (is-empty (seq (rest v))))
        (check c (is-empty (seq (rest l))))
        (check c (is-empty (seq (rest sv))))
        (check c (is-empty (seq (rest ls))))
        (check c (is-empty (seq (rest nothing))))
        (check c (is-empty (seq (rest (rest v)))))
        (check c (= (count (rest v)) 0))
        (check c (= (count (rest l)) 0))
        (check c (= (count (rest sv)) 0))
        (check c (= (count (rest ls)) 0))
        (check c (= (count (rest nothing)) 0))
        (check c (is-empty (next v)))
        (check c (is-empty (next l)))
        (check c (is-empty (next sv)))
        (check c (is-empty (next ls)))
        (check c (is-empty (next nothing)))
        (check c (is-empty (next one)))
        (check c (is-empty (next (some 1))))
        (check c (is-empty (next (array 1 3))))
        (check c (is-empty (seq (rest one))))
        (check c (match (seq a) (nil false) ((some s) (= (nth s 0) 0))))
        (check c (is-empty (seq (rest a))))
        (checks-result c))))
