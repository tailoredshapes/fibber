;; spec:   stdlib §4.3 (row char), §2.8 (conversions are checked)
;; expect: trap
;; trap:   char: value out of range
;; roots:  ../../lib support
;; covers: char
;; 0x110000 is the first value above the scalar range: 1114111 is a character (case 2850).
(defun main () -> i64 (sext i64 (char->i32 (char 1114112i32))))
