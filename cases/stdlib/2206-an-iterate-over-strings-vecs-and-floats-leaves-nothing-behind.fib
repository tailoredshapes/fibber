;; spec:   stdlib §4.4 (row iterate: (fn (a) a) a -> (Iterate a)), method.md rule 2 (the audit)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: iterate take vec nth last
;; The element type is any type: strings that grow, Vecs that grow and floats that double, read
;; by a fused chain, by a bound lazy seq and by nth. Every element is a value made by f
;; and handed to the consumer, and the run ends with a clean audit: no element, no closure and no
;; node is left behind by a walk that the consumer stopped.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (grow (iterate (fn (s: str) (str-concat s "ab")) ""))
        (stack (iterate (fn (v: (Vec i64)) (conj v (count v))) [])))
    (do (check c (= (vec (take 3 grow)) ["" "ab" "abab"]))
        (check c (= (nth grow 4) "abababab"))
        (let ((s (take 3 grow)))
          (check c (= (last s) (some "abab"))))
        (check c (= (vec (take 4 stack)) [[] [0] [0 1] [0 1 2]]))
        (check c (= (nth stack 5) [0 1 2 3 4]))
        (check c (= (vec (take 4 (iterate (fn (x: f64) (* x 2.0)) 1.5))) [1.5 3.0 6.0 12.0]))
        (check c (= (vec (take 3 (iterate (fn (x: i32) (+ x 1i32)) 7i32))) [7i32 8i32 9i32]))
        (checks-result c))))
