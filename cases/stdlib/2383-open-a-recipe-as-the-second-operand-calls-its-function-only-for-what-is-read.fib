;; spec:   stdlib §2.1 rule 5 (the bufferless cursors after L16), §7 L16, tranche 2 plan Y3 (W2)
;; expect: accept
;; result: 1
;; audit:  clean
;; roots:  ../../lib support
;; open:   X7
;; A hand-built `Zipped` whose second operand is a `Mapped` recipe, of which the program reads the first pair. A cursor that pulls one element
;; per `advance!` calls the function once; the buffering cursor of today builds the whole Vec of the recipe when the walk starts and calls it
;; for all 5 elements, so main answers 5 and the case is OPEN for X7.
;; The answer 1 is worked out by hand for the day X7 lands, not run.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((calls (cell 0)))
    (do (first (Zipped [1 2 3 4 5] (Mapped [10 20 30 40 50] (fn (a: i64) (do (set! calls (+ @calls 1)) a)))))
        @calls)))
