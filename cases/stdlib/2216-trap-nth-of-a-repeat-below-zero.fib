;; spec:   stdlib §4.4 (rows repeat, nth), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: repeat nth
;; Nth of an index below zero is out of range, though every other index is the element, answered without a walk.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (nth (repeat 4) -1))
