;; spec:   stdlib §2.7 (the table of the printers), §4.14 (rows println print prn), §6.3 (R5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: println print prn pr newline
;; (println a b ..) writes the Show text of each argument, one space between two,
;; and a newline; print is the same without the newline; prn and pr are the two over Debug
;; (strings quoted, a char with its backslash); a literal nil is the word nil in all four
;; (the page's table: (println nil) prints nil); a string literal is its own Show text;
;; no argument writes the empty text. A case never prints to compare, so what this
;; program writes is checked by crates/fibref/tests/print_macros.rs and
;; crates/fibc/tests/print_macros.rs, which run it under each tool and compare its
;; standard output with the 13 lines they hold; the program's own result is
;; the sum of the checks that each call answers unit.
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check))

(defun unit? (u: unit) -> bool true)

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (unit? (println 5 "a" true)))
        (check c (unit? (println)))
        (check c (unit? (println "solo")))
        (check c (unit? (println nil)))
        (check c (unit? (println "k" nil 2)))
        (check c (unit? (print "x" 1)))
        (check c (unit? (print)))
        (check c (unit? (newline)))
        (check c (unit? (prn "q" ["a" "b"] nil)))
        (check c (unit? (pr \a 1.5)))
        (check c (unit? (newline)))
        (check c (unit? (println ["a" "b"] (some "a") (some 3))))
        (check c (unit? (prn (some "a") \space)))
        (check c (unit? (println (list 1 2) (Pair 1 2) (conj (set-empty) 7))))
        (check c (unit? (pr)))
        (check c (unit? (prn)))
        (check c (unit? (println "é" (i32->char 128512i32))))
        (checks-result c))))
