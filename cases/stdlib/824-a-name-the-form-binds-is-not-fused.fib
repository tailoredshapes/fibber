;; spec:   stdlib §2.1 rule 2 (a head the form binds is not the library's), tranche 1 plan R9
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map count
;; A parameter, a `let` name and a pattern variable can each be called `count` or `map`, and the
;; call is then the program's. Here `count` is a parameter of type (fn ((LSeq i64)) i64): had the
;; rewrite fused its argument it would pass a recipe where a seq is wanted, and the program would
;; not type-check; a `let`-bound `map` that returns a plain Vec likewise. The last check is the
;; same function with the library's `count`, which is fused and is the same number.
(ns main (:use fib.core fib.seq tl.check))

(defun via (count: (fn ((LSeq i64)) i64) v: (Vec i64)) -> i64
  (count (map (fn (x: i64) (* x 2)) v)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (via (fn (s: (LSeq i64)) (+ 1000 (sum s))) [1 2 3]) 1012))
        (let ((map (fn (f: (fn (i64) i64) v: (Vec i64)) -> (Vec i64) [7 7])))
          (check c (= (sum (map (fn (x: i64) x) [1 2 3])) 14)))
        (check c (= (count (map (fn (x: i64) (* x 2)) [1 2 3])) 3))
        (checks-result c))))
