;; spec:   stdlib §2.1 rule 2, §4.4 rows zip, map/3, interleave; Clojure's map and interleave of two seqs (`(and (seq c1) (seq c2))`)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: zip map interleave
;; Clojure's two-seq `map` and `interleave` take `(seq c1)` and `(seq c2)` before they look at either, so the first node of
;; the second operand is made even when the first operand is empty, and the other way round. The lockstep seqs here do
;; the same (recalled from Clojure's source, which was not run: there is none on this machine); the fused walk, which asks the
;; second operand only for an element of the first, differs from this within the latitude the page allows. The sources are
;; lazy seqs that count the nodes made; the first operand empty makes one node of the second, an empty second operand one
;; of the first, and both empty make one of each. f of map/3 is never called when either side is empty.
(ns main (:use fib.core fib.seq tl.check))

(defun countdown (n: i64 nodes: (Cell i64)) -> (LSeq i64)
  (lazy-node (fn () (do (set! nodes (+ @nodes 1))
                        (if (> n 0) (LCons n (countdown (- n 1) nodes)) LNil)))))

;; the first node of z, demanded
(defun demand (z: (LSeq a)) -> bool (match (lfirst z) (nil false) ((some _) true)))

(defun main () -> i64
  (let ((c (checks))
        (na (cell 0)) (nb (cell 0)) (calls (cell 0)))
    (do (check c (not (demand (zip (countdown 0 na) (countdown 5 nb)))))
        (check c (and (= @na 1) (= @nb 1)))
        (set! na 0) (set! nb 0)
        (check c (not (demand (zip (countdown 5 na) (countdown 0 nb)))))
        (check c (and (= @na 1) (= @nb 1)))
        (set! na 0) (set! nb 0)
        (check c (not (demand (map (fn (x: i64 y: i64) (do (set! calls (+ @calls 1)) x))
                                        (countdown 0 na) (countdown 5 nb)))))
        (check c (and (= @na 1) (and (= @nb 1) (= @calls 0))))
        (set! na 0) (set! nb 0)
        (check c (not (demand (map (fn (x: i64 y: i64) (do (set! calls (+ @calls 1)) x))
                                        (countdown 5 na) (countdown 0 nb)))))
        (check c (and (= @na 1) (and (= @nb 1) (= @calls 0))))
        (set! na 0) (set! nb 0)
        (check c (not (demand (interleave (countdown 0 na) (countdown 5 nb)))))
        (check c (and (= @na 1) (= @nb 1)))
        (set! na 0) (set! nb 0)
        (check c (not (demand (interleave (countdown 5 na) (countdown 0 nb)))))
        (check c (and (= @na 1) (= @nb 1)))
        (set! na 0) (set! nb 0)
        (check c (not (demand (zip (countdown 0 na) (countdown 0 nb)))))
        (check c (and (= @na 1) (= @nb 1)))
        (checks-result c))))
