;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §4.4 (row range: floats accumulate)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: range-by
;; The nth of a float range walks, because its elements are accumulated sums; (range-by 0.0 1.0 0.25) is
;; 0.0 0.25 0.5 0.75, so index 4 is past the end and the walk traps with the function's name.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (= (nth (range-by 0.0 1.0 0.25) 4) 1.0) 1 0))
