;; spec:   stdlib §2.7 (println is Show), §6.3 (R5), §4.14 (row println)
;; expect: reject
;; error:  no implementation of Show for Pt
;; roots:  ../../lib support
;; covers: println
;; (println p) is (fib.prelude/println (fib.prelude/show p)): a struct with no Show
;; instance is refused when the program is checked.
(ns main (:use fib.core fib.seq fib.print))

(defstruct Pt (x: i64 y: i64))

(defun main () -> i64 (do (println "p =" (Pt 1 2)) 0))
