;; spec: spec/stdlib.md section 4.3 rows `parse-boolean`, `try-parse-int`, `Integer/parseInt`, `Long/parseLong`, `Double/parseDouble` (all unbound before package FOLLOWUP-1)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; parse-boolean is exactly "true" or "false". try-parse-int is `[+-]? digit+` in a radix of 2 to 36 and the range of an i32 (the edges 2147483647 and -2147483648 parse,
;; one past either is nil), never a trap. The Java-named parsers trap with Java's NumberFormatException texts, caught here with `try`: Integer/parseInt, Long/parseLong, Double/parseDouble.
(ns main (:use tl.check fib.ex) (:require [Integer :as Integer] [Long :as Long] [Double :as Double]))

(defun msg (f: (fn () i64)) -> str (try (do (f) "no trap") (catch e (ex-message e))))
(defun msgd (f: (fn () f64)) -> str (try (do (f) "no trap") (catch e (ex-message e))))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (parse-boolean "true") (some true)))
        (check c (= (parse-boolean "false") (some false)))
        (check c (nil? (parse-boolean "True")))
        (check c (nil? (parse-boolean " true")))
        (check c (nil? (parse-boolean "")))
        (check c (nil? (parse-boolean "yes")))
        (check c (= (try-parse-int "42") (some 42i32)))
        (check c (= (try-parse-int "-42") (some -42i32)))
        (check c (= (try-parse-int "+7") (some 7i32)))
        (check c (= (try-parse-int "2147483647") (some 2147483647i32)))
        (check c (= (try-parse-int "-2147483648") (some -2147483648i32)))
        (check c (nil? (try-parse-int "2147483648")))
        (check c (nil? (try-parse-int "-2147483649")))
        (check c (nil? (try-parse-int "99999999999999999999")))
        (check c (nil? (try-parse-int "")))
        (check c (nil? (try-parse-int "-")))
        (check c (nil? (try-parse-int " 1")))
        (check c (nil? (try-parse-int "1_0")))
        (check c (nil? (try-parse-int "1.5")))
        (check c (nil? (try-parse-int "\u{661}")))
        (check c (= (try-parse-int "ff" 16) (some 255i32)))
        (check c (= (try-parse-int "FF" 16) (some 255i32)))
        (check c (= (try-parse-int "-zz" 36) (some -1295i32)))
        (check c (= (try-parse-int "1010" 2) (some 10i32)))
        (check c (= (try-parse-int "7fffffff" 16) (some 2147483647i32)))
        (check c (= (try-parse-int "-80000000" 16) (some -2147483648i32)))
        (check c (nil? (try-parse-int "80000000" 16)))
        (check c (nil? (try-parse-int "2" 2)))
        (check c (nil? (try-parse-int "1" 1)))
        (check c (nil? (try-parse-int "1" 37)))
        (check c (= (parse-i32 "12") (some 12i32)))
        (check c (= (try-parse-long "9223372036854775807") (some 9223372036854775807)))
        (check c (nil? (try-parse-long "9223372036854775808")))
        (check c (= (try-parse-long "-8000000000000000" 16) (some -9223372036854775808)))
        (check c (= (Integer/parseInt "123") 123i32))
        (check c (= (Integer/parseInt "-ff" 16) -255i32))
        (check c (= (msg (fn () (do (Integer/parseInt "12x") 0))) "For input string: \"12x\""))
        (check c (= (msg (fn () (do (Integer/parseInt "") 0))) "For input string: \"\""))
        (check c (= (msg (fn () (do (Integer/parseInt "zz" 16) 0))) "For input string: \"zz\" under radix 16"))
        (check c (= (msg (fn () (do (Integer/parseInt "1" 1) 0))) "radix 1 less than Character.MIN_RADIX"))
        (check c (= (msg (fn () (do (Integer/parseInt "1" 37) 0))) "radix 37 greater than Character.MAX_RADIX"))
        (check c (= (Long/parseLong "9223372036854775807") 9223372036854775807))
        (check c (= (msg (fn () (Long/parseLong "9223372036854775808"))) "For input string: \"9223372036854775808\""))
        (check c (= (Long/parseLong "ff" 16) 255))
        (check c (= (Double/parseDouble "2.5") 2.5))
        (check c (= (Double/parseDouble "1e3") 1000.0))
        (check c (= (msgd (fn () (Double/parseDouble "abc"))) "For input string: \"abc\""))
        (check c (= (msgd (fn () (Double/parseDouble ""))) "empty String"))
        (check c (= (msgd (fn () (Double/parseDouble "0x10"))) "For input string: \"0x10\""))
        (checks-result c))))
