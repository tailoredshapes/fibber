;; spec: docs/design/lacinia.md
;; expect: reject
;; error: cannot be shared between threads
;; stage: 2
;; roots: ../../lib
(ns main (:require [fib.lacinia :as g]))
(defun main () -> i64
  (let [local (cell 0)
        field (g/resolving (g/named "Int")
          (fn (context: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue) (Ok (g/IntValue @local))))]
    0))
