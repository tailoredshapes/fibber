;; spec:   stdlib §4.5 row merge-with, §3 N4 (-with takes a combiner)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: merge-with
;; (merge-with + {"a" 1} {"a" 2 "b" 3}) is {"a" 3 "b" 3}, the page's own example: the key in both maps holds f of the two
;; values, and a key in one map keeps its value. f gets the OLD value first, a's, then the NEW one, b's: with - the answer
;; is 10 - 3 = 7 and not 3 - 10, and with a concatenation of text the order shows in the result, "xy". The function is the
;; first argument (Clojure's order) and may be any (fn (v v) v), a literal fn or a function value.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (merge-with + {"a" 1} {"a" 2 "b" 3})))
    (do (check c (= m {"a" 3 "b" 3}))
        (check c (= (count m) 2))
        (check c (= (get m "a") (some 3)))
        (check c (= (get m "b") (some 3)))
        (check c (= (get (merge-with - {"a" 10} {"a" 3}) "a") (some 7)))
        (check c (= (get (merge-with (fn (o n) (- n o)) {"a" 10} {"a" 3}) "a") (some -7)))
        (check c (= (get (merge-with (fn (o n) (str-concat o n)) {1 "x"} {1 "y"}) 1) (some "xy")))
        (check c (= (merge-with + {"a" 1} {"b" 2}) {"a" 1 "b" 2}))
        (check c (= (merge-with + {"a" 1 "b" 5} {"b" 7 "c" 9}) {"a" 1 "b" 12 "c" 9}))
        (check c (= (merge-with max {1 4 2 9} {1 6 2 3}) {1 6 2 9}))
        (checks-result c))))
