;; spec:   stdlib §2.4 (update traps on a missing key), §6.3 (R6b), §4.5 (row update)
;; expect: trap
;; trap:   update: no key
;; roots:  ../../lib support
;; covers: update
;; (update m k f x ..) is the library's update over a closure that passes the
;; extra arguments, so a key the map lacks is the same trap as the three-argument
;; form (case 423), after a good update has answered: Clojure's NullPointerException
;; on (+ nil 10). A literal fnil is the form for a key that may be missing (case 782).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((m (assoc (empty {1 0}) 1 10))
        (m2 (update m 1 + 5)))
    (match (get (update m2 2 + 5) 2) (nil 0) ((some x) x))))
