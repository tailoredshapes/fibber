;; spec:   syntax §1.4 (literal collections are library calls), §3.19 (def), stdlib §6.1
;; expect: accept
;; result: 0
;; audit:  clean
;; The vector and map literals expand to the prelude's `vec-conj` and `map-assoc` by qualified
;; heads, so they mean the same with the library implicit and with a program's own `conj` and
;; `assoc` in scope, and a `def` initialiser that is a literal is still a constant: the
;; compiler holds it as static data.
(def primes: (Vec i64) [2 3 5 7])
(def names: (Map i64 str) {1 "one" 2 "two"})

(defun conj (v: (Vec i64) x: i64) -> (Vec i64) v)
(defun assoc (m: (Map i64 str) k: i64 v: str) -> (Map i64 str) m)

(defun miss (bit: i64 ok: bool) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (miss 1 (= (count primes) 4))
     (+ (miss 2 (= (nth primes 3) 7))
        (+ (miss 4 (= (get names 2) (some "two")))
           (+ (miss 8 (= (count (conj [1 2] 3)) 2))
              (miss 16 (= (count [1 2 3]) 3)))))))
