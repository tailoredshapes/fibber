;; spec:   stdlib §2.3 (Truthy; Lookup), §4.4 (rows every? not-any?), A11 t05
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: every? not-any?
;; Clojure's (every? #(get m %) ks): the predicate is the generic `get` of
;; fib.coll, which answers an Option, so every? and not-any? read it as a
;; condition. The Map's Lookup instance is L8b's (fib.coll.map), the Vec's is
;; P0's: the program is the page's.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (map-empty) 1 10) 2 0)))
    (do (check c (every? (fn (k) (get m k)) [1 2]))
        (check c (not (every? (fn (k) (get m k)) [1 2 3])))
        (check c (not-any? (fn (k) (get m k)) [7 8 9]))
        (check c (not (not-any? (fn (k) (get m k)) [7 2 9])))
        (checks-result c))))
