;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: trap
;; trap:   update failed
;; stage:  2
;; roots:  ../../lib support
;; Test 7 of the design: cell-update! moves the content out of the cell and hands it to its function; if the function's failure unwound,
;; the cell would hold what the function released. Poisoning is not built: the failure there is the trap it was, even inside a try (ADR
;; 0009). Killed by: scripts/mutant-catch.sh `update-unwinds` (the catch answers and reads the moved-from cell).
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (let ((c (cell [1 2 3])))
    (try (do (cell-update! c (fn (v: (Vec i64)) (if (> (count v) 2) (trap "update failed") v))) 0)
         (catch e (count @c)))))
