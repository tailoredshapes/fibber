;; spec:   stdlib §2.1 rule 2 (a head the module defines is not the library's), §7 L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map count defn
;; The module defines `map` with two clauses; its calls pick `map$2` and are the program's, not the
;; library's `map` stage: the chain below is not rewritten, and the qualified call still is the library's.
(ns main (:use tl.check))

(defn map
  ([f: (fn (i64) i64) v: (Vec i64)] -> (Vec i64) [7 7])
  ([f: (fn (i64 i64) i64) v: (Vec i64) w: (Vec i64)] -> (Vec i64) [1 2 3 4]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (count (map (fn (x: i64) x) [1 2 3])) 2))
        (check c (= (count (map (fn (x: i64 y: i64) x) [1] [2])) 4))
        (check c (= (count (fib.seq/map (fn (x: i64) x) [1 2 3])) 3))
        (checks-result c))))
