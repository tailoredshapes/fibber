;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; hsum hmin hmax of ['i8', 'i16', 'i32', 'i64'] vectors equal the scalar loops over the same lanes; hsum is the left-to-right checked sum.
(ns main (:use fib.core fib.coll tl.check))

(defun red-i8-1 (c: Checks) -> unit
  (let ((a: i8x1 <<5>>i8) (ref: (Vec i8) [5i8]))
    (loop ((i 1) (s (nth ref 0)) (lo (nth ref 0)) (hi (nth ref 0)))
      (if (< i 1)
          (recur (+ i 1) (+ s (nth ref i)) (if (< (nth ref i) lo) (nth ref i) lo) (if (> (nth ref i) hi) (nth ref i) hi))
          (do (check c (= (hsum a) s)) (check c (= (hmin a) lo)) (check c (= (hmax a) hi)) ())))))

