;; spec: spec/stdlib.md section 4.3 rows `true?`, `false?`, `NaN?`, `infinite?`; section 4.7 row `clojure.string/trim-newline` (all unbound before package FOLLOWUP-1, listed in docs/adr/0023-unbound-rows.tsv)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; The cheap rows of the ADR 0023 list. true? and false? on a bool; NaN? is true for NaN only (not for the infinities, not for -0.0), infinite? for both infinities only (not for the largest double,
;; not for NaN); trim-newline removes every trailing LF and CR and nothing else (not a leading one, not a space, not one in the middle), on text with non-ASCII characters before the end too.
(ns main (:use tl.check) (:require [fib.string :as s]))

(defun main () -> i64
  (let ((c (checks)) (inf (fdiv 1.0 0.0)) (ninf (fdiv -1.0 0.0)) (nan (fdiv 0.0 0.0)))
    (do (check c (true? true))
        (check c (not (true? false)))
        (check c (false? false))
        (check c (not (false? true)))
        (check c (NaN? nan))
        (check c (not (NaN? 0.0)))
        (check c (not (NaN? inf)))
        (check c (not (NaN? -0.0)))
        (check c (infinite? inf))
        (check c (infinite? ninf))
        (check c (not (infinite? nan)))
        (check c (not (infinite? 1.7976931348623157e308)))
        (check c (not (infinite? 0.0)))
        (check c (= (s/trim-newline "abc\n") "abc"))
        (check c (= (s/trim-newline "abc\r\n") "abc"))
        (check c (= (s/trim-newline "abc\n\n\r\n") "abc"))
        (check c (= (s/trim-newline "abc \n") "abc "))
        (check c (= (s/trim-newline "\nabc") "\nabc"))
        (check c (= (s/trim-newline "a\nb\n") "a\nb"))
        (check c (= (s/trim-newline "abc") "abc"))
        (check c (= (s/trim-newline "") ""))
        (check c (= (s/trim-newline "\r\n") ""))
        (check c (= (s/trim-newline "caf\u{e9}\u{20ac}\n") "caf\u{e9}\u{20ac}"))
        (check c (= (s/trim-newline "\u{e9}\r") "\u{e9}"))
        (checks-result c))))
