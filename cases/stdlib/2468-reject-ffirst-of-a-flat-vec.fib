;; spec:   stdlib §4.4 (row ffirst: two Reducible constraints), tranche 2 plan Y4
;; expect: reject
;; error:  no implementation of Reducible for i64
;; roots:  ../../lib support
;; covers: ffirst
;; (ffirst c) needs the elements of c to be collections themselves: over a Vec of integers the second
;; Reducible constraint, on the element type, has no instance, and the checker says which type.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (match (ffirst [1 2 3])
    (nil 0)
    ((some v) v)))
