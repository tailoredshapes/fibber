;; spec:   stdlib §2.7 (nil and a present value), §2.3 (ToStr, Debug)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; Clojure has no wrapper: (str (some 1)) is "1", (pr-str (some "a")) is
;; "\"a\"" and a nil is the empty text under str and `nil` under pr. A present
;; value is its payload's text at every depth, so the Option of an Option is
;; as ambiguous as Clojure's nested nil: (some nil) prints as nil does. Inside
;; a collection the element is printed by the same rule (str of a Vec is its
;; Debug text, so a missing element is `nil` there). The Show instance of an
;; Option is the prelude's (R2, case 205 of cases/ownership), not this part's.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil)
        (nn: (Option (Option i64)) nil)
        (sn: (Option (Option i64)) (some nil))
        (ss: (Option (Option i64)) (some (some 5)))
        (mixed: (Vec (Option i64)) [(some 1) nil (some 3)])
        (words: (Vec (Option str)) [(some "a") nil]))
    (do (check c (= (str (some 1)) "1"))
        (check c (= (str none) ""))
        (check c (= (str (some "a")) "a"))
        (check c (= (str (some \a)) "a"))
        (check c (= (debug (some 1)) "1"))
        (check c (= (debug none) "nil"))
        (check c (= (debug (some "a")) "\"a\""))
        (check c (= (debug (some \a)) "\\a"))
        (check c (= (str nn) ""))
        (check c (= (debug nn) "nil"))
        (check c (= (str sn) ""))
        (check c (= (debug sn) "nil"))
        (check c (= (str ss) "5"))
        (check c (= (debug ss) "5"))
        (check c (= (str mixed) "[1 nil 3]"))
        (check c (= (debug mixed) "[1 nil 3]"))
        (check c (= (debug words) "[\"a\" nil]"))
        (check c (= (str (some [1 2])) "[1 2]"))
        (check c (= (str (Pair (some 1) none)) "[1 nil]"))
        (checks-result c))))
