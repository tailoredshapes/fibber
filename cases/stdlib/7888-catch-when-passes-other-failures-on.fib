;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 21
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `(catch e :when cond handler..)` catches only when cond holds; any other failure goes on outwards to the next try, through the inner
;; finally. Killed by: scripts/mutant-catch.sh `no-catch`.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (let ((seen (cell 0)))
    (+ (try (try (nth [1] 4)
                 (catch e :when (= (ex-kind e) (some "overflow")) 100)
                 (finally (set! seen 1)))
            (catch e :when (= (ex-kind e) (some "index")) 20))
       @seen)))
