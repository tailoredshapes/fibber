;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: trap
;; trap:   nobody catches this
;; stage:  2
;; roots:  ../../lib support
;; With no catch active on the thread, throw is the trap of the exception's message, as before stage 2 (stdlib §2.10): the program aborts.
;; Killed by: scripts/mutant-catch.sh `catch-everywhere` (throw-object believes a catch is active: the failure reaches main's caller).
(ns main (:use fib.core fib.ex))

(defun main () -> i64 (throw (ex "nobody catches this")))
