;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; hsum hmin hmax of ['f32', 'f64'] vectors equal the scalar loops over the same lanes; hsum of floats is the halving tree (lane i plus lane i + n/2), the reference `tree` adds in that order; a NaN lane makes hmin, hmax and hsum NaN.
(ns main (:use fib.core fib.coll tl.check))

(defun red-f32-1 (c: Checks) -> unit
  (let ((a: f32x1 <<-2.5>>f32) (ref: (Vec f32) [-2.5f32]))
    (loop ((i 1) (s (nth ref 0)) (lo (nth ref 0)) (hi (nth ref 0)))
      (if (< i 1)
          (recur (+ i 1) (+ s (nth ref i)) (if (< (nth ref i) lo) (nth ref i) lo) (if (> (nth ref i) hi) (nth ref i) hi))
          (do (check c (= (hsum a) s)) (check c (= (hmin a) lo)) (check c (= (hmax a) hi)) ())))))

