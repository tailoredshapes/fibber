(defun special (c: Checks) -> unit
  (let ((nan (/ 0.0 0.0)))
    (let ((a: f64x4 (with-lane <<1.0 2.0 3.0 4.0>>f64 2 nan)))
      (do (check c (!= (hsum a) (hsum a))) (check c (!= (hmin a) (hmin a))) (check c (!= (hmax a) (hmax a)))
          (check c (= (hmax <<-0.0 0.0>>f64) 0.0)) (check c (= (lane (splat f64x2 (hmin <<0.0 -0.0>>f64)) 0) 0.0))
          (check c (= (hsum <<1.0e300 1.0e300 1.0e300 1.0e300>>f64) (+ (+ 1.0e300 1.0e300) (+ 1.0e300 1.0e300))))
          ()))))

(defun tree (c: Checks) -> unit
  (let ((a: f32x4 <<16777216.0 1.0 1.0 -16777216.0>>f32))
    (do (check c (= (hsum a) (+ (+ 16777216.0f32 1.0f32) (+ 1.0f32 -16777216.0f32))))
        ())))

(defun main () -> i64
  (let ((c (checks)))
    (do (red-f32-1 c)
        (red-f32-2 c)
        (red-f32-3 c)
        (red-f32-4 c)
        (red-f32-5 c)
        (red-f32-8 c)
        (red-f32-16 c)
        (red-f64-1 c)
        (red-f64-2 c)
        (red-f64-3 c)
        (red-f64-4 c)
        (red-f64-5 c)
        (red-f64-8 c)
        (special c)
        (tree c)
        (checks-result c))))
