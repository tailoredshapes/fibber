;; spec:   stdlib §4.14 (rows print-str pr-str println-str prn-str), method.md rule 3 (allocs)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 6
;; roots:  ../../lib support
;; covers: print-str pr-str println-str prn-str
;; The twins of the four string printers over an integer allocate the text of the integer, one object
;; each for `print-str` and `pr-str`, and one more for `println-str` and `prn-str`, the join with the
;; newline: 1 + 1 + 2 + 2 = 6 objects under both tools (the A lines of the free trace; each twin was
;; also measured alone, at 1, 1, 2 and 2). A twin that asked its protocol twice, copied the text before
;; it returned it or added the newline in a second step would cost more. The bound is the measured count;
;; the harness lowers it by one and requires the failure
;; (a_stdlib_count_bound_one_below_the_count_fails).
(ns main)

(defun main () -> i64
  (let ((a (print-str 7))
        (b (pr-str 7))
        (c (println-str 7))
        (d (prn-str 7)))
    (if (= (+ (str-len a) (+ (str-len b) (+ (str-len c) (str-len d)))) 6) 0 1)))
