;; spec:   stdlib §7 L8 (the trap clause of a let is the checker's own: a written one is still redundant)
;; expect: reject
;; error:  redundant match clause
;; roots:  ../../lib support
;; The trap clause that ends a refutable `let` is exempt from the redundancy check; a `match`
;; the program writes is not: a struct pattern covers every Point, so the `_` after it is
;; reported, as it was before the let was rewritten.
(defstruct Point (x: i64 y: i64))

(defun main () -> i64
  (match (Point 1 2)
    ((Point x y) (+ x y))
    (_ 0)))
