;; spec:   stdlib §4.4 (rows cycle, last), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   last: never ends
;; roots:  ../../lib support
;; covers: cycle last
;; Last of a cycle of a source that has elements: the override traps. The cycle of an empty source has no last (case 2218).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (unwrap-or (last (cycle [1 2 3])) 0))
