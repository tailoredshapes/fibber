;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; `:private` stands right after a clause's parameter vector: the clause of two
;; arguments is the module's own, the clause of one calls it. (`defn-` would make
;; every clause private.)
(ns main (:use tl.check))

(defn scaled
  ([x: i64] -> i64 (scaled x 10))
  ([x: i64 k: i64] :private -> i64 (* x k)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (scaled 4) 40))
        (checks-result c))))
