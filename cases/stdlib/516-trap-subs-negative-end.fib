;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; A negative end is out of range (and not "start after end": the start 0
;; is before everything); the call before it is fine.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 0 0))
       (count (subs s 0 (- 0 1))))))
