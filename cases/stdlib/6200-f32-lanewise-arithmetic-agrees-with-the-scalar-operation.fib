        (check c (= (lane r 5) (- 7.0f32 -2.5f32)))
        (check c (= (lane r 6) (- 7.0f32 1.25f32)))
        (check c (= (lane r 7) (- 7.0f32 -3.75f32)))
        (check c (= (lane r 8) (- 7.0f32 0.0f32)))
        (check c (= (lane r 9) (- 7.0f32 3.75f32)))
        (check c (= (lane r 10) (- 7.0f32 -1.25f32)))
        (check c (= (lane r 11) (- 7.0f32 2.5f32)))
        (check c (= (lane r 12) (- 7.0f32 -2.5f32)))
        (check c (= (lane r 13) (- 7.0f32 1.25f32)))
        (check c (= (lane r 14) (- 7.0f32 -3.75f32)))
        (check c (= (lane r 15) (- 7.0f32 0.0f32)))
        ()))
        ())))

(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: f32x2 <<-3.75 0.0>>f32) (b: f32x2 <<0.5 3.0>>f32))
    (do (check p (= (lane (+ a b) 1) (- 0.0f32 3.0f32)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-f32-1 c)
        (arith-f32-2 c)
        (arith-f32-3 c)
        (arith-f32-4 c)
        (arith-f32-5 c)
        (arith-f32-8 c)
        (arith-f32-16 c)
        (planted c)
        (checks-result c))))
