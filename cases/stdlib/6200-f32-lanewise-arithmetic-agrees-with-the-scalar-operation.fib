;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg and fdiv on f32 vectors of [1, 2, 3, 4, 5, 8, 16] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-f32-1 (c: Checks) -> unit
  (let ((a: f32x1 <<-3.75>>f32) (b: f32x1 <<0.5>>f32))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -3.75f32 0.5f32)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -3.75f32 0.5f32)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -3.75f32 0.5f32)))
        ()))
        (let ((r (fdiv a b)))
      (do
        (check c (= (lane r 0) (fdiv -3.75f32 0.5f32)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75f32)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75f32 2.0f32)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0f32 -3.75f32)))
        ()))
        ())))

