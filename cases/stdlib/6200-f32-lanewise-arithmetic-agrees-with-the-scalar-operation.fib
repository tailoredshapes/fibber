        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -3.75f32)))
        (check c (= (lane r 1) (neg 0.0f32)))
        ()))
        (let ((r (+ a 2.0)))
      (do
        (check c (= (lane r 0) (+ -3.75f32 2.0f32)))
        (check c (= (lane r 1) (+ 0.0f32 2.0f32)))
        ()))
        (let ((r (- 7.0 a)))
      (do
        (check c (= (lane r 0) (- 7.0f32 -3.75f32)))
        (check c (= (lane r 1) (- 7.0f32 0.0f32)))
        ()))
        ())))

