;; spec:   stdlib §2.8 (Division), Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: /
;; The page's own function: (defun half (x: t) :where ((Div t r) (Num t))
;; -> r (/ x (+ x x))) has one answer whatever the caller's type, because
;; the result type is the instance's: 1/2 at the integers and at a ratio,
;; 0.5 at the floats. Before Div, a generic (/ x (+ x x)) at i64 was 0.
(ns main (:use fib.core tl.check))

(defun half (x: t) :where ((Div t r) (Num t)) -> r (/ x (+ x x)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (half 3) (/ 1 2)))
        (check c (= (show (half 3)) "1/2"))
        (check c (= (show (half 7i8)) "1/2"))
        (check c (= (show (half 9i32)) "1/2"))
        (check c (= (half 3.0) 0.5))
        (check c (= (half 3.0f32) 0.5f32))
        (check c (= (show (half (/ 1 3))) "1/2"))
        (check c (= (show (half (/ -7 5))) "1/2"))
        (checks-result c))))
