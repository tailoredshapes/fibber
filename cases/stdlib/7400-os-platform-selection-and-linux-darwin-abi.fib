;; spec: docs/design/os.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check) (:require [fib.os.platform :as p] [fib.os.abi :as a] [fib.os.backend :as b]))
(defun main () -> i64
  (let [c (checks) linux (a/linux-abi) darwin (a/darwin-abi)]
    (do (check c (= b/platform-name (p/name (p/current))))
        (check c (= (. linux would-block) 11)) (check c (= (. darwin would-block) 35))
        (check c (= (. linux monotonic-clock) 1)) (check c (= (. darwin monotonic-clock) 6))
        (check c (= (. linux create-flag) 64)) (check c (= (. darwin create-flag) 512))
        (check c (= (. linux socket-level) 1)) (check c (= (. darwin socket-level) 65535))
        (check c (= (. linux uname-width) 65)) (check c (= (. darwin uname-width) 256))
        (check c (= (. linux dirent-name) 19)) (check c (= (. darwin dirent-name) 21))
        (checks-result c))))
