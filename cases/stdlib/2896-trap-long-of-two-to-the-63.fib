;; spec:   stdlib §4.3 (row long), §2.8 (conversions are checked)
;; expect: trap
;; trap:   long: value out of range
;; roots:  ../../lib support
;; covers: long
;; The first f64 above an i64: 2^63 is 1 more than the maximum, and the maximum is no f64 (the next
;; one below 2^63, 9223372036854774784.0, is a long: case 2854).
(defun main () -> i64 (long 9223372036854775808.0))
