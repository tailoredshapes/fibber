;; spec:   stdlib §4.14 (row newline), §2.10
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: newline print println prn
;; (newline) writes one "\n" and answers unit, and so do the printers, in a
;; row: a case whose result is the sum of its checks reaches its last line only
;; if none of the writes trapped (a write that failed or made no progress is the
;; trap `println: write failed`). The bytes are not a case's result, with one
;; exception that the case uses: the compiled runner reads the result from the
;; last line of stdout, so a case that ends its output with text and then
;; (newline) fails under `fibc cases` if newline writes anything that does not end
;; the line ("end0" is not an integer). Case 607 tells the printers apart by the
;; protocol each asks, and case 614 counts their writes.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun unit? (u: unit) -> bool true)

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (unit? (newline)))
        (check c (unit? (print "a")))
        (check c (unit? (newline)))
        (check c (unit? (println "b")))
        (check c (unit? (prn "c")))
        (check c (unit? (print "")))
        (check c (unit? (println "")))
        (check c (unit? (newline)))
        (print "end")
        (check c (unit? (newline)))
        (checks-result c))))
