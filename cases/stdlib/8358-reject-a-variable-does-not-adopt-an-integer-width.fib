;; spec:   types §1.1, stdlib §7 L26 (a)
;; expect: reject
;; error:  cannot unify i64 with i32
;; roots:  ../../lib support
;; Only a literal adopts the width it meets: a variable bound to an integer is an `i64` and stays one (`(let ((n 2)) (+ x n))` with an i32 x). The rule is
;; the literal's, not a general promotion (types §1.1: no implicit conversion between scalar types).
(ns main)

(defun bump (x: i32) -> i32
  (let ((n 1)) (+ x n)))

(defun main () -> i64
  (if (= (bump 1i32) 2i32) 1 0))
