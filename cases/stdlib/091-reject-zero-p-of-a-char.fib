;; spec:   stdlib §2.3 (Unit: i8..i64, f32, f64), §4.3 (row zero?: Eq t, Unit t)
;; expect: reject
;; error:  no implementation of Unit for char
;; roots:  ../../lib
;; covers: zero?
;; zero? needs Eq and Unit. A char has Eq, so the bound that fails is Unit,
;; and the error says so: Unit's instances are the six numeric types.
(ns main (:use fib.core))

(defun main () -> i64
  (if (zero? \a) 1 0))
