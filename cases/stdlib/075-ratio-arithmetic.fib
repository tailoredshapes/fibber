;; spec:   stdlib §2.8 ((Ratio t): Num, Div), Appendix A13 div
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / quot rem neg
;; + - * / on ratios give ratios in lowest terms (1/2 and 1/3: 5/6, 1/6, 1/6
;; and 3/2); quot is the quotient with its fraction dropped toward zero, a
;; ratio with denominator 1, and rem is a - b * quot(a, b), which takes the
;; dividend's sign: 7/2 over 3/4 is 14/3, so quot 4 and rem 1/2, and -7/2
;; gives -4 and -1/2. The values were worked out outside fibber with exact
;; fractions.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (a (/ 1 2))
        (b (/ 1 3))
        (x (/ 7 2))
        (y (/ 3 4))
        (z (/ -7 2)))
    (do (check c (= (show (+ a b)) "5/6"))
        (check c (= (show (- a b)) "1/6"))
        (check c (= (show (- b a)) "-1/6"))
        (check c (= (show (* a b)) "1/6"))
        (check c (= (show (/ a b)) "3/2"))
        (check c (= (show (+ a a)) "1"))
        (check c (= (show (* (/ 2 3) (/ 3 2))) "1"))
        (check c (= (show (quot x y)) "4"))
        (check c (= (show (rem x y)) "1/2"))
        (check c (= (show (quot z y)) "-4"))
        (check c (= (show (rem z y)) "-1/2"))
        (check c (= (show (quot a (/ 3 1))) "0"))
        (check c (= (show (rem a (/ 3 1))) "1/2"))
        (check c (= (show (neg a)) "-1/2"))
        (check c (= (+ a (neg a)) (/ 0 1)))
        (checks-result c))))
