;; spec:   stdlib §5.5 S15, §7 L29 (dynamic vars, with-redefs)
;; expect: accept
;; result: 2
;; audit:  clean
;; open:   L29
;; Clojure's (with-redefs [f g] (f)) calls g where the body says f. A call
;; to a named function is direct today, so there is nothing to redefine and
;; no such form: L29 marks the functions some with-redefs names and calls
;; them through a global slot. The shape of the binding list below is the
;; plan's guess, not the spec's: L29's agent corrects it when the item lands.
(defun f () -> i64 1)
(defun g () -> i64 2)

(defun main () -> i64
  (with-redefs ((f g)) (f)))
