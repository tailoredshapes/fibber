;; spec:   stdlib §5 (nth traps out of range), types §8.3
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: nth
;; A negative index on a trie (a shared conj of a flat Vec of 1000): it is below tailoff, so without the range test it would
;; walk the trie with a negative index (the low bits pick a slot: a wrong element and no trap). The answer 0, which the
;; harness refuses, would mean the Vec was not a trie and the case tested nothing. `v` is read last so that it is still held
;; when `conj` runs: a unique `v` would be pushed in place and stay flat.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (mapv (fn (i: i64) (* i 3)) (range 1000))))
    (let ((t (conj v -1)))
      (if (> (span-count t) 1)
          (+ (nth t 0) (nth t -1) (nth v 0))
          0))))
