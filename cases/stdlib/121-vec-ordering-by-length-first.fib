;; spec:   stdlib §2.7 (`Ord` on a `Vec` is Clojure's: the shorter vector is less, then element by element)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; The page's own example: `(sort [[1 2 3] [9 9] [1 2]])` is `[[1 2] [9 9] [1 2 3]]`
;; (A11 t1r), which is the three comparisons below; sort itself is L7's, so
;; the order is asked of `<` here. The length decides first (the empty vector is
;; below every other, a short vector with a big element below a long one with
;; small ones), then the first position where the elements differ. `<=`, `>`
;; and `>=` are the builtin protocol's defaults over `<`, so they follow. The
;; order is built on `<` alone, as Clojure's `compare` is, so an element that
;; is neither less nor greater than the other (a NaN) is passed over, and a
;; vector of vectors, of strings (code-point order) and of floats order too.
(ns main (:use fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (e: (Vec i64) (vec-empty))
        (nan (fdiv 0.0 0.0)))
    (do (check c (< [1 2] [9 9]))
        (check c (< [9 9] [1 2 3]))
        (check c (< [1 2] [1 2 3]))
        (check c (not (< [9 9] [1 2])))
        (check c (not (< [1 2 3] [9 9])))
        (check c (not (< [1 2 3] [1 2])))
        (check c (< e [0]))
        (check c (not (< [0] e)))
        (check c (not (< e e)))
        (check c (not (< [1 2 3] [1 2 3])))
        (check c (< [1 2 3] [1 2 4]))
        (check c (< [1 2 9] [1 3 0]))
        (check c (< [0 9 9] [1 0 0]))
        (check c (not (< [1 3 0] [1 2 9])))
        (check c (<= [1 2] [1 2]))
        (check c (<= [1 2] [1 3]))
        (check c (not (<= [1 3] [1 2])))
        (check c (> [1 2 3] [9 9]))
        (check c (not (> [9 9] [1 2 3])))
        (check c (>= [1 2] [1 2]))
        (check c (>= [1 3] [1 2]))
        (check c (not (>= [1 2] [1 3])))
        (check c (< ["a" "b"] ["a" "c"]))
        (check c (< ["z"] ["a" "a"]))
        (check c (< ["a" "ab"] ["a" "z"]))
        (check c (not (< ["a" "z"] ["a" "ab"])))
        (check c (< ["z"] ["é"]))
        (check c (not (< ["é"] ["z"])))
        (check c (< [[1 2] [3]] [[1 2] [4]]))
        (check c (< [[9 9] [9]] [[1 2 3] [0]]))
        (check c (not (< [[1 2 3] [0]] [[9 9] [9]])))
        (check c (< [-2.5 1.0] [-2.5 1.5]))
        (check c (< [-0.0] [0.5]))
        (check c (not (< [nan] [1.0])))
        (check c (not (< [1.0] [nan])))
        (check c (< [nan 1.0] [nan 2.0]))
        (check c (not (< [nan 2.0] [nan 1.0])))
        (check c (= (checks-made c) 37))
        (checks-result c))))
