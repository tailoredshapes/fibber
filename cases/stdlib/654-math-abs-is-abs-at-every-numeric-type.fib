;; spec:   stdlib §4.10 (row Math/abs), §4.3 (row abs), §2.8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Math/abs
;; (Math/abs x) is abs: the magnitude at the width of x, for every integer and both float widths.
;; The float cases are the ones where a bare (if (< x 0) (neg x) x) goes wrong: -0.0 gives 0.0 (its
;; bits are all zero, not the sign bit), NaN stays NaN, the infinities give the positive one.
(ns main (:use fib.core tl.check) (:require [Math :as Math]))

(defun apply1 (f: (fn (i64) i64) x: i64) -> i64 (f x))

(defun main () -> i64
  (let ((c (checks))
        (nan (fdiv 0.0 0.0))
        (inf (fdiv 1.0 0.0)))
    (do ;; integers
        (check c (= (Math/abs -5) 5))
        (check c (= (Math/abs 5) 5))
        (check c (= (Math/abs 0) 0))
        (check c (= (apply1 Math/abs -7) 7))
        (check c (= (Math/abs -9223372036854775807) 9223372036854775807))
        (check c (= (Math/abs 9223372036854775807) 9223372036854775807))
        (check c (= (Math/abs -127i8) 127i8))
        (check c (= (Math/abs -32767i16) 32767i16))
        (check c (= (Math/abs -2147483647i32) 2147483647i32))
        (check c (= (Math/abs -7i32) 7i32))
        ;; floats
        (check c (= (Math/abs -2.5) 2.5))
        (check c (= (Math/abs 2.5) 2.5))
        (check c (= (Math/abs -1.5f32) 1.5f32))
        (check c (= (f64->bits -0.0) -9223372036854775808))
        (check c (= (f64->bits (Math/abs -0.0)) 0))
        (check c (= (f64->bits (Math/abs 0.0)) 0))
        (check c (= (f32->bits (Math/abs -0.0f32)) 0i32))
        (check c (= (Math/abs (neg inf)) inf))
        (check c (= (Math/abs inf) inf))
        (check c (not= (Math/abs nan) (Math/abs nan)))
        (check c (= (f64->bits (Math/abs -1e300)) 9094988921128908188))
        (checks-result c))))
