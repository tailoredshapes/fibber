;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (fd/values (fd/domain [3 1 3 2])) [1 2 3]))
        (check c (= (fd/values (fd/interval -2 2)) [-2 -1 0 1 2]))
        (check c (= (fd/values (fd/domain [-1000 0 1000])) [-1000 0 1000]))
        (check c (= (fd/values (fd/intersection (fd/interval 1 9) (fd/interval 5 12))) [5 6 7 8 9]))
        (check c (= (fd/values (fd/remove-value (fd/interval 1 3) 2)) [1 3]))
        (check c (= (fd/values (fd/interval 2 1)) []))
        (check c (= (fd/size (fd/interval 0 62)) 63))
        (check c (= (fd/size (fd/interval 1 1000000000)) 1000000000))
        (check c (= (fd/minimum (fd/interval -1000000000 1000000000)) -1000000000))
        (check c (= (fd/maximum (fd/interval -1000000000 1000000000)) 1000000000))
        (check c (= (fd/values (fd/interval 9223372036854775807 9223372036854775807)) [9223372036854775807]))
        (checks-result c))))
