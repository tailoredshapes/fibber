;; spec:   types §2.17 (the gpu builtins: atomics are unsafe like the loads and stores they act on)
;; expect: reject
;; error:  .fib:8:4: gpu/atomic-add-i32 may only be used inside unsafe
;; The atomic builtins take a raw ptr, as `load-i32` does, and are `unsafe`; the library's `gpu/i32-add!` is the safe-looking wrapper (it contains the unsafe). A plain
;; function that names the builtin outside `unsafe` is refused.
(ns main (:require [fib.gpu :as gpu]))
(defun bump (p: ptr) -> i32
  (gpu/atomic-add-i32 p 1i32))
(defun main () -> i64 0)
