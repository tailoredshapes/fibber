;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types fib.http.message))
(defun main () -> i64
  (let [c (checks)]
    (do (check c (match (parse-response-head "HTTP/1.1 2\u{e9}\u{e9} OK\r\n\r\n") ((Err _) true) (_ false)))
        (check c (match (parse-response-head "HTTP/1.1 200 caf\u{e9}\r\nX: 1\r\n\r\n") ((Ok h) (= (. h status) 200)) (_ false)))
        (check c (match (parse-response-head "HTTP/1.1 20\u{e9}\r\n\r\n") ((Err _) true) (_ false)))
        (checks-result c))))
