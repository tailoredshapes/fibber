;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (wide (fd/interval 1 10000)))
    (do (check c (= (l/run 1 (fn (q) (l/all [(fd/in q wide) (fd/< q (l/integer 10000))]))) [(l/integer 1)]))
        (check c (= (l/run 1 (fn (q) (l/all [(fd/in q wide) (fd/<= (l/integer 1) q)]))) [(l/integer 1)]))
        (check c (= (l/run 1 (fn (q) (l/all [(fd/in q wide) (fd/!= q (l/integer 1))]))) [(l/integer 2)]))
        (checks-result c))))
