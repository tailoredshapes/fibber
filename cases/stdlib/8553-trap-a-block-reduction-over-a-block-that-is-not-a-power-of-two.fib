;; spec:   types §2.17 (the gpu builtins); docs/design/gpu.md 6.7
;; expect: trap
;; trap:   fib.gpu.reduce: the block must be a power of two of at most 256 threads
;; roots:  ../../lib
;; `block-sum-i32` and its kin hold barriers and halve a stride, so the block must be a power of two of at most 256 threads; any other block is a device trap (here the
;; host index says three threads), not a wrong answer.
(ns main (:require [fib.gpu :as gpu] [fib.gpu.reduce :as r]))
(defun main () -> i64
  (do (gpu/host-launch [1] [3] (fn () (do (r/block-sum-i32 1i32) ())))
      0))
