;; spec: docs/design/dataloader.md
;; expect: reject
;; error: cannot be shared between threads
;; roots: ../../lib
(ns main (:use fib.core fib.seq fib.coll) (:require [fib.dataloader :as d]))
(defun main () -> i64
  (let [l (match (d/loader 1 (fn (keys: (Vec i64)) -> (Result (Vec (Result i64 str)) str) (Ok (mapv (fn (k: i64) (Ok k)) keys))))
            ((Ok l) l) ((Err m) (trap m)))
        task (spawn (fn () (d/load-many l [1])))]
    (do (join task) 0)))
