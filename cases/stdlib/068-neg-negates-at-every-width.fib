;; spec:   stdlib §4.3 (row neg), types §2.12 (Num: neg)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: neg
;; neg is the builtin Num method, and the library's ratio has it too. A
;; float keeps the sign of zero: (neg 0.0) is -0.0, whose reciprocal is
;; negative infinity (the sign is read through `/`, so no float is printed).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (neg 5) -5))
        (check c (= (neg -5) 5))
        (check c (= (neg 0) 0))
        (check c (= (neg (neg 7)) 7))
        (check c (= (neg 5i8) -5i8))
        (check c (= (neg -127i8) 127i8))
        (check c (= (neg 300i16) -300i16))
        (check c (= (neg -70000i32) 70000i32))
        (check c (= (neg 2.5) -2.5))
        (check c (= (neg -2.5f32) 2.5f32))
        (check c (< (/ 1.0 (neg 0.0)) 0.0))
        (check c (> (/ 1.0 (neg -0.0)) 0.0))
        (check c (= (show (neg (/ 1 2))) "-1/2"))
        (check c (= (neg (/ -3 4)) (/ 3 4)))
        (checks-result c))))
