;; spec:   stdlib §4.2 (row assert), syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  support
;; covers: assert
;; A passing assertion is unit and costs its test only: the message is
;; evaluated when the assertion fails and not before (it is the argument
;; of the trap in the arm that is not taken), the test is evaluated once,
;; and the assertion is a step like any other of a `do` and of a function
;; of type unit.
(ns main (:use tl.check))

(defun bump (c: (Cell i64)) -> bool (do (set! c (+ @c 1)) true))

(defun message (c: (Cell i64)) -> str (do (set! c (+ @c 100)) "never built"))

(defun checked (c: (Cell i64) m: (Cell i64)) -> unit
  (assert (bump c) (message m)))

(defun main () -> i64
  (let ((c (checks))
        (tests (cell 0))
        (messages (cell 0)))
    (do (checked tests messages)
        (checked tests messages)
        (assert (= @tests 2) "the test is evaluated once per call")
        (check c (= @tests 2))
        (check c (= @messages 0))
        (assert true)
        (check c (= (do (assert (> 2 1)) 5) 5))
        (checks-result c))))
