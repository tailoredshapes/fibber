;; spec:   stdlib §2.3 (Stack), §4.4 row pop, §1.2 P5
;; expect: trap
;; trap:   pop: empty
;; roots:  ../../lib support
;; covers: pop
;; (pop ()) throws in Clojure, so it traps here with the function's name; the empty list comes from popping a list of one.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((emptied (pop (list 7))))
    (count (pop emptied))))
