;; spec:   stdlib §4.3 (row mod: traps on zero)
;; expect: trap
;; trap:   integer rem by zero
;; roots:  ../../lib
;; covers: mod
;; mod is built on rem, so an integer zero divisor traps with rem's own
;; text (Clojure throws ArithmeticException "Divide by zero"); the library
;; cannot tell an integer from a float at a type variable, and a float zero
;; divisor is a NaN (case 052).
(ns main (:use fib.core))

(defun main () -> i64 (mod 5 0))
