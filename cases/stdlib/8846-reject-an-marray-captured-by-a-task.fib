;; spec:   stdlib §2.11 (Arrays: the race is the deviation), §4.1 rows aset MArray, §5 M2
;; expect: reject
;; error:  cell cannot be shared between threads: closure capture a, field c of MArray has type (Cell (Array i64))
;; roots:  ../../lib
;; covers: MArray aset
;; Clojure lets two threads write one array; an MArray holds a Cell, so the cell-capture check refuses the closure that would
;; take it to another task, with the page's message (A12 aset3).
(ns main)

(defun main () -> i64
  (let ((a (long-array 3)))
    (let ((t (spawn (fn () (aset a 0 1)))))
      (do (join t) (aget a 0)))))
