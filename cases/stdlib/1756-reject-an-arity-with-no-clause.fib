;; spec:   stdlib §7 L1
;; expect: reject
;; error:  area takes 1 or 2 argument(s), got 3
;; roots:  ../../lib support
;; covers: defn
;; The error lists the counts the function has.
(ns main)

(defn area
  ([s: i64] -> i64 (* s s))
  ([w: i64 h: i64] -> i64 (* w h)))

(defun main () -> i64 (area 1 2 3))
