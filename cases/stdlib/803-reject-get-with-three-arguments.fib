;; spec:   stdlib §7 D1, §4.5 (rows get, get-or), §5.5 S7
;; expect: reject
;; error:  get takes 2 argument(s), got 3
;; roots:  ../../lib
;; covers: get
;; Clojure's `(get m k d)` is a call of one argument too many: until arity overloading
;; lands (§7 L1) `get` is the two-argument lookup and the default is `get-or`. The
;; checker's arity error of a library function says which stand-in serves the
;; arity the call wrote, so the Clojure habit is told what to write.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (get {1 2} 1 0))
