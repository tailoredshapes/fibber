;; spec:   stdlib §2.7 (three printers), §2.3 (ToStr), §4.3 (row str)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; (str x) is ToStr: an integer or a bool is its digits or its word, a char
;; is itself, a string is itself, an Option is its payload's text and the
;; empty text for nil (Clojure's (str nil) is ""). The numbers print as the
;; builtin Show does, so the floats here are ones whose text C12 does not
;; change. A char above U+FFFF is four bytes of text, not a surrogate pair.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil)
        (smile (i32->char 128512i32)))
    (do (check c (= (str 42) "42"))
        (check c (= (str -7) "-7"))
        (check c (= (str 0) "0"))
        (check c (= (str 9223372036854775807) "9223372036854775807"))
        (check c (= (str (- -9223372036854775807 1)) "-9223372036854775808"))
        (check c (= (str 7i8) "7"))
        (check c (= (str -128i8) "-128"))
        (check c (= (str 300i16) "300"))
        (check c (= (str 70000i32) "70000"))
        (check c (= (str true) "true"))
        (check c (= (str false) "false"))
        (check c (= (str 1.5) "1.5"))
        (check c (= (str -0.5) "-0.5"))
        (check c (= (str 100.0) "100.0"))
        (check c (= (str 0.25f32) "0.25"))
        (check c (= (str \a) "a"))
        (check c (= (str \space) " "))
        (check c (= (str (i32->char 233i32)) "é"))
        (check c (= (str-len (str (i32->char 233i32))) 2))
        (check c (= (str-len (str smile)) 4))
        (check c (= (str "ab") "ab"))
        (check c (= (str "") ""))
        (check c (= (str (some 1)) "1"))
        (check c (= (str none) ""))
        (check c (= (str (some "a")) "a"))
        (checks-result c))))
