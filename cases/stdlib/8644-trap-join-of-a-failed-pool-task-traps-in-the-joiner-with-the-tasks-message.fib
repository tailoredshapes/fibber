;; spec:   types §8.8 (amended 2026-10-07, P-sched: traps in pool tasks); docs/adr/0001; rt/sched.lir
;; expect: trap
;; trap:   pool task failed
;; stage:  2
;; roots:  ../../lib support
;; `join` (and `@t`) of a pool task that failed traps in the joiner with the task's own message, as for a spawned task; main's trap ends
;; the program with that message after `trap in task: pool task failed` was written by the worker.
(ns main (:use fib.core fib.parallel))

(defun main () -> i64
  (let [t (fork-task (fn () (do (trap "pool task failed") 0)))]
    (join t)))
