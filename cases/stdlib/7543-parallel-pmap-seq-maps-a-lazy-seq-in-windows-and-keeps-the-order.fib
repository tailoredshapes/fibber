;; spec:   docs/design/parallelism.md 3.2 (pmap over lazy seqs); lib/fib/parallel/pmap.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `pmap-seq` realises a window of the lazy source on the calling thread, maps it in chunks, and goes on to the next window: the results are `map`'s,
;; in order, for sources shorter than, equal to and longer than one window (workers x 8 x grain items), and the source's items are each made
;; exactly once (a counter in the mapped source says so: a window realised twice would count more).
(ns main (:use fib.core fib.parallel tl.check))

(defun main () -> i64
  (let [c (checks)]
    (do (doseq [n [0 1 7 64 65 511 512 513 5000]]
          (doseq [w [1 3 8]]
            (let [p (Par w 4 false)
                  made (atom 0)
                  src (map (fn (i) (do (swap! made inc) (* 3 i))) (range n))]
              (do (check c (= (pmap-seq p (fn (x) (+ x 1)) src) (mapv (fn (i) (+ (* 3 i) 1)) (vec (range n)))))
                  (check c (= @made n))))))
        (checks-result c))))
