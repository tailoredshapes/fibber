;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; The point of overloading: `find` answers an Option with two arguments and the
;; value itself with a default. Each clause has its own `-> R`, and its own
;; `:where` (the second needs `Ord` on the value, the first does not).
(ns main (:use tl.check))

(defn look
  ([m: (Map i64 i64) k: i64] -> (Option i64) (get m k))
  ([m: (Map i64 i64) k: i64 d: i64] :where ((Ord i64)) -> i64 (if (< d 0) d (get-or m k d))))

(defun main () -> i64
  (let ((c (checks))
        (m {1 10 2 20}))
    (do (check c (= (look m 1) (some 10)))
        (check c (= (look m 5) nil))
        (check c (= (look m 5 7) 7))
        (check c (= (look m 2 7) 20))
        (checks-result c))))
