;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:8:12: kernel k: a closure: a kernel has no function values
;; A `fn` literal in a kernel (one that captures the index) is refused at the `fn`: a kernel has no function values.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0))
        (f (fn (x: i64) (+ x i))))
    (when (< i n) (gpu/f32-set! a i (sitofp f32 (f 2))))))
(defun main () -> i64 0)
