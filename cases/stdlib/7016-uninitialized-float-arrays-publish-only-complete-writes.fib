;; spec: spec/syntax.md 3.15; complete numeric buffer writes and clean owner release
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (dotimes (n 19)
          (unsafe
            (let ((a (array-uninit-f32 n)) (b (array-uninit-f64 n))
                  (ap (ptr+ (raw a) 24)) (bp (ptr+ (raw b) 24)))
              (do (dotimes (i n)
                    (do (store-f32 (ptr+ ap (* i 4)) (float i))
                        (store-f64 (ptr+ bp (* i 8)) (double i))))
                  (dotimes (i n)
                    (do (check c (= (array-get a i) (float i)))
                        (check c (= (array-get b i) (double i)))))))))
        (checks-result c))))
