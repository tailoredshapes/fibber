;; spec:   syntax §4.4 (rows for-each, range), stdlib §8.3 C
;; expect: accept
;; result: 0
;; audit:  clean
;; `(for-each c f)` is the counting loop only for a literal `(range a b)` and a literal
;; one-parameter `fn`. Any other call, a function value `f` or a collection `c`, is
;; `(fib.seq/run! f c)`: the library's walk with the function first. The prelude's own
;; `for-each` function is gone, so this expansion is all there is, over a Vec, a Map's pairs,
;; a range and a list.
(defun miss (bit: i64 ok: bool) -> i64 (if ok 0 bit))

(defun total (c: c f: (fn (i64) unit)) :where ((Reducible c i64)) -> unit (for-each c f))

(defun main () -> i64
  (let ((acc (cell 0))
        (add (fn (x: i64) (set! acc (+ @acc x)))))
    (do (for-each [1 2 3] add)
        (let ((a @acc))
          (do (for-each (range 0 4) add)
              (let ((b @acc))
                (do (total (list 10 20) add)
                    (for-each {1 2} (fn (e: (Pair i64 i64)) (set! acc (+ @acc (. e snd)))))
                    (+ (miss 1 (= a 6))
                       (+ (miss 2 (= b 12))
                          (miss 4 (= @acc 44)))))))))))
