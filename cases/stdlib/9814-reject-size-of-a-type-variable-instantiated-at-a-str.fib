;; spec: spec/types.md 1.9 (scalar-generic chunk): `(size-of a)` puts `(Num a)` on the definition, so an instance that is not a number is refused
;; expect: reject
;; error: no implementation of Num for str
;; roots: ../../lib support
;; The generic is fine alone; calling it with a str fails the Num obligation the size-of put on it.
(ns main)

(defun sz (x: a) -> i64 (size-of a))

(defun main () -> i64 (sz "hello"))
