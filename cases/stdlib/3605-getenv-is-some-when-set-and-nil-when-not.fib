;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: getenv
;; A variable that is set (PATH) is a some, one that is not is nil, and so is a name with a NUL in it.
(ns main (:use tl.check tl.sysx fib.unix))

(defun set? (o: (Option str)) -> bool (match o ((some s) true) (nil false)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (set? (getenv "PATH")))
        (check c (not (set? (getenv "FIB_S5_SURELY_NOT_SET_3605"))))
        (check c (not (set? (getenv "PA\0TH"))))
        (check c (not (set? (getenv ""))))
        (checks-result c))))
