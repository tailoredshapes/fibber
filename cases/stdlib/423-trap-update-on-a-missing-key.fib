;; spec:   stdlib §2.4 (update traps on a missing key), §1.2 P5, §4.5 (row update)
;; expect: trap
;; trap:   update: no key
;; roots:  ../../lib support
;; covers: update
;; (update m k f) hands f the value at k, and a key the map lacks is
;; Clojure's NullPointerException on (inc nil): here the trap `update: no
;; key`, after a good update has answered. update-or and update-opt are the
;; forms for a key that may be missing (case 424).
(ns main (:use fib.core fib.seq fib.coll))

(defun bump (x: i64) -> i64 (+ x 1))

(defun main () -> i64
  (let ((m (assoc (empty {1 0}) 1 10))
        (m2 (update m 1 bump)))
    (match (get (update m2 2 bump) 2) (nil 0) ((some x) x))))
