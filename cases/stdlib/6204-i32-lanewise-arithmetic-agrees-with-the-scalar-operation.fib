;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg on i32 vectors of [1, 2, 3, 4, 5, 8, 16] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-i32-1 (c: Checks) -> unit
  (let ((a: i32x1 <<-989>>i32) (b: i32x1 <<-993>>i32))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -989i32 -993i32)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -989i32 -993i32)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -989i32 -993i32)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -989i32)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ -989i32 2i32)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7i32 -989i32)))
        ()))
        ())))

(defun arith-i32-2 (c: Checks) -> unit
  (let ((a: i32x2 <<-989 -952>>i32) (b: i32x2 <<-993 -940>>i32))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ -989i32 -993i32)))
        (check c (= (lane r 1) (+ -952i32 -940i32)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- -989i32 -993i32)))
        (check c (= (lane r 1) (- -952i32 -940i32)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* -989i32 -993i32)))
        (check c (= (lane r 1) (* -952i32 -940i32)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg -989i32)))
        (check c (= (lane r 1) (neg -952i32)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ -989i32 2i32)))
        (check c (= (lane r 1) (+ -952i32 2i32)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7i32 -989i32)))
        (check c (= (lane r 1) (- 7i32 -952i32)))
        ()))
        ())))

