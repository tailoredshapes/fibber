(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: i32x2 <<-989 -952>>i32) (b: i32x2 <<-993 -940>>i32))
    (do (check p (= (lane (+ a b) 1) (- -952i32 -940i32)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-i32-1 c)
        (arith-i32-2 c)
        (arith-i32-3 c)
        (arith-i32-4 c)
        (arith-i32-5 c)
        (arith-i32-8 c)
        (arith-i32-16 c)
        (planted c)
        (checks-result c))))
