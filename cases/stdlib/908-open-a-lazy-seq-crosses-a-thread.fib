;; spec:   stdlib §5.5 S10, §2.1 rule 2, §7 C9 (the run-once cell)
;; expect: accept
;; result: 3
;; audit:  clean
;; roots:  ../../lib
;; open:   C9
;; A lazy seq is shared by two threads in Clojure. An LSeq holds a Cell
;; for its memo, and a Cell is never Send, so the program is refused
;; today: `cell cannot be shared between threads: closure capture s,
;; field box of LSeq has type (Cell (LState i64))` (A11 e8d). The
;; run-once cell of C9 makes the realisation of a node race-free.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s (to-lseq [1 2 3])))
    (let ((t (spawn (fn () (count s)))))
      (join t))))
