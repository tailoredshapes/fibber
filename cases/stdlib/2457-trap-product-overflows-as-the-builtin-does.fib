;; spec:   stdlib §4.4 (row product), §2.8 (overflow traps at every width), tranche 2 plan Y4
;; expect: trap
;; trap:   integer overflow in * at i64
;; roots:  ../../lib support
;; covers: product
;; product is the builtin * folded over the source, so a product that does not fit an i64 traps with
;; the builtin's text and does not wrap: 2^32 times 2^32 is 2^64.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (product [4294967296 4294967296]))
