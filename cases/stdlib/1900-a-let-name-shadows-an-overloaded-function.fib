;; spec:   stdlib §7 L1 (a name a form binds is not the clause set), expander scope
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; covers: defn
;; `pick` has clauses of one and two parameters. A `let` that binds `pick` to a function of three
;; calls the local: no clause takes three, so the pick must leave the call alone. The call after
;; the `let` is the clause again.
(defn pick
  ([a: i64] -> i64 (* a 10))
  ([a: i64 b: i64] -> i64 (+ a b)))

(defun main () -> i64
  (let ((local (let ((pick (fn (a: i64 b: i64 c: i64) -> i64 (+ a (+ b c)))))
                 (pick 1 2 3))))
    (if (= local 6)
        (if (= (pick 4) 40) (if (= (pick 4 5) 9) 0 3) 2)
        1)))
