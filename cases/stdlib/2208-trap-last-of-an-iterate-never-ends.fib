;; spec:   stdlib §4.4 (rows iterate, last), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   last: never ends
;; roots:  ../../lib support
;; covers: iterate last
;; Last of an iterate: no element is the last, so the override traps where the default walk would hang.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (unwrap-or (last (iterate inc 0)) 0))
