;; spec:   stdlib §2.3 (Reducible: nth traps out of range; O(1) on Array), §1.2 P5
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; The nth of an Array is its index, checked against its length: an array of three has the indexes 0 to 2.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (nth (array 3 1) 3))
