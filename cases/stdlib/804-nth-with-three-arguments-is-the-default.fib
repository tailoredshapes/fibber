;; spec:   stdlib §4.4 (row nth), §7 L1
;; expect: accept
;; result: 2
;; audit:  clean
;; roots:  ../../lib
;; covers: nth
;; `(nth c i d)`: the clause of three arguments of `nth` (L1), the default when the index is out of range;
;; `nth` of two arguments still traps out of range (§2.4).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (nth [1 2] 1 0))
