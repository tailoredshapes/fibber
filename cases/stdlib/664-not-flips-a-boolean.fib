;; spec:   stdlib §4.1 (row not), types §2.12 (not : (fn :send (bool) bool))
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: not
;; not is the builtin on bool: it flips true and false, it is its own inverse, it negates a comparison
;; and the result of any boolean expression, and, being a function of type (fn (bool) bool), it can be
;; passed along. That a condition of type (Option T) is accepted by it is L20 (case 677).
(ns main (:use fib.core tl.check))

(defun apply-to (f: (fn (bool) bool) x: bool) -> bool (f x))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (not true) false))
        (check c (= (not false) true))
        (check c (= (not (not true)) true))
        (check c (= (not (not false)) false))
        (check c (not (= 1 2)))
        (check c (not (< 3 2)))
        (check c (= (not (and true false)) true))
        (check c (= (not (or false false)) true))
        (check c (if (not (= "a" "b")) true false))
        (check c (= (not (== 0.0 -0.0)) false))
        (check c (apply-to not false))
        (check c (not (apply-to not true)))
        (checks-result c))))
