;; spec:   stdlib §4.4 (row reduce: the 2-arity traps `reduce: empty collection`), §1.2 P5
;; expect: trap
;; trap:   reduce: empty collection
;; roots:  ../../lib support
;; covers: reduce1
;; reduce-nonempty is the two-argument reduce of Clojure with no (f) to call
;; on an empty source: it traps, with the name of the function the program
;; wrote. reduce1 is the same walk that answers nil (case 207), which is
;; what the case calls first.
(ns main (:use fib.core fib.seq))

(defun plus (a: i64 x: i64) -> i64 (+ a x))

(defun main () -> i64
  (let ((ev: (Vec i64) (vec-empty)))
    (match (reduce1 plus ev)
      (nil (reduce-nonempty plus ev))
      ((some x) x))))
