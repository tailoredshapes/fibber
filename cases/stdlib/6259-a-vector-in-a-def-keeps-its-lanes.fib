;; spec:   types §1.9, stdlib L15 (def), docs/design/simd-and-tensors.md
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A def may hold a vector (a float, an integer and a mask vector): each lane read from a function, a closure and a loop agrees with the literal the def was initialised with, and a def initialised from an expression (the sum of two literals) holds that sum. A vector is a value, so a def of one is never counted or released.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(def kf: f64x4 <<1.5 2.5 3.5 4.5>>)
(def ki: i32x4 <<10 20 30 40>>i32)
(def km: (Simd bool 4) <<true false false true>>)
(def ksum: i64x2 (+ <<1 2>> <<10 20>>))

(defun lane-sum () -> f64 (loop ((i 0) (acc 0.0)) (if (< i 4) (recur (+ i 1) (+ acc (lane kf i))) acc)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (lane-sum) (+ 1.5 (+ 2.5 (+ 3.5 4.5)))))
        (check c (= kf <<1.5 2.5 3.5 4.5>>))
        (check c (= (hsum ki) 100i32))
        (check c (= (lane ki 2) 30i32))
        (check c (= (lane km 0) true)) (check c (= (lane km 1) false)) (check c (= (lane km 3) true))
        (check c (= ksum <<11 22>>))
        (let ((f (fn () (hsum kf)))) (check c (= (f) 12.0)))
        (let ((p (checks)))
          (do (check p (= (lane kf 0) 2.5)) (check-detects c p)))
        (checks-result c))))
