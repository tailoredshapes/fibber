;; spec:   stdlib §4.4 (row reduce: the identity table), §6.3 (R6b), §7 L19
;; expect: accept
;; result: 1
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce
;; (reduce + c) is (reduce + 0 c): the 0 the macro writes is an integer literal in an argument
;; position, which takes the float type it unifies with (L19), so a sum over f64 is
;; Clojure's (reduce + [1.5 2.5]) = 4.0. The two-argument form with a lambda has no identity
;; and works over any type (case 786).
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (> (reduce + [1.5 2.5]) 3.0) 1 0))
