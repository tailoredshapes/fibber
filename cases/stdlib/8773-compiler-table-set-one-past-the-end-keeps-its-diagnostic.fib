;; spec:   compiler/types/table.fib (table-set requires an existing row)
;; expect: trap
;; trap:   table-set: no row 1
;; stage:  2
;; roots:  ../../lib ../../compiler
(ns main (:use types.table))
(defun main () -> i64
  (let ((table (table-new)))
    (do (table-add table 7) (table-set table 1 9) 0)))
