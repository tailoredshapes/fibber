;; spec:   stdlib §4.4 (row range-by), §8.1 item 2 (differential tests against a naive reference), §9.4 of the plan
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: range-by
;; 300 seeded integer ranges (start and end in -100..100, a step of 1 to 12 either way) against a five-line
;; loop, the reference: the elements of to-vec in order, the count, nth at three indexes and the elements of the
;; lazy seq. The reference is written here, shares nothing with the library, and only uses the prelude's Vec.
;; The last two checks plant a fault in the reference (an end that is an element; the second element dropped)
;; and require the same comparison to fail, so the case shows it can.
(ns main (:use fib.core fib.seq tl.check tl.rng))

;; the reference: add the step, stop at the end; `fault` 1 includes the end, `fault` 2 drops the second element
(defun ref-range (lo: i64 hi: i64 by: i64 fault: i64) -> (Vec i64)
  (loop ((i lo) (n 0) (acc (vec-empty)))
    (if (if (> by 0) (if (= fault 1) (<= i hi) (< i hi)) (if (= fault 1) (>= i hi) (> i hi)))
        (recur (+ i by) (+ n 1) (if (if (= fault 2) (= n 1) false) acc (vec-conj acc i)))
        acc)))

;; the lazy seq's elements, as a Vec
(defun lseq-elements (s: (LSeq i64)) -> (Vec i64)
  (loop ((s s) (acc (vec-empty)))
    (match (lnode s)
      ((LNil) acc)
      ((LCons h t) (recur t (vec-conj acc h))))))

(defun same (v: (Vec i64) xs: (Vec i64)) -> bool
  (and (= (vec-count v) (vec-count xs))
       (loop ((i 0))
         (if (< i (vec-count v))
             (if (= (vec-nth v i) (vec-nth xs i)) (recur (+ i 1)) false)
             true))))

;; the library range against the reference with the given fault, at one triple
(defun agrees (lo: i64 hi: i64 by: i64 fault: i64) -> bool
  (let ((r (range-by lo hi by))
        (want (ref-range lo hi by fault))
        (n (vec-count (ref-range lo hi by fault))))
    (and (same (to-vec r) want)
         (and (= (count r) n)
              (and (same (lseq-elements (to-lseq r)) want)
                   (if (> n 0)
                       (and (= (nth r 0) (vec-nth want 0))
                            (and (= (nth r (- n 1)) (vec-nth want (- n 1)))
                                 (= (nth r (quot n 2)) (vec-nth want (quot n 2)))))
                       true))))))

;; 300 triples from a seed; the checks count into c
(defun sweep (c: Checks fault: i64) -> unit
  (let ((r (rng 20261001)))
    (dotimes (j 300)
      (let ((lo (- (rng-below r 201) 100))
            (hi (- (rng-below r 201) 100))
            (m (+ 1 (rng-below r 12)))
            (up (= (rng-below r 2) 0)))
        (check c (agrees lo hi (if up m (- 0 m)) fault))))))

(defun main () -> i64
  (let ((c (checks))
        (inclusive (checks))
        (dropped (checks)))
    (do (sweep c 0)
        (check c (= (checks-made c) 300))
        (sweep inclusive 1)
        (sweep dropped 2)
        (check-detects c inclusive)
        (check-detects c dropped)
        (checks-result c))))
