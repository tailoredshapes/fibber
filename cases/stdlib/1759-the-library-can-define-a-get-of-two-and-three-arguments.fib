;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; What Y11 will write in the library: `get` with and without a default, over a
;; Map. The module's own `get` hides the library's here, so the clauses call the
;; library's by its qualified name.
(ns main (:use tl.check))

(defn get
  ([m: (Map i64 i64) k: i64] -> (Option i64) (fib.coll/get m k))
  ([m: (Map i64 i64) k: i64 d: i64] -> i64 (fib.coll/get m k d)))

(defun main () -> i64
  (let ((c (checks))
        (m {1 10}))
    (do (check c (= (get m 1) (some 10)))
        (check c (= (get m 2) nil))
        (check c (= (get m 1 0) 10))
        (check c (= (get m 2 7) 7))
        (checks-result c))))
