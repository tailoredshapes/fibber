;; spec: spec/stdlib.md section 4.7 rows str/upper-case str/lower-case str/capitalize (Unicode full case mapping, locale independent)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; covers: str/upper-case str/lower-case str/capitalize
;; Package LIB-2. The expected texts are what Java 25 (Unicode 16.0) prints for String.toUpperCase(Locale.ROOT) and toLowerCase(Locale.ROOT) of the same inputs (recorded by a one-off program, D2.java of the package
;; report): the full mapping of SpecialCasing (ß is SS, ŉ is ʼN, the ligature ﬁ is FI, İ lowercases to i and U+0307, the Greek iota-subscript letters), and the final sigma (ΑΣ is ας, ΑΣΑ is ασα, ΑΣ.Β is ασ.β: a
;; full stop is skipped as case-ignorable; a combining mark after the sigma is skipped too; ΑΣΣ is ασς). The whole range of simple one-to-one mappings (all 1112064 scalar values, upper, lower, isLetter, isDigit,
;; isWhitespace, isUpperCase, isLowerCase) was compared with Java: 0 differences. capitalize is Clojure's: the first character upper-cased, the rest lower-cased.
(ns main (:use tl.check) (:require [fib.string :as str]))

(defun cps (xs: (Vec i64)) -> str (str-join (mapv (fn (n: i64) (char->str (i32->char (trunc i32 n)))) xs)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (str/upper-case "straße ǆ ﬁ héllo") "STRASSE Ǆ FI HÉLLO"))
        (check c (= (str/lower-case "straße ǆ ﬁ héllo") "straße ǆ ﬁ héllo"))
        (check c (= (str/lower-case "ΑΣ ΑΣΑ İ ÀÉ") "ας ασα i̇ àé"))
        (check c (= (str/lower-case "ΣΑΣ.") "σας."))
        (check c (= (str/lower-case "ΑΣ.Β") "ασ.β"))
        (check c (= (str/lower-case "Σ") "σ"))
        (check c (= (str/lower-case "ΑΣ'Α") "ασ'α"))
        (check c (= (str/upper-case (cps [329 32 912 32 496])) (cps [700 78 32 921 776 769 32 74 780])))
        (check c (= (str/lower-case (cps [913 931 769])) (cps [945 962 769])))
        (check c (= (str/lower-case (cps [65 769 931])) (cps [97 769 962])))
        (check c (= (str/lower-case "ΑΣΣ") "ασς"))
        (check c (= (str/upper-case (cps [8072])) (cps [7944 921])))
        (check c (= (str/upper-case "ᾳ") "ΑΙ"))
        (check c (= (str/upper-case "") ""))
        (check c (= (str/upper-case "abc XYZ 123") "ABC XYZ 123"))
        (check c (= (str/capitalize "hello wORLD") "Hello world"))
        (check c (= (str/capitalize "élan VITAL") "Élan vital"))
        (check c (= (str/capitalize "") ""))
        (check c (= (str/capitalize "ß") "SS"))
        (checks-result c))))
