;; spec:   stdlib §4.3 (row byte), §2.8 (conversions are checked)
;; expect: trap
;; trap:   byte: value out of range
;; roots:  ../../lib support
;; covers: byte
;; A float is cut toward zero and the integer must then fit: 127.9 is a byte (case 2857), 128.0
;; cuts to 128 and is not.
(defun main () -> i64 (sext i64 (byte 128.0)))
