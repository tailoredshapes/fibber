;; spec:   stdlib §2.8 (the components trap on overflow at their width), review finding of L1
;; expect: trap
;; trap:   integer overflow in / at i8
;; roots:  ../../lib
;; covers: /
;; 1/-128 is -1/128: the denominator, once the sign is fixed, is 128 and does
;; not fit an i8. The sign is fixed last, by the exact division of both
;; components by the gcd carrying the denominator's sign, so the trap is that
;; division of -128 by -1 (its text is the integer division's), and it is a
;; trap only because the normalised value does not fit (compare case 093,
;; where it does).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (numerator (/ 1i8 -128i8))))
    (if (= x 0i8) 1 2)))
