;; spec:   stdlib §2.3 (Collection s r e), §4.5 (row into)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: into set
;; (into to c) conj-es the elements of c onto to, in c's order, and answers the
;; target's own type. One generic function (fill) takes a Vec target and a Set
;; target; a Map target takes Pairs. The source is any Reducible: a Vec, an
;; Option, a Set, another Map (its Pairs), a lazy seq. A repeated element is
;; kept by a Vec and absorbed by a Set; a repeated key of a Map keeps its last
;; value.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun fill (to: t) :where ((Collection t t i64)) -> t (into to [3 1 2 3]))

(defun main () -> i64
  (let ((c (checks))
        (v (fill [9]))
        (s (fill (empty (set [0]))))
        (m (into (empty {1 0}) [(Pair 1 10) (Pair 2 20) (Pair 1 11)]))
        (m2 (into m (some (Pair 7 70))))
        (v2 (into [0] (set [5])))
        (m3 (into (empty {1 0}) m2))
        (ls (into [0] (lcons 1 (lcons 2 (lazy-node (fn () LNil)))))))
    (do (check c (= (count v) 5))
        (check c (= (nth v 0) 9))
        (check c (= (nth v 1) 3))
        (check c (= (nth v 4) 3))
        (check c (= (count s) 3))
        (check c (contains? s 1))
        (check c (contains? s 2))
        (check c (contains? s 3))
        (check c (= (count m) 2))
        (check c (is (get m 1) 11))
        (check c (= (count m2) 3))
        (check c (is (get m2 7) 70))
        (check c (is (get m2 2) 20))
        (check c (= (count v2) 2))
        (check c (= (nth v2 1) 5))
        (check c (= (count m3) 3))
        (check c (is (get m3 7) 70))
        (check c (= (count (into [] (into (empty (set [0])) [4 4 4]))) 1))
        (check c (= (count ls) 3))
        (check c (= (nth ls 2) 2))
        (checks-result c))))
