;; spec:   stdlib §4.3 (rows partial complement constantly), §2.2, §8.1 item 5 (count cases), tranche 2 plan Y6
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 6
;; roots:  ../../lib support
;; covers: partial complement constantly
;; A combinator allocates the closure it returns, once per call of the combinator, and its calls allocate nothing:
;; the three functions below are each called 1000 times in a loop. The bound 6 is the Checks (a struct and two
;; cells) and the three closures, nothing per call. (A bound one below the count fails: the lowered half of method
;; rule 3, run by the allocs tests over every count- case.)
(ns main (:use fib.core fib.seq tl.check))

(defun add (a: i64 b: i64) -> i64 (+ a b))

(defun main () -> i64
  (let ((c (checks))
        (p (partial add 1))
        (k (constantly 7))
        (odd (complement even?)))
    (do (check c (= (loop ((i 0) (acc 0)) (if (< i 1000) (recur (+ i 1) (+ acc (p i))) acc)) 500500))
        (check c (= (loop ((i 0) (acc 0)) (if (< i 1000) (recur (+ i 1) (+ acc (k i))) acc)) 7000))
        (check c (= (loop ((i 0) (acc 0)) (if (< i 1000) (recur (+ i 1) (if (odd i) (+ acc 1) acc)) acc)) 500))
        (checks-result c))))
