;; spec:   stdlib §4.1 (row Long/bitCount), §3 N12, types §2.12 (popcount)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Long/bitCount
;; (Long/bitCount x) is the number of one bits of the 64-bit two's complement of x, as Java's: a
;; negative number has many (-1 has 64), the minimum has one, the maximum 63, and the alternating
;; patterns 32. It is an i64 function: that a narrower integer is refused is case 674.
(ns main (:use fib.core tl.check) (:require [Long :as Long]))

(defun apply1 (f: (fn (i64) i64) x: i64) -> i64 (f x))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (Long/bitCount 0) 0))
        (check c (= (Long/bitCount 1) 1))
        (check c (= (Long/bitCount 255) 8))
        (check c (= (Long/bitCount 256) 1))
        (check c (= (Long/bitCount 1023) 10))
        (check c (= (Long/bitCount -1) 64))
        (check c (= (Long/bitCount -2) 63))
        (check c (= (Long/bitCount Long/MIN_VALUE) 1))
        (check c (= (Long/bitCount Long/MAX_VALUE) 63))
        (check c (= (Long/bitCount 6148914691236517205) 32))
        (check c (= (Long/bitCount -6148914691236517206) 32))
        (check c (= (Long/bitCount (bit-not 255)) 56))
        (check c (= (apply1 Long/bitCount 255) 8))
        (checks-result c))))
