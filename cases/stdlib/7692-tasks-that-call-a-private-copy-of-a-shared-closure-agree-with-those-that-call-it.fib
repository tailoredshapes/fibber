;; spec:   spec/types.md 2.10.2 (private-copy); docs/design/parallelism.md 3.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: private-copy, spawn
;; 28 tasks share one closure over a Vec and a String; each calls it 20 000 times, half of them through a private copy made in the task. The
;; sums agree with the sequential sum, and every copy (28 of them) and the closure are released exactly once: a copy that skipped the
;; retain of the Vec or the string frees them early (the audit and the sums fail), one that retained twice leaks (the audit fails).
(ns main (:use tl.check))

(defun work (f: (fn (i64) i64) n: i64) -> i64
  (loop ((i 0) (s 0)) (if (< i n) (recur (+ i 1) (+ s (f (rem i 50)))) s)))

(defun main () -> i64
  (let ((c (checks)) (v (mapv (fn (i: i64) (+ i 1)) (range 50))) (tag (str "k" 7)))
    (let ((f (fn (i: i64) (+ (nth v i) (str-len tag)))))
      (let ((want (work f 20000))
            (shared (mapv (fn (j: i64) (spawn (fn () (work f 20000)))) (range 14)))
            (copies (mapv (fn (j: i64) (spawn (fn () (let ((g (private-copy f))) (work g 20000))))) (range 14))))
        (do (check c (> want 0))
            (check c (every? (fn (t: (Task i64)) (= (join t) want)) shared))
            (check c (every? (fn (t: (Task i64)) (= (join t) want)) copies))
            (checks-result c))))))
