;; spec:   stdlib §4.3 (row defonce), §7 L15, tranche 2 plan Y6
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defonce
;; (defonce name: T v) is (def name: T v), evaluated once before main, and the macro hands everything after the
;; name to def, so (defonce name v) is (def name v). A def initialiser is a constant until L15, so these are
;; constants; case 2657 is the one for a call.
(ns main (:use fib.core fib.seq tl.check))

(defonce limit: i64 40)
(defonce greeting: str "hello")
(defonce primes: (Vec i64) [2 3 5 7])
(defonce answer 42)

(defun bump (n: i64) -> i64 (+ n limit))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= limit 40))
        (check c (= (bump 2) 42))
        (check c (= greeting "hello"))
        (check c (= (count primes) 4))
        (check c (= (reduce + 0 primes) 17))
        (check c (= answer 42))
        (check c (= (+ answer limit) 82))
        (checks-result c))))
