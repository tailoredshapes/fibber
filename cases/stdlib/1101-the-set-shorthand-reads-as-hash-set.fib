;; spec:   syntax §1.2 (`#{..}`), stdlib §7 E8
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; #{a b} is (hash-set a b): the same set, a repeated element is one, and #{}
;; is the empty set.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (e: (Set i64) #{}))
    (do (check c (= #{1 2} (hash-set 1 2)))
        (check c (= #{1 2 2 3} (hash-set 1 2 3)))
        (check c (= (count #{1 2 2 3}) 3))
        (check c (= (count e) 0))
        (check c (= #{3 1 2} (hash-set 1 2 3)))
        (checks-result c))))
