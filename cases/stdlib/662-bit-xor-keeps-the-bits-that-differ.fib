;; spec:   stdlib §4.1 (row bit-xor), types §2.12 (Bits)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bit-xor
;; The builtin bit-xor over two integers of one type keeps the bits that differ: a number against
;; itself is 0, against 0 is itself, against -1 is its complement, and it is its own inverse (the
;; exchange of two variables without a third is the proof the textbook gives, run below). It works at
;; every width.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (bit-xor 12 10) 6))
        (check c (= (bit-xor 255 15) 240))
        (check c (= (bit-xor 12345 12345) 0))
        (check c (= (bit-xor 12345 0) 12345))
        (check c (= (bit-xor 0 12345) 12345))
        (check c (= (bit-xor 12345 -1) (bit-not 12345)))
        (check c (= (bit-xor -1 -1) 0))
        (check c (= (bit-xor -9223372036854775808 9223372036854775807) -1))
        (check c (= (bit-xor (bit-xor 12345 678) 678) 12345))
        (check c (let ((a 12345) (b 678))
                   (let ((a1 (bit-xor a b)))
                     (let ((b1 (bit-xor a1 b)))
                       (let ((a2 (bit-xor a1 b1)))
                         (and (= a2 678) (= b1 12345)))))))
        (check c (= (bit-xor 127i8 -128i8) -1i8))
        (check c (= (bit-xor 15i8 60i8) 51i8))
        (check c (= (bit-xor -1i16 255i16) -256i16))
        (check c (= (bit-xor -1i32 65535i32) -65536i32))
        (checks-result c))))
