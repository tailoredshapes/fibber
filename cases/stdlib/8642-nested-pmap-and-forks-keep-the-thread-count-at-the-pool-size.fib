;; spec:   docs/design/parallelism.md 3.1 (one pool bounds nested parallel calls), 3.2; lib/fib/parallel/chunks.fib; rt/sched.lir
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; linux-only: counts the process threads from /proc/self/status; macOS has no /proc
;; A body of a parallel call may itself call one: nested pmaps and forks inside forks fork onto the same pool, so the number of threads of
;; the process stays the pool's (W workers, plus the program's thread and nothing else: /proc/self/task) however deep the nesting, where W x W
;; threads ran before P-sched (the header of chunks.fib said so). Checked with the thread count of fib.os.process after a pmap of pmaps of
;; pmaps over 64 x 64 x 64 elements and a fork tree of 4096 leaves, and with the results.
(ns main (:use fib.core fib.parallel fib.os fib.os.process tl.check))

(defun inner (i: i64) -> i64
  (reduce + 0 (pmap (fn (j) (reduce + 0 (pmap (fn (k) (+ i (+ j k))) (vec (range 64))))) (vec (range 64)))))

(defun forks (depth: i64) -> i64
  (if (= depth 0) 1 (let [t (fork-task (fn () (forks (- depth 1))))] (+ (forks (- depth 1)) (join t)))))

(defun main () -> i64
  (let [c (checks)
        xs (pmap inner (vec (range 64)))
        leaves (forks 12)
        threads (unwrap-or (thread-count) -1)]
    (do (check c (= (reduce + 0 xs) (* 3 (* 64 (* 64 (quot (* 63 64) 2))))))
        (check c (= leaves 4096))
        (check c (>= threads 2))
        (check c (<= threads (+ (pool-workers) 1)))
        (checks-result c))))
