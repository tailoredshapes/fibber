;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:7:34: kernel k: a Simd value: a kernel is scalar code
;; The SIMD lane model is the CPU's (gpu.md 5.3): a `(simd ..)` value in a kernel is refused at the form.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)) (v (simd 1.0f32 2.0f32 3.0f32 4.0f32)))
    (when (< i n) (gpu/f32-set! a i (lane v 0)))))
(defun main () -> i64 0)
