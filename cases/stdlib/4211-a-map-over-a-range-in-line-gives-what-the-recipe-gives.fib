;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see); docs/design/vec-performance.md item 2; compiler/expand/fuseinline.fib, fuserange.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: mapv vec into map range range-by range-walk-kind
;; A chain of `map` steps over a `range` call, `(mapv f (range n))`, `(vec (map f (range a b)))`, `(into [] (map f (range a b s)))`,
;; is written out by the expander as a counted loop that walks the range itself, start plus step plus step .., with f's body
;; in line (compiler/expand/fuserange.fib). Each result here is compared with an eager twin, a `loop` of `conj` that no rewrite
;; touches: sizes on both sides of the 32-element spans of the output (0, 1, 31, 32, 33, 64, 65, 1057), ascending and descending
;; steps, a step that does not divide the length, an empty range of each kind (start at the end, a step away from it, a step of
;; zero at the end), i64 and f64 ranges (the floats accumulate, so the eleventh of 0.0 by 0.1 is 0.9999999999999999), counted
;; elements (strings), a chain of two stages, a named function, a literal that captures, and ranges that end at the largest and
;; start at the smallest i64 (the walk never adds past its last element, so nothing overflows).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun sq (x: f64) -> f64 (* x x))
(defun tag (x: i64) -> str (str "t" x))

;; the eager twins: the elements lo, lo + by, .. while before hi, through f
(defun twin-i64 (lo: i64 hi: i64 by: i64 f: (fn (i64) i64)) -> (Vec i64)
  (loop ((x lo) (acc [])) (if (if (> by 0) (< x hi) (> x hi)) (recur (+ x by) (conj acc (f x))) acc)))
(defun twin-f64 (n: i64 f: (fn (i64) f64)) -> (Vec f64)
  (loop ((i 0) (acc [])) (if (< i n) (recur (+ i 1) (conj acc (f i))) acc)))

(defun one-size (c: Checks n: i64) -> unit
  (do (check c (= (mapv (fn (i) (* 3 i)) (range n)) (twin-i64 0 n 1 (fn (i) (* 3 i)))))
      (check c (= (mapv (fn (i) (* 0.5 (double i))) (range n)) (twin-f64 n (fn (i) (* 0.5 (double i))))))
      (check c (= (vec (map (fn (i) (- i 7)) (range 7 (+ n 7)))) (twin-i64 0 n 1 (fn (i) i))))
      (check c (= (into [] (map (fn (i: i64) (* i i)) (range (- n 1) -1 -1))) (twin-i64 (- n 1) -1 -1 (fn (i) (* i i)))))
      (check c (= (vec (map sq (map (fn (i) (double i)) (range 0 n 3)))) (twin-f64 (quot (+ n 2) 3) (fn (i) (sq (double (* 3 i)))))))
      (check c (= (mapv tag (range n)) (mapv tag (twin-i64 0 n 1 (fn (i) i)))))
      (check c (= (count (mapv (fn (i) i) (range n))) n))))

(defun main () -> i64
  (let ((c (checks)) (k 5))
    (do (one-size c 0) (one-size c 1) (one-size c 31) (one-size c 32) (one-size c 33)
        (one-size c 64) (one-size c 65) (one-size c 1057)
        ;; empty ranges: at the end, a step away from the end, a step of zero at the end
        (check c (= (mapv (fn (i) (* 2 i)) (range 5 5)) []))
        (check c (= (mapv (fn (i) (* 2 i)) (range 5 9 -1)) []))
        (check c (= (mapv (fn (i) (* 2 i)) (range 5 5 0)) []))
        (check c (= (mapv (fn (i) (* 2 i)) (range -3)) []))
        ;; floats accumulate as the range's own walk does
        (check c (= (mapv (fn (x) x) (range 0.0 1.0 0.1)) (vec (range 0.0 1.0 0.1))))
        (check c (= (nth (mapv (fn (x) x) (range 0.0 1.0 0.1)) 10) 0.9999999999999999))
        (check c (= (mapv sq (range 2.5)) [0.0 1.0 4.0]))
        ;; a literal that captures, a range-by call
        (check c (= (mapv (fn (i) (* k i)) (range 4)) [0 5 10 15]))
        (check c (= (vec (map (fn (i) (+ i 1)) (range-by 10 0 -3))) [11 8 5 2]))
        ;; the ends of i64: the last element is 9223372036854775806 and nothing is added to it
        (check c (= (mapv (fn (x) (- x 9223372036854775800)) (range 9223372036854775800 9223372036854775807 2)) [0 2 4 6]))
        (check c (= (mapv (fn (x) (+ x 9223372036854775800)) (range -9223372036854775800 -9223372036854775808 -3)) [0 -3 -6]))
        (check c (= (checks-made c) 67))
        (checks-result c))))
