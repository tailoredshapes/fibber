;; spec:   stdlib §2.1 rule 5 (the bufferless cursors after L16), §7 L16
;; expect: accept
;; result: 48
;; audit:  clean
;; roots:  ../../lib support
;; Before L16 the cursor of a recipe was the VecCur of its whole walk, so a `Mapped` over a `Repeat` as the second operand of a fused walk never returned (out of
;; memory). Now the cursor pulls: 3 pairs of (x, 5 + 1) from the first operand's three elements: (1+6) + (2+6) + (3+6) = 24, plus `Taken` over the same endless source
;; as the second operand of a walk that ends with the shorter side: 2 pairs of 2 * 6, 24 more. 24 + 24.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (+ (reduce + 0 (ZipWith [1 2 3] (Mapped (Repeat 5) (fn (a: i64) (+ a 1))) (fn (a: i64 b: i64) (+ a b))))
     (reduce + 0 (ZipWith [1 2 3] (Taken (Repeat 6) 2) (fn (a: i64 b: i64) (* 2 b))))))
