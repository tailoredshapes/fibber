;; spec:   stdlib §4.5 (row assoc), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: assoc
;; (assoc m k1 v1 k2 v2 ..) is (assoc (assoc m k1 v1) k2 v2 ..), one pair at a time
;; from the left, so a key given twice keeps its last value. It works on a Map and
;; on a Vec (an index at most the count; the count appends). The three-argument call
;; is the library's own. Keys and values are evaluated once each, left to right, the
;; collection first.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun note (trail: (Cell i64) v: i64) -> i64 (do (set! trail (+ (* @trail 10) v)) v))

(defun main () -> i64
  (let ((c (checks))
        (trail (cell 0))
        (m (assoc {} 1 10 2 20 3 30))
        (twice (assoc {} 1 10 2 20 1 11))
        (names (assoc {} "a" 1 "b" 2))
        (w (assoc [0 0 0] 0 5 2 7))
        (grown (assoc [0 0] 1 8 2 9 3 10)))
    (do (check c (= (count m) 3))
        (check c (= (get m 3) (some 30)))
        (check c (= (get twice 1) (some 11)))
        (check c (= (count twice) 2))
        (check c (= (get names "b") (some 2)))
        (check c (= w [5 0 7]))
        (check c (= grown [0 8 9 10]))
        (check c (= (assoc {} 1 10) {1 10}))
        (check c (= (assoc {} 1 10 2 20 3 30 4 40 5 50) {1 10 2 20 3 30 4 40 5 50}))
        (check c (= (get (assoc {} (note trail 1) (note trail 2) (note trail 3) (note trail 4)) 3) (some 4)))
        (check c (= @trail 1234))
        (checks-result c))))
