;; spec: spec/types.md 1.9 (scalar-generic chunk): (convert e) in a function generic over the float width is chosen per instance
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; scale multiplies by (convert 0.7071): the literal itself in the f64 instance and its fptrunc in the f32 one, so the f32 result is exactly (* x 0.7071f32) and the f64 one (* x 0.7071).
(ns main (:use tl.check))

(defun scale (x: a) :where ((Num a) (Float a)) -> a (* x (convert 0.7071)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (scale 3.0) (* 3.0 0.7071)))
        (check c (= (scale 3.0f32) (* 3.0f32 0.7071f32)))
        (check c (= (scale 0.1f32) (* 0.1f32 0.7071f32)))
        (check c (= (scale 1.0f32) 0.7071f32))
        (check c (= (checks-made c) 4))
        (checks-result c))))
