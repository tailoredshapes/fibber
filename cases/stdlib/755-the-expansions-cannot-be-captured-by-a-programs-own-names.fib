;; spec:   stdlib §6.3 (a macro's expansion names its functions by qualified heads), §2.7
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str println prn
;; The program defines functions called show, str-concat, to-str, debug and print-str
;; that answer "WRONG", the names an expansion of the printing macros calls. A bare
;; head would be captured by them; the macros write fib.prelude/show,
;; fib.prelude/str-concat, fib.prelude/println, fib.prelude/print-str, fib.core/to-str
;; and fib.core/debug, which a definition of the program's cannot shadow (the same hygiene
;; as cases/modules/020's list). The text of what println and prn write is judged by case 751's
;; test; here the case runs the three macros whose result is a value, str and the
;; calls of the user's own functions that must still be the user's.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun show (x: i64) -> str "WRONG")
(defun str-concat (a: str b: str) -> str "WRONG")
(defun to-str (x: i64) -> str "WRONG")
(defun debug (x: i64) -> str "WRONG")
(defun print-str (x: str) -> str "WRONG")

(defun unit? (u: unit) -> bool true)

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (str 1 2 "x") "12x"))
        (check c (= (str 7) "7"))
        (check c (= (show 5) "WRONG"))
        (check c (= (str-concat "a" "b") "WRONG"))
        (check c (= (to-str 5) "WRONG"))
        (check c (= (debug 5) "WRONG"))
        (check c (= (print-str "z") "WRONG"))
        (check c (unit? (println 1 2)))
        (check c (unit? (prn 3 "q")))
        (check c (unit? (print 1)))
        (newline)
        (checks-result c))))
