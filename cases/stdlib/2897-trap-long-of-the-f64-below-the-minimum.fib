;; spec:   stdlib §4.3 (row long), §2.8 (conversions are checked)
;; expect: trap
;; trap:   long: value out of range
;; roots:  ../../lib support
;; covers: long
;; The f64 below the minimum: -2^63 is a long (case 2854); the next f64 down, -2^63 - 2048, is not.
(defun main () -> i64 (long -9223372036854777856.0))
