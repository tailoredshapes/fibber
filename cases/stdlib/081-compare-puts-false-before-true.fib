;; spec:   types §2.12 (Ord on every scalar), stdlib §4.3 (rows compare max min)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: compare max min
;; false is before true: (compare false true) is -1 and (compare true false)
;; is 1, as Boolean.compareTo's, and max and min of two bools follow from `<`.
;; The compiled program once lowered `<` on a bool as a signed compare of an i1,
;; which reads true as -1 and put it below false (cases/ownership 221 is the
;; operator's case; this is the library's, built on it).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (compare false true) -1))
        (check c (= (compare true false) 1))
        (check c (= (compare true true) 0))
        (check c (= (compare false false) 0))
        (check c (< false true))
        (check c (not (< true false)))
        (check c (= (max false true) true))
        (check c (= (max true false) true))
        (check c (= (min false true) false))
        (check c (= (min true false) false))
        (checks-result c))))
