;; spec:   syntax §1.1 (the vector literal `<<..>>`), docs/design/simd-and-tensors.md 2.3
;; expect: reject
;; error:  must be followed immediately by a form
;; stage:  2
;; roots:  ../../lib support
;; The read error `PrefixWithoutForm`: the reader refuses the literal before any typing, with the message above, at the element or the literal.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((v <<1 '>>))
    0))
