;; spec:   types §3.3 and §4.1 (the liberal coverage condition), stdlib §7 L16
;; expect: accept
;; result: 7
;; audit:  clean
;; roots:  ../../lib support
;; The probe of L16: `(impl (Cur (Wrap k)) (Box c) :where ((Cur c k)) ..)` names `k`, which no head variable is, but which `(Cur c k)` determines from `c`.
;; It was `type variable k is not a parameter of the impl head`. The cursor of a box of a box of a source is a wrap of a wrap of the number.
(ns main (:use fib.core))

(defprotocol (Cur s c) (cur (self) -> c))
(defstruct Src (n: i64))
(defstruct (Wrap k) (v: k))
(defstruct (Box c) (inner: c))
(impl (Cur i64) Src (cur (self) (. self n)))
(impl (Cur (Wrap k)) (Box c) :where ((Cur c k))
  (cur (self) (Wrap (cur (. self inner)))))

(defun main () -> i64
  (. (. (cur (Box (Box (Src 7)))) v) v))
