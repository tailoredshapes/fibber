;; spec:   stdlib §2.7 (Show, ToStr, Debug), §2.8 (ratio text), §4.3 (row Ratio)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Ratio /
;; A ratio is written 7/2, with a minus sign in front of the numerator, and a
;; ratio whose denominator is 1 as the integer alone (the page's (/ 6 3)
;; prints 2): by the builtin show, by to-str (which is what `str` calls)
;; and by debug (which `pr` calls), at every width.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (show (/ 7 2)) "7/2"))
        (check c (= (to-str (/ 7 2)) "7/2"))
        (check c (= (debug (/ 7 2)) "7/2"))
        (check c (= (show (/ -7 2)) "-7/2"))
        (check c (= (to-str (/ 7 -2)) "-7/2"))
        (check c (= (debug (/ -7 -2)) "7/2"))
        (check c (= (show (/ 6 3)) "2"))
        (check c (= (to-str (/ 6 3)) "2"))
        (check c (= (debug (/ 8 -4)) "-2"))
        (check c (= (show (/ 0 9)) "0"))
        (check c (= (show (/ 7i8 2i8)) "7/2"))
        (check c (= (to-str (/ 7i16 2i16)) "7/2"))
        (check c (= (debug (/ 7i32 2i32)) "7/2"))
        (check c (= (show (Ratio 1 4)) "1/4"))
        (checks-result c))))
