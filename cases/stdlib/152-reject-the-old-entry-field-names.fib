;; spec:   stdlib §2.3 (the prelude's Entry gives way to Pair), §8.3 B
;; expect: reject
;; error:  has no field key
;; roots:  ../../lib support
;; The entry a for-each over a Map hands out is a Pair, whose fields are fst and snd: the prelude's old
;; Entry had key and val, and a program that still reads them is refused with the checker's own message,
;; not run on a struct that no longer has them.
(ns main)

(defun main () -> i64
  (let ((m (assoc (map-empty) 1 2)) (n (cell 0)))
    (do (for-each m (fn (e) (set! n (+ @n (. e key)))))
        @n)))
