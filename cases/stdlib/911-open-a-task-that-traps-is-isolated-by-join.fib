;; spec:   stdlib §5.5 S16, §2.10, §7 L28 (exceptions, step 2)
;; expect: accept
;; result: 5
;; audit:  clean
;; open:   L28
;; A task's trap ends the whole process today (types §2.11): `trap: boom`
;; and, compiled, Aborted (A11 t40, e9). L28's second step returns a
;; task's trap from `join`, so the joiner may go on. The program ignores
;; what join returns, so it does not fix that type.
(defun main () -> i64
  (let ((t (spawn (fn () (trap "boom")))))
    (do (join t)
        5)))
