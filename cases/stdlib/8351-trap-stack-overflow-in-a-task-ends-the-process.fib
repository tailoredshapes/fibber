;; spec:   docs/design/stack.md, docs/adr/0001, docs/adr/0009 (fatal list)
;; expect: trap
;; trap:   stack overflow
;; roots:  ../../lib support
;; A task's thread has a stack of 8 MiB. A task that outruns it is not a trap the task survives (docs/adr/0001 isolates a task's traps, but a stack overflow is
;; on the fatal list): `join` never answers a failure, the process says `trap: stack overflow` (not `trap in task:`) and ends with status 134.
;; Killed by: scripts/mutant-stack-guard.sh `no-task-guard` (the task's thread keeps no signal stack: the handler cannot run).
(ns main (:use fib.core fib.async))

(defun climb (n: i64) -> i64
  (if (= n 0) 0 (- (* 2 n) (climb (- n 1)))))

(defun main () -> i64
  (join (spawn (fn () (climb 1000000000)))))
