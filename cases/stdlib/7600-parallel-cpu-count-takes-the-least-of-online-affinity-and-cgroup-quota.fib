;; spec:   docs/design/parallelism.md 3.2 (P-struct); lib/fib/parallel/cpu.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `cpu-count` is the least of the online CPUs (sysconf, which ignores affinity and cgroups), the affinity mask (/proc/self/status) and the
;; cgroup quota (cpu.max, rounded up), clamped to [1, max-workers]. The parsers and the policy are pure and are checked on fixed inputs: a
;; policy that kept the sysconf count (the documented over-count under `taskset` and `docker --cpus`) fails the rows with an affinity or a
;; quota; a quota that rounds down fails "1.5 CPUs is 2"; a list parser that counts a range as its two ends fails "0-3,8,10-11 is 7".
;; Planted fault (`p`): the policy that only reads sysconf must be caught by the same rows.
(ns main (:use fib.parallel fib.parallel.cpu tl.check))

(defun sysconf-only (online: i64 affinity: i64 quota: i64) -> i64 (max 1 (min (max-workers) online)))

(defun rows (c: Checks policy: (fn (i64 i64 i64) i64)) -> unit
  (do (check c (= (policy 28 0 0) 28))
      (check c (= (policy 28 4 0) 4))
      (check c (= (policy 28 0 2) 2))
      (check c (= (policy 28 8 3) 3))
      (check c (= (policy 4 28 0) 4))
      (check c (= (policy 1000 0 0) (max-workers)))
      (check c (= (policy 0 0 0) (max-workers)))))

(defun main () -> i64
  (let [c (checks) p (checks)]
    (do (rows c least-known)
        (rows p sysconf-only)
        (check-detects c p)
        (check c (= (cpu-list-count (str-bytes "0-27\n")) 28))
        (check c (= (cpu-list-count (str-bytes "0-3,8,10-11\n")) 7))
        (check c (= (cpu-list-count (str-bytes "5")) 1))
        (check c (= (cpu-list-count (str-bytes "")) 0))
        (check c (= (cpu-list-count (str-bytes "2,4,6\n")) 3))
        (check c (= (digit-runs (str-bytes "max 100000\n")) [100000]))
        (check c (= (digit-runs (str-bytes "150000 100000\n")) [150000 100000]))
        (check c (= (quota-cpus 150000 100000) 2))
        (check c (= (quota-cpus 100000 100000) 1))
        (check c (= (quota-cpus 200000 100000) 2))
        (check c (= (quota-cpus -1 100000) 0))
        (check c (= (quota-cpus 0 0) 0))
        (let [n (cpu-count)]
          (do (check c (>= n 1))
              (check c (<= n (max-workers)))
              (check c (<= n (online-cpus)))
              (check c (or (= (affinity-cpus) 0) (<= n (affinity-cpus))))))
        (checks-result c))))
