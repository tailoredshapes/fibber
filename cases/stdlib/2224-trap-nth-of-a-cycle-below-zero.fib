;; spec:   stdlib §4.4 (rows cycle, nth), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: cycle nth
;; Nth of an index below zero is out of range at once; the walk would go round the cycle for ever.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (nth (cycle [1 2 3]) -1))
