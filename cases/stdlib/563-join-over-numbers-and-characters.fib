;; spec:   stdlib §4.7 (row clojure.string/join; `(str/join ", " [1 2 3])`), §2.7 (ToStr), plan §6 L10b, L11
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.string/join
;; Clojure's most used `join` is over numbers, `(str/join ", " [1 2 3])`, and over the characters of
;; a string, `(str/join "" (reverse s))`. Both need the `ToStr` instances of the scalars, which the
;; printing part writes (L11, loaded by `:use`ing fib.print). The case was OPEN until L11 landed: before
;; it the checker said `no implementation of ToStr for i64`. Case 550 shows `join` over the sources
;; and element types that had an instance before.
(ns main (:use fib.core fib.seq fib.print tl.check) (:require [fib.string :as str]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (str/join ", " [1 2 3]) "1, 2, 3"))
        (check c (= (str/join "" [1 2 3]) "123"))
        (check c (= (str/join "-" [\a \b \c]) "a-b-c"))
        (check c (= (str/join "+" [true false]) "true+false"))
        (check c (= (str/join "," [-5 0 7]) "-5,0,7"))
        (checks-result c))))
