;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 494445
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Test 13 of the design, at case size: 100,000 iterations each make a vector and a string, and every second one throws an exception
;; made from them (an argument, so the frame still holds both when it throws: a throw in tail position would release them first); every throw is caught, and the audit is clean (every object freed once). The rate of a million throws is measured in
;; docs/design/exceptions.md 9. Killed by: scripts/mutant-catch.sh `no-release`.
(ns main (:use fib.core fib.ex fib.datum))

(defun work (i: i64) -> i64
  (let ((v [i i i]) (s (str-concat "n" (show i))))
    (+ (count v) (if (= (rem i 2) 0) (throw (ex-assoc (ex s) :i (DInt i))) (str-len s)))))

(defun main () -> i64
  (loop ((i 0) (acc 0))
    (if (= i 100000)
        acc
        (recur (+ i 1) (+ acc (try (work i) (catch e 1)))))))
