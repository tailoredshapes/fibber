;; spec:   types §1.9 (loads), docs/design/simd-and-tensors.md 2.7
;; expect: trap
;; trap:   simd-load: lanes out of range of the array
;; stage:  2
;; roots:  ../../lib support
;; One check per vector: the last lane of the load at index 4 of a 7-element array is element 7, which does not exist, so the load traps and no lane is read.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (array 7 1.5)))
    (let ((v: f64x4 (simd-load a 4)))
      (do (println (hsum v)) 0))))
