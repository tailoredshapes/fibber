;; spec:   stdlib §4.4 (row sort: fewer than two elements come back as they are), §8.1 item 5 (count cases)
;; expect: accept
;; result: 0
;; audit:  clean
;; allocs: <= 5
;; roots:  ../../lib support
;; covers: sort
;; Sorting one element has nothing to order: the Vec comes back inside the
;; VSeq as it is, with no buffer, no cell and no rebuilt Vec. The input is a
;; `def` of one integer (its own objects are not in the trace). The run
;; allocates 5 objects under both tools (measured: a bound of 0 reports 5);
;; the merge route over one element, which a `(< n 1)` test would take,
;; allocates more.
(ns main (:use fib.core fib.seq tl.check))

(def input: (Vec i64) [41])

(defun main () -> i64
  (let ((c (checks))
        (out (to-vec (sort input))))
    (do (check c (= (vec-count out) 1))
        (check c (= (vec-nth out 0) 41))
        (checks-result c))))
