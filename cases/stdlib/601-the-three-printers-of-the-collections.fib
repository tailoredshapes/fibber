;; spec:   stdlib §2.7 (the table of the three printers), §2.3 (ToStr, Debug)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; The page's table, one row per kind of value, on the types a program can
;; write: Show (println's text) leaves strings bare at every depth, Debug
;; (pr's) quotes them, and ToStr (str's) of a collection is its Debug text, so
;; (str ["a" "b"]) is ["a" "b"] while (println ["a" "b"]) shows [a b]. A Vec, a
;; Pair and a Triple are in brackets, a Set is #{..}, a Map {k v, k v}, and the
;; seqs (a List, a VSeq, an LSeq, a Range) are in parentheses. A Set or Map of two
;; elements is in the order its walk gives, which the page leaves open, so
;; those two checks accept either order. A Vec has one element type, so the
;; page's row `["a" 1]` is here a Vec of strings and a Triple.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks))
        (ss ["a" "b"])
        (ns [1 2])
        (nested [[1 2] [3]])
        (nss [["a"]])
        (e: (Vec i64) (vec-empty))
        (p (Pair 1 2))
        (t (Triple 1 "a" \b))
        (s1 (conj (set-empty) 7))
        (s2 (conj (conj (set-empty) 1) 2))
        (se: (Set i64) (set-empty))
        (m1 (assoc (map-empty) "a" 1))
        (m2 (assoc (assoc (map-empty) 1 2) 3 4))
        (me: (Map i64 i64) (map-empty))
        (l (list 1 2))
        (ls (list "a"))
        (vs (rest ["a" "b" "c"]))
        (ve (rest ["a"]))
        (lz (lseq-vec ["a" "b"]))
        (r3 (range 3))
        (r0 (range 0))
        (rf (range-by 0.0 1.0 0.5)))
    (do (check c (= (str ss) "[\"a\" \"b\"]"))
        (check c (= (show ss) "[a b]"))
        (check c (= (debug ss) "[\"a\" \"b\"]"))
        (check c (= (str ns) "[1 2]"))
        (check c (= (show ns) "[1 2]"))
        (check c (= (debug ns) "[1 2]"))
        (check c (= (str nested) "[[1 2] [3]]"))
        (check c (= (show nss) "[[a]]"))
        (check c (= (debug nss) "[[\"a\"]]"))
        (check c (= (str nss) "[[\"a\"]]"))
        (check c (= (str e) "[]"))
        (check c (= (show e) "[]"))
        (check c (= (str p) "[1 2]"))
        (check c (= (show p) "[1 2]"))
        (check c (= (debug p) "[1 2]"))
        (check c (= (str t) "[1 \"a\" \\b]"))
        (check c (= (show t) "[1 a b]"))
        (check c (= (debug t) "[1 \"a\" \\b]"))
        (check c (= (str s1) "#{7}"))
        (check c (let ((x (str s2))) (or (= x "#{1 2}") (= x "#{2 1}"))))
        (check c (= (str se) "#{}"))
        (check c (= (str m1) "{\"a\" 1}"))
        (check c (= (show m1) "{a 1}"))
        (check c (= (debug m1) "{\"a\" 1}"))
        (check c (let ((x (show m2))) (or (= x "{1 2, 3 4}") (= x "{3 4, 1 2}"))))
        (check c (= (str me) "{}"))
        (check c (= (str l) "(1 2)"))
        (check c (= (debug ls) "(\"a\")"))
        (check c (= (str vs) "(\"b\" \"c\")"))
        (check c (= (show vs) "(b c)"))
        (check c (= (debug vs) "(\"b\" \"c\")"))
        (check c (= (show ve) "()"))
        (check c (= (str lz) "(\"a\" \"b\")"))
        (check c (= (show lz) "(a b)"))
        (check c (= (debug lz) "(\"a\" \"b\")"))
        (check c (= (str (lseq-vec e)) "()"))
        (check c (= (str r3) "(0 1 2)"))
        (check c (= (show r3) "(0 1 2)"))
        (check c (= (debug r3) "(0 1 2)"))
        (check c (= (str r0) "()"))
        (check c (= (show (range-by 10 0 -5)) "(10 5)"))
        (check c (= (show rf) "(0.0 0.5)"))
        (checks-result c))))
