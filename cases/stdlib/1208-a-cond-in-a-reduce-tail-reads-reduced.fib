;; spec:   stdlib §4.3 (row reduce), §6.3 (E4); syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce cond
;; The tail walker of the reduce macro reads the flat cond: the expressions are the tails, so a (reduced e)
;; there stops the fold, and the tests are not tails. A bracket fn is the literal fn the macro wants.
(ns main (:use tl.check))

(defun main () -> i64
  (let [c (checks)
        stopped (reduce (fn [acc x]
                          (cond (> acc 10) (reduced acc)
                                :else (+ acc x)))
                        0
                        [4 5 6 7 8])
        whole (reduce (fn [acc x]
                        (cond (> acc 100) (reduced acc)
                              (> x 0) (+ acc x)
                              :else acc))
                      0
                      [1 2 3])]
    (do (check c (= stopped 15))
        (check c (= whole 6))
        (checks-result c))))
