;; spec:   stdlib §4.4 (row cycle: an empty source ends at once), §4.4 row nth (traps out of range)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: cycle nth
;; The cycle of an empty source has no element 0: the walk for it ends at the first pass that yields
;; nothing and `nth` traps as it does past the end of a Vec.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((e: (Vec i64) []))
    (nth (cycle e) 0)))
