;; spec:   stdlib §4.4 row reduce-kv ("the walk passes k and v as two arguments, so it builds no Pair"), §2.1 (a walk allocates per call, not per element), §8.1 item 5
;; expect: accept
;; result: 179700
;; audit:  clean
;; allocs: <= 2335
;; roots:  ../../lib support
;; covers: reduce-kv
;; reduce-kv hands each key and its value to f as two arguments and builds no Pair. main builds a Map of 300 entries in a loop
;; (the trie's nodes and the Map's versions are the whole count, 2335 measured for the build alone, as in case 149), then runs
;; three reduce-kv folds over it (the sum of the keys, 44850; of the values, 134550; and the count, 300), and the folds allocate
;; nothing: the same program with reduce, whose function is given a Pair for every entry, allocates 900 more, 3235 (measured,
;; both tools), and the bound, the count as measured, does not allow that.
(ns main (:use fib.core fib.seq fib.coll))

(defun build () -> (Map i64 i64)
  (loop ((i 0) (m (map-empty)))
    (if (< i 300) (recur (+ i 1) (assoc m i (* i 3))) m)))

(defun main () -> i64
  (let ((m (build)))
    (+ (reduce-kv (fn (acc k v) (+ acc k)) 0 m)
       (+ (reduce-kv (fn (acc k v) (+ acc v)) 0 m)
          (reduce-kv (fn (acc k v) (+ acc 1)) 0 m)))))
