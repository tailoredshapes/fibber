;; spec:   stdlib §2.1 rule 5 ("Every adaptor is Cursable by buffering"), tranche 2 plan Y3 (T1's and Y2's recipes), A11 e16
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; The seven recipes of tranche 1, the seven of Y2 and the three of the lockstep walks are never values of a program,
;; yet a fused `zip` meets one as its second operand, so each has a cursor: the VecCur of `(to-vec self)`, one buffer
;; for the cursor and none per element. Each recipe is built by hand over a small source, its cursor is drained, and the
;; elements are those the recipe's own walk gives, written out. (The page's first version said `no implementation of
;; Cursable for (Mapped (Vec i64) i64 i64)`; the three impls of A11 e16 (Mapped, Filtered, Taken) remove that error, and
;; here are all seventeen recipes.) The source of each is a Vec; a recipe over a recipe is case 2367.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun drain (c: k) :where ((Cursor k e)) -> (Vec e)
  (loop ((acc (vec-empty)))
    (if (advance! c) (recur (conj acc (current c))) acc)))

;; the cursor of the recipe gives the elements that its each-while does, which are `want`
(defun buffered (r: s want: (Vec e)) :where ((Cursable s k) (Cursor k e) (Reducible s e) (Eq e)) -> bool
  (and (= (drain (cursor r)) want) (= (to-vec r) want)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (buffered (Mapped [1 2 3 4 5] (fn (x: i64) (* x 2))) [2 4 6 8 10]))
        (check c (buffered (Filtered [1 2 3 4 5] odd?) [1 3 5]))
        (check c (buffered (Taken [1 2 3 4 5] 3) [1 2 3]))
        (check c (buffered (Dropped [1 2 3 4 5] 2) [3 4 5]))
        (check c (buffered (TakenWhile [1 2 3 4 5] (fn (x: i64) (< x 4))) [1 2 3]))
        (check c (buffered (Mapcat [1 2 3] (fn (x: i64) [x x])) [1 1 2 2 3 3]))
        (check c (buffered (Cat [1 2 3] [9 8]) [1 2 3 9 8]))
        (check c (buffered (MapIndexed [1 2 3] (fn (i: i64 x: i64) (+ (* 10 i) x))) [1 12 23]))
        (check c (buffered (Kept [1 2 3 4 5] (fn (x: i64) (if (odd? x) (some (* x x)) nil))) [1 9 25]))
        (check c (buffered (DroppedWhile [1 2 3 4 5] (fn (x: i64) (< x 3))) [3 4 5]))
        (check c (buffered (Interposed [1 2 3] 0) [1 0 2 0 3]))
        (check c (buffered (Distinct [1 2 1 3 2]) [1 2 3]))
        (check c (buffered (Reductions [1 2 3] (fn (a: i64 x: i64) (+ a x)) 10) [10 11 13 16]))
        (check c (buffered (Consed 0 [1 2 3]) [0 1 2 3]))
        (check c (buffered (Zipped [1 2 3] [4 5 6]) [(Pair 1 4) (Pair 2 5) (Pair 3 6)]))
        (check c (buffered (ZipWith [1 2 3] [4 5 6 7] (fn (a: i64 b: i64) (+ a b))) [5 7 9]))
        (check c (buffered (Interleaved [1 2 3] [4 5]) [1 4 2 5]))
        (checks-result c))))
