;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; unchecked-add unchecked-subtract unchecked-multiply unchecked-negate wrap at the lane width, for a vector and a scalar: the opt-out of the checked + - * and neg (the cases 6230 to 6234 trap).
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (let ((a: i8x4 <<127 -128 100 5>>i8) (b: i8x4 <<1 -1 100 5>>i8))
          (do (check c (= (unchecked-add a b) <<-128 127 -56 10>>i8)) (check c (= (unchecked-subtract (neg <<0 1 2 3>>i8) b) <<-1 0 -102 -8>>i8))
              (check c (= (unchecked-multiply a b) <<127 -128 16 25>>i8)) (check c (= (unchecked-negate a) <<-127 -128 -100 -5>>i8))))
        (let ((m: i32x2 <<2147483647 1>>i32))
          (check c (= (unchecked-add m <<1 1>>i32) <<-2147483648 2>>i32)))
        (check c (= (unchecked-add 127i8 1i8) -128i8)) (check c (= (unchecked-multiply 100i16 1000i16) -31072i16))
        (check c (= (unchecked-negate -128i8) -128i8))
        (let ((p (checks)))
          (do (check p (= (unchecked-add <<127>>i8 <<1>>i8) <<127>>i8)) (check-detects c p)))
        (checks-result c))))
