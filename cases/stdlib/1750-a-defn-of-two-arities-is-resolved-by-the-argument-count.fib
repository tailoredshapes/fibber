;; spec:   stdlib §7 L1, syntax §3.1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defn
;; Clojure's shape: one name, a parameter vector per clause, the call picks the
;; clause by its argument count. The two clauses compute different things, so a
;; wrong pick shows in the result.
(ns main (:use tl.check))

(defn area
  ([s: i64] -> i64 (* s s))
  ([w: i64 h: i64] -> i64 (* w h)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (area 3) 9))
        (check c (= (area 3 4) 12))
        (checks-result c))))
