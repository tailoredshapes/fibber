;; spec:   stdlib §2.7 (floats), §4.14 (row pr-str)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: pr-str
;; Clojure's pr writes a non-finite double in reader form, ##Inf ##-Inf ##NaN (found by differential testing
;; against Clojure 1.12), also inside a collection and for an f32; `(str x)` of a bare double is Double.toString's
;; Infinity, -Infinity, NaN, and `(str [x])` is the collection's, so [##Inf]. Every finite float is the same text
;; for both (case 2950). The text of `println` of a bare non-finite float is the builtin Show's: case 2974.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (inf: f64 (/ 1.0 0.0))
        (ninf: f64 (/ -1.0 0.0))
        (nan: f64 (/ 0.0 0.0))
        (f: f32 (fptrunc f32 (/ 1.0 0.0))))
    (do (check c (= (pr-str inf) "##Inf"))
        (check c (= (pr-str ninf) "##-Inf"))
        (check c (= (pr-str nan) "##NaN"))
        (check c (= (pr-str f) "##Inf"))
        (check c (= (pr-str [inf 1.5 nan]) "[##Inf 1.5 ##NaN]"))
        (check c (= (pr-str (list ninf)) "(##-Inf)"))
        (check c (= (to-str inf) "Infinity"))
        (check c (= (to-str ninf) "-Infinity"))
        (check c (= (to-str nan) "NaN"))
        (check c (= (to-str [inf 1.5]) "[##Inf 1.5]"))
        (check c (= (pr-str 1.5) "1.5"))
        (checks-result c))))
