;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clock-now wall-now sleep-ns
;; The monotonic clock is non-decreasing, a sleep of 2 ms moves it by at least 2 ms, a sleep of nothing or of
;; a negative time returns at once, and the wall clock is after 2020.
(ns main (:use tl.check tl.sysx fib.unix))

(defun main () -> i64
  (let ((c (checks))
        (t0 (clock-now))
        (t1 (clock-now)))
    (do (check c (>= t1 t0))
        (check c (> t0 0))
        (check c (= (sleep-ns 2000000) 0))
        (check c (>= (- (clock-now) t1) 2000000))
        (check c (= (sleep-ns 0) 0))
        (check c (= (sleep-ns -5) 0))
        (check c (> (wall-now) 1577836800000000000))
        (checks-result c))))
