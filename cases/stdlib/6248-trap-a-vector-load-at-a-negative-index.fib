;; spec:   types §1.9 (loads), docs/design/simd-and-tensors.md 2.7
;; expect: trap
;; trap:   simd-load: lanes out of range of the array
;; stage:  2
;; roots:  ../../lib support
;; A negative start index traps, though i + n is within the length.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (array 7 1.5)) (i (- 0 1)))
    (let ((v: f64x4 (simd-load a i)))
      (do (println (hsum v)) 0))))
