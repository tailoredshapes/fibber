;; spec:   stdlib §4.1 (rows bit-shift-left etc.), §7 L26 (a), lib/fib/core/alias.fib
;; expect: accept
;; result: 40
;; audit:  clean
;; roots:  ../../lib
;; covers: bit-shift-left
;; Clojure writes (bit-shift-left x 3) for any x: the distance is a literal. The distance of the
;; builtin shl has the type of the value, so for an i32 the literal must be an i32, which L26 (a)
;; (literal adoption across widths) gives (landed with LANG-2: the case was `open` and read `cannot unify i32 with i64`, probe r6 of its
;; package). Case 650 writes 3i32 out.
(ns main (:use fib.core))

(defun shl3 (x: i32) -> i32 (bit-shift-left x 3))

(defun main () -> i64
  (zext i64 (shl3 5i32)))
