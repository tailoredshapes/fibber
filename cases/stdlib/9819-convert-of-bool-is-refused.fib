;; spec: spec/types.md 1.9 (scalar-generic chunk): (convert e) takes and gives Num scalars
;; expect: reject
;; error:  no implementation of Num for bool
;; roots:  ../../lib support
;; covers: convert
;; A bool is not a Num (it has no integer width to convert from or to), so (convert true) with an i64 result is refused when compiled. The other refusal, (convert 1.5) with
;; nothing fixing the result, is the checker's ordinary ambiguity error ("ambiguous constraint Num a in main; add an annotation").
(ns main (:use tl.check))

(defun main () -> i64
  (let ((x: i64 (convert true)))
    x))
