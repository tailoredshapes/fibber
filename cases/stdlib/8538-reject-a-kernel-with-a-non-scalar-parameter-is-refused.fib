;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:6:22: kernel k: heap data of type (Vec f32): a kernel allocates nothing
;; A kernel's parameters are scalars and raw pointers: a Vec parameter is refused at the parameter.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr xs: (Vec f32) n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n) (gpu/f32-set! a i (nth xs 0)))))
(defun main () -> i64 0)
