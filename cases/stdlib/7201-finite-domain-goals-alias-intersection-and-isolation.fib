;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (l/run 5 (fn (q) (fd/in q (fd/domain [3 1 2])))) [(l/integer 1) (l/integer 2) (l/integer 3)]))
        (check c (= (l/run 5 (fn (q) (l/all [(fd/in q (fd/interval 1 4)) (fd/in q (fd/interval 3 6))]))) [(l/integer 3) (l/integer 4)]))
        (check c (= (l/run 1 (fn (q) (l/all [(fd/in q (fd/interval 1 3)) (l/== q (l/integer 9))]))) []))
        (check c (= (l/run-many 3 2 (fn (qs) (l/all [(fd/in (nth qs 0) (fd/interval 1 2)) (fd/in (nth qs 1) (fd/interval 2 3)) (l/== (nth qs 0) (nth qs 1))]))) [[(l/integer 2) (l/integer 2)]]))
        (check c (= (l/run 3 (fn (q) (l/any [(l/all [(fd/in q (fd/interval 1 2)) (l/== q (l/integer 9))]) (fd/in q (fd/domain [7]))]))) [(l/integer 7)]))
        (check c (= (l/run 1 (fn (q) (fd/in q (fd/domain [])))) []))
        (checks-result c))))
