;; spec:   stdlib §2.4 (update traps on a missing key), §4.5 (update)
;; expect: trap
;; trap:   update: no key
;; roots:  ../../lib support
;; covers: update
;; (update v i f) on an index that is not an element is the trap `update: no key`
;; where Clojure's (update [1 2] 2 inc) throws a NullPointerException: here the
;; get of the Vec says nil at the count, and update does not turn that into an
;; append (update-or does, case 401).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (nth (update [10 20] 2 (fn (x) (+ x 1))) 0))
