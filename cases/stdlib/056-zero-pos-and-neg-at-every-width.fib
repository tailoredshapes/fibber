;; spec:   stdlib §4.3 (rows zero? pos? neg?)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: zero? pos? neg?
;; Three predicates over a Unit witness and the builtin comparisons, at
;; the six numeric types. A float follows IEEE: -0.0 is zero, neither
;; positive nor negative, and a NaN is none of the three.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0)))
    (do (check c (zero? 0i8))
        (check c (not (zero? 1i8)))
        (check c (pos? 1i8))
        (check c (not (pos? -1i8)))
        (check c (neg? -1i8))
        (check c (not (neg? 0i8)))
        (check c (zero? 0i16))
        (check c (pos? 32767i16))
        (check c (neg? -32768i16))
        (check c (zero? 0i32))
        (check c (pos? 7i32))
        (check c (neg? -7i32))
        (check c (zero? 0))
        (check c (not (zero? -1)))
        (check c (pos? 9223372036854775807))
        (check c (neg? -9223372036854775807))
        (check c (not (pos? 0)))
        (check c (not (neg? 0)))
        (check c (zero? 0.0f32))
        (check c (pos? 0.5f32))
        (check c (neg? -0.5f32))
        (check c (zero? 0.0))
        (check c (zero? -0.0))
        (check c (not (pos? -0.0)))
        (check c (not (neg? -0.0)))
        (check c (pos? 0.000001))
        (check c (neg? -0.000001))
        (check c (not (zero? nan)))
        (check c (not (pos? nan)))
        (check c (not (neg? nan)))
        (checks-result c))))
