;; spec:   stdlib §4.5 (row select-keys)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: select-keys
;; (select-keys m ks) is the entries of m whose keys are in ks, in a map of
;; the same type: a key m lacks is skipped (the note of the row), a key listed
;; twice is one entry, and no keys give the empty map. ks is any source of
;; keys: a Vec, a Set, an Option. m is not changed.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (assoc (empty {"a" 0}) "a" 1) "b" 2) "c" 3))
        (r (select-keys m ["a" "c" "z" "a"]))
        (r2 (select-keys m (set ["b"])))
        (r3 (select-keys m (some "c"))))
    (do (check c (= (count r) 2))
        (check c (is (get r "a") 1))
        (check c (is (get r "c") 3))
        (check c (not (contains? r "b")))
        (check c (not (contains? r "z")))
        (check c (= (count r2) 1))
        (check c (is (get r2 "b") 2))
        (check c (= (count r3) 1))
        (check c (is (get r3 "c") 3))
        (check c (= (count (select-keys m [])) 0))
        (check c (= (count (select-keys m ["x" "y"])) 0))
        (check c (= (count m) 3))
        (check c (= (count (select-keys (empty m) ["a"])) 0))
        (checks-result c))))
