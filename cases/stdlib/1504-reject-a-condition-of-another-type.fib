;; spec:   stdlib §7 L20
;; expect: reject
;; error:  cannot unify (Vec i64) with bool
;; roots:  support
;; covers: if
;; A test is a bool or an Option; any other type that is not a primitive that is always
;; true is the plain mismatch.
(ns main (:use tl.check))

(defun main () -> i64
  (if [1 2] 1 2))
