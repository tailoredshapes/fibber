;; spec: spec/types.md 1.9 (scalar-generic chunk): (convert e) between integers and floats: sitofp, fptosi-sat (truncation toward zero, saturation, NaN 0)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Negative integers keep their sign through sitofp, floats truncate toward zero, 1e300 and -1e300 saturate to the i32 limits (not wrap), NaN is 0 and f32 300.5 saturates to the i8 maximum 127.
(ns main (:use tl.check))

(defun i64->f64 (x: i64) -> f64 (convert x))
(defun i32->f32 (x: i32) -> f32 (convert x))
(defun f64->i64 (x: f64) -> i64 (convert x))
(defun f64->i32 (x: f64) -> i32 (convert x))
(defun f32->i8 (x: f32) -> i8 (convert x))

(defun main () -> i64
  (let ((c (checks)) (nan (/ 0.0 0.0)))
    (do (check c (= (i64->f64 -7) -7.0))
        (check c (= (i64->f64 123456) 123456.0))
        (check c (= (i32->f32 -3i32) -3.0f32))
        (check c (= (i32->f32 40i32) 40.0f32))
        (check c (= (f64->i64 2.9) 2))
        (check c (= (f64->i64 -2.9) -2))
        (check c (= (f64->i32 -2.9) -2i32))
        (check c (= (f64->i32 1.0e300) 2147483647i32))
        (check c (= (f64->i32 -1.0e300) -2147483648i32))
        (check c (= (f64->i32 nan) 0i32))
        (check c (= (f64->i64 nan) 0))
        (check c (= (f32->i8 300.5f32) 127i8))
        (check c (= (f32->i8 -300.5f32) -128i8))
        (check c (= (checks-made c) 13))
        (checks-result c))))
