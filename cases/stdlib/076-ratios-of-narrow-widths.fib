;; spec:   stdlib §2.8 ((Ratio t): components of the operand width)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / numerator denominator
;; The ratio of an i8, an i16 or an i32 has components of that width, and
;; every operation keeps it: the numerator of (/ 127i8 -127i8) is -1i8, and
;; the sum 1/2 + 1/3 at i8 is 5/6 with an i8 numerator. (Overflow at the
;; width is case 087.)
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (numerator (/ 127i8 -127i8)) -1i8))
        (check c (= (denominator (/ 127i8 -127i8)) 1i8))
        (check c (= (show (/ 100i16 -300i16)) "-1/3"))
        (check c (= (numerator (/ 100i16 -300i16)) -1i16))
        (check c (= (denominator (/ 100i16 -300i16)) 3i16))
        (check c (= (show (+ (/ 1i8 2i8) (/ 1i8 3i8))) "5/6"))
        (check c (= (numerator (+ (/ 1i8 2i8) (/ 1i8 3i8))) 5i8))
        (check c (= (show (/ 2147483647i32 2i32)) "2147483647/2"))
        (check c (= (numerator (* (/ 3i32 4i32) (/ 4i32 3i32))) 1i32))
        (check c (< (/ 1i8 3i8) (/ 1i8 2i8)))
        (check c (= (/ 2i16 4i16) (/ 1i16 2i16)))
        (checks-result c))))
