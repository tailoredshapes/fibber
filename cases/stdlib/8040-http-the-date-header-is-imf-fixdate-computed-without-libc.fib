;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll) (:require [fib.http.server.date :as d]))
(defun main () -> i64
  (let [c (checks)]
    (do (check c (= (d/format-date 0) "Thu, 01 Jan 1970 00:00:00 GMT"))
        (check c (= (d/format-date 1000000000) "Sun, 09 Sep 2001 01:46:40 GMT"))
        (check c (= (d/format-date 951782400) "Tue, 29 Feb 2000 00:00:00 GMT"))
        (check c (= (d/format-date 1234567890) "Fri, 13 Feb 2009 23:31:30 GMT"))
        (check c (= (d/format-date 4102444799) "Thu, 31 Dec 2099 23:59:59 GMT"))
        (check c (= (str-len (d/http-date)) 29))
        (checks-result c))))
