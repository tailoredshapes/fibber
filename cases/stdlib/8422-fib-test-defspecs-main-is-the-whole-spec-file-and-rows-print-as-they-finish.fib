;; spec: docs/design/test-harness.md 6 (a spec file's main); package LIB-2 items 5d and 5f
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; covers: fib.test defspecs-main
;; `(defspecs-main specs suite ..)` defines `specs` and the file's `main` (`run-main (specs)`): a spec file needs no main of its own. This file is its own proof: its `main` is the one the macro wrote, and
;; it returns 0 only because every scenario of its two features held. The rows print one by one as each scenario finishes (the head of a feature before its first row, the summary after the last), not
;; all together when the file ends: the output of this case is the plain report in the order the rows ran, `props` then `plain`, then the summary line.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.test.gen))

(defspecs-main specs
  (feature "props"
    (prop "addition commutes over two names" [a (gen-i64) b (gen-i64)] (= (+ a b) (+ b a)))
    (prop "reverse of reverse is the vector" [v (gen-vec (gen-i64))] (= (vec (reverse (reverse v))) v)))
  (feature "plain"
    (scenario "a scenario still runs" (given [x 2]) (then (expect = 4 (* x x))))
    (outline "doubling" [a b] [[1 2] [2 4] [3 6]] (then (expect = b (* a 2))))))
