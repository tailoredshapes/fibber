;; spec:   syntax §1.1 (the regex literal)
;; expect: reject
;; error:  unterminated string
;; stage:  2
;; roots:  ../../lib support
;; A `#"` whose closing quote is held by a backslash (`\"` stays in the pattern) runs to the end of the file: the reader's
;; error, as for a string.
(ns main (:use fib.core fib.regex))

(defun main () -> i64
  (re-count #"ab\" "abcd"))
