;; spec:   stdlib §2.5, §4.4 row assoc, §1.2 P5, tranche 1 plan §4.3 rule 8, task P1 item 1
;; expect: trap
;; trap:   assoc: index out of range
;; roots:  ../../lib support
;; covers: assoc
;; A Vec has no holes: assoc at the count appends (case 2100 checks it) and one past the count traps, the message
;; naming the function. The vector has 1056 elements, so the index is checked before the trie is entered.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (vec (range 1056))))
    (count (assoc v 1057 0))))
