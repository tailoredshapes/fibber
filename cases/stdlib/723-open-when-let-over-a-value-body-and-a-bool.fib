;; spec:   stdlib §4.2 (row when-let), §2.4, §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; open:   L20
;; roots:  support
;; covers: when-let
;; (when-let (x e) body) is over a Truthy: an Option (x is the payload) or
;; a bool (x is the bool), and its value is unit when the body is, else
;; `(Option T)` with `some` around the body, as `when`. Today the binding
;; is an Option and the body is unit: a value body is
;; `cannot unify unit with i64`, a bool binding `cannot unify bool with
;; (Option a)`.
(ns main (:use tl.check))

(defun plus-one (o: (Option i64)) -> (Option i64)
  (when-let (x o) (+ x 1)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (match (plus-one (some 4)) ((some y) (= y 5)) (nil false)))
        (check c (match (plus-one nil) ((some _) false) (nil true)))
        (check c (match (when-let (b (> 2 1)) 7) ((some y) (= y 7)) (nil false)))
        (checks-result c))))
