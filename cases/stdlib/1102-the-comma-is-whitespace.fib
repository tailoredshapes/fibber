;; spec:   syntax §1.1 (comma is whitespace), stdlib §7 E14
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; The comma is whitespace everywhere: [1,2,3] has three elements, a map may
;; separate its pairs with commas, and so may a call.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (count [1,2,3]) 3))
        (check c (= [1,2,3] [1 2 3]))
        (check c (= {:a 1, :b 2} {:a 1 :b 2}))
        (check c (= (+ 1,2,3) 6))
        (check c (= (count [,1,,2,]) 2))
        (checks-result c))))
