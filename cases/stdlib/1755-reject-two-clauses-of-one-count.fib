;; spec:   stdlib §7 L1
;; expect: reject
;; error:  two clauses of area take 1 argument(s)
;; roots:  ../../lib support
;; covers: defn
;; Two clauses with the same number of parameters can never both be picked.
(ns main)

(defn area
  ([s: i64] -> i64 (* s s))
  ([w: i64] -> i64 (* w 2)))

(defun main () -> i64 (area 3))
