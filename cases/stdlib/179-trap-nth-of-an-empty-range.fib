;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §4.4 (row range)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: range
;; (range 0.0) is empty, so even index 0 is out of range. A float range's nth walks from the start, and the
;; walk's first element is the start: without a check that the range is not empty it would answer 0.0.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (= (nth (range 0.0) 0) 0.0) 1 0))
