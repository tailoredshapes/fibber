;; spec:   stdlib §2.3 (Assoc), §4.5 (assoc: beyond the count it traps), Appendix A11 e6
;; expect: trap
;; trap:   assoc: index out of range
;; roots:  ../../lib support
;; covers: assoc
;; The other end of the rule of case 381: an index below zero is no index
;; of a Vec and does not count back from the end as it would in some
;; languages. The Vec is the empty one, the variant that the trie's
;; functions take apart first.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (nth (assoc (vec-empty) -1 30) 0))
