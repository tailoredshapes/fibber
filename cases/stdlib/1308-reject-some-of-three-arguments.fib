;; spec:   stdlib §4.6 (row some), §6.3 (E1)
;; expect: reject
;; error:  macro some takes 1 or 2 argument(s), got 3
;; roots:  ../../lib support
;; (no `covers:`: the table's row is the two-argument call, which this case does not make)
;; (some pred c) is the macro and (some x) the constructor; no other count is either, and the macro says so
;; at the call.
(ns main (:use tl.check))

(defun main () -> i64
  (count (some even? [1 2] 3)))
