;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (let [query "query Echo($text: String = \"fallback\") { echo(text: $text) }"]
        (do (check c (= (f/member (g/execute schema query {} g/NullValue) "echo") (g/StringValue "fallback")))
          (check c (= (f/member (g/execute schema query {"text" (g/StringValue "supplied")} g/NullValue) "echo") (g/StringValue "supplied")))
          (check c (g/null? (f/member (g/execute schema query {"text" g/NullValue} g/NullValue) "echo")))
          (check c (= (f/member (g/execute schema "query($text: String) { echo(text: $text) }" {} g/NullValue) "echo") (g/StringValue "default")))
          (check c (= (f/member (g/execute schema "query($text: String) { present(text: $text) }" {} g/NullValue) "present") (g/BooleanValue false)))
          (check c (= (f/member (g/execute schema "query($text: String) { present(text: $text) }" {"text" g/NullValue} g/NullValue) "present") (g/BooleanValue true)))
          (check c (= (g/result-json (g/execute schema "{ count }" {"extra" (g/IntValue 1)} g/NullValue)) "{\"data\":{\"count\":0}}"))))))
      (checks-result c))))
