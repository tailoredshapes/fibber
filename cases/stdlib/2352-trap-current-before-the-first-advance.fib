;; spec:   stdlib §2.3 (Cursor), tranche 2 plan Y3 (the convention of the part)
;; expect: trap
;; trap:   current: the cursor has no element
;; roots:  ../../lib support
;; A cursor stands before its first element until advance! is called, so `current` has nothing to read. It traps with a
;; message that names the function, as `nth` does past the end of a Vec (case 016), and reads no element of the Vec:
;; the cursor of a Vec is an index that starts at -1.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (current (cursor [10 20 30])))
