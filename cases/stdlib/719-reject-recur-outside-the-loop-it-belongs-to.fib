;; spec:   stdlib §4.2 (row recur), syntax §3.18
;; expect: reject
;; error:  recur outside loop
;; covers: recur
;; `recur` belongs to the innermost enclosing `loop` of the same function:
;; one inside a `fn` literal nested in the loop body is outside any loop,
;; because the closure is a function of its own and the jump could not
;; leave it.
(defun main () -> i64
  (loop ((i 0))
    (if (< i 3)
        (recur (+ i 1))
        (let ((f (fn () (recur 9))))
          (f)))))
