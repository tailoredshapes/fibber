;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.logic :as l] [fib.logic.fd :as fd]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (wide (fd/interval 1 10000)))
    (do (check c (= (l/run-many 1 2
                    (fn (qs) (l/all [(fd/in-all qs wide)
                                     (fd/+ (nth qs 0) (l/integer 1) (nth qs 1))])))
                    [[(l/integer 1) (l/integer 2)]]))
        (checks-result c))))
