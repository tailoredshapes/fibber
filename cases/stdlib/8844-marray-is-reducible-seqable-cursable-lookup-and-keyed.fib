;; spec:   stdlib §2.3 (the protocol table: MArray in Reducible Seqable Cursable Lookup Keyed), §4.1 row MArray
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; covers: MArray
;; An MArray is a source of the sequence functions (reduce, count, nth, last, seq, rest, map of two sources through the cursor),
;; and Lookup and Keyed by index as an Array is: (get (int-array [1 2]) 0) is (some 1i32) (A13 marray), contains? is the index test.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (a (long-array [3 1 2])) (i (int-array [1 2])))
    (do (check c (= (reduce + 0 a) 6))
        (check c (= (count a) 3))
        (check c (= (nth a 2) 2))
        (check c (= (last a) (some 2)))
        (check c (= (vec (filter odd? a)) [3 1]))
        (check c (= (vec (map + a [10 20 30])) [13 21 32]))
        (check c (= (vec (sort a)) [1 2 3]))
        (check c (= (count (rest a)) 2))
        (check c (some? (seq a)))
        (check c (nil? (seq (long-array 0))))
        (check c (= (get i 0) (some 1i32)))
        (check c (= (get i 2) nil))
        (check c (contains? a 2))
        (check c (not (contains? a 3)))
        (aset a 0 0)
        (check c (= (reduce + 0 a) 3))
        (checks-result c))))
