;; spec: docs/design/compress.md
;; expect: accept
;; result: 0
;; audit: clean
;; roots: ../../lib support
;; xxHash32 of the empty input and of abc (published), and a digest streamed in 3 pieces equals the one-shot digest at lengths around the 16-byte stripe.
(ns main (:use tl.check fib.compress.lz4.xxh32))
(defun d (n: i64) -> (Array i8) (let [a (cell (array n 0i8))] (do (dotimes (i n) (array-set! &a i (trunc i8 (rem (* i 7) 251)))) @a)))
(defun main () -> i64
  (let [c (checks)]
    (do (check c (= (xxh32 (array 0 0i8) 0) 46947589))
        (check c (= (xxh32 (str-bytes "abc") 0) 852579327))
        (dotimes (j 6)
          (let [n (nth [0 15 16 17 100 4097] j) a (d n) x (xxh-new 0)]
            (do (xxh-update! x a 0 (quot n 3)) (xxh-update! x a (quot n 3) (- n (quot n 3))) (check c (= (xxh-digest x) (xxh32 a 0))))))
        (checks-result c))))
