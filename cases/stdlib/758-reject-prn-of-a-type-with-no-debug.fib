;; spec:   stdlib §2.7 (prn is Debug), §6.3 (R5), §4.14 (row prn)
;; expect: reject
;; error:  no implementation of Debug for Pt
;; roots:  ../../lib support
;; covers: prn
;; (prn p) is (fib.prelude/println (fib.core/debug p)): a struct with a Show and no
;; Debug is refused when the program is checked, which is what tells prn from println.
(ns main (:use fib.core fib.seq fib.print))

(defstruct Pt (x: i64 y: i64))
(impl Show Pt (show (self) "Pt"))

(defun main () -> i64 (do (prn (Pt 1 2)) 0))
