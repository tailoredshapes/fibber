;; spec:   stdlib §2.1 rule 1 and 2 (an infinite source is fine; two lazy adaptors stay lazy), §4.4 rows map-indexed keep drop-while interpose distinct reductions cons partition-by, plan PC-13
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map-indexed keep drop-while interpose distinct reductions cons partition-by take
;; Each lazy function of tranche 2 over an endless lazy seq (the naturals, made by hand: Y1's
;; iterate has not landed when this case is written, and a lazy seq of nodes is a source it will
;; not change), ended by take. The counter in the source says how many nodes were made: no more than
;; the answer needs and the function reads (a version that converted its source in full would not
;; return, and one that read a node ahead would count one more). The recipe of each, under a Taken,
;; stops its endless source too. Case 2262 has the same over a Range of step 0, which is a
;; different path (to-lseq of a source that is not an LSeq).
(ns main (:use fib.core fib.seq fib.coll tl.check))

;; the naturals from i; every node realised bumps the counter
(defun nat (i: i64 nodes: (Cell i64)) -> (LSeq i64)
  (lazy-node (fn () (do (set! nodes (+ @nodes 1)) (LCons i (nat (+ i 1) nodes))))))

(defun groups (s: (LSeq (VSeq a))) -> (Vec (Vec a))
  (vec (map (fn (g: (VSeq a)) (to-vec g)) s)))

;; the answer and the number of nodes made
(defun probe (mk: (fn ((LSeq i64)) (LSeq b))) -> (Pair (Vec b) i64)
  (let ((nodes (cell 0)))
    (let ((v (vec (mk (nat 0 nodes)))))
      (Pair v @nodes))))

(defun total (c: c) :where ((Reducible c i64)) -> i64
  (let ((acc (cell 0)))
    (do (each-while c (fn (x) (do (set! acc (+ @acc x)) true))) @acc)))

(defun main () -> i64
  (let ((c (checks))
        (add (fn (a: i64 x: i64) (+ a x))))
    (do ;; the answer, then the nodes of the source it took
        (let ((p (probe (fn (s) (take 3 (keep (fn (x: i64) (if (even? x) (some (* x 10)) nil)) s))))))
          (do (check c (= (. p fst) [0 20 40]))
              (check c (= (. p snd) 5))))
        (let ((p (probe (fn (s) (take 3 (map-indexed (fn (i: i64 x: i64) (+ (* i 100) x)) s))))))
          (do (check c (= (. p fst) [0 101 202]))
              (check c (= (. p snd) 3))))
        (let ((p (probe (fn (s) (take 3 (drop-while (fn (x: i64) (< x 5)) s))))))
          (do (check c (= (. p fst) [5 6 7]))
              (check c (= (. p snd) 8))))
        (let ((p (probe (fn (s) (take 5 (interpose 9 s))))))
          (do (check c (= (. p fst) [0 9 1 9 2]))
              (check c (= (. p snd) 3))))
        (let ((p (probe (fn (s) (take 3 (distinct (map (fn (x: i64) (rem x 3)) s)))))))
          (do (check c (= (. p fst) [0 1 2]))
              (check c (= (. p snd) 3))))
        (let ((p (probe (fn (s) (take 4 (reductions add 0 s))))))
          (do (check c (= (. p fst) [0 0 1 3]))
              (check c (= (. p snd) 3))))
        (let ((p (probe (fn (s) (take 3 (cons -1 s))))))
          (do (check c (= (. p fst) [-1 0 1]))
              (check c (= (. p snd) 2))))
        (let ((nodes (cell 0)))
          (let ((gs (groups (take 2 (partition-by (fn (x: i64) (quot x 2)) (nat 0 nodes))))))
            (do (check c (= gs [[0 1] [2 3]]))
                (check c (= @nodes 5)))))
        ;; a first element only
        (let ((nodes (cell 0)))
          (do (check c (= (first (keep (fn (x: i64) (if (> x 3) (some x) nil)) (nat 0 nodes))) (some 4)))
              (check c (= @nodes 5))))
        ;; a stack of the new adaptors over the endless seq
        (let ((p (probe (fn (s) (take 3 (map-indexed (fn (i: i64 x: i64) (+ i x))
                                          (keep (fn (x: i64) (if (odd? x) (some x) nil))
                                                (drop-while (fn (x: i64) (< x 4)) s))))))))
          (do (check c (= (. p fst) [5 8 11]))
              (check c (= (. p snd) 10))))
        ;; the recipes, stopped by a Taken
        (let ((nodes (cell 0)))
          (do (check c (= (total (Taken (Kept (nat 0 nodes) (fn (x: i64) (if (odd? x) (some x) nil))) 3)) 9))
              (check c (= @nodes 6))))
        (let ((nodes (cell 0)))
          (do (check c (= (total (Taken (MapIndexed (nat 0 nodes) (fn (i: i64 x: i64) (* i x))) 4)) 14))
              (check c (= @nodes 4))))
        (let ((nodes (cell 0)))
          (do (check c (= (total (Taken (Interposed (nat 1 nodes) 100) 4)) 203))
              (check c (= @nodes 3))))
        (let ((nodes (cell 0)))
          (do (check c (= (total (Taken (Reductions (nat 1 nodes) (fn (a: i64 x: i64) (+ a x)) 0) 4)) 10))
              (check c (= @nodes 3))))
        (checks-result c))))
