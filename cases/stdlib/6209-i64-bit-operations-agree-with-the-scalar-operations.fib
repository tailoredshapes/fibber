;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; bit-and bit-or bit-xor bit-not popcount shl shr sar on i64 vectors equal the scalar operations lane by lane, with random bit patterns and shift counts up to the width plus 4 (a count is masked to the width as the scalar's is).
(ns main (:use fib.core tl.check))

(defun bits-i64-1 (c: Checks) -> unit
  (let ((a: i64x1 <<-9223372007655982437>>i64) (b: i64x1 <<-9223372036854492287>>i64) (s: i64x1 <<0>>i64))
    (do (let ((r (bit-and a b)))
      (do
        (check c (= (lane r 0) (bit-and -9223372007655982437 -9223372036854492287)))
        ()))
        (let ((r (bit-or a b)))
      (do
        (check c (= (lane r 0) (bit-or -9223372007655982437 -9223372036854492287)))
        ()))
        (let ((r (bit-xor a b)))
      (do
        (check c (= (lane r 0) (bit-xor -9223372007655982437 -9223372036854492287)))
        ()))
        (let ((r (bit-not a)))
      (do
        (check c (= (lane r 0) (bit-not -9223372007655982437)))
        ()))
        (let ((r (popcount a)))
      (do
        (check c (= (lane r 0) (popcount -9223372007655982437)))
        ()))
        (let ((r (shl a s)))
      (do
        (check c (= (lane r 0) (shl -9223372007655982437 0)))
        ()))
        (let ((r (shr a s)))
      (do
        (check c (= (lane r 0) (shr -9223372007655982437 0)))
        ()))
        (let ((r (sar a s)))
      (do
        (check c (= (lane r 0) (sar -9223372007655982437 0)))
        ()))
        ())))

