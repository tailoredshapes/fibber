;; spec:   stdlib §3 N11 (an Option function takes the function first and the Option last), §4.3 (row map-opt)
;; expect: reject
;; error:  cannot unify (Option i64) with (fn (a) b)
;; roots:  ../../lib
;; covers: map-opt unwrap-or
;; The order is the sequence functions' (N1, N2): function first, Option last,
;; so `->>` threads it. `(map-opt o f)` is refused, with both types in the
;; message, and not accepted as another spelling.
(ns main (:use fib.core))

(defun bump (x: i64) -> i64 (+ x 1))

(defun main () -> i64
  (unwrap-or (map-opt (some 1) bump) 0))
