;; spec:   stdlib §4.4 (row nth), §1.2 P5 (Clojure throws, fibber traps with the function's name)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: nth
;; nth of an index at or past the end is the one lookup that traps, here on
;; a Vec (the method the Vec overrides) after a good index has answered.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((v [5 6 7]))
    (+ (nth v 2) (nth v 3))))
