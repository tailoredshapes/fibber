;; spec:   stdlib §7 L8 (a refutable let pattern traps `let: pattern does not match`)
;; expect: trap
;; trap:   let: pattern does not match
;; roots:  ../../lib support
;; The prefix pattern needs two elements and the vector has one. Clojure binds nil here; the
;; type of nil does not exist in fibber (stdlib §5 T1), so the let is a match whose last
;; clause traps, and it names itself.
(ns main (:use fib.core fib.coll))

(defun short () -> (Vec i64) [7])

(defun main () -> i64
  (let (([a b] (short))) (+ a b)))
