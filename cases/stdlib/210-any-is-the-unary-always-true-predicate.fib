;; spec:   stdlib §4.4 (row any?), A11 (any? is not the quantifier)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: any? every? find-first
;; Clojure's any? takes one value and says true (the default spec
;; predicate); the quantifier is `some`, so (any? p c) is a type error here
;; and not a silently different program (the checker says so, the
;; arity error in case 218). As a function value it is the
;; predicate that accepts everything: every? over anything is true, and
;; find-first with it is first.
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (any? 1))
        (check c (any? "x"))
        (check c (any? (some 3)))
        (check c (any? [1 2]))
        (check c (every? any? [1 2 3]))
        (check c (every? any? ["a"]))
        (check c (match (find-first any? [7 8]) ((some x) (= x 7)) (nil false)))
        (check c (nil? (find-first any? (vec-empty))))
        (checks-result c))))
