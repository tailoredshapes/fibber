;; spec:   syntax §3.15a (lir), lir.md 6.6
;; expect: reject
;; error:  atomic-load cannot have ordering release
;; stage:  2
;; roots:  ../../lib support
;; The body is checked as lIR when the function is made, with the checker's text and the position inside the string.
(ns main (:use fib.core))

(defun f (p: ptr) -> i64 (unsafe (lir [p: ptr] -> i64 "(block entry (ret (atomic-load release i64 p)))")))

(defun main () -> i64 (unsafe (f (alloc 8))))
