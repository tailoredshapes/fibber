;; spec:   stdlib §4.2 (row `x), §7 E14
;; expect: accept
;; result: 0
;; audit:  clean
;; open:   E14
;; roots:  support
;; covers: `x
;; In Clojure's syntax-quote a symbol that ends in # is one fresh symbol
;; for the whole template: `(let [x# 10] (+ x# ~e)) cannot capture a
;; variable of the caller's, which is why `x#` is the idiom for a macro's
;; own binder. Today the reader takes `x#` for an ordinary symbol, so the
;; macro's binder is the caller's own `x#` and the expansion is
;; (let ((x# 10)) (+ x# x#)): 20 where Clojure's rule gives 11. (The
;; caller's variable is named like the template's on purpose: nothing else
;; can show that two symbols are different.)
(ns main (:use tl.check))

(defmacro add-ten (e)
  `(let ((x# 10)) (+ x# ,e)))

(defun main () -> i64
  (let ((c (checks))
        (x# 1))
    (do (check c (= (add-ten x#) 11))
        (checks-result c))))
