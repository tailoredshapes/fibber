;; spec:   stdlib §2.7 (the `\a` row of the table), §2.3 (Debug)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; Debug of a char is the form the reader reads: a backslash and the char, and
;; for the six that Clojure names (char-name-string) the name: \newline
;; \space \tab \return \backspace \formfeed. Any other char, a control
;; character included, is a backslash and the char itself (Clojure's pr of a
;; NUL is a backslash and a NUL, not \u0000). ToStr of a char is the char and
;; Show is the char too. The text of a string that needs no escape is quoted
;; and no more, at every depth; the escapes are case 613.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (debug \a) "\\a"))
        (check c (= (debug \A) "\\A"))
        (check c (= (debug \0) "\\0"))
        (check c (= (debug \newline) "\\newline"))
        (check c (= (debug \space) "\\space"))
        (check c (= (debug \tab) "\\tab"))
        (check c (= (debug \return) "\\return"))
        (check c (= (debug (i32->char 8i32)) "\\backspace"))
        (check c (= (debug (i32->char 12i32)) "\\formfeed"))
        (check c (= (debug \") "\\\""))
        (check c (= (debug \\) "\\\\"))
        (check c (= (debug (i32->char 233i32)) "\\é"))
        (check c (= (str-len (debug (i32->char 233i32))) 3))
        (check c (= (str-len (debug (i32->char 128512i32))) 5))
        (check c (= (str-len (debug (i32->char 0i32))) 2))
        (check c (= (str-len (debug (i32->char 127i32))) 2))
        (check c (= (show \a) "a"))
        (check c (= (show \newline) "\n"))
        (check c (= (str \newline) "\n"))
        (check c (= (debug [\a \space]) "[\\a \\space]"))
        (check c (= (show [\a \b]) "[a b]"))
        (check c (= (str [\a]) "[\\a]"))
        (check c (= (debug "ab") "\"ab\""))
        (check c (= (debug "") "\"\""))
        (check c (= (debug "é😀") "\"é😀\""))
        (check c (= (debug ["a" "bc"]) "[\"a\" \"bc\"]"))
        (check c (= (debug (some "a")) "\"a\""))
        (checks-result c))))
