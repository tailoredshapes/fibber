;; spec:   stdlib §2.3, tranche 1 plan §4.2 (core.base)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; The types every part shares, as the parts find them: Step (More and
;; Done, and `reduced` making a Done) from fib.core, and the prelude's Pair,
;; Triple and Result, with the fields fst, snd and thd and the variants Ok v
;; and Err e.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (p (Pair 1 "a"))
        (t (Triple 1 2 3))
        (ok: (Result i64 str) (Ok 7))
        (bad: (Result i64 str) (Err "no")))
    (do (check c (match (reduced 3) ((Done v) (= v 3)) ((More _) false)))
        (check c (match (More 4) ((More v) (= v 4)) ((Done _) false)))
        (check c (and (= (. p fst) 1) (= (. p snd) "a")))
        (check c (= (+ (. t fst) (+ (. t snd) (. t thd))) 6))
        (check c (match ok ((Ok v) (= v 7)) ((Err _) false)))
        (check c (match bad ((Err e) (= e "no")) ((Ok _) false)))
        (checks-result c))))
