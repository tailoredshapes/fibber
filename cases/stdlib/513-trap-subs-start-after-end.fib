;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: start after end
;; roots:  ../../lib support
;; Two bounds that are both in range but in the wrong order: (subs s 2 1) of
;; "aé€" has a start after its end. The message says so and not "out of
;; range", which is for a bound that is outside the string; (subs s 2 2) is
;; the empty string and is made first.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 2 2))
       (count (subs s 2 1)))))
