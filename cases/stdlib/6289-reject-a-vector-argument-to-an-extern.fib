;; spec:   types §3.15 (extern), docs/design/simd-and-tensors.md 2.4
;; expect: reject
;; error:  an extern position cannot be a vector
;; stage:  2
;; roots:  ../../lib support
;; A vector has no C ABI of fibber's own, so an extern may take scalars, ptr or unit only: the type of a position that is (Simd T n) is refused with a message that says so.
(ns main (:use fib.core))

(extern vec_sum ((Simd f64 2)) -> f64)

(defun main () -> i64 0)
