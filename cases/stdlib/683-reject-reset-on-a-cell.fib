;; spec:   stdlib §4.1 (rows reset! and atom), types §2.10 (reset! : (Atom a) a -> unit)
;; expect: reject
;; error:  cannot unify (Cell i64) with (Atom a)
;; roots:  ../../lib
;; covers: reset!
;; reset! takes an atom: a cell is written by set! (case 682 is the other way). The two builtins are
;; not interchangeable although both store a value and release the old one; which of them a program
;; may use decides whether tasks can share the slot.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((k (cell 1)))
    (do (reset! k 2)
        @k)))
