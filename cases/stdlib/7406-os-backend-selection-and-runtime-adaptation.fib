;; spec: docs/design/os.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib ../../compiler support
(ns main (:use tl.check) (:require [expand.roots :as r] [emit.os :as rt] [emit.runtime :as seed]))
(defun main () -> i64
  (let [c (checks) darwin (rt/sys-for "Darwin" seed/RT-SYS)]
    (do (check c (= (r/backend-relative "Linux") "fib/os/backend.fib"))
        (check c (= (r/backend-relative "Darwin") "platform/darwin/fib/os/backend.fib"))
        (check c (= (r/backend-relative "Windows") "platform/unsupported/fib/os/backend.fib"))
        (check c (= (rt/sys-for "Linux" seed/RT-SYS) seed/RT-SYS))
        (check c (some? (str-find darwin "__error" 0)))
        (check c (not (some? (str-find darwin "__errno_location" 0))))
        (check c (some? (str-find darwin "@openat (i32 -2)" 0)))
        (check c (some? (str-find darwin "@fib.sys-clock (i32 6)" 0)))
        (checks-result c))))
