;; spec:   stdlib §2.3 (Lookup), §1.2 P5 (nil is an Option), Appendix A12 keyed
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: get
;; get by index is (some x) in range and nil out of it, below zero included:
;; Clojure's (get [10 20] 5) and (get (int-array [1 2]) 5) are nil, never a
;; throw. A Vec is P0's instance (case 013), an array is L8a's. The array here
;; holds 0 10 20 so that a read of the wrong place is told apart; a second one
;; holds strings, which are objects and not scalars.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun tens (n: i64) -> (Array i64)
  (let ((c (cell (array n 0))))
    (do (dotimes (i n) (array-set! &c i (* 10 i)))
        @c)))

(defun is-some (o: (Option i64) x: i64) -> bool
  (match o ((some y) (= x y)) (nil false)))

(defun main () -> i64
  (let ((c (checks))
        (a (tens 3))
        (names (array 2 "ab")))
    (do (check c (is-some (get a 0) 0))
        (check c (is-some (get a 1) 10))
        (check c (is-some (get a 2) 20))
        (check c (nil? (get a 3)))
        (check c (nil? (get a -1)))
        (check c (nil? (get a 100)))
        (check c (nil? (get (tens 0) 0)))
        (check c (match (get names 1) ((some s) (= s "ab")) (nil false)))
        (check c (nil? (get names 2)))
        (check c (is-some (get [5 6 7] 2) 7))
        (check c (nil? (get [5 6 7] 3)))
        (checks-result c))))
