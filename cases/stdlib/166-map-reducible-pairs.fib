;; spec:   stdlib §2.1 rule 1 (a Map is a source of (Pair k v)), §2.3 (Reducible), tranche 1 plan §6 L5a
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; A (Map k v) is a Reducible of (Pair k v), the entry Clojure's seq gives, in the map's own order, which the
;; checks do not depend on (they fold with + and test every pair). count is the map's size. The walk stops when
;; the visitor says false and the visitor is not called again (the prelude's map-each under it stops the
;; walk of the trie): that is the early-exit check, with the visits counted. Maps of strings and of a
;; few dozen keys (a trie of several levels) are walked too.
(ns main (:use fib.core fib.seq tl.check))

(defun squares (n: i64) -> (Map i64 i64)
  (loop ((i 0) (m (map-empty)))
    (if (< i n) (recur (+ i 1) (assoc m i (* i i))) m)))

(defun sum-keys (c: c) :where ((Reducible c (Pair i64 i64))) -> i64
  (let ((acc (cell 0)))
    (do (each-while c (fn (p) (do (set! acc (+ @acc (. p fst))) true)))
        @acc)))

;; every pair is (k, k * k)
(defun all-squares (c: c) :where ((Reducible c (Pair i64 i64))) -> bool
  (let ((ok (cell true)))
    (do (each-while c (fn (p) (do (if (= (. p snd) (* (. p fst) (. p fst))) () (set! ok false)) true)))
        @ok)))

(defun stop-at (c: c n: i64) :where ((Reducible c e)) -> (Pair i64 bool)
  (let ((k (cell 0)))
    (let ((done (each-while c (fn (x) (do (set! k (+ @k 1)) (< @k n))))))
      (Pair @k done))))

(defun key-lengths (c: c) :where ((Reducible c (Pair str i64))) -> i64
  (let ((acc (cell 0)))
    (do (each-while c (fn (p) (do (set! acc (+ @acc (str-len (. p fst)))) true)))
        @acc)))

(defun main () -> i64
  (let ((c (checks))
        (m (squares 3))
        (big (squares 40))
        (none: (Map i64 i64) (map-empty))
        (words (assoc (assoc (map-empty) "alpha" 1) "be" 2)))
    (do (check c (= (count m) 3))
        (check c (= (fib.prelude/count (to-vec m)) 3))
        (check c (= (sum-keys m) 3))
        (check c (all-squares m))
        ;; early exit
        (let ((p (stop-at m 2)))
          (check c (and (= (. p fst) 2) (not (. p snd)))))
        (let ((p (stop-at m 1)))
          (check c (and (= (. p fst) 1) (not (. p snd)))))
        (let ((p (stop-at m 4)))
          (check c (and (= (. p fst) 3) (. p snd))))
        ;; a map of forty entries
        (check c (= (count big) 40))
        (check c (= (fib.prelude/count (to-vec big)) 40))
        (check c (= (sum-keys big) 780))
        (check c (all-squares big))
        (let ((p (stop-at big 17)))
          (check c (and (= (. p fst) 17) (not (. p snd)))))
        ;; empty
        (check c (= (count none) 0))
        (check c (= (sum-keys none) 0))
        (let ((p (stop-at none 1)))
          (check c (and (= (. p fst) 0) (. p snd))))
        ;; string keys
        (check c (= (count words) 2))
        (check c (= (key-lengths words) 7))
        (checks-result c))))
