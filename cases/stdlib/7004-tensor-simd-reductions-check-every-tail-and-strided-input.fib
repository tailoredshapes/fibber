;; spec: docs/design/numerical-library.md; explicit reassociated f64x4 reductions
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (dotimes (n 18)
          (let ((a (t/linspace 0.0 (double (max 0 (- n 1))) n))
                (b (t/full [n] 2.0)))
            (do (check c (= (t/sum-fast a) (t/sum a)))
                (check c (= (t/dot-fast a b) (t/dot a b)))
                (check c (= (t/sum-fast (t/flip 0 a)) (t/sum a))))))
        (let ((a (t/reshape [3 4] (t/linspace 0.0 11.0 12))))
          (check c (= (t/sum-fast (t/transpose a)) 66.0)))
        (check c (= (t/dot-fast (t/slice 0 0 12 2 (t/linspace 0.0 11.0 12))
                                (t/full [6] 2.0)) 60.0))
        (checks-result c))))
