;; spec:   stdlib §4.3 (row mod), types §2.12 (integer arithmetic has Rust's semantics)
;; expect: trap
;; trap:   integer overflow in rem at i64
;; roots:  ../../lib
;; covers: mod
;; mod is built on the builtin rem, and rem of the smallest i64 by -1 traps
;; (Rust's remainder overflows there; Java's % answers 0). The page says
;; to replicate Clojure's sharp edges that are not safety matters; the
;; library cannot special-case this one, because at a type variable it cannot
;; tell an integer from a float (a float -1.0 divisor must not answer 0).
;; This case records what the library does, so that a change to it is a
;; visible edit of one header.
(ns main (:use fib.core))

(defun main () -> i64
  (mod (- -9223372036854775807 1) -1))
