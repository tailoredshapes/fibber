;; spec:   stdlib §2.1 rule 2 (the recipe of each adaptor), §8.1 item 2, tranche 2 plan §5 Y2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; Case 271 for the recipes of tranche 2: the seven structs (MapIndexed Kept DroppedWhile Interposed
;; Distinct Reductions Consed), each alone and in six nested shapes of the kind the fusion rewrite
;; (X12) emits, against eager loops over the prelude's vec-conj and vec-nth (no library code on the
;; reference side), over 300 seeded draws of a Vec of 0 to 20 integers below 8 and drawn parameters.
;; The recipe side walks the structure with to-vec, which is each-while. The last checks plant a
;; fault in the reference, one at a time (1: Kept tests the wrong remainder, 2: Interposed puts a
;; separator first, 3: Reductions leaves out its init, 4: Distinct drops only a repeat of the previous
;; element), and require each to be noticed. Seed 2273.
(ns main (:use fib.core fib.seq fib.coll tl.check tl.rng))

;; ---- the reference
(defun push (v: (Vec i64) x: i64) -> (Vec i64) (vec-conj v x))
(defun r-map-indexed (v: (Vec i64) k: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i (vec-count v)) (recur (+ i 1) (push acc (+ (* i k) (vec-nth v i)))) acc)))
(defun r-keep (v: (Vec i64) k: i64 fault: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i (vec-count v))
        (let ((x (vec-nth v i)))
          (recur (+ i 1) (if (= (rem (+ x k) 3) (if (= fault 1) 1 0)) (push acc (* x k)) acc)))
        acc)))
(defun tail-from (v: (Vec i64) from: i64) -> (Vec i64)
  (loop ((j from) (acc (vec-empty))) (if (< j (vec-count v)) (recur (+ j 1) (push acc (vec-nth v j))) acc)))
(defun r-drop-while (v: (Vec i64) k: i64) -> (Vec i64)
  (loop ((i 0)) (if (and (< i (vec-count v)) (< (vec-nth v i) k)) (recur (+ i 1)) (tail-from v i))))
(defun r-interpose (v: (Vec i64) sep: i64 fault: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i (vec-count v))
        (recur (+ i 1) (push (if (or (> i 0) (and (= fault 2) (= i 0))) (push acc sep) acc) (vec-nth v i)))
        acc)))
(defun has (v: (Vec i64) x: i64) -> bool
  (loop ((i 0)) (if (< i (vec-count v)) (if (= (vec-nth v i) x) true (recur (+ i 1))) false)))
(defun r-distinct (v: (Vec i64) fault: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i (vec-count v))
        (let ((x (vec-nth v i)))
          (recur (+ i 1)
                 (if (if (= fault 4)
                         (and (> (vec-count acc) 0) (= (vec-nth acc (- (vec-count acc) 1)) x))
                         (has acc x))
                     acc
                     (push acc x))))
        acc)))
(defun step (a: i64 x: i64 k: i64) -> i64 (rem (+ (* a k) x) 1000003))
(defun r-reductions (v: (Vec i64) init: i64 k: i64 fault: i64) -> (Vec i64)
  (loop ((i 0) (a init) (acc (if (= fault 3) (vec-empty) (push (vec-empty) init))))
    (if (< i (vec-count v))
        (let ((b (step a (vec-nth v i) k))) (recur (+ i 1) b (push acc b)))
        acc)))
(defun r-cons (x: i64 v: (Vec i64)) -> (Vec i64)
  (loop ((i 0) (acc (push (vec-empty) x)))
    (if (< i (vec-count v)) (recur (+ i 1) (push acc (vec-nth v i))) acc)))
(defun r-map (v: (Vec i64) k: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty))) (if (< i (vec-count v)) (recur (+ i 1) (push acc (+ (vec-nth v i) k))) acc)))

(defun same (a: (Vec i64) b: (Vec i64)) -> bool
  (and (= (vec-count a) (vec-count b))
       (loop ((i 0)) (if (< i (vec-count a)) (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false) true))))

;; ---- the functions given to the recipes, the same ones the reference spells out
(defun fmi (k: i64) -> (fn (i64 i64) i64) (fn (i x) (+ (* i k) x)))
(defun fkeep (k: i64) -> (fn (i64) (Option i64)) (fn (x) (if (= (rem (+ x k) 3) 0) (some (* x k)) nil)))
(defun fbelow (k: i64) -> (fn (i64) bool) (fn (x) (< x k)))
(defun fstep (k: i64) -> (fn (i64 i64) i64) (fn (a x) (step a x k)))
(defun fplus (k: i64) -> (fn (i64) i64) (fn (x) (+ x k)))

;; one draw: every recipe alone, then nested
(defun draw (r: Rng c: Checks fault: i64) -> unit
  (let ((v (rng-vec r (rng-below r 21) 8))
        (k (rng-below r 5))
        (x (rng-below r 8)))
    (do (check c (same (to-vec (MapIndexed v (fmi k))) (r-map-indexed v k)))
        (check c (same (to-vec (Kept v (fkeep k))) (r-keep v k fault)))
        (check c (same (to-vec (DroppedWhile v (fbelow k))) (r-drop-while v k)))
        (check c (same (to-vec (Interposed v x)) (r-interpose v x fault)))
        (check c (same (to-vec (Distinct v)) (r-distinct v fault)))
        (check c (same (to-vec (Reductions v (fstep (+ k 1)) x)) (r-reductions v x (+ k 1) fault)))
        (check c (same (to-vec (Consed x v)) (r-cons x v)))
        (check c (same (to-vec (Kept (MapIndexed v (fmi k)) (fkeep x))) (r-keep (r-map-indexed v k) x fault)))
        (check c (same (to-vec (Interposed (Distinct v) x)) (r-interpose (r-distinct v fault) x fault)))
        (check c (same (to-vec (Reductions (DroppedWhile v (fbelow k)) (fstep (+ x 1)) k))
                       (r-reductions (r-drop-while v k) k (+ x 1) fault)))
        (check c (same (to-vec (Consed x (Kept v (fkeep k)))) (r-cons x (r-keep v k fault))))
        (check c (same (to-vec (MapIndexed (Interposed v x) (fmi k))) (r-map-indexed (r-interpose v x fault) k)))
        (check c (same (to-vec (Distinct (Mapped v (fplus k)))) (r-distinct (r-map v k) fault))))))

(defun run-all (c: Checks fault: i64) -> unit
  (let ((r (rng 2273)))
    (dotimes (i 300) (draw r c fault))))

(defun main () -> i64
  (let ((c (checks)) (p1 (checks)) (p2 (checks)) (p3 (checks)) (p4 (checks)))
    (do (run-all c 0)
        (check c (= (checks-made c) 3900))
        (run-all p1 1)
        (run-all p2 2)
        (run-all p3 3)
        (run-all p4 4)
        (check-detects c p1)
        (check-detects c p2)
        (check-detects c p3)
        (check-detects c p4)
        (checks-result c))))
