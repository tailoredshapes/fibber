;; spec:   stdlib §4.4 (row cycle), §2.1 rule 1 (Cycle is a source)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: cycle take vec first nth reduce
;; The page's example, (take 7 (cycle [1 2 3])), is [1 2 3 1 2 3 1], and so is the bound lazy
;; form of it. A cycle is made of any source: a Vec, a string (its characters), a Range, a
;; List and a lazy seq, each read the same way by the fused loop. The walk starts again from the
;; source on every pass and stops where the consumer stops; `nth` of a large index goes round that many times.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (s (take 7 (cycle [1 2 3]))))
    (do (check c (= (vec (take 7 (cycle [1 2 3]))) [1 2 3 1 2 3 1]))
        (check c (= (vec s) [1 2 3 1 2 3 1]))
        (check c (= (reduce (fn (a x) (+ (* a 10) x)) 0 (take 7 (cycle [1 2 3]))) 1231231))
        (check c (= (vec (take 5 (cycle "ab"))) [\a \b \a \b \a]))
        (check c (= (vec (take 7 (cycle (range 3)))) [0 1 2 0 1 2 0]))
        (check c (= (vec (take 5 (cycle (list 7 8)))) [7 8 7 8 7]))
        (check c (= (vec (take 5 (cycle (map inc [1 2])))) [2 3 2 3 2]))
        (check c (= (vec (take 3 (cycle [9]))) [9 9 9]))
        (check c (= (first (cycle [4 5])) (some 4)))
        (check c (= (nth (cycle [4 5 6]) 100) 5))
        (check c (= (vec (take 5 (cycle (cycle [1 2])))) [1 2 1 2 1]))
        (checks-result c))))
