;; spec:   stdlib §2.7 (Ord of a Vec is Clojure's: the shorter first, then element by element), §4.4 (row sort), A11 t1r
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sort
;; (sort [[1 2 3] [9 9] [1 2]]) is [[1 2] [9 9] [1 2 3]]: a Vec is ordered by
;; length first, then by its elements, as Clojure's `compare` of vectors is.
;; The instance is L3's (fib.seq.hash). Nothing here uses Eq of a Vec: the rows of the
;; result are compared by hand.
(ns main (:use fib.core fib.seq tl.check))

(defun same (a: (Vec i64) b: (Vec i64)) -> bool
  (if (= (vec-count a) (vec-count b))
      (loop ((i 0))
        (if (< i (vec-count a))
            (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false)
            true))
      false))

(defun main () -> i64
  (let ((c (checks))
        (out (to-vec (sort [[1 2 3] [9 9] [1 2] [] [1 3] [0 0 0]]))))
    (do (check c (= (vec-count out) 6))
        (check c (same (vec-nth out 0) []))
        (check c (same (vec-nth out 1) [1 2]))
        (check c (same (vec-nth out 2) [1 3]))
        (check c (same (vec-nth out 3) [9 9]))
        (check c (same (vec-nth out 4) [0 0 0]))
        (check c (same (vec-nth out 5) [1 2 3]))
        (checks-result c))))
