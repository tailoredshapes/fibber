;; spec:   stdlib §7 L3b (the fields in order and exactly)
;; expect: reject
;; error:  a vector pattern of a Pair takes exactly its 2 field(s) and no rest, the pattern has 3 element(s)
;; roots:  ../../lib support
;; A Pair has two fields, so `[a b c]` cannot match it, and unlike a vector's pattern it has no
;; length to test at run time: the checker refuses it.
(ns main (:use fib.core))

(defun main () -> i64
  (match (Pair 1 2)
    ([a b c] (+ a b))))
