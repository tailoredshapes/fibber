;; spec:   syntax §3.15a (lir)
;; expect: reject
;; error:  malformed lir: wrong number of operands
;; stage:  2
;; roots:  ../../lib support
;; Five parts: the head, the operands, the arrow, the result type and the body.
(ns main (:use fib.core))

(defun f (p: ptr) -> i64 (unsafe (lir [p: ptr] i64 "(block entry (ret (i64 0)))")))

(defun main () -> i64 0)
