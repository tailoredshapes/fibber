;; spec:   stdlib §6.3 (E4); syntax §4.4; §7 L20
;; expect: accept
;; result: 3
;; audit:  clean
;; roots:  ../../lib support
;; covers: cond
;; Without a default, falling off the end of a cond is nil (`(Option T)`, each value in `some`), no longer
;; a trap (the `:else` a cond that must answer writes, as the library does, is the default). The
;; clause that matches answers `(some v)`.
(ns main (:use tl.check))

(defun pick (n: i64) -> (Option i64)
  (cond (< n 0) 1
        (> n 0) 2))

(defun main () -> i64
  (+ (match (pick 3) ((some x) x) (nil 100))
     (match (pick 0) ((some x) x) (nil 1))))
