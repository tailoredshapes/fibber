;; spec:   stdlib §4.4 (rows reduce, reduce1), §5.5 S7
;; expect: reject
;; error:  reduce takes 3 argument(s), got 2
;; roots:  ../../lib
;; covers: reduce
;; `(reduce f c)` as written is the macro's (it is `reduce-nonempty`, which traps on an
;; empty `c`, cases 784 and 785) and runs. A call the macro does not see, the
;; qualified head `fib.seq/reduce`, is the three-argument function, and its arity
;; error is the plain one. `reduce1`, the two-argument form that answers an Option, stays a function of its own:
;; the macro `reduce` (Rust) owns the two-argument call, and the D1 hint that named `reduce1` is gone.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (fib.seq/reduce + [1 2]))
