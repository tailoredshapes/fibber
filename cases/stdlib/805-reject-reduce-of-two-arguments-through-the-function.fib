;; spec:   stdlib §7 D1, §4.4 (rows reduce, reduce1), §5.5 S7
;; expect: reject
;; error:  reduce takes 3 argument(s), got 2; use reduce1
;; roots:  ../../lib
;; covers: reduce
;; `(reduce f c)` as written is the macro's (it is `reduce-nonempty`, which traps on an
;; empty `c`, cases 784 and 785) and runs. A call the macro does not see, the
;; qualified head `fib.seq/reduce`, is the three-argument function, and its arity
;; error names the stand-in of the two-argument form that answers an Option,
;; `reduce1`.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (fib.seq/reduce + [1 2]))
