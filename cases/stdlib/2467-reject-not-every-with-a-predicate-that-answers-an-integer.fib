;; spec:   stdlib §2.3 (a predicate result is a Truthy: bool or Option, and no other type), §4.4 (row not-every?), tranche 2 plan Y4
;; expect: reject
;; error:  no implementation of Truthy for i64
;; roots:  ../../lib support
;; covers: not-every?
;; not-every? takes a predicate whose result is a bool or an Option: an integer cannot be false, so
;; `(not-every? (fn (x) x) [1 2])` is refused with the protocol's name.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (not-every? (fn (x) x) [1 2]) 1 0))
