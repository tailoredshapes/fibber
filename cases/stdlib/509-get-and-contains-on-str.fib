;; spec:   stdlib §2.3 (Lookup, Keyed), §2.9 (a str is looked up by character index)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; A str is a `Lookup` from an `i64` to a `char` and `Keyed` by its indexes, as
;; Clojure's string is: (get "abc" 1) is (some \b), (get "abc" 3) is nil and
;; never a trap (nth is the one that traps, case 519), a negative index is nil,
;; and (contains? "abc" 1) is true where (contains? "abc" 97) is false: the key
;; is the index, not an element (includes? is the element test, L8a). The
;; index counts characters, so every index of "aé€😀z" from 0 to 4 is in
;; and 5 is out, though the string is eleven bytes long.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun got (r: (Option char) want: char) -> bool
  (match r ((some x) (= x want)) (nil false)))

(defun main () -> i64
  (let ((c (checks))
        (s "aé€😀z"))
    (do (check c (got (get s 0) \a))
        (check c (got (get s 1) \é))
        (check c (got (get s 2) \€))
        (check c (got (get s 3) \😀))
        (check c (got (get s 4) \z))
        (check c (nil? (get s 5)))
        (check c (nil? (get s 10)))
        (check c (nil? (get s -1)))
        (check c (nil? (get "" 0)))
        (check c (got (get "abc" 1) \b))
        (check c (contains? s 0))
        (check c (contains? s 4))
        (check c (not (contains? s 5)))
        (check c (not (contains? s 10)))
        (check c (not (contains? s -1)))
        (check c (not (contains? "" 0)))
        (check c (contains? "abc" 1))
        (check c (not (contains? "abc" 3)))
        (check c (not (contains? "abc" 97)))
        (checks-result c))))
