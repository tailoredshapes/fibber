;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 17
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Test 1 of the design (leak after catching): three frames each own objects (a vector, strings, a vector made by conj) when the deepest
;; traps (an index out of range in the library's nth); the catch in main gets it and every object the unwound frames owned is freed, so
;; the audit is clean. The second try holds an owned temporary argument ([1 2 3], evaluated, not yet handed to consume) when the next
;; argument fails: it is freed too. Killed by: scripts/mutant-catch.sh `no-release` (the frames' releases are skipped: a leak) and
;; `no-pending` (the evaluated arguments are not released: a leak).
(ns main (:use fib.core fib.ex))

(defun leaf (v: (Vec i64) i: i64) -> i64 (nth v i))

(defun mid (v: (Vec i64) i: i64) -> i64
  (let ((label (str-concat "mid " (show i))) (w (conj v i)))
    (+ (str-len label) (leaf w i))))

(defun top (i: i64) -> i64
  (let ((v [10 20 30]) (name (str-concat "top " (show i))))
    (+ (str-len name) (mid v (* i 10)))))

(defun consume (v: (Vec i64) n: i64) -> i64 (+ (count v) n))

(defun main () -> i64
  (let ((a (try (top 1) (catch e -1)))
        (b (try (consume [1 2 3] (top 2)) (catch e -2)))
        (c (try (top 0) (catch e -3))))
    (+ a (+ b c))))
