;; spec:   stdlib §2.9 (the cost of a str as a Reducible), §8.1 item 2 (a tight allocs bound), cases/stdlib/README.md
;; expect: accept
;; result: 1000
;; audit:  clean
;; allocs: <= 2
;; roots:  ../../lib support
;; `count` of a 500-character string (962 bytes: one to four per character)
;; walks the bytes and allocates nothing. The string is one object, made at
;; run time by `str-concat` of two literals of 250 characters, and the
;; `Chars` view of it is a second, a struct, until C5; so the bound is the
;; string and the view, and the two counts, 500 each, cost no more. The
;; prelude's `str-chars` would add 2095 objects per 1000 characters, a Vec
;; built by a `conj` loop, and a `size` that fell back on the default walk
;; would add a cell. The bound is the measured count: the tests
;; `a_stdlib_count_bound_one_below_the_count_fails` lower it by one and
;; require the failure. The result is the two counts added, 500 + 500.
(ns main (:use fib.core fib.seq))

(def left: str "hw🙉乓d丕Ċq东óŕzhf😟乇乁😥g🙉r😑zzgburcĈkuy😇lszws临gpēg丬书mĮjtwækn😞z😇😝ĺ😭😬du乐乀三Ğu丳乢ued😭乙zŬjym😣丫😋b🙉Ŋ乞twċ乥y😧Ůehe😭ĭlmf乤jiqńe😕wwŻŏ丌xvlsŕfot乼İb乪qiapkfic😒rð丂fb😆亀😩三ońnīmlùnçb乣dnĩ个t乭jĬŦmb丒丈qmŗ乙😔丿丠t乩bjto😃a😫😻ugŬ乍tpzwnŬĬyf😥òŵfk丱p久iedŅ😖cs丿ôſ🙍jadsgfyeĵ😅乗ix乥pnz丞i🙁ĺæv乸řląl乲😺m😢r")
(def right: str "udo😵gwtf乼丄gĞų丹rv丒乓wulny乮丹ŝbm😳😭cjubnuc🙋😗Űm乿fe乜ff😶etŷqĬ😺丣乳乨h😘č丫😀Ŷuk😂丁ic🙊m😻jjw丕ĉ🙂bm😝reňēsmiâc义nhŒw丫o习🙈丸😪ts😇qxhdĎ丆乑xť😧kjbs並乸ĩfyŃgyenĀ乖ź😼e乳gji😗个乡jg不丆jls丯😑一😀Ĵzipibv😁dţ乊ĤčŦqy😿tm😻qrńuv主😏e😭jàqojy😚k🙀😗g🙏乸v丗一dkwž😬jg😽😣😜qlĈ🙄丌h丒l乮qōăŴŒy😡hbkx🙋clha🙎oopbaĦk😞qŦy乘😰y不乧ph")

(defun main () -> i64
  (let ((s (str-concat left right)))
    (+ (count s) (count (Chars s)))))
