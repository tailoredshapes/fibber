;; spec:   stdlib §4.3 (row float), §2.3 (ToFloat), §2.8 (conversions are checked)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: float
;; `(float x)` over an i8, an i16, an i32, an i64, an f32 (itself) and an f64. An integer is
;; rounded to the nearest f32 and never traps (16777217 is not an f32: it is 16777216.0, and
;; 16777219 is 16777220.0, both ties to even); an f64 is narrowed when it is within the range
;; of an f32, the greatest f32 (bits 7F7FFFFF) and its negation included; a value too small
;; for an f32 underflows to zero, which is not an overflow; a NaN passes through. The traps
;; are cases 2906 to 2909. The greatest f32 is read back as its bit pattern, 2139095039.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (nan (/ 0.0 0.0)))
    (do (check c (= (float 0) 0.0f32))
        (check c (= (float -7) -7.0f32))
        (check c (= (float 127i8) 127.0f32))
        (check c (= (float -32768i16) -32768.0f32))
        (check c (= (float 2147483647i32) 2147483648.0f32))
        (check c (= (float 16777216) 16777216.0f32))
        (check c (= (float 16777217) 16777216.0f32))
        (check c (= (float 16777219) 16777220.0f32))
        (check c (= (float -16777217) -16777216.0f32))
        (check c (= (float 2.5f32) 2.5f32))
        (check c (= (float 2.5) 2.5f32))
        (check c (= (float -2.5) -2.5f32))
        (check c (= (float 0.1) 0.1f32))
        (check c (= (f32->bits (float 3.4028234663852886e38)) 2139095039i32))
        (check c (= (f32->bits (float -3.4028234663852886e38)) -8388609i32))
        (check c (= (float 1e-50) 0.0f32))
        (check c (!= (float nan) (float nan)))
        (checks-result c))))
