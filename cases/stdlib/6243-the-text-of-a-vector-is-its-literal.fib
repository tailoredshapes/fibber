;; spec:   types §2.12 (Show of a vector), docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; show of a vector is the literal with the element type visible (no suffix for i64 and f64, the suffix for the others, bool lanes as true/false), compared with a text built here from the show of each lane by the scalar rule and with the literal written out.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun joined (v: (Simd t n) lanes: i64 suffix: str) :where ((Show t)) -> str
  (let ((parts (loop ((i 0) (acc [])) (if (< i lanes) (recur (+ i 1) (conj acc (show (lane v i)))) acc))))
    (str-join ["<<" (str-join (into [] (interpose " " parts))) ">>" suffix])))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (show <<1 2 3 4>>i32) (joined <<1 2 3 4>>i32 4 "i32")))
        (check c (= (show <<1 2 3 4>>i32) "<<1 2 3 4>>i32"))
        (check c (= (show <<-1 127>>i8) "<<-1 127>>i8"))
        (check c (= (show <<-300 32767 0>>i16) "<<-300 32767 0>>i16"))
        (check c (= (show <<7 -8 9>>) "<<7 -8 9>>"))
        (check c (= (show <<7 -8 9>>) (joined <<7 -8 9>> 3 "")))
        (check c (= (show <<1.5 2.5>>f32) "<<1.5 2.5>>f32"))
        (check c (= (show <<1.0 -2.25 3.0 4.0>>) "<<1.0 -2.25 3.0 4.0>>"))
        (check c (= (show (simd/lt <<1 2>> <<2 1>>)) "<<true false>>"))
        (check c (= (show <<5>>i64) "<<5>>"))
        (let ((p (checks)))
          (do (check p (= (show <<1 2>>i32) "<<1 2>>")) (check-detects c p)))
        (checks-result c))))
