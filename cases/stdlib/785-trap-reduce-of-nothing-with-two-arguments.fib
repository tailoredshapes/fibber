;; spec:   stdlib §4.4 (row reduce), §6.3 (R6b), §2.1 rule 3
;; expect: trap
;; trap:   reduce: empty collection
;; roots:  ../../lib support
;; covers: reduce
;; The two-argument (reduce f c) starts from the first element, so an empty source
;; has no value to answer with: the macro makes it reduce-nonempty, which traps
;; `reduce: empty collection` (Clojure's (f) with no arguments has no type here).
;; The same call over a source of one element answers it without calling f, after
;; a good call has answered.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((ev: (Vec i64) (vec-empty))
        (one (reduce (fn (a x) (+ a x)) [41])))
    (+ one (reduce (fn (a x) (+ a x)) ev))))
