;; spec:   stdlib §4.1 (rows set! and atom), types §2.10 ("set! on an atom is a type error")
;; expect: reject
;; error:  cannot unify (Atom i64) with (Cell a)
;; roots:  ../../lib
;; covers: set!
;; The two stores do not cross: set! writes a Cell, which one task owns, and an atom is written by
;; reset! and swap!, which are atomic. A set! on an atom would be a plain store that another task
;; reads, the race the atom exists to avoid, so the checker refuses it (case 683 is the other way).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (atom 1)))
    (do (set! a 2)
        @a)))
