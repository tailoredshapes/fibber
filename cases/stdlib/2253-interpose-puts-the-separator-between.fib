;; spec:   stdlib §4.4 row interpose, §2.1 rule 2 (the lazy form), tranche 2 plan §5 Y2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: interpose
;; (interpose sep c) puts sep between two neighbours, never before the first element nor after
;; the last: a source of n >= 1 elements gives 2n - 1, one element is itself, and none is none.
;; The separator has the type of the elements; for strings it is the usual way to join (the text
;; is built with str-join over the seq's Vec).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (vec (interpose 0 [1 2 3])) [1 0 2 0 3]))
        (check c (= (vec (interpose 0 [1 2])) [1 0 2]))
        (check c (= (vec (interpose 0 [7])) [7]))
        (check c (empty? (interpose 0 [])))
        (check c (= (count (interpose 0 [1 2 3 4])) 7))
        ;; strings, the usual use
        (check c (= (str-join (vec (interpose ", " ["a" "b" "c"]))) "a, b, c"))
        (check c (= (str-join (vec (interpose "-" ["x"]))) "x"))
        ;; every kind of source
        (check c (= (vec (interpose 9 (range 3))) [0 9 1 9 2]))
        (check c (= (vec (interpose 9 (list 1 2))) [1 9 2]))
        (check c (= (vec (interpose 9 (some 1))) [1]))
        (check c (= (vec (interpose 0 (map (fn (x: i64) (* x 2)) [1 2 3]))) [2 0 4 0 6]))
        ;; the separator may equal an element
        (check c (= (vec (interpose 1 [1 1])) [1 1 1]))
        ;; a bound seq walked twice
        (let ((s (interpose 0 [5 6])))
          (do (check c (= (vec s) [5 0 6]))
              (check c (= (vec s) [5 0 6]))))
        (checks-result c))))
