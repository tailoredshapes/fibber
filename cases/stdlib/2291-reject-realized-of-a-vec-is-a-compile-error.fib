;; spec:   stdlib §4.4 row realized?, §2.1 rule 2
;; expect: reject
;; error:  cannot unify (Vec i64) with (LSeq a)
;; roots:  ../../lib support
;; covers: realized?
;; A Vec is realised from the start, and the page's row gives realized? only to the types that
;; have a forced flag: a seq (an LSeq), a delay, a promise, a task. A Vec is none of them, and
;; asking is refused rather than answered true.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (realized? [1 2 3]) 1 0))
