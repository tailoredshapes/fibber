;; spec:   docs/design/parallelism.md 3.2 (P-struct); lib/fib/parallel/chunks.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; 1500 chunks (grain 1), each taking 2 ms, on 6 workers: the number of chunk bodies running at once, counted by an atom, never exceeds 6 and does exceed 1.
;; (On a pool of one worker, FIB_THREADS=1, the chunks cannot overlap: the second check then holds by that.)
;; A pmap that spawned one task per chunk would run thousands of threads at once: it fails this check and, under the cases' `ulimit -v
;; 16000000`, runs out of address space (about 250 allocating threads, each with its own 64 MB malloc arena) before it finishes.
(ns main (:use fib.core fib.parallel fib.os tl.check))

(defun main () -> i64
  (let [c (checks)
        live (atom 0)
        peak (atom 0)
        ys (pmap-n (Par 6 1 false)
             (fn (i) (let [now (swap! live inc)]
                       (do (swap! peak (fn (m) (max m now)))
                           (sleep-ns 150000)
                           (swap! live dec)
                           i)))
             1500)]
    (do (check c (= ys (vec (range 1500))))
        (check c (<= @peak 6))
        (check c (or (> @peak 1) (= (pool-workers) 1)))
        (check c (= @live 0))
        (checks-result c))))
