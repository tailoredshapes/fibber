;; spec:   stdlib §4.2 (row defrecord), §2.7, plan Y8 (PC2-5)
;; expect: reject
;; error:  no implementation of Debug for Inner
;; roots:  ../../lib support
;; A record needs the instances of its six derives for every field: Inner derives four (Eq Ord Hash Show) and not Debug,
;; so Outer's derive of Debug, the fifth the macro writes, is refused naming Inner (ToStr, the sixth, is Debug's text, so
;; it needs Debug of the field and no instance of its own). The four before it are accepted, which is why the message is
;; about Debug and no other. The way out is a `derive Debug` of Inner, or a `defstruct` for Outer with the derives that
;; its author chooses.
(ns main)

(defstruct Inner (a: i64))
(derive Eq Inner)
(derive Ord Inner)
(derive Hash Inner)
(derive Show Inner)

(defrecord Outer [i: Inner n: i64])

(defun main () -> i64
  (let ((o (->Outer (Inner 1) 2)))
    (. o n)))
