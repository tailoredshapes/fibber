;; spec:   stdlib §2.4 (get with a default is get-or until L1), §4.5 (row get-or)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: get-or
;; (get-or c k d) is the value at k or, when k is missing, d: Clojure's
;; (get m k d). A value that is present wins over the default even when it is
;; zero or equal to the default, and a missing key gives the default whatever
;; it is. It works on every collection with a Lookup instance: a Map by key,
;; a Vec by index (out of range, and negative, is a miss).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (empty {1 0}) 1 0) 2 7))
        (v [5 6 7]))
    (do (check c (= (get-or m 1 99) 0))
        (check c (= (get-or m 2 99) 7))
        (check c (= (get-or m 3 99) 99))
        (check c (= (get-or m 3 7) 7))
        (check c (= (get-or (empty m) 1 -1) -1))
        (check c (= (get-or v 0 -1) 5))
        (check c (= (get-or v 2 -1) 7))
        (check c (= (get-or v 3 -1) -1))
        (check c (= (get-or v -1 -2) -2))
        (check c (= (get-or (assoc (empty {"a" "x"}) "a" "b") "a" "d") "b"))
        (check c (= (get-or (empty {"a" "x"}) "a" "d") "d"))
        (checks-result c))))
