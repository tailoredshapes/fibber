;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; Kinds 9 long (when it fits) and double and the bit length, 11 isqrt, 12 the exact quotient as a ratio.
;; The operands are drawn by tl.bigdiff (zero, digits, powers of two and their neighbours, random limbs up to
;; 160, all-one limbs, the edges of an i64, powers of ten, limbs from the edge values where Algorithm D's
;; add-back is common) and each result's text goes into a digest; the digests below are what
;; scripts/bigint/BigDiff.java printed for the same seeds with java.math.BigInteger (README of the library:
;; scripts/bigint/README.md). A mismatch names the kind in the result's bit mask; a planted wrong digest shows
;; that the comparison can fail.
(ns main (:use tl.check tl.bigdiff))

(defun main () -> i64
  (let [c (checks)
        p (checks)]
    (do
      (check c (= (bigdiff-run 9 false) -5071872658855120585))
      (check c (= (bigdiff-run 11 false) 4285056225027190476))
      (check c (= (bigdiff-run 12 false) -9107085681884633938))
      (check p (= (bigdiff-run 9 false) -5071872658855120584))
      (check-detects c p)
      (checks-result c))))
