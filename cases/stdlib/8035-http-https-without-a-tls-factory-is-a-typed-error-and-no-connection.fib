;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types fib.http.client.types) (:require [fib.http.client :as cl]))
(defun main () -> i64
  (let [c (checks)]
    (match (cl/build-http-client (default-options))
      ((Err _) 1)
      ((Ok client)
        (do (check c (match (cl/request-with client (ClientRequest "GET" "https://127.0.0.1:1/" {} (array 0 0i8))) ((Err (TlsUnsupported _)) true) (_ false)))
            (check c (= (. (cl/pool-stats client) opened) 0))
            (check c (match (cl/request-with client (ClientRequest "GET" "ftp://127.0.0.1/" {} (array 0 0i8))) ((Err (InvalidRequest _)) true) (_ false)))
            (cl/close-http-client client) (checks-result c))))))
