;; spec:   stdlib §7 L15, syntax §3.19
;; expect: trap
;; trap: def broken: config missing
;; roots:  ../../lib support
;; covers: def
;; The initialiser runs before `main`; a trap in it stops the program with
;; the `def` named, since no function of the program is on the stack.
(def broken: i64 (trap "config missing"))

(defun main () -> i64 0)
