;; spec: spec/types.md 1.9 (scalar-generic chunk): `(size-of T)` is an i64, the bytes of T in memory: i8 1, i16 2, i32 4, i64 8, f32 4, f64 8, ptr 8 on this host; a local binding named size-of shadows the form
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Each width is compared with its size; a wrong size of any one of them returns that width's bit, so the exit code names the width. The last check binds a local called
;; size-of and calls it, which proves only a local shadows the primitive form.
(ns main)

(defun bad (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (bad (= (size-of i8) 1) 1)
     (bad (= (size-of i16) 2) 2)
     (bad (= (size-of i32) 4) 4)
     (bad (= (size-of i64) 8) 8)
     (bad (= (size-of f32) 4) 16)
     (bad (= (size-of f64) 8) 32)
     (bad (= (size-of ptr) 8) 64)
     (let ((size-of (fn (x: i64) -> i64 (+ x 100))))
       (bad (= (size-of 5) 105) 128))))
