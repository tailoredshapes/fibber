;; spec:   stdlib §2.3 (the some-p of A11, over Truthy and Payload), §4.4 (row some), tranche 2 plan Y4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; (some-p p c) is the function that the Rust macro `some` calls for `(some pred c)` (plan PC2-3):
;; the payload of the first truthy result of p, as an Option. A predicate that answers a bool gives
;; `(some true)` for a hit and nil for none, Clojure's `(some even? [1 3 4 6])` is true; nothing to
;; look at is nil. The first hit is the answer: a later one is never looked at.
(ns main (:use fib.core fib.seq tl.check))

(defun hit? (o: (Option bool)) -> bool (match o (nil false) ((some b) b)))

(defun main () -> i64
  (let ((c (checks))
        (empty: (Vec i64) (vec-empty)))
    (do (check c (hit? (some-p even? [1 3 4 6])))
        (check c (nil? (some-p even? [1 3 5])))
        (check c (nil? (some-p even? empty)))
        (check c (hit? (some-p even? [4])))
        (check c (hit? (some-p even? (list 1 2))))
        (check c (hit? (some-p even? (Range 1 5 1))))
        (check c (nil? (some-p even? (Range 5 5 1))))
        (check c (hit? (some-p even? (map inc [1 3 4]))))
        (check c (nil? (some-p even? (some 3))))
        (check c (hit? (some-p even? (some 4))))
        (check c (match (some-p (fn (x) (if (> x 1) (some (* x 100)) nil)) [1 2 3]) (nil false) ((some v) (= v 200))))
        (check c (match (some-p (fn (s) (if (> (str-len s) 1) (some (str-concat s "!")) nil)) ["a" "bb" "ccc"])
                   (nil false) ((some t) (= t "bb!"))))
        (check c (match (some-p (fn (ch) (= ch \b)) "abc") (nil false) ((some b) b)))
        (checks-result c))))
