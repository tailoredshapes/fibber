;; spec:   stdlib §4.4 (rows ffirst fnext), tranche 2 plan Y4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: ffirst fnext
;; (ffirst c) is `(first (first c))`: two Reducible constraints, the outer collection of inner
;; collections, so the inner type is any source (a Vec, a List, a string). It is nil when the
;; outer is empty and when the first inner is empty (`(ffirst [[] [1]])` is nil in Clojure: the
;; second inner is not looked at). (fnext c) is the alias of `second`: the element after the first.
(ns main (:use fib.core fib.seq tl.check))

(defun is (o: (Option i64) n: i64) -> bool (match o (nil false) ((some x) (= x n))))

(defun main () -> i64
  (let ((c (checks))
        (none: (Vec (Vec i64)) (vec-empty))
        (hole: (Vec (Vec i64)) [(vec-empty) [1]]))
    (do (check c (is (ffirst [[1 2]]) 1))
        (check c (is (ffirst [[7 8] [9]]) 7))
        (check c (is (ffirst (list [4 5] [6])) 4))
        (check c (is (ffirst [(list 3 4)]) 3))
        (check c (nil? (ffirst none)))
        (check c (nil? (ffirst hole)))
        (check c (match (ffirst ["abc" "d"]) ((some ch) (= ch \a)) (nil false)))
        (check c (match (ffirst [["x" "y"] ["z"]]) ((some s) (= s "x")) (nil false)))
        (check c (is (ffirst [(map inc [1 2])]) 2))
        (check c (is (fnext [4 5 6]) 5))
        (check c (nil? (fnext [4])))
        (check c (is (fnext (list 1 2)) 2))
        (check c (match (fnext ["a" "b"]) ((some s) (= s "b")) (nil false)))
        (checks-result c))))
