;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:9:19: kernel k: a cell of an object: a kernel has cells of scalars only
;; `try`/`catch` is the library's macro (fib.ex) over a cell that holds the caught object and the builtin `catch-run`: a kernel catches nothing;
;; the first thing the macro's expansion needs, a cell of an object, is refused at the `try`.
(ns main (:use fib.ex) (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n) (try (gpu/f32-set! a i 1.0f32) (catch e (trap "no"))))))
(defun main () -> i64 0)
