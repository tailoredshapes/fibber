(ns tl.lacinia-query (:use fib.core fib.seq fib.coll) (:require [fib.lacinia :as g]))
(defun definition (calls: (Atom i64)) -> g/GqlSchemaDefinition
  (let [text (g/named "String") integer (g/named "Int")
    echo (g/resolving text (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
      (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (unwrap-or (get args "text") g/NullValue)))))
    describe (g/resolving text (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
      (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/StringValue (g/value-json (g/object args)))))))
    person (g/object {"name" (g/StringValue "Ada") "id" (g/IntValue 7)
      "friend" (g/object {"name" (g/StringValue "Bob") "id" (g/IntValue 8)})})]
    (with (g/schema {"Person" (g/object-type {"name" (g/field text) "id" (g/field (g/named "ID"))
      "friend" (g/field (g/named "Person"))})} {
      "echo" (with echo (arguments {"text" (with (g/argument text) (default-value (some (g/StringValue "default"))))}))
      "required" (with echo (arguments {"text" (g/argument (g/non-null text))}))
      "strict" (with echo (type (g/non-null text)) (arguments {"text" (g/argument (g/non-null text))}))
      "present" (with (g/resolving (g/named "Boolean")
        (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
          (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/BooleanValue (contains? args "text"))))))
        (arguments {"text" (g/argument text)}))
      "filter" (with describe (arguments {"input" (g/argument (g/named "Filter"))}))
      "empty" (with describe (arguments {"input" (g/argument (g/named "Emptyable"))}))
      "count" (g/resolving integer (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
        (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/IntValue 0)))))
      "emptyPerson" (g/resolving (g/named "Person") (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
        (do (swap! calls (fn (n: i64) (+ n 1))) (Ok g/NullValue))))
      "people" (g/resolving (g/list-of (g/named "Person")) (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
        (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/ListValue [person person g/NullValue])))))
      "requiredPeople" (g/resolving (g/list-of (g/non-null (g/named "Person")))
        (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
          (do (swap! calls (fn (n: i64) (+ n 1))) (Ok (g/ListValue [person person])))))
      "person" (g/resolving (g/named "Person") (fn (ctx: g/GqlValue args: (Map str g/GqlValue) parent: g/GqlValue)
        (do (swap! calls (fn (n: i64) (+ n 1))) (Ok person))))})
      (input-objects {"Filter" (g/input-object {
        "text" (with (g/argument text) (default-value (some (g/StringValue "base"))))
        "limit" (with (g/argument (g/non-null integer)) (default-value (some (g/IntValue 10))))
        "terms" (g/argument (g/list-of (g/non-null text))) "nested" (g/argument (g/named "Filter"))})
        "Emptyable" (g/input-object {"value" (g/argument text)})}))))
(defun member (result: g/GqlResult key: str) -> g/GqlValue
  (g/field-value (unwrap-or (. result data) g/NullValue) key))
(defun request-error? (result: g/GqlResult) -> bool
  (and (= (. result data) nil) (> (count (. result errors)) 0)))
