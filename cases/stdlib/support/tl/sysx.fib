;; tl.sysx: the helpers the cases of the sys primitives (3600 to 3649) share. Each turns a (Result t i64) into
;; one i64 to check: the value, or the negated errno of an Err.
(ns tl.sysx (:use fib.unix))

(defun num (r: (Result i64 i64)) -> i64 (match r ((Ok v) v) ((Err e) (- 0 e))))

;; The length of the bytes read, or the negated errno.
(defun nread (r: (Result (Array i8) i64)) -> i64 (match r ((Ok a) (array-len a)) ((Err e) (- 0 e))))

;; The text of the bytes read, "" at end of file, "<err>" when the read failed.
(defun text (fd: i64 n: i64) -> str
  (match (fd-read fd n) ((Ok a) (str-from-bytes a)) ((Err e) "<err>")))

(defun put (fd: i64 s: str) -> i64 (num (fd-write fd (str-bytes s))))

(defun creat (path: str) -> i64
  (num (fd-open path (bit-or O_WRONLY (bit-or O_CREAT O_TRUNC)) 420)))

(defun open-ro (path: str) -> i64 (num (fd-open path O_RDONLY 0)))
