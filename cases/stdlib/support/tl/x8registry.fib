;; tl.x8registry: a module whose `def`s are made by an init function
;; (L15, case 1705): a number from a call, and an atom that a function of
;; the module writes. The module that uses it has `def`s of its own that
;; read the number and call the function, so they need this module's
;; init functions to have run first.
(ns tl.x8registry)

(defun shifted (n: i64) -> i64 (+ n 100))

(def base: i64 (shifted 1))
(def log: (Atom (Vec i64)) (atom []))

(defun note (n: i64) -> i64
  (do (swap! log (fn (v) (conj v n))) n))

(defun noted () -> i64 (count @log))
