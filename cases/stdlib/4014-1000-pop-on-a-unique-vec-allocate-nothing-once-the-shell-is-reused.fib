;; spec:   design/in-place-update.md §6 T9 (counts), §5 L5, stdlib §2.5, §8.1 item 5 (count cases)
;; expect: accept
;; result: 99007
;; audit:  clean
;; allocs: <= 6691
;; roots:  ../../lib support
;; covers: pop
;; The program of case 4013 with the bound of L5: the shell is reused, so a pop allocates only at the leaf boundaries (every 32 pops);
;; the build (6476) and 150. OPEN for L5.
;; LANDED (L8): measured 6691, see case 4013.
(ns main (:use fib.core fib.seq fib.coll))

(defun big () -> (Vec i64) (vec (range 100000)))

;; 1000 pop on a vector that nobody else holds
(defun main () -> i64
  (let ((v (loop ((i 0) (v (big))) (if (>= i 1000) v (recur (+ i 1) (pop v))))))
    (+ (count v) (nth v 7))))
