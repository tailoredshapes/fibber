;; spec:   stdlib §4.5 row find, §2.3 (Lookup), §1.2 P5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: find
;; (find m k) is the map entry of k, a Pair of the key and its value, or nil: Clojure's (find {"a" 1 "b" 2} "a") is ["a" 1].
;; A hit is (some (Pair k v)), the key the Pair holds is the one asked for, and the entry is a Pair that key and val read; a
;; miss is nil, never a trap; the map after an assoc answers with the new value and after a dissoc with a miss; an empty
;; map misses; the map is not changed by asking.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m {"a" 1 "b" 2}))
    (do (check c (= (find m "a") (some (Pair "a" 1))))
        (check c (= (find m "b") (some (Pair "b" 2))))
        (check c (= (find m "z") nil))
        (check c (match (find m "a") ((some p) (and (= (key p) "a") (= (val p) 1))) (nil false)))
        (check c (match (find m "b") ((some p) (and (= (. p fst) "b") (= (. p snd) 2))) (nil false)))
        (check c (= (find (empty m) "a") nil))
        (check c (= (find (dissoc m "a") "a") nil))
        (check c (= (find (dissoc m "a") "b") (some (Pair "b" 2))))
        (check c (= (find (assoc m "a" 9) "a") (some (Pair "a" 9))))
        (check c (= (find (assoc m "c" 3) "c") (some (Pair "c" 3))))
        (check c (= (count m) 2))
        (checks-result c))))
