;; parse: a function that can fail returns the prelude's Result.
(ns parse)

(defun digit-at :private (s: str i: i64) -> (Result i64 str)
  (let ((b (zext i64 (str-byte-at s i))))
    (if (and (>= b 48) (<= b 57))
        (Ok (- b 48))
        (Err (str-concat "bad digit " (char->str (i32->char (trunc i32 b))))))))

(defun digits (s: str) -> (Result i64 str)
  (if (= (str-len s) 0)
      (Err "no digits")
      (loop ((i 0) (acc 0))
        (if (< i (str-len s))
            (match (digit-at s i)
              ((Ok d) (recur (+ i 1) (+ (* acc 10) d)))
              ((Err e) (Err e)))
            (Ok acc)))))

(defun double (r: (Result i64 str)) -> (Result i64 str)
  (match r ((Ok v) (Ok (* v 2))) ((Err e) (Err e))))
