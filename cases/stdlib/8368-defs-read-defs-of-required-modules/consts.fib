;; The module `main` requires: a constant, `def`s made at run time that read it, and a function that reads a `def`.
(ns consts)

(def limit: i64 50)
(def names: (Vec str) ["a" "b"])
(def doubled: i64 (* limit 2))
(defun scaled (k: i64) -> i64 (* k (count names)))
(def derived: i64 (+ doubled (scaled 1)))
