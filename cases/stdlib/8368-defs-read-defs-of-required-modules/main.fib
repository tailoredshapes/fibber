;; spec:   syntax §3.19 (def: modules in dependency order), §5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../../lib ../support
;; A `def` made at run time reads the constant and the made `def`s of a module it requires, and a function of that module that reads its own `def`s:
;; the modules are initialised in dependency order, each in source order, in `fibc run` and in an executable alike (LANG-2 item 4: the WASM-2
;; and DMN agents met `def .. is read where it has no value` for a constant read by a made `def`, in one module and across modules).
(ns main (:use tl.check) (:require [consts :as k]))

(def over: i64 (+ k/limit k/doubled))
(def via-fn: i64 (k/scaled 3))
(def names-here: (Vec str) (conj k/names (str "n" (count k/names))))
(def sum-of-all: i64 (+ over via-fn (count names-here) k/derived))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= over 150))
        (check c (= via-fn 6))
        (check c (= names-here ["a" "b" "n2"]))
        (check c (= k/derived 102))
        (check c (= sum-of-all 261))
        (checks-result c))))
