;; spec:   stdlib §7 L1, syntax §5
;; expect: reject
;; error:  scaled$2 is private to shapes; it is not exported
;; roots:  ../../../lib ../support
;; covers: defn
;; The clause of two arguments is `:private`, the one of one argument is not: the call of
;; one argument is fine, the call of two names the clause (`NAME$N`) that the module keeps to itself.
(ns main (:require [shapes :as s]))

(defn both [x: i64] -> i64 (+ (s/scaled x) (s/scaled x 3)))

(defun main () -> i64 (both 4))
