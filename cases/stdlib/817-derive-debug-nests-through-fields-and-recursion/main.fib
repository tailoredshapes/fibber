;; spec:   stdlib §2.7 (Debug of a record is the Debug of each field; a record of module m is #m.P{..}), §7 L17
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../../lib ../support
;; A record holds records: a struct whose field is a derived struct prints the
;; inner text inside its own braces; a recursive enum prints through itself (its
;; instance asks for the instance it is defining, as a derived Eq does); a Vec of
;; records, a Pair of them and an Option of one print with the library's own
;; brackets around each derived text. The types are in the module model.shapes,
;; whose name is what the text carries (`#model.shapes.Inner{..}`): the module is
;; the one the derive is expanded in, which a derive in main could not show, main
;; being the name of every other case.
(ns main (:use fib.core fib.seq fib.coll fib.print model.shapes tl.check))

(defun main () -> i64
  (let ((c (checks))
        (i (Inner 1 "x"))
        (t (Node (Node Leaf 1 Leaf) 2 Leaf)))
    (do (check c (= (debug (Outer i \z)) "#model.shapes.Outer{:i #model.shapes.Inner{:a 1, :b \"x\"}, :tag \\z}"))
        (check c (= (debug t) "#model.shapes.Node{:l #model.shapes.Node{:l Leaf, :v 1, :r Leaf}, :v 2, :r Leaf}"))
        (check c (= (debug [i i]) "[#model.shapes.Inner{:a 1, :b \"x\"} #model.shapes.Inner{:a 1, :b \"x\"}]"))
        (check c (= (debug (Pair i 3)) "[#model.shapes.Inner{:a 1, :b \"x\"} 3]"))
        (check c (= (debug (some i)) "#model.shapes.Inner{:a 1, :b \"x\"}"))
        (check c (= (debug (Cross "late")) "#model.shapes.Cross{:why \"late\"}"))
        (check c (= (to-str Calm) "Calm"))
        (checks-result c))))
