;; model.shapes: the types of case 817, in a module of a dotted name: the text a
;; derived Debug writes names this module, not main.
(ns model.shapes (:use fib.core fib.print))

(defstruct Inner (a: i64 b: str))
(derive Debug Inner)

(defstruct Outer (i: Inner tag: char))
(derive Debug Outer)

(defenum (Tree t) Leaf (Node l: (Tree t) v: t r: (Tree t)))
(derive Debug Tree)

(defenum Mood Calm (Cross why: str))
(derive Debug Mood)
(derive ToStr Mood)
