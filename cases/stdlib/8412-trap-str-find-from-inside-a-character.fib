;; spec: spec/stdlib.md section 2.9 (the byte-offset rule, LIB-2): a byte offset that splits a character traps with a clear message
;; expect: trap
;; trap: str-find: from 2 splits a character
;; roots: ../../lib support
(ns main)
(defun main () -> i64 (match (str-find "aéb" "b" 2) (nil 0) ((some i) i)))
