;; spec:   stdlib §5 M1, §7 L15, types §2.16
;; expect: reject
;; error: def c: a def may not hold a Cell or a Weak: the value has type (Cell i64); use an Atom
;; roots:  ../../lib support
;; covers: def
;; A global cell would be reachable from every task without being captured,
;; so two tasks could write it: the type of a `def` may not contain a Cell
;; (an Atom is the global mutable thing, case 907).
(def c: (Cell i64) (cell 0))

(defun main () -> i64 0)
