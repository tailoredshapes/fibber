;; spec: docs/design/os.md (read-file-bytes), spec/types.md section 2.13.1 (array-push! grows a block of 32 or more elements by doubling)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Package LIBFIX-1 (the old code): `read-file-bytes` appended to its result with `array-push!`, which copied the whole array on every push once it had 32 elements, so a file
;; of 1.6 MB took 40 s and one of 64 MiB would not finish. A 64 MiB file is written and read back: every byte must be where it was written (a wrong
;; length, a lost chunk and a swapped byte each fail), the limit is still enforced one byte below the size, and the read must take under 20 s (the
;; linear read takes well under 2 s; the quadratic one is killed by the harness's 300 s alarm). The file is removed.
(ns main (:use tl.check fib.coll) (:require [fib.os :as os]))

(defun pattern (i: i64) -> i8 (trunc i8 (bit-and (+ i (shr i 16)) 255)))

(defun filled (n: i64) -> (Array i8)
  (let [a (cell (array n 0i8))]
    (do (dotimes (i n) (array-set! &a i (pattern i))) @a)))

(defun same? (b: (Array i8) n: i64) -> bool
  (and (= (array-len b) n)
       (loop [i 0] (cond (= i n) true (= (array-get b i) (pattern i)) (recur (+ i 1)) :else false))))

(defun main () -> i64
  (let [c (checks) n 67108864 path (str "/tmp/fib-os-8100-" (os/process-id))]
    (do (check c (= (os/write-file-bytes path (filled n)) (Ok ())))
        (let [t0 (os/clock-now)
              r (os/read-file-bytes path n)
              t1 (os/clock-now)]
          (do (check c (match r ((Ok b) (same? b n)) (_ false)))
              (check c (< (- t1 t0) 20000000000))))
        (check c (match (os/read-file-bytes path (- n 1)) ((Err e) (= (. e kind) os/LimitExceeded)) (_ false)))
        (check c (= (os/remove-file path) (Ok ())))
        (checks-result c))))
