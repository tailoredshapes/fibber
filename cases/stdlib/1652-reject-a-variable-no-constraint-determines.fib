;; spec:   types §3.3 (the liberal coverage condition), stdlib §7 L16
;; expect: reject
;; error:  type variable k is not a parameter of the impl head
;; The determined argument names `k`, and the one constraint `(Cur c i64)` fixes only its own output: nothing determines `k`.
(ns main (:use fib.core))

(defprotocol (Cur s c) (cur (self) -> c))
(defstruct (Wrap k) (v: k))
(defstruct (Box c) (inner: c))
(impl (Cur (Wrap k)) (Box c) :where ((Cur c i64))
  (cur (self) (Wrap (cur (. self inner)))))

(defun main () -> i64 0)
