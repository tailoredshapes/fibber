;; spec:   stdlib §4.4 row partition-by (Eq k), §2.1 rule 8
;; expect: reject
;; error:  no implementation of Eq for (fn (i64) i64)
;; roots:  ../../lib support
;; covers: partition-by
;; partition-by compares the keys of neighbouring elements, so the key type needs Eq. A function is
;; no key (a function type has no equality), and the message names it.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (count (partition-by (fn (x: i64) (fn (y: i64) y)) [1 2])))
