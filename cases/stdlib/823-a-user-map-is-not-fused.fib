;; spec:   stdlib §2.1 rule 2 (a user's own `map` is not rewritten), tranche 1 plan R9
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map sum
;; The rule fuses a call whose head is the library's. This module defines its own `map` at top
;; level, which shadows the one `fib.seq` exports (a local definition shadows a `:use`d one,
;; syntax §5), so `(sum (map f v))` is a call of the program's function, here one that
;; ignores f and answers [100]. Had the rewrite turned the call into the recipe `Mapped`,
;; the sum would be 12.
(ns main (:use fib.core fib.seq tl.check))

(defun map (f: (fn (i64) i64) v: (Vec i64)) -> (Vec i64) [100])

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (sum (map (fn (x: i64) (* x 2)) [1 2 3])) 100))
        (check c (= (count (map (fn (x: i64) (* x 2)) [1 2 3])) 1))
        (checks-result c))))
