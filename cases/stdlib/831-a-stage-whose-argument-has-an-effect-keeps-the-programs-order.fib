;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see), tranche 1 plan R9
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map filter take sum vec count
;; A call evaluates its arguments left to right: in (map f c) the function, then the collection. A
;; recipe holds its source before its parameter, so the rewrite takes only a stage whose function or
;; count is a symbol, a literal or a `fn` form (no effect, so no order); any other argument keeps the
;; stage a lazy seq, read once by the stage above it. Each function, count and source below logs when it
;; is evaluated, and the log is the order of a program that calls the library's functions one by one:
;; outer stage first, source last, each once however many elements follow.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun note (log: (Cell (Vec i64)) n: i64) -> unit (set! log (conj @log n)))

(defun fm (log: (Cell (Vec i64)) n: i64) -> (fn (i64) i64) (do (note log n) (fn (x) (* x 2))))
(defun fp (log: (Cell (Vec i64)) n: i64) -> (fn (i64) bool) (do (note log n) (fn (x) (> x 2))))
(defun nn (log: (Cell (Vec i64)) at: i64 n: i64) -> i64 (do (note log at) n))
(defun src (log: (Cell (Vec i64)) n: i64) -> (Vec i64) (do (note log n) [1 2 3 4]))

(defun main () -> i64
  (let ((c (checks))
        (log (cell (vec-empty))))
    (do (check c (= (sum (map (fm log 1) (src log 2))) 20))
        (check c (= @log [1 2]))
        (set! log (vec-empty))
        (check c (= (vec (filter (fp log 1) (map (fm log 2) (src log 3)))) [4 6 8]))
        (check c (= @log [1 2 3]))
        (set! log (vec-empty))
        (check c (= (count (take (nn log 1 3) (src log 2))) 3))
        (check c (= @log [1 2]))
        ;; a stage with a plain function above one with an effect
        (set! log (vec-empty))
        (let ((p (fn (x: i64) (> x 2))))
          (check c (= (vec (filter p (map (fm log 1) (src log 2)))) [4 6 8])))
        (check c (= @log [1 2]))
        ;; and the effect above a plain function
        (set! log (vec-empty))
        (let ((f (fn (x: i64) (* x 2))))
          (check c (= (vec (filter (fp log 1) (map f (src log 2)))) [4 6 8])))
        (check c (= @log [1 2]))
        (checks-result c))))
