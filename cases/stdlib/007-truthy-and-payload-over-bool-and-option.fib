;; spec:   stdlib §2.3 (Truthy, Payload), §2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; A predicate's result is a bool or an Option: truthy? says whether it
;; passes and payload says what a passing Option carries (for a bool, the
;; bool). These two are what filter, some and every? will be written over.
;; (some false) is truthy here: Clojure's falsy `false` inside an Option is
;; L20's checker rule, not a library instance.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil))
    (do (check c (truthy? true))
        (check c (not (truthy? false)))
        (check c (truthy? (some 0)))
        (check c (not (truthy? none)))
        (check c (payload true))
        (check c (not (payload false)))
        (check c (= (payload (some 7)) 7))
        (check c (= (payload (some "x")) "x"))
        (checks-result c))))
