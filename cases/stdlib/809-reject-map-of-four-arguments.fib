;; spec:   stdlib §4.4 row map (the overloads by arity, L1)
;; expect: reject
;; error:  map takes 2 or 3 argument(s), got 4
;; roots:  ../../lib
;; covers: map
;; `map` has the clauses of two and three arguments; Clojure's variadic `(map f c1 c2 c3)` is not offered (the arity of a function
;; type is fixed, §1), and the error names the arities there are.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (count (map + [1] [2] [3])))
