;; spec:   stdlib §2.5 (about n/32 allocations instead of 2.09 per element), §8.1 item 5 (count cases)
;; expect: accept
;; result: 10240
;; audit:  clean
;; allocs: <= 704
;; roots:  ../../lib support
;; covers: vec
;; Case 490 with ten times the elements and the same shape of bound, n/16 + 64 = 704. The count is 678: the
;; builder's cost grows with the number of leaves, not the number of elements, and the conj loop that was the default
;; allocated 22,014 here (2.15 an element, measured with the compiler built before the builder). Loose by design (`bound-`): see 490.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (vec (array 10240 0))))
    (count v)))
