;; spec:   types §2.17 (the gpu builtins: atomics, select), lir §6.6; docs/design/gpu.md 12
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib
;; `gpu/atomic-add-i64 p v` answers the old 64-bit value and leaves the sum; `gpu/select c a b` computes both operands and answers `a` where `c` holds. On the host, one thread.
(ns main (:require [fib.gpu :as gpu]))
(defun main () -> i64
  (let [buf (cell (array 2 0i64)) p (unsafe (ptr+ (raw @buf) 24))]
    (unsafe
      (do (array-set! &buf 0 4294967296i64)
          (let [old (gpu/atomic-add-i64 p 5i64)
                s1 (gpu/select true 7i32 9i32)
                s2 (gpu/select false 7i32 9i32)]
            (+ (if (= old 4294967296i64) 0 1)
               (if (= (array-get @buf 0) 4294967301i64) 0 2)
               (if (and (= s1 7i32) (= s2 9i32)) 0 4)))))))
