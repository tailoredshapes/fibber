;; spec:   stdlib §2.9 (nth of a str), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; A negative index is out of range for nth, not counted from the end. The
;; call at index 0 is made first.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (zext i64 (char->i32 (nth s 0)))
       (zext i64 (char->i32 (nth s (- 0 1)))))))
