        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* 2i8 -2i8)))
        (check c (= (lane r 1) (* 1i8 -6i8)))
        (check c (= (lane r 2) (* 0i8 9i8)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg 2i8)))
        (check c (= (lane r 1) (neg 1i8)))
        (check c (= (lane r 2) (neg 0i8)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ 2i8 2i8)))
        (check c (= (lane r 1) (+ 1i8 2i8)))
        (check c (= (lane r 2) (+ 0i8 2i8)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7i8 2i8)))
        (check c (= (lane r 1) (- 7i8 1i8)))
        (check c (= (lane r 2) (- 7i8 0i8)))
        ()))
        ())))

