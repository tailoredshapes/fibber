(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: i8x3 <<2 1 0>>i8) (b: i8x3 <<-2 -6 9>>i8))
    (do (check p (= (lane (+ a b) 1) (- 1i8 -6i8)))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (arith-i8-1 c)
        (arith-i8-3 c)
        (arith-i8-16 c)
        (arith-i8-32 c)
        (arith-i8-64 c)
        (planted c)
        (checks-result c))))
