;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; Every lane of + - * and neg on i8 vectors of [1, 3, 16, 32, 64] lane counts, and a scalar literal operand in both orders, equals the scalar operation written in the case on the same lane values; lane counts that are not a power of two included. The values keep every result in range, so no check fires (the overflow traps are cases 622x); `planted` compares + against a reference that subtracts and must see it fail.
(ns main (:use fib.core tl.check))

(defun arith-i8-1 (c: Checks) -> unit
  (let ((a: i8x1 <<2>>i8) (b: i8x1 <<-2>>i8))
    (do (let ((r (+ a b)))
      (do
        (check c (= (lane r 0) (+ 2i8 -2i8)))
        ()))
        (let ((r (- a b)))
      (do
        (check c (= (lane r 0) (- 2i8 -2i8)))
        ()))
        (let ((r (* a b)))
      (do
        (check c (= (lane r 0) (* 2i8 -2i8)))
        ()))
        (let ((r (neg a)))
      (do
        (check c (= (lane r 0) (neg 2i8)))
        ()))
        (let ((r (+ a 2)))
      (do
        (check c (= (lane r 0) (+ 2i8 2i8)))
        ()))
        (let ((r (- 7 a)))
      (do
        (check c (= (lane r 0) (- 7i8 2i8)))
        ()))
        ())))

(defun arith-i8-3 (c: Checks) -> unit
  (let ((a: i8x3 <<2 1 0>>i8) (b: i8x3 <<-2 -6 9>>i8))
    (do (let ((r (+ a b)))
