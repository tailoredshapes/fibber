;; spec:   stdlib §4.1 (row +: the builtin is binary, overflow traps), §6.3 (R6a)
;; expect: trap
;; trap:   integer overflow in + at i64
;; roots:  ../../lib support
;; covers: +
;; (+ a b c) is (+ (+ a b) c): the fold is from the left and each sum is the
;; builtin's, so the first sum that leaves i64 traps even when the last
;; argument would bring the total back (decided in the R6a header; Clojure's
;; (+ Long/MAX_VALUE 1 -1) throws too, at the first addition).
(ns main (:use fib.core))

(defun main () -> i64
  (+ 9223372036854775807 1 -1))
