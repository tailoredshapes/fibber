;; spec:   stdlib §4.1 (row bit-and), types §2.12 (Bits)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bit-and
;; The builtin bit-and over two integers of one type keeps the bits set in both: a mask picks bits,
;; -1 (all ones) is its identity and 0 its zero, a number against its own complement is 0, and it
;; works at every width. (More than two arguments is the macro of R6a.)
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (bit-and 12 10) 8))
        (check c (= (bit-and 255 -2) 254))
        (check c (= (bit-and 1023 1000) 1000))
        (check c (= (bit-and -1 12345) 12345))
        (check c (= (bit-and 12345 -1) 12345))
        (check c (= (bit-and 0 12345) 0))
        (check c (= (bit-and 12345 0) 0))
        (check c (= (bit-and 12345 12345) 12345))
        (check c (= (bit-and 12345 (bit-not 12345)) 0))
        (check c (= (bit-and -9223372036854775808 9223372036854775807) 0))
        (check c (= (bit-and -9223372036854775808 -1) -9223372036854775808))
        (check c (= (bit-and -1i8 127i8) 127i8))
        (check c (= (bit-and 15i8 60i8) 12i8))
        (check c (= (bit-and -1i16 255i16) 255i16))
        (check c (= (bit-and -1i32 65535i32) 65535i32))
        (check c (= (bit-and 6 3) 2))
        (checks-result c))))
