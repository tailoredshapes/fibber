;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/gpu ../../examples/webgpu
;; webgpu-target = reject | i8
;; A buffer holds 32-bit words -- a load of a byte has no WGSL form and is refused naming the type.
;; The host builds and runs this program (nothing calls the kernel); compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [gpu :as gpu] [gpu32 :as g]))
(gpu/defkernel k (a: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n) (g/i32-set! a i (sext i32 (unsafe (load-i8 (ptr+ a (sext i64 i)))))))))
(defun main () -> i64 0)
