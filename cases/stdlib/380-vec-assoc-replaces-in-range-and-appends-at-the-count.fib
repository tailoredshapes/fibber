;; spec:   stdlib §2.3 (Assoc), §4.5 (assoc), Appendix A11 e6
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: assoc
;; assoc on a Vec takes an index: below the count it replaces the element,
;; at the count it appends (Clojure's (assoc v (count v) x)), and the Vec it
;; was given is not changed. The trie's own boundaries are the sizes 31, 32,
;; 33, 64, 65 and 100: the tail is full at 32, and the first leaf moves into
;; the trie at 33. Each size is checked at the first, a middle and the last
;; index and at the count, against a model that never calls assoc: the Vec
;; 0 3 6 .. with one element replaced, or one more at the end. Elements that
;; are not scalars (a str, a Vec) go through the same instance.
(ns main (:use fib.core fib.seq fib.coll tl.check))

;; the Vec 0 3 6 .. 3(n-1)
(defun triples (n: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i n) (recur (+ i 1) (conj acc (* 3 i))) acc)))

;; whether v is that Vec with x at index at, one longer when at is the count
(defun is-triples-with (v: (Vec i64) n: i64 at: i64 x: i64) -> bool
  (let ((len (if (= at n) (+ n 1) n)))
    (and (= (count v) len)
         (loop ((i 0))
           (if (< i len)
               (if (= (nth v i) (if (= i at) x (* 3 i))) (recur (+ i 1)) false)
               true)))))

;; assoc at each of the four places of a Vec of n elements
(defun all-places (n: i64) -> bool
  (let ((v (triples n)))
    (and (is-triples-with (assoc v 0 -1) n 0 -1)
         (and (is-triples-with (assoc v (quot n 2) -2) n (quot n 2) -2)
              (and (is-triples-with (assoc v (- n 1) -3) n (- n 1) -3)
                   (and (is-triples-with (assoc v n -4) n n -4)
                        (is-triples-with v n -1 0)))))))

(defun main () -> i64
  (let ((c (checks))
        (names ["a" "b" "c"])
        (rows [[1] [2]]))
    (do (check c (is-triples-with (assoc (triples 1) 0 -1) 1 0 -1))
        (check c (is-triples-with (assoc (triples 1) 1 -4) 1 1 -4))
        (check c (is-triples-with (assoc (vec-empty) 0 -4) 0 0 -4))
        (check c (all-places 2))
        (check c (all-places 5))
        (check c (all-places 31))
        (check c (all-places 32))
        (check c (all-places 33))
        (check c (all-places 64))
        (check c (all-places 65))
        (check c (all-places 100))
        (check c (= (nth (assoc (assoc (assoc (vec-empty) 0 1) 1 2) 0 5) 0) 5))
        (check c (= (count (assoc (assoc (assoc (vec-empty) 0 1) 1 2) 0 5)) 2))
        (check c (= (nth (assoc names 1 "z") 1) "z"))
        (check c (= (nth (assoc names 1 "z") 2) "c"))
        (check c (= (nth names 1) "b"))
        (check c (= (count (assoc names 3 "d")) 4))
        (check c (let ((w (assoc rows 0 [9 8])))
                   (and (= (count (nth w 0)) 2) (= (nth (nth w 0) 1) 8))))
        (check c (let ((w (assoc rows 1 [7])))
                   (and (= (count (nth w 0)) 1) (= (nth (nth w 0) 0) 1))))
        (checks-result c))))
