;; spec:   stdlib §4.3 (rows Long/MAX_VALUE and Long/MIN_VALUE), §2.8 (A11 e19), §3 N12
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: Long/MAX_VALUE Long/MIN_VALUE
;; The module Long is required under its own name, as Clojure's text writes the class, and its two
;; constants are the ends of the i64 range: the largest value (2^63 - 1), the smallest (-2^63), one
;; the negation of the other plus one, and each the value that the bit operations say they are.
(ns main (:use fib.core tl.check) (:require [Long :as Long]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= Long/MAX_VALUE 9223372036854775807))
        (check c (= Long/MIN_VALUE -9223372036854775808))
        (check c (< Long/MIN_VALUE Long/MAX_VALUE))
        (check c (= (+ Long/MIN_VALUE 1) (neg Long/MAX_VALUE)))
        (check c (= (- Long/MAX_VALUE 1) 9223372036854775806))
        (check c (= (quot Long/MAX_VALUE 2) 4611686018427387903))
        (check c (= (quot Long/MIN_VALUE 2) -4611686018427387904))
        (check c (= (bit-shift-left 1 63) Long/MIN_VALUE))
        (check c (= (unsigned-bit-shift-right -1 1) Long/MAX_VALUE))
        (check c (= (bit-not Long/MAX_VALUE) Long/MIN_VALUE))
        (check c (= (bit-not Long/MIN_VALUE) Long/MAX_VALUE))
        (check c (= (bit-xor Long/MAX_VALUE Long/MIN_VALUE) -1))
        (check c (= (bit-and Long/MAX_VALUE Long/MIN_VALUE) 0))
        (check c (= (f64->bits (sitofp f64 Long/MIN_VALUE)) -4332462841530417152))
        (checks-result c))))
