;; spec:   stdlib §1.2 P5, §4.4 row pop, tranche 1 plan §4.3 rule 8, task P1 item 2
;; expect: trap
;; trap:   pop: empty
;; roots:  ../../lib support
;; covers: pop
;; pop of a Vec with nothing in it traps, the message naming the function (Clojure's throws). The vector is one that
;; had elements: 33 pops take it down to nothing, and the 34th traps, so the empty vector a pop answers is the one pop
;; refuses, not only the literal one.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (loop ((v (vec (range 33))) (n 0))
    (if (< n 34) (recur (pop v) (+ n 1)) (count v))))
