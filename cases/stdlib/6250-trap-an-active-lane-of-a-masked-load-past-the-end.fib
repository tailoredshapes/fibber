;; spec:   types §1.9 (masked loads), docs/design/simd-and-tensors.md 2.7
;; expect: trap
;; trap:   simd-load-masked: an active lane is out of range of the array
;; stage:  2
;; roots:  ../../lib support
;; The mask of the load at index 8 of a 10-element array is true in lane 2, which is element 10: the load traps (lanes 0 and 1 alone would not).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (array 10 1i32)) (m: (Simd bool 4) <<true false true false>>) (p: i32x4 <<0 0 0 0>>i32))
    (let ((v: i32x4 (simd-load-masked a 8 m p)))
      (do (println (hsum v)) 0))))
