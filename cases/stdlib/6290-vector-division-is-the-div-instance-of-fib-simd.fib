(defun planted (c: Checks) -> unit
  (let ((p (checks)) (a: f64x2 <<1.0 2.0>>f64))
    (do (check p (= (lane (/ a <<2.0 2.0>>f64) 1) 2.0))
        (check-detects c p))))

(defun main () -> i64
  (let ((c (checks)))
    (do (div-f32-1 c)
        (div-f32-2 c)
        (div-f32-3 c)
        (div-f32-4 c)
        (div-f32-5 c)
        (div-f32-8 c)
        (div-f32-16 c)
        (div-f64-1 c)
        (div-f64-2 c)
        (div-f64-3 c)
        (div-f64-4 c)
        (div-f64-5 c)
        (div-f64-8 c)
        (planted c)
        (checks-result c))))
