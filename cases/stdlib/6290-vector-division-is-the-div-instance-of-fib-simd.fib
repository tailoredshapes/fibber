;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; With (:use fib.simd) `/` divides float vectors lanewise (fdiv): equal to the scalar `/` on the same lane values, with a literal on either side. The instance is in lib/fib/simd.fib, not in fib.core: the Rust tools that read the core library do not know the vector type.
(ns main (:use fib.core fib.simd tl.check))

(defun div-f32-1 (c: Checks) -> unit
  (let ((a: f32x1 <<-3.75>>f32) (b: f32x1 <<0.5>>f32))
    (do (let ((r (/ a b)))
      (do
        (check c (= (lane r 0) (/ -3.75f32 0.5f32)))
        ()))
        (let ((r (/ a 4.0)))
      (do
        (check c (= (lane r 0) (/ -3.75f32 4.0f32)))
        ()))
        (let ((r (/ 8.0 b)))
      (do
        (check c (= (lane r 0) (/ 8.0f32 0.5f32)))
        ()))
        ())))

