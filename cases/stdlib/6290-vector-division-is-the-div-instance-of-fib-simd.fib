      (do
        (check c (= (lane r 0) (/ -3.75f32 0.5f32)))
        (check c (= (lane r 1) (/ 0.0f32 3.0f32)))
        ()))
        (let ((r (/ a 4.0)))
      (do
        (check c (= (lane r 0) (/ -3.75f32 4.0f32)))
        (check c (= (lane r 1) (/ 0.0f32 4.0f32)))
        ()))
        (let ((r (/ 8.0 b)))
      (do
        (check c (= (lane r 0) (/ 8.0f32 0.5f32)))
        (check c (= (lane r 1) (/ 8.0f32 3.0f32)))
        ()))
        ())))

