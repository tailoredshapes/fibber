;; spec:   stdlib §4.3 (row int), §2.8 (conversions are checked)
;; expect: trap
;; trap:   int: value out of range
;; roots:  ../../lib support
;; covers: int clojure.math/to-int-exact
;; The first i64 above an i32: 2147483647 is an int (case 2853), 2147483648 is not. This is
;; `clojure.math/to-int-exact`: the checked narrowing of an i64 is `(int x)`.
(defun main () -> i64 (sext i64 (int 2147483648)))
