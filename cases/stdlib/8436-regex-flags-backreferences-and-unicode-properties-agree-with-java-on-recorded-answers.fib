;; spec: spec/stdlib.md section 4.21 (fib.regex: inline flags, backreferences, \\p{..}); package LIB-2 item 6
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; covers: fib.regex inline-flags backreferences fib.regex.unicode
;; Each line of the table is `MODE HEX(pattern) HEX(input)|ANSWER`: MODE f is find, m is matches; the answer is what java.util.regex (Java 25, Unicode 16.0) printed for the pair, recorded by
;; scripts/regex-diff/Ref.java from the generator scripts/regex-diff/gen.py (seed 21, `--unicode`): `ERR` when Java refuses the pattern, `NO` for no match, else the code point index of the start of the match
;; and the hex of each group (`=` empty, `-` no part). The lines chosen are those whose pattern has a flag group, a backreference, `\\p` or `\\x{..}`: 96 of them agree with Java here, among them matches,
;; non-matches and refusals. The whole differential (7 runs of the generator, about 124000 lines, 0 disagreements after the two generator exclusions listed in spec 4.21) is `scripts/regex-diff/run.sh`; it needs a JDK, so it is not a case of the gate.
(ns main (:use fib.core fib.seq fib.coll fib.print) (:require [fib.regex :as re] [fib.regex.unicode :as ru] [fib.string :as s]))

(defun unhex (h: str) -> str
  (if (= h "-")
      ""
      (let [n (quot (str-len h) 2)
            c (cell (array (max n 1) 0i8))]
        (do (dotimes (i n)
              (let [hi (hexv (str-byte-at h (* 2 i)))
                    lo (hexv (str-byte-at h (+ (* 2 i) 1)))]
                (array-set! &c i (trunc i8 (+ (* hi 16) lo)))))
            (str-from-bytes (array-copy @c 0 n))))))

(defun hexv (b: i8) -> i64 (let [c (zext i64 b)] (if (< c 58) (- c 48) (- c 87))))

(defun hex-of (t: str) -> str
  (if (= (str-len t) 0)
      "="
      (str-join (mapv (fn (i: i64) (let [b (zext i64 (str-byte-at t i))] (str (str-slice "0123456789abcdef" (shr b 4) (+ (shr b 4) 1)) (str-slice "0123456789abcdef" (bit-and b 15) (+ (bit-and b 15) 1)))))
                      (range (str-len t))))))

(defun answer (m: (Option re/Match) text: str) -> str
  (match m
    (nil "NO")
    ((some x) (str (count (str-chars (str-slice text 0 (. x start))))
                   (str-join (mapv (fn (g: (Option str)) (match g (nil " -") ((some t) (str " " (hex-of t))))) (vec (concat [(some (. x whole))] (. x groups)))))))))

(defun run-line (line: str) -> str
  (let [f (s/split line " ")
        pat (unhex (nth f 1))
        text (unhex (nth f 2))]
    (match (ru/try-re-pattern pat)
      ((Err _) "ERR")
      ((Ok rx)
       (match (if (= (nth f 0) "f") (re/try-re-find rx text) (re/try-re-matches rx text))
         ((Err _) "BUDGET")
         ((Ok m) (answer m text)))))))


