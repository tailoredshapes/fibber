   "f 285c787b34317d7b30283f69292c337df09f988028f09f988028622e5b5e5c707b4c757d5d4129297b327d295b5c772d5d3f5b5e5c645c6e5d7b302c337d 2d332d43307841|ERR"])

(defun main () -> i64
  (let [bad (cell 0)
        n (cell 0)]
    (do (doseq [row (table)]
          (let [at (unwrap (str-find row "|" 0))
                line (str-slice row 0 at)
                want (str-slice row (+ at 1) (str-len row))
                got (run-line line)]
            (do (set! n (+ @n 1))
                (if (or (= got want) (= got "BUDGET")) () (do (set! bad (+ @bad 1)) (println (str "DISAGREE " line " java " want " fib " got)))))))
        (if (and (= @bad 0) (> @n 50)) 0 (+ 1 @bad)))))
