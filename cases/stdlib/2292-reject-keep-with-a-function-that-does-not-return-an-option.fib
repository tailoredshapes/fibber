;; spec:   stdlib §4.4 row keep (f returns an Option; nils are dropped, somes unwrapped)
;; expect: reject
;; error:  cannot unify (fn (i64) i64) with (fn (i64) (Option a))
;; roots:  ../../lib support
;; covers: keep
;; keep is not filter: its function gives an (Option b), and a function that gives a plain integer
;; (here x * 2, which Clojure would test for nil) is refused, with both function types named.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (count (keep (fn (x: i64) (* x 2)) [1 2])))
