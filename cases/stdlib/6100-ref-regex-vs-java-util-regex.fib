;; the first line that differs, as a string; "" when none does
(defun first-diff (lines: (Vec str)) -> str
  (loop [i 0]
    (if (< i (count lines))
        (let [r (check-record (nth lines i))]
          (if (= (str-len r) 0) (recur (+ i 1)) r))
        "")))

(defun has-match? (line: str) -> bool
  (let [f (str/split line "¦" -1)]
    (and (= (count f) 7) (!= (nth f 3) "F"))))

;; the record with an extra match in its F field
(defun planted (line: str) -> str
  (let [f (str/split line "¦" -1)]
    (str/join "¦" [(nth f 0) (nth f 1) (nth f 2) (str (nth f 3) "0-0;") (nth f 4) (nth f 5) (nth f 6)])))

(defun main () -> i64
  (let [c (checks)
        lines (vec (filter (fn (l: str) (> (str-len l) 0)) (str/split data "\n")))
        matching (vec (filter has-match? lines))]
    (do (check c (= (first-diff lines) ""))
        (check c (= (count lines) 3000))
        (check c (>= (* 10 (count matching)) (* 6 (count lines))))
        (check c (= (count (filter (fn (l: str) (!= (str-len (check-record (planted l))) 0)) matching)) (count matching)))
        (checks-result c))))
