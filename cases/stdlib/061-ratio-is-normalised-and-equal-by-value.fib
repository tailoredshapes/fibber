;; spec:   stdlib §2.8 ((Ratio t): normalised), §4.3 (rows Ratio, numerator, denominator)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: / Ratio numerator denominator
;; Every ratio `/` makes is in lowest terms with a positive denominator,
;; and zero is 0/1, so structural equality of the two fields is equality by
;; value: (/ 2 4) and (/ 1 2) are one number (the page's [true true true]
;; for = and the hashes is case 073). The sign is carried by the numerator
;; whichever operand was negative. The constructor itself is the library's:
;; a ratio written (Ratio n d) is as normal as the caller makes it, and the
;; case only reads one back to show the fields are n and d.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (/ 2 4) (/ 1 2)))
        (check c (= (/ 3 6) (/ 1 2)))
        (check c (= (/ -2 -4) (/ 1 2)))
        (check c (= (/ 2 -4) (/ -1 2)))
        (check c (!= (/ 1 2) (/ 1 3)))
        (check c (!= (/ 1 2) (/ -1 2)))
        (check c (= (numerator (/ -2 -4)) 1))
        (check c (= (denominator (/ -2 -4)) 2))
        (check c (= (numerator (/ 2 -4)) -1))
        (check c (= (denominator (/ 2 -4)) 2))
        (check c (= (numerator (/ 12 -18)) -2))
        (check c (= (denominator (/ 12 -18)) 3))
        (check c (= (numerator (/ 0 5)) 0))
        (check c (= (denominator (/ 0 5)) 1))
        (check c (= (numerator (/ 0 -5)) 0))
        (check c (= (denominator (/ 0 -5)) 1))
        (check c (= (numerator (/ 9223372036854775807 9223372036854775807)) 1))
        (check c (= (denominator (/ 9223372036854775807 9223372036854775807)) 1))
        (check c (= (/ 0 7) (/ 0 -3)))
        (check c (= (Ratio 1 2) (/ 1 2)))
        (check c (= (. (Ratio 3 4) n) 3))
        (check c (= (. (Ratio 3 4) d) 4))
        (checks-result c))))
