;; spec:   docs/design/webgpu.md 3.7 (atomics)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/webgpu
;; webgpu-target = accept | array<atomic<u32>>
;; An i32 atomic add makes the module's storage buffers `array<atomic<u32>>` (every access to them is atomicLoad/atomicStore) and the helper `fibw_atomic_add` switch
;; on the buffer; compiler/tests/native/gpu-device.sh runs the result on a device. The host builds and runs this program.
(ns main (:require [fib.gpu :as gpu] [gpu32 :as g]))
(defkernel k (a: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n) (gpu/i32-add! a 0i32 (g/i32-at a i)))))
(defun main () -> i64 0)
