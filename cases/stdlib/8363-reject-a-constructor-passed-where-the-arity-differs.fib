;; spec:   syntax §3.9a (a constructor as a value), types §2.2
;; expect: reject
;; error:  cannot unify (fn (i64 i64) Shape) with (fn (a) b)
;; roots:  ../../lib support
;; A constructor passed as a value has the arity of its fields: `Rect` takes two, `mapv` calls its function with one, and the error is the plain
;; mismatch of the two function types, at the argument.
(ns main)

(defenum Shape (Circle r: i64) (Rect w: i64 h: i64))

(defun main () -> i64
  (count (mapv Rect [1 2 3])))
