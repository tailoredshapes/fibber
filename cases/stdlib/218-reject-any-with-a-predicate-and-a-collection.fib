;; spec:   stdlib §4.4 (row any?: "the first version made (any? p c) the quantifier, which silently changes a ported program")
;; expect: reject
;; error:  any? takes 1 argument(s), got 2
;; roots:  ../../lib support
;; covers: any?
;; A program ported from Clojure that writes (any? even? xs) meaning "is
;; there an even element" must not compile and quietly answer true: any? has
;; one parameter, so the call is refused at the checker with the function's name.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (if (any? (fn (x) (> x 1)) [1 2 3]) 1 0))
