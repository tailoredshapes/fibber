;; spec:   stdlib §4.5 (rows conj set), §2.3 (Collection)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: conj set
;; A Set is the prelude's struct over a (Map k bool), and the library's
;; (conj s x) must leave it as the prelude's own conj does: every element
;; maps to true (the Set struct has no other value to hold, and the
;; prelude's own functions and a later change of the representation count
;; on it). The public protocols never read the bool, so this case reads
;; the field.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun is-true (o: (Option bool)) -> bool (match o (nil false) ((some b) b)))

(defun main () -> i64
  (let ((c (checks))
        (s (conj (conj (empty (set [0])) 4) 5))
        (t (set [7 8 7])))
    (do (check c (is-true (get (. s m) 4)))
        (check c (is-true (get (. s m) 5)))
        (check c (= (count (. s m)) 2))
        (check c (is-true (get (. t m) 7)))
        (check c (is-true (get (. t m) 8)))
        (check c (= (count (. t m)) 2))
        (checks-result c))))
