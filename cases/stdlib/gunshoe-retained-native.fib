;; spec: docs/design/gunshoe.md; explicit caller unsafe boundary
;; expect: accept
;; result: 42
;; audit: clean
;; stage: 2
;; roots: ../../lib

(ns main (:require [fib.gunshoe :as g]))
(defun main () -> i64
  (let [a (array 2 7)
        same (unsafe (let [p (g/retain-address a) q (g/borrow-address a)]
                       (let [equal (= (g/address->i64 p) (g/address->i64 q))]
                         (do (g/release-address! p) equal))))]
    (if (and same (= (array-get a 0) 7) (= (array-len a) 2)) 42 1)))
