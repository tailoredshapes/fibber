;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g]))
(defun main () -> i64
  (let [c (checks) person (g/object {"id" (g/IntValue 7) "name" (g/StringValue "Ada") "secret" (g/StringValue "hidden")})
        definition (g/schema {"Person" (g/object-type {"id" (g/field (g/non-null (g/named "ID"))) "name" (g/field (g/named "String"))})}
          {"people" (g/resolving (g/list-of (g/named "Person"))
            (fn (context: g/GqlValue arguments: (Map str g/GqlValue) parent: g/GqlValue) (Ok (g/ListValue [person]))))})]
    (do (match (g/compile-schema definition)
      ((Err _) (check c false))
      ((Ok compiled) (let [result (g/execute compiled "query People { team: people { name id __typename } }" {} g/NullValue)]
        (do (check c (= (. result errors) []))
          (check c (= (g/result-json result) "{\"data\":{\"team\":[{\"name\":\"Ada\",\"id\":\"7\",\"__typename\":\"Person\"}]}}"))))))
      (checks-result c))))
