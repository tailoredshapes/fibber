;; spec:   stdlib §2.3 (A11 some: `(some 20)`), §2.4 (`(some #(get m %) ks)` the first non-nil value), tranche 2 plan Y4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; (some-p (fn (x) (get m x)) [1 2 3]) is the page's `(some 20)`: the predicate answers an Option, nil
;; is a miss and a value is a hit, and the answer is the payload of the first hit, here the value
;; the map holds, even a stored 0 (a `some` is truthy: only nil is a miss). Over keys that all miss it
;; is nil.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m (assoc (assoc (assoc (map-empty) 2 20) 3 30) 4 0)))
    (do (check c (match (some-p (fn (x) (get m x)) [1 2 3]) (nil false) ((some v) (= v 20))))
        (check c (match (some-p (fn (x) (get m x)) [3 2]) (nil false) ((some v) (= v 30))))
        (check c (match (some-p (fn (x) (get m x)) [1 4 2]) (nil false) ((some v) (= v 0))))
        (check c (nil? (some-p (fn (x) (get m x)) [1 5 6])))
        (check c (match (some-p (fn (x) (get m x)) (list 7 3)) (nil false) ((some v) (= v 30))))
        (check c (match (some-p (fn (x) (get m x)) (Range 1 10 1)) (nil false) ((some v) (= v 20))))
        (check c (match (some-p (fn (k) (get m (+ k 1))) (map inc [1 2 3])) (nil false) ((some v) (= v 30))))
        (checks-result c))))
