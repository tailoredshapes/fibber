;; spec:   syntax §3.15 (extern, the option :lib), docs/design/static-linking.md 3
;; expect: reject
;; error:  extern option :lib takes a library name, a string
;; stage:  2
;; roots:  ../../lib support
;; An empty library name, and a `:lib` that ends the form, are refused as a non-string is: a link declaration that names nothing would link nothing and say so nowhere.
(ns main (:use fib.core))

(extern cbrt (f64) -> f64 :lib "")

(defun main () -> i64 0)
