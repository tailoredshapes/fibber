;; spec:   stdlib §4.3 (row byte), §2.8 (conversions are checked)
;; expect: trap
;; trap:   byte: value out of range
;; roots:  ../../lib support
;; covers: byte
;; Unlike `int` and `long` (case 2892), `byte` of a NaN traps, as Clojure's (byte ##NaN) throws.
(defun main () -> i64 (sext i64 (byte (/ 0.0 0.0))))
