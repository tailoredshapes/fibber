;; spec:   stdlib §2.3 (Div), §2.8, §7 L30
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; Div is the protocol of `/`: the instance determines the result type, so
;; a user type with an exact quotient gets `/` as Clojure's does, and the
;; builtin `/` is shadowed in every module that :uses fib.core (case 018).
;; Q is a fraction n/d; dividing by it multiplies by its inverse. The
;; result type is the instance's, which is what the Ratio of L1 relies on.
(ns main (:use fib.core tl.check))

(defstruct Q (n: i64 d: i64))

(impl (Div Q) Q
  (/ (self y) (Q (* (. self n) (. y d)) (* (. self d) (. y n)))))

(defun main () -> i64
  (let ((c (checks))
        (r (/ (Q 1 2) (Q 3 4)))
        (s (/ (/ (Q 1 2) (Q 3 4)) (Q 2 1))))
    (do (check c (= (. r n) 4))
        (check c (= (. r d) 6))
        (check c (= (. s n) 4))
        (check c (= (. s d) 12))
        (checks-result c))))
