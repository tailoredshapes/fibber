;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:10:23: kernel k: recursion: fact is on the path k -> fact -> fact (a kernel's call graph is acyclic) (reached through k -> fact)
;; A function a kernel reaches is checked under the kernel's rules; one that calls itself is a recursion, refused at the recursive call with the path.
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (when (< i n) (gpu/f32-set! a i (sitofp f32 (fact i))))))
(defun fact (n: i64) -> i64
  (if (<= n 1) 1 (* n (fact (- n 1)))))
(defun main () -> i64 0)
