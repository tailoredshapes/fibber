;; spec:   stdlib §4.3 (row inc: traps on overflow), §2.8 (overflow traps at every width)
;; expect: trap
;; trap:   integer overflow in + at i8
;; roots:  ../../lib
;; covers: inc
;; inc is the builtin + with a one, so the trap is the builtin's and names
;; the width: 127i8 plus one does not fit an i8. (The i64 and the other
;; widths are the same code; the page's rule is Clojure's own, `inc`
;; throws on a long overflow.)
(ns main (:use fib.core))

(defun main () -> i64
  (let ((x (inc 127i8)))
    (if (= x 0i8) 1 2)))
