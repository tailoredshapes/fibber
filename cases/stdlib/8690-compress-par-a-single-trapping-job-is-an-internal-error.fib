;; spec: docs/design/compress.md
;; expect: accept
;; result: 0
;; audit: abandoned
;; leaks: 14
;; stage: 2
;; roots: ../../lib support
;; fib.compress.par/run-jobs: a worker that traps is an :internal error and the process lives. Both jobs trap, so each trapped task abandons the same objects whatever the scheduling (8503 had one trapping job among several running ones: its count depended on which were in flight).
(ns main (:use tl.check) (:require [fib.compress.types :as t] [fib.compress.par :as p]))
(defun main () -> i64
  (let [c (checks)]
    (do (dotimes (i 2)
          (let [w (nth [2 7] i)]
            (check c (match (p/run-jobs w 2 (fn (j: i64) (trap "boom"))) ((Err e) (= (. e kind) :internal)) ((Ok _) false)))))
        (checks-result c))))
