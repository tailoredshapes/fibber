;; spec:   stdlib §4.3 (row char), §2.3 (ToChar), §2.8 (conversions are checked)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: char
;; `(char n)` over an i32 and over an i64: the values at both ends of each
;; gap of the Unicode scalar range come back as the character with that code
;; point (read back through the builtin `char->i32`, and against character
;; literals that share nothing with the conversion): 0, the last scalar below
;; the surrogates, the first above them, the last scalar of all, an astral
;; one. `(char (int c))` is `c`, which is Clojure's text for a round trip.
(ns main (:use tl.check))

(defun code (c: char) -> i64 (sext i64 (char->i32 c)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (code (char 0)) 0))
        (check c (= (code (char 55295)) 55295))
        (check c (= (code (char 57344)) 57344))
        (check c (= (code (char 1114111)) 1114111))
        (check c (= (code (char 0i32)) 0))
        (check c (= (code (char 55295i32)) 55295))
        (check c (= (code (char 57344i32)) 57344))
        (check c (= (code (char 1114111i32)) 1114111))
        (check c (= (char 65) \A))
        (check c (= (char 65i32) \A))
        (check c (= (char 233) \é))
        (check c (= (char 128512) \😀))
        (check c (= (char 128512i32) \😀))
        (check c (= (char (int \z)) \z))
        (check c (= (char (int \😀)) \😀))
        (check c (= (char (long \é)) \é))
        (checks-result c))))
