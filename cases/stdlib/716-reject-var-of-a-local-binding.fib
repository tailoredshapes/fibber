;; spec:   stdlib §4.2 (row var), syntax §3.20
;; expect: reject
;; error:  var: no definition named total
;; covers: var
;; (var x) names a top-level definition: a local binding of the name is
;; not one, so `total`, which is bound by this `let` and defined nowhere
;; at the top level, is the error `var: no definition named total`, where
;; the plain symbol would have found the local.
(defun main () -> i64
  (let ((total 5))
    (+ total (var total))))
