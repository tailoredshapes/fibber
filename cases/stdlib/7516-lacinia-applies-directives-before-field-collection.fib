;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (do
        (check c (= (g/result-json (g/execute schema "{ count @skip(if: true) count @include(if: true) }" {} g/NullValue)) "{\"data\":{\"count\":0}}"))
        (check c (= @calls 1))
        (doseq [query ["{ count @skip(if: true) @include(if: true) }" "{ ... @include(if: false) { count } }"
          "{ ...A @skip(if: true) } fragment A on Query { count }"
          "query($show: Boolean = false) { ...A } fragment A on Query { count @include(if: $show) }"]]
          (check c (= (g/result-json (g/execute schema query {} g/NullValue)) "{\"data\":{}}")))
        (check c (= @calls 1))))) (checks-result c))))
