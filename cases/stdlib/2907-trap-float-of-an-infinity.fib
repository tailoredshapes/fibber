;; spec:   stdlib §4.3 (row float), §2.8 (conversions are checked)
;; expect: trap
;; trap:   float: value out of range
;; roots:  ../../lib support
;; covers: float
;; An infinity is beyond the greatest f32 (a NaN is not: case 2855).
(defun main () -> i64 (fptosi i64 (fpext f64 (float (/ 1.0 0.0)))))
