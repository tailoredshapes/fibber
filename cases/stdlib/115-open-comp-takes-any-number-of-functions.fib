;; spec:   stdlib §4.3 (row comp: `(comp f g ..) (comp)`), §2.2 (arity-reading combinators), §7 L22
;; expect: accept
;; result: 24
;; audit:  clean
;; open:   L22
;; roots:  ../../lib
;; covers: comp
;; Clojure's `comp` takes any number of functions: `(comp)` is `identity`,
;; `(comp f)` is f, and `(comp f g h)` applies h, then g, then f. The arity of
;; the result is the arity of the last function, which is read from its type
;; (L22, the arity-reading forms). Tranche 1 ships the two-function form
;; (case 103) and a program nests the rest: today `(comp bump twice bump)` is
;; `comp takes 2 argument(s), got 3`, the same for `(comp bump)` (got 1) and
;; `(comp)` (got 0). When L22 lands this case passes and its `open:` goes.
;; 13 + 6 + 5 = 24.
(ns main (:use fib.core))

(defun bump (x: i64) -> i64 (+ x 1))
(defun twice (x: i64) -> i64 (* x 2))

(defun main () -> i64
  (+ ((comp bump twice bump) 5)
     (+ ((comp bump) 5)
        ((comp) 5))))
