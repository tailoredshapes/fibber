;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.3
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; The reader turns <<..>> into the form (simd ..); a top-level function named `simd` must not capture it: the literal still makes a vector. (A LOCAL named simd does capture it today; that is a finding of SIMD3, and no case pins it.)
(ns main (:use fib.core tl.check))

(defun simd (a: i64 b: i64) -> i64 (+ a b))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (hsum (simd 1 2)) 3))
        (let ((v: i64x2 <<7 8>>))
          (check c (= (hsum v) 15)))
        (checks-result c))))
