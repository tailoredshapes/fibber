;; spec:   stdlib §4.3 (row and-then: `(fn (a) (Option b)) (Option a) -> (Option b)`), §3 N11
;; expect: reject
;; error:  cannot unify (fn :send (i64) i64) with (fn (i64) (Option a))
;; roots:  ../../lib
;; covers: and-then unwrap-or
;; and-then is the bind: its function returns an Option and the result is that
;; Option, kept as it is. A function that returns a plain value belongs to
;; map-opt, and the checker says so by refusing it here, instead of wrapping
;; the result (which would make `(and-then f o)` and `(map-opt f o)` one
;; function and hide which of the two the program meant).
(ns main (:use fib.core))

(defun bump (x: i64) -> i64 (+ x 1))

(defun main () -> i64
  (unwrap-or (and-then bump (some 1)) 0))
