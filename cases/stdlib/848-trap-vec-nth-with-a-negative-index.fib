;; spec:   stdlib §5 (nth is the lookup that throws on a bad index, P5), types §2.13
;; expect: trap
;; trap:   nth: index out of range
;; A negative index is out of range, as in Clojure (which throws): it must not
;; wrap, nor read the tail from the end. The Vec holds 1100 elements so that
;; both of its parts, the trie and the tail, are there to be wrongly read; the
;; first element is read before the trap to show the Vec itself is sound.
(defun build (n: i64) -> (Vec i64)
  (loop ((i 0) (v (vec-empty)))
    (if (< i n) (recur (+ i 1) (conj v (* i 3))) v)))

(defun main () -> i64
  (let ((v (build 1100)))
    (+ (nth v 0) (nth v -1))))
