;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/webgpu
;; webgpu-target = reject | f64
;; WGSL has no double -- a kernel that computes in f64 is refused naming the type.
;; The host builds and runs this program (nothing calls the kernel); compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [fib.gpu :as gpu] [gpu32 :as g]))
(defkernel k (a: ptr x: f64 n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n) (g/f32-set! a i (fptrunc f32 (* x 2.0))))))
(defun main () -> i64 0)
