;; spec: docs/design/compress.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; fib.compress.par/run-jobs: results in job order for every worker count; of several failing jobs the lowest index's error. (The trap half is case 8690: its abandoned count is exact only when one job runs.)
(ns main (:use tl.check) (:require [fib.compress.types :as t] [fib.compress.par :as p]))
(defun main () -> i64
  (let [c (checks)]
    (do (dotimes (i 4)
          (let [w (nth [1 2 7 16] i)]
            (do (check c (= (p/run-jobs w 25 (fn (j: i64) (t/Ok (* j j)))) (t/Ok (vec (map (fn (j: i64) (* j j)) (range 25))))))
                (check c (match (p/run-jobs w 20 (fn (j: i64) (cond (= j 8) (Err (t/corrupt "job 8")) (= j 3) (Err (t/too-large "job 3")) :else (Ok j))))
                           ((Err e) (and (= (. e kind) :too-large) (= (. e message) "job 3"))) ((Ok _) false))))))
        (checks-result c))))
