;; spec:   stdlib §4.2 (row recur), syntax §3.18
;; expect: reject
;; error:  recur not in tail position
;; covers: recur
;; `recur` is a jump to the top of the loop, so it must be the last thing
;; the body does: here the result of the recur would be added to 1 after
;; it came back, and there is no coming back. The loop is not an
;; accumulating recursion (write the call as a `defun` for that).
(defun main () -> i64
  (loop ((i 0))
    (if (< i 3)
        (+ 1 (recur (+ i 1)))
        i)))
