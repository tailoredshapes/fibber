;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.6
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; simd/lt le gt ge eq ne on ['i8', 'i16', 'i32', 'i64'] vectors give the mask whose lane k is the scalar comparison of lane k.
(ns main (:use fib.core tl.check))

(defun cmp-i8-3 (c: Checks) -> unit
  (let ((a: i8x3 <<2 1 0>>i8) (b: i8x3 <<2 -6 9>>i8))
    (do (let ((r (simd/lt a b)))
      (do
        (check c (= (lane r 0) (< 2i8 2i8)))
        (check c (= (lane r 1) (< 1i8 -6i8)))
        (check c (= (lane r 2) (< 0i8 9i8)))
        ()))
        (let ((r (simd/le a b)))
      (do
        (check c (= (lane r 0) (<= 2i8 2i8)))
        (check c (= (lane r 1) (<= 1i8 -6i8)))
        (check c (= (lane r 2) (<= 0i8 9i8)))
        ()))
        (let ((r (simd/gt a b)))
      (do
        (check c (= (lane r 0) (> 2i8 2i8)))
        (check c (= (lane r 1) (> 1i8 -6i8)))
        (check c (= (lane r 2) (> 0i8 9i8)))
        ()))
        (let ((r (simd/ge a b)))
      (do
        (check c (= (lane r 0) (>= 2i8 2i8)))
        (check c (= (lane r 1) (>= 1i8 -6i8)))
        (check c (= (lane r 2) (>= 0i8 9i8)))
        ()))
        (let ((r (simd/eq a b)))
      (do
        (check c (= (lane r 0) (= 2i8 2i8)))
        (check c (= (lane r 1) (= 1i8 -6i8)))
        (check c (= (lane r 2) (= 0i8 9i8)))
        ()))
        (let ((r (simd/ne a b)))
      (do
        (check c (= (lane r 0) (!= 2i8 2i8)))
        (check c (= (lane r 1) (!= 1i8 -6i8)))
        (check c (= (lane r 2) (!= 0i8 9i8)))
        ()))
        (let ((r (simd/lt a 2)))
      (do
        (check c (= (lane r 0) (< 2i8 2i8)))
        (check c (= (lane r 1) (< 1i8 2i8)))
        (check c (= (lane r 2) (< 0i8 2i8)))
        ()))
        ())))

