(defun main () -> i64
  (let [bad (cell 0)]
    (do (doseq [row (table)]
          (let [at (unwrap (str-find row "|" 0))
                line (str-slice row 0 at)
                want (str-slice row (+ at 1) (str-len row))
                got (run-line line)]
            (if (= got want) () (do (set! bad (+ @bad 1)) (println (str "DISAGREE " line " java " want " fib " got))))))
        (if (and (= (d/dec-to-str (d/dec-parse "1.50")) "1.50")
                 (= (d/dec-to-str (d/dec-parse "1.5E+3")) "1.5E+3")
                 (= (d/dec-to-str (d/dec-parse "0.0000001234")) "1.234E-7")
                 (= (d/dec-compare (d/dec-parse "1.0") (d/dec-parse "1.00")) 0)
                 (not (= (d/dec-parse "1.0") (d/dec-parse "1.00")))
                 (= (d/dec-to-str (d/dec-add (d/dec-parse "0.1") (d/dec-parse "0.2"))) "0.3")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "2.5") 0 d/HalfEven)) "2")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "3.5") 0 d/HalfEven)) "4")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "-2.5") 0 d/HalfEven)) "-2")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "0.125") 2 d/HalfEven)) "0.12")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "0.135") 2 d/HalfEven)) "0.14")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "2.5") 0 d/HalfUp)) "3")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "2.5") 0 d/HalfDown)) "2")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "-2.1") 0 d/Ceiling)) "-2")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "-2.1") 0 d/Floor)) "-3")
                 (= (d/dec-to-str (d/dec-set-scale (d/dec-parse "2.1") 0 d/Up)) "3")
                 (= (d/dec-to-str (d/dec-divide (d/dec-parse "1") (d/dec-parse "3") (d/decimal128))) "0.3333333333333333333333333333333333")
                 (= (d/dec-to-str (d/dec-divide (d/dec-parse "2") (d/dec-parse "3") (d/decimal32))) "0.6666667")
                 (= (d/dec-to-str (d/dec-round (d/dec-parse "999.99") (d/math-context 4 d/HalfUp))) "1000")
                 (= @bad 0))
            0
            (+ 1 @bad)))))
