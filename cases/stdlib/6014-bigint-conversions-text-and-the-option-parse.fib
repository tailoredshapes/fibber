;; spec:   stdlib §2.8 (BigInt), §4.20
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bigint biginteger parse-bigint long double str pr-str
;; The conversions to and from the other numbers and text: the widths promote with `bigint`, text with a sign
;; or leading zeros parses, a malformed text is `nil` from `parse-bigint`, the i64 extremes round trip through
;; `long`, `double` rounds to nearest (a 2^53+1 ties to even), Show is the digits and Debug (`pr-str`) adds
;; Clojure's N.
(ns main (:use tl.check fib.bigint))

(defun main () -> i64
  (let [c (checks)
        p (checks)
        big (bigint "-123456789012345678901234567890")]
    (do
      (check c (= (str (bigint 7i8)) "7"))
      (check c (= (str (bigint -300i16)) "-300"))
      (check c (= (str (bigint 2000000000i32)) "2000000000"))
      (check c (= (str (bigint -9223372036854775808)) "-9223372036854775808"))
      (check c (= (str (biginteger 5)) "5"))
      (check c (= (str (bigint "+0012")) "12"))
      (check c (= (str (bigint "-0")) "0"))
      (check c (= (str (bigint "000000000000000000000000000000")) "0"))
      (check c (= (str (bigint "1000000000000000000")) "1000000000000000000"))
      (check c (= (str (bigint "1000000000000000000000000000001")) "1000000000000000000000000000001"))
      (check c (= (parse-bigint "") nil))
      (check c (= (parse-bigint "-") nil))
      (check c (= (parse-bigint "1 2") nil))
      (check c (= (parse-bigint "0x10") nil))
      (check c (= (parse-bigint "98765432109876543210") (some (bigint "98765432109876543210"))))
      (check c (= (long (bigint "9223372036854775807")) 9223372036854775807))
      (check c (= (long (bigint "-9223372036854775808")) (- (- 0 9223372036854775807) 1)))
      (check c (= (long (bigint 0)) 0))
      (check c (= (long (bigint -12345678901)) -12345678901))
      (check c (= (str (double (bigint "9007199254740993"))) "9.007199254740992E15"))
      (check c (= (str (double (bigint "9007199254740995"))) "9.007199254740996E15"))
      (check c (= (str (double (bigint "-1000000000000000000000000"))) "-1.0E24"))
      (check c (= (str (double (bigint 0))) "0.0"))
      (check c (= (pr-str big) "-123456789012345678901234567890N"))
      (check c (= (str big) "-123456789012345678901234567890"))
      (check c (= (to-str big) "-123456789012345678901234567890"))
      (check p (= (str (bigint "9007199254740993")) "9007199254740992"))
      (check-detects c p)
      (checks-result c))))
