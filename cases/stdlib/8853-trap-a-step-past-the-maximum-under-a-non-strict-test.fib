;; spec:   spec/lir.md 6.13 (facts), types §8.12 (checked arithmetic)
;; expect: trap
;; trap:   integer overflow in + at i64
;; roots:  ../../lib support
;; covers: + <= loop
;; The control of 8852: under `(<= i hi)` the step `(+ i 1)` can overflow (at `i = hi = max`), so no fact is emitted for it
;; (emit.lower.facts 2 takes `<` and `>` only) and it stays the checked add, which traps with the overflow message. Were the fact
;; emitted here it would be false: undefined behaviour, or a `lIR fact violated` trap under FIB_LIR_FACTS=trap, either way not this
;; message.
(ns main (:use fib.core fib.seq fib.coll))

(defun up-to (lo: i64 hi: i64) -> i64
  (loop ((i lo)) (if (<= i hi) (recur (+ i 1)) i)))

(defun main () -> i64
  (let ((k (count (args))) (max 9223372036854775807))
    (up-to (- max (+ 2 k)) (- max k))))
