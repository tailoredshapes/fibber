;; spec:   stdlib §4.4 (row range: `Num t, Ord t`), §2.3 (Unit: i8 to i64, f32, f64)
;; expect: reject
;; error:  no implementation of Num for char
;; roots:  ../../lib support
;; covers: range
;; A Range is over the numbers: (range n) needs `+` and a zero and a one of the type, so a char (which has
;; Ord and Eq but no arithmetic) is refused where the range is made, with the checker's own words, not where
;; it is walked.
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (count (range \a)))
