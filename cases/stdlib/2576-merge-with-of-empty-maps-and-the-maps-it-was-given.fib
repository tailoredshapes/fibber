;; spec:   stdlib §4.5 row merge-with, §1.2 P3 (persistent in the API)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: merge-with
;; An empty map on either side is the other map, whatever f is (it is never called, so a function that traps shows it); the
;; two maps are values and are not changed by the merge, which holds when the merge keeps the accumulated map and adds b's
;; entries to it; the result is a map of its own that takes further assoc without touching either argument.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun never (o: i64 n: i64) -> i64 (trap "merge-with: f was called"))

(defun main () -> i64
  (let ((c (checks))
        (a {1 10 2 20})
        (b {2 5 3 6})
        (e (empty {1 1})))
    (do (check c (= (merge-with never a e) a))
        (check c (= (merge-with never e a) a))
        (check c (= (merge-with never e e) e))
        (check c (= (count (merge-with never e e)) 0))
        (let ((m (merge-with + a b)))
          (do (check c (= m {1 10 2 25 3 6}))
              (check c (= a {1 10 2 20}))
              (check c (= b {2 5 3 6}))
              (check c (= (assoc m 4 1) {1 10 2 25 3 6 4 1}))
              (check c (= m {1 10 2 25 3 6}))))
        (checks-result c))))
