;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema) (let [result (g/execute schema "fragment Identity on Person { id name } query { person { name ...Identity ... on Person { friend { ...Identity } } } }" {} g/NullValue)]
        (do (check c (= (g/result-json result) "{\"data\":{\"person\":{\"name\":\"Ada\",\"id\":\"7\",\"friend\":{\"id\":\"8\",\"name\":\"Bob\"}}}}"))
          (check c (= @calls 1)))))) (checks-result c))))
