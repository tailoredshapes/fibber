;; spec:   stdlib §2.3 (Stack), §4.4 (rows peek pop), §1.2 P5
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: peek pop
;; A Vec is a stack at its end, the end conj adds at: (peek [1 2 3]) is (some 3) and (pop [1 2 3]) is [1 2], as Clojure's
;; (peek [1 2 3]) is 3 and (pop [1 2 3]) is [1 2], with the typed twist that a peek of nothing is nil. The checks: peek of
;; three, of one and of none; pop of three, two and one (the last gives the empty vector); a pop and a peek in a chain;
;; the popped vector is a Vec (it takes a conj, and its count is one less).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (v [1 2 3]))
    (do (check c (= (peek v) (some 3)))
        (check c (= (pop v) [1 2]))
        (check c (= (peek (pop v)) (some 2)))
        (check c (= (pop (pop v)) [1]))
        (check c (= (peek (pop (pop v))) (some 1)))
        (check c (= (pop (pop (pop v))) (vec-empty)))
        (check c (= (peek (pop (pop (pop v)))) nil))
        (check c (= (count (pop v)) 2))
        (check c (= (conj (pop v) 9) [1 2 9]))
        (check c (= (peek [7]) (some 7)))
        (check c (= (pop [7]) (vec-empty)))
        (check c (= (peek (conj (pop v) 9)) (some 9)))
        (checks-result c))))
