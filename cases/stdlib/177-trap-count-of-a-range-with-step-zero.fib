;; spec:   stdlib §4.4 (row range: a step of 0 repeats the start for ever), tranche 1 plan §6 L5a
;; expect: trap
;; trap:   count: a range with step 0 never ends
;; roots:  ../../lib support
;; covers: range-by
;; The range of a step of 0 and a start that is not its end repeats the start for ever (case 164), so it has
;; no count. Clojure's `count` of it never returns; here it is a trap that says why. (Decided in the header
;; of lib/fib/seq/sources.fib, and reported to the owner as the one place where this differs from Clojure.)
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (count (range-by 3 10 0)))
