;; spec:   stdlib §2.5 (update! is for Cells; an Atom is shared and swap! is its form), §4.3 (row update!)
;; expect: reject
;; error:  Cell
;; roots:  ../../lib support
;; covers: update!
;; An Atom's value is visible to every task and is never unique, so there is nothing for update! to move out:
;; the call is a type error, the Atom form being swap!.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a (atom 1)))
    (do (update! a (fn (x) (+ x 1)))
        0)))
