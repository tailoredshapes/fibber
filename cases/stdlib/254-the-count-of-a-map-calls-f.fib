;; spec:   stdlib §2.1 rule 4 (count of an adaptor is a walk that calls f), §4.4 rows map filter mapcat
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map filter mapcat
;; (count (map f c)) calls f once per element, as Clojure's does: a seq has
;; no size without a walk. Over [1 2] a counting f is called twice, the page's
;; [(count r) calls] = [2 2]; counting the same seq again calls it no more
;; (the seq is memoised); a filter's predicate and a mapcat's function are
;; called once per source element.
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (calls (cell 0)))
    (do (let ((r (map (fn (x: i64) (do (set! calls (+ @calls 1)) x)) [1 2])))
          (do (check c (= (count r) 2))
              (check c (= @calls 2))
              (check c (= (count r) 2))
              (check c (= @calls 2))))
        (set! calls 0)
        (check c (= (count (filter (fn (x: i64) (do (set! calls (+ @calls 1)) (> x 1))) [1 2 3])) 2))
        (check c (= @calls 3))
        (set! calls 0)
        (check c (= (count (mapcat (fn (x: i64) (do (set! calls (+ @calls 1)) [x x])) [1 2 3])) 6))
        (check c (= @calls 3))
        (checks-result c))))
