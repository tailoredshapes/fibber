;; spec:   stdlib §6.3 (E4); syntax §4.4
;; expect: reject
;; error:  malformed cond: a test with no expression
;; roots:  ../../lib support
;; covers: cond
;; An odd number of forms is a test with no expression. The old paired clause (cond (a 1)) is one form
;; and is refused the same way, which is how an unmigrated cond shows itself.
(ns main (:use fib.core))

(defun main () -> i64
  (cond (> 1 0) 1
        (< 1 0)))
