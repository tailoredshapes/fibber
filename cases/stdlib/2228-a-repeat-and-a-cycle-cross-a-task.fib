;; spec:   stdlib §2.1 rule 2 and §5.5 S10 (an LSeq holds a Cell and does not cross a task); tranche 2 plan Y1, risks (D7)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: repeat cycle take reduce
;; A Repeat holds its element and a Cycle its source and a count, no cell, so a task may take
;; one: each spawned task folds the first elements of the seq it was given and the main task joins
;; the sums. 5 elements of a repeated 5 are 25 and 5 of a cycle of 1 2 3 are 1 + 2 + 3 + 1 + 2 = 9.
;; (An Iterate holds a function, which is local: case 2229.)
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (r (repeat 5))
        (cy (cycle [1 2 3])))
    (let ((h1 (spawn (fn () (reduce (fn (a x) (+ a x)) 0 (take 5 r)))))
          (h2 (spawn (fn () (reduce (fn (a x) (+ a x)) 0 (take 5 cy))))))
      (do (check c (= (join h1) 25))
          (check c (= (join h2) 9))
          (checks-result c)))))
