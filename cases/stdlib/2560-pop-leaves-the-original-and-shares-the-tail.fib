;; spec:   stdlib §1.2 P3 (persistent in the API), §2.3 (Stack), §4.4 rows peek and pop
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: peek pop
;; pop is persistent: it returns the stack without its top and the stack it was given is unchanged, as Clojure's is. A Vec
;; popped twice gives two equal vectors, the original still has its three elements, and two pops from one vector do not see
;; each other; a List popped has the tail of the original, and the original is still whole (the tail is shared, not copied).
;; A stack that is popped, pushed and popped again ends where it began.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (v [1 2 3])
        (l (list 1 2 3))
        (v1 (pop [1 2 3]))
        (v2 (pop [1 2 3]))
        (a (pop [1 2 3]))
        (b (conj (pop [1 2 3]) 9)))
    (do (check c (= (pop v) (pop v)))
        (check c (= v [1 2 3]))
        (check c (= (peek v) (some 3)))
        (check c (= v1 v2))
        (check c (= a [1 2]))
        (check c (= b [1 2 9]))
        (check c (= (pop (conj (pop v) 3)) (pop v)))
        (check c (= (pop l) (pop l)))
        (check c (= l (list 1 2 3)))
        (check c (= (peek l) (some 1)))
        (check c (= (pop (pop l)) (list 3)))
        (check c (= (pop (conj (pop l) 1)) (pop l)))
        (checks-result c))))
