;; spec: spec/stdlib.md section 2.9 (the grammar of parse-double), section 4.7 row `parse-double` (`str -> (Option f64)`, correctly rounded, hex, a leading space, `inf` and trailing junk give nil)
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Package FOLLOWUP-1: `parse-double` had a row and no definition (unbound in 0.1.11). Pinned: the page's grammar exactly (`[+-]? (digits ['.' digits*] | '.' digits) ([eE] [+-]? digits)?` and the three names
;; NaN, Infinity, -Infinity), nil and never a trap for everything else, and the value correctly rounded: exact halfway cases between doubles (to even), the least subnormal and a text below it, the
;; largest double and the first text above it (Infinity), a mantissa of 40 digits (the strtod path) and an exponent too large for any i64 to hold. Bits are compared (`f64->bits`), so -0.0 and 0.0 differ.
;; scripts/parse-double-floats.sh checks a million random texts and the edge corpus against strtod.
(ns main (:use tl.check))

(defun bits (s: str) -> i64 (match (parse-double s) ((some x) (f64->bits x)) (nil -1)))
(defun same? (s: str x: f64) -> bool (= (bits s) (f64->bits x)))
(defun bad? (s: str) -> bool (nil? (parse-double s)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (same? "1.5" 1.5))
        (check c (same? "0" 0.0))
        (check c (same? "-0" -0.0))
        (check c (same? "-0.0" -0.0))
        (check c (same? "+2.5" 2.5))
        (check c (same? "10" 10.0))
        (check c (same? "1." 1.0))
        (check c (same? ".5" 0.5))
        (check c (same? "-.5" -0.5))
        (check c (same? "1e5" 100000.0))
        (check c (same? "1E5" 100000.0))
        (check c (same? "1e+5" 100000.0))
        (check c (same? "1.5e-3" 0.0015))
        (check c (same? "0.1" 0.1))
        (check c (same? "123456789.123456789" 123456789.123456789))
        (check c (same? "00012" 12.0))
        (check c (same? "9007199254740993" 9007199254740992.0))
        (check c (same? "9007199254740993.0" 9007199254740992.0))
        (check c (same? "9007199254740995" 9007199254740996.0))
        (check c (same? "4.9e-324" 5e-324))
        (check c (same? "2.4703282292062327e-324" 0.0))
        (check c (same? "2.4703282292062328e-324" 5e-324))
        (check c (same? "-1e-400" -0.0))
        (check c (same? "1.7976931348623157e308" 1.7976931348623157e308))
        (check c (= (bits "1.7976931348623158e308") (f64->bits 1.7976931348623157e308)))
        (check c (= (bits "1.7976931348623159e308") (f64->bits (fdiv 1.0 0.0))))
        (check c (= (bits "1e400") (f64->bits (fdiv 1.0 0.0))))
        (check c (= (bits "-1e400") (f64->bits (fdiv -1.0 0.0))))
        (check c (same? "1e-99999999999999999999" 0.0))
        (check c (= (bits "1e99999999999999999999") (f64->bits (fdiv 1.0 0.0))))
        (check c (same? "3.14159265358979323846264338327950288419716939937510" 3.141592653589793))
        (check c (same? "0.000000000000000000000000000000000000001" 1e-39))
        (check c (same? "Infinity" (fdiv 1.0 0.0)))
        (check c (same? "-Infinity" (fdiv -1.0 0.0)))
        (check c (match (parse-double "NaN") ((some x) (!= x x)) (nil false)))
        (check c (bad? ""))
        (check c (bad? "-"))
        (check c (bad? "+"))
        (check c (bad? "."))
        (check c (bad? "-."))
        (check c (bad? "e5"))
        (check c (bad? ".e5"))
        (check c (bad? "1e"))
        (check c (bad? "1e+"))
        (check c (bad? "1e5.5"))
        (check c (bad? "1..2"))
        (check c (bad? "1.2.3"))
        (check c (bad? "--1"))
        (check c (bad? "+-1"))
        (check c (bad? " 1"))
        (check c (bad? "1 "))
        (check c (bad? "1\n"))
        (check c (bad? "1_000"))
        (check c (bad? "1,5"))
        (check c (bad? "0x10"))
        (check c (bad? "0x1p3"))
        (check c (bad? "0x1.8p1"))
        (check c (bad? "inf"))
        (check c (bad? "-inf"))
        (check c (bad? "infinity"))
        (check c (bad? "nan"))
        (check c (bad? "+Infinity"))
        (check c (bad? "-NaN"))
        (check c (bad? "Infinityx"))
        (check c (bad? "1d"))
        (check c (bad? "1f"))
        (check c (bad? "12abc"))
        (check c (bad? "\u{661}\u{662}"))
        (check c (bad? "1\u{e9}"))
        (check c (same? "\u{31}" 1.0))
        (checks-result c))))
