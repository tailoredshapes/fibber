;; spec:   types §1.1, stdlib §7 L26 (a)
;; expect: reject
;; error:  the literal 300 does not fit i8 (-128..127)
;; roots:  ../../lib support
;; A literal takes the width of the integer it meets only if it fits: 300 is not an `i8`, and the error says what the range is (and not the bare
;; `cannot unify i64 with i8`). Killed by: a checker that adopts without the range test.
(ns main)

(defun big (x: i8) -> bool (< x 300))

(defun main () -> i64
  (if (big 1i8) 1 0))
