;; spec: lib/fib/tensor/optim.fib (header) and README.md (Fused optimiser steps): adam-step! and sgd-momentum-step! are bit-identical to the composition of fib.tensor calls with the same operation order, agree with PyTorch 2.14 on a fixed example, and never write into a buffer another holder still sees
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; The oracle for bit identity is the unfused composition (axpby, mul, sqrt, scale, shift, div) written here, over every length 0..40 (around the 4 and 8 lane widths), a matrix, a dense slice
;; with an offset and a transposed view, for three chained steps (the state of each step is the output of the last). The PyTorch values were produced by torch.optim.Adam and
;; torch.optim.SGD(momentum=0.9) in float64 and float32 (`~/.cache/fibber-scratch/t4/torch_ref.py`): lr 0.01, betas 0.9 and 0.999, eps 1e-8, three steps, ten parameters including 1e-3 and 100.0.
;; A fused kernel with eps inside the square root, a reordered multiply or a write into a shared buffer changes some value; planted wrong oracles must be detected.
(ns main (:require [fib.tensor :as t] [fib.math :as math]) (:use tl.check))

(defun ipow (x: f64 n: i64) -> f64 (loop ((i 0) (acc 1.0)) (if (< i n) (recur (+ i 1) (* acc x)) acc)))
(defun rel (a: f64 b: f64 tol: f64) -> bool (<= (abs (- a b)) (* tol (+ (abs b) 1.0e-30))))
(defun vclose (xs: (Vec f64) ys: (Vec f64) tol: f64) -> bool
  (and (= (count xs) (count ys)) (loop ((i 0)) (if (< i (count xs)) (if (rel (nth xs i) (nth ys i) tol) (recur (+ i 1)) false) true))))

;; ---- f32
(defun cv-f32 (x: f64) -> f32 (fptrunc f32 x))
(defun gen-f32 (n: i64 seed: i64 positive: bool) -> (t/Tensor f32)
  (let ((b (cell (array n 0.0f32))))
    (do (dotimes (i n)
          (let ((x (fdiv (double (- (rem (+ (* i 7919) (* seed 104729)) 1013) 500)) 37.0)))
            (array-set! &b i (cv-f32 (if positive (+ (abs x) 0.01) (* x (if (= (rem i 5) 0) 100.0 0.01)))))))
        (t/from-array [n] @b 0.0f32))))
(defun bits-f32 (x: (t/Tensor f32)) -> (Vec i64) (mapv (fn (v: f32) (zext i64 (f32->bits v))) (t/to-vec x)))
(defun vals-f32 (x: (t/Tensor f32)) -> (Vec f64) (mapv (fn (v: f32) (double v)) (t/to-vec x)))

(defun comp-adam-f32 (lr: f64 b1: f64 b2: f64 eps: f64 bc1: f64 bc2: f64 p: (t/Tensor f32) g: (t/Tensor f32) m: (t/Tensor f32) v: (t/Tensor f32)) -> (Vec (t/Tensor f32))
  (let [m2 (t/axpby (cv-f32 b1) m (cv-f32 (- 1.0 b1)) g)
        v2 (t/axpby (cv-f32 b2) v (cv-f32 (- 1.0 b2)) (t/mul g g))
        den (t/shift (cv-f32 eps) (t/scale (cv-f32 (/ 1.0 (math/sqrt bc2))) (t/sqrt v2)))
        p2 (t/axpby (cv-f32 1.0) p (cv-f32 (- 0.0 (/ lr bc1))) (t/div m2 den))]
    [p2 m2 v2]))
(defun comp-mom-f32 (lr: f64 mu: f64 p: (t/Tensor f32) g: (t/Tensor f32) b: (t/Tensor f32)) -> (Vec (t/Tensor f32))
  (let [b2 (t/axpby (cv-f32 mu) b (cv-f32 1.0) g)
        p2 (t/axpby (cv-f32 1.0) p (cv-f32 (- 0.0 lr)) b2)]
    [p2 b2]))

(defun same-f32 (a: (Vec (t/Tensor f32)) b: (Vec (t/Tensor f32))) -> bool
  (and (= (count a) (count b))
       (loop ((i 0)) (if (< i (count a)) (if (and (= (bits-f32 (nth a i)) (bits-f32 (nth b i))) (= (t/shape (nth a i)) (t/shape (nth b i)))) (recur (+ i 1)) false) true))))

;; three chained steps of the fused kernel and of the composition from the same start; every output of every step must have the same bits
(defun chain-f32 (p0: (t/Tensor f32) g0: (t/Tensor f32) m0: (t/Tensor f32) v0: (t/Tensor f32)) -> bool
  (loop ((s 1) (a [p0 m0 v0]) (b [p0 m0 v0]) (ok true))
    (if (<= s 3)
        (let ((bc1 (- 1.0 (ipow 0.9 s))) (bc2 (- 1.0 (ipow 0.999 s)))
              (ga (t/scale (cv-f32 (double s)) g0))
              (ra (t/adam-step! 0.01 0.9 0.999 1.0e-8 bc1 bc2 (nth a 0) (t/scale (cv-f32 (double s)) g0) (nth a 1) (nth a 2)))
              (rb (comp-adam-f32 0.01 0.9 0.999 1.0e-8 bc1 bc2 (nth b 0) ga (nth b 1) (nth b 2))))
          (recur (+ s 1) ra rb (and ok (same-f32 ra rb))))
        ok)))
(defun chain-mom-f32 (p0: (t/Tensor f32) g0: (t/Tensor f32) b0: (t/Tensor f32)) -> bool
  (loop ((s 1) (a [p0 b0]) (b [p0 b0]) (ok true))
    (if (<= s 3)
        (let ((ga (t/scale (cv-f32 (double s)) g0)) (ra (t/sgd-momentum-step! 0.1 0.9 (nth a 0) (t/scale (cv-f32 (double s)) g0) (nth a 1)))
              (rb (comp-mom-f32 0.1 0.9 (nth b 0) ga (nth b 1))))
          (recur (+ s 1) ra rb (and ok (same-f32 ra rb))))
        ok)))

(defun check-identity-f32 (c: Checks) -> unit
  (do (dotimes (n 41)
        (do (check c (chain-f32 (gen-f32 n 1 false) (gen-f32 n 2 false) (gen-f32 n 3 false) (gen-f32 n 4 true)))
            (check c (chain-mom-f32 (gen-f32 n 5 false) (gen-f32 n 6 false) (gen-f32 n 7 false)))))
      ;; a matrix, a dense slice with an offset and a transposed view (made contiguous inside: the same bits)
      (check c (chain-f32 (t/reshape [5 13] (gen-f32 65 1 false)) (t/reshape [5 13] (gen-f32 65 2 false)) (t/reshape [5 13] (gen-f32 65 3 false)) (t/reshape [5 13] (gen-f32 65 4 true))))
      (check c (chain-f32 (t/slice 0 3 40 1 (gen-f32 50 1 false)) (t/slice 0 5 42 1 (gen-f32 50 2 false)) (t/slice 0 7 44 1 (gen-f32 50 3 false)) (t/slice 0 2 39 1 (gen-f32 50 4 true))))
      (check c (chain-f32 (t/transpose (t/reshape [5 13] (gen-f32 65 1 false))) (t/transpose (t/reshape [5 13] (gen-f32 65 2 false)))
                         (t/transpose (t/reshape [5 13] (gen-f32 65 3 false))) (t/transpose (t/reshape [5 13] (gen-f32 65 4 true)))))
      (check c (chain-mom-f32 (t/slice 0 3 40 1 (gen-f32 50 1 false)) (t/slice 0 5 42 1 (gen-f32 50 2 false)) (t/slice 0 7 44 1 (gen-f32 50 3 false))))
      ;; the result shapes are the inputs'
      (check c (= (t/shape (nth (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 (t/reshape [5 13] (gen-f32 65 1 false)) (t/reshape [5 13] (gen-f32 65 2 false))
                                              (t/reshape [5 13] (gen-f32 65 3 false)) (t/reshape [5 13] (gen-f32 65 4 true))) 0)) [5 13]))
      ;; a second holder of p, m, v and g keeps its values: the step never writes into a shared buffer
      (let ((p (gen-f32 33 1 false)) (g (gen-f32 33 2 false)) (m (gen-f32 33 3 false)) (v (gen-f32 33 4 true)))
        (let ((p-before (bits-f32 p)) (m-before (bits-f32 m)) (v-before (bits-f32 v)) (g-before (bits-f32 g)) (r (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 p g m v)))
          (do (check c (= (bits-f32 p) p-before)) (check c (= (bits-f32 m) m-before)) (check c (= (bits-f32 v) v-before)) (check c (= (bits-f32 g) g-before))
              (check c (!= (bits-f32 (nth r 0)) p-before)))))
      (let ((p (gen-f32 33 1 false)) (g (gen-f32 33 2 false)) (b (gen-f32 33 3 false)))
        (let ((p-before (bits-f32 p)) (b-before (bits-f32 b)) (r (t/sgd-momentum-step! 0.1 0.9 p g b)))
          (do (check c (= (bits-f32 p) p-before)) (check c (= (bits-f32 b) b-before)) (check c (!= (bits-f32 (nth r 0)) p-before)))))))

;; PyTorch: three Adam steps on ten parameters
(defun torch-f32 (c: Checks tol: f64) -> unit
  (let ((p (t/from-array [10] (arr-f32 [1.0 -2.0 0.5 3.0 1.0e-3 100.0 -0.25 0.0 2.5 -7.0]) 0.0f32))
        (g1 (arr-f32 [0.1 -0.2 0.3 -0.4 1.0e-5 50.0 -0.05 0.0 0.7 -1.5])) (g2 (arr-f32 [0.05 0.1 -0.3 0.2 2.0e-5 -40.0 0.07 0.01 -0.2 1.0]))
        (g3 (arr-f32 [-0.2 0.15 0.05 0.1 -1.0e-5 30.0 0.02 -0.01 0.9 0.5])))
    (let ((z (t/zeros-f32 [10])))
      (let ((r1 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 1)) (- 1.0 (ipow 0.999 1)) p (t/from-array [10] g1 0.0f32) z z)))
        (let ((r2 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 2)) (- 1.0 (ipow 0.999 2)) (nth r1 0) (t/from-array [10] g2 0.0f32) (nth r1 1) (nth r1 2))))
          (let ((r3 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 3)) (- 1.0 (ipow 0.999 3)) (nth r2 0) (t/from-array [10] g3 0.0f32) (nth r2 1) (nth r2 2))))
            (do (check c (vclose (vals-f32 (nth r3 0)) [0.9827417731285095 -1.989188313484192 0.49018213152885437 3.013277292251587 -0.022833656519651413 99.98629760742188 -0.2452390044927597 -0.006989536806941032 2.4784975051879883 -6.989186763763428] tol))
                (check c (vclose (vals-f32 (nth r3 1)) [-0.007400000002235174 0.007800000719726086 0.0022999995853751898 -0.004399999976158142 1.610000026630587e-06 3.450000047683716 0.004249999765306711 -9.999996109399945e-05 0.12870000302791595 0.01849999651312828] tol))
                (check c (vclose (vals-f32 (nth r3 2)) [5.2477513236226514e-05 7.24100464140065e-05 0.00018223011284135282 0.00020964017312508076 5.994000868564386e-13 4.993402481079102 7.790103154547978e-06 1.999000005525886e-07 0.0013389805098995566 0.00349450227804482] tol)))))))))
(defun torch-mom-f32 (c: Checks tol: f64) -> unit
  (let ((p (t/from-array [4] (arr-f32 [1.0 -2.0 0.5 3.0]) 0.0f32)) (z (t/zeros-f32 [4])))
    (let ((r1 (t/sgd-momentum-step! 0.1 0.9 p (t/from-array [4] (arr-f32 [0.1 -0.2 0.3 -0.4]) 0.0f32) z)))
      (let ((r2 (t/sgd-momentum-step! 0.1 0.9 (nth r1 0) (t/from-array [4] (arr-f32 [0.05 0.1 -0.3 0.2]) 0.0f32) (nth r1 1))))
        (let ((r3 (t/sgd-momentum-step! 0.1 0.9 (nth r2 0) (t/from-array [4] (arr-f32 [-0.2 0.15 0.05 0.1]) 0.0f32) (nth r2 1))))
          (do (check c (vclose (vals-f32 (nth r3 0)) [0.9833999872207642 -1.9797999858856201 0.4706999957561493 3.0604000091552734] tol))
              (check c (vclose (vals-f32 (nth r3 1)) [-0.07400000095367432 0.0780000165104866 0.023000000044703484 -0.04399997740983963] tol))))))))
(defun arr-f32 (v: (Vec f64)) -> (Array f32)
  (let ((b (cell (array (count v) 0.0f32)))) (do (dotimes (i (count v)) (array-set! &b i (cv-f32 (nth v i)))) @b)))

;; ---- f64
(defun cv-f64 (x: f64) -> f64 x)
(defun gen-f64 (n: i64 seed: i64 positive: bool) -> (t/Tensor f64)
  (let ((b (cell (array n 0.0))))
    (do (dotimes (i n)
          (let ((x (fdiv (double (- (rem (+ (* i 7919) (* seed 104729)) 1013) 500)) 37.0)))
            (array-set! &b i (cv-f64 (if positive (+ (abs x) 0.01) (* x (if (= (rem i 5) 0) 100.0 0.01)))))))
        (t/from-array [n] @b 0.0))))
(defun bits-f64 (x: (t/Tensor f64)) -> (Vec i64) (mapv (fn (v: f64) (f64->bits v)) (t/to-vec x)))
(defun vals-f64 (x: (t/Tensor f64)) -> (Vec f64) (mapv (fn (v: f64) (double v)) (t/to-vec x)))

(defun comp-adam-f64 (lr: f64 b1: f64 b2: f64 eps: f64 bc1: f64 bc2: f64 p: (t/Tensor f64) g: (t/Tensor f64) m: (t/Tensor f64) v: (t/Tensor f64)) -> (Vec (t/Tensor f64))
  (let [m2 (t/axpby (cv-f64 b1) m (cv-f64 (- 1.0 b1)) g)
        v2 (t/axpby (cv-f64 b2) v (cv-f64 (- 1.0 b2)) (t/mul g g))
        den (t/shift (cv-f64 eps) (t/scale (cv-f64 (/ 1.0 (math/sqrt bc2))) (t/sqrt v2)))
        p2 (t/axpby (cv-f64 1.0) p (cv-f64 (- 0.0 (/ lr bc1))) (t/div m2 den))]
    [p2 m2 v2]))
(defun comp-mom-f64 (lr: f64 mu: f64 p: (t/Tensor f64) g: (t/Tensor f64) b: (t/Tensor f64)) -> (Vec (t/Tensor f64))
  (let [b2 (t/axpby (cv-f64 mu) b (cv-f64 1.0) g)
        p2 (t/axpby (cv-f64 1.0) p (cv-f64 (- 0.0 lr)) b2)]
    [p2 b2]))

(defun same-f64 (a: (Vec (t/Tensor f64)) b: (Vec (t/Tensor f64))) -> bool
  (and (= (count a) (count b))
       (loop ((i 0)) (if (< i (count a)) (if (and (= (bits-f64 (nth a i)) (bits-f64 (nth b i))) (= (t/shape (nth a i)) (t/shape (nth b i)))) (recur (+ i 1)) false) true))))

;; three chained steps of the fused kernel and of the composition from the same start; every output of every step must have the same bits
(defun chain-f64 (p0: (t/Tensor f64) g0: (t/Tensor f64) m0: (t/Tensor f64) v0: (t/Tensor f64)) -> bool
  (loop ((s 1) (a [p0 m0 v0]) (b [p0 m0 v0]) (ok true))
    (if (<= s 3)
        (let ((bc1 (- 1.0 (ipow 0.9 s))) (bc2 (- 1.0 (ipow 0.999 s)))
              (ga (t/scale (cv-f64 (double s)) g0))
              (ra (t/adam-step! 0.01 0.9 0.999 1.0e-8 bc1 bc2 (nth a 0) (t/scale (cv-f64 (double s)) g0) (nth a 1) (nth a 2)))
              (rb (comp-adam-f64 0.01 0.9 0.999 1.0e-8 bc1 bc2 (nth b 0) ga (nth b 1) (nth b 2))))
          (recur (+ s 1) ra rb (and ok (same-f64 ra rb))))
        ok)))
(defun chain-mom-f64 (p0: (t/Tensor f64) g0: (t/Tensor f64) b0: (t/Tensor f64)) -> bool
  (loop ((s 1) (a [p0 b0]) (b [p0 b0]) (ok true))
    (if (<= s 3)
        (let ((ga (t/scale (cv-f64 (double s)) g0)) (ra (t/sgd-momentum-step! 0.1 0.9 (nth a 0) (t/scale (cv-f64 (double s)) g0) (nth a 1)))
              (rb (comp-mom-f64 0.1 0.9 (nth b 0) ga (nth b 1))))
          (recur (+ s 1) ra rb (and ok (same-f64 ra rb))))
        ok)))

(defun check-identity-f64 (c: Checks) -> unit
  (do (dotimes (n 41)
        (do (check c (chain-f64 (gen-f64 n 1 false) (gen-f64 n 2 false) (gen-f64 n 3 false) (gen-f64 n 4 true)))
            (check c (chain-mom-f64 (gen-f64 n 5 false) (gen-f64 n 6 false) (gen-f64 n 7 false)))))
      ;; a matrix, a dense slice with an offset and a transposed view (made contiguous inside: the same bits)
      (check c (chain-f64 (t/reshape [5 13] (gen-f64 65 1 false)) (t/reshape [5 13] (gen-f64 65 2 false)) (t/reshape [5 13] (gen-f64 65 3 false)) (t/reshape [5 13] (gen-f64 65 4 true))))
      (check c (chain-f64 (t/slice 0 3 40 1 (gen-f64 50 1 false)) (t/slice 0 5 42 1 (gen-f64 50 2 false)) (t/slice 0 7 44 1 (gen-f64 50 3 false)) (t/slice 0 2 39 1 (gen-f64 50 4 true))))
      (check c (chain-f64 (t/transpose (t/reshape [5 13] (gen-f64 65 1 false))) (t/transpose (t/reshape [5 13] (gen-f64 65 2 false)))
                         (t/transpose (t/reshape [5 13] (gen-f64 65 3 false))) (t/transpose (t/reshape [5 13] (gen-f64 65 4 true)))))
      (check c (chain-mom-f64 (t/slice 0 3 40 1 (gen-f64 50 1 false)) (t/slice 0 5 42 1 (gen-f64 50 2 false)) (t/slice 0 7 44 1 (gen-f64 50 3 false))))
      ;; the result shapes are the inputs'
      (check c (= (t/shape (nth (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 (t/reshape [5 13] (gen-f64 65 1 false)) (t/reshape [5 13] (gen-f64 65 2 false))
                                              (t/reshape [5 13] (gen-f64 65 3 false)) (t/reshape [5 13] (gen-f64 65 4 true))) 0)) [5 13]))
      ;; a second holder of p, m, v and g keeps its values: the step never writes into a shared buffer
      (let ((p (gen-f64 33 1 false)) (g (gen-f64 33 2 false)) (m (gen-f64 33 3 false)) (v (gen-f64 33 4 true)))
        (let ((p-before (bits-f64 p)) (m-before (bits-f64 m)) (v-before (bits-f64 v)) (g-before (bits-f64 g)) (r (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 p g m v)))
          (do (check c (= (bits-f64 p) p-before)) (check c (= (bits-f64 m) m-before)) (check c (= (bits-f64 v) v-before)) (check c (= (bits-f64 g) g-before))
              (check c (!= (bits-f64 (nth r 0)) p-before)))))
      (let ((p (gen-f64 33 1 false)) (g (gen-f64 33 2 false)) (b (gen-f64 33 3 false)))
        (let ((p-before (bits-f64 p)) (b-before (bits-f64 b)) (r (t/sgd-momentum-step! 0.1 0.9 p g b)))
          (do (check c (= (bits-f64 p) p-before)) (check c (= (bits-f64 b) b-before)) (check c (!= (bits-f64 (nth r 0)) p-before)))))))

;; PyTorch: three Adam steps on ten parameters
(defun torch-f64 (c: Checks tol: f64) -> unit
  (let ((p (t/from-array [10] (arr-f64 [1.0 -2.0 0.5 3.0 1.0e-3 100.0 -0.25 0.0 2.5 -7.0]) 0.0))
        (g1 (arr-f64 [0.1 -0.2 0.3 -0.4 1.0e-5 50.0 -0.05 0.0 0.7 -1.5])) (g2 (arr-f64 [0.05 0.1 -0.3 0.2 2.0e-5 -40.0 0.07 0.01 -0.2 1.0]))
        (g3 (arr-f64 [-0.2 0.15 0.05 0.1 -1.0e-5 30.0 0.02 -0.01 0.9 0.5])))
    (let ((z (t/zeros [10])))
      (let ((r1 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 1)) (- 1.0 (ipow 0.999 1)) p (t/from-array [10] g1 0.0) z z)))
        (let ((r2 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 2)) (- 1.0 (ipow 0.999 2)) (nth r1 0) (t/from-array [10] g2 0.0) (nth r1 1) (nth r1 2))))
          (let ((r3 (t/adam-step! 0.01 0.9 0.999 1.0e-8 (- 1.0 (ipow 0.9 3)) (- 1.0 (ipow 0.999 3)) (nth r2 0) (t/from-array [10] g3 0.0) (nth r2 1) (nth r2 2))))
            (do (check c (vclose (vals-f64 (nth r3 0)) [0.9827417759072247 -1.9891883247612172 0.4901821311153249 3.0132772586670757 -0.022833655328610723 99.98629989613359 -0.24523900674381746 -0.006989535870088916 2.478497695420468 -6.989186992922957] tol))
                (check c (vclose (vals-f64 (nth r3 1)) [-0.0073999999999999995 0.007799999999999996 0.002300000000000002 -0.004400000000000002 1.61e-06 3.4499999999999993 0.0042499999999999994 -9.999999999999988e-05 0.12869999999999995 0.01849999999999999] tol))
                (check c (vclose (vals-f64 (nth r3 2)) [5.2477510000000055e-05 7.241004000000008e-05 0.00018223009000000015 0.00020964016000000023 5.994001000000006e-13 4.993402500000004 7.790102500000009e-06 1.999000000000002e-07 0.0013389804900000011 0.003494502250000003] tol)))))))))
(defun torch-mom-f64 (c: Checks tol: f64) -> unit
  (let ((p (t/from-array [4] (arr-f64 [1.0 -2.0 0.5 3.0]) 0.0)) (z (t/zeros [4])))
    (let ((r1 (t/sgd-momentum-step! 0.1 0.9 p (t/from-array [4] (arr-f64 [0.1 -0.2 0.3 -0.4]) 0.0) z)))
      (let ((r2 (t/sgd-momentum-step! 0.1 0.9 (nth r1 0) (t/from-array [4] (arr-f64 [0.05 0.1 -0.3 0.2]) 0.0) (nth r1 1))))
        (let ((r3 (t/sgd-momentum-step! 0.1 0.9 (nth r2 0) (t/from-array [4] (arr-f64 [-0.2 0.15 0.05 0.1]) 0.0) (nth r2 1))))
          (do (check c (vclose (vals-f64 (nth r3 0)) [0.9833999999999999 -1.9798 0.47069999999999995 3.0604] tol))
              (check c (vclose (vals-f64 (nth r3 1)) [-0.07399999999999998 0.07799999999999997 0.023000000000000027 -0.04400000000000004] tol))))))))
(defun arr-f64 (v: (Vec f64)) -> (Array f64)
  (let ((b (cell (array (count v) 0.0)))) (do (dotimes (i (count v)) (array-set! &b i (cv-f64 (nth v i)))) @b)))

(defun main () -> i64
  (let ((c (checks)) (q (checks)))
    (do (check-identity-f32 c) (check-identity-f64 c)
        (torch-f64 c 1.0e-12) (torch-mom-f64 c 1.0e-12) (torch-f32 c 3.0e-6) (torch-mom-f32 c 3.0e-6)
        ;; planted: eps inside the square root is a different formula and must miss PyTorch's values by far more than the tolerance
        (let ((p (t/tensor [1.0 -2.0 0.5])) (g (t/tensor [0.1 -0.2 0.3])) (z (t/zeros [3])))
          (let ((r (t/adam-step! 0.01 0.9 0.999 1.0e-8 0.1 0.001 p g z z)))
            (do (check c (vclose (t/to-vec (nth r 0)) [0.99 -1.99 0.49] 1.0e-6))
                ;; eps = 1 makes the denominator 2 instead of 1.0 and the first step 0.005 instead of 0.01; a wrong oracle that expects 0.01 there must be detected
                (check q (vclose (t/to-vec (nth (t/adam-step! 0.01 0.9 0.999 1.0 0.1 0.001 p g z z) 0)) [0.99 -1.99 0.49] 1.0e-6))
                (check-detects c q))))
        (checks-result c))))
