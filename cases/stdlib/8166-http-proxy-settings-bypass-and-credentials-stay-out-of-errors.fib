;; spec: docs/design/http.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use tl.check fib.coll fib.http.types fib.http.proxy))
(defun err-text (r: (Result Proxy Error)) -> str (match r ((Ok _) "ok") ((Err e) (error-message e))))
(defun main () -> i64
  (let [c (checks)
        env {"http_proxy" "http://u:p%40ss@proxy.corp:3128" "https_proxy" "proxy2:8080" "no_proxy" "internal.example, .corp.test,10.0.0.1:8443"}
        s (proxy-from-env-with (fn (n: str) (get env n)))]
    (do (check c (match (proxy-for s "http" "www.example.com" 80) ((some p) (and (= (. p host) "proxy.corp") (= (. p port) 3128) (some? (. p auth)))) (nil false)))
        (check c (match (proxy-for s "https" "www.example.com" 443) ((some p) (and (= (. p host) "proxy2") (= (. p port) 8080) (not (some? (. p auth))))) (nil false)))
        (check c (not (some? (proxy-for s "http" "internal.example" 80))))
        (check c (not (some? (proxy-for s "https" "a.corp.test" 443))))
        (check c (some? (proxy-for s "http" "xcorp.test" 80)))
        (check c (not (some? (proxy-for s "http" "10.0.0.1" 8443))))
        (check c (some? (proxy-for s "http" "10.0.0.1" 80)))
        (check c (not (some? (. (proxy-from-env-with (fn (n: str) (if (= n "REQUEST_METHOD") (some "GET") (if (= n "HTTP_PROXY") (some "http://evil:1") nil)))) http))))
        (check c (= (err-text (parse-proxy-url "https://user:hunter2@p:1")) "proxy scheme https is not supported: only http proxies"))
        (check c (not (some? (str-find (err-text (parse-proxy-url "socks5://user:hunter2@p:1")) "hunter2" 0))))
        (check c (not (some? (str-find (err-text (parse-proxy-url "http://user:%zz@p:1")) "zz" 0))))
        (checks-result c))))
