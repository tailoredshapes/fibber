;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.4
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; bit-and bit-or bit-xor bit-not popcount shl shr sar on i8 vectors equal the scalar operations lane by lane, with random bit patterns and shift counts up to the width plus 4 (a count is masked to the width as the scalar's is).
(ns main (:use fib.core tl.check))

(defun bits-i8-1 (c: Checks) -> unit
  (let ((a: i8x1 <<27>>i8) (b: i8x1 <<1>>i8) (s: i8x1 <<0>>i8))
    (do (let ((r (bit-and a b)))
      (do
        (check c (= (lane r 0) (bit-and 27i8 1i8)))
        ()))
        (let ((r (bit-or a b)))
      (do
        (check c (= (lane r 0) (bit-or 27i8 1i8)))
        ()))
        (let ((r (bit-xor a b)))
      (do
        (check c (= (lane r 0) (bit-xor 27i8 1i8)))
        ()))
        (let ((r (bit-not a)))
      (do
        (check c (= (lane r 0) (bit-not 27i8)))
        ()))
        (let ((r (popcount a)))
      (do
        (check c (= (lane r 0) (popcount 27i8)))
        ()))
        (let ((r (shl a s)))
      (do
        (check c (= (lane r 0) (shl 27i8 0i8)))
        ()))
        (let ((r (shr a s)))
      (do
        (check c (= (lane r 0) (shr 27i8 0i8)))
        ()))
        (let ((r (sar a s)))
      (do
        (check c (= (lane r 0) (sar 27i8 0i8)))
        ()))
        ())))

(defun bits-i8-3 (c: Checks) -> unit
  (let ((a: i8x3 <<27 -80 69>>i8) (b: i8x3 <<1 100 -57>>i8) (s: i8x3 <<0 3 6>>i8))
    (do (let ((r (bit-and a b)))
      (do
        (check c (= (lane r 0) (bit-and 27i8 1i8)))
        (check c (= (lane r 1) (bit-and -80i8 100i8)))
        (check c (= (lane r 2) (bit-and 69i8 -57i8)))
        ()))
        (let ((r (bit-or a b)))
      (do
        (check c (= (lane r 0) (bit-or 27i8 1i8)))
        (check c (= (lane r 1) (bit-or -80i8 100i8)))
        (check c (= (lane r 2) (bit-or 69i8 -57i8)))
        ()))
        (let ((r (bit-xor a b)))
      (do
        (check c (= (lane r 0) (bit-xor 27i8 1i8)))
        (check c (= (lane r 1) (bit-xor -80i8 100i8)))
        (check c (= (lane r 2) (bit-xor 69i8 -57i8)))
        ()))
        (let ((r (bit-not a)))
      (do
        (check c (= (lane r 0) (bit-not 27i8)))
        (check c (= (lane r 1) (bit-not -80i8)))
        (check c (= (lane r 2) (bit-not 69i8)))
        ()))
        (let ((r (popcount a)))
      (do
        (check c (= (lane r 0) (popcount 27i8)))
        (check c (= (lane r 1) (popcount -80i8)))
        (check c (= (lane r 2) (popcount 69i8)))
        ()))
        (let ((r (shl a s)))
      (do
        (check c (= (lane r 0) (shl 27i8 0i8)))
        (check c (= (lane r 1) (shl -80i8 3i8)))
        (check c (= (lane r 2) (shl 69i8 6i8)))
        ()))
        (let ((r (shr a s)))
      (do
        (check c (= (lane r 0) (shr 27i8 0i8)))
        (check c (= (lane r 1) (shr -80i8 3i8)))
        (check c (= (lane r 2) (shr 69i8 6i8)))
        ()))
        (let ((r (sar a s)))
      (do
        (check c (= (lane r 0) (sar 27i8 0i8)))
        (check c (= (lane r 1) (sar -80i8 3i8)))
        (check c (= (lane r 2) (sar 69i8 6i8)))
        ()))
        ())))

