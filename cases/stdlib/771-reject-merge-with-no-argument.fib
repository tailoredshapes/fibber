;; spec:   stdlib §4.5 (row merge: the macro's error for (merge)), §6.3 (R6a)
;; expect: reject
;; error:  malformed merge: needs at least one argument
;; roots:  ../../lib support
;; covers: merge
;; Clojure's (merge) is nil; a nil has no type here, and a call with nothing to
;; merge is a mistake, so the expansion refuses it.
(ns main (:use fib.core fib.coll))

(defun main () -> i64
  (count (merge)))
