;; spec:   stdlib §4.4 (row cycle: an empty source ends at once); tranche 2 plan Y1 (its walk stops when a whole pass yields nothing)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: cycle take vec first count last reduce empty? seq rest filter
;; A cycle of a source with no elements has no elements. Its walk would go round for ever if it did
;; not stop at a pass that yielded nothing, so each line below is a fold, a take or a search that comes
;; back: the walk ends (it ran to the end), `count` is 0, `last` and `first` are nil, `vec` is [], the
;; seq is nil and the rest of the empty cycle is empty. An empty lazy source (a filter that
;; keeps nothing), an empty Range and an empty string are as empty as an empty Vec.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun none? (x: i64) -> bool false)

(defun main () -> i64
  (let ((c (checks))
        (e: (Vec i64) []))
    (do (check c (= (vec (take 3 (cycle e))) []))
        (check c (= (reduce (fn (a x) (+ a x)) 7 (cycle e)) 7))
        (check c (= (count (cycle e)) 0))
        (check c (= (first (cycle e)) nil))
        (check c (= (last (cycle e)) nil))
        (check c (= (vec (cycle e)) []))
        (check c (empty? (cycle e)))
        (check c (= (match (seq (cycle e)) (nil 0) ((some s) 1)) 0))
        (check c (= (match (seq (rest (cycle e))) (nil 0) ((some s) 1)) 0))
        (check c (= (vec (take 3 (cycle (filter none? [1 2 3])))) []))
        (check c (= (vec (take 3 (cycle (range 0)))) []))
        (check c (= (vec (take 3 (cycle ""))) []))
        (check c (= (vec (take 3 (cycle (cycle e)))) []))
        (checks-result c))))
