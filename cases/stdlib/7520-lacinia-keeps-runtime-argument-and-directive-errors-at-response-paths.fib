;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll tl.check) (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun collection-errors (c: Checks schema: g/GqlCompiledSchema) -> unit
  (let [query "query($x: Boolean = true) { people { name @include(if: $x) } count }"
        list (g/execute schema query {"x" g/NullValue} g/NullValue)
        empty (g/execute schema "query($x: Boolean = true) { emptyPerson { name @include(if: $x) } count }" {"x" g/NullValue} g/NullValue)
        required (g/execute schema "query($x: Boolean = true) { requiredPeople { name @include(if: $x) } count }" {"x" g/NullValue} g/NullValue)
        strict (g/execute schema "query($x: String = \"yes\") { strict(text: $x) count }" {"x" g/NullValue} g/NullValue)]
    (do (check c (= (f/member list "people") (g/ListValue [g/NullValue g/NullValue g/NullValue])))
      (check c (= (count (. list errors)) 2))
      (check c (= (. (nth (. list errors) 0) path) [(g/FieldPath "people") (g/IndexPath 0)]))
      (check c (= (. (nth (. list errors) 1) path) [(g/FieldPath "people") (g/IndexPath 1)]))
      (check c (empty? (. empty errors)))
      (check c (= (f/member empty "count") (g/IntValue 0)))
      (check c (= (f/member required "requiredPeople") g/NullValue))
      (check c (= (count (. required errors)) 1))
      (check c (= (. strict data) (some g/NullValue)))
      (check c (= (count (. strict errors)) 1)))))
(defun main () -> i64
  (let [c (checks) calls (atom 0)]
    (do (match (g/compile-schema (f/definition calls))
      ((Err _) (check c false))
      ((Ok schema)
        (let [argument (g/execute schema "query($x: String = \"yes\") { bad: required(text: $x) count }" {"x" g/NullValue} g/NullValue)
              nested (g/execute schema "query($x: Boolean = true) { person { name @include(if: $x) } count }" {"x" g/NullValue} g/NullValue)
              skipped (g/execute schema "query($x: Boolean = true) { count @include(if: $x) @skip(if: true) }" {"x" g/NullValue} g/NullValue)
              root (g/execute schema "query($x: Boolean = true) { count @include(if: $x) }" {"x" g/NullValue} g/NullValue)]
          (do (check c (= (. argument data) (some (g/ObjectValue {"bad" g/NullValue "count" (g/IntValue 0)} ["bad" "count"]))))
            (check c (= (. (nth (. argument errors) 0) kind) g/ArgumentFailure))
            (check c (= (. (nth (. argument errors) 0) path) [(g/FieldPath "bad")]))
            (check c (= (. nested data) (some (g/ObjectValue {"person" g/NullValue "count" (g/IntValue 0)} ["person" "count"]))))
            (check c (= (. (nth (. nested errors) 0) path) [(g/FieldPath "person")]))
            (check c (= (. skipped data) (some (g/object {}))))
            (check c (empty? (. skipped errors)))
            (check c (= (. root data) (some g/NullValue)))
            (check c (= @calls 3))
            (collection-errors c schema)))))
      (checks-result c))))
