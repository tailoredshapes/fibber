;; spec:   stdlib §4.2 (row ns), syntax §5 (requires may not be cyclic)
;; expect: reject
;; error:  modules require each other in a cycle: main -> a -> b -> a
;; covers: ns
;; Modules are compiled in dependency order against the interfaces of their
;; requires, so a require that closes a ring has no order: a requires b,
;; b requires a, and the error names the ring from the main module.
(ns main (:require [a :as a]))

(defun main () -> i64 (a/fa 1))
