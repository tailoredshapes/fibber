;; spec:   stdlib §4.4 (row range: floats accumulate as Clojure's do), §8.1 item 2
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: range-by
;; 200 seeded float ranges at f64 and 100 at f32, with a start and an end that are tenths and a step that is
;; twentieths (so the sums are not exact), against a loop that adds the step to the previous element: the
;; elements of to-vec, the count, nth of the first, middle and last element, and the lazy seq, compared
;; bit for bit with `=`. The two planted faults: a reference that includes the end, and a reference that
;; computes the elements as a + i*s (Clojure's `frange`, which gives ten elements for (0.0 1.0 0.1) and
;; elements that differ in the last bits), and both must fail the same comparison.
(ns main (:use fib.core fib.seq tl.check tl.rng))

;; the reference at f64; fault 1 includes the end, fault 2 multiplies instead of accumulating
(defun ref64 (lo: f64 hi: f64 by: f64 fault: i64) -> (Vec f64)
  (loop ((x lo) (i 0) (acc (vec-empty)))
    (if (if (> by 0.0) (if (= fault 1) (<= x hi) (< x hi)) (if (= fault 1) (>= x hi) (> x hi)))
        (recur (if (= fault 2) (+ lo (* (sitofp f64 (+ i 1)) by)) (+ x by)) (+ i 1) (vec-conj acc x))
        acc)))

(defun ref32 (lo: f32 hi: f32 by: f32 fault: i64) -> (Vec f32)
  (loop ((x lo) (i 0) (acc (vec-empty)))
    (if (if (> by 0.0f32) (if (= fault 1) (<= x hi) (< x hi)) (if (= fault 1) (>= x hi) (> x hi)))
        (recur (if (= fault 2) (+ lo (* (sitofp f32 (+ i 1)) by)) (+ x by)) (+ i 1) (vec-conj acc x))
        acc)))

(defun same (v: (Vec t) xs: (Vec t)) :where ((Eq t)) -> bool
  (and (= (vec-count v) (vec-count xs))
       (loop ((i 0))
         (if (< i (vec-count v))
             (if (= (vec-nth v i) (vec-nth xs i)) (recur (+ i 1)) false)
             true))))

(defun lseq-elements (s: (LSeq t)) -> (Vec t)
  (loop ((s s) (acc (vec-empty)))
    (match (lnode s)
      ((LNil) acc)
      ((LCons h t) (recur t (vec-conj acc h))))))

;; a range of either float width against the reference's elements
(defun agrees (r: c want: (Vec t)) :where ((Reducible c t) (Eq t)) -> bool
  (let ((n (vec-count want)))
    (and (same (to-vec r) want)
         (and (= (count r) n)
              (and (same (lseq-elements (to-lseq r)) want)
                   (if (> n 0)
                       (and (= (nth r 0) (vec-nth want 0))
                            (and (= (nth r (- n 1)) (vec-nth want (- n 1)))
                                 (= (nth r (quot n 2)) (vec-nth want (quot n 2)))))
                       true))))))

(defun tenths (r: Rng) -> f64 (* (sitofp f64 (- (rng-below r 41) 20)) 0.1))

(defun twentieths (r: Rng) -> f64
  (let ((m (sitofp f64 (+ 1 (rng-below r 12)))))
    (if (= (rng-below r 2) 0) (* m 0.05) (* (- 0.0 m) 0.05))))

;; 200 triples at f64 and 100 at f32 from a seed; the checks count into c
(defun sweep (c: Checks fault: i64) -> unit
  (let ((r (rng 31415926)))
    (do (dotimes (j 200)
          (let ((lo (tenths r)) (hi (tenths r)) (by (twentieths r)))
            (check c (agrees (range-by lo hi by) (ref64 lo hi by fault)))))
        (dotimes (j 100)
          (let ((lo (fptrunc f32 (tenths r))) (hi (fptrunc f32 (tenths r))) (by (fptrunc f32 (twentieths r))))
            (check c (agrees (range-by lo hi by) (ref32 lo hi by fault))))))))

(defun main () -> i64
  (let ((c (checks))
        (inclusive (checks))
        (multiplied (checks)))
    (do (sweep c 0)
        (check c (= (checks-made c) 300))
        (sweep inclusive 1)
        (sweep multiplied 2)
        (check-detects c inclusive)
        (check-detects c multiplied)
        (checks-result c))))
