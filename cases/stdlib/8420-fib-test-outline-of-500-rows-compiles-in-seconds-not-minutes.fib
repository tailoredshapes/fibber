      (then (expect = b (* a 3))))))

(defspecs bad-specs
  (feature "table"
    (outline "wrong" [a b] [[1 2] [2 5] [3 6]]
      (then (expect = b (* a 2))))))

(defun main () -> i64
  (let ((good (specs))
        (bad (bad-specs)))
    (do (if (= (count (. (nth good 0) scenarios)) 500) () (trap "500 rows are 500 scenarios"))
        (if (= (. (nth (. (nth good 0) scenarios) 499) id) "table/triple-500-499-1497-r499") () (trap (str "row 500 id " (. (nth (. (nth good 0) scenarios) 499) id))))
        (if (= (. (nth (. (nth good 0) scenarios) 1) text) "triple #2 [1 3 \"r1\"]") () (trap "row text"))
        (if (= (count (. (nth bad 0) scenarios)) 3) () (trap "3 rows are 3 scenarios"))
        (let ((rc (run-main-with (specs) ["--seed" "1"]))
              (rb (run-main-with (bad-specs) ["--seed" "1" "--only" "wrong-2-2-5"])))
          (if (and (= rc 0) (= rb 1)) 0 (+ 10 (+ (* rc 2) rb)))))))
