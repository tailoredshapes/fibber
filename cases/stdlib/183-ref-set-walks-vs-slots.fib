;; spec:   stdlib §2.1 rule 1 (a Set is a source of its keys), §8.1 item 2, tranche 1 plan §6 L5a
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; 30 seeded sets built by 30 random inserts and removals over the keys 0 to 15 (a key is inserted twice, removed
;; when absent, and inserted again), against a model of a Vec of 16 slots updated in step. For each set: count
;; is the number of present slots; the walk visits every present key exactly once and nothing else (a tally per
;; key is compared with the slots); and an early exit after k visits makes min(k, count) visits and says it did
;; not run to the end exactly when k <= count. The last two checks plant a fault in the model (a removal that
;; is ignored; a key 3 that is never present) and require the same sweep to fail.
(ns main (:use fib.core fib.seq tl.check tl.rng))

(defun zeros (n: i64) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty)))
    (if (< i n) (recur (+ i 1) (vec-conj acc 0)) acc)))

(defun vset (v: (Vec i64) i: i64 x: i64) -> (Vec i64)
  (loop ((j 0) (acc (vec-empty)))
    (if (< j (vec-count v))
        (recur (+ j 1) (vec-conj acc (if (= j i) x (vec-nth v j))))
        acc)))

(defun same (v: (Vec i64) xs: (Vec i64)) -> bool
  (and (= (vec-count v) (vec-count xs))
       (loop ((i 0))
         (if (< i (vec-count v))
             (if (= (vec-nth v i) (vec-nth xs i)) (recur (+ i 1)) false)
             true))))

(defun total (v: (Vec i64)) -> i64
  (loop ((i 0) (acc 0))
    (if (< i (vec-count v)) (recur (+ i 1) (+ acc (vec-nth v i))) acc)))

;; the set and its model after 30 operations; fault 1 ignores removals, fault 2 never adds key 3
(defun build (r: Rng fault: i64) -> (Pair (Set i64) (Vec i64))
  (loop ((j 0) (s (set-empty)) (has (zeros 16)))
    (if (< j 30)
        (let ((k (rng-below r 16)) (insert (< (rng-below r 3) 2)))
          (recur (+ j 1)
                 (if insert (conj s k) (disj s k))
                 (if insert
                     (if (if (= fault 2) (= k 3) false) has (vset has k 1))
                     (if (= fault 1) has (vset has k 0)))))
        (Pair s has))))

;; how many times each key was visited
(defun tally (s: (Set i64)) -> (Vec i64)
  (let ((times (cell (zeros 16))))
    (do (each-while s
          (fn (x) (do (set! times (vset @times x (+ 1 (vec-nth @times x)))) true)))
        @times)))

(defun stop-after (s: (Set i64) k: i64) -> (Pair i64 bool)
  (let ((visits (cell 0)))
    (let ((done (each-while s (fn (x) (do (set! visits (+ @visits 1)) (< @visits k))))))
      (Pair @visits done))))

(defun agrees (r: Rng fault: i64) -> bool
  (let ((b (build r fault))
        (k (+ 1 (rng-below r 18))))
    (let ((n (total (. b snd))) (t (tally (. b fst))) (w (stop-after (. b fst) k)))
      (and (= (count (. b fst)) n)
           (and (same t (. b snd))
                (and (= (. w fst) (if (< k n) k n))
                     (= (. w snd) (> k n))))))))

(defun sweep (c: Checks fault: i64) -> unit
  (let ((r (rng 14142135)))
    (dotimes (j 30) (check c (agrees r fault)))))

(defun main () -> i64
  (let ((c (checks))
        (removals-ignored (checks))
        (missing-key (checks)))
    (do (sweep c 0)
        (check c (= (checks-made c) 30))
        (sweep removals-ignored 1)
        (sweep missing-key 2)
        (check-detects c removals-ignored)
        (check-detects c missing-key)
        (checks-result c))))
