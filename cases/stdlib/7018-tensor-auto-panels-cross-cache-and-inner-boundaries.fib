;; spec: docs/design/numerical-performance.md; automatic panels preserve every output across cache and inner boundaries
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks))
        (a (t/flip 1 (t/reshape [257 129]
             (t/map-as (fn (v: i64) (fdiv (double (- (rem v 17) 8)) 8.0)) 0.0 (t/arange 0 (* 257 129) 1)))))
        (b (t/transpose (t/reshape [129 129]
             (t/map-as (fn (v: i64) (fdiv (double (- (rem (* v 7) 19) 9)) 16.0)) 0.0 (t/arange 0 (* 129 129) 1)))))
        (x (t/map-as (fn (v: f64) (float v)) 0.0f32 a))
        (y (t/map-as (fn (v: f64) (float v)) 0.0f32 b)))
    (do (check c (= (t/to-vec (t/mmul a b)) (t/to-vec (t/mmul-scalar a b))))
        (check c (= (t/to-vec (t/mmul x y)) (t/to-vec (t/mmul-scalar x y))))
        (checks-result c))))
