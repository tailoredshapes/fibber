;; spec:   stdlib §2.3 (Payload), tranche 1 plan §4.3 rule 8
;; expect: trap
;; trap:   payload: nil
;; roots:  ../../lib
;; payload of an empty Option has nothing to give, and a trap's message
;; names the function that trapped (the page's sketch wrote `unwrap: nil`,
;; which is L2's function, not this one's).
(ns main (:use fib.core))

(defun main () -> i64
  (let ((none: (Option i64) nil))
    (payload none)))
