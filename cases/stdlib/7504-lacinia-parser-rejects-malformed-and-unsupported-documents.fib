;; spec: docs/design/lacinia.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check) (:require [fib.lacinia :as g] [fib.lacinia.parser :as p]))
(defun main () -> i64
  (let [c (checks)]
    (do (doseq [query ["{}" "{ x(a: 01) }" "{ x(a: 1e) }" "{ x(a: \"\\uD800\") }"
      "{ x(a: \"unfinished) }" "{ x(a: 1 a: 2) }" "{ x } trailing"
      "query Q($x: Int = ) { x }" "{ x @skip(if: true) }" "{ ...Frag }" "mutation { x }"]]
      (check c (match (p/parse query) ((Err error) (> (count (. error locations)) 0)) (_ false))))
      (check c (match (p/parse "# comment\r\n{ x(a: \"café \\uD83D\\uDE00\", b: [1, 2]) }") ((Ok _) true) (_ false)))
      (check c (match (p/parse "{\n  ?\n}") ((Err error) (let [pos (nth (. error locations) 0)] (and (= (. pos line) 2) (= (. pos column) 3)))) (_ false)))
      (checks-result c))))
