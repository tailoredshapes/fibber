;; spec:   stdlib §4.4 row reductions, §7 L1
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reductions
;; (reductions f c) is (reductions f (first c) (rest c)): the running values from the first element on. For an empty c Clojure
;; answers (f), which a typed f cannot be asked for, so here it is the empty seq (decided in Y11). Lazy: f runs as nodes are demanded.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun none () -> (Vec i64) [])

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (vec (reductions + [1 2 3 4])) [1 3 6 10]))
        (check c (= (vec (reductions + [5])) [5]))
        (check c (= (vec (reductions + (none))) []))
        (check c (= (vec (take 4 (reductions + (iterate inc 1)))) [1 3 6 10]))
        (check c (= (vec (reductions (fn (a: i64 x: i64) (* a x)) [1 2 3 4])) [1 2 6 24]))
        
        (checks-result c))))
