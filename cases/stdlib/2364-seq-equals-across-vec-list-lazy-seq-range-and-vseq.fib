;; spec:   stdlib §4.4 row seq=, §2.7 (equality across Reducibles; `=` is on one type), A10 showseq
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: seq=
;; (seq= a b) is true when the two Reducibles have equal elements one by one and end together, whatever their types:
;; `(= [1] (list 1))` is `cannot unify` (§2.7), `seq=` runs (A10 showseq: `(seq= (map inc [1 2]) [2 3])` is true).
;; The case builds [1 2 3] seven ways (a Vec, a List, a lazy seq, a Range, a VSeq with no front and one with a front
;; element, an Array) and compares each with each, in both roles, so all forty-nine pairs are true; then each is
;; compared with shorter, longer, empty and different sequences, which are all false, so a `seq=` that only looked at
;; the shorter operand or at the first element fails. The elements may be of any type with `Eq`: strings, pairs, vectors.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun none () -> (Vec i64) (vec-empty))

;; all of the results are true
(defun all (v: (Vec bool)) -> bool (every? (fn (b: bool) b) v))

;; a is [1 2 3]: equal to each of the seven builds of it
(defun equal-to-all (a: c) :where ((Reducible c i64)) -> bool
  (all [(seq= a [1 2 3])
        (seq= a (list 1 2 3))
        (seq= a (map inc [0 1 2]))
        (seq= a (range 1 4))
        (seq= a (rest [0 1 2 3]))
        (seq= a (conj (rest [9 2 3]) 1))
        (seq= a (array-with (array-with (array-with (array 3 0) 0 1) 1 2) 2 3))]))

;; a is [1 2 3]: equal to none of these
(defun equal-to-none (a: c) :where ((Reducible c i64)) -> bool
  (all [(not (seq= a [1 2 4]))
        (not (seq= a [0 2 3]))
        (not (seq= a [1 2]))
        (not (seq= a [1 2 3 4]))
        (not (seq= a (none)))
        (not (seq= a (list 1 2)))
        (not (seq= a (range 1 3)))
        (not (seq= a (range 1 5)))
        (not (seq= a (map inc [0 1 3])))]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (equal-to-all [1 2 3]))
        (check c (equal-to-all (list 1 2 3)))
        (check c (equal-to-all (map inc [0 1 2])))
        (check c (equal-to-all (range 1 4)))
        (check c (equal-to-all (rest [0 1 2 3])))
        (check c (equal-to-all (conj (rest [9 2 3]) 1)))
        (check c (equal-to-all (array-with (array-with (array-with (array 3 0) 0 1) 1 2) 2 3)))
        (check c (equal-to-none [1 2 3]))
        (check c (equal-to-none (list 1 2 3)))
        (check c (equal-to-none (map inc [0 1 2])))
        (check c (equal-to-none (range 1 4)))
        (check c (equal-to-none (rest [0 1 2 3])))
        (check c (equal-to-none (conj (rest [9 2 3]) 1)))
        ;; two empty sequences are equal
        (check c (seq= (none) (none)))
        (check c (not (seq= (none) (list 0))))
        (check c (seq= (range 0) (rest (none))))
        ;; other element types
        (check c (seq= ["a" "b"] (list "a" "b")))
        (check c (not (seq= ["a" "b"] (list "a" "c"))))
        (check c (seq= (zip [1 2] [3 4]) (zip [1 2] [3 4])))
        (check c (not (seq= (zip [1 2] [3 4]) (zip [1 2] [3 5]))))
        (check c (seq= [[1 2] [3]] (list [1 2] [3])))
        (check c (seq= "abc" [\a \b \c]))
        (check c (not (seq= "abc" [\a \b])))
        (check c (seq= (range-by 0.0 1.0 0.25) [0.0 0.25 0.5 0.75]))
        (checks-result c))))
