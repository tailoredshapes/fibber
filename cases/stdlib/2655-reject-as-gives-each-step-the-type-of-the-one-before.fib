;; spec:   stdlib §4.3 (row as->), tranche 2 plan Y6
;; expect: reject
;; error:  cannot unify i64 with str
;; roots:  ../../lib support
;; covers: as->
;; (as-> 5 v (str v) (+ v 1)): the second form sees v as the text the first made, so adding 1 to it is the
;; checker's refusal, not a coercion. The macro adds no check of its own: its expansion is nested lets, and the
;; type of v changes at each (the same program with v at i64 throughout, case 2654, runs).
(ns main (:use fib.core))

(defun main () -> i64
  (as-> 5 v (str v) (+ v 1)))
