;; spec:   docs/design/exceptions.md 4.2 (stage 2), stdlib §2.10 step 2 (rows throw try catch finally); docs/adr/0009
;; expect: accept
;; result: 12
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `(try-result body..)` is the body's value as Ok, or Err with what it threw or trapped (the bridge to try-let and match). Killed by:
;; scripts/mutant-catch.sh `no-catch`.
(ns main (:use fib.core fib.ex))

(defun main () -> i64
  (+ (match (try-result (nth [1 2 3] 5)) ((Ok v) v) ((Err e) (if (= (ex-kind e) (some "index")) 10 0)))
     (match (try-result (+ 1 1)) ((Ok v) v) ((Err e) 100))))
