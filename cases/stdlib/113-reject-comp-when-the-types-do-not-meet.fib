;; spec:   stdlib §4.3 (row comp: `(fn (B) C) (fn (A..) B) -> (fn (A..) C)`)
;; expect: reject
;; error:  cannot unify (fn :send (i64) (Option i64)) with (fn (i64) i64)
;; roots:  ../../lib
;; covers: comp
;; (comp f g) applies g and hands the result to f, so f must take what g
;; returns: `(comp twice halve)` hands an Option to a function of an i64.
;; Clojure would fail at run time with a ClassCastException; here the
;; composition is refused at the checker, with the two function types.
(ns main (:use fib.core))

(defun twice (x: i64) -> i64 (* x 2))
(defun halve (x: i64) -> (Option i64) (if (= (rem x 2) 0) (some (quot x 2)) nil))

(defun main () -> i64
  ((comp twice halve) 4))
