;; spec:   syntax §1.1 (ratio), stdlib §7 E14
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; 7/2 reads as the call (/ 7 2): decimal digits, a slash, decimal digits,
;; the sign on the first only. The division of two integers is a ratio in
;; lowest terms.
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= 7/2 (/ 7 2)))
        (check c (= (numerator 7/2) 7))
        (check c (= (denominator 7/2) 2))
        (check c (= (numerator -7/2) -7))
        (check c (= (numerator 6/4) 3))
        (check c (= (denominator 20/5) 1))
        (check c (= (numerator (+ 1/2 1/3)) 5))
        (checks-result c))))
