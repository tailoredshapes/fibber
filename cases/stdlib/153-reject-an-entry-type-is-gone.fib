;; spec:   stdlib §2.3 (the prelude's Entry gives way to Pair), §8.3 C
;; expect: reject
;; error:  unknown type Entry
;; roots:  ../../lib support
;; The prelude defines no Entry any more: a function that names the type of a map's entry is refused,
;; and the entry is written (Pair k v).
(ns main)

(defun first-key (e: (Entry i64 i64)) -> i64 (. e key))

(defun main () -> i64 0)
