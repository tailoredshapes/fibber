;; spec:   stdlib §7 L15, syntax §3.19
;; expect: trap
;; trap: def broken: config missing
;; roots:  ../../lib support
;; covers: def
;; Nothing reads `broken`, and its initialiser reaches the trap through a function of the program: it still runs before `main`
;; (the compiler may drop an unread `def` only when it cannot trap).
(defun load-config (n: i64) -> i64 (if (> n 0) (trap "config missing") n))
(def broken: i64 (load-config 1))

(defun main () -> i64 0)
