;; spec:   stdlib §2.3 (Reducible: nth traps out of range), §1.2 P5; plan §6 L5a and MUT-L5a
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; The float range-nth walks from the start until it reaches the index, so a negative index, which it never
;; reaches, is refused before the walk starts and not by the walk running out. Case 184 refuses -1 on a range
;; that ends, where a walk that ran out would trap with the same words; this range has a NaN end, which
;; never stops a walk (case 162), so the walk would not return, and only the refusal up front can trap.
(ns main (:use fib.core fib.seq))

(defun nan () -> f64 (bits->f64 9221120237041090560))

(defun main () -> i64
  (if (= (range-nth 0.0 (nan) 1.0 -1) 0.0) 1 0))
