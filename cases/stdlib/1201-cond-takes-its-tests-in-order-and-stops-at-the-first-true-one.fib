;; spec:   stdlib §6.3 (E4); syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: cond
;; A test after the true one is not evaluated, an expression that is not taken is not evaluated, and the
;; symbol else is a variable like any other: it is the default only as the keyword :else.
(ns main (:use tl.check))

(defun main () -> i64
  (let [c (checks)
        hits (atom 0)
        else false]
    (do (check c (= (cond (do (swap! hits + 1) false) 1
                          (do (swap! hits + 10) true) (do (swap! hits + 100) 2)
                          (do (swap! hits + 1000) true) 3
                          :else 4)
                    2))
        (check c (= @hits 111))
        (check c (= (cond else 1 :else 2) 2))
        (let [else true]
          (check c (= (cond else 1 :else 2) 1)))
        (checks-result c))))
