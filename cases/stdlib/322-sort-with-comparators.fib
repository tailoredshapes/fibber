;; spec:   stdlib §2.3 (Cmp: a comparator is any function whose result is a Cmp), §4.4 (rows sort/2, sort-by/3)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: sort sort-by
;; A comparator returns an i64 (negative, zero, positive) or a bool, which
;; is Clojure's predicate form (true means "before"; a false asks the
;; swapped call). `<` and `>` are function values and work as predicates,
;; a named function and an i64 function work too; sort-by/3 takes the
;; comparator for the keys. A predicate that is true for equal elements
;; (`<=`) still sorts: true means "before", so the left element of a tie goes first.
(ns main (:use fib.core fib.seq tl.check))

(defstruct Item (key: i64 id: i64))

(defun same (a: (Vec e) b: (Vec e)) :where ((Eq e)) -> bool
  (if (= (vec-count a) (vec-count b))
      (loop ((i 0))
        (if (< i (vec-count a))
            (if (= (vec-nth a i) (vec-nth b i)) (recur (+ i 1)) false)
            true))
      false))

(defun lt? (a: i64 b: i64) -> bool (< a b))
(defun by-distance (a: i64 b: i64) -> i64 (- (if (< a 0) (- 0 a) a) (if (< b 0) (- 0 b) b)))

(defun ids (v: (Vec Item)) -> (Vec i64)
  (loop ((i 0) (acc (vec-empty))) (if (< i (vec-count v)) (recur (+ i 1) (vec-conj acc (. (vec-nth v i) id))) acc)))

(defun main () -> i64
  (let ((c (checks))
        (xs [3 1 4 1 5 9 2 6 5 3 5])
        (items [(Item 2 0) (Item 1 1) (Item 2 2) (Item 1 3) (Item 3 4)]))
    (do (check c (same (to-vec (sort < xs)) [1 1 2 3 3 4 5 5 5 6 9]))
        (check c (same (to-vec (sort > xs)) [9 6 5 5 5 4 3 3 2 1 1]))
        (check c (same (to-vec (sort lt? xs)) [1 1 2 3 3 4 5 5 5 6 9]))
        (check c (same (to-vec (sort (fn (a b) (- a b)) xs)) [1 1 2 3 3 4 5 5 5 6 9]))
        (check c (same (to-vec (sort (fn (a b) (- b a)) xs)) [9 6 5 5 5 4 3 3 2 1 1]))
        (check c (same (to-vec (sort by-distance [-5 3 -1 4 -2 0])) [0 -1 -2 3 4 -5]))
        (check c (same (to-vec (sort <= xs)) [1 1 2 3 3 4 5 5 5 6 9]))
        (check c (same (to-vec (sort > [7])) [7]))
        (check c (same (ids (to-vec (sort-by (fn (p) (. p key)) < items))) [1 3 0 2 4]))
        (check c (same (ids (to-vec (sort-by (fn (p) (. p key)) > items))) [4 0 2 1 3]))
        (check c (same (ids (to-vec (sort-by (fn (p) (. p key)) (fn (a b) (- b a)) items))) [4 0 2 1 3]))
        (check c (same (to-vec (sort-by (fn (s) (str-len s)) > ["a" "ccc" "bb" "dd"])) ["ccc" "bb" "dd" "a"]))
        (checks-result c))))
