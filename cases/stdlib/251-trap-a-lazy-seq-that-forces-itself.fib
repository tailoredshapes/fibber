;; spec:   stdlib §2.1 rule 2 (a seq that forces itself traps), §4.4 row lazy-seq
;; expect: trap
;; trap:   lazy-seq: a seq forced itself
;; roots:  ../../lib support
;; covers: lazy-seq map
;; The body of a lazy-seq that demands the very seq it is computing has no
;; value to give. Here the seq s is (lazy-seq (map f s)): its first node
;; needs the first node of s, which is the node being made. Clojure's lazy
;; seq throws there; this one traps with a message that names the form
;; instead of looping or reading a half-made node. The seq is reached
;; through a cell set after it is made.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((r: (Cell (Option (LSeq i64))) (cell nil)))
    (let ((s (lazy-seq (map (fn (x: i64) (+ x 1))
                            (match @r ((some t) t) (nil (to-lseq [0])))))))
      (do (set! r (some s))
          (count s)))))
