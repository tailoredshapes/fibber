;; spec:   stdlib §6.3 (E3); syntax §3.3
;; expect: reject
;; error:  malformed let: a binding is a pattern and an expression, or name: a type and an expression
;; roots:  ../../lib support
;; covers: let
;; The binding vector is pairs: the last name has no expression.
(ns main (:use fib.core))

(defun main () -> i64
  (let [a 1
        b]
    a))
