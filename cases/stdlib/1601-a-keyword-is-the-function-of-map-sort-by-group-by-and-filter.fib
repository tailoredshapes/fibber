;; spec:   stdlib §7 L14, §4.4 (map, sort-by, group-by, filter)
;; expect: accept
;; result: 98522
;; audit:  clean
;; roots:  ../../lib support
;; covers: :k map sort-by group-by filter
;; The commonest Clojure lines: a keyword where a function is expected is the field read of each element.
;; ages 30 + 25 + 41 = 96 (map :age); the youngest, 25 (sort-by); dept 1 has two and dept 2 one (group-by);
;; one person is active (filter :active). So 96000 + 2500 + 20 + 1 + 1.
(defstruct Person (name: str age: i64 dept: i64 active: bool))

(defun main () -> i64
  (let ((ps [(Person "ann" 30 1 true) (Person "bob" 25 2 false) (Person "cy" 41 1 false)])
        (youngest (match (first (sort-by :age ps)) ((some p) (:age p)) (nil 0)))
        (groups (group-by :dept ps))
        (n1 (match (get groups 1) ((some g) (count g)) (nil 0)))
        (n2 (match (get groups 2) ((some g) (count g)) (nil 0))))
    (+ (+ (* 1000 (reduce + 0 (map :age ps))) (* 100 youngest))
       (+ (+ (* 10 n1) n2) (* 1 (count (filter :active ps)))))))
