;; spec:   stdlib §2.7 (Show: nil and a present value; a seq in parentheses), tranche 1 plan C-14
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: str
;; Show of an Option and of a List are the prelude's (R2, cases/ownership 205); Show of
;; every other type is this library's. They compose: a present value is its payload's
;; text at every depth, nil is `nil` (where `str` of a nil is the empty text, which is
;; Clojure's (str nil)), a List is in parentheses as the other seqs are, and a Pair, a
;; Triple and a Vec hold their elements through the same instances. A List, a VSeq and
;; an LSeq of the same elements print alike under all three printers.
(ns main (:use fib.core fib.seq fib.print tl.check))

(defun main () -> i64
  (let ((c (checks))
        (none: (Option i64) nil)
        (opts: (Vec (Option i64)) [(some 1) nil (some 3)])
        (lopts: (List (Option i64)) (list (some 1) nil))
        (e: (List i64) (list))
        (words (list "a" "b"))
        (vs (rest [0 1 2]))
        (lz (lseq-vec [1 2])))
    (do (check c (= (show (some 3)) "3"))
        (check c (= (show none) "nil"))
        (check c (= (str none) ""))
        (check c (= (show (some "a")) "a"))
        (check c (= (show (some (list 1))) "(1)"))
        (check c (= (show (list 1 2)) "(1 2)"))
        (check c (= (show e) "()"))
        (check c (= (show words) "(a b)"))
        (check c (= (debug words) "(\"a\" \"b\")"))
        (check c (= (str words) "(\"a\" \"b\")"))
        (check c (= (show opts) "[1 nil 3]"))
        (check c (= (show lopts) "(1 nil)"))
        (check c (= (show (Pair (some 1) none)) "[1 nil]"))
        (check c (= (show (Triple (some "a") none (list 1))) "[a nil (1)]"))
        (check c (= (show (list (Pair 1 2))) "([1 2])"))
        (check c (= (show (list 1 2)) (show lz)))
        (check c (= (show (list 1 2)) (show (rest [0 1 2]))))
        (check c (= (show vs) "(1 2)"))
        (check c (= (debug (list 1 2)) (debug lz)))
        (check c (= (str (list 1 2)) (str lz)))
        (checks-result c))))
