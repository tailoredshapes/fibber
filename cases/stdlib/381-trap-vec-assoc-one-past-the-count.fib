;; spec:   stdlib §2.3 (Assoc), §4.5 (assoc: beyond the count it traps), Appendix A11 e6
;; expect: trap
;; trap:   assoc: index out of range
;; roots:  ../../lib support
;; covers: assoc
;; The index equal to the count appends (case 380); the next one, count + 1,
;; is where Clojure's (assoc [10 20] 3 30) throws IndexOutOfBounds, and here
;; the trap names the function. A Vec has no holes: index 2 would have to
;; hold something before index 3 could.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64 (nth (assoc [10 20] 3 30) 0))
