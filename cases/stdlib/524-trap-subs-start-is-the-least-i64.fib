;; spec:   stdlib §4.3 (row subs), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   subs: index out of range
;; roots:  ../../lib support
;; The least i64 is a negative bound like any other: it is out of range and
;; the message says so, where a count that went down by one from it would
;; overflow and trap with a different message. The call before it, with a
;; start of 0, is fine.
(ns main (:use fib.core fib.seq))

(defun least () -> i64 (- (- 0 (+ (shl 1 62) (- (shl 1 62) 1))) 1))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (count (subs s 0 2))
       (count (subs s (least) 2)))))
