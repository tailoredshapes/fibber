;; spec:   stdlib §5.5 S12, syntax §1.1, §7 E14 (Clojure's reader)
;; expect: accept
;; result: 8
;; audit:  clean
;; open:   E14
;; Clojure's unquote is ~x. Today the reader knows `,x` (a comma touching a
;; form is the unquote) and `~` is `unknown reader syntax`. E14 reads ~x and
;; ~@x, makes the comma whitespace, and migrates every ,x of lib/ and the
;; compiler in the same commit.
(defmacro twice (x) `(+ ~x ~x))

(defun main () -> i64 (twice 4))
