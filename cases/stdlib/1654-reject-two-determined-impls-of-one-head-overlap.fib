;; spec:   types §4.1 (one instance per (P, K)), stdlib §7 L16
;; expect: reject
;; error:  overlapping instances
;; A determined variable does not make a second instance for the head `(Box c)` another key: the pair (Cur, Box) is taken.
(ns main (:use fib.core))

(defprotocol (Cur s c) (cur (self) -> c))
(defstruct Src (n: i64))
(defstruct (Wrap k) (v: k))
(defstruct (Box c) (inner: c))
(impl (Cur i64) Src (cur (self) (. self n)))
(impl (Cur (Wrap k)) (Box c) :where ((Cur c k))
  (cur (self) (Wrap (cur (. self inner)))))
(impl (Cur k) (Box c) :where ((Cur c k))
  (cur (self) (cur (. self inner))))

(defun main () -> i64 0)
