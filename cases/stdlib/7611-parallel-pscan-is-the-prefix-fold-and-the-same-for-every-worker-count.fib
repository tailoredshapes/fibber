;; spec:   docs/design/parallelism.md 3.2 (pscan); lib/fib/parallel/scan.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; `pscan` is the inclusive prefix fold: for integers it equals `reductions` (serial, left to right) for 0 to 1000 elements, grains 1, 3, 7 and
;; the default, and 1 to 28 workers; for inexact f64 over 200 001 elements (4 chunks of the grain 65 536) its bits are the same for every
;; worker count and equal a reference written out here (each chunk scanned from the carry, the carry the left to right fold of the earlier chunk
;; totals). A wrong carry (the carry of the chunk before, or none) fails the integer rows; a chunk bound off by one fails the length rows.
(ns main (:use fib.core fib.parallel tl.check tl.rng))

(defun datum (i: i64) -> f64 (/ (double (- (rem (* 11 i) 101) 50)) 7.0))

(defun ref-scan (xs: (Vec f64) grain: i64) -> (Vec f64)
  (let [n (vec-count xs)
        totals (loop [lo 0 out []]
                 (if (< lo n)
                     (recur (+ lo grain) (conj out (loop [i lo acc 0.0] (if (< i (min n (+ lo grain))) (recur (+ i 1) (+ acc (nth xs i))) acc))))
                     out))]
    (loop [lo 0 k 0 carry 0.0 out []]
      (if (< lo n)
          (let [hi (min n (+ lo grain))
                r (loop [i lo acc carry o out] (if (< i hi) (let [v (+ acc (nth xs i))] (recur (+ i 1) v (conj o v))) o))]
            (recur hi (+ k 1) (+ carry (nth totals k)) r))
          out))))

(defun main () -> i64
  (let [c (checks) r (rng 7611)]
    (do (doseq [n [0 1 2 10 63 64 65 1000]]
          (let [xs (rng-vec r n 1000) want (vec (reductions + 0 xs))]
            (doseq [w [1 2 3 8 28]]
              (doseq [grain [0 1 3 7]]
                (check c (= (pscan (Par w grain false) + 0 xs) (if (= n 0) [] (vec (rest want)))))))))
        (let [xs (mapv datum (vec (range 200001))) want (ref-scan xs 65536)]
          (doseq [w [1 2 3 4 7 8 16 28]]
            (check c (= (pscan (Par w 0 false) + 0.0 xs) want))))
        (checks-result c))))
