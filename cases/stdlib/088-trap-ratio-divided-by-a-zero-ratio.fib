;; spec:   stdlib §2.8 ((Ratio t)), §4.1 (row /)
;; expect: trap
;; trap:   ratio: divide by zero
;; roots:  ../../lib
;; covers: /
;; A ratio over a ratio whose numerator is zero has no value: the Div
;; instance of the ratio makes the quotient (1*1)/(2*0), and the denominator
;; zero is the same trap as case 066's.
(ns main (:use fib.core))

(defun main () -> i64
  (numerator (/ (/ 1 2) (/ 0 5))))
