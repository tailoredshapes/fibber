;; spec: docs/design/compress.md 9.1 (the jobs are tasks of the pool), docs/design/parallelism.md 8
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; Compress and decompress with `threads` 8 INSIDE the body of a pmap over 12 inputs (each of 1.3 MB, 64 KiB blocks, so every call forks runners) give the same bytes as the same calls
;; made one after the other, and the process has no more threads than the pool's workers plus the program's own: a call inside a pool task forks onto the pool and does not start 8 threads of its
;; own (12 x 8 OS threads ran before the engine moved onto the pool). The thread count is read from /proc/self/task after the parallel work, and is sampled by a task inside the nest.
(ns main (:use fib.core fib.parallel fib.os fib.os.process tl.check fib.compress.lz4.mem) (:require [fib.compress :as z] [fib.compress.lz4 :as lz4]))

(defun data (seed: i64) -> (Array i8)
  (let [c (cell (array 1300000 0i8))]
    (do (dotimes (i 1300000) (array-set! &c i (trunc i8 (+ (rem (* i (+ 3 seed)) 37) (if (= (rem i (+ 997 seed)) 0) (rem (* i 31) 251) 0)))))
        @c)))

(defun opts () -> z/Options (z/with-block-size (z/with-threads (z/default-options) 8) 65536))

(defun round-trip (seed: i64) -> (Pair (Array i8) i64)
  (let [d (data seed) k (lz4/lz4)]
    (match (z/compress k d (opts))
      ((Ok zb) (match (z/decompress k zb (opts))
                 ((Ok back) (Pair zb (if (bytes-eq back d) (max 1 (unwrap-or (thread-count) 1)) -1)))
                 ((Err _) (Pair zb -2))))
      ((Err _) (Pair (array 0 0i8) -3)))))

(defun main () -> i64
  (let [c (checks)
        nested (pmap round-trip (vec (range 12)))
        serial (mapv round-trip (vec (range 12)))
        threads (unwrap-or (thread-count) -1)]
    (do (check c (every? (fn (p: (Pair (Array i8) i64)) (> (. p snd) 0)) nested))
        (check c (every? (fn (i: i64) (bytes-eq (. (nth nested i) fst) (. (nth serial i) fst))) (range 12)))
        (check c (every? (fn (p: (Pair (Array i8) i64)) (<= (. p snd) (+ (pool-workers) 1))) nested))
        (check c (>= threads 1))
        (check c (<= threads (+ (pool-workers) 1)))
        (checks-result c))))
