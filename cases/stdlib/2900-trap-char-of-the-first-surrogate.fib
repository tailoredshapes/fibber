;; spec:   stdlib §4.3 (row char), §2.8 (conversions are checked)
;; expect: trap
;; trap:   char: value out of range
;; roots:  ../../lib support
;; covers: char
;; U+D800 is the first surrogate: 55295 is a character (case 2850), 55296 is not a Unicode scalar
;; and so no `char` (types §1.1).
(defun main () -> i64 (sext i64 (char->i32 (char 55296i32))))
