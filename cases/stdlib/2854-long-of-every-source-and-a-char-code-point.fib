;; spec:   stdlib §4.3 (row long), §2.3 (ToLong), §2.8 (a char gives its code point; `sext` widens unchecked)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: long
;; `(long x)` over an i8, an i16, an i32 (widened), an i64 (itself), an f32, an f64 and a
;; char. An f64 is cut toward zero: 9.2e18 is a long, so are -9223372036854775808.0 (the
;; minimum) and 9223372036854774784.0 (the greatest f64 below 2^63, 1024 short of the maximum).
(ns main (:use tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (long 127i8) 127))
        (check c (= (long -128i8) -128))
        (check c (= (long 32767i16) 32767))
        (check c (= (long -32768i16) -32768))
        (check c (= (long 2147483647i32) 2147483647))
        (check c (= (long -2147483648i32) -2147483648))
        (check c (= (long 9223372036854775807) 9223372036854775807))
        (check c (= (long -9223372036854775808) -9223372036854775808))
        (check c (= (long 0) 0))
        (check c (= (long 2.7) 2))
        (check c (= (long -2.7) -2))
        (check c (= (long 0.9) 0))
        (check c (= (long -0.9) 0))
        (check c (= (long 9.2e18) 9200000000000000000))
        (check c (= (long -9223372036854775808.0) -9223372036854775808))
        (check c (= (long 9223372036854774784.0) 9223372036854774784))
        (check c (= (long 3.5f32) 3))
        (check c (= (long -3.5f32) -3))
        (check c (= (long 16777216.0f32) 16777216))
        (check c (= (long \a) 97))
        (check c (= (long \😀) 128512))
        (check c (= (long (char 1114111)) 1114111))
        (check c (= (- (long \z) (long \a)) 25))
        (checks-result c))))
