;; spec:   stdlib §4.1 (rows + and *), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: + *
;; (+) is 0 and (*) is 1, the identities, as Clojure's; (+ a) and (* a) are a;
;; three or more fold from the left, each argument evaluated once, in order
;; (the cells record the order). The binary call stays the builtin's: it is
;; what the folds are made of, so (+ 1 2) and (+ (+ 1 2) 3) agree with
;; (+ 1 2 3). The macro does not widen: a literal of another width folds at
;; its own width ((+ 1i8 2i8 3i8) is an i8), and the call of nothing is an i64.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (trail (cell 0))
        (a 10) (b 20))
    (do (check c (= (+) 0))
        (check c (= (*) 1))
        (check c (= (+ 7) 7))
        (check c (= (* 7) 7))
        (check c (= (+ 1 2) 3))
        (check c (= (+ 1 2 3) 6))
        (check c (= (+ 1 2 3 4 5) 15))
        (check c (= (* 2 3 4) 24))
        (check c (= (* 1 2 3 4 5 6) 720))
        (check c (= (+ a b 5) 35))
        (check c (= (+ a b a b) 60))
        (check c (= (* a b 2) 400))
        (check c (= (+ 1i8 2i8 3i8) 6i8))
        (check c (= (* 2i32 3i32 4i32) 24i32))
        (check c (= (+ 0.5 0.25 0.25) 1.0))
        (check c (= (+ 1 (+ 2 3 4) (* 5 6 7)) 220))
        ;; each argument once, left to right: 1 then 2 then 3 gives 123
        (check c (= (+ (do (set! trail (+ (* @trail 10) 1)) 1)
                       (do (set! trail (+ (* @trail 10) 2)) 2)
                       (do (set! trail (+ (* @trail 10) 3)) 3))
                    6))
        (check c (= @trail 123))
        (checks-result c))))
