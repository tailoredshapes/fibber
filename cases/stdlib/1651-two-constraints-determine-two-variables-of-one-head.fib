;; spec:   types §3.3 and §4.1 (the liberal coverage condition), stdlib §7 L16
;; expect: accept
;; result: 42
;; audit:  clean
;; roots:  ../../lib support
;; Each of `k` and `j` is determined by a constraint on its own head variable, and both stand in the determined argument of the instance.
(ns main (:use fib.core))

(defprotocol (Cur s c) (cur (self) -> c))
(defstruct Src (n: i64))
(defstruct Txt (s: str))
(defstruct (Two k j) (a: k b: j))
(defstruct (Duo a b) (l: a r: b))
(impl (Cur i64) Src (cur (self) (. self n)))
(impl (Cur str) Txt (cur (self) (. self s)))
(impl (Cur (Two k j)) (Duo a b) :where ((Cur a k) (Cur b j))
  (cur (self) (Two (cur (. self l)) (cur (. self r)))))

(defun main () -> i64
  (let ((t (cur (Duo (Src 40) (Txt "ab")))))
    (+ (. t a) (str-len (. t b)))))
