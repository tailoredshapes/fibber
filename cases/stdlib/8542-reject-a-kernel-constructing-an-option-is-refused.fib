;; spec:   types §2.17 (the kernel subset), syntax §3.22 (defkernel); docs/design/gpu.md 3
;; expect: reject
;; error:  .fib:9:24: kernel k: a constructor of Option: a kernel allocates nothing
;; An `Option` is data (an object, or a pair with a tag): its constructor `some` is refused where it is called, before the `match` on it
;; (whose patterns over data the checker refuses too: a kernel matches literals, wildcards and names only).
(ns main (:require [fib.gpu :as gpu]))
(defkernel k (a: ptr n: i64)
  (let ((i (gpu/global-id 0)))
    (match (if (< i n) (some i) nil)
      ((some j) (gpu/f32-set! a j 1.0f32))
      (nil ()))))
(defun main () -> i64 0)
