;; spec:   docs/design/parallelism.md 3.5 (P-det), 2.7; lib/fib/parallel/reduce.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; The deterministic fixed tree: `preduce` of inexact f64 values (((11 i) mod 101 - 50) / 7) over 400 003 elements (7 chunks of the grain
;; 65 536, the last short) gives the SAME bits for 1, 2, 3, 4, 7, 8, 16 and 28 workers, and the bits of a reference tree written out here with
;; plain loops: chunk sums from 0.0 in index order, then adjacent pairs level by level. The sequential path (one worker) is that tree too.
;; Planted fault (`p`): the `fast` mode (one chunk per worker, left to right) depends on the worker count and the same check fails on it,
;; so the check can fail. scripts/mutant-parallel.sh breaks the library two ways (a grain taken from the worker count; a left to right
;; combine of the chunk results) and this case must fail under both.
(ns main (:use fib.core fib.parallel tl.check))

(defun datum (i: i64) -> f64 (/ (double (- (rem (* 11 i) 101) 50)) 7.0))

(defun chunk-sum (lo: i64 hi: i64) -> f64
  (loop [i lo acc 0.0] (if (< i hi) (recur (+ i 1) (+ acc (datum i))) acc)))

;; the reference: chunk sums, then pairs
(defun ref-level (xs: (Vec f64)) -> (Vec f64)
  (loop [i 0 out []]
    (cond (>= i (vec-count xs)) out
          (= (+ i 1) (vec-count xs)) (recur (+ i 2) (conj out (nth xs i)))
          :else (recur (+ i 2) (conj out (+ (nth xs i) (nth xs (+ i 1))))))))

(defun ref-tree (n: i64) -> f64
  (let [sums (loop [lo 0 out []] (if (< lo n) (recur (+ lo 65536) (conj out (chunk-sum lo (min n (+ lo 65536))))) out))]
    (loop [level sums] (if (= (vec-count level) 1) (nth level 0) (recur (ref-level level))))))

(defun psum (p: Par n: i64) -> f64
  (preduce-n p + 0.0 (fn (i) (datum i)) n))

(defun psum-chunks (p: Par n: i64) -> f64
  (pfold-chunks p n + 0.0 (fn (lo hi) (chunk-sum lo hi))))

(defun all-equal (xs: (Vec f64)) -> bool
  (loop [i 1] (if (< i (vec-count xs)) (if (= (nth xs i) (nth xs 0)) (recur (+ i 1)) false) true)))

(defun main () -> i64
  (let [c (checks) p (checks)
        n 400003
        want (ref-tree n)
        workers [1 2 3 4 7 8 16 28]]
    (do (check c (all-equal (mapv (fn (w: i64) (psum (Par w 0 false) n)) workers)))
        (check c (all-equal (mapv (fn (w: i64) (psum-chunks (Par w 0 false) n)) workers)))
        (check c (= (psum (Par 1 0 false) n) want))
        (check c (= (psum (Par 28 0 false) n) want))
        (check c (= (psum-chunks (Par 3 0 false) n) want))
        (check c (= (preduce + 0.0 (fn (x) x) (mapv datum (vec (range 70000)))) (ref-tree 70000)))
        ;; the planted fault: the unordered mode is not a function of the data alone
        (check p (all-equal (mapv (fn (w: i64) (psum (Par w 0 true) n)) workers)))
        (check-detects c p)
        (checks-result c))))
