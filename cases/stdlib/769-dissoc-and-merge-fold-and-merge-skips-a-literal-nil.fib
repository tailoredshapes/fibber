;; spec:   stdlib §4.5 (rows dissoc and merge), §2.4 (a literal nil operand of merge), §6.3 (R6a)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: dissoc merge
;; (dissoc m a b) takes the keys out one at a time and (dissoc m) is m. (merge a b c) is
;; (merge (merge a b) c): the later map wins a conflict, as Clojure's. A literal nil
;; operand is skipped, which is how Clojure's (merge nil m) reads: (merge a nil b) is
;; (merge a b), (merge a nil) and (merge nil a) are a, and (merge a) is a.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (m {1 10 2 20 3 30 4 40})
        (a {1 1 2 2})
        (b {2 20 3 30})
        (d {3 300 4 400}))
    (do (check c (= (dissoc m 1 2) {3 30 4 40}))
        (check c (= (dissoc m 1 2 3 4) {}))
        (check c (= (dissoc m 9 8 7) m))
        (check c (= (dissoc m 1) {2 20 3 30 4 40}))
        (check c (= (dissoc m) m))
        (check c (= (merge a b d) {1 1 2 20 3 300 4 400}))
        (check c (= (merge d b a) {1 1 2 2 3 30 4 400}))
        (check c (= (merge a nil b) (merge a b)))
        (check c (= (merge a nil) a))
        (check c (= (merge nil a) a))
        (check c (= (merge a) a))
        (check c (= (merge nil a nil b nil d) (merge a b d)))
        (checks-result c))))
