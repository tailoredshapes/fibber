;; spec:   stdlib §2.7 (the table: a record under `println`), §7 L17, §4.2 (row defrecord), plan Y8 (judge of defrecord)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: defrecord ->Name print-str
;; open:   L17
;; The plan's judge of defrecord: `(println r)` of a record is `#main.P{:x 1, :y a}` (the string field bare), and
;; `(pr-str r)` is the same text with the string quoted. The second holds (case 2800); the first does not, because
;; println, print-str and println-str ask Show, and the Show that `defrecord` writes is `(derive Show P)`, whose text is the
;; builtin's `(P 1 a)` (spec §7 L17 says so itself; case 2952 is the same gap for a defstruct). `defrecord` writes the six
;; derives the row names and does not change what a derive prints: not changed here, the spec and the code disagree (a
;; report to the lead). The case is the page's text for a record from `defrecord`; it passes the day a derived Show
;; writes the record text, and whoever lands that removes the label.
(ns main (:use tl.check))

(defrecord P [x: i64 y: str])

(defun main () -> i64
  (let ((c (checks))
        (r (->P 1 "a")))
    (do (check c (= (print-str r) "#main.P{:x 1, :y a}"))
        (check c (= (println-str r) "#main.P{:x 1, :y a}\n"))
        (check c (= (pr-str r) "#main.P{:x 1, :y \"a\"}"))
        (checks-result c))))
