;; spec: docs/design/numerical-library.md; trusted kernel failure boundary (the ordered fold's dense fast path still checks every read)
;; expect: trap
;; trap: array index 4 out of range 0..4
;; stage: 2
;; roots: ../../lib
;; A forged descriptor claims eight elements over a four-element buffer. The ordered sum walks the buffer in logical order and its fifth
;; read is the checked one, at index 4: a fast path that read through a pointer, or checked the range once at the wrong place, would not
;; trap with this index.
(ns main (:require [fib.tensor :as t]))
(defun main () -> i64 (do (t/sum (t/Tensor (array 4 1.0) (t/to-array (t/tensor-i64 [0 1 8 1])) 0.0)) 0))
