;; spec:   syntax §5 (a definition shadows a prelude name)
;; expect: reject
;; error:  the type Result of this module shadows the prelude's Result, which takes 2
;; roots:  ../../lib support
;; A module that defines `Result` has its own `Result` in that module (a local definition shadows the prelude's, syntax §5), so `(Result i64 str)` is an
;; arity error. It used to say only `type Result takes 0 argument(s), not 2`, which reads as a bug in the compiler; it now says whose `Result` it is and what
;; the prelude's takes. The constructors `Ok` and `Err` are the prelude's and keep working (case 8366).
(ns main)

(defstruct Result (ok: bool msg: str))

(defun parse (x: i64) -> (Result i64 str)
  (if (> x 0) (Ok x) (Err "negative")))

(defun main () -> i64
  (match (parse 3) ((Ok v) v) ((Err _) 0)))
