;; spec:   stdlib §2.9 (first of a str), §2.1 rule 3 (first, empty?)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; The page's own example: (first "héllo") is (some \h), the first character
;; and not the first byte, and (first "😀x") is the four-byte 😀, decoded whole.
;; The first of the empty string is nil; `empty?` is true for "" and false for
;; any text.
(ns main (:use fib.core fib.seq tl.check))

(defun first-is (r: (Option char) want: char) -> bool
  (match r ((some x) (= x want)) (nil false)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (first-is (first "héllo") \h))
        (check c (first-is (first "😀x") \😀))
        (check c (first-is (first "éa") \é))
        (check c (first-is (first (Chars "€")) \€))
        (check c (nil? (first "")))
        (check c (empty? ""))
        (check c (not (empty? "a")))
        (check c (empty? (Chars "")))
        (checks-result c))))
