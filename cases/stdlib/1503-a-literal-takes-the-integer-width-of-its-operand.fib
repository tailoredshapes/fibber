;; spec:   stdlib §7 L26 (a), types §1.1
;; expect: accept
;; result: 1
;; audit:  clean
;; roots:  support
;; covers: +
;; Verdict flipped by LANG-2 (it was `reject`, `cannot unify i64 with i32`, the rule being that L19's adoption is for the float types only): an
;; integer literal in an argument position takes the integer width it meets, when it fits that width by range (types §1.1). (+ x 1) with x an
;; i32 is an i32; a literal that does not fit is an error that names the range (case 8357). A variable never adopts: `(let ((n 1)) (+ x n))` is still
;; the mismatch (case 8358).
(ns main (:use tl.check))

(defun bump (x: i32) -> i32
  (+ x 1))

(defun main () -> i64
  (if (= (bump 1i32) 2i32) 1 0))
