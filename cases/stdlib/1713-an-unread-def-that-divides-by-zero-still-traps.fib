;; spec:   stdlib §7 L15, syntax §3.19
;; expect: trap
;; trap: def ratio:
;; roots:  ../../lib support
;; covers: def
;; Nothing reads `ratio`; its initialiser divides by a zero that is another `def`: it still runs before `main`.
(def zero: i64 0)
(def ratio: i64 (quot 10 zero))

(defun main () -> i64 0)
