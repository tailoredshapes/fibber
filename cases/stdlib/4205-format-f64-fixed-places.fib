;; spec:   stdlib §4.14 (row format, the %f directive: not landed; fib.fmt/format-f64 stands in)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: format-f64
;; Fixed-point text: nine places for the n-body energies (the published outputs), rounding of the exact value,
;; negative and zero, no places, a large value, and a value that rounds up through a carry (0.9999999996).
(ns main (:use tl.check) (:require [fib.fmt :as fmt]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (fmt/format-f64 -0.169075164 9) "-0.169075164"))
        (check c (= (fmt/format-f64 -0.16907516382852447 9) "-0.169075164"))
        (check c (= (fmt/format-f64 -0.1690599069 9) "-0.169059907"))
        (check c (= (fmt/format-f64 0.0 9) "0.000000000"))
        (check c (= (fmt/format-f64 0.9999999996 9) "1.000000000"))
        (check c (= (fmt/format-f64 2.5 0) "2"))
        (check c (= (fmt/format-f64 3.5 0) "4"))
        (check c (= (fmt/format-f64 1.0 3) "1.000"))
        (check c (= (fmt/format-f64 1e20 2) "100000000000000000000.00"))
        (check c (= (fmt/format-f64 -0.0000000004 9) "-0.000000000"))
        (checks-result c))))
