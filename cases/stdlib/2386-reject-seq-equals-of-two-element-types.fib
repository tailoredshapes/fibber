;; spec:   stdlib §4.4 row seq= (`Reducible c1 e, Reducible c2 e, Eq e`), §2.7
;; expect: reject
;; error:  cannot unify
;; roots:  ../../lib support
;; covers: seq=
;; `seq=` compares two sources of one element type: `=` is on one type (§2.7) and so is this, within a family. Clojure's
;; `(= [1] ["a"])` is false at run time; there is no union of `i64` and `str` for the program to hold, so the checker
;; refuses the call (§5 T7: "which is what Clojure's `false` would hide").
(ns main (:use fib.core fib.seq))

(defun main () -> i64 (if (seq= [1] ["a"]) 1 0))
