;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in * at i16x5
;; stage:  2
;; roots:  ../../lib support
;; i16 lanes: 300 * 300 overflows, the literal operand broadcast.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i16x5 <<1 2 3 300 5>>i16))
    (do (println (lane (* a 300) 0)) 0)))
