;; spec:   stdlib §4.15 (row future: a macro over spawn), §2.11
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: future
;; (future) with no body form is a task whose value is unit: the template wraps the forms in a do,
;; and an empty do is unit, where a closure with no body is `malformed fn: missing body`. The page
;; is silent about a body of no forms (Clojure's is a future of nil); this is what the library
;; does, decided in lib/fib/async.fib by the do, and found by the mutation review (MUT-L12) when
;; a mutant without the do survived every other case. A task is a value like any other: the unit
;; one is joined, dereferenced and joined again, and a body of one form is that form's value.
(ns main (:use fib.core fib.async tl.check))

(defun main () -> i64
  (let ((c (checks))
        (e (future))
        (one (future 7)))
    (do (check c (= (join e) ()))
        (check c (= @e ()))
        (check c (= (join e) ()))
        (check c (= (join one) 7))
        (checks-result c))))
