;; spec: lib/fib/tensor/README.md (Linear algebra and SIMD, AVX-512): the f64 GEMM is one source over a witness vector; at four lanes (6x8 tile, inner block 256) and at eight (6x32 tile, inner block 128) every output is the same ordered fma chain
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; `multiply-at` runs the kernel at the width of the witness on any target (eight lanes are split into the registers an AVX2 CPU has), so this case compares the two tile shapes bit for bit on the machine
;; that runs the suite: against each other and against the checked scalar `fma-reference`, for shapes around the tile edges of both (6 rows; 8 and 32 columns), the inner blocks (128 and 256), the
;; column block (1024), views of any stride and empty extents. A tile that reorders an output's accumulation (an accumulator reused across two outputs, a block that restarts the chain
;; instead of continuing it), a tail that drops or doubles a column, a scratch tile of the wrong pitch or a packed panel of the wrong width changes some bit of some output of these shapes.
(ns main (:require [fib.tensor :as t] [fib.tensor.gemm-fma-f64 :as g]) (:use tl.check))

(defun gen (n: i64 seed: i64) -> (t/Tensor f64)
  (let ((buf (cell (array n 0.0))))
    (do (dotimes (i n) (array-set! &buf i (fdiv (double (- (rem (+ (* i 7919) (* seed 104729)) 1013) 500)) 37.0)))
        (t/from-array [n] @buf 0.0))))

(defun mat (m: i64 n: i64 seed: i64) -> (t/Tensor f64) (t/reshape [m n] (gen (* m n) seed)))

;; the same shape and the same bits in every element (0.0 and -0.0 differ)
(defun bits (x: (t/Tensor f64)) -> (Vec i64) (mapv (fn (v: f64) (f64->bits v)) (t/to-vec x)))
(defun same? (x: (t/Tensor f64) y: (t/Tensor f64)) -> bool (and (= (t/shape x) (t/shape y)) (= (bits x) (bits y))))

(defun w4 () -> f64x4 (splat f64x4 0.0))
(defun w8 () -> f64x8 (splat f64x8 0.0))

;; both widths equal the reference (and so each other)
(defun agree? (a: (t/Tensor f64) b: (t/Tensor f64)) -> bool
  (let ((r (g/fma-reference a b)))
    (and (same? (g/multiply-at a b (w4)) r) (same? (g/multiply-at a b (w8)) r))))

(defun main () -> i64
  (let ((c (checks)) (ms [1 5 6 7 13 97 110]) (ns [1 7 8 9 15 16 17 31 32 33 40 63 64 65]) (ks [1 3 127 128 129 255 256 257 300]))
    (do (dotimes (mi (count ms))
          (dotimes (ni (count ns))
            (dotimes (ki (count ks))
              (let ((m (nth ms mi)) (n (nth ns ni)) (k (nth ks ki)))
                (check c (agree? (mat m k 1) (mat k n 2)))))))
        ;; more than one column block (1024), a column block edge, the second inner block and a second row block (96 rows)
        (let ((a (mat 7 5 3)) (b (mat 5 1030 4))) (check c (agree? a b)))
        (let ((a (mat 100 260 5)) (b (mat 260 70 6))) (check c (agree? a b)))
        ;; strided inputs: transposed, flipped, stepped slices, a view with offset
        (let ((a (mat 19 23 5)) (b (mat 23 21 6)) (at (t/transpose (mat 23 19 5))) (bt (t/transpose (mat 21 23 6))))
          (do (check c (agree? at b))
              (check c (agree? a bt))
              (check c (agree? (t/flip 1 a) (t/flip 0 b)))
              (let ((sa (t/slice 1 1 23 2 a)) (sb (t/slice 0 1 23 2 b))) (check c (agree? sa sb)))
              (let ((sa (t/slice 0 3 17 1 a)) (sb (t/slice 1 2 20 3 b)) (sa2 (t/slice 1 0 22 1 sa)) (sb2 (t/slice 0 0 22 1 sb)))
                (check c (agree? sa2 sb2)))))
        ;; empty extents: the product of nothing is zeros, at both widths
        (check c (agree? (mat 0 5 1) (mat 5 7 2)))
        (check c (agree? (mat 4 5 1) (mat 5 0 2)))
        (check c (same? (g/multiply-at (mat 4 0 1) (mat 0 7 2) (w8)) (t/zeros [4 7])))
        ;; the entry point `multiply` is one of the two widths, so it is the reference too
        (check c (same? (g/multiply (mat 33 40 1) (mat 40 33 2)) (g/fma-reference (mat 33 40 1) (mat 40 33 2))))
        ;; the data discriminate: an fma chain is not the multiply-then-add chain of mmul-scalar
        (let ((a (mat 40 300 1)) (b (mat 300 40 2)))
          (check c (not (same? (g/multiply-at a b (w8)) (t/mmul-scalar a b)))))
        (check c (= (checks-made c) 894))
        (checks-result c))))
