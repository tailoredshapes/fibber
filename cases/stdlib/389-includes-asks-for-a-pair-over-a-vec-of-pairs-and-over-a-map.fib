;; spec:   stdlib §3 N3, §4.5 (includes?: the element first, Eq e), §2.3 (Pair and Triple: Eq by field)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: includes?
;; The elements of a Map are its entries, (Pair k v), so (includes? (Pair k v) m)
;; asks whether the Map holds that entry, key and value both: the prelude derives
;; Eq for Pair and Triple, which includes? needs. The same call over a Vec of
;; Pairs, a Vec of Triples and a Set of Pairs (a Pair hashes, so it is a key).
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks))
        (ps [(Pair 1 "a") (Pair 2 "b")])
        (ts [(Triple 1 2 3) (Triple 4 5 6)])
        (m (assoc (assoc (map-empty) "x" 10) "y" 20))
        (s (conj (conj (set-empty) (Pair 1 2)) (Pair 3 4))))
    (do (check c (includes? (Pair 2 "b") ps))
        (check c (includes? (Pair 1 "a") ps))
        (check c (not (includes? (Pair 2 "a") ps)))
        (check c (not (includes? (Pair 3 "c") ps)))
        (check c (includes? (Triple 4 5 6) ts))
        (check c (not (includes? (Triple 4 5 7) ts)))
        (check c (includes? (Pair "y" 20) m))
        (check c (includes? (Pair "x" 10) m))
        (check c (not (includes? (Pair "y" 10) m)))
        (check c (not (includes? (Pair "z" 20) m)))
        (check c (includes? (Pair 3 4) s))
        (check c (not (includes? (Pair 4 3) s)))
        (check c (not (includes? (Pair 1 "a") (vec-empty))))
        (checks-result c))))
