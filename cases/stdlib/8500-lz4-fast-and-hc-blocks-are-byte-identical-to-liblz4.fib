;; spec: docs/design/compress.md
;; expect: accept
;; result: 0
;; audit: clean
;; roots: ../../lib support
;; The fast encoder (acceleration 1 and 4) and the HC parser (levels 3 and 9) give, for one 294-byte input, exactly the bytes liblz4 1.10 gives (python lz4.block: LZ4_compress_fast and LZ4_compress_HC).
(ns main (:use tl.check fib.compress.lz4.mem fib.compress.lz4.block) (:require [fib.crypto :as c]))
(defun hex-of (b: (Array i8)) -> str (c/hex b))
(defun input () -> (Array i8)
  (str-bytes (str "the quick brown fox jumps over the lazy dog; the quick brown fox jumps over the lazy cat. "
                  "the quick brown fox jumps over the lazy dog; the quick brown fox jumps over the lazy cat. "
                  "the quick brown fox jumps over the lazy dog; the quick brown fox jumps over the lazy cat. "
                  "tail bytes of the input!")))
(defun main () -> i64
  (let [c (checks) d (input)]
    (do (check c (= (array-len d) 294))
        (check c (= (hex-of (block-compress d 1)) "f01074686520717569636b2062726f776e20666f78206a756d7073206f766572201f00916c617a7920646f673b0e000f2d00114f6361742e2d00160f5a007af00861696c206279746573206f662074686520696e70757421"))
        (check c (= (hex-of (block-compress d 4)) "ff1e74686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f673b202d00154f6361742e2d00160f5a007af00861696c206279746573206f662074686520696e70757421"))
        (check c (= (hex-of (block-compress-hc d 3)) "f01074686520717569636b2062726f776e20666f78206a756d7073206f766572201f00af6c617a7920646f673b202d00155f6361742e205a00a2f00861696c206279746573206f662074686520696e70757421"))
        (check c (= (hex-of (block-compress-hc d 9)) "f01074686520717569636b2062726f776e20666f78206a756d7073206f766572201f00af6c617a7920646f673b202d00155f6361742e205a00a2f00861696c206279746573206f662074686520696e70757421"))
        (checks-result c))))
