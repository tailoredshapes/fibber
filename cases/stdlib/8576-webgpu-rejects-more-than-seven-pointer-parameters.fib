;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/gpu ../../examples/webgpu
;; webgpu-target = reject | pointer parameters
;; WebGPU binds 8 storage buffers per stage and one is the trap flag -- a kernel of 8 pointers is refused naming the count.
;; The host builds and runs this program (nothing calls the kernel); compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [gpu :as gpu] [gpu32 :as g]))
(gpu/defkernel k (a: ptr b: ptr c: ptr d: ptr e: ptr f: ptr h: ptr j: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n) (g/f32-set! j i (+ (g/f32-at a i) (g/f32-at h i))))))
(defun main () -> i64 0)
