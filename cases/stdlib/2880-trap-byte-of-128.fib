;; spec:   stdlib §4.3 (row byte), §2.8 (conversions are checked)
;; expect: trap
;; trap:   byte: value out of range
;; roots:  ../../lib support
;; covers: byte
;; The first i64 above an i8: 127 is a byte (case 2851), 128 is not. `(trunc i8 128)` wraps to -128
;; and never traps; `byte` is the checked form, so it traps and names itself.
(defun main () -> i64 (sext i64 (byte 128)))
