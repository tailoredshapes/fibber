;; spec:   syntax §3.19, types §2.16, stdlib §7 L15
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: def
;; The initialiser of a `def` (L15) is any expression, made once before `main`: a
;; call of a function (`(def v: i64 (f 2))`), a call over an earlier `def`,
;; a collection built by calls. Each is made by the init function of the
;; module, not at compile time, and read as a global afterwards.
(ns main (:use tl.check))

(defun f (n: i64) -> i64 (* n 21))
(defun g (n: i64) -> i64 (+ n 1))

(def v: i64 (f 2))
(def w: i64 (g v))
(def names: (Vec str) (conj (conj [] "ann") "bo"))
(def total: i64 (+ v (count names)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= v 42))
        (check c (= w 43))
        (check c (= (nth names 1) "bo"))
        (check c (= total 44))
        (checks-result c))))
