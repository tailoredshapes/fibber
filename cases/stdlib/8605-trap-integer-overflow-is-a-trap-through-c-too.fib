;; spec:   types §8.12 (checked arithmetic), docs/design/lir2c.md section 3 (sadd-overflow is __builtin_add_overflow)
;; expect: trap
;; trap: integer overflow in + at i64
;; roots:  ../../lib support
;; The checked `+` of fibber is lIR's `sadd-overflow` and a trap on the flag; a C printer that wrote a plain `+` (which wraps, or is
;; undefined) would print 0 and exit 0. The operands come through a function so that no compiler folds the sum. Through C the message
;; and the abort are the same (`FIB_VIA=c fibc cases`, compiler/tests/c-backend/suite.sh); scripts/mutant-lir2c.sh wrap-trap plants the
;; plain `+` and the differential harness sees the difference.
(ns main (:use fib.core))

(defun big (x: i64) -> i64 (+ x 9223372036854775807))

(defun main () -> i64
  (if (= (big 1) 0) 0 1))
