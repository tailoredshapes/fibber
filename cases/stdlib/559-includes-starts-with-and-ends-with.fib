;; spec:   stdlib §4.7 (rows clojure.string/includes? starts-with? ends-with?), §2.9, plan §6 L10b
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: clojure.string/includes? clojure.string/starts-with? clojure.string/ends-with?
;; The three tests of Clojure's `clojure.string`, over bytes (a `str` is valid UTF-8, so equal bytes
;; are equal characters): `(str/includes? s sub)` is true when `sub` occurs anywhere, `(str/starts-with?
;; s p)` at the start and `(str/ends-with? s p)` at the end; each is true for the empty string, and
;; false when the other is longer than `s`. Overlap is not a problem (`"aaa"` ends with `"aa"`), a
;; partial match at the edge is not a match (`"abc"` does not end with `"bcd"`), and characters
;; are compared whole: `"aé"` ends with `"é"` (bytes C3 A9), `"é"` does not end with `"©"` (C2 A9,
;; which has the same last byte) and `"€"` (E2 82 AC) does not end with `"é"`. `str/starts-with?` is
;; the prelude's builtin under its qualified name, so the same function answers both spellings;
;; that is the check of the last two lines.
;; Expected values are Java's `contains`, `startsWith` and `endsWith`, which agree on all of these.
(ns main (:use fib.core tl.check) (:require [fib.string :as str]))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (str/includes? "hello world" "lo wo"))
        (check c (str/includes? "hello" "hello"))
        (check c (str/includes? "hello" ""))
        (check c (str/includes? "" ""))
        (check c (not (str/includes? "" "a")))
        (check c (not (str/includes? "hello" "helloo")))
        (check c (not (str/includes? "hello" "world")))
        (check c (str/includes? "aé€😀z" "€😀"))
        (check c (str/includes? "aé€😀z" "😀z"))
        (check c (not (str/includes? "aé€😀z" "é😀")))
        (check c (str/starts-with? "hello" "he"))
        (check c (str/starts-with? "hello" "hello"))
        (check c (str/starts-with? "hello" ""))
        (check c (str/starts-with? "" ""))
        (check c (not (str/starts-with? "hello" "el")))
        (check c (not (str/starts-with? "he" "hello")))
        (check c (str/starts-with? "éa" "é"))
        (check c (not (str/starts-with? "€" "é")))
        (check c (str/ends-with? "hello" "llo"))
        (check c (str/ends-with? "hello" "hello"))
        (check c (str/ends-with? "hello" ""))
        (check c (str/ends-with? "" ""))
        (check c (str/ends-with? "aaa" "aa"))
        (check c (not (str/ends-with? "hello" "hel")))
        (check c (not (str/ends-with? "abc" "bcd")))
        (check c (not (str/ends-with? "lo" "hello")))
        (check c (str/ends-with? "aé" "é"))
        (check c (str/ends-with? "a😀" "😀"))
        (check c (not (str/ends-with? "€" "é")))
        (check c (not (str/ends-with? "é" "©")))
        (check c (not (str/ends-with? "aé" "€")))
        (check c (= (str/starts-with? "hello" "he") (starts-with? "hello" "he")))
        (check c (= (str/starts-with? "hello" "lo") (starts-with? "hello" "lo")))
        (checks-result c))))
