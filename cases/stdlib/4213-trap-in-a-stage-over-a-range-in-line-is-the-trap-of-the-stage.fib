;; spec:   stdlib §2.1 rule 2 (the rewrite changes nothing a program can see); docs/design/vec-performance.md item 2; compiler/expand/fuseinline.fib, fuserange.fib
;; expect: trap
;; trap:   stage refused 41
;; roots:  ../../lib support
;; covers: mapv range
;; A stage put in line over a range (case 4211) traps as the closure did: at the element that makes it trap (here the 42nd,
;; in the second span of the output), with its own message, after the elements before it and before any after it.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (count (mapv (fn (x: i64) (if (= x 41) (trap (str "stage refused " x)) (* x 2))) (range 70))))
