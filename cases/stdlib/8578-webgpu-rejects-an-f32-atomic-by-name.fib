;; spec:   docs/design/webgpu.md 3 (the kernel subset in WGSL: what is rejected by name), 3.7 (atomics)
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib ../../examples/webgpu
;; webgpu-target = reject | an f32 atomic
;; WGSL has atomic<i32> and atomic<u32> only: `gpu/f32-add!` (lIR `atomicrmw fadd`) is refused naming the f32 atomic, and the function that holds it.
;; The host builds and runs this program (nothing calls the kernel); compiler/tests/native/wgsl-emit.sh builds it for wgsl-unknown-webgpu and
;; checks the `webgpu --` verdict and the `webgpu-error:` text.
(ns main (:require [fib.gpu :as gpu] [gpu32 :as g]))
(defkernel k (a: ptr n: i32)
  (let ((i (g/global-id-x)))
    (when (< i n) (gpu/f32-add! a 0i32 (g/f32-at a i)))))
(defun main () -> i64 0)
