;; spec:   stdlib §5 (nth traps out of range), types §8.3
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; covers: nth
;; A flat Vec of 1000 kept by a second name and conj'd: the new version is a trie of 1001 whose tail holds 9. Its last element
;; is read first, then index 1001, one past it: with the range test gone, i - tailoff is 9 and the tail's own bounds test
;; would trap with another message (`array index 9 out of range`), so the message names nth only if vec-nth tests the range
;; before it subtracts. The kept flat Vec is read too, at its count, after the trie: never reached.
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (let ((v (mapv (fn (i: i64) (* i 3)) (range 1000))))
    (let ((t (conj v -1)))
      (if (> (span-count t) 1)
          (+ (nth t 1000) (nth t 1001) (nth v 1000))
          0))))
