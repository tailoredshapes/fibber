;; spec:   stdlib §4.1 (row bit-or), types §2.12 (Bits)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: bit-or
;; The builtin bit-or over two integers of one type keeps the bits set in either: 0 is its identity
;; and -1 (all ones) its zero, a number with its own complement is -1, it sets flags without
;; touching the others, and it works at every width. The sign bit is one bit like the rest.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (bit-or 12 10) 14))
        (check c (= (bit-or 1 2) 3))
        (check c (= (bit-or 256 1) 257))
        (check c (= (bit-or 0 12345) 12345))
        (check c (= (bit-or 12345 0) 12345))
        (check c (= (bit-or -1 12345) -1))
        (check c (= (bit-or 12345 -1) -1))
        (check c (= (bit-or 12345 12345) 12345))
        (check c (= (bit-or 12345 (bit-not 12345)) -1))
        (check c (= (bit-or -9223372036854775808 9223372036854775807) -1))
        (check c (= (bit-or -9223372036854775808 1) -9223372036854775807))
        (check c (= (bit-or 64i8 -128i8) -64i8))
        (check c (= (bit-or 15i8 60i8) 63i8))
        (check c (= (bit-or 255i16 -256i16) -1i16))
        (check c (= (bit-or 65535i32 -65536i32) -1i32))
        (checks-result c))))
