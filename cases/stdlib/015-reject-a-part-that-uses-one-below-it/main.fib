;; spec:   tranche 1 plan §4.1 (layers: a part never uses a part below it), syntax §5
;; expect: reject
;; error:  fib.seq.types -> fib.seq.protocols -> fib.seq.types
;; roots:  bad ../../../lib
;; The parts of a facade are ordered: a part may :use the facades above
;; it and the parts before it in its own facade, never one after it. The
;; compiler enforces the rule for it is the rule against import cycles
;; (syntax §5). The root `bad` comes first, so its fib.seq.types shadows
;; the library's and :uses fib.seq.protocols, which :uses fib.seq.types:
;; the real parts, one :use added. The roots are searched in order, so
;; the main file's directory, then bad, then the library.
(ns main (:use fib.seq))

(defun main () -> i64 0)
