;; spec:   stdlib §4.4 (rows cycle, count), §2.1 rule 1; tranche 2 plan §4.2 rule 5 (an endless source traps with the function's name and `never ends`)
;; expect: trap
;; trap:   count: never ends
;; roots:  ../../lib support
;; covers: cycle count
;; Count of a cycle of a source that has elements: the size method traps. The cycle of an empty source is empty and counts 0 (case 2218).
(ns main (:use fib.core fib.seq fib.coll))

(defun main () -> i64
  (count (cycle [1 2 3])))
