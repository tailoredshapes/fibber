;; spec:   syntax §5 (own definitions, then :use, then the implicit modules, then the prelude), stdlib §6.1
;; expect: accept
;; result: -7
;; audit:  clean
;; A module the program `:use`s that exports `first` beats the library's `first` (`fib.seq`,
;; implicit): no E12 error (that is for two `:use`d modules, case 009), and the call is the
;; user module's, which answers -7 where the library's answers an Option.
(ns main (:use u))

(defun main () -> i64 (first [1 2]))
