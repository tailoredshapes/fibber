;; spec:   stdlib §4.3 (row abs: traps on the minimum of an integer type)
;; expect: trap
;; trap:   integer overflow in neg at i64
;; roots:  ../../lib
;; covers: abs
;; The magnitude of the smallest i64 does not fit an i64: abs negates a
;; negative number, and the builtin neg traps: the page's row says abs traps
;; on the minimum of an integer type.
(ns main (:use fib.core))

(defun main () -> i64
  (abs (- -9223372036854775807 1)))
