;; spec:   stdlib §2.1 rule 3 (a `reduced` fold over (iterate inc 1) ends, A11 e20), §4.4 row iterate
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: iterate reduce reduced
;; Plain `reduce` over a literal fn reads `reduced` (the macro of R6b rewrites the
;; tails of the body), so a fold that never reaches the end of its source still ends:
;; the running sum of 1, 2, 3 .. is 105 after fourteen elements and 120 after fifteen,
;; and with a limit of 105 the sixteenth element finds 120 over the limit and answers
;; it. The function was called sixteen times, once per element it saw.
(ns main (:use fib.core fib.seq tl.check))

(defun main () -> i64
  (let ((c (checks))
        (calls (cell 0)))
    (do (check c (= (reduce (fn (acc x) (do (set! calls (+ @calls 1)) (if (> acc 105) (reduced acc) (+ acc x))))
                            0 (iterate inc 1))
                    120))
        (check c (= @calls 16))
        (check c (= (reduce (fn (acc x) (if (> acc 10) (reduced acc) (+ acc x))) 0 (iterate inc 5)) 11))
        (checks-result c))))
