;; spec:   stdlib §2.7 (ToStr of a record is its Debug text: `(str r)` is believed to be the `pr` text), §7 L17
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; (derive ToStr P) gives `to-str` the same text as `debug`, so `str` of a
;; derived type is its `pr` text, quoted strings included. It is built from the
;; fields' Debug, not from a Debug instance of the type, so a type that derives
;; only ToStr has a `to-str` and, case 815, no `debug`. A struct and an enum that
;; derive only ToStr are shown against literals; a struct and an enum that derive
;; both are shown to give one text from the two methods.
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check))

(defstruct P (x: i64 y: str))
(derive ToStr P)

(defenum E (Nada) (Leaf v: i64) (Two a: str b: str))
(derive ToStr E)

(defstruct Both (x: i64 y: str))
(derive Debug Both)
(derive ToStr Both)

(defenum Either (Zip) (Pick v: i64) (Pair2 a: str b: str))
(derive Debug Either)
(derive ToStr Either)

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (to-str (P 1 "x")) "#main.P{:x 1, :y \"x\"}"))
        (check c (= (to-str Nada) "Nada"))
        (check c (= (to-str (Leaf 4)) "#main.Leaf{:v 4}"))
        (check c (= (to-str (Two "a" "b")) "#main.Two{:a \"a\", :b \"b\"}"))
        (check c (= (to-str (Both 2 "q")) (debug (Both 2 "q"))))
        (check c (= (to-str (Both 2 "q")) "#main.Both{:x 2, :y \"q\"}"))
        (check c (= (to-str Zip) (debug Zip)))
        (check c (= (to-str (Pick 8)) (debug (Pick 8))))
        (check c (= (to-str (Pair2 "u" "v")) (debug (Pair2 "u" "v"))))
        (checks-result c))))
