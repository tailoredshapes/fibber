;; spec: spec/types.md 1.9 (scalar-generic chunk): (convert e) converts a scalar to the float type the context fixes: fptrunc, fpext, identity
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib support
;; f64 to f32 is the rounding of the literal (0.1 as f32 equals 0.1f32, and is not 0.1 widened back), f32 to f64 is exact, and the same type is the value itself.
(ns main (:use tl.check))

(defun narrow (x: f64) -> f32 (convert x))
(defun widen (x: f32) -> f64 (convert x))
(defun same64 (x: f64) -> f64 (convert x))
(defun same32 (x: f32) -> f32 (convert x))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (narrow 0.1) 0.1f32))
        (check c (not (= (widen (narrow 0.1)) 0.1)))
        (check c (= (widen 0.5f32) 0.5))
        (check c (= (widen 0.1f32) (let ((y: f64 (convert 0.1f32))) y)))
        (check c (= (same64 0.1) 0.1))
        (check c (= (same32 0.1f32) 0.1f32))
        (check c (= (narrow 1.0e300) (/ 1.0f32 0.0f32)))
        (check c (= (checks-made c) 7))
        (checks-result c))))
