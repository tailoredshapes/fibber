;; spec:   stdlib §2.1 rule 3 (first, some, every?, take, take-while, empty? stop the source through the bool), §4.4 row iterate
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: iterate first filter find-first take-while every? empty? drop reduce-while vec
;; The page's own examples, over an iterate that has no end: the first element
;; of a filter that has a hit terminates, so do the other consumers that
;; decide at an element (find-first, every?, empty?), take-while and drop
;; followed by a first, and a reduce-while whose function says Done. Each one
;; would never return if the walk did not stop at the element that decides it.
(ns main (:use fib.core fib.seq fib.coll tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (first (filter (fn (x: i64) (> (* x x) 200)) (iterate inc 0))) (some 15)))
        (check c (= (find-first (fn (x: i64) (> x 40)) (iterate (fn (x: i64) (+ x 7)) 0)) (some 42)))
        (check c (= (vec (take-while (fn (x: i64) (< x 30)) (iterate (fn (x: i64) (* x 2)) 1))) [1 2 4 8 16]))
        (check c (not (every? (fn (x: i64) (< x 5)) (iterate inc 0))))
        (check c (not (empty? (iterate inc 0))))
        (check c (= (first (drop 100 (iterate inc 0))) (some 100)))
        (check c (= (reduce-while (fn (a x) (if (> x 3) (Done a) (More (+ a x)))) 0 (iterate inc 0)) 6))
        (check c (= (first (remove even? (iterate inc 0))) (some 1)))
        (checks-result c))))
