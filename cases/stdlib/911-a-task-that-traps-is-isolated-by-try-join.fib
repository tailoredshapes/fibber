;; spec:   stdlib §5.5 S16, §2.10, §7 L28 (exceptions, stage 1); docs/design/exceptions.md 4.1
;; expect: accept
;; result: 5
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A task's trap ends that task and not the process (it was `trap: boom` and Aborted, types §2.11, A11 t40, e9). The joiner that
;; asks with `try-join` gets the trap as a value, `(Err trap)`, and goes on; the task owned nothing, so the audit is clean. (`join`
;; and `@t` keep trapping in the joiner: cases 916 and 917.) Killed by: scripts/mutant-task-trap.sh `no-isolate`.
(ns main (:use fib.async))

(defun main () -> i64
  (let ((t (spawn (fn () (trap "boom")))))
    (match (try-join t)
      ((Err e) (if (= (. e message) "boom") 5 1))
      ((Ok _) 0))))
