;; spec:   stdlib §6.3 (R6b, R14: a module's own definitions beat the prelude macros), syntax §4.4
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: reduce str
;; The program defines its own two-argument str. Its definition beats the prelude macro of the
;; name (the owner's rule of 2026-10-01: own definitions, then :use, then the implicit library,
;; then the prelude), so (str 4 5) is the program's function, 45, and the literal head of
;; (reduce str c) is that function, with no identity: it goes through reduce-nonempty, 123 for
;; [1 2 3]; (reduce str 0 c) is the library reduce over it. The prelude's macro is still
;; reached by its qualified name: (fib.prelude/str 4 5) is "45", the text of each piece.
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check))

(defun str (a: i64 x: i64) -> i64 (+ (* a 10) x))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (str 4 5) 45))
        (check c (= (reduce str [1 2 3]) 123))
        (check c (= (reduce str 0 [1 2 3]) 123))
        (check c (= (fib.prelude/str 4 5) "45"))
        (check c (= (fib.prelude/str "a" 1 \c) "a1c"))
        (checks-result c))))
