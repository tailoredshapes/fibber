;; spec:   types §1.9, docs/design/simd-and-tensors.md 2.8
;; expect: trap
;; trap:   integer overflow in neg at i32x4
;; stage:  2
;; roots:  ../../lib support
;; neg traps when a lane is the minimum value, as the scalar.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((a: i32x4 <<1 2 -2147483648 4>>i32))
    (do (println (lane (neg a) 0)) 0)))
