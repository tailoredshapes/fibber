;; spec:   stdlib §2.1 rule 8 (a seq prints in parentheses, a vector in brackets), §2.7, §4.4 rows map-indexed keep drop-while interpose distinct reductions cons mapv filterv partition-by
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: map-indexed keep drop-while interpose distinct reductions cons mapv filterv partition-by
;; The text of each result, computed with to-str (a case never prints to compare): the lazy functions
;; give seqs, which print in parentheses as Clojure's do, and so does each group of partition-by, a
;; VSeq; mapv and filterv give vectors, which print in brackets. This is what tells the eager twins
;; from the lazy functions at a glance, and a group from a vector.
(ns main (:use fib.core fib.seq fib.coll fib.print tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (to-str (map-indexed (fn (i: i64 x: i64) (+ i x)) [5 5 5])) "(5 6 7)"))
        (check c (= (to-str (keep (fn (x: i64) (if (> x 1) (some x) nil)) [1 2 3])) "(2 3)"))
        (check c (= (to-str (drop-while (fn (x: i64) (< x 2)) [1 2 3])) "(2 3)"))
        (check c (= (to-str (interpose 0 [1 2 3])) "(1 0 2 0 3)"))
        (check c (= (to-str (distinct [1 2 1])) "(1 2)"))
        (check c (= (to-str (reductions (fn (a: i64 x: i64) (+ a x)) 0 [1 2 3])) "(0 1 3 6)"))
        (check c (= (to-str (cons 0 [1 2])) "(0 1 2)"))
        (check c (= (to-str (mapv (fn (x: i64) (* x 2)) [1 2 3])) "[2 4 6]"))
        (check c (= (to-str (filterv (fn (x: i64) (> x 1)) [1 2 3])) "[2 3]"))
        (check c (= (to-str (partition-by (fn (x: i64) (rem x 2)) [1 3 2 4 5])) "((1 3) (2 4) (5))"))
        (check c (= (to-str (interpose 0 (distinct (map-indexed (fn (i: i64 x: i64) (rem (+ i x) 3)) [0 0 0 0])))) "(0 0 1 0 2)"))
        (checks-result c))))
