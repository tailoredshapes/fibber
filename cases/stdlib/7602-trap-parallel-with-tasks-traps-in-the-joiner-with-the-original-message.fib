;; spec:   docs/design/parallelism.md 3.2; lib/fib/parallel/scope.fib
;; expect: trap
;; trap:   original message of the task
;; stage:  2
;; roots:  ../../lib support
;; A trap in a task of a `with-tasks` scope is the scope's own trap, with the task's message and not a generic one; the sibling that was
;; started first is still joined before the trap (its pause is longer than the failing task's life, and a scope that traps at once would end the
;; process with the sibling still running: the audit would then not be a clean `abandoned`).
(ns main (:use fib.parallel fib.os))

(defun main () -> i64
  (with-tasks [s]
    (do (fork s (fn () (do (sleep-ns 20000000) 1)))
        (fork s (fn () (trap "original message of the task")))
        0)))
