;; spec: docs/design/finite-domains-and-sudoku.md
;; expect: accept
;; result: 0
;; audit: clean
;; stage: 2
;; roots: ../../lib ../../examples support
(ns main (:require [sudoku.solver :as s] [sudoku.puzzles :as p]) (:use tl.check))
(defun main () -> i64
  (let ((c (checks)) (a (s/sudokufd p/test-puzzle)) (b (s/sudokufd p/hard-puzzle)))
    (do (check c (= a [p/test-solution]))
        (check c (= b [p/hard-solution]))
        (check c (s/valid-solution? p/test-puzzle (nth a 0)))
        (check c (s/valid-solution? p/hard-puzzle (nth b 0)))
        (check c (= (s/sudokufd p/test-solution) [p/test-solution]))
        (checks-result c))))
