;; spec:   stdlib §2.8 ((Ratio t)), §4.1 (row /)
;; expect: trap
;; trap:   ratio: divide by zero
;; roots:  ../../lib
;; covers: /
;; An exact quotient by zero has no value (Clojure throws), so (/ 5 0)
;; traps, and the message names the function. A float zero divisor is
;; IEEE (case 060); a ratio divided by a zero ratio is case 088.
(ns main (:use fib.core))

(defun main () -> i64
  (numerator (/ 5 0)))
