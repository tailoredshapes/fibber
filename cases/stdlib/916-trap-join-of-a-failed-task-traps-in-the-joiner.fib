;; spec:   stdlib §2.10 (step 2); docs/design/exceptions.md 4.1 test 4, decision (2) of 2026-10-05
;; expect: trap
;; trap:   boom
;; stage:  2
;; roots:  ../../lib support
;; `join` returns the task's value, so for a task that trapped there is none to return: the joiner traps with the task's own message
;; (Clojure's `deref` of a failed future throws). Only `try-join` hands the trap back as a value (cases 911, 915). The task's trap
;; ends only the task; it is main's join that ends the process, with the old message and exit status, `trap: boom`.
;; Killed by: scripts/mutant-task-trap.sh `join-ignores` (join of a failed task reads its empty result and goes on).
(ns main (:use fib.async))

(defun main () -> i64
  (let ((t (spawn (fn () (trap "boom")))))
    (join t)))
