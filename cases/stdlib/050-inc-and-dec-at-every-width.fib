;; spec:   stdlib §2.8 (Unit), §4.3 (rows inc dec)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: inc dec
;; inc and dec are (+ x (one x)) and (- x (one x)), written once over a
;; Num type that has a Unit, so each answers at its own width: the literal 1
;; that Clojure writes has one type, and `one` is how the library gets a
;; 1i8 from an i8. The boundary values are the last ones that fit; case 051
;; and 077 show the next ones trapping.
(ns main (:use fib.core tl.check))

;; the generic caller, so that the call goes through the where-clause too
(defun twice-inc (x: t) :where ((Num t) (Unit t)) -> t (inc (inc x)))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (inc 5i8) 6i8))
        (check c (= (dec 5i8) 4i8))
        (check c (= (inc 126i8) 127i8))
        (check c (= (dec -127i8) -128i8))
        (check c (= (inc -1i16) 0i16))
        (check c (= (dec 0i16) -1i16))
        (check c (= (inc 32766i16) 32767i16))
        (check c (= (inc 41i32) 42i32))
        (check c (= (dec 41i32) 40i32))
        (check c (= (inc 2147483646i32) 2147483647i32))
        (check c (= (inc 41) 42))
        (check c (= (dec 41) 40))
        (check c (= (inc 9223372036854775806) 9223372036854775807))
        (check c (= (dec (inc -9223372036854775807)) -9223372036854775807))
        (check c (= (inc 1.5f32) 2.5f32))
        (check c (= (dec 0.5f32) -0.5f32))
        (check c (= (inc 1.5) 2.5))
        (check c (= (dec 0.0) -1.0))
        (check c (= (inc -0.5) 0.5))
        (check c (= (twice-inc 5i8) 7i8))
        (check c (= (twice-inc 5) 7))
        (check c (= (twice-inc 5.5) 7.5))
        (checks-result c))))
