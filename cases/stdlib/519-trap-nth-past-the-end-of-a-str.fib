;; spec:   stdlib §2.9 (nth of a str), plan §4.3 rule 8 (a trap names the function)
;; expect: trap
;; trap:   nth: index out of range
;; roots:  ../../lib support
;; nth of a str is by character: "aé€" has indexes 0 to 2 (six bytes, so a
;; byte index 3 would still be inside it), and index 3 is one past the last
;; character. The call at index 2 is made first.
(ns main (:use fib.core fib.seq))

(defun main () -> i64
  (let ((s "aé€"))
    (+ (zext i64 (char->i32 (nth s 2)))
       (zext i64 (char->i32 (nth s 3))))))
