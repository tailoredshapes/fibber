(ns main (:require [fib.tensor :as t]) (:use tl.check))

(defun main () -> i64
  (let ((c (checks)) (n 9223372036854775807)
        (x (t/mmul (t/full [0 0] 1.0) (t/full [0 n] 1.0)))
        (y (t/mmul (t/full [0 0] 1.0f32) (t/full [0 n] 1.0f32))))
    (do (check c (= (t/shape x) [0 n]))
        (check c (= (t/shape y) [0 n]))
        (check c (= (t/size x) 0))
        (check c (= (t/size y) 0))
        (checks-result c))))
