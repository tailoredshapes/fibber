;; spec:   docs/design/parallelism.md 3.5 (P-det); lib/fib/parallel/reduce.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; The shape of the tree is observable with a combine that records it: strings. One element per chunk (grain 1), a chunk is its digit, the
;; combine wraps `(a b)`. Level by level, adjacent pairs, an odd last one carried up: 5 chunks are (((0 1) (2 3)) 4), 6 are (((0 1) (2 3)) (4 5)),
;; 7 are (((0 1) (2 3)) ((4 5) 6)), 1 is 0. The same string for every worker count. Also: `init` for an empty input, integer folds equal
;; `reduce`, `preduce` equals `pfold`, `:fast` (a left to right combine) is exact for integers. A left to right combine of the chunk results
;; gives ((((0 1) 2) 3) 4) and fails here.
(ns main (:use fib.core fib.parallel tl.check))

(defun shape (w: i64 n: i64) -> str
  (pfold-chunks (Par w 1 false) n (fn (a: str b: str) (str "(" a " " b ")")) "" (fn (lo hi) (str lo))))

(defun main () -> i64
  (let [c (checks)]
    (do (doseq [w [1 2 3 4 7 28]]
          (do (check c (= (shape w 5) "(((0 1) (2 3)) 4)"))
              (check c (= (shape w 6) "(((0 1) (2 3)) (4 5))"))
              (check c (= (shape w 7) "(((0 1) (2 3)) ((4 5) 6))"))
              (check c (= (shape w 1) "0"))
              (check c (= (shape w 0) ""))))
        (let [xs (vec (range 1 100001))
              want (reduce + 0 xs)]
          (do (doseq [w [1 2 5 28]]
                (do (check c (= (pfold (Par w 0 false) + (fn (a x) (+ a x)) 0 xs) want))
                    (check c (= (preduce (Par w 777 false) + 0 (fn (x) x) xs) want))
                    (check c (= (preduce (Par w 0 true) + 0 (fn (x) x) xs) want))
                    (check c (= (preduce-n (Par w 100 false) + 0 (fn (i) (+ i 1)) 100000) want))))
              (check c (= (pfold + (fn (a x) (+ a x)) 42 (vec-empty)) 42))
              (check c (= (preduce + 0 (fn (x) (* 2 x)) xs) (* 2 want)))))
        (checks-result c))))
