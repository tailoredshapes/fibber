;; spec:   types §2.13.3 (array-blit!)
;; expect: trap
;; trap:   array-blit! of 3 elements at dst 4 (of 6) from src 0 (of 10) is out of range
;; roots:  ../../lib support
;; covers: array-blit!
;; Three elements at offset 4 of a six-element array do not fit: the call traps with the numbers in its message.
(ns main (:use fib.core))

(defun main () -> i64
  (let ((d (cell (array 6 0i8))) (s (array 10 1i8)))
    (do (array-blit! &d 4 s 0 3) 0)))
