;; spec:   stdlib §5.5 S3, §2.2, §7 L22 (arity-reading forms)
;; expect: accept
;; result: 6
;; audit:  clean
;; open:   L22
;; Clojure's (partial f a) of a three-parameter f is a function of the two
;; parameters left, whatever the arity of f: the checker reads it from the
;; type of f. Today the only `partial` is the library's one-free form and
;; none is in scope; the failing shape in the prototype was `cannot unify
;; (fn :send (i64 i64 i64) i64) with (fn (a b) c)` (A11 arity).
(defun add3 (a: i64 b: i64 c: i64) -> i64 (+ a (+ b c)))

(defun main () -> i64
  (let ((g (partial add3 1)))
    (g 2 3)))
