;; spec:   stdlib §2.7, §2.3 (ToStr, Debug)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; str of a string is the string itself and pr of a string is the string
;; in double quotes, as in Clojure: (str "ab") is ab and (pr-str "ab") is
;; "ab" with its quotes. These two instances are P0's; the instances for
;; every other type are L11's.
(ns main (:use fib.core tl.check))

(defun main () -> i64
  (let ((c (checks)))
    (do (check c (= (to-str "ab") "ab"))
        (check c (= (to-str "") ""))
        (check c (= (debug "ab") "\"ab\""))
        (check c (= (debug "") "\"\""))
        (check c (= (str-len (debug "é")) 4))
        (checks-result c))))
