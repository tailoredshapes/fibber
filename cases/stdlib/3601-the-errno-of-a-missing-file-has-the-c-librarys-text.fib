;; spec:   stdlib "sys primitives" (S5)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: fd-open errno-text
;; A missing file is an Err of ENOENT (2), and the text of the errno is the C library's.
(ns main (:use tl.check tl.sysx fib.unix))

(defun main () -> i64
  (let ((c (checks))
        (r (fd-open "/tmp/fib-s5-3601-missing/none" O_RDONLY 0)))
    (do (check c (= (num r) -2))
        (check c (= (errno-text 2) "No such file or directory"))
        (check c (= (errno-text 13) "Permission denied"))
        (check c (= (errno-text 9) "Bad file descriptor"))
        (checks-result c))))
