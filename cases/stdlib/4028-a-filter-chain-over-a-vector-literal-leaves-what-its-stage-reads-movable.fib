;; spec:   stdlib §2.1 rule 2 (a fused chain in line), §2.5 (in place when unique); compiler/expand/fusegen.fib `fg-spans-known?`
;; expect: accept
;; result: 1250
;; audit:  clean
;; allocs: <= 16000
;; roots:  ../../lib support
;; covers: filterv assoc
;; A filter chain over a vector literal is put in line with no branch for a source without spans: a Vec always has them. That branch
;; called the library's `filterv` with the stage literal, an escaping use that made it a heap closure; a binding the literal captures
;; was then never moved at its last use (a capture pins it), so the flood fill below, which filters the neighbours of a cell with a
;; literal that reads `labels` and then labels them, retained `labels` for every `assoc` and copied the flat Vec of 2500 into a trie at
;; the first and a path at each one after. In place, a cell costs the objects of the neighbour Vecs only: measured 15367 objects; 22642
;; (with the filter builder of 75054f10) with the stage 2 before the rewrite, 28792 with the stage 2 and library of f748147c. The result is the
;; number of cells labelled (the 50 by 50 grid's even rows) and must not depend on the rewrite.
(ns main (:use fib.core fib.seq fib.coll))

(defun flood (fg: (Vec bool) labels: (Vec i64) w: i64 start: i64) -> (Vec i64)
  (loop ((head 0) (queue [start]) (labels (assoc labels start 1)))
    (if (>= head (count queue))
        labels
        (let ((i (nth queue head)) (x (rem i w)) (y (quot i w))
              (next (filterv (fn (j: i64) (and (>= j 0) (nth fg j) (= (nth labels j) 0)))
                             [(if (< x (- w 1)) (+ i 1) -1) (if (> x 0) (- i 1) -1) (if (< y (- w 1)) (+ i w) -1) (if (> y 0) (- i w) -1)])))
          (recur (+ head 1) (into queue next) (reduce (fn (ls: (Vec i64) j: i64) (assoc ls j 1)) labels next))))))

(defun main () -> i64
  (let ((w 50)
        (fg (mapv (fn (c: i64) (= (rem (quot c 50) 2) 0)) (range 2500))))
    (let ((labels (loop ((s 0) (labels (mapv (fn (_: i64) 0) (range 2500))))
                    (cond (>= s 2500) labels
                          (or (not (nth fg s)) (not (= (nth labels s) 0))) (recur (+ s 1) labels)
                          :else (recur (+ s 1) (flood fg labels w s))))))
      (reduce + 0 labels))))
