;; spec:   stdlib §4.4 row map (the overloads by arity, L1), §2.1 rule 5 (lockstep walks)
;; expect: accept
;; result: 1353
;; audit:  clean
;; roots:  ../../lib support
;; covers: map
;; open:   L1
;; Clojure's (map f c1 c2) walks two collections in step and stops at the
;; shorter: here the sums 11, 22 and 33, as a number 1353. Until arity
;; clauses exist (L1) `map` has the one-collection form only, which the
;; checker says as an arity error, and the page's stand-in is `zip-with`
;; (tranche 2); the three-collection form is the same item.
(ns main (:use fib.core fib.seq))

(defun digits (c: c) :where ((Reducible c i64)) -> i64
  (let ((acc (cell 0)))
    (do (each-while c (fn (x) (do (set! acc (+ (* @acc 10) x)) true))) @acc)))

(defun main () -> i64
  (digits (map (fn (a: i64 b: i64) (+ a b)) [1 2 3] [10 20 30])))
