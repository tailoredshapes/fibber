;; spec:   syntax §4.4 (Declining), §5
;; expect: accept
;; result: 0
;; audit:  clean
;; Every kind of top-level definition makes the prelude macro of its name decline in the module:
;; a defn (when), a defstruct (the constructor unless), a defenum variant (cond with a field,
;; print without) and a defprotocol method (list), the definitions written after main, which
;; calls them. Before R14 each call was the macro's (when and unless an if, cond a clause list,
;; list a Cons chain). The result is 0 when every call answered the module's own, else the bits
;; of those that did not.
(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (let ((u (unless 5 6))
        (s (cond 3))
        (n print))
    (+ (ck (= (when 5) 6) 1)
       (+ (ck (= (. u b) 6) 2)
          (+ (ck (match s ((cond k) (= k 3)) (_ false)) 4)
             (+ (ck (match n ((print) true) (_ false)) 8)
                (ck (= (list 7) 14) 16)))))))

(defn when [x: i64] -> i64 (+ x 1))
(defstruct unless (a: i64 b: i64))
(defenum Shape (cond n: i64) (print))
(defprotocol Sized (list (self) -> i64))
(impl Sized i64 (list (self) (* self 2)))
