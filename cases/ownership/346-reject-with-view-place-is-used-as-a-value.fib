;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   lent place must be a private cell: a is used as a value
;; stage:  2
;; Check V5, an alias of the lent place (a value use of the cell) would be a second name for it (L1).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (let ((alias a))
      (with-view [v (array-window! &a 0 2)] (do (vset! v 0 1) 0)))))
