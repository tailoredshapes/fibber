;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    window index -1 out of range for a window of 4
;; stage:  2
;; Check R4, a negative index into a window traps (the window's own bounds, not the buffer's).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [v (array-window! &a 4 8)] (vget v -1))))
