;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    array-window!: range [4, 9) outside an array of 8
;; stage:  2
;; A window whose range leaves the array is refused at the lend, before any pointer is made.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [v (array-window! &a 4 9)] 0)))
