;; spec:   syntax §3.9a (a constructor as a value), types §6
;; expect: accept
;; result: 12
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A constructor passed as a function is `(fn (c) (Ctor c))`: the argument is moved into the object, as when it is called. The vectors that `Wrap` holds are
;; counted once each (the audit finds no leak and no double free), the originals are consumed by `mapv`, and a second pass over the wrapped
;; objects shares them without copying.
(ns main (:use fib.core))
(defstruct Wrap (v: (Vec i64)))
(defun total (ws: (Vec Wrap)) -> i64 (reduce + 0 (mapv (fn (w: Wrap) (count (. w v))) ws)))
(defun main () -> i64
  (let ((vs [[1 2] [3 4 5] [6]])
        (ws (mapv Wrap vs))
        (opts (mapv some ws)))
    (+ (total ws) (count opts) (total (mapv Wrap [[1] [2] [3]])))))
