;; spec:   types §2.13.2 (the operand must be unique)
;; expect: accept
;; result: 1010
;; audit:  clean
;; `a` and `c` both hold the array (count two); `(array-with @c 0 9)` consumes an acquired reference to it (the cell read), the count is
;; three at the call, and the result is a copy: `a` keeps 1 in slot 0 and the written copy has 9 (1000 + 9 + 1).
(defun main () -> i64
  (let ((a (array 4 1)))
    (let ((c (cell a)))
      (let ((b (array-with @c 0 9)))
        (+ 1000 (array-get b 0) (array-get a 0))))))
