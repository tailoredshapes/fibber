;; spec:   spec/types.md §6.2, §6.3 (Element reads)
;; expect: accept
;; result: 7
;; audit:  clean
;; The array operand is a field of a call's result, a part of a temporary of the call step: the element read would be `Derived` of
;; that temporary, which is released at the end of the step, so the read is `Owned` (retained once) and the box outlives the
;; holder. The field `n` is read after the step. A read left `Derived` of the released temporary reads a freed box; one that is
;; `Derived` and also retained at the step's end leaves a count that nothing releases (a leak the audit reports).
(defstruct Box (n: i64))
(defstruct Holder (arr: (Array Box)))

(defun mk (k: i64) -> Holder (Holder (array 2 (Box k))))

(defun main () -> i64
  (+ (. (array-get (. (mk 3) arr) 0) n) (. (array-get (. (mk 4) arr) 1) n)))
