;; spec:   syntax §5, §3.20, §3.16
;; expect: accept
;; result: 4
;; audit:  clean
;; A macro's expansion is resolved where the macro is used (syntax
;; §3.16: no automatic hygiene), so a template that must reach a private
;; helper writes (var m/helper) (§5, §3.20). var names only top-level
;; definitions: the local array-push that the use site binds does not
;; capture the template's reference, which is the prelude's private
;; helper.
(defmacro push-one (a x) `((var fib.prelude/array-push) ~a ~x))

(defun main () -> i64
  (let ((array-push 100)
        (grown (push-one (array 3 0) array-push)))
    (if (= (array-get grown 3) 100) (array-len grown) 0)))
