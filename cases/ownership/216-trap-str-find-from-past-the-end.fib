;; spec:   syntax §4.3; stdlib design 7 (L18)
;; expect: trap
;; trap:   str-find: from 4 out of range 0..3
;; `from` may be the length itself (nothing is left to find but the empty
;; pattern, which is found there) and not one more. The first call, at the
;; length, answers; the second, one past it, traps with `from` and the
;; length in the message.
(defun offset (r: (Option i64)) -> i64
  (match r ((some n) n) (nil -1)))

(defun main () -> i64
  (let ((s "aé"))
    (+ (offset (str-find s "" (str-len s)))
       (offset (str-find s "" (+ (str-len s) 1))))))
