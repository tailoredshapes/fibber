;; spec:   syntax §3.16
;; expect: reject
;; error:  :12:8: trap: boom: the argument is not a symbol
;; A macro body that runs `trap` fails the expansion, as any macro
;; failure does (syntax §3.16): the program is rejected with the
;; trap's message and the tool goes on to the next program. It is not
;; the abort of a run-time trap, which would end the compiler with the
;; message and exit status 134.
(defmacro boom (x)
  (match x
    ((Sym s) (Sym s))
    (_ (trap "boom: the argument is not a symbol"))))

(defun main () -> i64 (boom 1))
