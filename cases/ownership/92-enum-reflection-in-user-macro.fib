;; spec:   syntax §3.16
;; expect: accept
;; result: 12
;; audit:  clean
;; User macros calling enum-variants and enum? on the built-in Option.
;; The reflection builtins return the values their types promise, a
;; (Vec Form) and a bool, not a Form describing them: Option has two
;; variants and is an enum, 2 + 10 = 12 (adversary finding 012).
(defmacro nvariants (name) (Int (vec-count (enum-variants name)) :i64))
(defmacro isenum (name) (if (enum? name) (quote 10) (quote 0)))

(defun main () -> i64 (+ (nvariants Option) (isenum Option)))
