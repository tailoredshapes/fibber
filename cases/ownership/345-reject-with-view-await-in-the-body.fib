;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   await inside with-view
;; stage:  2
;; Check V3g, an await inside the body (L5): a task frame is never suspended with a lend outstanding.
(ns main (:use fib.view))

(defun main () -> i64
  (do (async (let ((a (cell (array 4 0))))
               (with-view [v (array-window! &a 0 2)] (await (async 1)))))
      0))
