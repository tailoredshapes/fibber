;; spec:   types §6.4 (Declared owned); syntax §3.1
;; expect: reject
;; error:  has no count kind
;; An `&` parameter is the callee's private cell: it is not handed over with a count, so `:owned` has nothing to declare there.
(defun bump (&a: (Array i64) :owned) -> unit (array-set! &a 0 9))

(defun main () -> i64
  (let ((c (cell (array 4 1))))
    (do (bump &c) (array-get @c 0))))
