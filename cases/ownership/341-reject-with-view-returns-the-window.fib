;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   view cell v can only be read as a call argument
;; stage:  2
;; Check V3, the value of the form is the window, which would outlive its owner (VC1: a view cell is read only as a call argument).
(ns main (:use fib.view))

(defun leak () -> (Win i64)
  (let ((a (cell (array 4 0))))
    (with-view [v (array-window! &a 0 2)] @v)))
(defun main () -> i64 0)
