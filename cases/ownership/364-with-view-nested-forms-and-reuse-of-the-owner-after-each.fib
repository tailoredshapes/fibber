;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Two forms in a row over one place (the owner is usable between them), and a window of f64 elements.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 6 0.5))))
    (do (with-view [v (array-window! &a 0 3)] (vset! v 2 4.0))
        (let ((x (+ (array-get @a 2) 1.0))) (with-view [w (array-window! &a 3 6)] (do (vset! w 0 x) (fill! w x))))
        (if (and (= (array-get @a 2) 4.0) (= (array-get @a 3) 5.0) (= (array-get @a 5) 5.0) (= (array-get @a 0) 0.5)) 0 1))))
