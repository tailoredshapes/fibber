;; spec:   types §2.12, §8.12 (method.md rule 6)
;; expect: accept
;; result: 2677090
;; audit:  clean
;; Integer arithmetic has Rust's semantics (Decided, owner, 2026-09-27).
;; The shift amount is taken modulo the width, so (shl 1 64) is 1,
;; (sar -1 65) is -1 and (shr -1 127) is 1; float-to-integer conversion
;; saturates and NaN converts to 0, so (fptosi i8 300.0) is 127,
;; (fptoui i8 300.0) is 255, an infinity converts to the maximum or
;; minimum of i64, and NaN to 0. LLVM gives poison for all of these, so
;; the compiled program emits the masks and the saturating conversions
;; (types §8.12). The sum is 1 - 10 + 100 + 127000 + 2550000 + 0 - 1.
;; Division and remainder by zero and signed overflow, including
;; (/ i64-min -1) that adversary finding 014 expected to wrap, now trap;
;; a case can only accept or reject, so the traps are pinned by the
;; evaluator's unit tests (eval::arith, eval::tests::values).
(defun main () -> i64
  (let ((inf (/ 1.0 0.0)) (nan (/ 0.0 0.0)))
    (+ (shl 1 64)
       (+ (* 10 (sar -1 65))
          (+ (* 100 (shr -1 127))
             (+ (* 1000 (sext i64 (fptosi i8 300.0)))
                (+ (* 10000 (zext i64 (fptoui i8 300.0)))
                   (+ (fptosi i64 nan)
                      (+ (fptosi i64 inf) (fptosi i64 (- 0.0 inf)))))))))))
