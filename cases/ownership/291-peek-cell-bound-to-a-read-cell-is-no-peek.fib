;; spec:   spec/types.md §6.3 (Cell peeks, P1)
;; expect: accept
;; result: 1
;; audit:  clean
;; `c` is a cell that another binding holds as well (`h` holds it): it is not a binding initialised by `(cell e)`, so `@c` is not a
;; peek even though `c` itself is only ever read. The index writes the cell through `h`, and the read still sees the old array
;; (value 1). Were `c` a peek the old array would be freed under the read and the read would see 9.
(defun nine () -> (Array i64) (array 4 9))

(defun poke (h: (Array (Cell (Array i64)))) -> i64
  (do (set! (array-get h 0) (array 4 7))
      (let [z (nine)] (- (array-get z 0) 8))))

(defun main () -> i64
  (let [a (cell (array 4 1))
        h (array 1 a)
        c (array-get h 0)]
    (+ 0 (array-get @c (poke h)))))
