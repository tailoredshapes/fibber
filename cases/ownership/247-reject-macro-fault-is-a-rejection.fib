;; spec:   syntax §3.16
;; expect: reject
;; error:  :9:21: trap: integer / by zero
;; A fault in the code of a macro, here a division by zero, fails the
;; expansion as a `trap` in its body does (case 246): the program is
;; rejected with the fault's message and the tool goes on to the next.
(defmacro divide (x)
  (match x
    ((Int n w) (Int (quot n (- n n)) w))
    (_ x)))

(defun main () -> i64 (divide 7))
