;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   a is lent to v and cannot be used here
;; stage:  2
;; Check V2b, the lender's own operand reads the lent place (L2), which would stop the lend from being a take. Twin: case 337 (the read is
;; bound before the form).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [v (array-window! &a 0 (array-len @a))]
      (do (vset! v 0 1) 0))))
