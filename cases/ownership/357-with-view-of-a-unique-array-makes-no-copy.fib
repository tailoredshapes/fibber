;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; allocs:  <= 2
;; stage:  2
;; Check R2, a unique array is lent and written in place: the run allocates the array, the cell, the view cell and the window and nothing
;; more (no second array). Case 358 is the shared twin, which costs exactly one array more.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 1000 1))))
    (do (with-view [v (array-window! &a 0 1000)] (fill! v 2))
        (if (= (array-get @a 999) 2) 0 1))))
