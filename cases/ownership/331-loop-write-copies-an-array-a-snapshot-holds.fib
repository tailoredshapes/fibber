;; spec:   types §2.13.1, §8.3 (array-set! writes in place only a unique array), emit.lower.hoist
;; expect: accept
;; result: 0
;; audit:  clean
;; `snap` holds the array the cell starts with, so the loop's writes must go to a copy: the snapshot stays all zeros while the cell's array
;; becomes 1 2 3 4. A hoisted loop that made no copy first (the unique check skipped, not hoisted) would change `snap` too: result 1.
(defun main () -> i64
  (let ((snap (array 4 0)) (buf (cell snap)))
    (do (dotimes (i 4) (array-set! &buf i (+ i 1)))
        (let ((now @buf))
          (if (and (= (array-get snap 0) 0) (= (array-get snap 3) 0)
                   (= (array-get now 0) 1) (= (array-get now 3) 4))
              0
              1)))))
