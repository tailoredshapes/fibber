;; spec:   docs/design/in-place-update.md §5 (lever L5, shell reuse)
;; expect: accept
;; result: 11
;; audit:  clean
;; `twice` builds a `Box` from the fields of `b` and then reads `b` again. The argument is unique (nothing else holds it), so building the new
;; object in `b`'s memory would be possible at run time, but `b` is read after the construction: the plan must not reuse it. If it did, `(. b n)`
;; would read the new object's 6 and the result would be 12.
(defstruct Box (n: i64 v: (Vec i64)))

(defun twice (b: Box) -> i64
  (match b
    ((Box n v) (let ((c (Box (+ n 1) v))) (+ (. c n) (. b n))))))

(defun main () -> i64
  (twice (Box 5 (vec-conj (vec-empty) 1))))
