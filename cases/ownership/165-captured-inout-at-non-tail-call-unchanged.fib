;; spec:   §5 (types §6.6; syntax §3.13)
;; expect: accept
;; result: 21
;; audit:  clean
;; A closure over f's & parameter v passed to a call that is not in tail
;; position: a copy-in and a write-back, before the owner's decision of
;; 2026-09-28 as after it. g returns 1 and its write-back stores 1 into
;; v, losing the closure's 7; f returns 1 + 1 = 2 and leaves 1 in c.
;; 10 * 2 + 1.
(defun g (&w: i64 k: (fn () unit) :borrow) -> i64 (do (set! w 1) (k) @w))
(defun f (&v: i64) -> i64 (let ((r (g &v (fn () (set! v 7))))) (+ r @v)))
(defun main () -> i64 (let ((c (cell 0))) (let ((r (f &c))) (+ (* 10 r) @c))))
