;; spec:   syntax §4.3; stdlib design 7 (L18)
;; expect: trap
;; trap:   str-byte-at: index -1 out of range 0..3
;; A negative index is out of range, not counted from the end: Clojure's
;; `nth` does not count from the end either. The compiled check is one
;; unsigned compare, which must refuse a negative index with the rest; the
;; index is computed, so no constant folding can see it.
(defun main () -> i64
  (let ((s "aé"))
    (zext i64 (str-byte-at s (- (str-len s) 4)))))
