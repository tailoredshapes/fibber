;; spec:   types §2.13.2 (the flags), §6.6 (HAS-WEAK, case 89)
;; expect: accept
;; result: 109
;; audit:  clean
;; `a` is unique (one holder, at its last use in the `array-with`) but a weak reference was taken of it: HAS-WEAK says copy. The copy is
;; the result, the operand's count is released and the array dies, so `@w` is nil (100); written in place, the weak reference would see
;; an immutable object change and return 9.
(defun main () -> i64
  (let ((a (array 4 1)))
    (let ((w (weak a)))
      (let ((b (array-with a 0 9)))
        (+ (array-get b 0)
           (match @w ((some x) (array-get x 0)) (nil 100)))))))
