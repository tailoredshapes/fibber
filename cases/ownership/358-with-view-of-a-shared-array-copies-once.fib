;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; allocs:  <= 3
;; stage:  2
;; Check R3, the same program with a counted holder of the array: one more allocation (the copy), made at the lend, not per write.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 1000 1))))
    (let ((r @a))
      (do (with-view [v (array-window! &a 0 1000)] (fill! v 2))
          (if (and (= (array-get @a 999) 2) (= (array-get r 999) 1)) 0 1)))))
