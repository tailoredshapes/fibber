;; spec:   §8 (syntax §3.6: a guard may await inside an async body)
;; expect: accept
;; result: 2
;; audit:  clean
;; The clause's rest is built in the task before the guard awaits, so
;; it is held across the await by the task's frame, and released there
;; after the body.
(defun main () -> i64
  (let ((v [1 2 3]))
    (block-on
      (async
        (match v
          ([x & r] :when (> (await (async (+ x 1))) 1) (count r))
          (_ 0))))))
