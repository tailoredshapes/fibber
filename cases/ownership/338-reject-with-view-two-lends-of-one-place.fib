;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   a is lent to x and cannot be used here
;; stage:  2
;; Check V1, two windows of one place in one form, even over disjoint ranges: the second lender call mentions the lent place (L2).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [x (array-window! &a 0 4) y (array-window! &a 4 8)]
      (do (vset! x 0 1) (vset! y 0 2) 0))))
