;; spec:   types §6.3 (consume), §6.10; docs/design/in-place-update.md §1 (lever L1)
;; expect: accept
;; result: 15
;; audit:  clean
;; `b` is bound outside the loop and consumed inside it: the call is the
;; last use in the body text, but the next iteration reads `b` again, so it
;; is retained every time. Moved, the second iteration would read a freed Box.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((eat (fn (b: Box) (. b n)))
        (b (Box 5)))
    (loop ((i 0) (acc 0))
      (if (< i 3) (recur (+ i 1) (+ acc (eat b))) acc))))
