;; spec:   spec/types.md §6.3 (Cell peeks, P2)
;; expect: accept
;; result: 7
;; audit:  clean
;; `(. @s n)` is a peek: a scalar field of the content of a cell. `(. @s arr)` is not: its value is an object that outlives the
;; read. `x` holds the old array while the cell is replaced, and an array of the same size is allocated; `x` must read 1, then the
;; new `n` is 6. As a peek of an object field `x` would dangle and read 9.
(defstruct Box (arr: (Array i64) n: i64))

(defun nine () -> (Array i64) (array 4 9))

(defun main () -> i64
  (let [s (cell (Box (array 4 1) 5))]
    (let [x (. @s arr)]
      (do (set! s (Box (array 4 7) 6))
          (let [z (nine)]
            (+ (+ (array-get x 1) (- (array-get z 0) 9)) (. @s n)))))))
