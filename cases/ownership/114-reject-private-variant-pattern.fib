;; spec:   syntax §5, §3.6
;; expect: reject
;; error:  is private to fib.prelude; it is not exported
;; A Vec's trie nodes are the prelude's private enum VNode (lib/prelude.fib).
;; Vec and its variant VecOf are exported, so a program may match a Vec
;; and bind its root, but a private enum's variants are not nameable
;; outside its module, in a pattern as in an expression (syntax §5): the
;; program cannot reach into the trie's representation. The message names
;; VLeaf (a header text may not start with a capital).
(defun leaves (v: (Vec i64)) -> i64
  (match v
    ((VecEmpty) 0)
    ((VecOf _ _ root _)
     (match root
       (nil 0)
       ((some (VLeaf items)) (array-len items))
       ((some _) 1)))))

(defun main () -> i64 (leaves (range 40)))
