;; spec:   §7 (types §8.8)
;; expect: accept
;; result: 7
;; audit:  clean
;; A spawned thread spins on an atom until main sets it; main sets it
;; after the spawn and only then joins. Every fair execution ends, with
;; 7. An executor that ran a spawned thread to completion before its
;; spawner continued never did: the thread spun for ever waiting for a
;; store that main could not reach (the M2 known gap). The reference
;; interpreter's executor switches threads at scheduling points, among
;; them an atom read and a loop's back edge (types §8.8), so the
;; spinning thread yields and main runs.
(defun main () -> i64
  (let ((a (atom 0))
        (t (spawn (fn () (loop () (if (= @a 0) (recur) @a))))))
    (do (reset! a 7)
        (join t))))
