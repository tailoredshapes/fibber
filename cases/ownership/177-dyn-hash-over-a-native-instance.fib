;; spec:   types §2.12, §4.4, §8.5
;; expect: accept
;; result: -680
;; audit:  clean
;; A (dyn Hash) over a str beside one over a struct: the str's Hash is
;; a native instance (types §2.12, no method bodies), so its vtable
;; slot is a function the compiler emits around the native method,
;; called through the dyn like any implementation (§8.5). hash of a
;; str is the FNV-1a of its bytes (case 169), folded by rem; of K its
;; field.
(defstruct K (n: i64))
(impl Hash K (hash (self) (. self n)))

(defun main () -> i64
  (let ((xs [(dyn Hash "abc") (dyn Hash (K 5))]))
    (+ (rem (hash (nth xs 0)) 1000) (hash (nth xs 1)))))
