;; spec:   types §2.12 (syntax §4.3)
;; expect: accept
;; result: 1209
;; audit:  clean
;; Show and Hash are native instances on every scalar and on str
;; (types §2.12). show gives a fresh str each time; hash of an integer
;; is its value, of a bool or char its code, of a field-less enum its
;; variant index, of a keyword the FNV-1a of its name and of a str of
;; its bytes, of a float the bits of its value as an f64, of unit 0.
;; The result folds every text's length and every hash, so a wrong
;; text or hash changes it.
(defenum Colour (Red) (Green) (Blue))

(defun texts () -> i64
  (+ (str-len (show 42))
     (+ (str-len (show -7i8))
        (+ (str-len (show 100000i32))
           (+ (str-len (show true))
              (+ (str-len (show \u{3BB}))
                 (+ (str-len (show Green))
                    (+ (str-len (show :key))
                       (str-len (show ()))))))))))

(defun hashes () -> i64
  (+ (hash 42)
     (+ (hash -7i8)
        (+ (hash true)
           (+ (hash \a)
              (+ (hash Blue)
                 (+ (rem (hash :key) 1000)
                    (+ (rem (hash "abc") 1000)
                       (+ (rem (hash 1.5) 1000)
                          (+ (rem (hash 2.5f32) 1000)
                             (hash ())))))))))))

(defun main () -> i64 (+ (texts) (hashes)))
