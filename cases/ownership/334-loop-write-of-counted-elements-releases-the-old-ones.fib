;; spec:   types §2.13.1, §8.3, emit.lower.hoist
;; expect: accept
;; result: 0
;; audit:  clean
;; The hoisted write of an element that is an object (a `str`) must still release the element it replaces, and the nested loops hoist the
;; cell once (the inner loop finds it already hoisted): a leaked text or a count taken twice fails the memory audit. The cell's array is
;; shared with `orig` when the loops start, so the first write copies and `orig` keeps its elements.
(defun main () -> i64
  (let ((orig (array 3 "old")) (n 3))
    (let ((buf (cell orig)))
      (do (dotimes (r 2)
            (dotimes (i n) (array-set! &buf i (str "new" r i))))
          (if (and (= (array-get orig 0) "old") (= (array-get @buf 0) "new10") (= (array-get @buf 2) "new12")) 0 1)))))
