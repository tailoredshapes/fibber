;; spec:   syntax §3.6 (types §2.6, §8.3)
;; expect: accept
;; result: 158
;; audit:  clean
;; Vector patterns by length: [] and [x] match exactly those lengths,
;; [0 y] a literal first element, [x y z & _] every length from three
;; up without building a rest. The clauses are exhaustive: lengths 0,
;; 1 and 2 have a clause each and [x y z & _] covers the rest.
;; 0 + 7 + 40 + 5 + 106 = 158.
(defun classify (v: (Vec i64)) -> i64
  (match v
    ([] 0)
    ([x] x)
    ([0 y] (* 10 y))
    ([x y] (+ x y))
    ([x y z & _] (+ 100 (+ x (+ y z))))))

(defun main () -> i64
  (+ (classify [])
     (+ (classify [7])
        (+ (classify [0 4])
           (+ (classify [2 3])
              (classify [1 2 3 4 5]))))))
