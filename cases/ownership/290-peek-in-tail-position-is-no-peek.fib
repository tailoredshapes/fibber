;; spec:   spec/types.md §6.3 (Cell peeks, P2)
;; expect: accept
;; result: 7
;; audit:  clean
;; `total` is called in tail position with the content of a cell the frame owns: the jump of the tail call would release the cell
;; first (spec/types.md §6.10 step 3). A call in tail position is never a peek, so the call is an ordinary one and `total` reads 7.
;; As a peek the array would be freed before `total` runs, `z` would take its memory and `total` would read 9.
(defun total (a: (Array i64)) -> i64
  (let [z (array 4 9)] (+ (array-get a 1) (- (array-get z 0) 9))))

(defun tail-read () -> i64
  (let [a (cell (array 4 7))] (total @a)))

(defun main () -> i64 (tail-read))
