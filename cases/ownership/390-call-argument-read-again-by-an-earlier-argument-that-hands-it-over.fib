;; spec:   types §6.3
;; expect: accept
;; result: 4
;; audit:  clean
;; Package BUG-1, a parameter that a join retains is owned (rule 1), so a caller hands it over; the same in an ordinary call, y last.
(defun pick2 (a: (Array i64) b: (Array i64)) -> (Array i64) (if (= (array-len b) 0) a b))
(defun two (a: (Array i64) b: (Array i64)) -> i64 (+ (array-get a 0) (array-get b 0)))
(defun t () -> i64 (let [y (array 4 2) x (array 4 1)] (two (pick2 x y) y)))
(defun main () -> i64 (t))
