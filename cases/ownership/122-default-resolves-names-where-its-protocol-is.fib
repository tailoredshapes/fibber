;; spec:   types §4.1, §2.12 (syntax §5)
;; expect: accept
;; result: 1
;; audit:  clean
;; The built-in Eq's default != is (not (= self y)) (types §2.12). The
;; program defines its own not, the identity, which shadows the builtin
;; in the program's module (syntax §5). The default's names resolve
;; where Eq is defined (types §4.1), so Pt's != still negates: the two
;; points differ, and != says so.
(defun not (b: bool) -> bool b)

(defstruct Pt (x: i64))
(impl Eq Pt (= (self o) (= (. self x) (. o x))))

(defun main () -> i64 (if (!= (Pt 1) (Pt 2)) 1 0))
