;; spec:   types §3.3, §4.4
;; expect: accept
;; result: 12
;; audit:  clean
;; A generic function whose inferred bound (Score a) is instantiated at
;; (dyn Score): the calls inside it resolve to the bound, and the
;; specialisation at (dyn Score) meets it with the receiver's own
;; vtable (§3.3), not with an instance. The compiler looked for an
;; instance of Score at a dyn and reported the program unsupported
;; (found by `fibc gen`, fibgen seed 35 size 5).
(defstruct Pt (x: i64))
(defprotocol Score (score (self) -> i64))
(impl Score Pt (score (self) (* 2 (. self x))))
(defun twice (a) (+ (score a) (score a)))
(defun main () -> i64 (twice (dyn Score (Pt 3))))
