;; spec:   types §2.11, §2.12 (method.md rule 3)
;; expect: trap
;; trap:   integer / by zero
;; Integer division by zero traps (types §2.12). It happens on a thread
;; that main joins: a trap on any thread aborts the whole program
;; (types §2.11), with the task and the vector it captured still live.
(defun main () -> i64
  (let ((v [1 2 3])
        (t (spawn (fn () (/ 10 (- (count v) 3))))))
    (join t)))
