;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; A user function with an `&` parameter of window type is a kernel: the view cell is passed as `&v`, the kernel writes it with vset!
;; and fills the rest with a loop. Twin of case 367, which tries to return the window from such a kernel.
(ns main (:use fib.view))

(defun scale! (&w: (Win f64) k: f64) -> unit
  (loop ((i 0))
    (when (< i (vlen w)) (do (vset! w i (* k (vget w i))) (recur (+ i 1))))))
(defun main () -> i64
  (let ((a (cell (array 6 2.0))))
    (do (with-view [v (array-window! &a 1 5)] (scale! &v 3.0))
        (if (and (= (array-get @a 0) 2.0) (= (array-get @a 1) 6.0) (= (array-get @a 4) 6.0) (= (array-get @a 5) 2.0)) 0 1))))
