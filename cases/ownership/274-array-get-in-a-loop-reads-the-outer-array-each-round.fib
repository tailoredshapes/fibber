;; spec:   spec/types.md §6.3 (Element reads, the element cannot outlive the array)
;; expect: accept
;; result: 14
;; audit:  clean
;; An element of the outer array `a` is read in every round of a loop that rebuilds a second array with `array-with`, and the
;; element read is passed on to the next round in the loop variable `last` (a part of `a`, retained by the `recur`; the old value
;; of `last` is released). `a` is read in each round and is never at a last use inside the loop. A count missing at the `recur`
;; would free a box that `a` still holds.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((a (array 3 (Box 2))))
    (loop ((i 0) (acc 0) (last (array-get a 0)) (b a))
      (if (< i 3)
          (recur (+ i 1) (+ acc (. (array-get b i) n)) (array-get a i) (array-with b i (Box (+ i 1))))
          (+ (+ acc (. last n)) (* 2 (. (array-get b 2) n)))))))
