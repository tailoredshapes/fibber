;; spec:   types §6.3
;; expect: accept
;; result: 52
;; audit:  clean
;; Joins of three and more arms, nested, and of match clauses, one arm borrowed.
(defun fresh (b: (Array i64) n: i64) -> (Array i64)
  (let [r (cell (array n 0))] (do (array-set! &r 0 (array-get b 0)) @r)))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun n1 (b: (Array i64) c: bool d: bool) -> i64 (let [v (if c (if d b (fresh b 2)) (fresh b 3))] (sink v)))
(defun c1 (b: (Array i64) c: i64) -> i64 (let [v (cond (= c 0) b (= c 1) (fresh b 3) true (fresh b 5))] (sink v)))
(defun m1 (b: (Array i64) c: (Option i64)) -> i64 (let [v (match c ((some x) (fresh b x)) (nil b))] (sink v)))
(defun main () -> i64
  (let [a (array 4 3)]
    (+ (+ (+ (n1 a true true) (n1 a true false)) (n1 a false true))
       (+ (+ (+ (c1 a 0) (c1 a 1)) (c1 a 2)) (+ (m1 a (some 3)) (m1 a nil))))))
