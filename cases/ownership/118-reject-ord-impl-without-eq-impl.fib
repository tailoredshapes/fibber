;; spec:   types §4.1, §2.7
;; expect: reject
;; error:  impl Ord for Ver requires an impl of Eq for Ver
;; An impl of a protocol needs impls of its supertraits for the same
;; type (types §4.1 rule 1): without one, a function bounded by (Ord t)
;; would call = at t = Ver, which (Ord t) entails (rule 2), and there
;; would be no implementation to run.
(defstruct Ver (major: i64 minor: i64))

(impl Ord Ver
  (< (self o) (< (. self major) (. o major))))

(defun same (a b) :where ((Ord t)) (= a b))

(defun main () -> i64 (if (same (Ver 1 2) (Ver 1 2)) 1 0))
