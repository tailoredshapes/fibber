;; spec:   §6, §7
;; expect: accept
;; result: 1
;; audit:  clean
;; A weak reference is taken on one thread while another thread
;; retains the same shared object. The HAS-WEAK bit is set with an
;; atomic or and the retain reads the flags atomically.
(defstruct B (v: i64))

(defun main () -> i64
  (let ((b (B 1)))
    (plet ((w (weak b))
           (o (some b)))
      (match o ((some x) (. x v)) (nil 0)))))
