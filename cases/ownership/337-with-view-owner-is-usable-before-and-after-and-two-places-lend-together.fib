;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; The owner is read before the lend (the twin of the freeze reject cases) and after it; two different places are lent by one form
;; (the twin of the same-place reject); a window is copied into the other with copy-into!.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 1))) (b (cell (array 4 0))))
    (let ((n (array-len @a)))
      (do (with-view [x (array-window! &a 0 n) y (array-window! &b 0 n)]
            (do (vset! x 1 7) (copy-into! y x)))
          (if (and (= (array-get @b 1) 7) (= (array-get @b 0) 1) (= (array-get @a 1) 7)) 0 1)))))
