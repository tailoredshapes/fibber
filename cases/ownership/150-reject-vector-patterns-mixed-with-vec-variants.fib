;; spec:   syntax §3.6 (types §2.6)
;; expect: reject
;; error:  vector patterns cannot be mixed with patterns of Vec's variants
;; (VecOf ..) is the prelude's representation of a non-empty vector; a
;; matrix that mixed it with lengths could not relate the two.
(defun f (v: (Vec i64)) -> i64
  (match v
    ([] 0)
    ((VecOf n _ _ _) n)))

(defun main () -> i64 (f [1 2]))
