;; spec:   types §6.3 (consume), §6.4; docs/design/in-place-update.md §1 (lever L1)
;; expect: accept
;; result: 14
;; audit:  clean
;; A binding is handed over (not retained) only at its last use. Here `b`,
;; an owned parameter (it is returned on the other path), is consumed by
;; `eat` and read again afterwards through an alias, so the call must retain
;; it: `eat` frees its argument (a closure's parameters are all owned), and a
;; hand-over would leave the alias reading a freed Box and release it twice.
(defstruct Box (n: i64))
;; `scribble` allocates (on the heap: `keep` makes them escape) and frees three Boxes and answers 0: after a premature free
;; it overwrites the freed object (the allocator reuses the last blocks freed), so a read
;; of the stale Box answers something else and the result shows it.
(defun keep (b: Box) -> Box b)
(defun scribble () -> i64
  (let ((j1 (keep (Box 98))) (j2 (keep (Box 99))) (j3 (keep (Box 97))))
    (- (+ (. j1 n) (. j2 n) (. j3 n)) 294)))

(defun test (b: Box eat: (fn (Box) i64) flag: bool) -> Box
  (if flag
      b
      (let ((a b)
            (x (eat b)))
        (Box (+ x (+ (scribble) (. a n)))))))

(defun main () -> i64
  (. (test (Box 7) (fn (b: Box) (. b n)) false) n))
