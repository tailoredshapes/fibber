;; spec:   types §6.3
;; expect: accept
;; result: 32
;; audit:  clean
;; A join inside a loop body, and one fed to a loop variable through `recur`.
(defun fresh (b: (Array i64) n: i64) -> (Array i64)
  (let [r (cell (array n 0))] (do (array-set! &r 0 (array-get b 0)) @r)))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun l1 (b: (Array i64) n: i64) -> i64 (loop [i n acc 0] (if (= i 0) acc (let [v (if (= (mod i 2) 0) b (fresh b 3))] (recur (- i 1) (+ acc (sink v)))))))
(defun l2 (b: (Array i64) n: i64) -> i64 (loop [i n v (fresh b 2)] (if (= i 0) (sink v) (recur (- i 1) (if (= (mod i 2) 0) b (fresh b 3))))))
(defun main () -> i64 (let [a (array 4 3)] (+ (l1 a 4) (l2 a 3))))
