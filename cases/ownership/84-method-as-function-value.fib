;; spec:   §4 (types §6.4, §6.12, §8.4)
;; expect: accept
;; result: 2
;; audit:  clean
;; A protocol method passed as a function value: count at (Vec i64).
;; Through a function value every object parameter and the closure are
;; owned, and a method's implementation used as a value runs its
;; all-owned body, like a named function's (types §8.4, §6.12
;; exception 5). Every count is released exactly once (adversary
;; finding 004, where the plan had no all-owned body for a method).
(defun apply1 (f x) (f x))
(defun main () -> i64 (apply1 count (conj [5] 6)))
