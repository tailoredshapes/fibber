;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   scoped value consumed
;; stage:  2
;; Check V3d, the window is stored in a vector (an owned, storing position): the read of the view cell is not a peek (S1).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (do (with-view [v (array-window! &a 0 2)] (conj [] @v)) 0)))
