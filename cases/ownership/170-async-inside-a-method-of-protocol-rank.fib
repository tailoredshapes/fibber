;; spec:   types §8.8 (compiler.md section 2, names)
;; expect: accept
;; result: 9
;; audit:  clean
;; An async literal inside a method of a protocol whose name has a
;; capital R. The task's resume function calls the body's code by its
;; name, `l.m.Rank.rank.Pt.N`; the compiler's template substituted the
;; result type for every `R` in that call, made it `l.m.i64ank...`,
;; an undefined function, and the module failed to compile (found by
;; `fibc gen`, fibgen seed 22 size 4). The interpreter joins the task
;; for 9.
(defstruct Pt (x: i64))
(defprotocol Rank (rank (self) -> i64))
(impl Rank Pt
  (rank (self) (let ((x (. self x))) (join (async (+ x 1))))))
(defun main () -> i64 (rank (Pt 8)))
