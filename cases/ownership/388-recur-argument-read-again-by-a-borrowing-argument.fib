;; spec:   types §6.3
;; expect: accept
;; result: 9
;; audit:  clean
;; Package BUG-1, a parameter that a join retains is owned (rule 1), so a caller hands it over; the later argument only borrows y: the direct read may still move it.
(defun two (a: (Array i64) b: (Array i64)) -> i64 (+ (array-get a 0) (array-get b 0)))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun t (n: i64) -> i64 (loop [i n x (array 4 1) y (array 4 2)] (if (= i 0) (sink x) (recur (- i 1) y (array 4 (two x y))))))
(defun main () -> i64 (t 3))
