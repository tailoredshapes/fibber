;; spec:   syntax §3.6 (guards may have side effects, in clause order)
;; expect: accept
;; result: 211
;; audit:  clean
;; Guards run in clause order, at most once each, and only when their
;; pattern matched. The first guard writes a cell and fails; the second
;; reads the value the first wrote. 100*2 + (5 + 6) = 211.
(defun main () -> i64
  (let ((tries (cell 0)))
    (let ((r (match [5 6 7]
               ([x & _] :when (do (set! tries (+ @tries 1)) (> x 10)) 1)
               ([x y & _] :when (do (set! tries (+ @tries 1)) (= @tries 2)) (+ x y))
               (_ 0))))
      (+ (* 100 @tries) r))))
