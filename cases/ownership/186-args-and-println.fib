;; spec:   syntax §4.3, §4.5 (M5)
;; expect: accept
;; result: 0
;; audit:  clean
;; (args) is the command line after the program: none under the case
;; harness, so their count is 0 (fibc run FILE -- a b gives 2, which
;; crates/fibc/tests/cli.rs checks); println writes to standard output
;; before the result, which the harness reads from the last line.
(defun main () -> i64
  (do (println "hello from fibber")
      (count (args))))
