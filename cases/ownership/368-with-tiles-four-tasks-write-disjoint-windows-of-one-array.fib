;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Decision 5: four native tasks each get their own window of one array; every element is incremented once, so an overlap would leave a 2.0 and
;; a gap a 0.0. The combinator joins the tasks before the owner is usable again.
(ns main (:use fib.view fib.view.tiles))

(defun main () -> i64
  (let ((a (cell (array 1003 0.0))))
    (do (with-tiles [w a 4]
          (loop ((i 0))
            (when (< i (vlen w)) (do (vset! w i (+ (vget w i) 1.0)) (recur (+ i 1))))))
        (loop ((i 0) (ok true))
          (if (< i 1003)
              (recur (+ i 1) (and ok (= (array-get @a i) 1.0)))
              (if ok 0 1))))))
