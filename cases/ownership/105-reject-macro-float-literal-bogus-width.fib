;; spec:   syntax §1.1, §3.16 (types §1.1)
;; expect: reject
;; error:  a Flt form of width :f16
;; A float literal has the width f32 or f64 (syntax §1.1): 2.5f16 is a
;; read error, and a macro that builds the Form (Flt 2.5 :f16) and
;; splices it into run-time code is refused where its expansion is
;; turned back into a form, as case 93 is for an integer literal out
;; of its width. The Form value itself is data (syntax §3.16); only a
;; form that is compiled must be a valid literal.
(defmacro half () (List [(Sym "fptosi") (Sym "i64") (Flt 2.5 :f16)]))

(defun main () -> i64 (half))
