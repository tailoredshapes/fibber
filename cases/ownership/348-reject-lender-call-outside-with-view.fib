;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   lender call outside with-view: array-window!
;; stage:  2
;; Check V6, a lender called outside with-view would make a window that is a plain value (L3).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (let ((w (array-window! &a 0 2))) 0)))
