;; spec:   syntax §5, §3.20
;; expect: accept
;; result: 1060
;; audit:  clean
;; A program's own :private definitions are visible in its own module
;; (syntax §5). Its public array-push does not clash with the
;; prelude's private one, which is not brought in; and (var
;; fib.prelude/array-push) is the one reference that reaches the
;; prelude's (§3.20), a direct call to it.
(defstruct Point :private (x: i64 y: i64))

(defun norm1 :private (p: Point) -> i64 (+ (. p x) (. p y)))

(def origin :private (Point 0 0))

(defun array-push (a: i64 b: i64) -> i64 (* 10 (+ a b)))

(defun main () -> i64
  (let ((grown ((var fib.prelude/array-push) (array 3 1) 5)))
    (+ (+ (array-push (norm1 (Point 40 60)) (norm1 origin))
          (array-get grown 3))
       (+ (* 10 (array-len grown)) 15))))
