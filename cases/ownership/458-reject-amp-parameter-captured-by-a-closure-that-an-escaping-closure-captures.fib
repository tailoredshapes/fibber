;; spec:   spec/types.md §6.5 (d), captures by closures (decided by the owner, 2026-10-24), the first `&` rule (case 18)
;; expect: reject
;; error:  & parameter captured by escaping closure: v
;; The `&` parameter `v` is captured by `push`, which is only called, but `push` is captured by the literal that `make-pusher`
;; returns: that literal escapes, so `push` escapes with it (captures are transitive) and its capture of `v` is refused, as in case
;; 18. Taken for a stack closure, `push` would write through a private cell that the write-back has freed.
(defun make-pusher (&v)
  (let ((push (fn (x) (append &v x))))
    (fn (x) (push x))))

(defun main () -> i64
  (let ((v (cell [])))
    (let ((p (make-pusher &v)))
      (p 1)
      (count @v))))
