;; spec:   spec/types.md §6.3 (Cell peeks, P2)
;; expect: accept
;; result: 10
;; audit:  clean
;; `keep` returns its parameter, so its parameter is owned and the argument `@c` is consumed: a position that is not a borrowed one
;; is never a peek. The result of `keep` is the array with a count of its own and the cell still holds it. As a peek the callee
;; would hand the cell's only count on and release it with the result: a double free (the audit fails, or the later read of `@c`
;; sees another array).
(defun keep (a: (Array i64)) -> (Array i64) a)

(defun main () -> i64
  (let [c (cell (array 4 5))]
    (+ (array-get (keep @c) 1) (array-get @c 2))))
