;; spec:   syntax §4.3; stdlib design 7 (L18)
;; expect: trap
;; trap:   str-find: from 2 splits a character
;; `from` must lie between characters, as the ends of `str-slice` must:
;; byte 2 of "aé" (a, then C3 A9) is the continuation byte of é, so a
;; search that starts there has no meaning and traps, in both tools,
;; with the offset in the message. Byte 1 and byte 3 are boundaries and
;; do not trap (the first two calls are made and answered before the
;; third traps, so the trap cannot be a refusal of every `from`).
(defun offset (r: (Option i64)) -> i64
  (match r ((some n) n) (nil -1)))

(defun main () -> i64
  (+ (offset (str-find "aé" "é" 1))
     (+ (offset (str-find "aé" "" 3))
        (offset (str-find "aé" "é" (+ 1 (str-len "a")))))))
