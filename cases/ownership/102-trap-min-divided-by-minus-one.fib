;; spec:   types §2.11, §2.12 (method.md rule 3)
;; expect: trap
;; trap:   integer overflow in / at i64
;; The minimum of i64 divided by -1 is 2^63, which does not fit i64:
;; Rust's semantics trap (types §2.12), where LLVM's sdiv would be
;; undefined behaviour. The divisor is computed, so no constant folding
;; can see it.
(defun minus-one (v) (- (count v) 4))

(defun main () -> i64
  (quot -9223372036854775808 (minus-one [1 2 3])))
