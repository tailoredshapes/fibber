;; spec:   syntax §3.3; stdlib §7 L8
;; expect: accept
;; result: 3
;; audit:  clean
;; This was a reject case, `a let pattern must be irrefutable`: [a b] matches only
;; vectors of length two. A vector pattern in a binding position now takes a prefix
;; (it is [a b & _]) and a vector that is too short traps, so the let binds.
(defun main () -> i64
  (let (([a b] [1 2])) (+ a b)))
