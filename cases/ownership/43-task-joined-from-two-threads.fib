;; spec:   §7, §8
;; expect: accept
;; result: 10
;; audit:  clean
;; One task, joined from two threads. The task is resumed by whichever
;; joiner claims it; the other waits for its completion and reads the
;; same result.
(defun main () -> i64
  (let ((t (async (do (await (yield)) 5))))
    (plet ((a (join t))
           (b (join t)))
      (+ a b))))
