;; spec:   types §2.15, §3.6, §5.1 (ownership.md §7)
;; expect: reject
;; error:  cell cannot be shared between threads: type argument a of hide, field n of Counter has type (Cell i64)
;; A generic function that hides its argument behind (dyn Show :send)
;; gets the bound (Send a) in its scheme (types §2.15), so the Send
;; check is not lost behind the type variable: calling it with a value
;; that reaches a cell is refused at the call, whose instantiation
;; brings the bound back.
(defstruct Counter (n: (Cell i64)))

(impl Show Counter (show (self) "counter"))

(defun hide (x) (dyn Show :send x))

(defun main () -> i64
  (let ((d (hide (Counter (cell 0))))
        (t (spawn (fn () (str-len (show d))))))
    (join t)))
