;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   a is lent to r and cannot be used here
;; stage:  2
;; Check V4, a writable lend of a place while a read lend of it is live (a write while a reader exists).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view-ro [r (array-window &a 0 4)]
      (with-view [w (array-window! &a 4 8)] (do (vset! w 0 1) 0)))))
