;; spec:   types §8.8 (syntax §3.12)
;; expect: accept
;; result: 24
;; audit:  clean
;; One shared task awaited by two other tasks and then joined by main.
;; Each awaiter registers in the shared task's waiter list (types §8.8:
;; a list, never a single slot) and is woken at its completion; main
;; joins the awaiters, then reads the shared result itself. Every
;; count on the shared task is released: two registrations, the
;; awaiters' captures, main's binding.
(defun main () -> i64
  (let ((shared (async (do (await (yield)) 7)))
        (a (async (+ 1 (await shared))))
        (b (async (+ 2 (await shared)))))
    (+ (join a) (+ (join b) (join shared)))))
