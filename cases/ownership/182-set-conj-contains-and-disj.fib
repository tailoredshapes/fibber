;; spec:   types §2.13 (syntax §4.5)
;; expect: accept
;; result: 1029
;; audit:  clean
;; A Set over a Map: conj of new and of repeated elements, contains?,
;; disj, count, for-each summing the elements, with str elements too.
(defun main () -> i64
  (let ((s (conj (conj (conj (conj (set-empty) 3) 4) 3) 5))
        (t (disj s 4))
        (names (conj (conj (set-empty) "a") "b"))
        (total (cell 0)))
    (do (for-each s (fn (x) (set! total (+ @total x))))
        (+ (count s)
           (+ (if (set-contains? s 4) 10 0)
              (+ (if (set-contains? t 4) 100 0)
                 (+ (count t)
                    (+ (if (set-contains? names "b") 1000 0)
                       (+ (count names)
                          @total)))))))))
