;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   & argument must be a cell variable
;; stage:  2
;; A read-only window has no write: vset! wants a writable window, so the type checker refuses it.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 3))))
    (with-view-ro [r (array-window &a 0 4)] (do (vset! r 0 1) 0))))
