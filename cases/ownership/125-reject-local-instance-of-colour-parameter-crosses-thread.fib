;; spec:   types §1.3, §5.1, §5.3 (ownership.md §7)
;; expect: reject
;; error:  cell cannot be shared between threads: closure capture h, field f of Handler, closure capture c has type (Cell i64)
;; The Handler is built over a closure that captures a cell, so its
;; colour argument is local (types §1.3), and Send of the Handler, which
;; follows its colour argument (§5.1), is false. The spawned closure
;; captures it, and the witness follows the path from the capture
;; through the field to the cell (§5.3).
(defstruct (Handler k :colour) (f: (fn k (i64) i64)))

(defun main () -> i64
  (let ((c (cell 1))
        (h (Handler (fn (x) (+ x @c)))))
    (join (spawn (fn () ((. h f) 1))))))
