;; spec:   types §6.3
;; expect: accept
;; result: 6
;; audit:  clean
;; Package BUG-1, a parameter that a join retains is owned (rule 1), so a caller hands it over; `(recur y (pick2 x y))` read y first for the slot and then handed the same count to pick2: a double free.
;; Killed by: a recur argument that moves a variable another argument consumes later (the audit: a double free).
(defun pick2 (a: (Array i64) b: (Array i64)) -> (Array i64) (if (= (array-len b) 0) a b))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun t (n: i64) -> i64 (loop [i n x (array 4 1) y (array 4 2)] (if (= i 0) (sink x) (recur (- i 1) y (pick2 x y)))))
(defun main () -> i64 (t 3))
