;; spec:   syntax §4.4 (Declining, Hygiene)
;; expect: accept
;; result: 0
;; audit:  clean
;; A head written fib.prelude/NAME is the prelude's macro NAME in every module: the module
;; defines its own when, cond and list (each of another arity, so a call that the macro
;; answered would be an error here), and the qualified calls still expand: when to a
;; one-armed if, cond to its clauses, list to the Cons chain. The bare names are the module's
;; own functions. The result is 0 when each is as it should be. (`and` and `or` are core forms
;; since stdlib §7 L20: a module cannot define them, and there is no macro to qualify.)
;; (R14, stdlib §6.3: the owner's rule of 2026-10-01.)
(defun when (c: bool) -> i64 (if c 1 2))
(defun cond (a: i64) -> i64 (+ a 30))
(defun list (a: i64) -> i64 (+ a 40))

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun head (l: (List i64)) -> i64
  (match l ((Cons h _) h) (_ -1)))

(defun main () -> i64
  (let ((x (cell 0)))
    (do (fib.prelude/when true (set! x 5))
        (+ (+ (ck (= @x 5) 1) (ck (= (when true) 1) 2))
           (+ (ck (= (fib.prelude/cond false 1 :else 2) 2) 4)
              (+ (ck (= (cond 1) 31) 8)
                 (+ (ck (= (head (fib.prelude/list 9 8)) 9) 16)
                    (ck (= (list 1) 41) 32))))))))
