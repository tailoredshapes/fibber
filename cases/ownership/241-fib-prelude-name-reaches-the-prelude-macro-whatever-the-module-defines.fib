;; spec:   syntax §4.4 (Declining, Hygiene)
;; expect: accept
;; result: 0
;; audit:  clean
;; A head written fib.prelude/NAME is the prelude's macro NAME in every module: the module
;; defines its own when, and, or, cond and list (each of another arity, so a call that the
;; macro answered would be an error here), and the qualified calls still expand: when to an
;; if with a unit else, and and or to ifs, cond to its clauses, list to the Cons chain.
;; The bare names are the module's own functions. The result is 0 when each is as it should be.
;; (R14, stdlib §6.3: the owner's rule of 2026-10-01.)
(defun when (c: bool) -> i64 (if c 1 2))
(defun and (a: i64) -> i64 (+ a 10))
(defun or (a: i64) -> i64 (+ a 20))
(defun cond (a: i64) -> i64 (+ a 30))
(defun list (a: i64) -> i64 (+ a 40))

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun head (l: (List i64)) -> i64
  (match l ((Cons h _) h) (_ -1)))

(defun main () -> i64
  (let ((x (cell 0)))
    (do (fib.prelude/when true (set! x 5))
        (+ (+ (ck (= @x 5) 1) (ck (= (when true) 1) 2))
           (+ (+ (ck (not (fib.prelude/and true false true)) 4) (ck (= (and 1) 11) 8))
              (+ (+ (ck (fib.prelude/or false false true) 16) (ck (= (or 1) 21) 32))
                 (+ (ck (= (fib.prelude/cond false 1 :else 2) 2) 64)
                    (+ (ck (= (cond 1) 31) 128)
                       (+ (ck (= (head (fib.prelude/list 9 8)) 9) 256)
                          (ck (= (list 1) 41) 512))))))))))
