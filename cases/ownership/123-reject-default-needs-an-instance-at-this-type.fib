;; spec:   types §4.1, §2.7
;; expect: reject
;; error:  no implementation of Show for Opaque
;; A default is specialised per instance (types §4.1): describe's
;; default calls show on self, which is well typed for Loud, whose type
;; has Show, and not for Opaque, whose type has none. The error names
;; the missing instance at the impl that took the default, not at the
;; protocol.
(defprotocol Describe (describe (self) -> str (show self)))

(defstruct Loud (s: str))
(impl Show Loud (show (self) (. self s)))
(impl Describe Loud)

(defstruct Opaque (n: i64))
(impl Describe Opaque)

(defun main () -> i64 (+ (str-len (describe (Loud "a"))) (str-len (describe (Opaque 1)))))
