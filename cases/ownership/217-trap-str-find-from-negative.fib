;; spec:   syntax §4.3; stdlib design 7 (L18)
;; expect: trap
;; trap:   str-find: from -1 out of range 0..3
;; A negative `from` is out of range. The interpreter and the compiled
;; check say the same words; `from` is computed, so no constant folding
;; can see it.
(defun offset (r: (Option i64)) -> i64
  (match r ((some n) n) (nil -1)))

(defun main () -> i64
  (let ((s "aé"))
    (offset (str-find s "a" (- (str-len s) 4)))))
