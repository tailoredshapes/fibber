;; spec:   types §2.13, §2.12
;; expect: accept
;; result: 479
;; audit:  clean
;; Keys whose hashes are equal: a Hash instance that returns the same
;; value for every key, so every entry of the map lands in one bucket
;; (MColl) and is told apart by Eq; assoc replaces in the bucket,
;; dissoc shrinks it back to a leaf, and str keys hash for real.
(defstruct K (n: i64))
(impl Eq K (= (self o) (= (. self n) (. o n))))
(impl Hash K (hash (self) 7))

(defun main () -> i64
  (let ((m (assoc (assoc (assoc (map-empty) (K 1) 10) (K 2) 20) (K 3) 30))
        (m2 (assoc m (K 2) 25))
        (m3 (dissoc (dissoc m2 (K 1)) (K 3)))
        (s (assoc (assoc (map-empty) "one" 1) "two" 2)))
    (+ (count m)
       (+ (unwrap-or (get m (K 2)) -1000)
          (+ (unwrap-or (get m2 (K 2)) -1000)
             (+ (count m2)
                (+ (count m3)
                   (+ (unwrap-or (get m3 (K 2)) -1000)
                      (+ (unwrap-or (get m3 (K 1)) 100)
                         (+ (unwrap-or (get s "two") -1000)
                            (unwrap-or (get s "three") 300)))))))))))
