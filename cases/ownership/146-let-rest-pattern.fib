;; spec:   syntax §3.3, §3.6
;; expect: accept
;; result: 33
;; audit:  clean
;; [& r] is the one irrefutable vector pattern: in a let, r owns a
;; fresh copy, released at the let's exit or moved out as its value;
;; [& _] builds nothing. 3 + 10*3 = 33.
(defun copy-of (v: (Vec i64)) -> (Vec i64)
  (let (([& all] v)) all))

(defun main () -> i64
  (let ((v [1 2 3])
        ([& w] v)
        ([& _] w))
    (+ (count (copy-of v)) (* 10 (count w)))))
