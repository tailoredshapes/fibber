;; spec:   types §6.3 (consume), §6.10; docs/design/in-place-update.md §1 (lever L1)
;; expect: accept
;; result: 8
;; audit:  clean
;; The loop variable `v` is handed to `id` at its last use and the result
;; is the next value: no retain before the call and no release of the old
;; value at the jump (the call took it). Run five times, then read: the
;; vector must be alive once and freed once (audit).
(defun id (v: (Vec i64)) -> (Vec i64) v)

(defun main () -> i64
  (let ((v (loop ((i 0) (v (vec (range 8))))
             (if (>= i 5) v (recur (+ i 1) (id v))))))
    (count v)))
