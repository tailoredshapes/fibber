;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   view cell v is passed in-out and used again in the same call
;; stage:  2
;; Check V7, one view as both the written and the read operand of one call (VC4): the callee's two parameters would alias.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (with-view [v (array-window! &a 0 4)] (do (copy-into! v v) 0))))
