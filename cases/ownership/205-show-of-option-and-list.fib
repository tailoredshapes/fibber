;; spec:   syntax §4.5 (the prelude); stdlib design 2.7 (Show of an Option and of a List); plan tranche 1 C-14
;; expect: accept
;; result: 127
;; audit:  clean
;; A present Option is printed as its payload, as Clojure has no wrapper
;; (a derived Show said `(some 3)`), nil is `nil`, and a List is its
;; elements in parentheses, a space apart: `(1 2)`, `()`. The texts are
;; compared with `=` and the result is a bit per check, so a wrong text is
;; a number, not a line of output nobody reads:
;;   1  (show (some 3))                    is "3"
;;   2  (show (some "a"))                  is "a"
;;   4  (show nil) of an (Option i64)      is "nil"
;;   8  (show (list 1 2))                  is "(1 2)"
;;   16 (show (list)) of a (List i64)      is "()"
;;   32 (show (list "a" "b" "c"))          is "(a b c)"
;;   64 (show (list (some 1) nil))         is "(1 nil)": the two instances compose
(defun check (ok: bool bit: i64) -> i64 (if ok bit 0))

(defun main () -> i64
  (let ((none: (Option i64) nil)
        (empty-list: (List i64) (list)))
    (+ (check (= (show (some 3)) "3") 1)
       (+ (check (= (show (some "a")) "a") 2)
          (+ (check (= (show none) "nil") 4)
             (+ (check (= (show (list 1 2)) "(1 2)") 8)
                (+ (check (= (show empty-list) "()") 16)
                   (+ (check (= (show (list "a" "b" "c")) "(a b c)") 32)
                      (check (= (show (list (some 1) nil)) "(1 nil)") 64)))))))))
