;; spec:   spec/types.md §6.3 (Cell peeks, P3)
;; expect: accept
;; result: 1
;; audit:  clean
;; The index of the read passes `&a` to a function that writes element 0. `@a` is not a peek, so the array has two holders when
;; `bump` writes and the write copies: the read still sees element 0 = 1. A peek would leave the array unique, `bump` would move it
;; in and write it in place, and the read would see 99.
(defun bump (&a: (Array i64)) -> i64 (do (array-set! &a 0 99) 1))

(defun main () -> i64
  (let [a (cell (array 4 1))]
    (+ 0 (array-get @a (- (bump &a) 1)))))
