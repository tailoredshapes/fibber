;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   scoped type Win can only be constructed inside unsafe
;; stage:  2
;; Check L6, a window cannot be forged from another window's fields in safe code, which would be a window that is a plain value.
(ns main (:use fib.view))

(defun forge (w: (Win i64)) -> (Win i64) (Win (. w base) 1 0))
(defun main () -> i64 0)
