;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   lent place must be a private cell: a is captured by a closure
;; stage:  2
;; Check V5b, a closure that captures the lent place could write it during the extent (L1).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (let ((g (fn () (array-get @a 0))))
      (with-view [v (array-window! &a 0 2)] (do (vset! v 0 1) 0)))))
