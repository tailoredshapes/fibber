;; spec:   types §2.9, §2.11
;; expect: trap
;; trap:   boom
;; A task that traps does not hand @ a value: the trap aborts the whole program on whichever thread it
;; happens, as it does for `join`, and nothing after the read runs (the 1000 below would be a result).
;; The objects live at the abort are not leaks; the audit still checks that none was freed twice.
(defun main () -> i64
  (let ((t (spawn (fn () (+ 1 (trap "boom"))))))
    (+ 1000 @t)))
