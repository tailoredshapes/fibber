;; spec:   §2 (types §6.3, §8.3; syntax §3.6)
;; expect: accept
;; result: 3900
;; audit:  clean
;; A rest used only inside its clause is released at the clause's
;; exit, a hundred times over. The vector has 40 elements, so the first
;; two are read from the trie and the last eight from the tail, and the
;; rest of 38 elements needs a trie of its own. A rest that leaked, or
;; an element read that took a count, fails the audit.
;; 100 * (0 + 1 + 38) = 3900.
(defun tail-sum (v: (Vec i64)) -> i64
  (match v
    ([a b & r] (+ a (+ b (count r))))
    (_ 0)))

(defun main () -> i64
  (let ((v (vec (range 40))))
    (loop ((i 0) (acc 0))
      (if (< i 100) (recur (+ i 1) (+ acc (tail-sum v))) acc))))
