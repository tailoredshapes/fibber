;; spec:   syntax §3.9a (a constructor as a value), types §2.2 (generics)
;; expect: accept
;; result: 21
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; The parameter of the function a constructor becomes has the type the use gives it: in a generic function `(mapv some xs)` is `(Vec (Option a))` for
;; whatever `a` is, the objects of a heap element are moved into the options and counted once, and a constructor with two fields (`Pair`) is called in a `reduce`
;; step, where it is named in call position and stays the constructor.
(ns main (:use fib.core))
(defun lift (xs: (Vec a)) -> (Vec (Option a)) (mapv some xs))
(defun count-some (xs: (Vec (Option a))) -> i64 (count (filter some? xs)))
(defun main () -> i64
  (let ((strs (lift ["a" "bb" "ccc"]))
        (vecs (lift [[1 2] [3]]))
        (pairs (reduce (fn (acc: (Vec (Pair i64 str)) x: i64) (conj acc (Pair x "k"))) [] [1 2 3])))
    (+ (count-some strs) (count-some vecs) (count pairs)
       (reduce + 0 (mapv (fn (o: (Option (Vec i64))) (match o ((some v) (count v)) (nil 0))) vecs))
       10)))
