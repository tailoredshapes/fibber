;; spec:   §5 (types §6.10 rule (b))
;; expect: accept
;; result: 2
;; audit:  clean
;; A call in tail position passes the function's own & parameter to
;; another function. Since the owner relaxed types §6.10 rule (b), that
;; forwards the private cell: no copy-in, no write-back, and the call is
;; a tail call. (The case name predates the relaxation; the verdict is
;; the same either way.)
(defun add1 (&v) (push! &v 1))
(defun twice (&v) (do (push! &v 0) (add1 &v)))

(defun main () -> i64
  (let ((x (cell [])))
    (twice &x)
    (count @x)))
