;; spec:   syntax §4.2, §4.4; stdlib §7 L20
;; expect: reject
;; error:  defmacro cannot redefine core form and
;; `and` and `or` are core forms the checker elaborates (stdlib §7 L20, §8.2.1 item 11), so a
;; module cannot define a macro of that name; this was the capture R14 guarded against (the
;; prelude's own expansions named a bare and), which the core form makes impossible.
(defmacro and (a b) `(+ ~a ~b))

(defun main () -> i64
  (and 100 200))
