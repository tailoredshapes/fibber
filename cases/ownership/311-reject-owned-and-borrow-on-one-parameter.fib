;; spec:   types §6.4 (Declared owned); syntax §3.1
;; expect: reject
;; error:  more than one of :borrow and :owned
;; The two count and escape promises contradict each other: a `:borrow` parameter is never released by the callee, an `:owned` one
;; always is or is handed on.
(defun f (a: (Array i64) :borrow :owned) -> i64 (array-get a 0))

(defun main () -> i64 (f (array 4 1)))
