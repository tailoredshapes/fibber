;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Check R5, array-split! returns the two halves [0, k) and [k, n) of one lend: filling the halves with different values leaves no gap and no
;; overlap, for an odd cut, a cut at the ends and a cut of one.
(ns main (:use fib.view))

(defun check (n: i64 k: i64) -> bool
  (let ((a (cell (array n 0))))
    (do (with-view [(lo hi) (array-split! &a k)]
          (do (fill! lo 1) (fill! hi 2)))
        (loop ((i 0) (ok true))
          (if (< i n)
              (recur (+ i 1) (and ok (= (array-get @a i) (if (< i k) 1 2))))
              ok)))))
(defun main () -> i64 (if (and (check 7 3) (check 7 1) (check 7 6) (check 5 5) (check 5 0) (check 1 0)) 0 1))
