;; spec:   spec/types.md §6.3 (Element reads, the element cannot outlive the array)
;; expect: accept
;; result: 4
;; audit:  clean
;; `e` is a part of the array parameter `a`, which `make` does not keep; the closure it returns captures `e`. The capture of an
;; escaping closure is a store (E3) and retains the box, so the box outlives the array, which the caller of `make` releases
;; before it calls `f`. A capture without that count leaves the box freed with the array.
(defstruct Box (n: i64))

(defun make (a: (Array Box)) -> (fn () i64)
  (let ((e (array-get a 0)))
    (fn () (. e n))))

(defun main () -> i64
  (let ((f (make (array 2 (Box 4)))))
    (f)))
