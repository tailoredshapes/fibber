;; spec:   syntax §3.6 (types §2.6: vector patterns in the matrix)
;; expect: reject
;; error:  non-exhaustive match: missing [_ _ & _]
;; Lengths 0 and 1 are covered; every length from 2 up is not.
(defun f (v: (Vec i64)) -> i64
  (match v
    ([] 0)
    ([x] x)))

(defun main () -> i64 (f [1 2]))
