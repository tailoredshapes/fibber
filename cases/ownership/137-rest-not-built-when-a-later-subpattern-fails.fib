;; spec:   syntax §3.6 (a clause's rests are built only once its whole pattern matched)
;; expect: accept
;; result: 4720
;; audit:  clean
;; In (Tagged [_ & r] 1) the vector matches before the tag fails. A
;; rest built as soon as its vector matched would be abandoned when the
;; tag failed and leak. Also a string literal element and a vector
;; pattern inside (some ..), exhaustive by nil, (some []) and
;; (some [x & _]). 20 + 100*7 + 1000*4 = 4720.
(defstruct Tagged (items: (Vec str) tag: i64))

(defun f (t: Tagged) -> i64
  (match t
    ((Tagged [_ & r] 1) (count r))
    ((Tagged ["a" & r] 2) (* 10 (count r)))
    ((Tagged _ _) 7)))

(defun g (o: (Option (Vec i64))) -> i64
  (match o
    (nil 0)
    ((some []) 1)
    ((some [x & _]) x)))

(defun main () -> i64
  (+ (f (Tagged ["a" "b" "c"] 2))
     (+ (* 100 (f (Tagged ["z"] 3)))
        (* 1000 (g (some [4 5]))))))
