;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; A window element updated from its own value: `vset!` evaluates its index and value before the call that takes `&v`, so the read of `v`
;; in the value is not a sibling operand of the write (the twin of the reject for `copy-into!` of a view into itself).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 10 1))))
    (do (with-view [v (array-window! &a 2 8)]
          (loop ((i 0))
            (when (< i 6) (do (vset! v i (+ (vget v i) i)) (recur (+ i 1))))))
        (if (and (= (array-get @a 2) 1) (= (array-get @a 7) 6) (= (array-get @a 0) 1) (= (array-get @a 9) 1)) 0 1))))
