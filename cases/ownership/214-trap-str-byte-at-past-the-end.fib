;; spec:   syntax §4.3; stdlib design 7 (L18)
;; expect: trap
;; trap:   str-byte-at: index 3 out of range 0..3
;; The valid indexes are 0 to length - 1, in bytes: "aé" is three bytes,
;; so index 2 reads the last one and index 3, the length itself, traps.
;; The message names the index and the length. The index is computed from
;; the length, so no constant folding can see it.
(defun main () -> i64
  (let ((s "aé"))
    (+ (zext i64 (str-byte-at s (- (str-len s) 1)))
       (zext i64 (str-byte-at s (str-len s))))))
