;; spec:   §2 (types §6.3, §6.11; syntax §3.6)
;; expect: accept
;; result: 22
;; audit:  clean
;; A vector pattern inside a struct pattern, on a struct that is a
;; scope-local temporary of the match. The first clause's vector
;; matches but its tag does not, so no rest is built; the second
;; clause's guard is true and its rest leaves the match, the let and
;; the struct's stack scope, holding counts of its own on 2 and 3.
;; 2 + 10*2 = 22.
(defstruct Pair (a: (Vec i64) b: i64))

(defun main () -> i64
  (let ((rest (match (Pair [1 2 3] 4)
                ((Pair [x & r] 5) (conj r 100))
                ((Pair [x & r] b) :when (> b x) r)
                ((Pair _ _) [0]))))
    (+ (count rest) (* 10 (nth rest 0)))))
