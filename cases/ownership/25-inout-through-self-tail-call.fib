;; spec:   §5
;; expect: accept
;; result: 3
;; audit:  clean
;; An & accumulator threaded through a self tail call. The tail call
;; forwards the private cell; the single write-back happens when the
;; loop returns to main.
(defun fill (&v n)
  (if (= n 0) () (do (append &v n) (fill &v (- n 1)))))

(defun main () -> i64
  (let ((x (cell [])))
    (fill &x 3)
    (count @x)))
