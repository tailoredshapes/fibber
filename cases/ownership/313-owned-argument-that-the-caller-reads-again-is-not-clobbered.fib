;; spec:   types §6.4 (Declared owned: the caller that is not at its last use retains), §2.13.2
;; expect: accept
;; result: 10
;; audit:  clean
;; `a` is passed to an `:owned` parameter and read again afterwards, so the call is not its last use: the caller retains, the callee's
;; count is two, `array-with` copies, and `a` still has 1 in slot 0. Handed over as if it were the last use, the callee would write 9
;; into the array the caller reads and the result would be 18.
(defun put (a: (Array i64) :owned) -> (Array i64) (array-with a 0 9))

(defun main () -> i64
  (let ((a (array 4 1)))
    (let ((b (put a)))
      (+ (array-get b 0) (array-get a 0)))))
