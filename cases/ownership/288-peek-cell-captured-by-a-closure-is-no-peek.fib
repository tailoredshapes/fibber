;; spec:   spec/types.md §6.3 (Cell peeks, P1)
;; expect: accept
;; result: 1
;; audit:  clean
;; The cell is captured by a closure that the index calls: the closure replaces the cell's array and allocates a heap array of the
;; same size (`nine`). A cell that a literal captures is never a peek, so the read holds the old array (value 1). As a peek the old
;; array would be freed under the read and the read would see 9.
(defun nine () -> (Array i64) (array 4 9))

(defun main () -> i64
  (let [a (cell (array 4 1))
        f (fn () -> i64 (do (set! a (array 4 7)) (let [z (nine)] (- (array-get z 0) 8))))]
    (+ 0 (array-get @a (f)))))
