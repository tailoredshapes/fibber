;; spec:   syntax §4.3, §4.5 (types §8.3)
;; expect: accept
;; result: 129495
;; audit:  clean
;; Building strings and taking them apart (M5): str-join concatenates
;; a vector of strings; str-chars decodes UTF-8 into chars (one, two,
;; three and four bytes each); char->str encodes one char; and
;; str-from-bytes is the inverse of str-bytes. Every text is checked
;; against the expected one and its length or count added.
(defun chk (s: str e: str) -> i64 (if (str-eq s e) (str-len s) -1000))

(defun main () -> i64
  (let ((joined (str-join ["ab" "" "cde"]))
        (chars (str-chars "aλ€😀"))
        (back (str-join (map char->str (str-chars "héllo wörld"))))
        (round (str-from-bytes (str-bytes "xyz"))))
    (+ (chk joined "abcde")
       (+ (count chars)
          (+ (sext i64 (char->i32 (nth chars 1)))
             (+ (sext i64 (char->i32 (nth chars 3)))
                (+ (chk back "héllo wörld")
                   (+ (chk round "xyz")
                      (+ (chk (char->str (nth chars 2)) "€")
                         (str-len (str-join (vec-empty))))))))))))
