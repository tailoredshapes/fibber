;; spec:   §7, §8
;; expect: accept
;; result: 10
;; audit:  clean
;; One task awaited by two tasks. Each registration goes into the
;; awaited task's waiter list; completion wakes both.
(defun main () -> i64
  (let ((t (async (do (await (yield)) 5))))
    (let ((u (async (await t)))
          (w (async (await t))))
      (+ (block-on u) (block-on w)))))
