;; spec:   §5 (syntax §2, §3.13; types §6.6)
;; expect: accept
;; result: 2
;; audit:  clean
;; Case 150's call on a let cell: push! copies in, since c is no &
;; parameter. Its second argument pushes 4 onto c through io15 before
;; the call is entered. The copy-in happens at call entry (owner,
;; 2026-09-28), so it sees [4], and the write-back stores [4 0]. Had it
;; copied in at the argument's position, it would have held [], and the
;; write-back would have lost the 4 (result 1).
(defun io15 (&v0: (Vec i64) n: i64) -> unit (push! &v0 n))
(defun main () -> i64
  (let ((c (cell [])))
    (do (push! &c (do (io15 &c 4) 0))
        (count @c))))
