;; spec:   types §6.3 (consume), §6.10; docs/design/in-place-update.md §1 (lever L1)
;; expect: accept
;; result: 9
;; audit:  clean
;; `b` is bound outside the loop and consumed only on the path that leaves
;; the loop: that path never reads it again, so the count is handed over
;; there (and released nowhere else), while the `recur` path keeps it for
;; the next iteration. A leak or a double free here fails the audit.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((eat (fn (b: Box) (. b n)))
        (b (Box 9)))
    (loop ((i 0))
      (if (< i 3) (recur (+ i 1)) (let ((x (eat b))) x)))))
