;; spec:   syntax §4.3
;; expect: trap
;; trap:   str-from-bytes: invalid UTF-8
;; str-from-bytes takes only UTF-8: two bytes 0xFF are no encoding of
;; anything, so it traps with this message, on both sides, with the
;; array live at the abort.
(defun main () -> i64
  (let ((bad (array 2 -1i8)))
    (str-len (str-from-bytes bad))))
