;; spec:   §3 (types §6.3: the scope-exit rule for Derived)
;; expect: accept
;; result: 6
;; audit:  clean
;; An element bound by a vector pattern is a part of the scrutinee, a
;; temporary of the match. Returned, it is retained before the
;; temporary is released, so it outlives the vector that held it.
(defun main () -> i64
  (let ((s (match [(box 5) (box 6)]
             ([a & _] :when (> (unbox a) 9) a)
             ([_ b] b)
             (_ (box 0)))))
    (unbox s)))
