;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    window index 4 out of range for a window of 4
;; stage:  2
;; Check R4, the window [4, 8) of an array of 8 has length 4; its index 4 is inside the buffer and outside the window, and traps.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [v (array-window! &a 4 8)] (do (vset! v 4 1) 0))))
