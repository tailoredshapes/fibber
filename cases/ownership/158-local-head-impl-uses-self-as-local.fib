;; spec:   types §1.3, §4.1 (syntax §3.10)
;; expect: accept
;; result: 13
;; audit:  clean
;; An impl head may give a colour (owner, 2026-09-28): under (Hook
;; :local) the body sees self as a (Hook :local) and may pass it to usel.
;; The instance covers local hooks: h, over a cell, is one; the second
;; Hook's closure captures nothing, and its colour variable is made
;; :local by resolving score against the instance's head.
;; usel h = 2 + 5 = 7; the second is 2 * 3 = 6.
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defun usel (h: (Hook :local)) -> i64 ((. h f) (. h tag)))
(defprotocol Score (score (self) -> i64))
(impl Score (Hook :local) (score (self) (usel self)))
(defun main () -> i64
  (let ((c (cell 5))
        (h (Hook (fn (x) (+ x @c)) 2)))
    (+ (score h) (score (Hook (fn (x) (* x 3)) 2)))))
