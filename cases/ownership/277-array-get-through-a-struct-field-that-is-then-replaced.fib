;; spec:   spec/types.md §6.3 (Element reads, the element cannot be overwritten under the borrow)
;; expect: accept
;; result: 11
;; audit:  clean
;; `e` is a part of the array in a field of `h`, which owns a count of the holder that the cell `c` also holds. `set-field!` replaces
;; the field of the cell's holder: the holder is shared (count 2), so it is copied and `h` keeps the old array and `e` the old box.
(defstruct Box (n: i64))
(defstruct Holder (arr: (Array Box)))

(defun main () -> i64
  (let ((c (cell (Holder (array 2 (Box 3))))))
    (let ((h @c))
      (let ((e (array-get (. h arr) 0)))
        (do (set-field! &c arr (array 2 (Box 8)))
            (+ (. e n) (. (array-get (. @c arr) 0) n)))))))
