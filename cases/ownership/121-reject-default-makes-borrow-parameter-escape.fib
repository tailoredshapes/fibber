;; spec:   types §4.1, §6.4 (syntax §3.10)
;; expect: reject
;; error:  implementation of Keeper/keep for Jar makes parameter x escape; the protocol declares it :borrow
;; A default body is checked as the body of every impl that takes it
;; (types §4.1, §6.4): here it returns x, which the signature declares
;; :borrow. Callers rely on the declaration and pass x without a count;
;; accepted, the result would be a second owner of a borrowed object.
;; The error names the impl that took the default.
(defprotocol Keeper (keep (self x: (Box i64) :borrow) -> (Box i64) x))

(defstruct Jar (n: i64))
(impl Keeper Jar)

(defun main () -> i64 (unbox (keep (Jar 0) (Box 7))))
