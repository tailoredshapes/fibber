;; spec:   syntax §3.15
;; expect: trap
;; trap:   out of memory
;; (alloc n) of a block no system can give (10^15 bytes is more than the
;; address space) is the trap `out of memory` on both sides. The
;; interpreter used to abort in `vec![0; n]` ("memory allocation of N
;; bytes failed", not a trap), and the compiled `calloc` answered null,
;; which the program went on to use.
(defun main () -> i64
  (unsafe
    (let ((p (alloc 1000000000000000)))
      (do (free p) 7))))
