;; spec:   types §2.12
;; expect: accept
;; result: 12
;; audit:  clean
;; The digits of show on a float are the shortest that read back at the
;; value's width, and among those of that length the nearest to the
;; value, an exact tie going up (types §2.12). The first rounding that
;; reads back is not always that text, and printf rounds a tie to even.
;; The layout is Clojure's (types §2.12, Decided, owner, 2026-10-01: the
;; text of Java's Double.toString), which is why the expected texts
;; changed and the verdict did not: a value outside 1e-3 <= |x| < 1e7 was
;; spelled positionally (0.000000029802322387695313,
;; 1237940100000000000000000000.0) and is now d.dddE<exp>. Java takes the
;; even digit of an exact tie where this takes the larger one (it prints
;; 2^-25 as 2.9802322387695312E-8): the ties below pin the tie going up,
;; which the owner's decision of 2026-10-01 leaves as types §2.12 has it.
;; Three kinds of value, each checked against the expected text (a hit
;; counts 1, so a wrong digit lowers the verdict):
;;   - exact ties: 2^-25 and 2^-24 (a 5 and no more digits after the 17th
;;     and after the 16th),
;;     222507385850720.125 and 1125899906842624.25 (not powers of two),
;;     and at f32 2^-12 and 2097152.25;
;;   - powers of two, whose interval is narrower below than above: the
;;     nearest digits of 2^-44 and 2^-77 lie below the value, outside
;;     it, and the shortest reading lies above; 2^-1017 (once a text of
;;     324 characters, now 7.120236347223045E-307) and, at f32, 2^90 are
;;     the same;
;;   - 0.1 + 0.2, whose shortest text really has 17 digits.
(defun chk (s: str e: str) -> i64 (if (str-eq s e) 1 0))

(defun sum (v: (Vec i64)) -> i64
  (loop ((i 0) (acc 0))
    (if (= i (count v)) acc (recur (+ i 1) (+ acc (nth v i))))))

(defun main () -> i64
  (sum [(chk (show 2.9802322387695313e-8) "2.9802322387695313E-8")
        (chk (show -2.9802322387695313e-8) "-2.9802322387695313E-8")
        (chk (show 5.960464477539063e-8) "5.960464477539063E-8")
        (chk (show 222507385850720.13) "2.2250738585072013E14")
        (chk (show 1125899906842624.3) "1.1258999068426243E15")
        (chk (show 5.684341886080802e-14) "5.684341886080802E-14")
        (chk (show 6.617444900424222e-24) "6.617444900424222E-24")
        (chk (show 7.120236347223045e-307) "7.120236347223045E-307")
        (chk (show 2.44140625e-4f32) "2.4414063E-4")
        (chk (show 2097152.3f32) "2097152.3")
        (chk (show 1.2379401e27f32) "1.2379401E27")
        (chk (show (+ 0.1 0.2)) "0.30000000000000004")]))
