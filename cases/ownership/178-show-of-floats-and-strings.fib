;; spec:   types §2.12
;; expect: accept
;; result: 75
;; audit:  clean
;; The texts of show on floats and on str (types §2.12, Decided
;; 2026-09-30): a str shows as itself, unquoted; a float as the
;; shortest decimal that reads back at its width, positional, with .0
;; when integral, and NaN, inf, -inf. Each text is checked against the
;; expected one and its length added, so a wrong text costs 1000.
(defun chk (s: str e: str) -> i64 (if (str-eq s e) (str-len s) -1000))

(defun main () -> i64
  (+ (chk (show "abc") "abc")
     (+ (chk (show 1.5) "1.5")
        (+ (chk (show 100.0) "100.0")
           (+ (chk (show -0.0) "-0.0")
              (+ (chk (show 0.1f32) "0.1")
                 (+ (chk (show 1e21) "1000000000000000000000.0")
                    (+ (chk (show 1e-7) "0.0000001")
                       (+ (chk (show 123.456) "123.456")
                          (+ (chk (show (/ 0.0 0.0)) "NaN")
                             (+ (chk (show (/ -1.0 0.0)) "-inf")
                                (chk (show 16777217.0f32) "16777216.0"))))))))))))
