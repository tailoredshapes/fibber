;; spec:   types §6.3
;; expect: accept
;; result: 13
;; audit:  clean
;; stage:  2
;; roots:  ../../lib support
;; A join under a `try`, whose function returns a failure next to its value.
(ns main (:use fib.core fib.ex))
(defun fresh (b: (Array i64) n: i64) -> (Array i64)
  (let [r (cell (array n 0))] (do (array-set! &r 0 (array-get b 0)) @r)))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun t (b: (Array i64) c: bool) -> i64 (let [v (try (if c b (fresh b 3)) (catch e b))] (sink v)))
(defun main () -> i64 (let [a (array 4 3)] (+ (t a true) (t a false))))
