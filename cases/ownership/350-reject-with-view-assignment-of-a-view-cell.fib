;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   view cell v cannot be assigned
;; stage:  2
;; Check V8, a view cell is not replaceable (VC3).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (with-view [v (array-window! &a 0 2)] (do (set! v @v) 0))))
