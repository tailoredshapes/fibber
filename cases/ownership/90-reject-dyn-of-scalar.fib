;; spec:   §1 (types §2.15, §6.14, §8.5)
;; expect: reject
;; error:  dyn requires an object type
;; (dyn P e) of a scalar e is a type error (Decided, owner, 2026-09-27).
;; A (dyn P) is an object pointer and a vtable, and retaining or
;; releasing one acts on the object; an i64 has no object word (the
;; retain would read a header at address 7), and unit has no value at
;; all. The same holds for a field-less enum. A scalar that must be
;; dispatched dynamically is boxed in a struct first (adversary finding
;; 010, which expected 107).
(defprotocol Q (q (self) -> i64))
(impl Q i64 (q (self) self))
(impl Q unit (q (self) 100))

(defun sum (xs: (Vec (dyn Q)))
  (loop ((i 0) (acc 0))
    (if (< i (count xs)) (recur (+ i 1) (+ acc (q (nth xs i)))) acc)))

(defun main () -> i64 (sum [(dyn Q 7) (dyn Q ())]))
