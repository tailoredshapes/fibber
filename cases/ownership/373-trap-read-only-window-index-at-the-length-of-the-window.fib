;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    window index 4 out of range for a window of 4
;; stage:  2
;; Package EV2, a read of a read-only window at its length traps, though the element is inside the array.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 12 7))))
    (with-view-ro [v (array-window &a 4 8)] (vget v 4))))
