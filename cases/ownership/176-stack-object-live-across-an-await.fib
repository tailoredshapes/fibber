;; spec:   types §6.11, §8.8
;; expect: accept
;; result: 7
;; audit:  clean
;; A scope-local struct made before an await and read after it. Its
;; scope is the task's (types §6.11, "an async body's scopes are the
;; task's"), so compiled it lives in the task's frame, where a resume
;; on another worker still finds it, and its drop runs at the scope's
;; end after the await; on the interpreter's side it is a STACK object
;; ended by the same scope.
(defstruct P (x: i64 y: i64))

(defun main () -> i64
  (let ((t (async
             (let ((p (P 3 4)))
               (do (await (yield))
                   (+ (. p x) (. p y)))))))
    (block-on t)))
