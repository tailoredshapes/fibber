;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Package EV2, with-tiles is generic over the element type of fib.view: three tiles on three tasks of an f32, an i64 and an i32 array, each element
;; incremented once (an overlap would leave a 2, a gap a 0), and a count of tiles that does not divide the length.
(ns main (:use fib.view fib.view.tiles))

(defun f32s (n: i64 k: i64) -> bool
  (let ((a (cell (array n 0.0f32))))
    (do (with-tiles [w a k] (dotimes (i (vlen w)) (vset! w i (+ (vget w i) 1.0f32))))
        (loop ((i 0) (ok true)) (if (< i n) (recur (+ i 1) (and ok (= (array-get @a i) 1.0f32))) ok)))))

(defun i64s (n: i64 k: i64) -> bool
  (let ((a (cell (array n 10))))
    (do (with-tiles [w a k] (dotimes (i (vlen w)) (vset! w i (+ (vget w i) 1))))
        (loop ((i 0) (ok true)) (if (< i n) (recur (+ i 1) (and ok (= (array-get @a i) 11))) ok)))))

(defun i32s (n: i64 k: i64) -> bool
  (let ((a (cell (array n (trunc i32 5)))))
    (do (with-tiles [w a k] (dotimes (i (vlen w)) (vset! w i (+ (vget w i) (trunc i32 1)))))
        (loop ((i 0) (ok true)) (if (< i n) (recur (+ i 1) (and ok (= (array-get @a i) (trunc i32 6)))) ok)))))

(defun main () -> i64
  (if (and (f32s 1003 3) (i64s 1003 3) (i32s 1003 3) (f32s 7 4) (i64s 5 5) (i64s 2 4) (i32s 1 1)) 0 1))
