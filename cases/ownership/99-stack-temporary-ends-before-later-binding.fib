;; spec:   §3.2 (syntax §2, types §6.11, §8.2)
;; expect: accept
;; result: 1
;; audit:  clean
;; Stack lifetimes need not nest. The temporary (Pt 1 2) and the `let`
;; binding h are both scope-local. The temporary is made first and dies
;; at the end of its step (syntax §2), after h exists; h lives to the
;; `let`'s exit. Compiled, each is an alloca of the entry block whose
;; drop runs inline where its scope ends (types §8.2). The interpreter
;; once required each stack object to end innermost-first and stopped
;; with a gap in the ownership plan. Found by the rule-5 generator
;; (fibgen seed 100029, size 6), minimised by hand.
(defstruct Pt (x: i64 y: i64))
(defstruct Holder (v: i64))

(defun unhold (h: Holder) -> i64 (. h v))

(defun main () -> i64
  (let ((h (Holder (. (Pt 1 2) x))))
    (unhold h)))
