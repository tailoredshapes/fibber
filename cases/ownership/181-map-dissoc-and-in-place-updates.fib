;; spec:   types §2.13 (syntax §3.13, §4.5)
;; expect: accept
;; result: 1927
;; audit:  clean
;; dissoc of present and absent keys, down to the empty map; map-put!
;; and map-del! through & on a cell-held map; for-each over the
;; entries summing keys and values; contains?.
(defun main () -> i64
  (let ((m (loop ((i 0) (m (map-empty)))
             (if (< i 50) (recur (+ i 1) (assoc m i i)) m)))
        (gone (loop ((i 0) (m m))
                (if (< i 50) (recur (+ i 1) (dissoc m i)) m)))
        (half (loop ((i 0) (m m))
                (if (< i 50) (recur (+ i 2) (dissoc m i)) m)))
        (c (cell (map-empty)))
        (total (cell 0)))
    (do (map-put! &c 5 500)
        (map-put! &c 6 600)
        (map-del! &c 5)
        (map-del! &c 99)
        (for-each half (fn (e) (set! total (+ @total (+ (. e fst) (. e snd))))))
        (+ (count gone)
           (+ (count half)
              (+ (if (contains? half 3) 1 0)
                 (+ (if (contains? half 4) 1 0)
                    (+ (count (dissoc m 1000))
                       (+ (count @c)
                          (+ (unwrap-or (get @c 6) -1000)
                             @total))))))))))
