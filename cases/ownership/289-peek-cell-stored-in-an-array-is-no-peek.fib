;; spec:   spec/types.md §6.3 (Cell peeks, P1)
;; expect: accept
;; result: 1
;; audit:  clean
;; The cell is stored in an array (it is a value there), and the index calls a function that writes it through the array. A cell
;; that is ever a value is never a peek, so the read holds the old array (value 1). As a peek the old array would be freed under
;; the read and the read would see 9.
(defun nine () -> (Array i64) (array 4 9))

(defun poke (h: (Array (Cell (Array i64)))) -> i64
  (do (set! (array-get h 0) (array 4 7))
      (let [z (nine)] (- (array-get z 0) 8))))

(defun main () -> i64
  (let [a (cell (array 4 1))
        h (array 1 a)]
    (+ 0 (array-get @a (poke h)))))
