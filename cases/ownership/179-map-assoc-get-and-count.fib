;; spec:   types §2.13 (syntax §4.5, §1.4)
;; expect: accept
;; result: 1738
;; audit:  clean
;; The prelude's Map (an HAMT): a map literal, assoc of new and of
;; existing keys, get of present and absent keys, count, and the trie
;; growing past one node: keys 0, 32 and 1024 share their low five
;; bits and split at deeper levels; 40 keys fill a bitmap node.
(defun sum-gets (m: (Map i64 i64) n: i64) -> i64
  (loop ((i 0) (acc 0))
    (if (< i n)
        (recur (+ i 1) (+ acc (unwrap-or (get m i) -1000)))
        acc)))

(defun main () -> i64
  (let ((lit {1 10 2 20 3 30})
        (m (loop ((i 0) (m (map-empty)))
             (if (< i 40) (recur (+ i 1) (assoc m i (* i 2))) m)))
        (deep (assoc (assoc (assoc (map-empty) 0 1) 32 2) 1024 3)))
    (+ (unwrap-or (get lit 2) -1000)
       (+ (count lit)
          (+ (unwrap-or (get (assoc lit 2 99) 2) -1000)
             (+ (count (assoc lit 2 99))
                (+ (unwrap-or (get lit 7) 5)
                   (+ (count m)
                      (+ (sum-gets m 40)
                         (+ (unwrap-or (get deep 1024) -1000)
                            (+ (unwrap-or (get deep 32) -1000)
                               (count deep))))))))))))
