;; spec:   syntax §3.6 (types §2.6: a guarded clause covers nothing)
;; expect: reject
;; error:  non-exhaustive match: missing [_ & _]
;; The two guards together cover every non-empty vector, but the checker
;; cannot know a guard's value, so the unguarded clauses alone must be
;; exhaustive, and they cover only [].
(defun f (v: (Vec i64)) -> i64
  (match v
    ([] 0)
    ([x & _] :when (> x 0) x)
    ([x & _] :when (<= x 0) (- 0 x))))

(defun main () -> i64 (f [3]))
