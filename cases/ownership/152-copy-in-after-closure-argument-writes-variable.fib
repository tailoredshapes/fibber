;; spec:   §5 (syntax §2, §3.13; types §6.6)
;; expect: accept
;; result: 39
;; audit:  clean
;; A later argument writes the & argument's variable through a local
;; closure that captures it. (grow) pushes 2 onto c, through a copy-in
;; and write-back of its own that free [1]; then put is entered and
;; copies in c as it is then, [1 2], and pushes 9. The write-back
;; stores [1 2 9]: 3 elements, the last 9. With a copy-in at the
;; argument's position put would have pushed 9 onto [1], and its
;; write-back would have overwritten grow's push (29).
(defun put (&v: (Vec i64) n: i64) -> unit (push! &v n))

(defun main () -> i64
  (let ((c (cell [1])))
    (let ((grow (fn () (do (push! &c 2) 9))))
      (do (put &c (grow))
          (+ (* 10 (count @c)) (nth @c (- (count @c) 1)))))))
