;; spec:   syntax §3.16, §4.4
;; expect: accept
;; result: 2
;; audit:  clean
;; A user macro calling struct-fields on a struct defined earlier in the
;; module: reflection at expansion time gives the field names as Syms,
;; so the macro expands to the literal 2. The evaluator once sent every
;; builtin whose name starts with "str", struct-fields included, to the
;; string builtins (adversary finding 011).
(defstruct P (a: i64 b: str))

(defmacro nfields (name) (Int (vec-count (struct-fields name)) :i64))

(defun main () -> i64 (nfields P))
