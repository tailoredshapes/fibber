;; spec:   types §6.3 (consume), §6.6 (unique writes); docs/design/in-place-update.md §1 (steal, lever L1)
;; expect: accept
;; result: 10
;; audit:  clean
;; The shell `h` is read again after the cell takes `a`, so `a` is not stolen even though `h` is unique: its
;; field must still hold the array (the write copies it, since `a` is retained, and `(. h a)` reads the original 1).
;; A steal planned here reads a null array.
(defstruct Holder (a: (Array i64)))
(defun keep (h: Holder) -> Holder h)

(defun main () -> i64
  (let ((h (keep (Holder (array 4 1)))))
    (match h
      ((Holder a)
       (let ((c (cell a)))
         (do (array-set! &c 0 9)
             (+ (array-get @c 0) (array-get (. h a) 0))))))))
