;; spec:   spec/types.md §8.4; docs/design/vectorisation.md 7 item 4; compiler/emit/lower/spec.fib (the depth bound)
;; expect: accept
;; result: 0
;; audit:  clean
;; Recursion through a specialisation: a callee that calls itself passing its known parameter on (one instance), two functions that call
;; each other doing so, and a callee that calls itself with a new literal wrapping its parameter, which would make a new specialisation
;; at every level without the depth bound (the program compiles, and the answer is the one through a closure the specialisation cannot see).
(defun rsum (i: i64 hi: i64 f: (fn (i64) i64)) -> i64
  (if (>= i hi) 0 (+ (f i) (rsum (+ i 1) hi f))))
(defun even-sum (i: i64 hi: i64 f: (fn (i64) i64)) -> i64
  (if (>= i hi) 0 (+ (f i) (odd-sum (+ i 1) hi f))))
(defun odd-sum (i: i64 hi: i64 f: (fn (i64) i64)) -> i64
  (if (>= i hi) 0 (- (odd-sum-step i f) (even-sum (+ i 1) hi f))))
(defun odd-sum-step (i: i64 f: (fn (i64) i64)) -> i64 (* 2 (f i)))
(defun nest (n: i64 f: (fn (i64) i64)) -> i64
  (if (= n 0) (f 0) (nest (- n 1) (fn (x: i64) (+ 1 (f (+ x 2)))))))

(defun hidden (fs: (Vec (fn (i64) i64))) -> (fn (i64) i64) (nth fs 0))
(defun differs (a: i64 b: i64) -> i64 (if (= a b) 0 1))

(defun main () -> i64
  (let ((k 5))
    (+ (differs (rsum 0 20 (fn (i: i64) (* i k))) (rsum 0 20 (hidden [(fn (i: i64) (* i k))])))
       (differs (rsum 0 20 (fn (i: i64) (* i k))) 950)
       (differs (even-sum 0 9 (fn (i: i64) (+ i k))) (even-sum 0 9 (hidden [(fn (i: i64) (+ i k))])))
       (differs (nest 12 (fn (x: i64) (* x k))) (nest 12 (hidden [(fn (x: i64) (* x k))])))
       (differs (nest 12 (fn (x: i64) (* x k))) 132))))
