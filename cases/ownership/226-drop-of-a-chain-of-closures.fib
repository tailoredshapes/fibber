;; spec:   types §8.2, §8.4; compiler.md §4; method.md rule 6
;; expect: accept
;; result: 3
;; audit:  clean
;; allocs: <= 200004
;; Each closure captures the one before it, 200000 deep, the shape of a
;; lazy sequence whose every step holds the step behind it. Nothing
;; calls the chain (a call of it is as deep as the chain, a different
;; limit); it is only released, which must not take a native frame per
;; link. The trace of the frees is compared line for line with the
;; interpreter's.
(defun chain (n: i64) -> (fn () i64)
  (loop ((i 0) (f (fn () 1)))
    (if (< i n)
        (recur (+ i 1) (fn () (+ 1 (f))))
        f)))

(defun main () -> i64
  (let ((f (chain 200000)))
    (do (chain 2) 3)))
