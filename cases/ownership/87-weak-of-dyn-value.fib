;; spec:   §6 (types §2.11, §4.4, §8.1, §8.7)
;; expect: accept
;; result: 1
;; audit:  clean
;; A weak reference to a (dyn Show) value (Decided, owner, 2026-09-27:
;; supported). A (Weak (dyn P)) is two words by value, like (dyn P):
;; the object's one weak box, shared by every weak reference to that
;; object whatever protocol it is viewed through, and the vtable; it
;; holds one count on the box. @w rebuilds (some (dyn P)) from the box's
;; target and the stored vtable, or nil once the object is gone (types
;; §8.1, §8.7). While b is alive (show d) is "A", so main returns 1.
;; The finding (adversary 007) was that the mapping kept no vtable.
(defstruct A (n: i64))
(impl Show A (show (self) "A"))

(defun main () -> i64
  (let ((b (A 3)) (w (weak (dyn Show b))))
    (match @w ((some d) (str-len (show d))) (nil 0))))
