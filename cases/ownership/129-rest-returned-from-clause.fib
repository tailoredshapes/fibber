;; spec:   §3 (types §6.3: the match clause row; syntax §3.6)
;; expect: accept
;; result: 123
;; audit:  clean
;; A rest variable owns a new vector: returned as the clause's value it
;; is moved out of the clause's scope, while the other clause returns
;; the parameter itself, which the join retains. A rest that were a
;; borrow of the scrutinee would be freed with it, or make the
;; parameter escape; one released at the clause's exit as well as moved
;; out would be freed twice. 3 + 10*2 + 100*1 + 1000*0 = 123.
(defun drop-first (v: (Vec i64)) -> (Vec i64)
  (match v
    ([_ & r] r)
    ([] v)))

(defun main () -> i64
  (let ((a [1 2 3])
        (b (drop-first a))
        (c (drop-first b))
        (e (drop-first (drop-first c))))
    (+ (count a) (+ (* 10 (count b)) (+ (* 100 (count c)) (* 1000 (count e)))))))
