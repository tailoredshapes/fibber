;; spec:   types §6.3
;; expect: accept
;; result: 5
;; audit:  clean
;; Package BUG-1, a parameter that a join retains is owned (rule 1), so a caller hands it over; each recur argument is a call that hands over both loop variables; the first operands retain, the last moves.
;; Killed by: the recur argument fix.
(defun pick2 (a: (Array i64) b: (Array i64)) -> (Array i64) (if (= (array-len b) 0) a b))
(defun sink (v: (Array i64)) -> i64 (+ (array-get v 0) (array-len v)))
(defun t (n: i64) -> i64 (loop [i n x (array 4 1) y (array 4 2)] (if (= i 0) (sink x) (recur (- i 1) (pick2 y x) (pick2 x y)))))
(defun main () -> i64 (t 3))
