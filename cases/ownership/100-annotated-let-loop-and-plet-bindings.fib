;; spec:   syntax §1.5, §3.3, §3.12, §3.18 (types §2.4)
;; expect: accept
;; result: 12
;; audit:  clean
;; `x: T` annotates x in any binding position (syntax §1.5): a `let`
;; binding, a loop variable and a `plet` binding may be written
;; (x: T expr), the initialiser's type flowing into T. The reader once
;; rejected the annotated `let` binding as malformed. 0 + 3 + 9 = 12.
(defun main () -> i64
  (let ((x: (Vec i64) [])
        (n: i64 (count x)))
    (+ n
       (+ (loop ((i: i64 0) (acc: (Vec i64) x))
            (if (< i 3) (recur (+ i 1) (conj acc i)) (count acc)))
          (plet ((a: i64 (+ 4 5)) (b 0)) (+ a b))))))
