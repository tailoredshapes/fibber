;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Read-only lends: two read windows of one place at once and a read of the owner in the extent (decision 3 of 2026-10-04). Twin of
;; case 353: the second lend is read-only too.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 3))))
    (with-view-ro [r (array-window &a 0 4) s (array-window &a 4 8)]
      (if (= (+ (+ (vget r 0) (vget s 3)) (array-get @a 7)) 9) 0 1))))
