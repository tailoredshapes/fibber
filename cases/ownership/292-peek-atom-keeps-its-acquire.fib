;; spec:   spec/types.md §6.3 (Cell peeks, P1)
;; expect: accept
;; result: 4
;; audit:  clean
;; An atom is never a peek: another thread may replace its content at any time. `total` borrows the content of an atom and a cell
;; in turn; both give 2.
(defun total (a: (Array i64)) -> i64 (array-get a 3))

(defun main () -> i64
  (let [at (atom (array 4 2))
        c (cell (array 4 2))]
    (+ (total @at) (total @c))))
