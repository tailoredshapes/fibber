;; spec:   spec/types.md §6.3 (Cell peeks, P3)
;; expect: accept
;; result: 1
;; audit:  clean
;; The index of the read replaces the cell's array and then allocates a heap array of the same size (`nine`). `@a` is not a peek
;; (the index operand names `a`), so the read holds the old array by a count and reads its element 1 (value 1). A peek would leave
;; the old array with the cell's count alone: the `set!` frees it, `z` takes its memory and the read sees 9.
(defun nine () -> (Array i64) (array 4 9))

(defun main () -> i64
  (let [a (cell (array 4 1))]
    (+ 0 (array-get @a (do (set! a (array 4 7)) (let [z (nine)] (- (array-get z 0) 8)))))))
