;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   cannot be shared between threads
;; stage:  2
;; A tile's body runs on another task: it cannot capture the owner's cell (spawn's own Send rule), so the owner cannot be read while the tiles
;; write. Twin: case 368.
(ns main (:use fib.view fib.view.tiles))

(defun main () -> i64
  (let ((a (cell (array 8 0.0))))
    (do (with-tiles [w a 2] (vset! w 0 (array-get @a 0))) 0)))
