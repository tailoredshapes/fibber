;; spec:   syntax §4.3 (M5)
;; expect: accept
;; result: 124
;; audit:  clean
;; Whole files as strings: write-file writes a text, read-file reads it
;; back as (some text), and read-file of a path that does not exist is
;; nil; write-file into a directory that does not exist is false. The
;; file lives under /tmp, where both sides write the same bytes.
(defun main () -> i64
  (let ((path "/tmp/fibber-case-185.txt")
        (text (str-join ["héllo" "\n" "wörld"])))
    (+ (if (write-file path text) 1 0)
       (+ (match (read-file path) ((some t) (if (str-eq t text) (str-len t) -1000)) (nil -1000))
          (+ (match (read-file "/tmp/fibber-no-such-dir/x") ((some _) -1000) (nil 10))
             (if (write-file "/tmp/fibber-no-such-dir/x" "a") -1000 100))))))
