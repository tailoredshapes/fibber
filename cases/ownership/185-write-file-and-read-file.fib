;; spec:   syntax §4.3 (M5)
;; expect: accept
;; result: 124
;; audit:  clean
;; roots:  ../../lib
;; Whole files as strings: write-file writes a text, read-file reads it
;; back as (some text), and read-file of a path that does not exist is
;; nil; write-file into a directory that does not exist is false. The
;; Every run owns an exclusively created runtime directory and removes its fixture.
(ns main (:require [fib.os.environment :as env] [fib.os.process :as proc]
                  [fib.os.directories :as dirs] [fib.os.files :as files]))
(defun main () -> i64
  (let ((dir (match (dirs/create-temp-directory (str (env/temp-directory) "/fibber-case-185-" (proc/process-id) "-XXXXXX"))
               ((Ok d) d) ((Err _) (trap "case 185 fixture directory failed"))))
        (path (str dir "/data.txt"))
        (missing (str dir "/missing/x"))
        (text (str-join ["héllo" "\n" "wörld"])))
    (let ((result (+ (if (write-file path text) 1 0)
                    (+ (match (read-file path) ((some t) (if (str-eq t text) (str-len t) -1000)) (nil -1000))
                       (+ (match (read-file missing) ((some _) -1000) (nil 10))
                          (if (write-file missing "a") -1000 100))))))
      (do (files/remove-file path) (files/remove-directory dir) result))))
