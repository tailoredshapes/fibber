;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    with-tiles: the array is empty
;; stage:  2
;; Package EV2, a window needs an element for its seed, so with-tiles refuses an empty array as the lenders do (it did not before it was generic).
(ns main (:use fib.view fib.view.tiles))

(defun main () -> i64
  (let ((a (cell (array 0 0.0))))
    (do (with-tiles [w a 2] (vset! w 0 1.0))
        0)))
