;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: trap
;; trap:    window index 4 out of range for a window of 4
;; stage:  2
;; Package EV2, a store through vset! at the length of the window traps with the library's message, though the index is inside the buffer (the window
;; [4, 8) of an array of 12) and the store would land on a neighbour's element.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 12 0.0))))
    (do (with-view [v (array-window! &a 4 8)] (vset! v 4 1.0))
        0)))
