;; spec:   syntax §1.1, §3.16 (types §1.1)
;; expect: reject
;; error:  does not fit i8
;; A macro builds the Form (Int 300 :i8) and splices it into run-time
;; code. No i8 value is 300, and a literal that does not fit its width
;; is an error, never a wrap (syntax §1.1); a literal a macro builds is
;; checked like one the reader reads (adversary finding 013, where the
;; interpreter carried an i8 holding 300).
(defmacro m () (List [(Sym "sext") (Sym "i64") (Int 300 :i8)]))

(defun main () -> i64 (m))
