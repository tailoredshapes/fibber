;; spec:   syntax §3.6, §3.18 (types §6.10: a guard is never in tail position)
;; expect: reject
;; error:  recur not in tail position
;; The guard's value decides the clause; a recur there would jump out
;; of the match with the clause's rest still owned.
(defun main () -> i64
  (loop ((v [1 2 3]) (acc 0))
    (match v
      ([x & r] :when (recur r (+ acc x)) 0)
      (_ acc))))
