;; spec:   spec/types.md §6.2, §6.3 (Element reads, the element cannot be overwritten under the borrow)
;; expect: accept
;; result: 9
;; audit:  clean
;; The element read is `Owned` when its array comes out of a cell: the element is retained at the read (spec/types.md §6.3, "Element
;; reads" and "Cell peeks": `@c` here is a peek, so the array has the cell's count alone, and the element, a box, takes a count of its
;; own). `array-set!` then finds the array unique and writes in place, releasing the old box, which `e` still holds. If the read took
;; no count `e` would dangle after the write; if the write did not release the old box the audit would see a leak.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((c (cell (array 2 (Box 1)))))
    (let ((e (array-get @c 0)))
      (do (array-set! &c 0 (Box 7))
          (+ (. e n) (+ (. (array-get @c 0) n) (. (array-get @c 1) n)))))))
