;; spec:   spec/types.md §6.2, §6.3 (Element reads, the element cannot be overwritten under the borrow)
;; expect: accept
;; result: 9
;; audit:  clean
;; The array operand `@c` is `Owned` (a cell read acquires), so the element read stays `Owned`: it is retained at the read. The
;; cell's array is then held by the temporary as well, so `array-set!` copies it and the old box lives on in `e`. If the read took no
;; count the temporary's release would free the array and `e` would dangle; if the write did not copy, `e`'s box would be released
;; by the write while `e` still reads it.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((c (cell (array 2 (Box 1)))))
    (let ((e (array-get @c 0)))
      (do (array-set! &c 0 (Box 7))
          (+ (. e n) (+ (. (array-get @c 0) n) (. (array-get @c 1) n)))))))
