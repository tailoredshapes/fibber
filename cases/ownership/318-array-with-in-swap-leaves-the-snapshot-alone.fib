;; spec:   types §2.13.2 (an atom's value is shared), §6.6 (the atom's lock and snapshots)
;; expect: accept
;; result: 10
;; audit:  clean
;; An atom holds the array and a snapshot of it was taken before the `swap!`. The function given to `swap!` is a closure whose parameter
;; is owned, and `array-with` consumes it; the array has the atom's count and the snapshot's, so it is not unique and the update is a
;; copy: the snapshot still reads 1 and the atom 9. Written in place, the snapshot would read 9.
(defun main () -> i64
  (let ((at (atom (array 4 1))))
    (let ((snap @at))
      (do (swap! at (fn (a: (Array i64)) -> (Array i64) (array-with a 0 9)))
          (+ (array-get snap 0) (array-get @at 0))))))
