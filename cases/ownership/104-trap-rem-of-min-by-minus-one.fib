;; spec:   types §2.11, §2.12 (method.md rule 3)
;; expect: trap
;; trap:   integer overflow in rem at i32
;; rem of the minimum by -1 has the exact result 0, which fits, and
;; still traps, as Rust's % does and because LLVM's srem there is
;; undefined (types §2.12). At i32, so the width in the message is the
;; operands' own.
(defun main () -> i64
  (let ((m (trunc i32 -2147483648))
        (d (trunc i32 (- 0 (count [7])))))
    (sext i64 (rem m d))))
