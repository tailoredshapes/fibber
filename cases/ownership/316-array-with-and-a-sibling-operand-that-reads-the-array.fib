;; spec:   types §2.13.2 (a sibling read keeps the operand live), §6.3 (the operands of a call are siblings)
;; expect: accept
;; result: 10
;; audit:  clean
;; `(+ (array-get (array-with a 0 9) 0) (array-get a 0))`: the second operand of `+` reads `a` after the `array-with`, so `a` is not at
;; its last use there, the operand is retained and the call copies: 9 + 1. In place it would be 9 + 9.
(defun main () -> i64
  (let ((a (array 4 1)))
    (+ (array-get (array-with a 0 9) 0) (array-get a 0))))
