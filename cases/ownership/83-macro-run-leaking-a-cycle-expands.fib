;; spec:   §6 (syntax §3.16)
;; expect: accept
;; result: 5
;; audit:  clean
;; A macro whose body builds a cycle through a cell at expansion time
;; and returns its argument. A leaked cycle through cells is permitted
;; (§6, case 15), and macro-time evaluation is the same executable spec
;; as run time (syntax §3.16), so the expansion succeeds; only leaks
;; and audit errors, not cycle leaks, fail a macro run. The run-time
;; audit of main is clean (adversary finding 003).
(defmacro knot (x)
  (let ((c (cell [])))
    (do (set! c (vec-conj @c (fn () (vec-count @c)))) x)))

(defun main () -> i64 (knot 5))
