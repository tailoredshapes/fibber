;; spec:   spec/types.md §6.3 (Element reads, the element cannot be overwritten under the borrow)
;; expect: accept
;; result: 9
;; audit:  clean
;; `a` and the array in the cell `c` are one object with count 2, so the write `array-set! &c` must copy it. `e` is a part of `a`
;; (no count): it must still be the old box after the write, and `a` must still read the old box. A write in place would make the
;; sum 7 + 7 + 7.
(defstruct Box (n: i64))

(defun main () -> i64
  (let ((a (array 2 (Box 1))))
    (let ((c (cell a)))
      (let ((e (array-get a 0)))
        (do (array-set! &c 0 (Box 7))
            (+ (. e n) (+ (. (array-get a 0) n) (. (array-get @c 0) n))))))))
