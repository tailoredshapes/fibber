;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Package EV2, the unique-write protocol runs once before the tasks start: an array that another holder also counts is copied for the tiles, so
;; the writes of four tasks through raw pointers never reach the other holder, and the owner sees every write.
(ns main (:use fib.view fib.view.tiles))

(defun main () -> i64
  (let ((a (cell (array 16 1.0))))
    (let ((keep @a))
      (do (with-tiles [w a 4] (dotimes (i (vlen w)) (vset! w i (+ (vget w i) 1.0))))
          (loop ((i 0) (ok true))
            (if (< i 16)
                (recur (+ i 1) (and ok (= (array-get keep i) 1.0) (= (array-get @a i) 2.0)))
                (if ok 0 1)))))))
