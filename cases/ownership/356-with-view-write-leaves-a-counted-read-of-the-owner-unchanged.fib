;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; Check R1, the owner is shared with a plain read `r` made before the lend. The lender applies the unique-write protocol once, so it copies:
;; the window writes the owner's new buffer and `r` keeps the old values (a write never changes what a counted holder sees).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 1))))
    (let ((r @a))
      (do (with-view [v (array-window! &a 0 4)] (fill! v 9))
          (if (and (= (array-get r 0) 1) (= (array-get r 3) 1) (= (array-get @a 0) 9) (= (array-get @a 3) 9)) 0 1)))))
