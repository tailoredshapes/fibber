;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   a is lent to v and cannot be used here
;; stage:  2
;; Check V2, the body reads the lent place (L2). Twin: case 336, which reads the owner only after the form.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 8 0))))
    (with-view [v (array-window! &a 0 4)]
      (do (vset! v 0 (array-get @a 7)) 0))))
