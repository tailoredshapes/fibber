;; spec:   spec/types.md §2.11 (a trap), §8.4; docs/design/vectorisation.md 7 item 4; compiler/emit/lower/spec.fib
;; expect: trap
;; trap:   integer overflow
;; An overflow in a literal called directly from a specialised loop traps with the literal's message.
(defun sum (lo: i64 hi: i64 f: (fn (i64) i64)) -> i64
  (loop ((i lo) (acc 0)) (if (>= i hi) acc (recur (+ i 1) (+ acc (f i))))))

(defun main () -> i64
  (let ((big 9223372036854775800))
    (sum 0 10 (fn (i: i64) (if (= i 3) (+ big (* i 3)) i)))))
