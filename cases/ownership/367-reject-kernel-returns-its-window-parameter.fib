;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   view cell w can only be read as a call argument
;; stage:  2
;; S1 for an `&` parameter of scoped type: reading it as a value (to return it) is not a borrowed call argument. Twin: case 366.
(ns main (:use fib.view))

(defun leak (&w: (Win i64)) -> (Win i64) @w)
(defun main () -> i64 0)
