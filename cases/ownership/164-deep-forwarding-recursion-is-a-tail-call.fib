;; spec:   §4, §5 (types §6.6, §6.10 rule (b); syntax §3.13)
;; expect: accept
;; result: 2000000
;; audit:  clean
;; The exception of the owner's decision of 2026-09-28 concerns the
;; call's arguments only: a closure over v called directly before the
;; call, and an argument that does not mention v, leave &v forwarded,
;; so the self call is a tail call and the recursion, a million deep,
;; runs in constant stack with one write-back at the end.
;; r = @v = 1000000; c holds the same after the write-back.
(defun count-up (&v: i64 n: i64) -> i64
  (if (= n 0)
      @v
      (do ((fn () (set! v (+ @v 1))))
          (count-up &v (- n 1)))))
(defun main () -> i64
  (let ((c (cell 0)))
    (let ((r (count-up &c 1000000)))
      (+ r @c))))
