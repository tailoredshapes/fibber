;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   scoped value consumed: owned parameter w of keep
;; stage:  2
;; Check S1, a parameter of scoped type that is returned is consumed; a caller could then only pass it at an owned position.
(ns main (:use fib.view))

(defun keep (w: (Win i64)) -> (Win i64) w)
(defun main () -> i64 0)
