;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   view cell v cannot be captured by a closure
;; stage:  2
;; Check V3e, a closure mentions a view cell (VC2). Closures over view cells are not in v1 (decision 2 of 2026-10-04).
(ns main (:use fib.view))

(defun main () -> i64
  (let ((a (cell (array 4 0))))
    (with-view [v (array-window! &a 0 2)]
      (let ((f (fn () (vget v 0)))) (f)))))
