;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: reject
;; error:   scoped value consumed
;; stage:  2
;; Check V3b, the window is passed to a function that returns its argument, an owned position (6.4 rule 1): the read of the view cell is
;; not a peek, so the window would be consumed (S1).
(ns main (:use fib.view))

(defun same (x: a) -> a x)
(defun leak () -> i64
  (let ((a (cell (array 4 0))))
    (do (with-view [v (array-window! &a 0 2)] (same @v)) 0)))
(defun main () -> i64 0)
