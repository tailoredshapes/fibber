;; spec:   types §4.1, §4.4, §2.15
;; expect: accept
;; result: 20
;; audit:  clean
;; Named requires Show, and greet has a default that calls name. A
;; (dyn Named) satisfies Show too (types §4.1 rule 3), so show is
;; callable through it, and (dyn Show d) upcasts it; greet, omitted by
;; the impl, runs the default specialised to Dog (§4.1). The default
;; is object safe: only the receiver mentions Self (§4.4).
(defprotocol Named :requires (Show)
  (name (self) -> str)
  (greet (self) -> str (str-concat "hi " (name self))))

(defstruct Dog (n: str))
(impl Show Dog (show (self) (str-concat "dog " (. self n))))
(impl Named Dog (name (self) (. self n)))

(defun main () -> i64
  (let ((d (dyn Named (Dog "rex")))
        (s (dyn Show d)))
    (+ (str-len (greet d)) (+ (str-len (show d)) (str-len (show s))))))
