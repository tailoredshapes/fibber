;; spec:   syntax §3.6 (types §6.3: a false guard)
;; expect: accept
;; result: 1107
;; audit:  clean
;; Three clauses bind x and r. When a guard is false its clause's rest
;; is released and the next clause builds its own; the names are the
;; same but the bindings are not. The first guard allocates a
;; temporary, (conj r x), which dies at the guard's end whatever its
;; value. 100 + 1001 + 6 = 1107.
(defun pick (v: (Vec i64)) -> i64
  (match v
    ([x & r] :when (> (count (conj r x)) 3) (* 100 x))
    ([x & r] :when (= x 7) (+ 1000 (count r)))
    ([x & r] (+ x (count r)))
    ([] 0)))

(defun main () -> i64
  (+ (pick [1 2 3 4])
     (+ (pick [7 1])
        (pick [5 6]))))
