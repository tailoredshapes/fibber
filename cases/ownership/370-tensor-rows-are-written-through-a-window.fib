;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  0
;; audit:   clean
;; stage:  2
;; lib/fib/tensor/window-demo.fib: rows [1, 3) of a 4x3 dense matrix are filled and then incremented through a window over the tensor's buffer;
;; the other rows keep their values, and a counted holder of the original tensor still sees the original values.
(ns main (:use fib.view fib.tensor fib.tensor.window-demo))
(defun main () -> i64
  (let ((t (zeros [4 3])))
    (let ((u (add-to-rows! (fill-rows! t 1 3 2.0) 1 3 0.5)))
      (if (and (= (at u [0 0]) 0.0) (= (at u [1 0]) 2.5) (= (at u [2 2]) 2.5) (= (at u [3 1]) 0.0) (= (at t [1 1]) 0.0)) 0 1))))
