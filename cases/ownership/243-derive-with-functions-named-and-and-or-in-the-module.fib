;; spec:   syntax §4.4 (Hygiene)
;; expect: accept
;; result: 0
;; audit:  clean
;; The module defines functions and and or, which beat the prelude macros of those names in the
;; module: (and true true) is false here. The impls that derive writes name fib.prelude/and and
;; fib.prelude/or, so the derived Eq and Ord are the prelude's: two equal structs are equal and
;; (P 1 2) is less than (P 1 3), where the module's and would answer false for both.
;; (R14, stdlib §6.3: the owner's rule of 2026-10-01.)
(defun and (a: bool b: bool) -> bool false)
(defun or (a: bool b: bool) -> bool false)

(defstruct P (a: i64 b: i64))
(derive Eq P)
(derive Ord P)

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (+ (ck (not (and true true)) 1) (ck (= (P 1 2) (P 1 2)) 2))
     (+ (ck (< (P 1 2) (P 1 3)) 4) (ck (not (< (P 2 2) (P 1 3))) 8))))
