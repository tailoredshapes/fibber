;; spec:   types §2.13.1, §8.3 (array-set!), emit.lower.hoist (the unique check and the length are taken once before a counted loop)
;; expect: trap
;; trap:   array index 6 out of range 0..5
;; The loop writes indices 0, 2, 4 and then 6 of an array of 5: the trap is the checked write's, at index 6 with length 5, not earlier and
;; not at the end of the loop. A hoisted loop that dropped the bounds check would write past the array and not trap; one that checked the
;; whole range before the loop would name another index.
(defun main () -> i64
  (let ((buf (cell (array 5 0))))
    (do (dotimes (i 5) (array-set! &buf (* i 2) (+ i 1)))
        0)))
