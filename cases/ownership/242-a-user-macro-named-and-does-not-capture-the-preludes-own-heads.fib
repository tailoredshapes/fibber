;; spec:   syntax §4.4 (Hygiene)
;; expect: accept
;; result: 310
;; audit:  clean
;; The program defines a macro and, as the sum of its two operands. The prelude's own
;; expansions that name and, the fold (< 1 2 3) of a comparison, are written
;; fib.prelude/and and so are not the user's macro: (if (< 1 2 3) 10 0) is 10. Before R14 the
;; expansion of (< 1 2 3) named a bare and, which the user's macro captured: (+ true true).
;; The user's macro is still the user's by its bare name: (and 100 200) is 300.
(defmacro and (a b) `(+ ~a ~b))

(defun main () -> i64
  (+ (if (< 1 2 3) 10 0)
     (and 100 200)))
