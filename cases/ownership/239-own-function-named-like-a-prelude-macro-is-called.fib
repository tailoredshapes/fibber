;; spec:   syntax §4.4 (Declining), §5
;; expect: accept
;; result: 0
;; audit:  clean
;; A module's own definitions beat the prelude macros: it defines when, unless, cond, list,
;; update, reduce, str, print and max of its own, each with an arity or types the macro
;; cannot serve, and the call of each is the module's function. Before R14 every call below
;; was the macro's: (when true 1) is the if-expansion, (str 3 4) is a call of fib.core/to-str,
;; which this module does not see (unbound name), (update 1 2 3 4) is a call of
;; fib.coll/update (another unbound name) and (max 1 2 3) is the fold of fib.core/max. The
;; result is 0 when every call answered its function's number, else the bits of those that did not.
(defun when (c: bool a: i64) -> i64 (if c a 0))
(defun unless (c: bool a: i64) -> i64 (if c 0 a))
(defun cond (a: i64 b: i64) -> i64 (+ a b))
(defun list (a: i64 b: i64) -> i64 (* a b))
(defun update (a: i64 b: i64 c: i64 d: i64) -> i64 (+ (+ a b) (+ c d)))
(defun reduce (a: i64 b: i64) -> i64 (- a b))
(defun str (a: i64 b: i64) -> i64 (+ (* a 10) b))
(defun print (a: i64) -> i64 (* a 100))
(defun max (a: i64 b: i64 c: i64) -> i64 (+ a (+ b c)))

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (+ (+ (ck (= (when true 7) 7) 1) (ck (= (unless false 8) 8) 2))
        (+ (ck (= (cond 1 4) 5) 4) (ck (= (list 3 4) 12) 8)))
     (+ (+ (ck (= (update 1 2 3 4) 10) 16) (ck (= (reduce 9 4) 5) 32))
        (+ (ck (= (str 4 5) 45) 64) (+ (ck (= (print 2) 200) 128) (ck (= (max 1 2 3) 6) 256))))))
