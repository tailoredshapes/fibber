;; spec:   §2 (types §6.1: elements are derived; syntax §3.6)
;; expect: accept
;; result: 3011
;; audit:  clean
;; Struct patterns inside a vector pattern: the elements are parts of
;; the vector and their fields parts of them, all borrowed; the rest
;; holds counts on the structs it keeps. 11 + 100*30 + 0 = 3011.
(defstruct Pt (x: i64 y: i64))

(defun sum-first-two (ps: (Vec Pt)) -> i64
  (match ps
    ([(Pt a b) (Pt c d) & more] (+ (+ a b) (+ (+ c d) (count more))))
    ([(Pt a b)] (+ a b))
    ([] 0)))

(defun main () -> i64
  (+ (sum-first-two [(Pt 1 2) (Pt 3 4) (Pt 5 6)])
     (+ (* 100 (sum-first-two [(Pt 10 20)]))
        (sum-first-two []))))
