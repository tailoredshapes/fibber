;; spec:   syntax §4.4 (Hygiene); stdlib §7 L20
;; expect: accept
;; result: 0
;; audit:  clean
;; The impls that derive writes use the core forms and and or (since stdlib §7 L20 they are not
;; macros a module's own definitions could capture): two equal structs are equal and (P 1 2) is
;; less than (P 1 3), whatever else the module defines.
(defstruct P (a: i64 b: i64))
(derive Eq P)
(derive Ord P)

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (+ (+ (ck (and true true) 1) (ck (= (P 1 2) (P 1 2)) 2))
     (+ (ck (< (P 1 2) (P 1 3)) 4) (ck (not (< (P 2 2) (P 1 3))) 8))))
