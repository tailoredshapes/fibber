;; spec:   spec/types.md §8.4 (a closure's code and env), §8.9 (the order of a call); docs/design/vectorisation.md 7 item 4; compiler/emit/lower/spec.fib
;; expect: accept
;; result: 0
;; audit:  clean
;; A `fn` literal passed to a `defun` that calls it in a loop is called directly in a specialisation of the callee (emit.lower.spec),
;; not through the closure's code pointer; nothing else changes. The literals here capture a borrowed parameter (a struct), an owned
;; string made in the caller, a counted Vec, and a cell they write (so the calls are counted and their order seen), and are passed to
;; callees that call them in a `loop`, in a `recur` of the function itself, and from two parameters at once. Each answer is compared
;; with the same callee reached through a closure the specialisation cannot see (taken out of a Vec): a difference adds one.
(defstruct Box (n: i64))

(defun sum (lo: i64 hi: i64 f: (fn (i64) i64)) -> i64
  (loop ((i lo) (acc 0)) (if (>= i hi) acc (recur (+ i 1) (+ acc (f i))))))

(defun count-where (lo: i64 hi: i64 p: (fn (i64) bool)) -> i64
  (if (>= lo hi) 0 (+ (if (p lo) 1 0) (count-where (+ lo 1) hi p))))

(defun mix (n: i64 f: (fn (i64) i64) g: (fn (i64) i64)) -> i64
  (loop ((i 0) (acc 0)) (if (>= i n) acc (recur (+ i 1) (+ (* acc 3) (- (f i) (g i)))))))

(defun hidden (fs: (Vec (fn (i64) i64))) -> (fn (i64) i64) (nth fs 0))
(defun hidden-p (ps: (Vec (fn (i64) bool))) -> (fn (i64) bool) (nth ps 0))

(defun differs (a: i64 b: i64) -> i64 (if (= a b) 0 1))

(defun with-box (b: Box) -> i64
  (let ((s (str-concat "ab" "cde")) (v [10 20 30 40 50]) (calls (cell 0)))
    (let ((direct (sum 0 5 (fn (i: i64) (do (set! calls (+ (* @calls 10) (+ i 1))) (+ (* (. b n) i) (str-len s) (nth v i))))))
          (seen @calls)
          (through (sum 0 5 (hidden [(fn (i: i64) (do (set! calls (+ (* @calls 10) (+ i 1))) (+ (* (. b n) i) (str-len s) (nth v i))))]))))
      (+ (differs direct through) (differs seen 12345) (differs direct 245)
         (differs (count-where 0 50 (fn (i: i64) (= (rem i (. b n)) 0))) (count-where 0 50 (hidden-p [(fn (i: i64) (= (rem i (. b n)) 0))])))
         (differs (mix 6 (fn (i: i64) (* i (. b n))) (fn (i: i64) (nth v (rem i 5))))
                  (mix 6 (hidden [(fn (i: i64) (* i (. b n)))]) (hidden [(fn (i: i64) (nth v (rem i 5)))])))))))

(defun main () -> i64
  (with-box (Box 7)))
