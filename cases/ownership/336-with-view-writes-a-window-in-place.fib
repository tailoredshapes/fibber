;; spec:   types §6.15, syntax §3.21; docs/design/exclusive-views.md
;; expect: accept
;; result:  16
;; audit:   clean
;; stage:  2
;; A writable window of [2, 6) of a unique array: fill! and vset! write through it, vget reads it, and after the form the owner holds
;; the writes (1 + 9 + 5 + 1 = 16). Accepting twin of the reject cases that follow; each differs from this program in one token.
(ns main (:use fib.view))

(defun main () -> i64
  (let ((t (cell (array 8 1))))
    (do (with-view [v (array-window! &t 2 6)]
          (do (fill! v 5) (vset! v 0 9)))
        (+ (+ (array-get @t 0) (array-get @t 2)) (+ (array-get @t 3) (array-get @t 7))))))
