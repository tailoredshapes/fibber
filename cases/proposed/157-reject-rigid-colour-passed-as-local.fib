;; spec:   types §1.3, §3.2 (syntax §3.10)
;; expect: reject
;; error:  cannot unify (Hook k) with (Hook :local)
;; In an impl on (Hook k), k is rigid (owner, 2026-09-28): self is a
;; (Hook k) for an unknown k, which equals only itself as a colour
;; argument, so it cannot be passed where a (Hook :local) is expected.
;; Case 158 is the same body under a (Hook :local) head, which is
;; accepted.
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defun usel (h: (Hook :local)) -> i64 ((. h f) (. h tag)))
(defprotocol Score (score (self) -> i64))
(impl Score (Hook k) (score (self) (usel self)))
(defun main () -> i64 (score (Hook (fn (x) x) 1)))
