;; spec:   §5 (types §6.6, §6.10 rule (b); syntax §3.13)
;; expect: accept
;; result: 11
;; audit:  clean
;; Case 162 with the closure bound by a let before the call: k is a
;; carrier of v (a let binding whose initialiser is directly a fn that
;; mentions v, types §6.6), and the argument k names it, so &v is
;; copied in and written back as in case 162 (owner, 2026-09-28).
(defun g (&w: i64 k: (fn () unit) :borrow) -> i64 (do (set! w 1) (k) @w))
(defun f (&v: i64) -> i64 (let ((k (fn () (set! v 7)))) (g &v k)))
(defun main () -> i64 (let ((c (cell 0))) (let ((r (f &c))) (+ (* 10 r) @c))))
