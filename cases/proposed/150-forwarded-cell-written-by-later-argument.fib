;; spec:   §5 (types §6.6, §6.10 rule (b))
;; expect: accept
;; result: 2
;; audit:  clean
;; A finding of the rule-5 generator, minimised. io4's push! is in tail
;; position and forwards io4's private cell; its second argument first
;; calls io15 on the same cell, an ordinary call with a copy-in and a
;; write-back that pushes 4. Forwarded, push! then sees [4] and pushes
;; 0. The owner decided (2026-09-28) that a copy-in happens at call
;; entry, after every argument has been evaluated, so that forwarding
;; stays an unobservable optimisation of copy-in/copy-out: case 151 is
;; the same call on a let cell, which copies in, and gives 2 as well.
(defun io15 (&v0: (Vec i64) n: i64) -> unit (push! &v0 n))
(defun io4 (&v0: (Vec i64)) -> unit (push! &v0 (do (io15 &v0 4) 0)))
(defun main () -> i64 (let ((c (cell []))) (do (io4 &c) (count @c))))
