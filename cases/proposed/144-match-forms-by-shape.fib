;; spec:   syntax §3.6, §3.16 (matching forms)
;; expect: accept
;; result: 123
;; audit:  clean
;; Forms have no pattern syntax of their own: a List form's items are a
;; (Vec Form), matched by a vector pattern inside (List ..), at
;; expansion time in a macro and at run time on quoted forms, whose
;; parts are immortal. swap-if turns (if true 1 20) into (if true 20 1).
;; 20 + 3 + 100 + 0 = 123.
(defmacro swap-if (form)
  (match form
    ((List [(Sym "if") c t e]) (List [(Sym "if") c e t]))
    (_ form)))

(defun shape (f: Form) -> i64
  (match f
    ((List [(Sym "do") & steps]) (count steps))
    ((List [(Sym "if") _ _ _]) 100)
    ((List []) -1)
    (_ 0)))

(defun main () -> i64
  (+ (swap-if (if true 1 20))
     (+ (shape '(do a b c))
        (+ (shape '(if x y z))
           (shape 'q)))))
