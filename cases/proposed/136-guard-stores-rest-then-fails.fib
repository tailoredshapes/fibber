;; spec:   §3, §6 (types §6.3: a false guard; E2, E3)
;; expect: accept
;; result: 333
;; audit:  clean
;; A guard that stores its clause's rest into a cell and captures it in
;; a closure stored into another cell, then is false. The stores
;; retained the rest, so the release when the guard fails frees
;; nothing still held; the next clause matches the same scrutinee.
;; 3 + 10*3 + 100*3 = 333.
(defun main () -> i64
  (let ((saved (cell [0]))
        (thunk (cell (fn () 0))))
    (let ((n (match [1 2 3 4]
               ([_ & r] :when (do (set! saved r) (set! thunk (fn () (count r))) false) 0)
               ([a b & _] (+ a b))
               (_ -1))))
      (+ n (+ (* 10 (count @saved)) (* 100 (@thunk)))))))
