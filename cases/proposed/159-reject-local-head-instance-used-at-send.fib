;; spec:   types §1.3, §4.1 (syntax §3.10)
;; expect: reject
;; error:  no implementation of Score for (Hook :send)
;; The instance for (Hook :local) is the one instance of Score for Hook
;; (owner, 2026-09-28: one per protocol and head constructor, whatever
;; the colour) and covers local hooks only. h is annotated (Hook :send),
;; so no instance of Score applies to it.
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defun usel (h: (Hook :local)) -> i64 ((. h f) (. h tag)))
(defprotocol Score (score (self) -> i64))
(impl Score (Hook :local) (score (self) (usel self)))
(defun main () -> i64
  (let ((h: (Hook :send) (Hook (fn (x) (* x 3)) 2)))
    (score h)))
