;; spec:   §5 (syntax §2, §3.13; types §6.6)
;; expect: accept
;; result: 332
;; audit:  clean
;; Two & arguments; the third argument pushes 5 onto a, the first
;; one's variable, and yields its new count, 2. Both copy-ins happen at
;; call entry, in parameter order, after that: x starts as [1 5], y as
;; []. both pushes (count @x) = 2 onto y and n = 2 onto x and returns
;; 3; the write-backs, in parameter order, store [1 5 2] into a and [2]
;; into b. 3*100 + 3*10 + 2. With the copy-in of a at its position x
;; would have started as [1], and the write-back would have lost the 5
;; (221).
(defun both (&x: (Vec i64) &y: (Vec i64) n: i64) -> i64
  (do (push! &y (count @x))
      (push! &x n)
      (count @x)))

(defun main () -> i64
  (let ((a (cell [1]))
        (b (cell [])))
    (let ((r (both &a &b (do (push! &a 5) (count @a)))))
      (+ (* 100 r) (+ (* 10 (count @a)) (nth @b 0))))))
