;; spec:   syntax §3.16 (Phase separation: macro-time helpers)
;; expect: accept
;; result: 59
;; audit:  clean
;; stage:  2
;; A macro calls, at expansion time, a function of a module its own module requires (`h/tri`, `h/nested`), and the helpers
;; recurse by name. The site defines its own `tri`, which is not the helper. Before macro-time helpers the macro module saw
;; only the prelude: `macro sum-to failed: .. unbound name h/tri`. (sum-to 10) = 55; (nest 4) = 4.
(ns main (:require [hlib :as l]))

(defun tri (n: i64) -> i64 (- 0 n))

(defun main () -> i64
  (+ (l/sum-to 10) (l/nest 4)))
