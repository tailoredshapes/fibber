;; Macros that call, at expansion time, functions of a module their module requires (hlib.help); the helpers recurse by name.
(ns hlib (:require [hlib.help :as h]))

(defmacro sum-to (n)
  (match n
    ((Int v _) (Int (h/tri v) :i64))
    (_ (trap "sum-to: give a literal"))))

(defmacro nest (n) (h/nested n))
