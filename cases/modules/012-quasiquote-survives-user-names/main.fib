;; spec:   syntax §3.16, §1.4, §5; stdlib design §7 B2
;; expect: accept
;; result: 62
;; audit:  clean
;; A template is rewritten into (List (concat ..)), (Vec ..) and (Map ..)
;; calls, which resolve in the prelude, not in the module the macro is
;; used in (§1.4's rule for literals, applied to the rewrite): lib has
;; its own two-argument concat, and this module an enum whose variants
;; are named List, Vec and Map, and neither is what the macros build with
;; (a three-part template was "concat takes 2 argument(s), got 3", and
;; the variants were taken for the Form constructors). `() is the empty
;; list: fibc said "macro nothing failed: concat of nothing" for it, the
;; interpreter expanded it. The sum is 42 + 3 + 2 + 1 + 5 + 9.
(ns main (:use lib))

(defenum Tok (List x: i64) (Vec y: i64) (Map z: i64))

(defmacro thrice (x) `(+ ~x (+ ~x ~x)))

(defun main () -> i64
  (+ (twice 21)
     (+ (concat 1 2)
        (+ (count (vec-of-two 7))
           (+ (count (map-of 1 2))
              (+ (do (nothing) (last-of 1 2 5))
                 (thrice 3)))))))
