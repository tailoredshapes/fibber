;; spec:   syntax §5; compiler.md §1; stdlib design §7 E7
;; expect: accept
;; result: 43
;; audit:  clean
;; roots:  lib
;; A module that is not beside the main file but under a library root:
;; the header's roots key gives the case the root lib, which both
;; harnesses pass as -I lib (fibref run -I and fibc run -I do the same by
;; hand). ext.shapes is found there, and it needs ext.units, found there
;; too, from the file that requires it; local is beside the main file.
;; 6 * 7 * 1 = 42, and (bump 0) = 1 more.
(ns main (:require [ext.shapes :as s] [local :as l]))

(defun main () -> i64 (+ (s/area 6 7) (l/bump 0)))
