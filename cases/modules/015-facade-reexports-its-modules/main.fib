;; spec:   syntax §5; stdlib design §6.2, §7 E7
;; expect: accept
;; result: 716
;; audit:  clean
;; roots:  lib
;; A facade module re-exports others with (:export-from m ..): what they
;; export is exported by it, unqualified to a :use and through the alias
;; of a :require, in every space of names: functions (fa, fb), a struct
;; and its constructor (Pt), a protocol and its method (size), a macro
;; (twice). The facade's own function (own) is there too, and it sees
;; the re-exported names itself, as it :uses them. 302 + 101 + 202 + 6 +
;; 3 + 100 + 2 = 716: own, (fa 1), (fb 2), (twice 3), (size (Pt 1 2)),
;; (f/fa 0), (f/twice 1).
(ns main (:use facade) (:require [facade :as f]))

(defun main () -> i64
  (+ (own)
     (+ (fa 1)
        (+ (fb 2)
           (+ (twice 3)
              (+ (size (Pt 1 2))
                 (+ (f/fa 0) (f/twice 1))))))))
