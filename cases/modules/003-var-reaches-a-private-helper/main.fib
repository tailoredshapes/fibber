;; spec:   syntax §3.20, §5
;; expect: accept
;; result: 83
;; audit:  clean
;; (var m/x) is the one reference that sees a private definition of
;; another module (syntax §3.20): the deliberate door a macro of util
;; would use; here main goes through it directly, beside a public
;; function of the same module (42).
(ns main (:require [util :as u]))

(defun main () -> i64 (+ ((var u/secret)) (u/open)))
