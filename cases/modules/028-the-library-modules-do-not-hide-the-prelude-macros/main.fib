;; spec:   syntax §4.4 (Declining), §5; stdlib §6.3 (R14)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../../lib
;; The library's modules export functions called update, reduce, str, println, max, conj and
;; assoc, which are the twins of the prelude macros of those names and sit beside them: a module
;; that :uses fib.core, fib.seq, fib.coll and fib.print does not lose the macros. (update m k + 1)
;; with an extra argument and (reduce + c) with no initial value are the macros'; (str 1 2) is the
;; text "12"; (max 1 2 3) the fold. The same program with a module of the program's own that
;; exports those names would call its functions (case 026).
(ns main (:use fib.core fib.seq fib.coll fib.print))

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun main () -> i64
  (let ((m (assoc (map-empty) "a" 5)))
    (+ (+ (ck (= (get-or (update m "a" + 10) "a" 0) 15) 1) (ck (= (reduce + [1 2 3]) 6) 2))
       (+ (ck (= (str 1 2) "12") 4) (ck (= (max 1 2 3) 3) 8)))))
