;; spec:   syntax §5; compiler.md §1; stdlib design §7 E7
;; expect: accept
;; result: 108
;; audit:  clean
;; roots:  first second
;; The order modules are looked for in: the main file's directory, then
;; each root of the header in order. util is in all three places, and the
;; one beside the main file wins (100); pick is in both roots, and the
;; first one wins (1, not 2: a module in two roots is the first's, the
;; second is never read); only-second is only in the second root (7).
;; 100 + 1 + 7 = 108.
(ns main (:require [util :as u] [pick :as p] [only-second :as o]))

(defun main () -> i64 (+ (u/which) (+ (p/which) (o/which))))
