;; spec:   stdlib §6.3, §7 E1 and E10 (the list macro expands to qualified names); syntax §3.16
;; expect: accept
;; result: 23
;; audit:  clean
;; The prelude macro (list ..) expands to the prelude's own Cons and Empty
;; (fib.prelude/Cons, fib.prelude/Empty), not to whatever `cons` and `empty`
;; mean in the module that uses it. lib defines a function `cons` that
;; returns its second argument and a function `empty`: with the unqualified
;; expansion (cons 1 (cons 2 (cons 3 empty))) the list was built by lib's
;; `cons`, and (count (list 1 2 3)) was 0 (probe p4 of the tranche 1 plan:
;; result 0, audit clean). Three elements, two elements times ten, and an
;; empty list: 3 + 20 + 0.
(ns main (:use lib))

(defun main () -> i64
  (let ((e: (List i64) (list)))
    (+ (count (list 1 2 3))
       (+ (* 10 (count (list 4 5)))
          (count e)))))
