;; spec:   syntax §5
;; expect: accept
;; result: 7
;; audit:  clean
;; Two modules that both require a third: the third is read once and
;; its definitions are one set, so the struct left makes and right
;; reads is the same type, and its def is one immortal value.
(ns main (:require [left :as l] [right :as r]))

(defun main () -> i64 (+ (r/read (l/make 4)) (l/count-shared)))
