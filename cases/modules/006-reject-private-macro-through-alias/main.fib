;; spec:   syntax §5, §3.16
;; expect: reject
;; error:  unbound name u/hidden
;; A :private macro of a required module is not reached through the
;; alias (syntax §5): the call is then no macro call, and its head is
;; an unbound name.
(ns main (:require [util :as u]))

(defun main () -> i64 (u/hidden 5))
