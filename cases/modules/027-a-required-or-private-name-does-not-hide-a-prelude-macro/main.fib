;; spec:   syntax §4.4 (Declining), §5; stdlib §6.3 (R14)
;; expect: accept
;; result: 0
;; audit:  clean
;; util defines functions called when and list and a private one called unless. Main :requires
;; util under an alias and :uses nothing: a required module's names are not main's own (they are
;; reached by the alias, (u/when 6) is util's 106), and a :private name is not exported to anyone,
;; so in main (when ..), (list ..) and (unless ..) are still the prelude's macros: (when c body) is
;; an if with a unit else, (list 1 2) the Cons chain, (unless c body) an if. The result is 0 when
;; each call answered as it should, else the bits of those that did not.
(ns main (:require [util :as u]))

(defun ck (ok: bool bit: i64) -> i64 (if ok 0 bit))

(defun head (l: (List i64)) -> i64
  (match l ((Cons h _) h) (_ -1)))

(defun main () -> i64
  (let ((x (cell 0)))
    (do (when true (set! x 3))
        (unless true (set! x 99))
        (+ (+ (ck (= @x 3) 1) (ck (= (u/when 6) 106) 2))
           (+ (ck (= (head (list 7 8)) 7) 4) (ck (= (u/list 1 2) 2) 8))))))
