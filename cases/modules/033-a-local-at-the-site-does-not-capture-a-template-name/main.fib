;; spec:   syntax §3.16 (Names in a template), §5
;; expect: accept
;; result: 1010
;; audit:  clean
;; stage:  2
;; The classic hygiene test: the site binds locals named `double` (a function value) and `base`, spelt like the names the
;; template takes from its module, and calls the macro inside them. The template's names are clib/double and clib/base, which
;; no local can capture. The site `:use`s clib, so with the template resolved at the site (no rule) the expansion compiles and
;; calls the local `double` and adds the local `base`: (+ (* 5 1000) 7) = 5007, a wrong answer rather than an error.
;; (twice-plus-base 5) = 10 + 1000.
(ns main (:use clib))

(defun main () -> i64
  (let ((double (fn (x: i64) (* x 1000)))
        (base 7))
    (twice-plus-base 5)))
