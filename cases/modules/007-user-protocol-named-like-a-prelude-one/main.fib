;; spec:   syntax §5, §1.4, §3.10; stdlib design §7 B3
;; expect: accept
;; result: 43
;; audit:  clean
;; The program's own protocol Collection with a method conj, implemented
;; for (Vec a), beside the library's Collection and conj (fib.coll, implicit
;; in every module). A name defined locally shadows the library's (syntax
;; §5), so (conj [1 2 3] 4) is the program's method, which keeps the
;; receiver: 3. The literal [1 2 3] is the prelude's vec-conj (§1.4 resolves
;; its heads in the prelude, not in the module), and fib.coll/conj is the
;; library's method: 4 elements.
;; Both tools must give 3 + 10 * 4 = 43: fibc named both methods
;; m.Collection.conj.$Vec... and failed with "duplicate definition".
(defprotocol (Collection s e) (conj (self x: e) -> Self))
(impl (Collection a) (Vec a)
  (conj (self x) self))

(defun main () -> i64
  (+ (count (conj [1 2 3] 4))
     (* 10 (count (fib.coll/conj [1 2 3] 4)))))
