;; spec:   syntax §5
;; expect: reject
;; error:  secret is private to util; it is not exported
;; A :private definition of a required module is not reachable by its
;; qualified name from another module (syntax §5): the error names the
;; module that owns it.
(ns main (:require [util :as u]))

(defun main () -> i64 (u/secret))
