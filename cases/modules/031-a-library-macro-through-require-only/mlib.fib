;; A library whose macros name its own functions bare, a function of a module it requires through its alias, another macro of
;; its own (which recurses by name) and a local the template binds that is spelt like one of its functions.
(ns mlib (:require [mlib.util :as u]))

(defun scale (x: i64) -> i64 (* x 10))

(defmacro scaled (e) `(+ (scale ~e) (u/bump ~e)))

(defmacro sum-all (... xs)
  (if (= (vec-count xs) 0)
      '0
      `(+ ~(vec-nth xs 0)
          (sum-all ~@(loop ((i 1) (out (vec-empty)))
                       (if (< i (vec-count xs)) (recur (+ i 1) (vec-conj out (vec-nth xs i))) out))))))

;; `scale` is bound by the template's `let`: it stays the local, not mlib/scale
(defmacro plus-one (e) `(let ((scale ~e)) (+ scale 1)))

;; an anaphoric macro: the template binds `it` for the caller's body, and mlib also defines a function `it`; the binding must stay
;; the bare `it` the body refers to (written mlib/it, the body's `it` would be unbound at the site)
(defun it (x: i64) -> i64 x)
(defmacro with-it (e body) `(let ((it ~e)) ~body))
