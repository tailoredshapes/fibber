;; spec:   syntax §3.16 (Names in a template), §5
;; expect: accept
;; result: 1279
;; audit:  clean
;; stage:  2
;; A library's macros work where the library is only `:require`d under an alias: the template's bare `scale` is mlib/scale, its
;; `u/bump` (mlib's alias) is mlib.util/bump, a module main never names, and `sum-all` calls itself as mlib/sum-all. The
;; `scale` that `plus-one`'s template binds stays the local. Before the rule: `unbound name scale` at the site.
;; (scaled 7) = 70 + 8; (sum-all 1 2 3 4 5) = 15; (plus-one 1185) = 1186.
(ns main (:require [mlib :as m]))

(defun main () -> i64
  (+ (m/scaled 7) (+ (m/sum-all 1 2 3 4 5) (m/plus-one 1185))))
