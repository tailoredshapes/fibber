;; spec:   stdlib §6.5; plan tranche 1 C-3 (probe p1)
;; expect: accept
;; result: 5
;; audit:  clean
;; lib exports a method `empty` and a function `cons`, and this module
;; matches the prelude's list on its variants Empty and Cons. With the old
;; spelling of the variants it was "empty is not a variant or struct" at the
;; pattern (probe p1, both tools): a name in scope that is a function or a
;; method hides a variant of the same name in a pattern. Empty and Cons
;; are no function's or method's name, so both names are free for the
;; library. (len (cons 9 l)) is 4, and the method on a vector gives the empty
;; vector, which conj makes a one-element vector.
(ns main (:use lib))

(defun len (l: (List i64)) -> i64
  (match l
    ((Empty) 0)
    ((Cons _ t) (+ 1 (len t)))))

(defun main () -> i64
  (let ((l (list 1 2 3)))
    (+ (len (cons 9 l)) (count (conj (empty [1 2]) 7)))))
