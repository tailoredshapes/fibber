;; spec:   stdlib §6.5; plan tranche 1 C-3
;; expect: reject
;; error:  empty is not a variant or struct
;; The prelude's list variants are Empty and Cons: the old spellings in a
;; pattern are names that are nothing, with no alias (the plan: "no alias for
;; the old names"), so a program that still writes them is told so, not
;; silently matched against a lowercase function or method of the same name.
(ns main)

(defun len (l: (List i64)) -> i64
  (match l
    ((empty) 0)
    ((cons _ t) (+ 1 (len t)))))

(defun main () -> i64 (len (list 1 2)))
