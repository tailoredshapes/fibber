;; spec:   syntax §1.4; stdlib §6.2, §7 E1; plan tranche 1 C-5
;; expect: accept
;; result: 123
;; audit:  clean
;; A literal collection is rewritten to calls of the prelude's functions
;; vec-conj and map-assoc (fib.prelude/vec-conj, fib.prelude/map-assoc), not
;; to its protocol methods conj and assoc, which the library defines again
;; in fib.coll and the flip deletes from the prelude. lib defines a `conj`
;; and an `assoc` that return their first argument unchanged: [1 2 3] still
;; has three elements, {1 2 3 4} two entries, and the bare call (conj [5] 9)
;; is lib's, which adds nothing: 3 + 2 * 10 + 1 * 100.
(ns main (:use lib))

(defun main () -> i64
  (+ (count [1 2 3])
     (+ (* 10 (count {1 2 3 4}))
        (* 100 (count (conj [5] 9))))))
