;; spec:   stdlib §6.3, §7 E1 and E10 (the list macro expands to qualified names); plan tranche 1 R2
;; expect: accept
;; result: 223
;; audit:  clean
;; lib defines its own list type (Stack a) with the variants Empty and
;; Cons, and main uses lib, so a bare Cons or Empty in main is the Stack's.
;; The prelude macro (list ..) must still build the prelude's List
;; (fib.prelude/Cons, fib.prelude/Empty): its expansion is not what the
;; names mean in the module that calls it. Case 020 has lowercase functions
;; named cons and empty, which since the variants became Cons and Empty can
;; no longer capture the expansion; this case can. The prelude list of three
;; counts 3, an empty list 0, the hand-built Stack counts 2, written by its
;; own constructors: 3 + 10 * 0 + 100 * 2 + 20 (the list of two, counted).
(ns main (:use lib))

(defun main () -> i64
  (let ((e: (List i64) (list)))
    (+ (count (list 1 2 3))
       (+ (* 10 (count e))
          (+ (* 100 (stack-len (Cons 1 (Cons 2 Empty))))
             (* 10 (count (list 4 5))))))))
