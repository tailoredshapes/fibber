(ns lib)

;; a user's own list type whose variants are spelt like the prelude's: a bare
;; Cons or Empty in this module or in a module that uses it is this type's
(defenum (Stack a) (Empty) (Cons head: a tail: (Stack a)))

(defun stack-len (s: (Stack i64)) -> i64
  (match s
    ((Empty) 0)
    ((Cons _ t) (+ 1 (stack-len t)))))
