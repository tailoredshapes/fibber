;; spec:   syntax §5, §3.10; stdlib design §7 B3
;; expect: accept
;; result: 2121
;; audit:  clean
;; Two modules each define a protocol Sized with a method size, and each
;; implements it for str: different protocols, so different methods
;; (a answers 1, b answers 2), called directly and through (dyn Sized).
;; fibc named the two methods m.Sized.size.str, and the vtable of the
;; second (dyn Sized "..") was the first's, silently: the symbols of a
;; protocol's methods and vtables carry the defining module's name.
(ns main (:require [a :as a] [b :as b]))

(defun main () -> i64
  (+ (a/size "xy")
     (+ (* 10 (b/size "xy"))
        (+ (* 100 (a/via-dyn "xy"))
           (* 1000 (b/via-dyn "xy"))))))
