;; spec:   stdlib §6.5 (`empty`, `cons`: the variants become Empty, Cons); plan tranche 1 C-3
;; expect: accept
;; result: 1234
;; audit:  clean
;; The variants of the prelude's (List a) are Empty and Cons, with the fields
;; head and tail, in a pattern, as constructors and as the value of the
;; list macro. A field-less variant is written (Empty) in a pattern; a bare
;; Empty is a binding. 1000 + 200 + 30 + 4: the sum of (list 1 2 3), the
;; length of a hand-built list, whether a list built by hand is equal to
;; the macro's, and the first element through a pattern with a wildcard.
(ns main)

(defun sum (l: (List i64)) -> i64
  (match l
    ((Empty) 0)
    ((Cons h t) (+ h (sum t)))))

(defun len (l: (List i64)) -> i64
  (match l
    ((Empty) 0)
    ((Cons _ t) (+ 1 (len t)))))

(defun first-or (l: (List i64) d: i64) -> i64
  (match l
    ((Cons h _) h)
    (_ d)))

(defun main () -> i64
  (let ((built (Cons 1 (Cons 2 (Cons 3 Empty))))
        (made (list 1 2 3)))
    (+ (if (= (sum made) 6) 1000 0)
       (+ (if (= (len (Cons 7 (Cons 8 Empty))) 2) 200 0)
          (+ (if (= built made) 30 0)
             (first-or (list 4 5) 0))))))
