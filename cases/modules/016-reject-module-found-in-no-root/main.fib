;; spec:   syntax §5; compiler.md §1; stdlib design §7 E7
;; expect: reject
;; error:  module ext.nowhere is not at
;; roots:  lib
;; A module that is neither beside the main file nor under any root is an
;; error that names the file it was expected at, and the others it was
;; looked for in.
(ns main (:require [ext.nowhere :as n]))

(defun main () -> i64 (n/f))
