;; spec:   syntax §3.16 (Names in a template), §3.20, §5
;; expect: accept
;; result: 744
;; audit:  clean
;; stage:  2
;; A template that names a :private function and a :private `def` of its module bare reaches them from a module that only
;; requires it: the rewrite writes `(var plib/secret)` and `(var plib/offset)`, the one reference that sees a private definition
;; (§3.20), in a call head and as a value. Before the rule: `secret is private to plib` or `unbound name secret`.
;; (reveal 4) = 407 + 30; (apply-secret 3) = 307.
(ns main (:require [plib :as p]))

(defun main () -> i64
  (+ (p/reveal 4) (p/apply-secret 3)))
