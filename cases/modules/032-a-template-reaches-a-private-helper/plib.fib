(ns plib)

(defun secret :private (x: i64) -> i64 (+ (* x 100) 7))
(def offset :private 30)

;; bare names of private definitions: the template means plib's, written (var plib/secret) and (var plib/offset)
(defmacro reveal (e) `(+ (secret ~e) offset))
;; a private helper used as a value, not called
(defmacro apply-secret (e) `(let ((f secret)) (f ~e)))
