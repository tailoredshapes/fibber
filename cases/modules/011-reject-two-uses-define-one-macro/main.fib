;; spec:   syntax §5; stdlib design §7 E12
;; expect: reject
;; error:  twice is exported by both one and two; write one/twice or two/twice
;; The rule of case 009 holds for macros: two :use'd modules that both
;; define a macro twice make (twice 4) an error. The macro of the first
;; :use was expanded silently.
(ns main (:use one two))

(defun main () -> i64 (twice 4))
