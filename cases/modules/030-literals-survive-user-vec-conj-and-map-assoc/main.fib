;; spec:   syntax §1.4; stdlib §6.2, §7 E1; plan tranche 1 R2 (C-5)
;; expect: accept
;; result: 23
;; audit:  clean
;; The rewrite of a literal collection names the prelude's functions as
;; fib.prelude/vec-empty, vec-conj, map-empty and map-assoc: "the rewrite
;; resolves them in the prelude, not in the current namespace" (§1.4). lib
;; defines functions of those four names that build the wrong collections,
;; and main uses lib, so a bare name in the expansion would reach them. Case
;; 021 shadows conj and assoc, which no literal is built with any more; this
;; one shadows the four names that are. [1 2 3] has three elements, {1 2 3
;; 4} two entries, and the empty literals none (lib's empties have one
;; entry each): 3 + 10 * 2 + 100 * 0 + 1000 * 0.
(ns main (:use lib))

(defun main () -> i64
  (+ (count [1 2 3])
     (+ (* 10 (count {1 2 3 4}))
        (+ (* 100 (count (let ((v: (Vec i64) [])) v)))
           (* 1000 (count (let ((m: (Map i64 i64) {})) m)))))))
