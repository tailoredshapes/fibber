(ns lib)

;; functions named like the prelude functions that a literal is rewritten to
;; (stdlib design C-5): none of them is what [..] and {..} mean. Each is
;; deliberately wrong: the conj and the assoc return their first argument,
;; and the empties are one-entry collections
(defun vec-empty () -> (Vec i64) [100])
(defun vec-conj (v: (Vec i64) x: i64) -> (Vec i64) v)
(defun map-empty () -> (Map i64 i64) {7 7})
(defun map-assoc (m: (Map i64 i64) k: i64 v: i64) -> (Map i64 i64) m)
