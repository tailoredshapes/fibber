;; spec:   syntax §3.16 (Names in a template), §5
;; expect: accept
;; result: 24
;; audit:  clean
;; stage:  2
;; The site defines its own top-level `helper` and `fmt`, spelt like the functions the macro's template names; a module's own
;; definition shadows a `:use`d one (§5), so with the template resolved at the site (no rule) the expansion would call main's
;; functions: (fmt (helper 5)) + (fmt (helper 1)) = 499 + 99. The template means slib/helper and slib/fmt: (5 + 1) * 3 + (1 + 1) * 3.
(ns main (:use slib))

(defun helper (x: i64) -> i64 (* x 100))
(defun fmt (x: i64) -> i64 (- x 1))

(defun main () -> i64
  (+ (step 5) (step 1)))
