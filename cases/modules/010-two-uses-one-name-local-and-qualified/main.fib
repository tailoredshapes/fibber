;; spec:   syntax §5; stdlib design §7 E12
;; expect: accept
;; result: 1630
;; audit:  clean
;; The error of case 009 is only for a bare reference to a name that two
;; :use'd modules export. This module defines its own peek, which
;; shadows both (the local (peek 3) is 30); a name only one of them
;; exports is no clash (only-one, only-two, each 0 once 5 and 7 are
;; taken off); and each module's peek is reachable by the module's full
;; name, one/peek and two/peek (a :use makes the name a qualifier, §5):
;; 1000 * (two/peek 0) + 100 * (one/peek 6) + 30 + 0 + 0 = 1630.
(ns main (:use one two))

(defun peek (x: i64) -> i64 (* x 10))

(defun main () -> i64
  (+ (* 1000 (two/peek 0))
     (+ (* 100 (one/peek 6))
        (+ (peek 3)
           (+ (- (only-one) 5) (- (only-two) 7))))))
