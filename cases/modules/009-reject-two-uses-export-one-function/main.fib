;; spec:   syntax §5; stdlib design §7 E12
;; expect: reject
;; error:  peek is exported by both one and two; write one/peek or two/peek
;; Two :use'd modules that export one name make that name an error when it
;; is referenced unqualified (syntax §5). The code took the first :use
;; silently: (peek 3) was 3 with (:use one two) and 4 with (:use two one).
(ns main (:use one two))

(defun main () -> i64 (peek 3))
