;; spec:   syntax §5, §3.16
;; expect: accept
;; result: 40
;; audit:  clean
;; A module's macros reach the module that uses it unqualified and the
;; one that requires it through the alias: twice from the used module
;; and m/thrice through the alias; a second module's macro of the same
;; name, thrice, is a different macro, told apart by its module.
(ns main (:require [more :as m]) (:use util))

(defun main () -> i64
  (+ (twice 5) (+ (m/thrice 5) (thrice 5))))
