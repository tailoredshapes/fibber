;; spec:   syntax §5
;; expect: accept
;; result: 17
;; audit:  clean
;; A program of three modules: main requires geo.point under the alias
;; pt and uses util, so pt/Point, pt/norm1 and the unqualified double
;; resolve; geo.point itself uses util. The modules live under main's
;; directory, geo.point at geo/point.fib, and are read once each in
;; dependency order.
(ns main (:require [geo.point :as pt]) (:use util))

(defun main () -> i64
  (+ (pt/norm1 (pt/Point 3 4)) (double 5)))
