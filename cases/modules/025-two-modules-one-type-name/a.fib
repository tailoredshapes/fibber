(ns a)
(defstruct Pt (x: i64))
(defstruct Hidden :private (n: i64))
(defstruct (Wrap t) (v: t))
(defenum Shape (Dot p: Pt) (Bare))
(defprotocol Sz (size (self) -> i64))
(impl Sz Pt (size (self) 1))
(impl Sz Hidden (size (self) 10))
(defun make (n: i64) -> Pt (Pt n))
(defun hidden (n: i64) -> i64 (let ((h (Hidden n))) (+ (. h n) (size h))))
(defun get-x (p: Pt) -> i64 (. p x))
(defun wrapped (n: i64) -> (Wrap Pt) (Wrap (Pt n)))
(defun shape (n: i64) -> Shape (if (> n 0) (Dot (Pt n)) Bare))
(defun of-shape (s: Shape) -> i64 (match s ((Dot p) (. p x)) ((Bare) 0)))
