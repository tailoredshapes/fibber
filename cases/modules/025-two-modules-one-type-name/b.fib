(ns b)
(defstruct Pt (x: i64 y: i64))
(defstruct Hidden :private (n: str m: i64))
(defstruct (Wrap t) (w: i64 v: t))
(defenum Shape (Dot p: Pt q: Pt) (Bare) (Other))
(defprotocol Sz (size (self) -> i64))
(impl Sz Pt (size (self) 2))
(impl Sz Hidden (size (self) 20))
(defun make (n: i64) -> Pt (Pt n (* 2 n)))
(defun hidden (n: i64) -> i64 (let ((h (Hidden "ab" n))) (+ (. h m) (+ (size h) (str-len (. h n))))))
(defun get-x (p: Pt) -> i64 (+ (. p x) (. p y)))
(defun wrapped (n: i64) -> (Wrap Pt) (Wrap 7 (Pt n n)))
(defun shape (n: i64) -> Shape (if (> n 0) (Dot (Pt n 1) (Pt 2 3)) Other))
(defun of-shape (s: Shape) -> i64 (match s ((Dot p q) (+ (. p y) (. q y))) ((Bare) 0) ((Other) 100)))
