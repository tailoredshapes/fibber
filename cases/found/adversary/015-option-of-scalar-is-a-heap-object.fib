;; spec:   §1, §6 (types §1.5, §6.11, §8.1, §8.3)
;; expect: accept
;; result: 1129
;; audit:  clean
;; types §8.1: "(Option T), T a scalar, a dyn, or itself an (Option ..)
;; | ptr to a heap enum object: tag and payload (§8.3; v1)", and §8.3:
;; "Every other Option (§8.1) is an ordinary heap enum with tag 0 = nil,
;; 1 = some"; §6.11: "an Option value is never itself a stack candidate".
;; So every (some 5), (some nil) and nil of such a type below is a
;; counted heap object, and each must be released exactly once: stored
;; in a cell and replaced by set!, stored in an atom and replaced by
;; swap!, held in a vector, captured by a closure, built by the
;; prelude's generic iterator (next : (Option a) at a = i64) and
;; matched through nested patterns. 5 + 100 + 3 + 7 + 11 + 3 + 1000 =
;; 1129.
;;
;; Observed before the fix (fibref run):
;;   result: 1129
;;   audit:  clean=true leak-cycles=0 leaks=0 errors=0
;; which says nothing, and is why this case passed then too: the
;; result cannot tell the representations apart. The plan gave every
;; Option constructor Alloc::Nothing and the evaluator built (some 5)
;; as an unboxed Val::Some(Int 5), so none of these objects existed for
;; the audit to check (method.md rule 2), and the counts the plan
;; planned on them were no-ops. Now the plan decides the representation by the type
;; (own/objects.rs option_rep), the evaluator allocates the heap enum
;; (eval/option.rs), and this case checks those counts; the unit test
;; eval::tests::options::a_some_of_a_scalar_allocates_a_heap_object
;; checks that the objects are allocated at all.
(defun first-even (v: (Vec i64)) -> (Option i64)
  (next (filter-iter (iter v) even?)))

(defun main () -> i64
  (let ((c (cell (some 1)))
        (a (atom (some 2)))
        (n (some nil))
        (x (some (some 3)))
        (os [(some 7) nil (some 4)])
        (k (let ((o (some 11))) (fn () (match o ((some v) v) (nil 0))))))
    (do (set! c (some 5))
        (swap! a (fn (o) (match o ((some v) (some (+ v 1))) (nil (some 10)))))
        (+ (match @c ((some v) v) (nil 0))
           (+ (match n ((some nil) 100) ((some (some _)) 1) (nil 2))
              (+ (match x ((some (some v)) v) (_ 0))
                 (+ (match (nth os 0) ((some v) v) (nil 0))
                    (+ (k)
                       (+ (match @a ((some v) v) (nil 0))
                          (match (first-even [1 3 4 6])
                            ((some 4) 1000) (_ 0)))))))))))
