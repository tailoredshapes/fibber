;; spec:   §6 (types §2.11, §4.4, §8.1, §8.7)
;; expect: accept
;; result: 1
;; audit:  clean
;; A weak reference to a (dyn Show) value. It type-checks: "(Object a) is
;; the built-in structural predicate 'a is not a scalar'" (types §2.11)
;; and (dyn P) is an object type (types §1.2). While b is alive,
;; (deref w) is (some d) and (show d) is "A", so main returns 1.
;;
;; Observed (fibref run):
;;   result: 1
;;   audit:  clean=true leak-cycles=0 leaks=0 errors=0
;; fibref is right; the finding is in the spec's compiled mapping, which
;; cannot produce this result (method.md rule 6):
;;   types §8.1: "(dyn P) | { ptr ptr } by value: object, vtable";
;;   types §8.7: "(defstruct fib.weakbox (i64 i32 i32  i32  ptr)) ;
;;   header ..., lock, target" and "@w: ... return t or nil".
;; The box keeps one pointer, so @w on a (Weak (dyn P)) can return the
;; object but not the vtable, which (Weak (dyn P)) does not determine;
;; §8.6 widens a cell for a dyn content ("four words for a (dyn P)") and
;; §8.1 gives (Option (dyn P)) a heap enum, but §8.7 says nothing for
;; Weak. Diagnosis: spec (types §8.7 incomplete, or (Object a) should
;; exclude dyn, as Send already does for v1).
(defstruct A (n: i64))
(impl Show A (show (self) "A"))

(defun main () -> i64
  (let ((b (A 3)) (w (weak (dyn Show b))))
    (match @w ((some d) (str-len (show d))) (nil 0))))
