;; spec:   syntax §3.16 (reflection at expansion time), §4.4
;; expect: accept
;; result: 2
;; audit:  clean
;; A user macro calling struct-fields on a struct defined earlier:
;;   syntax §3.16: "Reflection at expansion time (Decided ...), for a
;;   struct Name defined earlier in the module or imported:
;;   (struct-fields 'Name) | (Vec Form): the field names as Syms, in
;;   order". The macro expands to the literal 2.
;;
;; Observed (fibref run):
;;   rejected:
;;   011-struct-reflection-in-user-macro.fib:29:23: macro nfields failed:
;;   011-struct-reflection-in-user-macro.fib:27:38: internal error: no
;;   string builtin struct-fields
;; struct?, struct-params and struct-field-types fail the same way
;; ("no string builtin struct?", ...). Only the expander's own derive,
;; which does not go through the evaluator, can reflect on a struct.
;; Diagnosis: eval (crates/fibref/src/eval/native.rs, Interp::builtin:
;; the arm `name if name.starts_with("str") || ...` sends every builtin
;; whose name starts with "str", struct? and struct-* included, to the
;; string builtins before the arm for the expansion builtins is reached).
;; At run time (outside a macro) the same call gives the same internal
;; error instead of "struct-fields is available only at expansion time".
(defstruct P (a: i64 b: str))

(defmacro nfields (name) (Int (count (struct-fields name)) :i64))

(defun main () -> i64 (nfields P))
