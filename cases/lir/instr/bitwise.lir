;; expect: accept
;; out: and 240
;; out: or 65520
;; out: xor 65280
;; out: shl 986880
;; out: lshr 15
;; out: ashr -4
;; out: ctpop32 8
;; out: ctpop64 64
;; out: i1and 0
;; out: i1or 1
;; out: i1xor 0
;; out: ctpopv 1 2 3 32
;; ir: llvm.ctpop.i32
(declare printf i32 (ptr ...))
(define (show void) ((ptr tag) (i64 v))
  (block entry (call @printf (string "%s %lld\n") tag v) (ret)))
(define (ops void) ((i32 a) (i32 b) (i32 m) (i64 w) (i1 t) (i1 f))
  (block entry
    (call @show (string "and") (sext i64 (and a b)))
    (call @show (string "or") (sext i64 (or a b)))
    (call @show (string "xor") (sext i64 (xor a b)))
    (call @show (string "shl") (sext i64 (shl a (i32 4))))
    (call @show (string "lshr") (sext i64 (lshr m (i32 28))))
    (call @show (string "ashr") (sext i64 (ashr m (i32 2))))
    (call @show (string "ctpop32") (sext i64 (ctpop a)))
    (call @show (string "ctpop64") (ctpop w))
    (call @show (string "i1and") (zext i64 (and t f)))
    (call @show (string "i1or") (zext i64 (or t f)))
    (call @show (string "i1xor") (zext i64 (xor t t)))
    (let ((v (ctpop (<4 x i32> 1 3 7 -1))))
      (call @printf (string "ctpopv %d %d %d %d\n") (extractelement v (i32 0)) (extractelement v (i32 1))
            (extractelement v (i32 2)) (extractelement v (i32 3)))
      (ret))))
(define (main i32) ()
  (block entry
    (call @ops (i32 61680) (i32 4080) (i32 -16) (i64 -1) (i1 1) (i1 0))
    (ret (i32 0))))
