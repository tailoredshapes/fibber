;; expect: accept
;; out: trunc -1
;; out: zext 255
;; out: sext -2
;; out: fptrunc 2.5
;; out: fptosi -42
;; out: fptoui 42
;; out: sitofp -7
;; out: uitofp 255
;; out: ptr 4096
;; out: bitcast 4607182418800017408 2 1065353216
;; out: bitcastv 3 5
(declare printf i32 (ptr ...))
(define (conv void) ((i32 x511) (i8 m1) (i16 m2) (double d25) (double d429) (double dm429) (i32 m7) (i64 addr) (i64 packed))
  (block entry
    (call @printf (string "trunc %lld\n") (sext i64 (trunc i8 x511)))
    (call @printf (string "zext %lld\n") (zext i64 m1))
    (call @printf (string "sext %lld\n") (sext i64 m2))
    (call @printf (string "fptrunc %.17g\n") (fpext double (fptrunc float d25)))
    (call @printf (string "fptosi %d\n") (fptosi i32 dm429))
    (call @printf (string "fptoui %d\n") (fptoui i32 d429))
    (call @printf (string "sitofp %.17g\n") (sitofp double m7))
    (call @printf (string "uitofp %.17g\n") (uitofp double m1))
    (call @printf (string "ptr %lld\n") (ptrtoint i64 (inttoptr ptr addr)))
    (call @printf (string "bitcast %lld %.17g %d\n") (bitcast i64 (double 1.0))
      (bitcast double (i64 4611686018427387904)) (bitcast i32 (float 1.0)))
    (let ((v (bitcast <2 x i32> packed)))
      (call @printf (string "bitcastv %d %d\n") (extractelement v (i32 0)) (extractelement v (i32 1)))
      (ret))))
(define (main i32) ()
  (block entry
    (call @conv (i32 511) (i8 -1) (i16 -2) (double 2.5) (double 42.9) (double -42.9) (i32 -7) (i64 4096) (i64 21474836483))
    (ret (i32 0))))
