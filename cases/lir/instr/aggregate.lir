;; expect: accept
;; out: anon 7 8
;; out: named 1 -2 3
;; out: nested 5 6 7
;; out: insert 9 6 70
;; out: fromvalues 41 1
(declare printf i32 (ptr ...))
(defstruct pair (i64 i32 i8))
(defstruct outer (i64 %struct.inner))
(defstruct inner (i32 i8))
(define (mk %struct.pair) ((i64 a))
  (block entry (ret (%struct.pair a (i32 -2) (i8 3)))))
(define (mk2 { i64, i1 }) ((i64 a) (i1 b))
  (block entry (ret { a b })))
(define (main i32) ()
  (block entry
    (let ((s { (i64 7) (i64 8) }))
      (call @printf (string "anon %lld %lld\n") (extractvalue s 0) (extractvalue s 1)))
    (let ((p (call @mk (i64 1))))
      (call @printf (string "named %lld %d %d\n") (extractvalue p 0) (extractvalue p 1) (sext i32 (extractvalue p 2))))
    (let ((o (%struct.outer (i64 5) (%struct.inner (i32 6) (i8 7)))))
      (call @printf (string "nested %lld %d %d\n") (extractvalue o 0) (extractvalue o 1 0) (sext i32 (extractvalue o 1 1)))
      (let ((o2 (insertvalue (insertvalue o (i64 9) 0) (i8 70) 1 1)))
        (call @printf (string "insert %lld %d %d\n") (extractvalue o2 0) (extractvalue o2 1 0) (sext i32 (extractvalue o2 1 1)))))
    (let ((r (call @mk2 (i64 41) (i1 1))))
      (call @printf (string "fromvalues %lld %d\n") (extractvalue r 0) (zext i32 (extractvalue r 1)))
      (ret (i32 0)))))
