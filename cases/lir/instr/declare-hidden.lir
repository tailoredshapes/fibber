;; expect: accept
;; exit: 4
;; paths: jit
;; ir: declare hidden i64 @strlen(
;; spec/lir.md §4.3: a declare takes hidden. Only the JIT path: the
;; linker refuses a hidden reference to a symbol of a shared library.
(declare hidden strlen i64 (ptr))
(define (main i32) () (block entry (ret (trunc i32 (call @strlen (string "four"))))))
