;; expect: accept
;; out: [tab	quote" backslash\ A]
;; out: len 1 6
;; out: bytes 255 0
(declare printf i32 (ptr ...))
(declare strlen i64 (ptr))
(define (main i32) ()
  (block entry
    (call @printf (string "[tab\tquote\" backslash\\ \x41]\n"))
    (call @printf (string "len %lld %lld\n") (call @strlen (string "a\0b")) (call @strlen (string "héllo")))
    (let ((s (string "\xff")))
      (call @printf (string "bytes %d %d\n") (zext i32 (load i8 s)) (zext i32 (load i8 (getelementptr i8 s (i64 1)))))
      (ret (i32 0)))))
