;; expect: accept
;; exit: 4
;; out: environ ok
;; ir: @stderr = external global ptr
;; spec/lir.md §4.4: variables the C library defines. fprintf returns
;; the number of bytes written to stderr, which is the exit status.
(declare fprintf i32 (ptr ptr ...))
(declare fflush i32 (ptr))
(declare printf i32 (ptr ...))
(declare-global stderr ptr)
(declare-global environ ptr)
(define (main i32) ()
  (block entry
    (call @printf (string "environ %s\n")
      (select (icmp ne (load ptr @environ) (ptr null)) (string "ok") (string "null")))
    (let ((n (call @fprintf (load ptr @stderr) (string "err\n"))))
      (call @fflush (load ptr @stderr))
      (ret n))))
