;; expect: accept
;; out: scalar 10 20
;; out: ptr 1 0
;; out: pair 2 1
;; out: vec 1 20 3 40
(declare printf i32 (ptr ...))
(define (pick i64) ((i1 c)) (block entry (ret (select c (i64 10) (i64 20)))))
(define (main i32) ()
  (block entry
    (call @printf (string "scalar %lld %lld\n") (call @pick (i1 1)) (call @pick (i1 0)))
    (let ((a (alloca i64))
          (b (alloca i64))
          (c (icmp eq (ptrtoint i64 a) (ptrtoint i64 a)))
          (p (select c a b))
          (pr1 { a b })
          (pr2 { b a })
          (pr (select c pr2 pr1)))
      (call @printf (string "ptr %d %d\n") (zext i32 (icmp eq p a)) (zext i32 (icmp eq p b)))
      (call @printf (string "pair %d %d\n")
        (select (icmp eq (extractvalue pr 0) b) (i32 2) (i32 0))
        (select (icmp eq (extractvalue pr 1) a) (i32 1) (i32 0)))
      (let ((v (select (<4 x i1> 1 0 1 0) (<4 x i32> 1 2 3 4) (<4 x i32> 10 20 30 40))))
        (call @printf (string "vec %d %d %d %d\n") (extractelement v (i32 0)) (extractelement v (i32 1))
          (extractelement v (i32 2)) (extractelement v (i32 3)))
        (ret (i32 0))))))
