;; expect: accept
;; stage: 2
;; out: distinct 1
;; ir: @.str.1 = private constant [3 x i8] c"hi\00"
;; ir: @.str.2 = private constant [3 x i8] c"hi\00"
;; ir-not: unnamed_addr
;; spec/lir.md 3: each (STRING ..) occurrence is its own constant, so two equal strings have two addresses on both paths (the AOT path at
;; -O2: LLVM merges only unnamed_addr constants, and lair writes none).
(DECLARE printf I32 (PTR ...))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "distinct %d\n") (ZEXT I32 (ICMP NE (STRING "hi") (STRING "hi"))))
    (RET (I32 0))))
