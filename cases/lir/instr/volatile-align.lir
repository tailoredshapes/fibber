;; expect: accept
;; out: aligned 0 0
;; out: volatile 7 8
;; ir: load volatile i64
;; ir: store volatile i64
;; ir: alloca i64, align 64
;; ir: alloca [3 x i8], align 4096
;; ir: store i64 8, ptr %big, align 16
;; ir: load i64, ptr %big, align 1
;; spec/lir.md §6.5: volatile accesses and explicit alignments.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (let ((v (alloca i64))
          (big (alloca (align 64) i64))
          (page (alloca (align 4096) [3 x i8])))
      (call @printf (string "aligned %lld %lld\n")
        (urem (ptrtoint i64 big) (i64 64)) (urem (ptrtoint i64 page) (i64 4096)))
      (store volatile (i64 7) v)
      (store (align 16) (i64 8) big)
      (call @printf (string "volatile %lld %lld\n") (load volatile i64 v) (load (align 1) i64 big))
      (ret (i32 0)))))
