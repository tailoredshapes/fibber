;; expect: accept
;; out: fadd 5.5
;; out: fsub 9.5
;; out: fmul -15
;; out: fdiv -3.75
;; out: frem 1.5
;; out: fneg -7.5
;; out: fadd.f 1.75
;; out: fsub.f 1.25
;; out: fmul.f 0.375
;; out: fdiv.f 6
;; out: frem.f 0
;; out: fneg.f -1.5
;; out: inf inf
;; out: fneg0 -0
(declare printf i32 (ptr ...))
(define (show void) ((ptr tag) (double v))
  (block entry (call @printf (string "%s %.17g\n") tag v) (ret)))
(define (opsd void) ((double a) (double b))
  (block entry
    (call @show (string "fadd") (fadd a b))
    (call @show (string "fsub") (fsub a b))
    (call @show (string "fmul") (fmul a b))
    (call @show (string "fdiv") (fdiv a b))
    (call @show (string "frem") (frem a b))
    (call @show (string "fneg") (fneg a))
    (ret)))
(define (opsf void) ((float a) (float b))
  (block entry
    (call @show (string "fadd.f") (fpext double (fadd a b)))
    (call @show (string "fsub.f") (fpext double (fsub a b)))
    (call @show (string "fmul.f") (fpext double (fmul a b)))
    (call @show (string "fdiv.f") (fpext double (fdiv a b)))
    (call @show (string "frem.f") (fpext double (frem a b)))
    (call @show (string "fneg.f") (fpext double (fneg a)))
    (ret)))
(define (div double) ((double a) (double b)) (block entry (ret (fdiv a b))))
(define (main i32) ()
  (block entry
    (call @opsd (double 7.5) (double -2.0))
    (call @opsf (float 1.5) (float 0.25))
    (call @show (string "inf") (call @div (double 1.0) (double 0.0)))
    (call @show (string "fneg0") (fneg (call @div (double 0.0) (double 1.0))))
    (ret (i32 0))))
