;; expect: accept
;; signal: SIGILL, SIGTRAP
;; out: before
;; ir: call void @llvm.trap()
;; spec/lir.md §6.7: (trap) is llvm.trap, which kills the process with
;; the target's trap signal (ud2 raises SIGILL on x86-64; brk raises
;; SIGTRAP on AArch64) without flushing, so the output is flushed
;; first. The block goes on to unreachable.
(declare printf i32 (ptr ...))
(declare fflush i32 (ptr))
(define (main i32) ()
  (block entry
    (call @printf (string "before\n"))
    (call @fflush (ptr null))
    (trap)
    (unreachable)))
