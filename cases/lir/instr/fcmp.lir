;; expect: accept
;; out: nan oeq 0 one 0 olt 0 ole 0 ogt 0 oge 0 ord 0 ueq 1 une 1 ult 1 ule 1 ugt 1 uge 1 uno 1
;; out: num oeq 0 one 1 olt 1 ole 1 ogt 0 oge 0 ord 1 ueq 0 une 1 ult 1 ule 1 ugt 0 uge 0 uno 0
;; out: float olt 1 oeq 1
(declare printf i32 (ptr ...))
(define (b i32) ((i1 x)) (block entry (ret (zext i32 x))))
(define (all void) ((ptr tag) (double x) (double y))
  (block entry
    (call @printf (string "%s oeq %d one %d olt %d ole %d ogt %d oge %d ord %d ueq %d une %d ult %d ule %d ugt %d uge %d uno %d\n") tag
      (call @b (fcmp oeq x y)) (call @b (fcmp one x y)) (call @b (fcmp olt x y)) (call @b (fcmp ole x y))
      (call @b (fcmp ogt x y)) (call @b (fcmp oge x y)) (call @b (fcmp ord x y)) (call @b (fcmp ueq x y))
      (call @b (fcmp une x y)) (call @b (fcmp ult x y)) (call @b (fcmp ule x y)) (call @b (fcmp ugt x y))
      (call @b (fcmp uge x y)) (call @b (fcmp uno x y)))
    (ret)))
(define (fl void) ((float x) (float y))
  (block entry
    (call @printf (string "float olt %d oeq %d\n") (call @b (fcmp olt x y)) (call @b (fcmp oeq y y)))
    (ret)))
(define (main i32) ()
  (block entry
    (call @all (string "nan") (double 1.0) (double nan))
    (call @all (string "num") (double 1.0) (double 2.0))
    (call @fl (float 0.5) (float 0.75))
    (ret (i32 0))))
