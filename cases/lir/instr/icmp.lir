;; expect: accept
;; out: eq 0 ne 1 slt 1 sle 1 sgt 0 sge 0 ult 0 ule 0 ugt 1 uge 1
;; out: null 0 1 1
;; out: ptrord 1 0
;; out: vec 1 0 0 1
(declare printf i32 (ptr ...))
(define (b i32) ((i1 x)) (block entry (ret (zext i32 x))))
(define (ints void) ((i32 x) (i32 y))
  (block entry
    (call @printf (string "eq %d ne %d slt %d sle %d sgt %d sge %d ult %d ule %d ugt %d uge %d\n")
      (call @b (icmp eq x y)) (call @b (icmp ne x y)) (call @b (icmp slt x y)) (call @b (icmp sle x y))
      (call @b (icmp sgt x y)) (call @b (icmp sge x y)) (call @b (icmp ult x y)) (call @b (icmp ule x y))
      (call @b (icmp ugt x y)) (call @b (icmp uge x y)))
    (ret)))
(define (ptrs void) ((ptr p) (ptr n))
  (block entry
    (call @printf (string "null %d %d %d\n") (call @b (icmp eq p n)) (call @b (icmp ne p n)) (call @b (icmp eq n (ptr null))))
    (let ((q (getelementptr i8 p (i64 1))))
      (call @printf (string "ptrord %d %d\n") (call @b (icmp ult p q)) (call @b (icmp ugt p q)))
      (ret))))
(define (main i32) ()
  (block entry
    (call @ints (i32 -1) (i32 1))
    (let ((s (alloca i64)))
      (call @ptrs s (ptr null)))
    (let ((v (icmp slt (<4 x i32> 1 5 9 -3) (<4 x i32> 2 2 2 2))))
      (call @printf (string "vec %d %d %d %d\n") (call @b (extractelement v (i32 0))) (call @b (extractelement v (i32 1)))
        (call @b (extractelement v (i32 2))) (call @b (extractelement v (i32 3))))
      (ret (i32 0)))))
