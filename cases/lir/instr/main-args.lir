;; expect: accept
;; exit: 1
;; out: argv0 ok
;; main with (i32 argc) (ptr argv): run with no arguments, argc is 1.
(declare printf i32 (ptr ...))
(define (main i32) ((i32 argc) (ptr argv))
  (block entry
    (br (icmp ne (load ptr argv) (ptr null)) ok bad))
  (block ok
    (call @printf (string "argv0 ok\n"))
    (ret argc))
  (block bad
    (ret (i32 99))))
