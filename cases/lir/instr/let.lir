;; expect: accept
;; out: 9 30 12 7
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (let ((x (add (i32 1) (i32 2))))
      (let ((a (i32 10))
            (b (add a (i32 20))))
        (let ((sq (mul x x))
              (inner (add (let ((t (i32 5))) (add t (i32 7))) (i32 0))))
          (br next)))))
  (block next
    (call @printf (string "%d %d %d %d\n") sq b inner (add x (i32 4)))
    (ret (i32 0))))
