;; expect: accept
;; out: add8 -93
;; out: sub8 -107
;; out: mul8 68
;; out: sdiv8 -14
;; out: udiv8 22
;; out: srem8 -2
;; out: urem8 2
;; out: add16 600
;; out: mul16 24464
;; out: add32 -2147483648
;; out: sub32 2147483646
;; out: add64 999999994
;; out: sub64 1000000020
;; out: mul64 -13000000091
;; out: sdiv64 -76923077
;; out: udiv64 0
;; out: srem64 6
;; out: urem64 1000000007
;; Integer arithmetic at every width, through parameters so that the
;; JIT path (no optimisation) runs the instructions themselves.
(declare printf i32 (ptr ...))
(define (show void) ((ptr tag) (i64 v))
  (block entry (call @printf (string "%s %lld\n") tag v) (ret)))
(define (ops8 void) ((i8 a) (i8 b))
  (block entry
    (call @show (string "add8") (sext i64 (add a b)))
    (call @show (string "sub8") (sext i64 (sub a b)))
    (call @show (string "mul8") (sext i64 (mul a b)))
    (call @show (string "sdiv8") (sext i64 (sdiv a b)))
    (call @show (string "udiv8") (zext i64 (udiv a b)))
    (call @show (string "srem8") (sext i64 (srem a b)))
    (call @show (string "urem8") (zext i64 (urem a b)))
    (ret)))
(define (ops16 void) ((i16 a) (i16 b))
  (block entry
    (call @show (string "add16") (sext i64 (add a b)))
    (call @show (string "mul16") (sext i64 (mul a b)))
    (ret)))
(define (ops32 void) ((i32 a) (i32 b))
  (block entry
    (call @show (string "add32") (sext i64 (add a b)))
    (call @show (string "sub32") (sext i64 (sub a b)))
    (ret)))
(define (ops64 void) ((i64 a) (i64 b))
  (block entry
    (call @show (string "add64") (add a b))
    (call @show (string "sub64") (sub a b))
    (call @show (string "mul64") (mul a b))
    (call @show (string "sdiv64") (sdiv a b))
    (call @show (string "udiv64") (udiv a b))
    (call @show (string "srem64") (srem a b))
    (call @show (string "urem64") (urem a b))
    (ret)))
(define (main i32) ()
  (block entry
    (call @ops8 (i8 -100) (i8 7))
    (call @ops16 (i16 300) (i16 300))
    (call @ops32 (i32 2147483647) (i32 1))
    (call @ops64 (i64 1000000007) (i64 -13))
    (ret (i32 0))))
