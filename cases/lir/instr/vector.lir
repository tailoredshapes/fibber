;; expect: accept
;; out: add 11 22 33 44
;; out: insert 1 2 99 4
;; out: shuffle 4 40 1 10
;; out: fadd 1.5 4.25
;; out: dyn 30
;; out: ptrvec 1 1
(declare printf i32 (ptr ...))
(define (vadd <4 x i32>) ((<4 x i32> a) (<4 x i32> b)) (block entry (ret (add a b))))
(define (pr void) ((ptr tag) (<4 x i32> v))
  (block entry
    (call @printf (string "%s %d %d %d %d\n") tag (extractelement v (i32 0)) (extractelement v (i32 1))
      (extractelement v (i32 2)) (extractelement v (i32 3)))
    (ret)))
(define (at i32) ((<4 x i32> v) (i64 i)) (block entry (ret (extractelement v i))))
(define (main i32) ()
  (block entry
    (let ((a (<4 x i32> 1 2 3 4))
          (b (<4 x i32> 10 20 30 40)))
      (call @pr (string "add") (call @vadd a b))
      (call @pr (string "insert") (insertelement a (i32 99) (i32 2)))
      (call @pr (string "shuffle") (shufflevector a b (<4 x i32> 3 7 0 4)))
      (let ((d (fadd (<2 x double> 0.5 1.25) (<2 x double> 1.0 3.0))))
        (call @printf (string "fadd %.17g %.17g\n") (extractelement d (i32 0)) (extractelement d (i32 1))))
      (call @printf (string "dyn %d\n") (call @at b (i64 2)))
      (let ((s (alloca i64))
            (pv (insertelement (<2 x ptr> null null) s (i32 1)))
            (e (extractelement pv (i32 1))))
        (call @printf (string "ptrvec %d %d\n") (zext i32 (icmp eq e s)) (zext i32 (icmp eq (extractelement pv (i32 0)) (ptr null))))
        (ret (i32 0))))))
