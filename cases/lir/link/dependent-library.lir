;; expect: accept
;; stage: 2
;; out: crc 891568578
;; ir: !llvm.dependent-libraries = !{!0}
;; ir: !0 = !{!"z"}
;; spec/lir.md 4.9: the module names zlib with a dependent-library form and nothing else (no comment, no -l): lair lowers the form to LLVM's
;; `!llvm.dependent-libraries` and links `-lz` from it (the AOT path), and loads libz into the process before the JIT looks for crc32.
;; crc32(0, "abc", 3) is 0x352441C2.
(dependent-library "z")
(declare printf i32 (ptr ...))
(declare crc32 i64 (i64 ptr i32))
(define (main i32) ()
  (block entry
    (call @printf (string "crc %lld\n") (call @crc32 (i64 0) (string "abc") (i32 3)))
    (ret (i32 0))))
