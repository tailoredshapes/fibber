;; expect: accept
;; own: verify
;; out: alloc 4 size 32
;; out: retain 4 -> 2
;; out: count 2
;; out: free 4
;; spec/lir.md 6.14.4: addrspacecast both ways and the header inside unsafe defines; the value made of a ptr is none and may be returned.
(declare printf i32 (ptr ...))
(declare malloc ptr (i64))
(declare free void (ptr))
(defstruct hdr (i64 i32 i32))
(defstruct box (%struct.hdr i64 (ptr 1)))
(ownership (retain @rt.retain) (release @rt.release) (unique @rt.unique) (alloc @rt.alloc) (stack-init @rt.stack-init) (stack-end @rt.stack-end) (header %struct.hdr))
(define unsafe internal (rt.alloc ptr) ((i64 size) (i32 tid))
  (block entry
    (let ((p (call @malloc size)))
      (store (i64 1) (getelementptr %struct.hdr p (i32 0) (i32 0)))
      (store tid (getelementptr %struct.hdr p (i32 0) (i32 1)))
      (store (i32 0) (getelementptr %struct.hdr p (i32 0) (i32 2)))
      (call @printf (string "alloc %d size %lld\n") tid size)
      (ret p))))
(define unsafe internal (rt.retain void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done inc))
  (block inc
    (let ((c (getelementptr %struct.hdr p (i32 0) (i32 0))))
      (store (add (load i64 c) (i64 1)) c)
      (call @printf (string "retain %d -> %lld\n") (load i32 (getelementptr %struct.hdr p (i32 0) (i32 1))) (load i64 c))
      (ret)))
  (block done (ret)))
(define unsafe internal (rt.release void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done dec))
  (block dec
    (let ((c (getelementptr %struct.hdr p (i32 0) (i32 0)))
          (n (sub (load i64 c) (i64 1))))
      (store n c)
      (br (icmp eq n (i64 0)) gone done)))
  (block gone
    (call @printf (string "free %d\n") (load i32 (getelementptr %struct.hdr p (i32 0) (i32 1))))
    (call @free p)
    (ret))
  (block done (ret)))
(define unsafe internal (rt.unique i1) ((ptr p))
  (block entry (ret (icmp eq (load i64 (getelementptr %struct.hdr p (i32 0) (i32 0))) (i64 1)))))
(define unsafe internal (rt.stack-init void) ((ptr p) (i32 tid))
  (block entry
    (store (i64 0) (getelementptr %struct.hdr p (i32 0) (i32 0)))
    (store tid (getelementptr %struct.hdr p (i32 0) (i32 1)))
    (store (i32 4) (getelementptr %struct.hdr p (i32 0) (i32 2)))
    (ret)))
(define unsafe internal (rt.stack-end void) ((ptr p))
  (block entry
    (call @printf (string "stack-end %d\n") (load i32 (getelementptr %struct.hdr p (i32 0) (i32 1))))
    (ret)))
(define internal (peek i64) (((ptr 1) b))
  (block entry (ret (load i64 (getelementptr %struct.box b (i32 0) (i32 1))))))
(define unsafe internal (wrap (ptr 1)) ((i64 v))
  (block entry
    (let ((p (call @rt.alloc (i64 32) (i32 4)))
          (m (addrspacecast (ptr 1) p)))
      (store v (getelementptr %struct.box p (i32 0) (i32 1)))
      (store (ptr null) (getelementptr %struct.box p (i32 0) (i32 2)))
      (ret m))))
(define unsafe internal (count i64) (((ptr 1) b))
  (block entry (ret (load i64 (getelementptr %struct.hdr (addrspacecast ptr b) (i32 0) (i32 0))))))
(define (main i32) ()
  (block entry
    (let ((w (call @wrap (i64 5)))
          (c (copy-value w)))
      (call @printf (string "count %lld\n") (call @count w))
      (destroy-value c)
      (destroy-value w)
      (ret (i32 0)))))
