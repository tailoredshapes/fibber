;; expect: accept
;; own: verify
;; out: alloc 7 size 32
;; out: free 7
;; ir: call void @rt.release(ptr
;; spec/lir.md 4.7, 6.14.6: the importer uses the forms without an ownership form of its own: the imported module's is in its interface.
(import "import-base.lir")
(define (main i32) ()
  (block entry
    (let ((x (alloc-object %struct.box (i32 7))))
      (store init ((ptr 1) null) (getelementptr %struct.box x (i32 0) (i32 2)))
      (destroy-value x)
      (ret (i32 0)))))
