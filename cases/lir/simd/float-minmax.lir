;; expect: accept
;; stage: 2
;; ir: call <4 x double> @llvm.minimum.v4f64
;; ir: call <4 x double> @llvm.maximum.v4f64
;; ir: call <4 x double> @llvm.minnum.v4f64
;; ir: call <4 x double> @llvm.maxnum.v4f64
;; out: fmin 1 -999 -0 -0
;; out: fmin-lanes 1 -999 -0 -0
;; out: fmax 2 -999 0 0
;; out: fmax-lanes 2 -999 0 0
;; out: fminnum 1 3 5 -999
;; out: fminnum-lanes 1 3 5 -999
;; out: fmaxnum 2 3 5 -999
;; out: fmaxnum-lanes 2 3 5 -999
;; fmin/fmax propagate NaN and order -0.0 below +0.0; fminnum/fmaxnum return the other operand for a NaN (all-NaN lane: NaN prints -999)

(declare printf i32 (ptr ...))
(define (opq_4xdouble <4 x double>) ((<4 x double> v))
  (block entry
    (let ((s (alloca <4 x double>)))
      (store volatile v s)
      (ret (load volatile <4 x double> s)))))
(define (p_4xdouble void) ((ptr tag) (<4 x double> v))
  (block entry
    (let ((dv v) (fv (select (fcmp uno dv dv) (<4 x double> -999.0 -999.0 -999.0 -999.0) dv)))
      (call @printf (string "%s %.17g %.17g %.17g %.17g\n") tag (extractelement fv (i32 0)) (extractelement fv (i32 1)) (extractelement fv (i32 2)) (extractelement fv (i32 3)))
      (ret))))
(define (main i32) ()
  (block entry
    (let ()
      (call @p_4xdouble (string "fmin") (fmin (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0))))
      (call @p_4xdouble (string "fmin-lanes") (insertelement (insertelement (insertelement (insertelement (zeroinitializer <4 x double>) (fmin (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 0)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 0))) (i32 0)) (fmin (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 1)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 1))) (i32 1)) (fmin (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 2)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 2))) (i32 2)) (fmin (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 3)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 3))) (i32 3)))
      (call @p_4xdouble (string "fmax") (fmax (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0))))
      (call @p_4xdouble (string "fmax-lanes") (insertelement (insertelement (insertelement (insertelement (zeroinitializer <4 x double>) (fmax (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 0)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 0))) (i32 0)) (fmax (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 1)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 1))) (i32 1)) (fmax (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 2)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 2))) (i32 2)) (fmax (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 0.0 -0.0)) (i32 3)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 -0.0 0.0)) (i32 3))) (i32 3)))
      (call @p_4xdouble (string "fminnum") (fminnum (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan))))
      (call @p_4xdouble (string "fminnum-lanes") (insertelement (insertelement (insertelement (insertelement (zeroinitializer <4 x double>) (fminnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 0)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 0))) (i32 0)) (fminnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 1)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 1))) (i32 1)) (fminnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 2)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 2))) (i32 2)) (fminnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 3)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 3))) (i32 3)))
      (call @p_4xdouble (string "fmaxnum") (fmaxnum (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan))))
      (call @p_4xdouble (string "fmaxnum-lanes") (insertelement (insertelement (insertelement (insertelement (zeroinitializer <4 x double>) (fmaxnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 0)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 0))) (i32 0)) (fmaxnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 1)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 1))) (i32 1)) (fmaxnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 2)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 2))) (i32 2)) (fmaxnum (extractelement (call @opq_4xdouble (<4 x double> 1.0 nan 5.0 nan)) (i32 3)) (extractelement (call @opq_4xdouble (<4 x double> 2.0 3.0 nan nan)) (i32 3))) (i32 3)))
