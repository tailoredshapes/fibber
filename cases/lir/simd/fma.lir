;; ir: call <4 x float> @llvm.fma.v4f32
;; ir: call double @llvm.fma.f64
;; out: fma 5.5511151231257827e-17 2 13 0
;; out: fma-lanes 5.5511151231257827e-17 2 13 0
;; out: fma-contract 5.5511151231257827e-17 2 13 0
;; out: fma-contract-lanes 5.5511151231257827e-17 2 13 0
;; out: fmuladd 7 2.75 0 -2
;; out: fmuladd-lanes 7 2.75 0 -2
;; out: fma-f32 3.5 2 -11 0
;; out: fma-f32-lanes 3.5 2 -11 0
;; every vector result equals the same instruction on each lane; lane 0 of fma shows the single rounding: 0.1*10-1 is 2^-54, not 0

(declare printf i32 (ptr ...))
(define (opq_4xdouble <4 x double>) ((<4 x double> v))
  (block entry
    (let ((s (alloca <4 x double>)))
      (store volatile v s)
      (ret (load volatile <4 x double> s)))))
(define (p_4xdouble void) ((ptr tag) (<4 x double> v))
  (block entry
    (let ((dv v) (fv (select (fcmp uno dv dv) (<4 x double> -999.0 -999.0 -999.0 -999.0) dv)))
      (call @printf (string "%s %.17g %.17g %.17g %.17g\n") tag (extractelement fv (i32 0)) (extractelement fv (i32 1)) (extractelement fv (i32 2)) (extractelement fv (i32 3)))
      (ret))))
(define (opq_4xfloat <4 x float>) ((<4 x float> v))
