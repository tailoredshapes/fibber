;; expect: accept
;; stage: 2
;; ir: "target-cpu"="x86-64"
;; ir: "target-cpu"="x86-64" "target-features" }
;; out: 3
;; `features` is optional and defaults to the empty string; the target form may stand anywhere among the items.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%d\n") (i32 3))
    (ret (i32 0))))
(target (cpu "x86-64"))
