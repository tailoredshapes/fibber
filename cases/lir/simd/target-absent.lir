;; expect: accept
;; stage: 2
;; ir-not: "target-cpu"
;; ir-not: "target-features"
;; out: 4
;; Without a target form the functions carry no target attributes: the host's CPU and features are used as before.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%d\n") (i32 4))
    (ret (i32 0))))
