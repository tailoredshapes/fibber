;; expect: accept
;; stage: 2
;; ir: "target-cpu"="x86-64-v2"
;; ir: "target-features"="+sse4.2,+popcnt"
;; out: 8 35
;; The module names its target: every defined function carries the two string attributes (the IR text shows them), the JIT checks that the host
;; has the features, and the program runs. compiler/tests/native/p0-target.sh checks that the code generator follows them.
(target (cpu "x86-64-v2") (features "+sse4.2,+popcnt"))
(declare printf i32 (ptr ...))
(define (pop i32) ((i32 x)) (block entry (ret (ctpop x))))
(define (main i32) ()
  (block entry
    (call @printf (string "%d %d\n") (call @pop (i32 255)) (reduce-add (<2 x i32> 20 15)))
    (ret (i32 0))))
