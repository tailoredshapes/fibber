;; out: floor-b-lanes 1 2 3 -4
;; out: ceil-a -2 -1 -0 1
;; out: ceil-a-lanes -2 -1 -0 1
;; out: ceil-b 2 3 4 -3
;; out: ceil-b-lanes 2 3 4 -3
