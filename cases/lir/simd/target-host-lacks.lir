;; expect: reject
;; stage: 2
;; paths: jit
;; error: target: the host does not support +notafeature
;; `lair run` refuses a module whose target has a feature the host lacks (a program that would die of SIGILL); `lair build` may name any target.
(target (cpu "x86-64") (features "+sse2,+notafeature"))
(define (main i32) () (block entry (ret (i32 0))))
