;; expect: accept
;; stage: 2
;; out: stack-addr deeper ok same-frame ok
;; docs/design/stack-check.md 3, spec/lir.md 6.6b: `(stack-addr)` is the stack pointer of the function, an i64. A callee that calls is deeper than its caller (a lower address,
;; by less than a page for these frames); two reads in one function are within a frame of each other.
(declare printf i32 (ptr ...))
(define internal (inner i64) ((i64 n))
  (block entry
    (let ((a (alloca (align 16) i8 (i32 256))))
      (store (i8 1) a)
      (ret (stack-addr)))))
(define internal (outer i64) ()
  (block entry
    (let ((me (stack-addr))
          (a (alloca (align 16) i8 (i32 256)))
          (inside (call @inner (i64 1)))
          (me2 (stack-addr)))
      (store (i8 2) a)
      (ret (select (icmp ult inside me) (sub me inside) (i64 0))))))
(define (main i32) ()
  (block entry
    (let ((d (call @outer))
          (x (stack-addr))
          (y (stack-addr)))
      (call @printf (string "stack-addr deeper %s same-frame %s\n")
            (select (and (icmp ugt d (i64 0)) (icmp ult d (i64 4096))) (string "ok") (string "BAD"))
            (select (icmp eq x y) (string "ok") (string "BAD")))
      (ret (i32 0)))))
