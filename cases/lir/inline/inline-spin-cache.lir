;; expect: accept
;; stage: 2
;; out: inline 12 spin ok line ok
;; ir: alwaysinline
;; docs/design/inline-lir.md: the `inline` modifier, `(spin-hint)` and `(cache-line)`. The line is a power of two between 32 and 256 on every target.
(declare printf i32 (ptr ...))
(define inline internal (twice i64) ((i64 x))
  (block entry (ret (add x x))))
(define internal inline (spin i64) ((i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (loop i2)))
          (i2 (add i (i64 1))))
      (spin-hint)
      (br (icmp slt i2 n) loop done)))
  (block done (ret (i64 1))))
(define inline hidden (line i64) ()
  (block entry (ret (cache-line))))
(define (main i32) ()
  (block entry
    (let ((l (call @line)))
      (call @printf (string "inline %lld spin %s line %s\n") (call @twice (i64 6))
            (select (icmp eq (call @spin (i64 100)) (i64 1)) (string "ok") (string "BAD"))
            (select (and (and (icmp sge l (i64 32)) (icmp sle l (i64 256))) (icmp eq (and l (sub l (i64 1))) (i64 0))) (string "ok") (string "BAD")))
      (ret (i32 0)))))
