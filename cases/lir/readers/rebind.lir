;; expect: accept
;; out: 1
;; out: 2
;; spec/lir.md 4.7: a later binding of the same character replaces the earlier, for the forms after it. ! reads as (i64 1) at first, then as (i64 2).
(declare printf i32 (ptr ...))
(define-reader-macro "!" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (i64 1)))
      (ret l))))
(define (one i64) () (block entry (ret !)))
(define-reader-macro "!" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (i64 2)))
      (ret l))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (call @one))
    (call @printf (string "%lld\n") !)
    (ret (i32 0))))
