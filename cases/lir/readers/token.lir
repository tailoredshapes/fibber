;; expect: accept
;; out: 1000
;; out: 1234567
;; out: 42
;; spec/lir.md 4.7: the token reader is called for every atom with the stream after it and the atom's form; this one turns a symbol of
;; digits and _ (at least one _) into the integer, and returns any other token as it is: every name, keyword and number of this module
;; passes through it.
(declare printf i32 (ptr ...))
(define-token-reader (s tok)
  (block entry (br (icmp eq (call @lir.sexp.tag tok) (i64 1)) sym keep))
  (block keep (ret tok))
  (block sym
    (let ((p (call @lir.sexp.text tok))
          (n (call @lir.sexp.len tok)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (sym (i64 0)) (digit i2) (under i2)))
          (acc (phi i64 (sym (i64 0)) (digit acc2) (under acc)))
          (seen (phi i1 (sym (i1 0)) (digit seen) (under (i1 1)))))
      (br (icmp ult i n) char done)))
  (block char
    (let ((c (zext i64 (load i8 (getelementptr i8 p i))))
          (i2 (add i (i64 1))))
      (switch c maybe ((i64 95) under))))
  (block under (br loop))
  (block maybe (br (and (icmp uge c (i64 48)) (icmp ule c (i64 57))) digit keep))
  (block digit
    (let ((acc2 (add (mul acc (i64 10)) (sub c (i64 48)))))
      (br loop)))
  (block done (br seen make keep))
  (block make (ret (call @lir.sexp.integer acc))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (i64 1_000))
    (call @printf (string "%lld\n") (i64 1_234_567))
    (call @printf (string "%lld\n") (i64 42))
    (ret (i32 0))))
