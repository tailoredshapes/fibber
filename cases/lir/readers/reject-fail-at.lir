;; expect: reject
;; error: 12:51: error: reader macro !: a bad character after !
;; spec/lir.md 4.7: lir.read.fail at a position the macro took from lir.read.position: the stream starts after the ! (column 48) and the
;; macro takes two more characters, so the position is column 51.
(declare printf i32 (ptr ...))
(define-reader-macro "!" (s)
  (block entry
    (call @lir.read.next s)
    (call @lir.read.next s)
    (ret (call @lir.read.fail s (call @lir.read.position s) (string "a bad character after !")))))
(define (main i32) ()
  (block entry (call @printf (string "%lld\n") !bang) (ret (i32 0))))
