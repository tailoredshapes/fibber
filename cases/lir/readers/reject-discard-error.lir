;; expect: reject
;; error: 34:43: error: unexpected )
;; spec/lir.md 4.8: an error inside a form a macro reads is the module's error where it is: the [ of discard-closer.lir meets #_ ) and
;; lir.read.failed says so; the ) is reported, not an unclosed [.
(declare printf i32 (ptr ...))
(define-dispatch-macro "_" (s)
  (block entry
    (call @lir.read.form s)
    (ret (ptr null))))
(define-reader-macro "[" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (br next)))
  (block next
    (let ((n (phi i64 (entry (i64 0)) (more n2) (none n)))
          (b (call @lir.read.skip s)))
      (switch b item ((i64 93) close) ((i64 -1) end))))
  (block close
    (call @lir.read.next s)
    (call @lir.sexp.push l (call @lir.sexp.integer n))
    (ret l))
  (block end (ret (call @lir.read.fail s (i64 0) (string "unclosed ["))))
  (block item
    (let ((x (call @lir.read.form s)))
      (br (icmp eq x (ptr null)) none more)))
  (block more
    (let ((n2 (add n (i64 1))))
      (br next)))
  (block none (br (call @lir.read.failed s) failed next))
  (block failed (ret (ptr null))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") [1 #_ ) ])
    (ret (i32 0))))
