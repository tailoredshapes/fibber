;; expect: accept
;; out: 1 2 2
;; spec/lir.md 4.8: character classes. NBSP (U+00A0) made constituent is not whitespace: x<NBSP>y is one atom (the token reader sees it,
;; here it keeps it); ~ made terminating ends an atom, so a~b is a and then ~b, which the reader macro of ~ reads; | made whitespace parts
;; a|b. [..] counts the forms it reads: 1, 2 and 2. With the classes ignored (lIR's own whitespace and delimiters) it would be 2, 1 and 1.
(declare printf i32 (ptr ...))
(define-reader-class "\xC2\xA0" constituent)
(define-reader-class "~" terminating)
(define-reader-class "|" whitespace)
(define-token-reader (s tok)
  (block entry (ret tok)))
(define-reader-macro "~" (s)
  (block entry
    (let ((x (call @lir.read.form s)))
      (ret x))))
(define-reader-macro "[" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (br next)))
  (block next
    (let ((n (phi i64 (entry (i64 0)) (more n2)))
          (b (call @lir.read.skip s)))
      (switch b item ((i64 93) close) ((i64 -1) end))))
  (block close
    (call @lir.read.next s)
    (call @lir.sexp.push l (call @lir.sexp.integer n))
    (ret l))
  (block end (ret (call @lir.read.fail s (i64 0) (string "unclosed ["))))
  (block item
    (let ((x (call @lir.read.form s)))
      (br (icmp eq x (ptr null)) none more)))
  (block more
    (let ((n2 (add n (i64 1))))
      (br next)))
  (block none (ret (ptr null))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld %lld\n") [x y] [a~b] [a|b])
    (ret (i32 0))))
