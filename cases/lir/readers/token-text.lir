;; expect: accept
;; out: 4 5
;; spec/lir.md 4.8: the token reader is given the atom's text as a symbol whatever the text: 1234 arrives as the symbol 1234 (tag 1), not
;; as lIR's integer. This one turns a symbol of three or more characters starting with a digit into (i64 LENGTH) and keeps every other
;; token as it is (the parser reads 0 and i32 by their text).
(declare printf i32 (ptr ...))
(define-token-reader (s tok)
  (block entry
    (br (icmp eq (call @lir.sexp.tag tok) (i64 1)) sym keep))
  (block sym
    (let ((c (zext i64 (load i8 (call @lir.sexp.text tok))))
          (n (call @lir.sexp.len tok)))
      (br (and (and (icmp uge c (i64 48)) (icmp ule c (i64 57))) (icmp uge n (i64 3))) make keep)))
  (block make
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer n))
      (ret l)))
  (block keep (ret tok)))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n") 1234 12345)
    (ret (i32 0))))
