;; expect: accept
;; out: 2634 2652 2670 2689
;; out: 2766 2794 2813 2843
;; spec/lir.md 4.8: the form a reader macro returns spans the text its run consumed, from the macro character to where the run left the
;; stream, and so does every form in it the macro made; a form it read with lir.read.form keeps its own span. 'X reads as (quote X) and
;; [A ..] as (vector A ..) (lib/lir/readers.lir's two, written here). Line 2: 'abc from its ' to after abc, the made quote the same (its
;; end), abc its own (its start). Line 3: [x [y z]] from [ to after the outer ], the inner [y z], read by a nested run, its own.
(DECLARE printf I32 (PTR ...))
(DEFINE-MACRO lit64 (v)
  (BLOCK entry
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l (CALL (GLOBAL lir.sexp.symbol) (STRING "I64")))
      (CALL (GLOBAL lir.sexp.push) l v)
      (RET l))))
(DEFINE-MACRO start-of (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.start) x))))))
(DEFINE-MACRO end-of (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.end) x))))))
(DEFINE-MACRO start-of-nth (x i)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.start-of) (CALL (GLOBAL lir.sexp.nth) x (CALL (GLOBAL lir.sexp.int) i))))))
(DEFINE-MACRO end-of-nth (x i)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.end-of) (CALL (GLOBAL lir.sexp.nth) x (CALL (GLOBAL lir.sexp.int) i))))))
(DEFINE-READER-MACRO "'" (s)
  (BLOCK entry
    (LET ((x (CALL (GLOBAL lir.read.form) s)))
      (BR (ICMP EQ x (PTR NULL)) none some)))
  (BLOCK none (RET (PTR NULL)))
  (BLOCK some
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l (CALL (GLOBAL lir.sexp.symbol) (STRING "quote")))
      (CALL (GLOBAL lir.sexp.push) l x)
      (RET l))))
(DEFINE-READER-MACRO "[" (s)
  (BLOCK entry
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l (CALL (GLOBAL lir.sexp.symbol) (STRING "vector")))
      (BR next)))
  (BLOCK next
    (LET ((b (CALL (GLOBAL lir.read.skip) s)))
      (SWITCH b item ((I64 93) close) ((I64 -1) end))))
  (BLOCK close
    (CALL (GLOBAL lir.read.next) s)
    (RET l))
  (BLOCK end
    (RET (CALL (GLOBAL lir.read.fail) s (I64 0) (STRING "unclosed ["))))
  (BLOCK item
    (LET ((x (CALL (GLOBAL lir.read.form) s)))
      (BR (ICMP EQ x (PTR NULL)) none more)))
  (BLOCK more
    (CALL (GLOBAL lir.sexp.push) l x)
    (BR next))
  (BLOCK none (RET (PTR NULL))))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (start-of 'abc) (end-of 'abc) (end-of-nth 'abc 0) (start-of-nth 'abc 1))
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (start-of [x [y z]]) (end-of [x [y z]]) (start-of-nth [x [y z]] 2) (end-of-nth [x [y z]] 2))
    (RET (I32 0))))
