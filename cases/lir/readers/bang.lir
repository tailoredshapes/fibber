;; spec/lir.md 4.8: a module import-own-table.lir imports; run alone it is no program. It binds ! to (i64 7) for its own forms and exports
;; seven, which reads !; its importer binds ! to something else, and sees seven answer 7 and its own ! unchanged.
(define-reader-macro "!" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (i64 7)))
      (ret l))))
(define (seven i64) () (block entry (ret !)))
