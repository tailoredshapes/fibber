;; expect: accept
;; out: 7
;; spec/lir.md 4.8: (define-reader-depth N) sets the nesting the reader allows; a reader macro's run is a level, as a list is. ' reads the form
;; after it and adds one to it: in main the define is level 1, the block 2, the call 3, the seven quotes 4 to 10 and (i64 0) 11; a depth
;; of 11 admits it (reject-depth.lir: 10 does not).
(declare printf i32 (ptr ...))
(define-reader-depth 11)
(define-reader-macro "'" (s)
  (block entry
    (let ((x (call @lir.read.form s))
          (l (call @lir.sexp.list (i64 0)))
          (one (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push one (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push one (call @lir.sexp.integer (i64 1)))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l one)
      (call @lir.sexp.push l x)
      (ret l))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") '''''''(i64 0))
    (ret (i32 0))))
