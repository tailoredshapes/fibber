;; expect: accept
;; out: 2
;; out: 9
;; spec/lir.md 4.7: a reader macro that returns null without a failure read no form: #_ reads the next form and discards it, inside a form,
;; nested (#_ #_ a b c is c) and at the top level (a whole define discarded).
(declare printf i32 (ptr ...))
(define-dispatch-macro "_" (s)
  (block entry
    (call @lir.read.form s)
    (ret (ptr null))))
#_(define (gone i32) () (block entry (ret (i32 1))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") #_(i64 1) (i64 2))
    (call @printf (string "%lld\n") #_ #_ (i64 7) (i64 8) (i64 9))
    (ret (i32 0))))
