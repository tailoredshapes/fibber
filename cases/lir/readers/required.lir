;; expect: accept
;; out: 5
;; out: 6
;; spec/lir.md 4.7: the reader macros of a required library (lib/lir/readers.lir: ' and [) apply to this module's forms after the require.
;; (quote X) and (vector ..) are this module's macros: the length of the quoted symbol, the sum of the items.
(require-macros "../../../lib/lir/readers.lir")
(declare printf i32 (ptr ...))
(define-macro lit64 (v)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l v)
      (ret l))))
(define-macro quote (x)
  (block entry (ret (call @lir.macro.lit64 (call @lir.sexp.integer (call @lir.sexp.len x))))))
(define-macro vector (xs ...)
  (block entry
    (let ((n (call @lir.sexp.count xs)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (step i2)))
          (acc (phi i64 (entry (i64 0)) (step acc2))))
      (br (icmp ult i n) step done)))
  (block step
    (let ((acc2 (add acc (call @lir.sexp.int (call @lir.sexp.nth xs i))))
          (i2 (add i (i64 1))))
      (br loop)))
  (block done (ret (call @lir.macro.lit64 (call @lir.sexp.integer acc)))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") 'hello)
    (call @printf (string "%lld\n") [1 2 3])
    (ret (i32 0))))
