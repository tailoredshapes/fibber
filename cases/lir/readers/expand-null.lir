;; expect: accept
;; out: 1 1 7
;; spec/lir.md 4.6: a reader macro runs while the text is read and has no expansion to call: lir.sexp.expand answers it null, before the
;; module's macros have run (a) and after one has (b). The reader macros and the macros of a module run on its one worker (4.8), so the
;; hook lir.sexp.expand parks on is the reader's to answer, and neither kind of run waits on a worker nobody serves.
(declare printf i32 (ptr ...))
(define-macro lit64 (v)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l v)
      (ret l))))
(define-reader-macro "!" (s)
  (block entry
    (let ((f (call @lir.read.form s)))
      (let ((e (call @lir.sexp.expand f)))
        (br (icmp eq e (ptr null)) none some))))
  (block none (ret (call @lir.macro.lit64 (call @lir.sexp.integer (i64 1)))))
  (block some (ret (call @lir.macro.lit64 (call @lir.sexp.integer (i64 2))))))
(define (a i64) () (block entry (ret !(lit64 5))))
(define (seven i64) () (block entry (ret (lit64 7))))
(define (b i64) () (block entry (ret !(lit64 5))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld %lld\n") (call @a) (call @b) (call @seven))
    (ret (i32 0))))
