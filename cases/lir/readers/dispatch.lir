;; expect: accept
;; out: 3
;; out: 7
;; spec/lir.md 4.7: a dispatch macro bound to ( runs at #( with the stream after both characters; this one reads the forms up to ) and
;; makes (count N) of how many there were, which the module's macro `count` turns into (i64 N). # before an unbound character is an error
;; (reject-no-dispatch.lir); an atom of the module does not start with #.
(declare printf i32 (ptr ...))
(define-macro count (n)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l n)
      (ret l))))
(define-dispatch-macro "(" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "count")))
      (br next)))
  (block next
    (let ((n (phi i64 (entry (i64 0)) (more n2)))
          (b (call @lir.read.skip s)))
      (switch b item ((i64 41) close) ((i64 -1) end))))
  (block close
    (call @lir.read.next s)
    (call @lir.sexp.push l (call @lir.sexp.integer n))
    (ret l))
  (block end
    (ret (call @lir.read.fail s (i64 0) (string "unclosed #("))))
  (block item
    (let ((x (call @lir.read.form s)))
      (br (icmp eq x (ptr null)) none more)))
  (block more
    (let ((n2 (add n (i64 1))))
      (br next)))
  (block none (ret (ptr null))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") #(a b c))
    (call @printf (string "%lld\n") #(a (b c) d e f #(g) h))
    (ret (i32 0))))
