;; expect: reject
;; error: 11:1: error: import: cases/lir/readers/question.lir:5:38: error: undefined name ?
;; spec/lir.md 4.8: the importer's readtable does not leak into the module it imports: ? is bound here, and question.lir, which uses ?, is
;; read under its own table, where ? is nothing. The error is the imported module's, at the import.
(define-reader-macro "?" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (i64 1)))
      (ret l))))
(import "question.lir")
(define (main i32) () (block entry (ret (i32 0))))
