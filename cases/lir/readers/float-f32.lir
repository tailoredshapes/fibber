;; expect: accept
;; out: 1.29857696e-07 0.000202999727 9.9851417e+29
;; spec/lir.md 3: a (float X) literal is read by strtof, rounded once to f32. Each of these decimals rounds to a different f32 through a
;; double first (1.2985771e-07, 0.000202999712, 9.98514245e+29): the exact nearest f32 of each is printed.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%.9g %.9g %.9g\n")
          (fpext double (float 1.2985770325713019e-7))
          (fpext double (float 2.0299971947679297e-4))
          (fpext double (float 9.9851420743622797e29)))
    (ret (i32 0))))
