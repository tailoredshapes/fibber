;; expect: accept
;; out: 6
;; out: 0
;; out: 10
;; spec/lir.md 4.7: a reader macro bound to [ reads the forms up to ] (lir.read.skip, lir.read.form, lir.read.next) and makes (vector ..);
;; the module's macro `vector` expands to the sum of its arguments as i64 constants. [] is (vector), 0; [1 [2 3] 4] nests.
(declare printf i32 (ptr ...))
(define-macro lit64 (v)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l v)
      (ret l))))
(define-macro vector (xs ...)
  (block entry
    (let ((n (call @lir.sexp.count xs))
          (zero (call @lir.macro.lit64 (call @lir.sexp.integer (i64 0)))))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (join i2)))
          (acc (phi ptr (entry zero) (join sum))))
      (br (icmp ult i n) step done)))
  (block step
    (let ((sum (call @lir.sexp.list (i64 0)))
          (x (call @lir.sexp.nth xs i))
          (i2 (add i (i64 1))))
      (call @lir.sexp.push sum (call @lir.sexp.symbol (string "add")))
      (br (icmp eq (call @lir.sexp.tag x) (i64 2)) literal nested)))
  (block literal
    (call @lir.sexp.push sum (call @lir.macro.lit64 x))
    (br join))
  (block nested
    (call @lir.sexp.push sum x)
    (br join))
  (block join
    (call @lir.sexp.push sum acc)
    (br loop))
  (block done (ret acc)))
(define-reader-macro "[" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "vector")))
      (br next)))
  (block next
    (let ((b (call @lir.read.skip s)))
      (switch b item ((i64 93) close) ((i64 -1) end))))
  (block close
    (call @lir.read.next s)
    (ret l))
  (block end
    (ret (call @lir.read.fail s (i64 0) (string "unclosed ["))))
  (block item
    (let ((x (call @lir.read.form s)))
      (br (icmp eq x (ptr null)) none more)))
  (block more
    (call @lir.sexp.push l x)
    (br next))
  (block none (ret (ptr null))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") [1 2 3])
    (call @printf (string "%lld\n") [])
    (call @printf (string "%lld\n") [1 [2 3] 4])
    (ret (i32 0))))
