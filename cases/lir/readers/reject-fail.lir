;; expect: reject
;; error: 8:48: error: reader macro !: no bang here
;; spec/lir.md 4.7: a reader macro reports an error with lir.read.fail; with position 0 the error is at the macro's character.
(declare printf i32 (ptr ...))
(define-reader-macro "!" (s)
  (block entry (ret (call @lir.read.fail s (i64 0) (string "no bang here")))))
(define (main i32) ()
  (block entry (call @printf (string "%lld\n") !bang) (ret (i32 0))))
