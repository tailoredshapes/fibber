;; expect: reject
;; error: 9:41: error: no dispatch macro for #x
;; spec/lir.md 4.7: once a dispatch macro is bound, # before a character with no dispatch macro is an error at the #.
(declare printf i32 (ptr ...))
(define-dispatch-macro "_" (s)
  (block entry
    (call @lir.read.form s)
    (ret (ptr null))))
(define (main i32) () (block entry (ret #x)))
