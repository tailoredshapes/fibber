;; expect: reject
;; error: 8:68: error: reader macro !: boom
;; spec/lir.md 4.8: under a readtable the first error is the module's: the macro's failure here, not the unterminated string lIR's own
;; lexer would find on the line after it (which it reports instead for a module with no readtable, lir.md 1).
(declare printf i32 (ptr ...))
(define-reader-macro "!" (s)
  (block entry (ret (call @lir.read.fail s (i64 0) (string "boom")))))
(define (main i32) () (block entry (call @printf (string "%lld\n") !x) (ret (i32 0))))
(define (other i32) () (block entry (call @printf (string "unterminated) (ret (i32 0))))
