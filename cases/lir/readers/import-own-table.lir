;; expect: accept
;; out: 1 7 1
;; spec/lir.md 4.8: an import crosses no readtable. ! is bound to (i64 1) here, before the import, and still means that after it; bang.lir,
;; imported, reads under its own table, where ! is (i64 7), so seven answers 7.
(declare printf i32 (ptr ...))
(define-reader-macro "!" (s)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (i64 1)))
      (ret l))))
(define (one i64) () (block entry (ret !)))
(import "bang.lir")
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld %lld\n") (call @one) (call @seven) !)
    (ret (i32 0))))
