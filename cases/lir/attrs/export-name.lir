;; expect: accept
;; stage: 2
;; out: 42
;; ir: define i64 @add(i64 %a, i64 %b) #0 {
;; ir: attributes #0 = { "wasm-export-name"="add" }
;; ir-not: @twice(i64 %x) #
;; spec/lir.md 4.3: `(export-name "NAME")` on a define is LLVM's "wasm-export-name" string attribute on that function only (a wasm module exports it
;; under NAME; other backends ignore the attribute). The program runs on the host as before.
(declare printf i32 (ptr ...))
(define (export-name "add") (add i64) ((i64 a) (i64 b))
  (block entry (ret (add a b))))
(define internal (twice i64) ((i64 x))
  (block entry (ret (call @add x x))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (call @twice (i64 21)))
    (ret (i32 0))))
