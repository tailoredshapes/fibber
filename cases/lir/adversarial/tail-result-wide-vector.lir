;; expect: reject
;; error: tailcall: a result of type <1024 x i32> may be returned in memory, which no tail call can: at most 2 scalar or vector leaves of at most 512 bits (found 1 leaves, the widest 32768 bits)
;; §7.3 rule 5: a vector wider than the target's registers is returned
;; in memory too (LLVM aborted on this one as on the struct)
(define tailcc (f <1024 x i32>) () (block entry (ret (zeroinitializer <1024 x i32>))))
(define tailcc (g <1024 x i32>) () (block entry (tailcall @f)))
(define (main i32) () (block entry (ret (extractelement (call @g) (i32 0)))))
