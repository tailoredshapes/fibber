;; §7.3 rule 5 on an indirect tail call, judged by the written type
(define tailcc (f [4 x i64]) () (block entry (ret ([4 x i64] (i64 1) (i64 2) (i64 3) (i64 4)))))
(define tailcc (g [4 x i64]) () (block entry (indirect-tailcall @f (fn tailcc [4 x i64] ()))))
(define (main i32) () (block entry (ret (trunc i32 (extractvalue (call @g) 3)))))
