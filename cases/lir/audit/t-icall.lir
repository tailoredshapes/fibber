;; expect: accept
;; out: icall=42
;; audit: t/icall.lir with the function type written (spec/lir.md §6.8)
(declare printf i32 (ptr ...))
(define (inc i64) ((i64 x)) (block entry (ret (add x (i64 1)))))
(define (main i32) ()
  (block entry
    (let ((fp @inc))
      (call @printf (string "icall=%lld\n") (indirect-call fp (fn i64 (i64)) (i64 41)))
      (ret (i32 0)))))
