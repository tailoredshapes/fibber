;; expect: accept
;; out: icall=3.500000
;; audit: t/icall2.lir with the function type written; liar 7f4734c: LLVM verifier error (double arguments typed ptr)
(declare printf i32 (ptr ...))
(define (addd double) ((double x) (double y)) (block entry (ret (fadd x y))))
(define (main i32) ()
  (block entry
    (call @printf (string "icall=%f\n") (indirect-call @addd (fn double (double double)) (double 1.5) (double 2.0)))
    (ret (i32 0))))
