;; expect: accept
;; ir: fence acquire
;; ir: fence release
;; ir: fence acq_rel
;; ir: fence seq_cst
;; ir: fence syncscope("singlethread") seq_cst
;; audit: t/fence_mono.lir; liar 7f4734c emitted every fence as syncscope("singlethread"): no ordering between threads
(define (main i32) ()
  (block entry
    (fence acquire)
    (fence release)
    (fence acq_rel)
    (fence seq_cst)
    (fence singlethread seq_cst)
    (ret (i32 0))))
