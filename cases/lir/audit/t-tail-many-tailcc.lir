;; expect: accept
;; out: r=42
;; ir: musttail call tailcc
;; audit: t/tail_many.lir under tailcc: 10^7 tail calls between different prototypes
(declare printf i32 (ptr ...))
(define tailcc (a i64) ((i64 n))
  (block entry (br (icmp eq n (i64 0)) done rec))
  (block done (ret (i64 42)))
  (block rec (tailcall @b n (i64 1) (i64 2) (i64 3) (i64 4) (i64 5) (i64 6) (i64 7) (i64 8) (i64 9))))
(define tailcc (b i64) ((i64 n) (i64 x1) (i64 x2) (i64 x3) (i64 x4) (i64 x5) (i64 x6) (i64 x7) (i64 x8) (i64 x9))
  (block entry (tailcall @a (sub n (i64 1)))))
(define (main i32) ()
  (block entry
    (call @printf (string "r=%lld\n") (call @a (i64 10000000)))
    (ret (i32 0))))
