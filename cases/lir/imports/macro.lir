;; expect: accept
;; out: 14 20
;; spec/lir.md 4.7: the macro twice of math.lir is defined in the importer by the import, and runs in math.lir's session; a macro of the
;; importer's own may use it.
(import "math.lir")
(declare printf i32 (ptr ...))
(define-macro quad (x)
  (block entry
    (let ((inner (call @lir.sexp.list (i64 0)))
          (outer (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push inner (call @lir.sexp.symbol (string "twice")))
      (call @lir.sexp.push inner x)
      (call @lir.sexp.push outer (call @lir.sexp.symbol (string "twice")))
      (call @lir.sexp.push outer inner)
      (ret outer))))
(define (main i32) ()
  (block entry
    (call @printf (string "%d %d\n") (twice (i32 7)) (quad (i32 5)))
    (ret (i32 0))))
