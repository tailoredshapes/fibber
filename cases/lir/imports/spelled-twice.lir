;; out: 0
;; spec/lir.md 4.7: the same module imported through three spellings of its path is one module, loaded once (no duplicate definition of
;; its global): a module is identified by its canonical path, not by the text written.
(import "base.lir")
(import "./base.lir")
(import "../imports/base.lir")
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (load i64 @hits))
    (ret (i32 0))))
