;; expect: accept
;; out: 10 20 2
;; spec/lir.md 4.7: a diamond: left.lir and right.lir both import base.lir, which is loaded once (one global hits, bumped twice); the two
;; internal helpers of the same name are each their module's own (the later one is renamed in the program).
(import "left.lir")
(import "right.lir")
(import "base.lir")
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld %lld\n") (call @left-value) (call @right-value) (load i64 @hits))
    (ret (i32 0))))
