;; expect: reject
;; error: 1:1: error: no main function
;; spec/lir.md 4.7: a module other modules import (function-and-struct.lir, macro.lir, reject-internal.lir ..); run on its own it is no
;; program. It exports square, make-pair, say, counter, the struct pair and the macro twice; helper is internal to it, and defun, which
;; it requires, is its own (reject-transitive-macro.lir).
(require-macros "../../../lib/lir/defun.lir")
(declare printf i32 (ptr ...))
(declare abs i32 (i32))
(defstruct pair (i64 i64))
(global counter i64 (i64 0))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define internal (helper i64) ((i64 x))
  (block entry (ret (mul x x))))
(defun square ((x i64)) -> i64
  (block entry
    (store (add (load i64 @counter) (i64 1)) @counter)
    (ret (call @helper x))))
(define (make-pair %struct.pair) ((i64 a) (i64 b))
  (block entry (ret (%struct.pair a b))))
(define (say void) ((i64 n))
  (block entry
    (call @printf (string "say %lld %d\n") n (call @abs (i32 -3)))
    (ret)))
