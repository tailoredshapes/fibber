;; expect: accept
;; out: 49 25
;; out: 3 4
;; out: say 7 3
;; out: calls 2
;; spec/lir.md 4.7: a module imports math.lir and calls its functions, builds and reads its struct, reads its global; both modules declare
;; printf, which the program has once; the second import of the same file is nothing.
(import "math.lir")
(import "math.lir")
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n") (call @square (i64 7)) (call @square (i64 5)))
    (let ((p (call @make-pair (i64 3) (i64 4))))
      (call @printf (string "%lld %lld\n") (extractvalue p 0) (extractvalue p 1)))
    (call @say (i64 7))
    (call @printf (string "calls %lld\n") (load i64 @counter))
    (ret (i32 0))))
