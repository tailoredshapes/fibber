;; expect: accept
;; facts: trap
;; signal: SIGILL, SIGTRAP
;; stderr: lIR fact violated: (shl nuw) in @main, block entry, at 12:14
;; -1 << 1 keeps the sign (its `nsw` holds) but shifts a set bit out, so its `nuw` is false (LLVM's definition: shifting back gives another
;; value): the check mode tests both flags and names the one that failed.
(define (opq i64) ((i64 x))
  (block entry (let ((s (alloca i64))) (store volatile x s) (ret (load volatile i64 s)))))
(define (main i32) ()
  (block entry
    (let ((a (call @opq (i64 -1)))
          (s (shl nuw nsw a (i64 1))))
      (ret (trunc i32 s)))))
