;; expect: accept
;; facts: ignore
;; out: -9223372036854775808
;; ir-not: = add nsw
;; The control of trap-nsw.lir: the same false `nsw` dropped (`ignore`, the reference semantics) runs as the plain wrapping add.
(declare printf i32 (ptr ...))
(define (opq i64) ((i64 x))
  (block entry (let ((s (alloca i64))) (store volatile x s) (ret (load volatile i64 s)))))
(define (main i32) ()
  (block entry
    (let ((a (call @opq (i64 9223372036854775807)))
          (s (add nsw a (i64 1))))
      (call @printf (string "%lld\n") s)
      (ret (i32 0)))))
