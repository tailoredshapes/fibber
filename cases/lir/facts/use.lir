;; expect: accept
;; facts: use
;; ir: = add nsw i64
;; ir: = sub nuw i32
;; ir: = mul nuw nsw i64
;; ir: = shl nsw <2 x i64>
;; ir: call void @llvm.assume(i1
;; ir: load i64, ptr %p, align 8, !range !
;; ir: = !{i64 0, i64 100}
;; ir: = !{i8 -3, i8 -128}
;; out: 12 2 42 [8 12] 7 -3
;; In the default mode every fact reaches LLVM in LLVM's own spelling: the no-wrap flags on the instruction, `llvm.assume`, `!range` metadata
;; (the open-topped range of an i8 is written with the minimum as its end, LLVM's wrapped interval). Every fact is true, so the results are the
;; plain ones. The values come through volatile memory so that nothing is folded.
(declare printf i32 (ptr ...))
(define (opq i64) ((i64 x))
  (block entry (let ((s (alloca i64))) (store volatile x s) (ret (load volatile i64 s)))))
(define (main i32) ()
  (block entry
    (let ((a (call @opq (i64 5)))
          (b (call @opq (i64 7)))
          (s (add nsw a b))
          (d (sub nuw (trunc i32 b) (trunc i32 a)))
          (m (mul nuw nsw (i64 6) b))
          (v (shl nsw (insertelement (<2 x i64> 0 0) a (i32 0)) (<2 x i64> 0 0)))
          (w (shl nsw (<2 x i64> 2 3) (insertelement (<2 x i64> 2 2) (sub a (i64 3)) (i32 1))))
          (p (alloca i64))
          (q (alloca i8)))
      (assume (icmp slt a b))
      (store b p)
      (store (i8 -3) q)
      (let ((r (load (range 0 100) i64 p))
            (t (load (range -3 128) (align 1) i8 q)))
        (call @printf (string "%lld %d %lld [%lld %lld] %lld %d\n") s d m (extractelement w (i32 0)) (extractelement w (i32 1)) r (sext i32 t))
        (ret (i32 0))))))
