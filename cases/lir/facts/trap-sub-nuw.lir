;; expect: accept
;; facts: trap
;; signal: SIGILL, SIGTRAP
;; stderr: lIR fact violated: (sub nuw) in @main, block entry, at 11:14
;; 3 - 5 goes below zero: `sub nuw` is false (as unsigned it wraps) and traps in the check mode.
(define (opq i32) ((i32 x))
  (block entry (let ((s (alloca i32))) (store volatile x s) (ret (load volatile i32 s)))))
(define (main i32) ()
  (block entry
    (let ((a (call @opq (i32 3)))
          (s (sub nuw a (i32 5))))
      (ret s))))
