;; expect: accept
;; facts: trap
;; signal: SIGILL, SIGTRAP
;; stderr: lIR fact violated: (add nsw) in @main, block entry, at 13:14
;; A false `nsw`: the maximum plus one wraps. In the check mode the add is tested and the process traps with a message naming the fact and
;; where it is; the same program without the check mode is trap-nsw-ignored.lir.
(declare printf i32 (ptr ...))
(define (opq i64) ((i64 x))
  (block entry (let ((s (alloca i64))) (store volatile x s) (ret (load volatile i64 s)))))
(define (main i32) ()
  (block entry
    (let ((a (call @opq (i64 9223372036854775807)))
          (s (add nsw a (i64 1))))
      (call @printf (string "%lld\n") s)
      (ret (i32 0)))))
