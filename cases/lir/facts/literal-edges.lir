;; expect: accept
;; out: 127 255 -9223372036854775808 128 -2 4611686018427387904 -128
;; Literal operands at the edge of each flag are accepted when the operation does not wrap (the checker rejects only a fact the literals
;; already break: facts-verify/lit-*.lir are the other side of each edge). LLVM folds them; the values are the exact results.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%d %d %lld %d %d %lld %d\n")
          (sext i32 (add nsw (i8 127) (i8 0)))
          (zext i32 (add nuw (i8 254) (i8 1)))
          (mul nsw (i64 -9223372036854775808) (i64 1))
          (zext i32 (shl nuw (i8 64) (i8 1)))
          (sext i32 (shl nsw (i8 -1) (i8 1)))
          (shl nuw nsw (i64 2305843009213693952) (i64 1))
          (sext i32 (sub nsw (i8 -127) (i8 1))))
    (ret (i32 0))))
