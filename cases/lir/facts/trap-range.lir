;; expect: accept
;; facts: trap
;; signal: SIGILL, SIGTRAP
;; stderr: lIR fact violated: (load (range 0 100)) in @main, block entry, at 11:16
;; A false range: the loaded value is 100, one past the range's end, and the check mode traps (the end is exclusive, as LLVM's `!range`).
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (let ((p (alloca i64)))
      (store volatile (i64 100) p)
      (let ((r (load (range 0 100) i64 p)))
        (call @printf (string "%lld\n") r)
        (ret (i32 0))))))
