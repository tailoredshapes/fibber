;; expect: accept
;; facts: trap
;; out: 45
;; A fact in a loop body whose block feeds a phi: the check mode tests it with a call, not a branch, so the block stays one LLVM block and the
;; phi's incoming block is still the right one (the verifier would reject the module otherwise). The facts are true: the sum of 0..9.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2)))
          (acc (phi i64 (entry (i64 0)) (body acc2))))
      (br (icmp slt i (i64 10)) body done)))
  (block body
    (let ((acc2 (add nsw acc i))
          (i2 (add nuw nsw i (i64 1))))
      (assume (icmp sle i2 (i64 10)))
      (br loop)))
  (block done
    (call @printf (string "%lld\n") acc)
    (ret (i32 0))))
