;; expect: accept
;; facts: trap
;; signal: SIGILL, SIGTRAP
;; stderr: lIR fact violated: (load (range -3 128)) in @main, block entry, at 11:16
;; A false range below its start: -4 in [-3, 128) of an i8, whose top is open (no upper test), still traps on the lower one.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (let ((p (alloca i8)))
      (store volatile (i8 -4) p)
      (let ((r (load (range -3 128) i8 p)))
        (call @printf (string "%d\n") (sext i32 r))
        (ret (i32 0))))))
