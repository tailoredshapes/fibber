;; expect: accept
;; out: 42
;; spec/lir.md 4.6: the module macro armed by a library: everything after the require is pass-through's, which splices it back with
;; (define (hooked i64) () ..) appended.
(require-macros "module-hook-lib.lir")
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (call @hooked))
    (ret (i32 0))))
