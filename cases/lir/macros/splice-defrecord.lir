;; expect: accept
;; out: 7 12
;; spec/lir.md 4.6, splices: (defpair NAME T MAKE SUM) expands to a splice of three items,
;;   (begin (defstruct NAME (i64 i64))
;;          (define (MAKE T) ((i64 a) (i64 b)) (block entry (ret (T a b))))
;;          (define (SUM i64) ((T p)) (block entry (ret (add (extractvalue p 0) (extractvalue p 1)))))),
;; which the forms after the use call. The names come as arguments: the form library has no text concatenation, and the case is the splice.
(declare printf i32 (ptr ...))
(define-macro defpair (name t make sum)
  (block entry
    (let ((out (call @lir.sexp.list (i64 0)))
          (st (call @lir.sexp.list (i64 0))) (fields (call @lir.sexp.list (i64 0)))
          (mk (call @lir.sexp.list (i64 0))) (mk-sig (call @lir.sexp.list (i64 0))) (mk-ps (call @lir.sexp.list (i64 0)))
          (pa (call @lir.sexp.list (i64 0))) (pb (call @lir.sexp.list (i64 0)))
          (mk-blk (call @lir.sexp.list (i64 0))) (mk-ret (call @lir.sexp.list (i64 0))) (mk-val (call @lir.sexp.list (i64 0)))
          (sm (call @lir.sexp.list (i64 0))) (sm-sig (call @lir.sexp.list (i64 0))) (sm-ps (call @lir.sexp.list (i64 0)))
          (pp (call @lir.sexp.list (i64 0)))
          (sm-blk (call @lir.sexp.list (i64 0))) (sm-ret (call @lir.sexp.list (i64 0))) (sm-add (call @lir.sexp.list (i64 0)))
          (x0 (call @lir.sexp.list (i64 0))) (x1 (call @lir.sexp.list (i64 0)))
          (i64s (call @lir.sexp.symbol (string "i64"))) (a (call @lir.sexp.symbol (string "a"))) (b (call @lir.sexp.symbol (string "b")))
          (p (call @lir.sexp.symbol (string "p"))) (blocks (call @lir.sexp.symbol (string "block"))) (entry-s (call @lir.sexp.symbol (string "entry")))
          (rets (call @lir.sexp.symbol (string "ret"))) (defines (call @lir.sexp.symbol (string "define")))
          (ev (call @lir.sexp.symbol (string "extractvalue"))))
      (call @lir.sexp.push fields i64s) (call @lir.sexp.push fields i64s)
      (call @lir.sexp.push st (call @lir.sexp.symbol (string "defstruct"))) (call @lir.sexp.push st name) (call @lir.sexp.push st fields)
      (call @lir.sexp.push mk-sig make) (call @lir.sexp.push mk-sig t)
      (call @lir.sexp.push pa i64s) (call @lir.sexp.push pa a) (call @lir.sexp.push pb i64s) (call @lir.sexp.push pb b)
      (call @lir.sexp.push mk-ps pa) (call @lir.sexp.push mk-ps pb)
      (call @lir.sexp.push mk-val t) (call @lir.sexp.push mk-val a) (call @lir.sexp.push mk-val b)
      (call @lir.sexp.push mk-ret rets) (call @lir.sexp.push mk-ret mk-val)
      (call @lir.sexp.push mk-blk blocks) (call @lir.sexp.push mk-blk entry-s) (call @lir.sexp.push mk-blk mk-ret)
      (call @lir.sexp.push mk defines) (call @lir.sexp.push mk mk-sig) (call @lir.sexp.push mk mk-ps) (call @lir.sexp.push mk mk-blk)
      (call @lir.sexp.push sm-sig sum) (call @lir.sexp.push sm-sig i64s)
      (call @lir.sexp.push pp t) (call @lir.sexp.push pp p) (call @lir.sexp.push sm-ps pp)
      (call @lir.sexp.push x0 ev) (call @lir.sexp.push x0 p) (call @lir.sexp.push x0 (call @lir.sexp.integer (i64 0)))
      (call @lir.sexp.push x1 ev) (call @lir.sexp.push x1 p) (call @lir.sexp.push x1 (call @lir.sexp.integer (i64 1)))
      (call @lir.sexp.push sm-add (call @lir.sexp.symbol (string "add"))) (call @lir.sexp.push sm-add x0) (call @lir.sexp.push sm-add x1)
      (call @lir.sexp.push sm-ret rets) (call @lir.sexp.push sm-ret sm-add)
      (call @lir.sexp.push sm-blk blocks) (call @lir.sexp.push sm-blk entry-s) (call @lir.sexp.push sm-blk sm-ret)
      (call @lir.sexp.push sm defines) (call @lir.sexp.push sm sm-sig) (call @lir.sexp.push sm sm-ps) (call @lir.sexp.push sm sm-blk)
      (call @lir.sexp.push out (call @lir.sexp.symbol (string "begin")))
      (call @lir.sexp.push out st) (call @lir.sexp.push out mk) (call @lir.sexp.push out sm)
      (ret out))))
(defpair pair %struct.pair pair.make pair.sum)
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n")
          (call @pair.sum (call @pair.make (i64 3) (i64 4)))
          (call @pair.sum (call @pair.make (i64 5) (i64 7))))
    (ret (i32 0))))
