;; expect: reject
;; error: 1:1: error: no main function
;; spec/lir.md 4.6: a library that requires module-hook-lib.lir, which arms a module macro, and then arms one of its own: required by a
;; module (reject-module-twice.lir) it is refused at its direction; read as a module of its own, the forms after its require are the first
;; macro's data, spliced back, and the spliced direction arms a macro that takes nothing: no main.
(require-macros "module-hook-lib.lir")
(define-macro pass-through2 (forms ...)
  (block entry
    (let ((out (call @lir.sexp.list (i64 0)))
          (n (call @lir.sexp.count forms)))
      (call @lir.sexp.push out (call @lir.sexp.symbol (string "begin")))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (step i2))))
      (br (icmp ult i n) step done)))
  (block step
    (let ((i2 (add i (i64 1))))
      (call @lir.sexp.push out (call @lir.sexp.nth forms i))
      (br loop)))
  (block done (ret out)))
(module-macro pass-through2)
