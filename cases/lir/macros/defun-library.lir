;; expect: accept
;; out: 6
;; out: hello
;; spec/lir.md 4.6: the macro library lib/lir/defun.lir, loaded relative to this file; defun with parameters and with none.
(require-macros "../../../lib/lir/defun.lir")
(declare printf i32 (ptr ...))
(defun add3 ((a i64) (b i64) (c i64)) -> i64
  (block entry (ret (add (add a b) c))))
(defun hello () -> void
  (block entry
    (call @printf (string "hello\n"))
    (ret)))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (call @add3 (i64 1) (i64 2) (i64 3)))
    (call @hello)
    (ret (i32 0))))
