;; expect: accept
;; out: 8 9
;; spec/lir.md 4.6, splices: (both A B) expands to (begin A B); here A is a define-macro and B a define that uses it, so a spliced
;; define-macro defines its macro for the forms after it, in the splice and after it.
(declare printf i32 (ptr ...))
(define-macro both (a b)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "begin")))
      (call @lir.sexp.push l a)
      (call @lir.sexp.push l b)
      (ret l))))
(both (define-macro twice (x)
        (block entry
          (let ((l (call @lir.sexp.list (i64 0))))
            (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
            (call @lir.sexp.push l x)
            (call @lir.sexp.push l x)
            (ret l))))
      (define (eight i32) () (block entry (ret (twice (i32 4))))))
(define (main i32) ()
  (block entry
    (call @printf (string "%d %d\n") (call @eight) (add (twice (i32 4)) (i32 1)))
    (ret (i32 0))))
