;; expect: reject
;; error: 14:1: error: define expects (NAME R), parameters and blocks
;; spec/lir.md 4.6: an expansion that is not valid lIR is the parser's error, at the position of the macro use (the forms a macro makes
;; carry none of their own). (broken NAME) expands to (define (NAME i32)), which has no parameters and no blocks.
(define-macro broken (name)
  (block entry
    (let ((def (call @lir.sexp.list (i64 0)))
          (sig (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push sig name)
      (call @lir.sexp.push sig (call @lir.sexp.symbol (string "i32")))
      (call @lir.sexp.push def (call @lir.sexp.symbol (string "define")))
      (call @lir.sexp.push def sig)
      (ret def))))
(broken f)
(define (main i32) () (block entry (ret (i32 0))))
