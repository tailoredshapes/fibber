;; expect: accept
;; out: 25
;; spec/lir.md 4.6: no hygiene, but a fresh name from lir.sexp.gensym each time: (sq X) expands to (let ((G X)) (mul G G)) with a new G,
;; so two uses in one function bind two names (a name is bound once per function, 5.3).
(declare printf i32 (ptr ...))
(define-macro sq (x)
  (block entry
    (let ((g (call @lir.sexp.gensym (string "sq")))
          (binding (call @lir.sexp.list (i64 0)))
          (bindings (call @lir.sexp.list (i64 0)))
          (mul (call @lir.sexp.list (i64 0)))
          (l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push binding g)
      (call @lir.sexp.push binding x)
      (call @lir.sexp.push bindings binding)
      (call @lir.sexp.push mul (call @lir.sexp.symbol (string "mul")))
      (call @lir.sexp.push mul g)
      (call @lir.sexp.push mul g)
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "let")))
      (call @lir.sexp.push l bindings)
      (call @lir.sexp.push l mul)
      (ret l))))
(define (main i32) ()
  (block entry
    (let ((a (sq (i32 3)))
          (b (sq (i32 4))))
      (call @printf (string "%d\n") (add a b))
      (ret (i32 0)))))
