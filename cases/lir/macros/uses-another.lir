;; expect: accept
;; out: 28
;; spec/lir.md 4.6: a macro whose expansion uses an earlier macro: (quad X) expands to (twice (twice X)), whose head is a macro again and
;; is expanded until none remains.
(declare printf i32 (ptr ...))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define-macro quad (x)
  (block entry
    (let ((inner (call @lir.sexp.list (i64 0)))
          (outer (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push inner (call @lir.sexp.symbol (string "twice")))
      (call @lir.sexp.push inner x)
      (call @lir.sexp.push outer (call @lir.sexp.symbol (string "twice")))
      (call @lir.sexp.push outer inner)
      (ret outer))))
(define (main i32) ()
  (block entry
    (call @printf (string "%d\n") (quad (i32 7)))
    (ret (i32 0))))
