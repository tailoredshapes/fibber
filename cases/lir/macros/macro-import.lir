;; expect: accept
;; out: 1 2 13
;; spec/lir.md 4.6: (macro-import "FILE") compiles a runtime module into the macro session: the macro tick calls its count-up, whose
;; global (in the module it imports) keeps state from one use to the next of the module's expansion; a second macro-import of the same
;; file is nothing; the module is not in the program (no @ticks, no @bump here).
(declare printf i32 (ptr ...))
(macro-import "macro-import-counter.lir")
(macro-import "./macro-import-counter.lir")
(define-macro tick (by)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l (call @lir.sexp.integer (call @count-up (call @lir.sexp.int by))))
      (ret l))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld %lld\n") (tick 0) (tick 0) (tick 10))
    (ret (i32 0))))
