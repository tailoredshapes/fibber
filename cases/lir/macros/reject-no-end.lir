;; expect: reject
;; error: 11:35: error: macro forever: the expansion does not end after 512 steps
;; spec/lir.md 4.6: a macro whose expansion is a use of itself is expanded 512 times and then refused.
(define-macro forever (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "forever")))
      (call @lir.sexp.push l x)
      (ret l))))
(define (main i32) ()
  (block entry (ret (i32 0)) (ret (forever (i32 1)))))
