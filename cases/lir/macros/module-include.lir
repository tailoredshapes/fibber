;; expect: accept
;; out: 5 16861 1004050613 111
;; spec/lir.md 4.6: an include met while a module macro is armed reads the file under the readtable and contributes its forms to the
;; collection, in its place, each naming the file it was read from; the include itself is not collected, a nested include acts the same
;; way, and a second include of the file (another spelling of the path) is nothing. census (module-include-lib.lir) is given, in order:
;; the declare (this file, file digit 1, line 10), part-a (module-include-part.lir, digit 6, line 4), nested (module-include-nested.lir,
;; digit 8, line 5), part-b (digit 6, line 6) and main (digit 1, line 13).
(REQUIRE-MACROS "module-include-lib.lir")
(MODULE-MACRO census)
(DECLARE printf I32 (PTR ...))
(INCLUDE "module-include-part.lir")
(INCLUDE "./module-include-part.lir")
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (CALL (GLOBAL census-count)) (CALL (GLOBAL census-files)) (CALL (GLOBAL census-lines))
      (ADD (CALL (GLOBAL part-a)) (ADD (CALL (GLOBAL nested)) (CALL (GLOBAL part-b)))))
    (RET (I32 0))))
