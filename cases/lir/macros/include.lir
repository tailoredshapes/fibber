;; expect: accept
;; out: 5 10
;; spec/lir.md 4.6: (include "FILE") reads the file's text in place: its forms are this module's, a macro defined here is used there, and
;; a second include of the same file is nothing.
(declare printf i32 (ptr ...))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(include "included-part.lir")
(include "./included-part.lir")
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n") (call @part) (call @doubled))
    (ret (i32 0))))
