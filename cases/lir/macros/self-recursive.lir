;; expect: accept
;; out: 10
;; spec/lir.md 4.6: a macro's body calls its own function: (sum-ints F) expands to (i64 N), N the sum of the integers in F at any
;; depth, the body recursing over the items of a list through @lir.macro.sum-ints itself.
(declare printf i32 (ptr ...))
(define-macro lit64 (v)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l v)
      (ret l))))
(define-macro sum-ints (f)
  (block entry
    (let ((tag (call @lir.sexp.tag f)))
      (br (icmp eq tag (i64 2)) int other)))
  (block int (ret (call @lir.macro.lit64 f)))
  (block other (br (icmp eq tag (i64 5)) list zero))
  (block zero (ret (call @lir.macro.lit64 (call @lir.sexp.integer (i64 0)))))
  (block list (br loop))
  (block loop
    (let ((i (phi i64 (list (i64 0)) (step i2)))
          (acc (phi i64 (list (i64 0)) (step acc2))))
      (br (icmp ult i (call @lir.sexp.count f)) step done)))
  (block step
    (let ((sub (call @lir.macro.sum-ints (call @lir.sexp.nth f i)))
          (acc2 (add acc (call @lir.sexp.int (call @lir.sexp.nth sub (i64 1)))))
          (i2 (add i (i64 1))))
      (br loop)))
  (block done (ret (call @lir.macro.lit64 (call @lir.sexp.integer acc)))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (sum-ints (1 (2 3) ((4)))))
    (ret (i32 0))))
