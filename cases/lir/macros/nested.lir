;; expect: accept
;; out: 20 14
;; spec/lir.md 4.6: a macro used inside a function body, and inside its own argument; the outer use is expanded first, then the inner one
;; in what it returned. (twice X) expands to (add X X).
(declare printf i32 (ptr ...))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define (main i32) ()
  (block entry
    (let ((a (twice (twice (i32 5))))
          (b (add (twice (i32 3)) (i32 8))))
      (call @printf (string "%d %d\n") a b)
      (ret (i32 0)))))
