;; expect: reject
;; error: 1:1: error: no main function
;; spec/lir.md 4.6: the macros of module-include.lir and module-include-rearm.lir. (census FORM ...) is a module macro: it splices the forms
;; back and appends three functions of what it was given: census-count, their number; census-files, a digit per form, 1 plus the length of
;; the form's file name less that of the first form's (the cases' files share a directory, so the digit tells the files apart: 1 the
;; module, 6 module-include-part.lir, 8 module-include-nested.lir); census-lines, the forms' lines, two digits each. Run alone it is a
;; library with no main.
(DEFINE-MACRO pair (a b)
  (BLOCK entry
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l a)
      (CALL (GLOBAL lir.sexp.push) l b)
      (RET l))))
(DEFINE-MACRO triple (a b c)
  (BLOCK entry (RET (CALL (GLOBAL lir.sexp.push) (CALL (GLOBAL lir.macro.pair) a b) c))))
(DEFINE-MACRO quad (a b c d)
  (BLOCK entry (RET (CALL (GLOBAL lir.sexp.push) (CALL (GLOBAL lir.macro.triple) a b c) d))))
;; (const-fn NAME V): (DEFINE (NAME I64) () (BLOCK entry (RET (I64 V))))
(DEFINE-MACRO const-fn (name v)
  (BLOCK entry
    (RET (CALL (GLOBAL lir.macro.quad)
           (CALL (GLOBAL lir.sexp.symbol) (STRING "DEFINE"))
           (CALL (GLOBAL lir.macro.pair) name (CALL (GLOBAL lir.sexp.symbol) (STRING "I64")))
           (CALL (GLOBAL lir.sexp.list) (I64 0))
           (CALL (GLOBAL lir.macro.triple)
             (CALL (GLOBAL lir.sexp.symbol) (STRING "BLOCK"))
             (CALL (GLOBAL lir.sexp.symbol) (STRING "entry"))
             (CALL (GLOBAL lir.macro.pair)
               (CALL (GLOBAL lir.sexp.symbol) (STRING "RET"))
               (CALL (GLOBAL lir.macro.pair) (CALL (GLOBAL lir.sexp.symbol) (STRING "I64")) v)))))))
(DEFINE-MACRO name-length (f)
  (BLOCK entry (RET (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.len) (CALL (GLOBAL lir.sexp.string) (CALL (GLOBAL lir.sexp.file) f)))))))
(DEFINE-MACRO census (forms ...)
  (BLOCK entry
    (LET ((out (CALL (GLOBAL lir.sexp.list) (I64 0)))
          (n (CALL (GLOBAL lir.sexp.count) forms))
          (base (CALL (GLOBAL lir.sexp.int) (CALL (GLOBAL lir.macro.name-length) (CALL (GLOBAL lir.sexp.nth) forms (I64 0))))))
      (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.sexp.symbol) (STRING "BEGIN")))
      (BR loop)))
  (BLOCK loop
    (LET ((i (PHI I64 (entry (I64 0)) (step i2)))
          (files (PHI I64 (entry (I64 0)) (step files2)))
          (lines (PHI I64 (entry (I64 0)) (step lines2))))
      (BR (ICMP ULT i n) step done)))
  (BLOCK step
    (LET ((f (CALL (GLOBAL lir.sexp.nth) forms i))
          (i2 (ADD i (I64 1)))
          (len (CALL (GLOBAL lir.sexp.int) (CALL (GLOBAL lir.macro.name-length) f)))
          (files2 (ADD (MUL files (I64 10)) (ADD (SUB len base) (I64 1))))
          (lines2 (ADD (MUL lines (I64 100)) (CALL (GLOBAL lir.sexp.line) f))))
      (CALL (GLOBAL lir.sexp.push) out f)
      (BR loop)))
  (BLOCK done
    (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.macro.const-fn) (CALL (GLOBAL lir.sexp.symbol) (STRING "census-count")) (CALL (GLOBAL lir.sexp.integer) n)))
    (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.macro.const-fn) (CALL (GLOBAL lir.sexp.symbol) (STRING "census-files")) (CALL (GLOBAL lir.sexp.integer) files)))
    (CALL (GLOBAL lir.sexp.push) out (CALL (GLOBAL lir.macro.const-fn) (CALL (GLOBAL lir.sexp.symbol) (STRING "census-lines")) (CALL (GLOBAL lir.sexp.integer) lines)))
    (RET out)))
