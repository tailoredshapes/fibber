;; expect: accept
;; out: 2211 2253
;; out: 2332 2369 2410 2448
;; out: 0 0 2575 2606
;; spec/lir.md 4.6: every form the reader makes carries its span, the byte offsets in the file of its first character and of the byte
;; after its last, read by lir.sexp.start and lir.sexp.end: (start-of X) and (end-of X) expand to them, (start-of-nth X I) and
;; (end-of-nth X I) to those of the I-th item of a list. Line 2: the list (a (b c) "q\"x"), its end after the closing paren. Line 3: its
;; items (b c) and "q\"x", the string's span its text as written, quotes and escape included (6 bytes for 3). Line 4: what a macro made
;; has no span, 0 and 0, and keeps none through lir.sexp.expand ((mk) is a list mk made), while a form a macro passed through keeps the
;; text's ((id (p q)) is the (p q) written in it).
(DECLARE printf I32 (PTR ...))
(DEFINE-MACRO lit64 (v)
  (BLOCK entry
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l (CALL (GLOBAL lir.sexp.symbol) (STRING "I64")))
      (CALL (GLOBAL lir.sexp.push) l v)
      (RET l))))
(DEFINE-MACRO start-of (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.start) x))))))
(DEFINE-MACRO end-of (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.end) x))))))
(DEFINE-MACRO start-of-nth (x i)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.start-of) (CALL (GLOBAL lir.sexp.nth) x (CALL (GLOBAL lir.sexp.int) i))))))
(DEFINE-MACRO end-of-nth (x i)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.end-of) (CALL (GLOBAL lir.sexp.nth) x (CALL (GLOBAL lir.sexp.int) i))))))
(DEFINE-MACRO mk ()
  (BLOCK entry (RET (CALL (GLOBAL lir.sexp.push) (CALL (GLOBAL lir.sexp.list) (I64 0)) (CALL (GLOBAL lir.sexp.symbol) (STRING "made"))))))
(DEFINE-MACRO id (x) (BLOCK entry (RET x)))
(DEFINE-MACRO expanded-start (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.start-of) (CALL (GLOBAL lir.sexp.expand) x)))))
(DEFINE-MACRO expanded-end (x)
  (BLOCK entry (RET (CALL (GLOBAL lir.macro.end-of) (CALL (GLOBAL lir.sexp.expand) x)))))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "%lld %lld\n") (start-of (a (b c) "q\"x")) (end-of (a (b c) "q\"x")))
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (start-of-nth (a (b c) "q\"x") 1) (end-of-nth (a (b c) "q\"x") 1)
      (start-of-nth (a (b c) "q\"x") 2) (end-of-nth (a (b c) "q\"x") 2))
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (expanded-start (mk)) (expanded-end (mk)) (expanded-start (id (p q))) (expanded-end (id (p q))))
    (RET (I32 0))))
