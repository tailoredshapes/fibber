;; expect: accept
;; out: 1
;; spec/lir.md 4.6: lir.sexp.set is the dual of nth: (zero-second F) replaces item 2 of the list F by (i32 0) in place and returns F;
;; an index out of range changes nothing.
(declare printf i32 (ptr ...))
(define-macro zero-second (f)
  (block entry
    (let ((z (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push z (call @lir.sexp.symbol (string "i32")))
      (call @lir.sexp.push z (call @lir.sexp.integer (i64 0)))
      (call @lir.sexp.set f (i64 9) z)
      (ret (call @lir.sexp.set f (i64 2) z)))))
(define (main i32) ()
  (block entry
    (call @printf (string "%d\n") (zero-second (add (i32 1) (i32 2))))
    (ret (i32 0))))
