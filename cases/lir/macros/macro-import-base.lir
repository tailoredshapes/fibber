;; expect: reject
;; error: 1:1: error: no main function
;; spec/lir.md 4.6: a runtime module macro-import-counter.lir imports: a global and a function over it; run alone it is no program.
(global ticks i64 (i64 0))
(define (bump i64) ()
  (block entry
    (let ((n (add (load i64 @ticks) (i64 1))))
      (store n @ticks)
      (ret n))))
