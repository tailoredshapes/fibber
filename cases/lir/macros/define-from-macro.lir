;; expect: accept
;; out: 42
;; spec/lir.md 4.6: a macro whose expansion is a top-level define; the function it defines is called and runs on both paths.
;; (defconst NAME T V) expands to (define (NAME T) () (block entry (ret (T V)))).
(declare printf i32 (ptr ...))
(define-macro defconst (name ty v)
  (block entry
    (let ((def (call @lir.sexp.list (i64 0)))
          (sig (call @lir.sexp.list (i64 0)))
          (blk (call @lir.sexp.list (i64 0)))
          (lit (call @lir.sexp.list (i64 0)))
          (r (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push lit ty)
      (call @lir.sexp.push lit v)
      (call @lir.sexp.push r (call @lir.sexp.symbol (string "ret")))
      (call @lir.sexp.push r lit)
      (call @lir.sexp.push blk (call @lir.sexp.symbol (string "block")))
      (call @lir.sexp.push blk (call @lir.sexp.symbol (string "entry")))
      (call @lir.sexp.push blk r)
      (call @lir.sexp.push sig name)
      (call @lir.sexp.push sig ty)
      (call @lir.sexp.push def (call @lir.sexp.symbol (string "define")))
      (call @lir.sexp.push def sig)
      (call @lir.sexp.push def (call @lir.sexp.list (i64 0)))
      (call @lir.sexp.push def blk)
      (ret def))))
(defconst forty-two i32 42)
(define (main i32) ()
  (block entry
    (call @printf (string "%d\n") (call @forty-two))
    (ret (i32 0))))
