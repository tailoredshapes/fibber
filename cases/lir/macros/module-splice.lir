;; expect: accept
;; out: 1 8
;; spec/lir.md 4.6: the module macro's splice may hold directions and macro uses: with-import prepends (import "gensym-a.lir") to the
;; forms, and main, collected unexpanded, uses twice, defined before the direction; both take effect when the splice is expanded.
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define-macro with-import (forms ...)
  (block entry
    (let ((out (call @lir.sexp.list (i64 0)))
          (imp (call @lir.sexp.list (i64 0)))
          (n (call @lir.sexp.count forms)))
      (call @lir.sexp.push imp (call @lir.sexp.symbol (string "import")))
      (call @lir.sexp.push imp (call @lir.sexp.string (string "gensym-a.lir")))
      (call @lir.sexp.push out (call @lir.sexp.symbol (string "begin")))
      (call @lir.sexp.push out imp)
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (step i2))))
      (br (icmp ult i n) step done)))
  (block step
    (let ((i2 (add i (i64 1))))
      (call @lir.sexp.push out (call @lir.sexp.nth forms i))
      (br loop)))
  (block done (ret out)))
(module-macro with-import)
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %d\n") (call @a-value) (twice (i32 4)))
    (ret (i32 0))))
