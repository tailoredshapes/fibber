;; expect: reject
;; error: 12:41: error: macro twice expects 1 argument, found 2
;; spec/lir.md 4.6: a macro with no rest parameter takes exactly its parameters' count of arguments.
(declare printf i32 (ptr ...))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define (main i32) () (block entry (ret (twice (i32 1) (i32 2)))))
