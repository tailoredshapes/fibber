;; expect: reject
;; error: 12:34: error: macro both: a splice (begin ..) is a top-level form, not an instruction
;; spec/lir.md 4.6, splices: a macro used inside a function whose result is a splice is refused at the use.
(define-macro both (a b)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "begin")))
      (call @lir.sexp.push l a)
      (call @lir.sexp.push l b)
      (ret l))))
(define (main i32) ()
  (block entry (ret (add (i32 0) (both (i32 1) (i32 2))))))
