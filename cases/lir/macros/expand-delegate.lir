;; expect: accept
;; out: 3 2
;; spec/lir.md 4.6: lir.sexp.expand expands a form through the module's macros from inside a macro: (count-after F) expands to (i64 N), N
;; the count of the list F expands to; (twice X) is (add X X), three items, and (count-after ..) itself expands to (i64 N), two.
(declare printf i32 (ptr ...))
(define-macro lit64 (v)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "i64")))
      (call @lir.sexp.push l v)
      (ret l))))
(define-macro twice (x)
  (block entry
    (let ((l (call @lir.sexp.list (i64 0))))
      (call @lir.sexp.push l (call @lir.sexp.symbol (string "add")))
      (call @lir.sexp.push l x)
      (call @lir.sexp.push l x)
      (ret l))))
(define-macro count-after (f)
  (block entry
    (let ((e (call @lir.sexp.expand f)))
      (br (icmp eq e (ptr null)) failed ok)))
  (block failed (ret (ptr null)))
  (block ok (ret (call @lir.macro.lit64 (call @lir.sexp.integer (call @lir.sexp.count e))))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n") (count-after (twice (i32 5))) (count-after (count-after (twice (i32 5)))))
    (ret (i32 0))))
