;; expect: accept
;; out: 1 2
;; spec/lir.md 4.6 and 4.7: two modules whose own macros each splice a function named by a gensym of the same prefix: the counter is the
;; program's (one per process), so the two names differ and the program links; with a counter per session both would be box.1.
(import "gensym-a.lir")
(import "gensym-b.lir")
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld %lld\n") (call @a-value) (call @b-value))
    (ret (i32 0))))
