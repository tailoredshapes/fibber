;; spec/lir.md 4.6: a runtime module that macro-import.lir macro-imports: it imports macro-import-base.lir (macro-imported into the same
;; session) and defines count-up over it; run alone it is no program.
(import "macro-import-base.lir")
(define (count-up i64) ((i64 by))
  (block entry
    (let ((n (call @bump)))
      (ret (add n by)))))
