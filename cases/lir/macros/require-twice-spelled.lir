;; expect: accept
;; out: 6
;; spec/lir.md 4.6: a library required twice through two spellings of its path is one library, loaded once (no `duplicate macro defun`):
;; the file is identified by its canonical path, not by the text written.
(require-macros "../../../lib/lir/defun.lir")
(require-macros "../macros/../../../lib/./lir/defun.lir")
(declare printf i32 (ptr ...))
(defun add3 ((a i64) (b i64) (c i64)) -> i64
  (block entry (ret (add (add a b) c))))
(define (main i32) ()
  (block entry
    (call @printf (string "%lld\n") (call @add3 (i64 1) (i64 2) (i64 3)))
    (ret (i32 0))))
