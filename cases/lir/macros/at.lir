;; expect: accept
;; out: 0 1
;; out: 44 91 2892 2920
;; spec/lir.md 4.6: (lir.sexp.at made orig) gives made orig's position and span (line, column, file, start, end) and returns made, so a
;; macro that rebuilds a form keeps where it was written. (copied X) is a fresh list of X's items, at X: line 2 is the sum of a fresh
;; list's line, column, start and end (0: a made form has none) and whether lir.sexp.at returned the made list and gave it X's file (1);
;; line 3: the copy of the list (p (q r)) on the line of main's second call: its line, column, start and end, the list's.
(DECLARE printf I32 (PTR ...))
(DEFINE-MACRO lit64 (v)
  (BLOCK entry
    (LET ((l (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (CALL (GLOBAL lir.sexp.push) l (CALL (GLOBAL lir.sexp.symbol) (STRING "I64")))
      (CALL (GLOBAL lir.sexp.push) l v)
      (RET l))))
(DEFINE-MACRO copied (x)
  (BLOCK entry
    (LET ((made (CALL (GLOBAL lir.sexp.list) (I64 0))) (n (CALL (GLOBAL lir.sexp.count) x)))
      (BR loop)))
  (BLOCK loop
    (LET ((i (PHI I64 (entry (I64 0)) (step i2))))
      (BR (ICMP ULT i n) step done)))
  (BLOCK step
    (LET ((i2 (ADD i (I64 1))))
      (CALL (GLOBAL lir.sexp.push) made (CALL (GLOBAL lir.sexp.nth) x i))
      (BR loop)))
  (BLOCK done (RET (CALL (GLOBAL lir.sexp.at) made x))))
(DEFINE-MACRO fresh-sum (x)
  (BLOCK entry
    (LET ((m (CALL (GLOBAL lir.sexp.list) (I64 0))))
      (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer)
        (ADD (ADD (CALL (GLOBAL lir.sexp.line) m) (CALL (GLOBAL lir.sexp.column) m)) (ADD (CALL (GLOBAL lir.sexp.start) m) (CALL (GLOBAL lir.sexp.end) m)))))))))
(DEFINE-MACRO same (x)
  (BLOCK entry
    (LET ((m (CALL (GLOBAL lir.sexp.list) (I64 0))) (c (CALL (GLOBAL lir.sexp.at) m x)))
      (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer)
        (ZEXT I64 (AND (ICMP EQ c m) (ICMP EQ (CALL (GLOBAL lir.sexp.file) m) (CALL (GLOBAL lir.sexp.file) x))))))))))
(DEFINE-MACRO line-of (x) (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.line) (CALL (GLOBAL lir.macro.copied) x)))))))
(DEFINE-MACRO column-of (x) (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.column) (CALL (GLOBAL lir.macro.copied) x)))))))
(DEFINE-MACRO start-of (x) (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.start) (CALL (GLOBAL lir.macro.copied) x)))))))
(DEFINE-MACRO end-of (x) (BLOCK entry (RET (CALL (GLOBAL lir.macro.lit64) (CALL (GLOBAL lir.sexp.integer) (CALL (GLOBAL lir.sexp.end) (CALL (GLOBAL lir.macro.copied) x)))))))
(DEFINE (main I32) ()
  (BLOCK entry
    (CALL (GLOBAL printf) (STRING "%lld %lld\n") (fresh-sum (p)) (same (p (q r))))
    (CALL (GLOBAL printf) (STRING "%lld %lld %lld %lld\n") (line-of (p (q r))) (column-of (p (q r))) (start-of (p (q r))) (end-of (p (q r))))
    (RET (I32 0))))
