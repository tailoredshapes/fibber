;; expect: reject
;; error: 11:53: error: macro needs-list: expected a list
;; spec/lir.md 4.6: a macro reports an error through lir.sexp.fail, at the form it names (here its argument), and the expansion stops.
(define-macro needs-list (x)
  (block entry
    (br (icmp eq (call @lir.sexp.tag x) (i64 5)) ok bad))
  (block bad
    (ret (call @lir.sexp.fail x (string "expected a list"))))
  (block ok
    (ret x)))
(define (main i32) () (block entry (ret (needs-list 1))))
