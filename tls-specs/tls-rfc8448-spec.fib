;; The TLS 1.3 client against the traces of RFC 8448, byte for byte, through a real crypto provider (the OpenSSL driver) wrapped in a deterministic decorator
;; (tls-det): the client's private keys and the ClientHello the RFC lists are the inputs; the server's records (plaintext ServerHello, HelloRetryRequest, the AEAD-
;; protected flight) are fed as the byte stream; the assertions are every secret of the key schedule, the Finished verify_data, and the EXACT bytes the client
;; wrote (ClientHello record, [second ClientHello record], client Finished record). The certificate hooks are replaced (the RFC's certificate is an RSA-1024 key, which
;; fib.tls refuses): the Finished messages still cover the whole transcript, so a wrong transcript, label or key is caught. Run by scripts/tls-test.sh with the driver.
(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.crypto.types fib.tls.types fib.tls.bytes fib.tls.msg fib.tls.pem fib.tls.x509 fib.tls.hello
               fib.tls.record fib.tls.keys fib.tls.hs fib.tls.hs-flight tls-det tls-trace-data)
  (:require [fib.crypto :as c] [fib.crypto.openssl :as openssl]))

(defun provider () -> Det (match (openssl/open-provider) ((Ok p) (det (dyn CryptoProvider :send p))) ((Err e) (trap (. e message)))))
(defun th (name: str) -> (Array i8) (hexb (trace-hex name)))
(defun diff (what: str expected: (Array i8) actual: (Array i8)) -> str
  (if (bytes-eq? expected actual) "" (str what " differs: expected " (hex-of expected) " got " (hex-of actual) "; ")))

;; ---- the byte stream: what the server sent, and what the client wrote
(defstruct Feed (data: (Array i8) pos: (Cell i64) sink: (Cell (Array i8))))
(defun feed-io (data: (Array i8)) -> (Pair Io Feed)
  (let [f (Feed data (cell 0) (cell (empty-bytes)))]
    (Pair (Io (fn (n: i64) (let [pos @(. f pos) k (min n (- (array-len (. f data)) pos))] (do (set! (. f pos) (+ pos k)) (Ok (slice (. f data) pos (+ pos k))))))
              (fn (b: (Array i8)) (do (set! (. f sink) (cat [@(. f sink) b])) (Ok ()))) (fn () ()) (fn (at: i64) ()))
          f)))

(defun accept-all () -> Hooks (Hooks (fn (certs: (Vec Cert)) (Ok (nth certs 0))) (fn (spki: (Array i8) s: keyword content: (Array i8) sig: (Array i8)) (Ok ()))))
(defun pkcs8-p256 (raw: (Array i8)) -> (Array i8) (cat [(hexb "3041020100301306072a8648ce3d020106082a8648ce3d030107042730250201010420") raw]))
(defun the-offer () -> Offer (Offer [suite-aes-128-gcm-sha256 suite-chacha20-poly1305-sha256 suite-aes-256-gcm-sha384] [:x25519 :p-256 :p-384] (cv-algs) (cert-algs)))
(defun cfg () -> ClientConfig (client-config "server" (empty-trust) (fn () 0)))
(defun record-of (version: i64 body: (Array i8)) -> (Array i8) (cat [(w8 22) (w16 version) (vec16 body)]))

;; ---- the ClientHello of RFC 8448 3, laid out with this library's extension encoders
(def sigs-8448: (Vec i64) [1027 1283 1539 515 2052 2053 2054 1025 1281 1537 513 1026 1282 1538 514])
(defun hello-8448 (random: (Array i8) group: i64 pub: (Array i8) groups: (Vec i64) simple: bool cookie: (Option (Array i8)) padding: bool) -> (Array i8)
  (client-hello random (empty-bytes) [suite-aes-128-gcm-sha256 suite-chacha20-poly1305-sha256 suite-aes-256-gcm-sha384]
    (vec (concat (concat (concat [(ext-server-name "server") (ext 65281 (hexb "00")) (ext-supported-groups groups)]
                                 (if simple [(ext 35 (empty-bytes))] []))
                         [(ext-key-share-client [(Pair group pub)]) (ext-supported-versions-client [772]) (ext-signature-algorithms sigs-8448)])
                 (concat (match cookie (nil []) ((some ck) [(ext-cookie ck)]))
                         (concat [(ext 45 (hexb "0101")) (ext 28 (hexb "4001"))] (if padding [(ext 21 (zeros 175))] [])))))))

(defun trace-diffs (t: Trace pre: str) -> str
  (str (diff "shared secret" (th (str pre "-shared")) (. t shared)) (diff "handshake secret" (th (str pre "-handshake-secret")) (. t handshake))
       (diff "client handshake traffic secret" (th (str pre "-c-hs")) (. t c-hs)) (diff "server handshake traffic secret" (th (str pre "-s-hs")) (. t s-hs))
       (diff "master secret" (th (str pre "-master")) (. t master)) (diff "client application traffic secret" (th (str pre "-c-ap")) (. t c-ap))
       (diff "server application traffic secret" (th (str pre "-s-ap")) (. t s-ap)) (diff "client Finished verify_data" (th (str pre "-client-finished")) (. t client-finished))))

(defun import-x25519 (p: Det raw: (Array i8)) -> (dyn PrivateKey :send)
  (match (c/wrap-private :x25519 raw) ((Err e) (trap (. e message)))
    ((Ok pk) (match (c/import-private-key p :x25519 pk) ((Ok k) k) ((Err e) (trap (. e message)))))))

;; ---- section 3: simple 1-RTT
(defun the-random (hello: (Array i8)) -> (Array i8) (slice hello 6 38))
(defun s3-hello (p: Det) -> (Array i8)
  (let [k (import-x25519 p (th "s3-client-private"))]
    (match (private-key-public k) ((Ok pub) (do (private-key-close k) (hello-8448 (the-random (th "s3-client-hello")) 29 pub [29 23 24 25 256 257 258 259 260] true nil false))) ((Err _) (empty-bytes)))))
(defun run-s3 (p: Det) -> str
  (let [ch (th "s3-client-hello") key (import-x25519 p (th "s3-client-private")) fio (feed-io (cat [(th "s3-server-hello-record") (th "s3-server-flight-record")]))
        st (Start ch (empty-bytes) 29 :x25519 (the-offer) false [28] (fn (g: i64 pb: (Array i8) ck: (Option (Array i8))) (empty-bytes)))
        hs (new-hs (cfg) (. fio fst) (accept-all) st key)]
    (match (run-handshake p hs)
      ((Err e) (str "handshake: " (tls-error-text e)))
      ((Ok d) (str (trace-diffs (. d trace) "s3")
                   (diff "bytes written" (cat [(record-of 769 ch) (th "s3-client-finished-record")]) @(. (. fio snd) sink))
                   (if (= (. (. d suite) id) suite-aes-128-gcm-sha256) "" "wrong suite; "))))))

;; ---- section 5: HelloRetryRequest (X25519 offered, P-256 chosen, a cookie echoed)
(defun hello-1-s5 (p: Det) -> (Array i8)
  (let [k (import-x25519 p (th "s5-client-private-x25519"))]
    (match (private-key-public k) ((Ok pub) (do (private-key-close k) (hello-8448 (the-random (th "s5-client-hello-1")) 29 pub [29 23 24] false nil false))) ((Err _) (empty-bytes)))))
(defun run-s5 (p: Det) -> str
  (do (queue-key p :p-256 (pkcs8-p256 (th "s5-client-private-p256")))
      (let [ch1 (th "s5-client-hello-1") random (the-random ch1) key (import-x25519 p (th "s5-client-private-x25519"))
            fio (feed-io (cat [(th "s5-hrr-record") (th "s5-server-hello-record") (th "s5-server-flight-record")]))
            st (Start ch1 (empty-bytes) 29 :x25519 (the-offer) false [28] (fn (g: i64 pb: (Array i8) ck: (Option (Array i8))) (hello-8448 random g pb [29 23 24] false ck true)))
            hs (new-hs (cfg) (. fio fst) (accept-all) st key)]
        (match (run-handshake p hs)
          ((Err e) (str "handshake: " (tls-error-text e)))
          ((Ok d) (str (trace-diffs (. d trace) "s5")
                       (diff "bytes written" (cat [(record-of 769 ch1) (th "s5-client-hello-2-record") (th "s5-client-finished-record")]) @(. (. fio snd) sink))))))))

;; ---- what the decorated provider is: the RFC's X25519 public key comes out of the RFC's private key
(defun the-keys (p: Det) -> str
  (let [k (import-x25519 p (th "s3-client-private"))]
    (match (private-key-public k)
      ((Ok pub) (do (private-key-close k) (diff "the X25519 public key of the ClientHello" (slice (th "s3-client-hello") 0 0) (slice (empty-bytes) 0 0))
                    (if (>= (index-sub (th "s3-client-hello") pub) 0) "" "the public key is not in the ClientHello; ")))
      ((Err e) (. e message)))))
(defun index-sub (hay: (Array i8) needle: (Array i8)) -> i64
  (loop [i 0] (cond (> (+ i (array-len needle)) (array-len hay)) -1 (bytes-eq? needle (slice hay i (+ i (array-len needle)))) i :else (recur (+ i 1)))))

(defspecs specs
  (feature "RFC 8448 section 3: the simple 1-RTT handshake, byte for byte"
    (scenario "the ClientHello is laid out byte for byte by the library's encoders"
      (given [p (provider)])
      (then (expect = "" (diff "ClientHello" (th "s3-client-hello") (s3-hello p)))))
    (scenario "the RFC's X25519 public key is derived from its private key" (given [p (provider)]) (then (expect = "" (the-keys p))))
    (scenario "every secret, the Finished verify_data and the bytes written equal the trace" (given [p (provider)]) (then (expect = "" (run-s3 p)))))
  (feature "RFC 8448 section 5: HelloRetryRequest"
    (scenario "the first ClientHello is laid out byte for byte"
      (given [p (provider)])
      (then (expect = "" (diff "ClientHello 1" (th "s5-client-hello-1") (hello-1-s5 p)))))
    (scenario "after the retry every secret, the Finished verify_data and the bytes written (both ClientHellos, the Finished) equal the trace"
      (given [p (provider)]) (then (expect = "" (run-s5 p))))))

(defun main () -> i64 (run-main (specs)))
