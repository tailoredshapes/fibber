;; The fibber half of scripts/dns-diff.sh: resolves each argument with the native resolver (fib.dns, the host's /etc/resolv.conf and /etc/hosts) and prints
;; "name: addr addr .." (the addresses sorted, IPv4 then IPv6) or "name: ERR kind". `dns-resolve NAME..`
(ns main (:use fib.core fib.seq fib.coll fib.dns) (:require [fib.os.errors :as os]))
(defun show (r: (Result (Vec str) os/OSError)) -> str
  (match r
    ((Ok xs) (str-join (mapv (fn (a: str) (str a " ")) (vec (sort xs)))))
    ((Err e) (str "ERR " (if (= (. e kind) os/NotFound) "notfound" (if (= (. e kind) os/TimedOut) "timeout" "other"))))))
(defun main () -> i64
  (let [r (system-resolver)]
    (do (dotimes (i (count (args))) (println (str (nth (args) i) ": " (show (resolve-host r (nth (args) i))))))
        0)))
