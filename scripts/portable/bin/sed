#!/bin/sh
# sed shim for macOS: GNU `sed -i SCRIPT FILE` (and `-i -E`, `-i -e`) means in place with no backup; BSD sed takes the next word as the backup
# suffix (`sed -i -E s/x/y/ f` silently makes a backup named f-E and does not edit). A lone -i gets the empty suffix BSD wants; `-i.bak` and every
# other word pass unchanged.
n=$#
while [ "$n" -gt 0 ]; do
  a=$1; shift; n=$((n - 1))
  if [ "$a" = -i ]; then set -- "$@" -i ''; else set -- "$@" "$a"; fi
done
exec /usr/bin/sed "$@"
