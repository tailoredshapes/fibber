#!/usr/bin/env python3
# flock shim for macOS: `flock [-n] [-x|-s] [-w SECS] FILE COMMAND [ARG]...`, `flock [-n] FILE -c 'COMMAND'` and `flock [-n] FD`
# (the lock goes on the open file description of FD, which the calling shell shares). -n: exit 1 at once when the lock is taken; -w: give up after SECS (exit 1).
import fcntl, os, sys, time

a, mode, nb, wait = sys.argv[1:], fcntl.LOCK_EX, False, None
while a and a[0].startswith('-') and a[0] != '--':
    o = a.pop(0)
    if o in ('-n', '--nb', '--nonblock'): nb = True
    elif o in ('-x', '-e', '--exclusive'): mode = fcntl.LOCK_EX
    elif o in ('-s', '--shared'): mode = fcntl.LOCK_SH
    elif o in ('-u', '--unlock'): mode = fcntl.LOCK_UN
    elif o in ('-w', '--timeout'): wait = float(a.pop(0))
    elif o in ('-o', '--close', '-F', '--no-fork'): pass
    else: sys.stderr.write('flock: unknown option %s\n' % o); sys.exit(64)
if not a: sys.stderr.write('flock: usage: flock [-n] [-w SECS] FILE|FD [-c] COMMAND\n'); sys.exit(64)
target = a.pop(0)
if not a and target.isdigit(): fd, own = int(target), False
else:
    try: fd, own = os.open(target, os.O_RDONLY if os.path.isdir(target) else os.O_RDONLY | os.O_CREAT, 0o666), True
    except OSError as e: sys.stderr.write('flock: cannot open lock file %s: %s\n' % (target, e.strerror)); sys.exit(1)
end = time.time() + wait if wait is not None else None
while True:
    try: fcntl.flock(fd, mode | (fcntl.LOCK_NB if nb or end else 0)); break
    except OSError:
        if nb or (end and time.time() >= end): sys.exit(1)
        time.sleep(0.05)
if not a: sys.exit(0)
if a[0] in ('-c', '--command'): a = ['/bin/sh', '-c', a[1]]
if own: os.set_inheritable(fd, True)
try: os.execvp(a[0], a)
except FileNotFoundError: sys.stderr.write('flock: failed to execute %s: No such file or directory\n' % a[0]); sys.exit(127)
