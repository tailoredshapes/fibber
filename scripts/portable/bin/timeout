#!/usr/bin/perl
# timeout shim for macOS (no GNU coreutils): `timeout [-k KILL_AFTER] [-s SIGNAL] [--foreground] [--preserve-status] DURATION COMMAND [ARG]...`.
# Runs COMMAND with this process's stdin, stdout and stderr; after DURATION (a number with an optional s, m, h or d) sends SIGNAL (default TERM) to it,
# and KILL_AFTER later SIGKILL; exits 124 on a timeout, else COMMAND's status (128+N when a signal killed it), 125 for a bad call, 127 when it is not found.
# Perl, not Python: the golden and case scripts call `timeout` once per input (thousands of times in a gate) and Python 3.14's start-up plus
# `import subprocess` cost 37 ms a call on the M1 Ultra, perl 5 ms (docs/design/gate-profile.md, Mac).
use strict;
use warnings;
use POSIX ();
use Time::HiRes ();

sub usage { print STDERR "timeout: usage: timeout [-k D] [-s SIG] DURATION COMMAND [ARG]...\n"; exit 125; }

sub dur {
    my ($s) = @_;
    my %mult = (s => 1, m => 60, h => 3600, d => 86400);
    return $s =~ /^(\d+(?:\.\d*)?|\.\d+)([smhd]?)$/ ? $1 * ($2 eq '' ? 1 : $mult{$2}) : usage();
}

sub signum {
    my ($n) = @_;
    return $n + 0 if $n =~ /^\d+$/;
    $n = uc $n;
    $n =~ s/^SIG//;
    my %num = (HUP => 1, INT => 2, QUIT => 3, KILL => 9, USR1 => 30, USR2 => 31, ALRM => 14, TERM => 15, CONT => 19, STOP => 17);
    return $num{$n} // usage();
}

my @a = @ARGV;
my ($sig, $ka) = (15, undef);
while (@a && $a[0] =~ /^-/ && $a[0] ne '--') {
    my $o = shift @a;
    if ($o eq '-k' || $o eq '--kill-after') { usage() unless @a; $ka = dur(shift @a); }
    elsif ($o =~ /^--kill-after=(.*)$/) { $ka = dur($1); }
    elsif ($o eq '-s' || $o eq '--signal') { usage() unless @a; $sig = signum(shift @a); }
    elsif ($o =~ /^--signal=(.*)$/) { $sig = signum($1); }
    elsif ($o eq '--foreground' || $o eq '--preserve-status' || $o eq '-v' || $o eq '--verbose') { }
    else { usage(); }
}
shift @a if @a && $a[0] eq '--';
usage() unless @a >= 2;
my $d = dur(shift @a);
$ka = undef if defined $ka && $ka == 0;

my $pid = fork();
defined $pid or do { print STDERR "timeout: fork failed\n"; exit 125; };
if ($pid == 0) {
    { no warnings 'exec'; exec { $a[0] } @a; }
    my $err = $!;
    print STDERR "timeout: failed to run command $a[0]: $err\n";
    POSIX::_exit($err == POSIX::EACCES() ? 126 : 127);
}

my $timed_out = 0;
my $killed = 0;
for my $s (qw(INT TERM HUP)) {   # a signal to the shim goes on to the command, as timeout(1) does
    $SIG{$s} = sub { kill $_[0], $pid };
}
$SIG{ALRM} = sub {
    if (!$timed_out) {
        $timed_out = 1;
        kill $sig, $pid;
        Time::HiRes::alarm($ka) if defined $ka;
    } else {
        $killed = 1;
        kill 'KILL', $pid;
    }
};
Time::HiRes::alarm($d) if $d > 0;

my $st;
while (1) {
    my $r = waitpid($pid, 0);
    if ($r == $pid) { $st = $?; last; }
    next if $r == -1 && $!{EINTR};
    $st = 0; last;
}
my $rc = $st & 127 ? 128 + ($st & 127) : $st >> 8;
exit($timed_out ? 124 : $rc);
