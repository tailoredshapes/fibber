#!/usr/bin/env python3
# date shim for macOS: BSD date has no %N (it prints the letter N). A format with %N gets the nanoseconds (and %s the seconds) of one reading of the
# clock put in as text; everything else is /bin/date's.
import os, sys, time
a = sys.argv[1:]
if any('%N' in x for x in a):
    sec, frac = divmod(time.time_ns(), 10**9)
    a = [x.replace('%s', str(sec)).replace('%N', '%09d' % frac) if x.startswith('+') else x for x in a]
os.execv('/bin/date', ['date'] + a)
