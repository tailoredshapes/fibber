#!/usr/bin/env python3
# md5sum shim for macOS (`md5sum [FILE]...`, standard input for none or `-`): prints `HASH  NAME` as md5sum does.
import hashlib, sys
rc = 0
for f in sys.argv[1:] or ['-']:
    try:
        h = hashlib.md5(); fh = sys.stdin.buffer if f == '-' else open(f, 'rb')
        for b in iter(lambda: fh.read(1 << 20), b''): h.update(b)
        print('%s  %s' % (h.hexdigest(), f))
    except OSError as e: sys.stderr.write('md5sum: %s: %s\n' % (f, e.strerror)); rc = 1
sys.exit(rc)
