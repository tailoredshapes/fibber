#!/bin/sh
# make shim for macOS: /usr/bin/make is GNU Make 3.81, which the Makefile refuses, and the scripts of the gate call `make`. Under gmake (MAKE is exported by
# mk/config.mk) this runs that same gmake; by hand it runs gmake from PATH, else the system make (which then says what is wrong).
m=${MAKE:-gmake}
case $m in make|*/portable/bin/make) m=gmake ;; esac
if command -v "$m" > /dev/null 2>&1; then exec "$m" "$@"; fi
exec /usr/bin/make "$@"
