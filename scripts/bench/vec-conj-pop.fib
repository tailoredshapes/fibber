;; bench: Vec conj 20e6 elements, then pop them all back, summing what peek sees
(ns main)
(defun main () -> i64
  (let [n 20000000
        v0: (Vec i64) []
        v (loop [i 0 v v0] (if (>= i n) v (recur (+ i 1) (conj v (rem (* i 31) 1009)))))
        r (loop [v v acc 0] (if (= (count v) 0) acc (recur (pop v) (+ acc (unwrap (peek v))))))]
    (do (println (count v) r) 0)))
