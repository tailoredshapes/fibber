;; bench: the known finding. (Set i64): conj N keys, then disj N/2 of them. N = 20000 here because the cost is
;; quadratic (`dissoc` counts the whole trie twice per call: mnode-count in lib/prelude.fib); 220000 takes minutes.
(ns main)
(defun main () -> i64
  (let [n 20000
        s0: (Set i64) #{}
        s1 (loop [i 0 s s0] (if (>= i n) s (recur (+ i 1) (conj s (rem (* i 7919) 1000003)))))
        s2 (loop [i 0 s s1] (if (>= i n) s (recur (+ i 2) (disj s (rem (* i 7919) 1000003)))))]
    (do (println (count s1) (count s2) (reduce + 0 s2)) 0)))
