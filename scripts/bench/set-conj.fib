;; bench: (Set i64): 1e6 conj of pseudo-random keys (about 1e6 distinct), then 1e6 contains? probes; checksum = count and hits
(ns main)
(defun main () -> i64
  (let [n 1000000
        s0: (Set i64) #{}
        s (loop [i 0 s s0] (if (>= i n) s (recur (+ i 1) (conj s (rem (* i 7919) 1000003)))))
        h (loop [i 0 acc 0] (if (>= i n) acc (recur (+ i 1) (if (contains? s i) (+ acc 1) acc))))]
    (do (println (count s) h) 0)))
