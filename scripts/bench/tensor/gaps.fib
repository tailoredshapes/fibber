;; Micro benchmarks of the tensor-library gaps that docs/shootout/autodiff.md found, AFTER the new functions (the rows grow with each commit of the series; gaps-before.fib times the old ways):
;;   F build scripts/bench/tensor/gaps.fib -I lib -o ga && flock /tmp/fibsuite.lock taskset -c 3 ./ga
;; Each row is the median of 5 samples, a sample being REPS calls; microseconds per call. `gaps-before.fib` times the same rows with the API of main.
(ns main (:require [fib.tensor :as t] [fib.math :as math]))

(defun fill (n: i64 seed: i64) -> (t/Tensor f32)
  (let [buf (cell (array n 0.0f32))]
    (do (dotimes (i n) (array-set! &buf i (fdiv (float (- (rem (+ (* i 7919) (* seed 104729)) 1013) 500)) 37.0f32)))
        (t/from-array [n] @buf 0.0f32))))

(defun median5 (v: (Vec i64)) -> i64 (nth (sort v) 2))

(defun bench (name: str reps: i64 f: (fn () i64)) -> unit
  (let [times (mapv (fn (s: i64) (let [t0 (sys-clock-now)
                                       chk (loop [r 0 c 0] (if (< r reps) (recur (+ r 1) (+ c (f))) c))
                                       dt (- (sys-clock-now) t0)]
                                   (if (= chk -1) 0 dt)))
                    (range 6))
        ts (vec (rest times))]
    (println name "us_per_call" (/ (double (median5 ts)) (* 1000.0 (double reps))))))

(defun main () -> i64
  (let [x (t/reshape [128 256] (fill 32768 1)) y (t/reshape [128 256] (fill 32768 2)) zero (t/full [] 0.0f32)
        w (t/reshape [784 256] (fill 200704 3)) pos (t/map (fn (v: f32) (+ (abs v) 0.5f32)) w)
        xd (t/map-as (fn (v: f32) (double v)) 0.0 x) c3 (t/reshape [8 32 256] (fill 65536 4))
        w64 (t/map-as (fn (v: f32) (double v)) 0.0 w) pos64 (t/map-as (fn (v: f32) (double v)) 0.0 pos)]
    (do (bench "sqrt 784x256 f32" 100 (fn () (t/size (t/sqrt pos))))
        (bench "sqrt 784x256 f64" 100 (fn () (t/size (t/sqrt pos64))))
        (bench "sqrt of a transposed 784x256 f32 view" 100 (fn () (t/size (t/sqrt (t/transpose pos)))))
        (bench "rsqrt 784x256 f32" 100 (fn () (t/size (t/rsqrt pos))))
        (bench "abs 784x256 f32" 100 (fn () (t/size (t/abs w))))
        (bench "sign 784x256 f32" 100 (fn () (t/size (t/sign w))))
        (bench "greater-scalar 128x256 f32" 200 (fn () (t/size (t/greater x zero))))
        (bench "greater-tensor 128x256 f32" 200 (fn () (t/size (t/greater x y))))
        (bench "where mask x zero 128x256 f32" 200 (fn () (t/size (t/where (t/greater x y) x zero))))
        (bench "greater+where relu grad (g*mask) 128x256" 200 (fn () (t/size (t/where (t/greater x zero) y zero))))
        (bench "relu-grad g x 128x256 (new, one pass)" 200 (fn () (t/size (t/relu-grad y x))))
        (bench "relu-mask x then mul 128x256 (new)" 200 (fn () (t/size (t/mul y (t/relu-mask x)))))
        (bench "relu(y/y) mask workaround 128x256" 200 (fn () (t/size (t/mul y (t/relu (t/div x x))))))
        (bench "sum-axis 0 128x256 f32" 200 (fn () (t/size (t/sum-axis 0 false x))))
        (bench "sum-axis 0 784x256 f32" 100 (fn () (t/size (t/sum-axis 0 false w))))
        (bench "sum-axis 1 128x256 f32 (last axis: generic path)" 200 (fn () (t/size (t/sum-axis 1 false x))))
        (bench "sum-axis 1 of 8x32x256 f32" 100 (fn () (t/size (t/sum-axis 1 false c3))))
        (bench "sum-axis 0 of 8x32x256 f32" 100 (fn () (t/size (t/sum-axis 0 false c3))))
        (bench "sum-axis 2 of 8x32x256 f32 (last axis: generic path)" 100 (fn () (t/size (t/sum-axis 2 false c3))))
        (bench "mean-axis 0 128x256 f64" 100 (fn () (t/size (t/mean-axis 0 false xd))))
        (bench "maximum-axis 0 128x256 f32" 200 (fn () (t/size (t/maximum-axis 0 false x))))
        (bench "minimum-axis 0 784x256 f32" 100 (fn () (t/size (t/minimum-axis 0 false w))))
        (bench "bias grad: ones mmul 128x256" 200 (fn () (t/size (t/mmul (t/full [1 128] 1.0f32) x))))
        (bench "mul 784x256 f32 (reference)" 200 (fn () (t/size (t/mul w w))))
        (let [ps [w (t/zeros-f32 [256]) (t/reshape [256 10] (fill 2560 5)) (t/zeros-f32 [10])]
              gs [(t/reshape [784 256] (fill 200704 6)) (t/zeros-f32 [256]) (t/reshape [256 10] (fill 2560 7)) (t/zeros-f32 [10])]
              ms (mapv (fn (p: (t/Tensor f32)) (t/zeros-f32 (t/shape p))) ps) vs (mapv (fn (p: (t/Tensor f32)) (t/full (t/shape p) 0.5f32)) ps)]
          (do (bench "adam-step, 4 MLP tensors (203 530 floats), one pass each" 20
                     (fn () (reduce + 0 (map-indexed (fn (i: i64 p: (t/Tensor f32)) (t/size (nth (t/adam-step 0.001 0.9 0.999 1.0e-8 0.1 0.001 p (nth gs i) (nth ms i) (nth vs i)) 0))) ps))))
              (bench "adam-step, one 784x256 tensor" 50 (fn () (t/size (nth (t/adam-step 0.001 0.9 0.999 1.0e-8 0.1 0.001 w (nth gs 0) (nth ms 0) (nth vs 0)) 0))))
              (bench "sgd-momentum-step, one 784x256 tensor" 100 (fn () (t/size (nth (t/sgd-momentum-step 0.1 0.9 w (nth gs 0) (nth ms 0)) 0))))
              0))
        0)))
