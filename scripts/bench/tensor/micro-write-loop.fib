;; in-cache write loops: x[i] = 0.5*x[i] + y[i], 32768 elements, 40000 passes
(defun make (n: i64 k: i64) -> (Array f64)
  (let ((buf (cell (array n 0.0))))
    (do (dotimes (i n) (array-set! &buf i (double (rem (* i k) 7))))
        @buf)))

(defun passes (x: (Array f64) y: (Array f64) reps: i64) -> (Array f64)
  (let ((n (array-len x)) (buf (cell x)))
    (do (dotimes (r reps)
          (dotimes (i n) (array-set! &buf i (+ (* 0.5 (array-get @buf i)) (array-get y i)))))
        @buf)))

(defun main () -> i64
  (let ((r (passes (make 32768 1) (make 32768 3) 40000)))
    (do (println (array-get r 5) " " (array-get r 32767)) 0)))
