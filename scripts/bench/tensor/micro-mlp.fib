;; per-stage times of the f32 MLP forward pass (batch 256, 784-512-10), best of 15, in ms:
;;   F build scripts/bench/tensor/micro-mlp.fib -I lib -o m && flock /tmp/fibsuite.lock ./m
(ns main (:require [fib.tensor :as t]))
(defun gen (n: i64 q: i64) -> f32
  (fdiv (float (- (rem (* n q) 89) 44)) 16.0f32))
(defun count-of (dims: (Vec i64)) -> i64
  (loop ((i 0) (n 1)) (if (< i (count dims)) (recur (+ i 1) (* n (nth dims i))) n)))
(defun make (dims: (Vec i64) q: i64) -> (t/Tensor f32)
  (let ((n (count-of dims)) (buf (cell (array n 0.0f32))))
    (do (dotimes (i n) (array-set! &buf i (gen i q)))
        (t/from-array dims @buf 0.0f32))))
(defun lap (name: str f: (fn () f32) runs: i64) -> unit
  (loop ((r 0) (best 1000000000000) (v 0.0f32))
    (if (< r runs)
        (let ((s (sys-clock-now)) (x (f)) (e (- (sys-clock-now) s)))
          (recur (+ r 1) (min best e) x))
        (println name " best_ms " (fdiv (double best) 1000000.0) " check " v))))
(defun probe (x: (t/Tensor f32)) -> f32 (t/flat-at x 7))
;; the unfused pipeline (what bench.fib's mlp does)
(defun relu (x: (t/Tensor f32)) -> (t/Tensor f32)
  (t/where (t/greater x (t/full [] 0.0f32)) x (t/full [] 0.0f32)))
(defun mlp (x: (t/Tensor f32) w1: (t/Tensor f32) b1: (t/Tensor f32) w2: (t/Tensor f32) b2: (t/Tensor f32)) -> (t/Tensor f32)
  (t/add (t/mmul (relu (t/add (t/mmul x w1) b1)) w2) b2))
(defun mlp-fused (x: (t/Tensor f32) w1: (t/Tensor f32) b1: (t/Tensor f32) w2: (t/Tensor f32) b2: (t/Tensor f32)) -> (t/Tensor f32)
  (t/dense (t/dense x w1 b1 :relu) w2 b2 :identity))
(defun main () -> i64
  (let ((x (make [256 784] 7)) (w1 (make [784 512] 5)) (b1 (make [512] 3)) (w2 (make [512 10] 5)) (b2 (make [10] 3))
        (h (t/mmul x w1)) (z (t/add h b1)) (zero (t/full [] 0.0f32))
        (a (t/where (t/greater z zero) z zero)) (o (t/mmul a w2)))
    (do (lap "mmul1 256x784x512 " (fn () (probe (t/mmul x w1))) 15)
        (lap "add bias 256x512   " (fn () (probe (t/add h b1))) 15)
        (lap "relu (where)       " (fn () (probe (t/where (t/greater z zero) z zero))) 15)
        (lap "mmul2 256x512x10   " (fn () (probe (t/mmul a w2))) 15)
        (lap "add bias 256x10    " (fn () (probe (t/add o b2))) 15)
        (lap "whole mlp          " (fn () (probe (mlp x w1 b1 w2 b2))) 15)
        (lap "dense1 relu fused   " (fn () (probe (t/dense x w1 b1 :relu))) 15)
        (lap "dense2 fused        " (fn () (probe (t/dense a w2 b2 :identity))) 15)
        (lap "whole mlp fused     " (fn () (probe (mlp-fused x w1 b1 w2 b2))) 15)
        0)))
