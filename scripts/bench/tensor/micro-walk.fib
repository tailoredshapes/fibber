;; micro benchmark for the index-decode removal: map-as, zip-with, copy, to-vec, mean-axis, on dense and strided inputs
(ns main (:require [fib.tensor :as t]))
(defun gen (n: i64) -> (t/Tensor f64)
  (let ((buf (cell (array n 0.0))))
    (do (dotimes (i n) (array-set! &buf i (fdiv (double (- (rem (* i 7) 89) 44)) 16.0)))
        (t/from-array [n] @buf 0.0))))
(defun lap (name: str f: (fn () f64) runs: i64) -> i64
  (loop ((r 0) (best 1000000000000))
    (if (< r runs)
        (let ((s (sys-clock-now)) (v (f)) (e (- (sys-clock-now) s)))
          (do (when (= r (- runs 1)) (println name " best_ms " (fdiv (double (min best e)) 1000000.0) " check " v))
              (recur (+ r 1) (min best e))))
        0)))
(defun main () -> i64
  (let ((a (t/reshape [2048 2048] (gen 4194304))) (b (t/reshape [2048 2048] (gen 4194304))) (at (t/transpose a)))
    (do (lap "map dense   " (fn () (t/sum-fast (t/map (fn (v: f64) (+ v 1.0)) a))) 5)
        (lap "map strided " (fn () (t/sum-fast (t/map (fn (v: f64) (+ v 1.0)) at))) 5)
        (lap "zip dense   " (fn () (t/sum-fast (t/zip-with (fn (x: f64 y: f64) (+ x y)) 0.0 a b))) 5)
        (lap "zip strided " (fn () (t/sum-fast (t/zip-with (fn (x: f64 y: f64) (+ x y)) 0.0 a at))) 5)
        (lap "copy dense  " (fn () (t/sum-fast (t/copy a))) 5)
        (lap "copy strided" (fn () (t/sum-fast (t/copy at))) 5)
        (lap "to-array    " (fn () (let ((x (t/to-array a))) (array-get x 7))) 5)
        (lap "to-vec 1e6  " (fn () (let ((x (t/to-vec (t/reshape [1000000] (gen 1000000))))) (nth x 7))) 5)
        (lap "mean-axis -1" (fn () (t/sum-fast (t/mean-axis -1 true a))) 5)
        (lap "mean-axis 0 " (fn () (t/sum-fast (t/mean-axis 0 true a))) 5)
        0)))
