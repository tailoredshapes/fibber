;; bench: (Map i64 i64): 1e6 assoc, then 2e6 get lookups (half of them misses), then update-in-place style re-assoc of 1e6 keys
(ns main)
(defun main () -> i64
  (let [n 1000000
        m0: (Map i64 i64) {}
        m (loop [i 0 m m0] (if (>= i n) m (recur (+ i 1) (assoc m (* i 3) i))))
        h (loop [i 0 acc 0]
            (if (>= i 2000000) acc
              (recur (+ i 1) (+ acc (match (get m i) ((some v) v) (nil 1))))))
        m2 (loop [i 0 m m] (if (>= i n) m (recur (+ i 1) (assoc m (* i 3) (+ i 1)))))]
    (do (println (count m) h (get m2 2997) (count m2)) 0)))
