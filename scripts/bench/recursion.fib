;; bench: naive fib 44 and an arity-overloaded accumulating sum (the 1-arity calls the 2-arity) over 30e6
(ns main)
(defun fib (n: i64) -> i64 (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defn sumto
  ([n: i64] -> i64 (sumto n 0))
  ([n: i64 acc: i64] -> i64 (if (= n 0) acc (sumto (- n 1) (rem (+ acc n) 1000003)))))
(defun main () -> i64
  (let [a (fib 44)
        b (loop [i 0 acc 0] (if (>= i 30000) acc (recur (+ i 1) (+ acc (sumto 1000)))))]
    (do (println a b) 0)))
