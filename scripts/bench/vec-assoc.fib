;; bench: a 100000-element Vec, 10e6 assoc updates at pseudo-random indexes (the Vec is uniquely held throughout)
(ns main)
(defun main () -> i64
  (let [n 100000
        v0 (vec (range n))
        v (loop [i 0 x 12345 v v0]
            (if (>= i 10000000) v
              (let [x2 (rem (+ (* x 1103515245) 12345) 2147483648)]
                (recur (+ i 1) x2 (assoc v (rem x2 n) i)))))]
    (do (println (count v) (reduce + 0 v)) 0)))
