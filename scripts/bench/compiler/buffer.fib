(ns main (:use emit.ir emit.value) (:require [emit.node :as n]))

(defun main () -> i64
  (let ((builder (fb-new "large" nil [] false))
        (instruction (n/call "fib.retain" [(n/local "operand")]))
        (start (sys-clock-now)))
    (do (dotimes (i 100000) (fb-stmt builder instruction))
        (fb-term builder (n/ret nil))
        (println (str "items " (count @(. (fb-block builder) items))
                      " ns " (- (sys-clock-now) start)))
        (if (= (count @(. (fb-block builder) items)) 100001) 0 1))))
