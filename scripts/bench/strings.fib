;; bench: strings: str concat in a loop (growing, 20000 pieces), str of numbers 1e6 times, split/join of a 1e6-field line, index-of scans
(ns main (:use fib.core) (:require [fib.string :as str]))
(defun grow (n: i64) -> str
  (loop [i 0 s ""] (if (>= i n) s (recur (+ i 1) (str s "ab" (rem i 10))))))
(defun numbers (n: i64) -> i64
  (loop [i 0 acc 0] (if (>= i n) acc (recur (+ i 1) (+ acc (count (str "item-" i ":" (* i 2))))))))
(defun main () -> i64
  (let [g (grow 20000)
        nums (numbers 1000000)
        line (str/join "," (map (fn (i) (str (rem (* i 37) 1000))) (range 1000000)))
        parts (str/split line \,)
        total (reduce + 0 (map (fn (p) (count p)) parts))
        rejoined (str/join ";" parts)
        found (loop [i 0 from 0 acc 0]
                (if (>= i 2000) acc
                  (match (str/index-of g "9ab" from)
                    ((some k) (recur (+ i 1) (+ k 1) (+ acc k)))
                    (nil (recur (+ i 1) 0 acc)))))]
    (do (println (count g) nums (count line) (count parts) total (count rejoined) found) 0)))
