;; bench: f64 loop/recur series sum (harmonic-style); prints the sum scaled to an integer as the checksum
(ns main)
(defun main () -> i64
  (let [s (loop [i 0 acc 0.0]
            (if (>= i 2000000000) acc
              (recur (+ i 1) (+ acc (/ 1.0 (+ (double i) 1.0))))))]
    (do (println (long (* s 1000000.0))) 0)))
