;; bench: binary-trees (allocation heavy): max depth 18, as the benchmarks game
(ns main)
(defenum Tree (Leaf) (Node l: Tree r: Tree))
(defun make (d: i64) -> Tree (if (= d 0) (Node Leaf Leaf) (Node (make (- d 1)) (make (- d 1)))))
(defun check (t: Tree) -> i64 (match t ((Leaf) 0) ((Node l r) (+ 1 (+ (check l) (check r))))))
(defun main () -> i64
  (let [maxd 18
        stretch (check (make (+ maxd 1)))
        long-lived (make maxd)
        total (loop [d 4 acc 0]
                (if (> d maxd) acc
                  (let [iters (shl 1 (+ (- maxd d) 4))
                        s (loop [i 0 s 0] (if (>= i iters) s (recur (+ i 1) (+ s (check (make d))))))]
                    (recur (+ d 2) (+ acc s)))))]
    (do (println stretch total (check long-lived)) 0)))
