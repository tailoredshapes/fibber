;; scripts/bench/json/fibber-bench.fib MODE FILE REPS: the fib.json side of docs/shootout/json.md. Prints `NAME check N MB/s X` (X: MB/s of the input, of the output text for write).
;;   dom     parse into Json            tape   the structural pass only         three  tape + three fields of twitter.json by path (no DOM)
;;   typed   decode twitter.json into records (no DOM)                          write  serialise the parsed document, compact
;;   linespar the same on all cores (reduce-lines-par)
;;   lines   NDJSON file: parse every line (bounded memory: fib.json.io/reduce-lines); the third argument is the file size in bytes
(ns main (:use fib.core fib.seq fib.coll fib.json.types fib.json.parse fib.json.domfast fib.json.write fib.json.tapebuild fib.json.view fib.json.io fib.json.lines fib.json.docwrite fib.json.stream) (:require [fib.json.codec :as jc] [fib.json.convert :as cv]))

(jc/defjson User [screen_name: str followers_count: i64 verified: bool])
(jc/defjson Status [id: i64 text: str retweet_count: i64 favorite_count: i64 user: User])
(jc/defjson Timeline [statuses: (Vec Status)])

(defun typed (s: str) -> i64 (match (decode-Timeline s) ((Ok t) (count (. t statuses))) ((Err _) -1)))
(defun three (s: str) -> i64
  (match (tape-of s)
    ((Ok d) (let [a (path d ["statuses" "0" "user" "screen_name"])
                  b (path d ["search_metadata" "count"])
                  c (path d ["statuses" "0" "id"])]
              (+ (if (>= a 0) (if-some [x (node-str d a)] (str-len x) 0) 0)
                 (+ (if (>= b 0) (if-some [x (node-i64 d b)] x 0) 0)
                    (if (>= c 0) (if-some [x (node-i64 d c)] (rem x 1000) 0) 0)))))
    ((Err _) -1)))
(defun dom (s: str) -> i64 (match (parse-fast-default s) ((Ok v) (match v ((JObj ks _) (count ks)) ((JArr xs) (count xs)) (_ 1))) ((Err _) -1)))
(defun docw (d: Doc) -> i64 (str-len (doc-write d)))
(defun minify (s: str) -> i64 (match (tape-of s) ((Ok d) (str-len (doc-write d))) ((Err _) -1)))
(defun enc (t: Timeline) -> i64 (str-len (encode-Timeline t)))
(defun via-dom (t: Timeline) -> i64 (str-len (write (cv/->json t))))
(defun tape (s: str) -> i64 (match (tape-of s) ((Ok d) (. d len)) ((Err _) -1)))

(defun timed (name: str bytes: i64 reps: i64 f: (fn () i64)) -> unit
  (let [t0 (sys-clock-now)
        r (loop [k 0 a 0] (if (< k reps) (recur (+ k 1) (+ a (f))) a))
        t1 (sys-clock-now)]
    (println name "check" r "MB/s" (/ (* (double (* reps bytes)) 1000.0) (double (- t1 t0))))))

(defun lines (path: str size: i64 par: bool) -> unit
  (let [t0 (sys-clock-now)
        step (fn (acc: i64 d: (Result Json JsonError)) (match d ((Ok _) (+ acc 1)) ((Err _) -1000000000)))
        r (if par (reduce-lines-par path (default-options) step 0) (reduce-lines path (default-options) step 0))
        t1 (sys-clock-now)]
    (println (if par "ndjson lines parallel" "ndjson lines") (match r ((Ok n) n) ((Err _) -1)) "MB/s" (/ (* (double size) 1000.0) (double (- t1 t0))))))

(defun count-doc (j: Json) -> i64
  (match j
    ((JArr items) (reduce (fn (a: i64 x: Json) (+ a (count-doc x))) 1 items))
    ((JObj _ vals) (reduce (fn (a: i64 x: Json) (+ a (count-doc x))) 1 vals))
    (_ 1)))

;; the DOM made and dropped inside the task (reduce-lines-par-map)
(defun lines-map (path: str size: i64) -> unit
  (let [t0 (sys-clock-now)
        r (reduce-lines-par-map path (default-options) (fn (d: (Result Json JsonError)) (match d ((Ok j) (count-doc j)) ((Err _) -1000000000))) (fn (a: i64 x: i64) (+ a x)) 0)
        t1 (sys-clock-now)]
    (println "ndjson lines parallel map" (match r ((Ok n) n) ((Err _) -1)) "MB/s" (/ (* (double size) 1000.0) (double (- t1 t0))))))

;; the lazy seq of documents
(defun lines-lazy (path: str size: i64) -> unit
  (let [t0 (sys-clock-now)
        r (match (lines-seq path (default-options))
            ((Ok sq) (reduce (fn (a: i64 d: (Result Json JsonError)) (match d ((Ok j) (+ a 1)) ((Err _) -1000000000))) 0 sq))
            ((Err _) -1))
        t1 (sys-clock-now)]
    (println "ndjson lazy seq" r "MB/s" (/ (* (double size) 1000.0) (double (- t1 t0))))))

(defun validate-par (path: str size: i64) -> unit
  (match (read-file path)
    ((some s) (let [t0 (sys-clock-now) r (count (filter (fn (b: bool) b) (validate-lines s (default-options)))) t1 (sys-clock-now)]
                (println "ndjson validate parallel" r "MB/s" (/ (* (double size) 1000.0) (double (- t1 t0))))))
    (nil (println "unreadable"))))

(defun main () -> i64
  (let [a (args)
        mode (nth a 0)
        reps (if-some [v (parse-long (nth a 2))] v 1)]
    (if (= mode "lines") (do (lines (nth a 1) reps false) 0)
        (if (= mode "linesmap") (do (lines-map (nth a 1) reps) 0)
        (if (= mode "lineslazy") (do (lines-lazy (nth a 1) reps) 0)
        (if (= mode "linespar") (do (lines (nth a 1) reps true) 0)
        (if (= mode "validatepar") (do (validate-par (nth a 1) reps) 0)
        (if-some [s (read-file (nth a 1))]
          (let [n (str-len s)]
            (cond (= mode "dom") (do (timed "dom parse" n reps (fn () (dom s))) 0)
                  (= mode "tape") (do (timed "tape build" n reps (fn () (tape s))) 0)
                  (= mode "docwrite") (match (tape-of s) ((Ok d) (do (timed "doc write" (str-len (doc-write d)) reps (fn () (docw d))) 0)) ((Err _) 1))
                  (= mode "minify") (do (timed "minify (tape + doc write)" n reps (fn () (minify s))) 0)
                  (= mode "encode") (match (decode-Timeline s) ((Ok t) (do (timed "typed encode (no DOM)" (enc t) reps (fn () (enc t))) 0)) ((Err _) 1))
                  (= mode "encodedom") (match (decode-Timeline s) ((Ok t) (do (timed "typed encode via ToJson + DOM writer" (enc t) reps (fn () (via-dom t))) 0)) ((Err _) 1))
                  (= mode "three") (do (timed "tape + 3 fields" n reps (fn () (three s))) 0)
                  (= mode "typed") (do (timed "typed decode" n reps (fn () (typed s))) 0)
                  (= mode "write") (match (parse-fast-default s) ((Ok j) (do (timed "write compact" (str-len (write j)) reps (fn () (str-len (write j)))) 0)) ((Err _) 1))
                  :else 1))
          1))))))))
