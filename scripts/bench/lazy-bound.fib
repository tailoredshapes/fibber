;; bench: the same chain as lazy-fused but each stage bound to a name (a memoised seq, a cell per element), over 5e6
(ns main)
(defun main () -> i64
  (let [r (range 5000000)
        m (map (fn (x) (rem (* x 3) 1000)) r)
        f (filter (fn (x) (even? x)) m)
        a (reduce + 0 f)]
    (do (println a) 0)))
