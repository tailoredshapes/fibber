;; bench: a 100000-element Vec, 100e6 nth reads at pseudo-random indexes
(ns main)
(defun main () -> i64
  (let [n 100000
        v (vec (map (fn (i) (rem (* i 7) 1000)) (range n)))
        r (loop [i 0 x 777 acc 0]
            (if (>= i 100000000) acc
              (let [x2 (rem (+ (* x 1103515245) 12345) 2147483648)]
                (recur (+ i 1) x2 (+ acc (nth v (rem x2 n)))))))]
    (do (println (count v) r) 0)))
