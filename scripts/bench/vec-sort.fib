;; bench: sort 2e6 pseudo-random i64 (natural order), then sort-by a key (mod 1000) on 1e6 and sort with a comparator on 1e6
(ns main)
(defun rnd (n: i64) -> (Vec i64)
  (loop [i 0 x 42 v []]
    (if (>= i n) v
      (let [x2 (rem (+ (* x 1103515245) 12345) 2147483648)]
        (recur (+ i 1) x2 (conj v x2))))))
(defun main () -> i64
  (let [a (vec (sort (rnd 2000000)))
        b (vec (sort-by (fn (x) (rem x 1000)) (rnd 1000000)))
        c (vec (sort-with > (rnd 1000000)))]
    (do (println (nth a 0) (nth a 1999999) (nth b 0) (nth b 999999) (nth c 0) (nth c 999999)) 0)))
