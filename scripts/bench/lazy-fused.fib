;; bench: a lazy chain consumed in place (fused by the expander): range, map, filter, reduce over 100e6; then take/drop/iterate
(ns main)
(defun main () -> i64
  (let [a (->> (range 100000000) (map (fn (x) (rem (* x 3) 1000))) (filter (fn (x) (even? x))) (reduce + 0))
        b (->> (iterate (fn (x) (rem (+ (* x 5) 1) 1000003)) 1) (drop 10) (take 20000000) (reduce + 0))]
    (do (println a b) 0)))
