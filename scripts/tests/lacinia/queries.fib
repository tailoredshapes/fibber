;; Independent GraphQL conformance runner; arguments are query, variable fixture, operation name.
(ns main (:use fib.core fib.seq fib.coll fib.print)
  (:require [fib.lacinia :as g] [tl.lacinia-query :as f]))
(defun variables (fixture: str) -> (Map str g/GqlValue)
  (cond (= fixture "string") {"x" (g/StringValue "supplied")}
    (= fixture "null") {"x" g/NullValue}
    (= fixture "int") {"x" (g/IntValue 3)}
    (= fixture "true") {"x" (g/BooleanValue true)}
    (= fixture "false") {"x" (g/BooleanValue false)}
    (= fixture "object") {"input" (g/object {"limit" (g/IntValue 3)})}
    (= fixture "nested") {"terms" (g/StringValue "one") "text" (g/StringValue "leaf")}
    (= fixture "list") {"x" (g/ListValue [(g/StringValue "one") g/NullValue])}
    (= fixture "extra") {"unused" (g/IntValue 42)}
    :else {}))
(defun main () -> i64
  (let [arguments (args) calls (atom 0)]
    (if (!= (count arguments) 3) 2
      (match (g/compile-schema (f/definition calls))
        ((Err _) 3)
        ((Ok schema)
          (let [query (nth arguments 0) supplied (variables (nth arguments 1)) name (nth arguments 2)
                result (if (= name "") (g/execute schema query supplied g/NullValue)
                  (g/execute-operation schema query supplied g/NullValue name))]
            (do (println (g/result-json result)) (println @calls) 0)))))))
