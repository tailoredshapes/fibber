{:insert-into :people :values [{:name "ann" :age 30} {:name "bob" :age 41}]}
{:insert-into :people :columns [:name :age] :values [["ann" 30] ["bob" 41]]}
{:update :people :set {:age 31 :nick nil} :where [:= :name "ann"]}
{:delete-from :people :where [:and [:< :age 18] [:= :active false]]}
{:insert-into :people :values [{:name "ann"}] :returning [:id]}
