;; Compile/emission probe only: these calls deliberately use dummy resources.
;; Loading the Darwin overlay checks every backend entry point on a Linux host.
(ns main (:require [fib.os.backend :as b]))
(defun main () -> i64
  (unsafe (let [address (alloc 128) size (alloc 4) fds (alloc 8)]
    (do (store-i32 size 128i32) (b/clear-errno) (b/errno)
        (b/socket-new 2) (b/socket-accept -1 address size) (b/pipe-cloexec fds)
        (b/executable-path address 128) (b/directory-next address)
        (free address) (free size) (free fds) 0))))
