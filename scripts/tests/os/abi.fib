;; Values are compared with the host's C headers by scripts/test-os.sh.
(ns main (:require [fib.os.abi :as a]))
(defun main () -> i64
  (let [abi a/host]
    (do (doseq [n [(. abi create-flag) (. abi exclusive-flag) (. abi truncate-flag) (. abi append-flag)
      (. abi nonblock-flag) (. abi cloexec-flag) (. abi at-cwd) (. abi monotonic-clock)
      (. abi would-block) (. abi timed-out) (. abi connection-aborted) (. abi connection-reset)
      (. abi connection-refused) (. abi not-supported) (. abi address-in-use)
      (. abi socket-level) (. abi reuse-address) (. abi no-signal) (. abi ipv6-family)
      (if (. abi sockaddr-length) 1 0) (. abi uname-width) (. abi dirent-type) (. abi dirent-name)
      (. abi online-cpus) (. abi in-progress) (. abi socket-error)
      8 8 16 8 16 28 2 4 8]] (println n)) 0)))
