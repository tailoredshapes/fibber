;; scripts/lz4-bench.fib: the measuring half of docs/shootout/lz4.md. usage: lz4-bench MODE FILE [LEVEL] [REPS] [THREADS] [BSIZE]
;;   c  fast block, acceleration LEVEL        h  HC block, level LEVEL      d  block decompress (of the fast block) into a buffer made once      dh  the same for an HC block
;;   da and dha: the same into a fresh array each time (allocation, zero fill and page faults included)
;;   f  frame compress, level LEVEL (independent blocks of BSIZE, content checksum), THREADS workers      fd  frame decompress (content size recorded: direct mode)  fdp  the same without the size  fdn  the same with verification off      s  streaming compress + decompress in 64 KiB chunks
;; Prints the input and output sizes and the MEDIAN of REPS (default 5) runs, in MB/s of input: the same line as scripts/fetch-lz4-tools.sh's lz4bench.
(ns main (:use fib.compress.types fib.compress.lz4.mem fib.compress.lz4.block fib.compress.lz4.frame fib.compress.lz4.framedec fib.compress.lz4.xxh32 fib.compress.ops)
  (:require [fib.compress :as z] [fib.os.io :as io] [fib.os.files :as files] [fib.os.time :as time] [fib.compress.lz4 :as lz4]))

(defun slurp (path: str) -> (Array i8)
  (match (files/open-file path (files/default-file-options))
    ((Err e) (trap (str "open " path)))
    ((Ok fd)
     (let [out (cell (array 0 0i8)) used (cell 0)]
       (loop []
         (match (io/read-fd fd 4194304)
           ((Err e) (trap "read"))
           ((Ok b) (if (= (array-len b) 0) (array-copy @out 0 @used)
                     (do (when (> (+ @used (array-len b)) (array-len @out))
                           (let [nb (cell (array (max (* 2 (array-len @out)) (+ @used (array-len b))) 0i8))] (do (array-blit! &nb 0 @out 0 @used) (set! out @nb))))
                         (array-blit! &out @used b 0 (array-len b)) (set! used (+ @used (array-len b))) (recur))))))))))

(defun now () -> i64 (match (time/monotonic-ns) ((Ok t) t) ((Err e) 0)))

(defun stream-both (src: (Array i8) o: Options) -> i64
  (let [c (lz4/lz4)
        chunks (split-sizes src [65536])]
    (match (compress-chunks c o chunks)
      ((Ok z) (match (decompress-chunks c o (split-sizes z [65536])) ((Ok b) (array-len z)) ((Err e) (trap "stream decompress"))))
      ((Err e) (trap "stream compress")))))

;; The streaming decoder alone: the chunks fed, every step pulled, the output only counted.
(defun pull (k: k st: DecStep total: i64) -> i64 :where ((Decompressor k))
  (let [t (+ total (array-len (. st output)))]
    (if (. st needs-input) t (match (decompressor-feed k (array 0 0i8)) ((Ok more) (pull k more t)) ((Err e) (trap "pull"))))))
(defun stream-dec-count (z: (Array i8) o: Options chunk: i64) -> i64
  (match (codec-decompressor (lz4/lz4) o)
    ((Err e) (trap "dec"))
    ((Ok k) (loop [i 0 total 0]
              (if (>= i (array-len z)) total
                (let [e (min (array-len z) (+ i chunk))]
                  (match (decompressor-feed k (array-copy z i e)) ((Ok st) (recur e (pull k st total))) ((Err x) (trap "feed")))))))))

(defun run (mode: str src: (Array i8) level: i64 z: (Array i8) buf: (Array i8) threads: i64 bsize: i64) -> i64
  (let [chunks (if (= mode "sc") (split-sizes src [1048576]) []) o (with-verify (with-block-size (with-threads (with-level (default-options) level) threads) bsize) (not (= mode "fdn"))) n (array-len src)]
    (cond (= mode "c") (array-len (block-compress src level))
          (= mode "h") (array-len (block-compress-hc src level))
          (or (= mode "d") (= mode "dh")) (match (block-decompress-into z buf 0 n) ((Ok k) k) ((Err e) (trap (. e message))))
          (or (= mode "da") (= mode "dha")) (match (block-decompress-sized z n) ((Ok b) (array-len b)) ((Err e) (trap (. e message))))
          (= mode "x") (xxh32 src 0)
          (= mode "z") (array-len (array n 0i8))
          (= mode "f") (match (z/compress (lz4/lz4) src o) ((Ok b) (array-len b)) ((Err e) (trap (. e message))))
          (or (= mode "fd") (= mode "fdp") (= mode "fdn")) (match (z/decompress (lz4/lz4) z o) ((Ok b) (array-len b)) ((Err e) (trap (. e message))))
          (= mode "sc") (match (compress-chunks (lz4/lz4) o chunks) ((Ok b) (array-len b)) ((Err e) (trap "sc")))
          (= mode "sdn") (stream-dec-count z o 1048576)
          (= mode "sdm") (stream-dec-count z o 65536)
          (= mode "sd") (match (decompress-chunks (lz4/lz4) o (split-sizes z [1048576])) ((Ok b) (array-len b)) ((Err e) (trap "sd")))
          :else (stream-both src o))))

(defun main () -> i64
  (let [a (args) mode (nth a 0) src (slurp (nth a 1)) level (if (> (count a) 2) (unwrap-or (parse-long (nth a 2)) 1) 1)
        reps (if (> (count a) 3) (unwrap-or (parse-long (nth a 3)) 5) 5) threads (if (> (count a) 4) (unwrap-or (parse-long (nth a 4)) 1) 1) bsize (if (> (count a) 5) (unwrap-or (parse-long (nth a 5)) 65536) 65536) n (array-len src)
        buf (array (if (or (= mode "d") (= mode "dh")) n 0) 0i8)
        z (cond (or (= mode "dh") (= mode "dha")) (block-compress-hc src level) (or (= mode "d") (= mode "da")) (block-compress src 1)
                (or (= mode "sd") (= mode "sdn") (= mode "sdm")) (match (frame-compress src (with-block-size (with-level (default-options) level) bsize)) ((Ok b) b) ((Err e) (trap "frame")))
                (or (= mode "fd") (= mode "fdp") (= mode "fdn")) (match (frame-compress src (with-record-size (with-block-size (with-level (default-options) level) bsize) (not (= mode "fdp")))) ((Ok b) b) ((Err e) (trap "frame")))
                :else (array 0 0i8))
        times (loop [r 0 ts: (Vec i64) []]
                (if (>= r reps) ts
                  (let [t0 (now) _ (run mode src level z buf threads bsize) t (- (now) t0)] (recur (+ r 1) (conj ts t)))))
        best (nth (vec (sort times)) (quot (count times) 2))
        size (run mode src level z buf threads bsize)]
    (do (println mode (nth a 1) "level" level ":" n "->" (if (or (= mode "d") (= mode "dh") (= mode "da") (= mode "dha") (= mode "fd") (= mode "fdp") (= mode "fdn")) (array-len z) size) (str (quot (* 10000 size) n) "/100 %") "median" (quot best 1000000) "ms" (quot best 1000) "us =" (quot (* n 1000) (max 1 best)) "MB/s")
        0)))
