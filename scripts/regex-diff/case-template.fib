;; spec:   stdlib §4.9 (rows re-pattern re-find re-matches re-seq re-groups)
;; expect: accept
;; result: 0
;; audit:  clean
;; roots:  ../../lib support
;; covers: re-pattern re-find re-matches re-seq re-groups
;; fib.regex against java.util.regex (JDK 27) on @@COUNT@@ seeded random (pattern, text) pairs, generated by
;; scripts/regex-diff/RegexDiff.java (`java RegexDiff.java case @@SEED@@ @@COUNT@@ case-template.fib`), which is also
;; where the expected answers come from: for each pair it records, as Java computed them and converted to UTF-8 byte
;; offsets, every match of `Matcher.find` with all its groups (F), `matches` (M), `replaceAll` with `<$1:$0>` (R)
;; and `Pattern.split` with limit 0 (S). The library must answer the same four, for every pair, to the letter
;; (tl.rxdiff `check-record`).
;; The patterns are drawn from the subset the library supports: literals (ASCII, é, €, あ), `.`, classes with ranges,
;; negation and `\d \w \s \D \W \S`, `|`, `( )` and `(?: )`, `* + ? {n} {n,} {n,m}` greedy and lazy, `^ $ \b \B \A \z \Z`,
;; nested to depth 2. The texts are samples of the pattern's own language mixed with noise (LF and CR among it),
;; so most pairs have matches. Pairs on which Java itself takes over 150 ms are dropped by the generator.
;; Where the two differ and the library is not wrong: for a group inside two nested repeats Java keeps the capture of
;; an earlier iteration (`((a)*b)*` on "abaab": group 2 is the first iteration's), where Perl, and the library, keep the
;; last one; a `{0}` of a group is the same kind of quirk. The generator marks such patterns mode L, and then
;; only the extent of each match is compared, not the groups.
;; Checks: (0) no pair differs; (1) there are the pairs the header says; (2) at least 60 per cent of the pairs have a match
;; (a library that finds nothing cannot pass); (3) the PLANTED FAULT: every pair that has a match, with one more match
;; written into its expected answer, is reported as different, so the comparison can fail.
(ns main (:use fib.core fib.seq fib.coll fib.regex tl.check tl.rxdiff) (:require [fib.string :as str]))

(def data: str @@DATA@@)

;; the first line that differs, as a string; "" when none does
(defun first-diff (lines: (Vec str)) -> str
  (loop [i 0]
    (if (< i (count lines))
        (let [r (check-record (nth lines i))]
          (if (= (str-len r) 0) (recur (+ i 1)) r))
        "")))

(defun has-match? (line: str) -> bool
  (let [f (str/split line "¦" -1)]
    (and (= (count f) 7) (!= (nth f 3) "F"))))

;; the record with an extra match in its F field
(defun planted (line: str) -> str
  (let [f (str/split line "¦" -1)]
    (str/join "¦" [(nth f 0) (nth f 1) (nth f 2) (str (nth f 3) "0-0;") (nth f 4) (nth f 5) (nth f 6)])))

(defun main () -> i64
  (let [c (checks)
        lines (vec (filter (fn (l: str) (> (str-len l) 0)) (str/split data "\n")))
        matching (vec (filter has-match? lines))]
    (do (check c (= (first-diff lines) ""))
        (check c (= (count lines) @@COUNT@@))
        (check c (>= (* 10 (count matching)) (* 6 (count lines))))
        (check c (= (count (filter (fn (l: str) (!= (str-len (check-record (planted l))) 0)) matching)) (count matching)))
        (checks-result c))))
