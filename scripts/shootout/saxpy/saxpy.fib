;; saxpy: y = 0.5*x + y over arrays of N f64, REPS times (second argument, default 1); then the sum of y.
;; x[i] = i mod 7, y[i] = i mod 5: every value is a multiple of 0.5 below 2^53, so the result is exact in any order and
;; with or without fma. Output with one decimal.
(ns main (:require [fib.fmt :as fmt]))

(defun axpy (&y: (Array f64) x: (Array f64) n: i64) -> i64
  (loop [i 0] (if (< i n)
    (do (array-set! &y i (+ (* 0.5 (array-get x i)) (array-get @y i))) (recur (+ i 1)))
    0)))

(defun total (y: (Array f64) n: i64) -> f64
  (loop [i 0 s 0.0] (if (< i n) (recur (+ i 1) (+ s (array-get y i))) s)))

(defun main () -> i64
  (let [n (unwrap (parse-long (nth (args) 0)))
        reps (if (> (count (args)) 1) (unwrap (parse-long (nth (args) 1))) 1)
        x (cell (array n 0.0))
        y (cell (array n 0.0))]
    (do (loop [i 0] (if (< i n)
          (do (array-set! &x i (double (rem i 7))) (array-set! &y i (double (rem i 5))) (recur (+ i 1)))
          0))
        (loop [r 0] (if (< r reps) (do (axpy &y @x n) (recur (+ r 1))) 0))
        (println (fmt/format-f64 (total @y n) 1))
        0)))
