;; shootout self-test stand-in: prints the sum of i*i mod 1000003 for i in 0..N, then "done".
(ns main)
(defun main () -> i64
  (let [n (if-some [s (first (args))] (if-some [v (parse-long s)] v 0) 0)]
    (do (println (loop [i 0 acc 0]
                   (if (>= i n) acc (recur (+ i 1) (+ acc (rem (* i i) 1000003))))))
        (println "done")
        0)))
