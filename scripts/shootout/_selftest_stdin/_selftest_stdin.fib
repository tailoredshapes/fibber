;; shootout self-test stand-in for the stdin benchmarks: prints the number of bytes on stdin, then "done".
(ns main (:use fib.unix))
(defun count-bytes (total: i64) -> i64
  (match (fd-read stdin 65536)
    ((Ok a) (if (= (array-len a) 0) total (count-bytes (+ total (array-len a)))))
    ((Err e) -1)))
(defun main () -> i64
  (do (println (count-bytes 0))
      (println "done")
      0))
