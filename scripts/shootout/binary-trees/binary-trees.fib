;; binary-trees, the Computer Language Benchmarks Game: allocate and walk complete binary trees, no pooling.
;; usage: binary-trees N   (N from the command line; the game's sizes are 21 full)
(ns main)
(defstruct Node (l: (Option Node) r: (Option Node)))   ; as Java's Node: a leaf has no children
(defun make (d: i64) -> Node
  (if (= d 0) (Node nil nil) (Node (some (make (- d 1))) (some (make (- d 1))))))
(defun check (o: (Option Node)) -> i64
  (match o ((some n) (+ 1 (+ (check (. n l)) (check (. n r))))) (nil 0)))
(defun short-lived (d: i64 iters: i64) -> i64
  (loop [i 0 s 0] (if (>= i iters) s (recur (+ i 1) (+ s (check (some (make d))))))))
(defun arg-n () -> i64
  (if-some [a (first (args))]
    (if-some [n (parse-long a)] n 10)
    10))
(defun main () -> i64
  (let [min-depth 4
        max-depth (max (+ min-depth 2) (arg-n))
        stretch (+ max-depth 1)
        _ (println (str "stretch tree of depth " stretch "\t check: " (check (some (make stretch)))))
        long-lived (some (make max-depth))]
    (do
      (loop [d min-depth]
        (if (> d max-depth) 0
          (let [iters (shl 1 (+ (- max-depth d) min-depth))]
            (do (println (str iters "\t trees of depth " d "\t check: " (short-lived d iters)))
                (recur (+ d 2))))))
      (println (str "long lived tree of depth " max-depth "\t check: " (check long-lived)))
      0)))
