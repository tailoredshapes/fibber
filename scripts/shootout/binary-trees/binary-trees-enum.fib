;; binary-trees with a Tree enum (Leaf) (Node l r): the first, straightforward version; see README.md for why binary-trees.fib uses Option children instead.
;; usage: binary-trees-enum N
(ns main)
(defenum Tree (Leaf) (Node l: Tree r: Tree))
(defun make (d: i64) -> Tree
  (if (= d 0) (Node Leaf Leaf) (Node (make (- d 1)) (make (- d 1)))))
(defun check (t: Tree) -> i64
  (match t ((Leaf) 0) ((Node l r) (+ 1 (+ (check l) (check r))))))
(defun short-lived (d: i64 iters: i64) -> i64
  (loop [i 0 s 0] (if (>= i iters) s (recur (+ i 1) (+ s (check (make d)))))))
(defun arg-n () -> i64
  (if-some [a (first (args))]
    (if-some [n (parse-long a)] n 10)
    10))
(defun main () -> i64
  (let [min-depth 4
        max-depth (max (+ min-depth 2) (arg-n))
        stretch (+ max-depth 1)
        _ (println (str "stretch tree of depth " stretch "\t check: " (check (make stretch))))
        long-lived (make max-depth)]
    (do
      (loop [d min-depth]
        (if (> d max-depth) 0
          (let [iters (shl 1 (+ (- max-depth d) min-depth))]
            (do (println (str iters "\t trees of depth " d "\t check: " (short-lived d iters)))
                (recur (+ d 2))))))
      (println (str "long lived tree of depth " max-depth "\t check: " (check long-lived)))
      0)))
