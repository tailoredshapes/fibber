;; dot-product, SIMD version (SIMD wave 4, P5; lane-generic, the AVX-512 wave): the arrays are (Array f64xn), element k holding x[L*k .. L*k+L-1] for
;; the L = (native-lanes f64) lanes of the target (4 on AVX2, 8 where the target's native width is 512 bits), and the sum runs in four independent
;; vector accumulators (4 L products per trip) that are added once at the end. The sum is exact (see dot-product.fib), so the order and the width do
;; not change the printed digits. N must be a multiple of 4 L (32 for 8 lanes).
;; There is no vector load from an (Array f64) yet, so the data lives as vectors from the start: filling the arrays is
;; part of the program, written with a lane literal.
(ns main (:use fib.simd) (:require [fib.fmt :as fmt]))

(defun lanes () -> i64 (native-lanes f64))

;; the vector of lanes i0 .. i0+L-1 of the pattern (rem i m) + off
(defun fill (i0: i64 m: i64 off: f64) -> f64xn
  (loop [j 0 v (splat f64xn 0.0)]
    (if (< j (lanes)) (recur (+ j 1) (with-lane v j (+ (double (rem (+ i0 j) m)) off))) v)))

(defun dot (x: (Array f64xn) y: (Array f64xn) nv: i64) -> f64
  (let [z (splat f64xn 0.0)]
    (loop [i 0 a0 z a1 z a2 z a3 z]
      (if (< i nv)
        (recur (+ i 4)
               (+ a0 (* (array-get x i) (array-get y i)))
               (+ a1 (* (array-get x (+ i 1)) (array-get y (+ i 1))))
               (+ a2 (* (array-get x (+ i 2)) (array-get y (+ i 2))))
               (+ a3 (* (array-get x (+ i 3)) (array-get y (+ i 3)))))
        (hsum (+ (+ a0 a1) (+ a2 a3)))))))

(defun main () -> i64
  (let [n (unwrap (parse-long (nth (args) 0)))
        reps (if (> (count (args)) 1) (unwrap (parse-long (nth (args) 1))) 1)
        nv (quot n (lanes))
        x (cell (array nv (splat f64xn 0.0)))
        y (cell (array nv (splat f64xn 0.0)))]
    (do (loop [k 0] (if (< k nv)
          (do (array-set! &x k (fill (* k (lanes)) 7 0.0))
              (array-set! &y k (fill (* k (lanes)) 3 0.5))
              (recur (+ k 1)))
          0))
        (let [total (loop [r 0 t 0.0] (if (< r reps) (recur (+ r 1) (+ t (dot @x @y nv))) t))]
          (println (fmt/format-f64 total 1)))
        0)))
