(declare printf i32 (ptr ...))
(define (pi void) ((ptr tag) (i64 v))
  (block entry (call @printf (string "%s=%lld\n") tag v) (ret)))
(define (pd void) ((ptr tag) (double v))
  (block entry (call @printf (string "%s=%.17g\n") tag v) (ret)))
(define (b i64) ((i1 x)) (block entry (ret (zext i64 x))))
(define (main i32) ()
  (block entry
    (call @pd (string "fadd") (fadd (double 0.1) (double 0.2)))
    (call @pd (string "fdiv0") (fdiv (double 1.0) (double 0.0)))
    (call @pd (string "frem") (frem (double -7.5) (double 2.0)))
    (call @pd (string "fsub_float") (fpext double (fsub (float 1.5) (float 0.25))))
    (call @pd (string "nan") (double nan))
    (call @pd (string "neginf") (double -inf))
    (call @pd (string "sci") (double 1.5e-10))
    (call @pd (string "negzero") (fmul (double -0.0) (double 1.0)))
    (call @pi (string "oeq_nan") (call @b (fcmp oeq (double nan) (double nan))))
    (call @pi (string "une_nan") (call @b (fcmp une (double nan) (double nan))))
    (call @pi (string "one_nan") (call @b (fcmp one (double nan) (double 1.0))))
    (call @pi (string "ueq_nan") (call @b (fcmp ueq (double nan) (double 1.0))))
    (call @pi (string "ord_nan") (call @b (fcmp ord (double nan) (double 1.0))))
    (call @pi (string "uno_nan") (call @b (fcmp uno (double nan) (double 1.0))))
    (call @pi (string "ult_nan") (call @b (fcmp ult (double nan) (double 1.0))))
    (call @pi (string "olt") (call @b (fcmp olt (double 1.0) (double 2.0))))
    (call @pi (string "oge_float") (call @b (fcmp oge (float 2.0) (float 2.0))))
    (call @pi (string "icmp_ult") (call @b (icmp ult (i32 -1) (i32 1))))
    (call @pi (string "icmp_sge") (call @b (icmp sge (i8 -128) (i8 127))))
    (call @pi (string "trunc") (sext i64 (trunc i8 (i32 257))))
    (call @pi (string "zext") (zext i64 (i8 -1)))
    (call @pi (string "sext") (sext i64 (i16 -2)))
    (call @pd (string "fptrunc") (fpext double (fptrunc float (double 3.14159))))
    (call @pi (string "fptoui") (zext i64 (fptoui i32 (double 42.9))))
    (call @pi (string "fptosi") (fptosi i64 (double -42.9)))
    (call @pd (string "uitofp") (uitofp double (i8 -1)))
    (call @pd (string "sitofp") (sitofp double (i8 -1)))
    (call @pd (string "uitofp64") (uitofp double (i64 -1)))
    (call @pi (string "select") (select (icmp slt (i32 5) (i32 10)) (i64 1) (i64 2)))
    (call @pd (string "selectd") (select (i1 0) (double 1.0) (double 2.0)))
    (call @pi (string "ptrtoint_null") (ptrtoint i64 (ptr null)))
    (call @pi (string "inttoptr_rt") (ptrtoint i64 (inttoptr ptr (i64 4096))))
    (ret (i32 0))))
