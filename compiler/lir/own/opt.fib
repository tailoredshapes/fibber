;; compiler/lir/own/opt.fib: the slot for lIR-to-lIR rewrites on the explicit ownership forms (spec/lir.md 6.14, "Where it sits"): after
;; the verifier (lir.own) and before erasure (lir.own.erase), on the tree with the forms still in it. The rewrites that will live here: a
;; `copy-value`/`destroy-value` pair with nothing between that could observe the count cancelling, an owned argument whose callee only
;; borrows it made guaranteed, an `is-unique` whose value is fresh proven true. Today the identity: the verified module unchanged, so that
;; erasure gives exactly what the front end wrote (6.14.7), the oracle of lir-language.md stage 2 step 3.

(ns lir.own.opt
  (:use lir.ast))

;; The module with the optimisations of this slot applied: none yet.
(defun optimise-module (m: LModule) -> LModule m)
