;; compiler/lir/parse.fib: the parser's facade (crates/lir/src/parse/mod.rs `pub use`, and lib.rs `parse`). OWNER: package R.

(ns lir.parse
  (:use lir.diag lir.ast lir.sexp lir.parse.items))

;; Reads `src` into forms (`lir.sexp/read`) and parses them (`lir.parse.items/parse-module`): a lexical error anywhere is reported before any parse error. (lib.rs `parse`)
(defun parse-source (src: str) -> (Result LModule Diagnostic)
  (match (read src)
    ((Err d) (Err d))
    ((Ok forms) (parse-module forms))))
