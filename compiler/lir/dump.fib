;; compiler/lir/dump.fib: the oracle dump of the AST (docs/design/lair-ast-dump.md, written by package O; the Rust side is crates/lair/src/dump.rs). OWNER: package R. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

(ns lir.dump
  (:use lir.diag lir.ast))


;; The module as the canonical line-oriented dump, byte for byte the Rust `dump-ast` output.
(defun dump-module (m: LModule) -> str
  (trap "todo: lir.dump dump-module"))

;; The line the dump prints for a read or parse failure (so that `lairf dump-ast` and `lair dump-ast` compare it).
(defun dump-diagnostic (d: Diagnostic) -> str
  (trap "todo: lir.dump dump-diagnostic"))
