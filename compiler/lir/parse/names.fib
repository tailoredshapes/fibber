;; compiler/lir/parse/names.fib: names, and the helpers every parse module shares: crates/lir/src/parse/names.rs and the private helpers of
;; parse/mod.rs (`arity`, `atom`, `label`). OWNER: package R.
;;
;; The Rust `parse/mod.rs` is the parent of the other parse files and they call its helpers; fibber has no parent module, so the helpers are
;; here, at the bottom of the parse modules' dependency order. `&[Sexp]` is a `(Vec Sexp)` (a copy of the operands after the head).
(ns lir.parse.names
  (:use lir.diag lir.types lir.ast lir.sexp)
  (:require [lir.words :as words]))

;; The words the old spelling reserves as names (spec/lir.md 5.3 before the respelling): lower-case words that are not instruction heads.
;; Under the new spelling a name is refused only when it is the text of a word (`ADD`); these are refused while the old is admitted.
(def reserved-words: (Set str)
  #{"null" "void" "unordered" "monotonic" "acquire" "release" "acq_rel" "seq_cst" "singlethread" "weak" "inbounds" "volatile" "align"
    "zeroinitializer" "private" "internal" "external" "hidden"})

(defun scalar? :private (s: str) -> bool
  (match (scalar-keyword s) ((some _) true) (nil false)))

;; A reserved word: the text of a word of lir.words in every mode (`reserved word ADD used as a name`); a type keyword or one of the
;; reserved words of the old spelling while it is admitted (parse/names.rs `is_reserved`).
(defun reserved? (s: str) -> bool
  (or (words/word-text? s) (words/word-text? (strip-minus s))
      (and (or (contains? reserved-words s) (scalar? s)) (words/old-admitted?))))

;; The text without a leading `-`.
(defun strip-minus (s: str) -> str
  (if (starts-with? s "-") (str-slice s 1 (str-len s)) s))

;; Whether the first byte of s is an ASCII digit.
(defun digit-first? (s: str) -> bool
  (and (> (str-len s) 0)
       (let ((b (zext i64 (str-byte-at s 0)))) (and (>= b 48) (<= b 57)))))

(defun looks-numeric :private (s: str) -> bool
  (let ((body (strip-minus s)))
    (or (digit-first? body) (and (or (= body "inf") (= body "nan")) (words/old-admitted?)))))

;; Whether the old spelling's sigils start `s`: `@f` and `%struct.s` are not names while the old spelling is admitted; under the new, `@`
;; and `%` are characters like any other.
(defun sigil-first? :private (s: str) -> bool
  (and (or (starts-with? s "@") (starts-with? s "%")) (words/old-admitted?)))

;; A valid name at its binding site (parse/names.rs `valid_name`).
(defun valid-name (s: str pos: i64) -> (Result str Diagnostic)
  (cond (or (= (str-len s) 0) (sigil-first? s) (looks-numeric s) (= s "..."))
        (err pos (str "invalid name " s))
        (reserved? s) (err pos (str "reserved word " s " used as a name"))
        :else (Ok s)))

;; ---------------------------------------------------------------- words

;; The canonical name of the word the atom `s` spells (`ADD` and, while the old spelling is admitted, `add` both give `add`); "" for a form
;; that is not an atom or an atom that is no word, which is then a name. Every keyword position of the parser reads atoms through this.
(defun word-of (s: Sexp) -> str
  (match (sexp-atom s)
    ((some a) (canon a))
    (nil "")))

;; `keyword-of` as text: the canonical name, or "" for no word.
(defun canon (text: str) -> str
  (match (words/keyword-of text) ((some k) k) (nil "")))

;; The word the atom spells, else the atom's text (for a message: `unknown field vendor`); "" for no atom.
(defun word-or-atom (s: Sexp) -> str
  (let ((w (word-of s))) (if (= w "") (atom-or-empty s) w)))

;; Whether the form is an atom spelling the word `w` (its canonical name).
(defun atom-word? (s: Sexp w: str) -> bool
  (= (word-of s) w))

;; The entry of `m` for the word the atom `s` spells; nil for no word or no entry.
(defun word-get (m: (Map str a) s: Sexp) -> (Option a)
  (let ((k (word-of s)))
    (if (= k "") nil (get m k))))

;; The name of the global or function the form refers to: `(GLOBAL f)`, or the atom `@f` while the old spelling is admitted; nil otherwise.
(defun global-ref (s: Sexp) -> (Option str)
  (match s
    ((SxAtom a _ _) (if (and (starts-with? a "@") (> (str-len a) 1) (words/old-admitted?)) (some (str-slice a 1 (str-len a))) nil))
    ((SxList items _ _) (if (and (= (count items) 2) (atom-word? (nth items 0) "global")) (sexp-atom (nth items 1)) nil))
    (_ nil)))

;; The name of the struct type the form names: `(STRUCT s)`, or the atom `%struct.s` while the old spelling is admitted; nil otherwise.
(defun struct-ref (s: Sexp) -> (Option str)
  (match s
    ((SxAtom a _ _) (if (and (starts-with? a "%struct.") (> (str-len a) 8) (words/old-admitted?)) (some (str-slice a 8 (str-len a))) nil))
    ((SxList items _ _) (if (and (= (count items) 2) (atom-word? (nth items 0) "struct")) (sexp-atom (nth items 1)) nil))
    (_ nil)))

;; `op expects N operands, found M` unless `args` has exactly `n` (parse/mod.rs `arity`).
(defun arity (op: str args: (Vec Sexp) n: i64 pos: i64) -> (Result unit Diagnostic)
  (if (= (count args) n)
      (Ok ())
      (err pos (str op " expects " n " operand" (if (= n 1) "" "s") ", found " (count args)))))

;; The atom's text, or an error naming what was expected (parse/mod.rs `atom`).
(defun atom-text (s: Sexp what: str) -> (Result str Diagnostic)
  (match (sexp-atom s)
    ((some a) (Ok a))
    (nil (err (sexp-pos s) (str "expected " what ", found " (sexp-describe s))))))

;; A label: an atom that is neither empty nor the text of a word, nor (old spelling) a sigilled atom (parse/mod.rs `label`).
(defun label (s: Sexp) -> (Result str Diagnostic)
  (try-let ((a (atom-text s "a block label")))
    (if (or (sigil-first? a) (= (str-len a) 0) (words/word-text? a))
        (err (sexp-pos s) (str "invalid label " a))
        (Ok a))))

;; The items of v from index k on, as a fresh vector (Rust's `&items[k..]`).
(defun vec-from (v: (Vec Sexp) k: i64) -> (Vec Sexp)
  (let ((n (- (count v) k)))
    (if (<= n 0)
        (vec-empty)
        (let ((out (cell (array n (nth v k)))))
          (do (loop ((i 1))
                (if (< i n) (do (array-set! &out i (nth v (+ k i))) (recur (+ i 1))) ()))
              (vec-from-array @out))))))

;; Whether the form is an atom with exactly this text.
(defun atom-is? (s: Sexp w: str) -> bool
  (match (sexp-atom s) ((some a) (= a w)) (nil false)))

;; The atom's text or "" (Rust's `atom().unwrap_or("")`).
(defun atom-or-empty (s: Sexp) -> str
  (match (sexp-atom s) ((some a) a) (nil "")))

;; The expression parser that the instruction modules (instr, memory, atomics, control) are given for their operands, so that they do not
;; require lir.parse.expr, which requires them: the one recursion of the grammar is closed by passing `parse-expr` down.
(defstruct ExprParser (parse: (fn (Sexp) (Result LExpr Diagnostic))))

;; An operand: `parse-expr` through the field.
(defun operand (sub: ExprParser s: Sexp) -> (Result LExpr Diagnostic)
  ((. sub parse) s))

;; Every form of `args` as an expression (expr.rs `exprs`).
(defun operands (sub: ExprParser args: (Vec Sexp)) -> (Result (Vec LExpr) Diagnostic)
  (let ((n (count args)))
    (if (= n 0)
        (Ok (vec-empty))
        (match ((. sub parse) (nth args 0))
          ((Err d) (Err d))
          ((Ok e0)
           (let ((out (cell (array n e0))))
             (loop ((i 1))
               (if (>= i n)
                   (Ok (vec-from-array @out))
                   (match ((. sub parse) (nth args i))
                     ((Err d) (Err d))
                     ((Ok e) (do (array-set! &out i e) (recur (+ i 1)))))))))))))
