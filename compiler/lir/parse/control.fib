;; compiler/lir/parse/control.fib: calls, terminators, phi and let (crates/lir/src/parse/control.rs). OWNER: package R.

(ns lir.parse.control
  (:use lir.diag lir.types lir.ast lir.sexp lir.parse.names lir.parse.ty))

;; The special registers of a kernel target `(sreg NAME)` reads (spec/lir.md 6.9): the thread's index in its block, the block's in the grid, their sizes, in x, y and z,
;; and (GPU-5) `laneid`, the thread's lane in its warp, and `warpsize`, the width of the warp.
(defun sreg-name? (r: str) -> bool
  (some? (first (filter (fn (n: str) (= n r)) ["tid.x" "tid.y" "tid.z" "ctaid.x" "ctaid.y" "ctaid.z" "ntid.x" "ntid.y" "ntid.z" "nctaid.x" "nctaid.y" "nctaid.z" "laneid" "warpsize"]))))

;; The form for `ret br switch phi let call tailcall indirect-call indirect-tailcall unreachable trap sreg barrier`, nil for another head. (control.rs `parse`)
(defun parse-control (name: str args: (Vec Sexp) pos: i64 sub: ExprParser) -> (Option (Result LExpr Diagnostic))
  (cond (= name "ret") (some (ret sub args pos))
        (= name "br") (some (br sub args pos))
        (= name "switch") (some (switch sub args pos))
        (= name "unreachable") (some (try-let ((_ (arity name args 0 pos))) (Ok (expr-new kind-unreachable pos))))
        (= name "trap") (some (try-let ((_ (arity name args 0 pos))) (Ok (expr-new kind-trap pos))))
        (= name "barrier") (some (try-let ((_ (arity name args 0 pos))) (Ok (expr-new KBarrier pos))))
        (= name "sreg") (some (try-let ((_ (arity name args 1 pos)) (r (atom-text (nth args 0) "a special register name")))
                                (if (sreg-name? r) (Ok (expr-new (KSreg r) pos)) (Err (Diagnostic pos (str "sreg: no special register " r))))))
        (= name "phi") (some (phi sub args pos))
        (= name "let") (some (let-form sub args pos))
        (or (= name "call") (= name "tailcall")) (some (direct-call sub name args pos))
        (or (= name "indirect-call") (= name "indirect-tailcall")) (some (indirect-call sub name args pos))
        :else nil))

(defun ret :private (sub: ExprParser args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (cond (= (count args) 0) (Ok (expr-new (KRet nil) pos))
        (= (count args) 1) (try-let ((v (operand sub (nth args 0)))) (Ok (expr-new (KRet (some v)) pos)))
        :else (err pos (str "ret expects at most 1 operand, found " (count args)))))

(defun br :private (sub: ExprParser args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (cond (= (count args) 1) (try-let ((l (label (nth args 0)))) (Ok (expr-new (KBr l) pos)))
        (= (count args) 3)
        (try-let ((c (operand sub (nth args 0))) (t (label (nth args 1))) (f (label (nth args 2))))
          (Ok (expr-new (KCondBr c t f) pos)))
        :else (err pos (str "br expects 1 or 3 operands, found " (count args)))))

(defun switch :private (sub: ExprParser args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (if (< (count args) 2)
      (err pos "switch expects a value, a default label and cases")
      (try-let ((cases (switch-cases sub args)) (v (operand sub (nth args 0))) (d (label (nth args 1))))
        (Ok (expr-new (KSwitch v d cases) pos)))))

;; The cases of a switch, from `args[2..]`; an error in a case is found before one in the value (the Rust builds the cases first).
(defun switch-cases :private (sub: ExprParser args: (Vec Sexp)) -> (Result (Vec LCase) Diagnostic)
  (loop ((i 2) (out []))
    (if (>= i (count args))
        (Ok out)
        (match (nth args i)
          ((SxList kv _)
           (if (= (count kv) 2)
               (match (operand sub (nth kv 0))
                 ((Err d) (Err d))
                 ((Ok c) (match (label (nth kv 1))
                           ((Err d) (Err d))
                           ((Ok l) (recur (+ i 1) (conj out (LCase c l)))))))
               (err (sexp-pos (nth args i)) "a switch case must be ((iK c) LABEL)")))
          (other (err (sexp-pos other) "a switch case must be ((iK c) LABEL)"))))))

(defun phi :private (sub: ExprParser args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (if (< (count args) 2)
      (err pos "phi needs a type and at least one incoming value")
      (try-let ((incoming (phi-entries sub args)) (ty (parse-type (nth args 0))))
        (Ok (expr-new (KPhi ty incoming) pos)))))

(defun phi-entries :private (sub: ExprParser args: (Vec Sexp)) -> (Result (Vec LBinding) Diagnostic)
  (loop ((i 1) (out []))
    (if (>= i (count args))
        (Ok out)
        (match (nth args i)
          ((SxList lv p)
           (if (= (count lv) 2)
               (match (label (nth lv 0))
                 ((Err d) (Err d))
                 ((Ok l) (match (operand sub (nth lv 1))
                           ((Err d) (Err d))
                           ((Ok v) (recur (+ i 1) (conj out (LBinding l v p)))))))
               (err (sexp-pos (nth args i)) "a phi entry must be (LABEL value)")))
          (other (err (sexp-pos other) "a phi entry must be (LABEL value)"))))))

(defun let-form :private (sub: ExprParser args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (match (if (> (count args) 0) (nth args 0) (SxAtom "" 0))
    ((SxList binds _)
     (if (= (count args) 0)
         (err pos "let binding must be (NAME value)")
         (try-let ((bs (let-bindings sub binds)))
           (if (< (count args) 2)
               (err pos "let without a body")
               (try-let ((body (operands sub (vec-from args 1))))
                 (Ok (expr-new (KLet bs body) pos)))))))
    (_ (err pos "let binding must be (NAME value)"))))

(defun let-bindings :private (sub: ExprParser binds: (Vec Sexp)) -> (Result (Vec LBinding) Diagnostic)
  (loop ((i 0) (out []))
    (if (>= i (count binds))
        (Ok out)
        (match (nth binds i)
          ((SxList nv p)
           (if (and (= (count nv) 2) (is-atom? (nth nv 0)))
               (match (atom-text (nth nv 0) "a name")
                 ((Err d) (Err d))
                 ((Ok n) (match (valid-name n p)
                           ((Err d) (Err d))
                           ((Ok name) (match (operand sub (nth nv 1))
                                        ((Err d) (Err d))
                                        ((Ok v) (recur (+ i 1) (conj out (LBinding name v p)))))))))
               (err (sexp-pos (nth binds i)) "let binding must be (NAME value)")))
          (other (err (sexp-pos other) "let binding must be (NAME value)"))))))

(defun is-atom? :private (s: Sexp) -> bool
  (match s ((SxAtom _ _) true) (_ false)))

(defun direct-call :private (sub: ExprParser name: str args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (if (= (count args) 0)
      (err pos (str name " needs a function name @f"))
      (let ((head (nth args 0)) (a (atom-or-empty (nth args 0))))
        (if (and (starts-with? a "@") (> (str-len a) 1))
            (try-let ((xs (operands sub (vec-from args 1))))
              (Ok (expr-new (KCall (CalDirect (str-slice a 1 (str-len a))) xs (= name "tailcall")) pos)))
            (err (sexp-pos head) (str name " needs a function name @f, found " (sexp-describe head)))))))

(defun indirect-call :private (sub: ExprParser name: str args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (if (< (count args) 2)
      (err pos (str name " needs a callee and a function type"))
      (try-let ((ty (parse-fn-type (nth args 1) name))
                (callee (operand sub (nth args 0)))
                (xs (operands sub (vec-from args 2))))
        (Ok (expr-new (KCall (CalIndirect callee ty) xs (= name "indirect-tailcall")) pos)))))
