;; compiler/lir/parse/ty.fib: types in lIR text (crates/lir/src/parse/ty.rs). OWNER: package R. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

(ns lir.parse.ty
  (:use lir.diag lir.types lir.sexp lir.parse.names))


(defstruct ParamTypes (types: (Vec LType) varargs: bool))

;; A convention word taken from the head of a list, and how many items it used (the `(Cc, usize)` of `parse_cc`).
(defstruct CcSplit (cc: LCc used: i64))

;; A type: a scalar keyword, `%struct.NAME`, `<N x E>` (1 to 1024 lanes), `{ T* }`, `[N x T]` (N up to 4294967295). (ty.rs `parse_type`)
(defun parse-type (s: Sexp) -> (Result LType Diagnostic)
  (trap "todo: lir.parse.ty parse-type"))

;; A result type: a type or `void` (nil). (ty.rs `parse_ret`)
(defun parse-ret (s: Sexp) -> (Result (Option LType) Diagnostic)
  (trap "todo: lir.parse.ty parse-ret"))

;; A parameter type list `(T* ...?)`. (ty.rs `parse_params`)
(defun parse-params (s: Sexp) -> (Result ParamTypes Diagnostic)
  (trap "todo: lir.parse.ty parse-params"))

;; The calling convention word at the head of `items`, if any (ccc, tailcc), and how many items it used. (ty.rs `parse_cc`)
(defun parse-cc (items: (Vec Sexp)) -> CcSplit
  (trap "todo: lir.parse.ty parse-cc"))

;; `(fn CC? RET PARAMS)`; `op` names the form in messages. (ty.rs `parse_fn_type`)
(defun parse-fn-type (s: Sexp op: str) -> (Result LFnType Diagnostic)
  (trap "todo: lir.parse.ty parse-fn-type"))
