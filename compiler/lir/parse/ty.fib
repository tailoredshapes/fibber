;; compiler/lir/parse/ty.fib: types in lIR text (crates/lir/src/parse/ty.rs). OWNER: package R.
(ns lir.parse.ty
  (:use lir.diag lir.types lir.sexp lir.parse.names)
  (:require [lir.words :as words]))

(defun old-admitted? :private () -> bool (words/old-admitted?))

(defstruct ParamTypes (types: (Vec LType) varargs: bool))

;; A convention word taken from the head of a list, and how many items it used (the `(Cc, usize)` of `parse_cc`).
(defstruct CcSplit (cc: LCc used: i64))

;; The value of an unsigned decimal text (a leading `+` allowed, as Rust's `u32::from_str`), or -1 when it is not one or exceeds u32::MAX.
(defun parse-u32 (s: str) -> i64
  (let ((n (str-len s))
        (from (if (starts-with? s "+") 1 0)))
    (if (>= from n)
        -1
        (loop ((i from) (acc 0))
          (if (>= i n)
              acc
              (let ((b (zext i64 (str-byte-at s i))))
                (if (and (>= b 48) (<= b 57))
                    (let ((v (+ (* acc 10) (- b 48))))
                      (if (> v 4294967295) -1 (recur (+ i 1) v)))
                    -1)))))))

(defun parse-types :private (items: (Vec Sexp)) -> (Result (Vec LType) Diagnostic)
  (loop ((i 0) (out []))
    (if (>= i (count items))
        (Ok out)
        (match (parse-type (nth items i))
          ((Err d) (Err d))
          ((Ok t) (recur (+ i 1) (conj out t)))))))

;; A type (spec/lir.md 2): a scalar word, `(STRUCT NAME)`, `(VECTOR N E)` (1 to 1024 lanes), `(LITERAL-STRUCT T*)`, `(ARRAY N T)` (N up to
;; 4294967295), `(PTR (ADDRSPACE 1))` and the parameter kind `(OWNED (PTR (ADDRSPACE 1)))` (6.14); while the old spelling is admitted also
;; `%struct.NAME`, `<N x E>`, `{ T* }`, `[N x T]` and `(ptr 1)`. (ty.rs `parse_type`)
(defun parse-type (s: Sexp) -> (Result LType Diagnostic)
  (match s
    ((SxAtom a p) (atom-type a p))
    ((SxVecType n e p) (if (old-admitted?) (vector-of n (scalar-keyword (canon e)) e p) (type-found s)))
    ((SxBrace items _) (if (old-admitted?) (try-let ((ts (parse-types items))) (Ok (TAnon ts))) (type-found s)))
    ((SxBracket items p) (if (old-admitted?) (array-type items p) (type-found s)))
    ((SxList items p) (list-type items p))
    (_ (type-found s))))

(defun type-found :private (s: Sexp) -> (Result LType Diagnostic)
  (err (sexp-pos s) (str "expected a type, found " (sexp-describe s))))

;; The spelled types, by their head word: `(PTR (ADDRSPACE 1))`, `(OWNED T)`, `(STRUCT NAME)`, `(LITERAL-STRUCT T*)`, `(ARRAY N T)`,
;; `(VECTOR N E)`.
(defun list-type :private (items: (Vec Sexp) p: i64) -> (Result LType Diagnostic)
  (let ((head (if (= (count items) 0) "" (word-of (nth items 0))))
        (n (count items)))
    (cond (and (= n 2) (= head "ptr")) (ptr-type (nth items 1) p)
          (and (= n 2) (= head "owned"))
          (try-let ((t (parse-type (nth items 1))))
            (if (type-managed? t) (Ok ty-owned) (err p (str "owned needs (ptr 1), found " (type-str t)))))
          (= head "ptr") (err p "ptr with an address space is (ptr 1)")
          (= head "owned") (err p "owned is (owned (ptr 1))")
          (= head "struct") (if (and (= n 2) (some? (sexp-atom (nth items 1))))
                                (Ok (TNamed (unwrap-or (sexp-atom (nth items 1)) "")))
                                (err p "a struct type is (STRUCT NAME)"))
          (= head "literal-struct") (try-let ((ts (parse-types (vec-from items 1)))) (Ok (TAnon ts)))
          (= head "array") (if (= n 3) (array-of (nth items 1) (nth items 2)) (err p "an array type is (ARRAY N T)"))
          (= head "vector") (if (= n 3)
                                (try-let ((e (parse-type (nth items 2))))
                                  (vector-of (atom-or-empty (nth items 1)) (if (vector-element? e) (some e) nil) (type-str e) p))
                                (err p "a vector type is (VECTOR N E)"))
          :else (err p (str "expected a type, found " (if (= n 0) "()" (sexp-describe (nth items 0))))))))

;; The address space of `(PTR ..)`: `(ADDRSPACE 1)`, or `1` while the old spelling is admitted; the managed reference either way.
(defun ptr-type :private (space: Sexp p: i64) -> (Result LType Diagnostic)
  (let ((one (match space
               ((SxAtom a _) (and (old-admitted?) (= a "1")))
               ((SxList xs _) (and (= (count xs) 2) (atom-word? (nth xs 0) "addrspace") (atom-is? (nth xs 1) "1")))
               (_ false))))
    (if one (Ok ty-managed) (err p (str "ptr: the only address space is 1, found " (sexp-describe space))))))

(defun atom-type :private (a: str p: i64) -> (Result LType Diagnostic)
  (match (scalar-keyword (canon a))
    ((some t) (Ok t))
    (nil (cond (= (canon a) "void") (err p "void is only a function result type")
               (and (old-admitted?) (starts-with? a "%struct.") (> (str-len a) 8)) (Ok (TNamed (str-slice a 8 (str-len a))))
               :else (err p (str "unknown type " a))))))

;; Whether `t` may be a vector's element: an integer type, float, double or ptr (spec/lir.md 2).
(defun vector-element? :private (t: LType) -> bool
  (or (type-int? t) (type-float? t) (= t ty-ptr)))

;; A vector of `n` lanes (text) of the element `e`, nil when the element written as `etext` is none a vector may have.
(defun vector-of :private (n: str e: (Option LType) etext: str p: i64) -> (Result LType Diagnostic)
  (let ((lanes (parse-u32 n)))
    (if (and (>= lanes 1) (<= lanes 1024))
        (match e
          ((some t) (Ok (TVector lanes t)))
          (nil (err p (str "unknown vector element type " etext))))
        (err p "vector length must be 1 to 1024"))))

(defun all-digits? :private (s: str) -> bool
  (loop ((i 0))
    (cond (>= i (str-len s)) true
          (let ((b (zext i64 (str-byte-at s i)))) (and (>= b 48) (<= b 57))) (recur (+ i 1))
          :else false)))

;; `[N x T]` (spec/lir.md 2.1, the old spelling).
(defun array-type :private (items: (Vec Sexp) p: i64) -> (Result LType Diagnostic)
  (if (not (and (= (count items) 3) (atom-is? (nth items 1) "x")))
      (err p "array type must be [N x T]")
      (array-of (nth items 0) (nth items 2))))

;; An array of `n` (an atom of digits) elements of the type `t`.
(defun array-of :private (n: Sexp t: Sexp) -> (Result LType Diagnostic)
  (let ((digits (atom-or-empty n)))
    (cond (not (and (> (str-len digits) 0) (all-digits? digits)))
          (err (sexp-pos n) (str "array length must be a non-negative integer, found " (sexp-describe n)))
          (< (parse-u32 digits) 0) (err (sexp-pos n) (str "array length " digits " is too large"))
          :else (try-let ((ty (parse-type t))) (Ok (TArray (parse-u32 digits) ty))))))

;; A result type: a type or `void` (nil). (ty.rs `parse_ret`)
(defun parse-ret (s: Sexp) -> (Result (Option LType) Diagnostic)
  (if (atom-word? s "void")
      (Ok nil)
      (try-let ((t (parse-type s))) (Ok (some t)))))

;; A parameter type list `(T* ...?)`. (ty.rs `parse_params`)
(defun parse-params (s: Sexp) -> (Result ParamTypes Diagnostic)
  (match s
    ((SxList items _)
     (loop ((i 0) (out []))
       (if (>= i (count items))
           (Ok (ParamTypes out false))
           (let ((t (nth items i)))
             (if (atom-is? t "...")
                 (if (= (+ i 1) (count items))
                     (Ok (ParamTypes out true))
                     (err (sexp-pos t) "... must be the last parameter type"))
                 (match (parse-type t)
                   ((Err d) (Err d))
                   ((Ok ty) (recur (+ i 1) (conj out ty)))))))))
    (_ (err (sexp-pos s) (str "expected a parameter type list, found " (sexp-describe s))))))

;; The calling convention word at the head of `items`, if any (ccc, tailcc, kernelcc), and how many items it used. (ty.rs `parse_cc`)
(defun parse-cc (items: (Vec Sexp)) -> CcSplit
  (let ((w (if (> (count items) 0) (word-of (nth items 0)) "")))
    (cond (= w "tailcc") (CcSplit cc-tail 1)
          (= w "kernelcc") (CcSplit cc-kernel 1)
          (= w "preservemost") (CcSplit cc-preserve 1)
          (= w "ccc") (CcSplit cc-c 1)
          :else (CcSplit cc-c 0))))

;; `(FUNCTION CC? RET PARAMS)` (`(fn ..)` in the old spelling); `op` names the form in messages. (ty.rs `parse_fn_type`)
(defun parse-fn-type (s: Sexp op: str) -> (Result LFnType Diagnostic)
  (match s
    ((SxList items pos)
     (if (and (> (count items) 0) (atom-word? (nth items 0) "fn"))
         (let ((after (vec-from items 1))
               (split (parse-cc after))
               (rest (vec-from after (. split used))))
           (try-let ((_ (arity "fn" rest 2 pos))
                     (ret (parse-ret (nth rest 0)))
                     (ps (parse-params (nth rest 1))))
             (Ok (LFnType (. split cc) ret (. ps types) (. ps varargs)))))
         (fn-type-found s op)))
    (_ (fn-type-found s op))))

(defun fn-type-found :private (s: Sexp op: str) -> (Result LFnType Diagnostic)
  (err (sexp-pos s) (str op " needs a function type (fn R (T..)), found " (sexp-describe s))))
