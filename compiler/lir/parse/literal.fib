;; compiler/lir/parse/literal.fib: literals in lIR text (crates/lir/src/parse/literal.rs). OWNER: package R. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; Integers are `LLit` (lir.lit): `int-token` reads the magnitude with `lit-mul-add`, which refuses what `i128::from_str_radix` refuses (more than
;; 2^127 - 1), then applies the sign; `int-value` checks the range of the type with `lit-fits-int?`.

(ns lir.parse.literal
  (:use lir.diag lir.types lir.lit lir.ast lir.sexp lir.parse.names))


;; An integer token: decimal, `0x`, `0b`, an optional `-`; nil when it is not one or its magnitude exceeds 2^127 - 1. (literal.rs `int_token`)
(defun int-token (s: str) -> (Option LLit)
  (trap "todo: lir.parse.literal int-token"))

;; The value of an `iK` literal token, in range `-2^(K-1) .. 2^K-1`, else `integer literal TOK out of range for iK` or `invalid integer literal TOK`. (literal.rs `int_value`)
(defun int-value (bits: i64 tok: str pos: i64) -> (Result LLit Diagnostic)
  (trap "todo: lir.parse.literal int-value"))

;; The value of a `float` or `double` literal token (`inf`, `-inf`, `nan` included); a finite token that rounds to infinity is out of range. (literal.rs `float_value`)
(defun float-value (ty: LType tok: str pos: i64) -> (Result f64 Diagnostic)
  (trap "todo: lir.parse.literal float-value"))

;; `(iK n)`, `(float x)`, `(double x)`, `(ptr null)`. (literal.rs `scalar_literal`)
(defun scalar-literal (ty: LType args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (trap "todo: lir.parse.literal scalar-literal"))

;; `(<N x E> e..)`. (literal.rs `vector_literal`)
(defun vector-literal (ty: LType args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (trap "todo: lir.parse.literal vector-literal"))

;; `([N x T] e..)`. (literal.rs `array_literal`)
(defun array-literal (ty: LType args: (Vec Sexp) pos: i64) -> (Result LExpr Diagnostic)
  (trap "todo: lir.parse.literal array-literal"))
