;; compiler/lir/check.fib: the whole-module checker (spec/lir.md section 10; crates/lir/src/check/mod.rs). OWNER: package K1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

(ns lir.check
  (:use lir.diag lir.types lir.ast lir.check.env lir.check.globals lir.check.func))


;; Checks the whole module: every error of the module-level rules, else the first error of each global and function. (mod.rs `check`)
(defun check (m: LModule) -> (Result unit (Vec Diagnostic))
  (trap "todo: lir.check check"))

;; The rule for a module that is run or linked into an executable (spec/lir.md 7.2): `main must be (main i32) ..`, `no main function`. (mod.rs `check_main`)
(defun check-main (m: LModule) -> (Result unit Diagnostic)
  (trap "todo: lir.check check-main"))
