;; compiler/lir/respell.fib: `lairf respell` (spec/lir.md 2; the audit's step 3): an lIR text rewritten in the new spelling at the token
;; level. The tokens and their spans are lir.respell.tree's, the grammar-shaped walk lir.respell.walk's and lir.respell.forms', and the
;; output copies every byte the walk did not name, so comments, case headers and layout survive; the result is idempotent and parses to
;; the same tree as the input (compiler/tests/lir/respell.sh holds both over cases/lir). The caller admits the old spelling for the read
;; (lir.words `admitting-old`): the tool must read what it converts.
(ns lir.respell
  (:use lir.diag lir.respell.tree lir.respell.walk lir.respell.forms))

;; `src` in the new spelling, or the lexical error that stops the read.
(defun respell-text (src: str) -> (Result str Diagnostic)
  (try-let ((toks (tokenise src))
            (forms (forms-of toks)))
    (let ((wk (Walk src toks (edits-new))))
      (do (doseq [f forms] (item! wk f))
          (Ok (assemble src toks (. wk ed)))))))

;; The lines on which `a` and `b` differ, for `--check`.
(defun respell-diff (a: str b: str) -> str
  (diff-lines a b))
