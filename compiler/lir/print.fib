;; compiler/lir/print.fib: the printer: AST to lIR text that parses back (new; no Rust counterpart). OWNER: package R. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; Section 2.2 of docs/design/lair-in-fibber.md: `dump(parse(print(parse(text))))` equals `dump(parse(text))`; and at stage 9 the text of an AST
;; the emitter built equals the text it prints today.

(ns lir.print
  (:use lir.diag lir.types lir.ast))


;; The module as lIR text, items in order, one top-level form per paragraph.
(defun print-module (m: LModule) -> str
  (trap "todo: lir.print print-module"))

;; One expression as lIR text.
(defun print-expr (e: LExpr) -> str
  (trap "todo: lir.print print-expr"))
