;; compiler/lir/print.fib: the printer: AST to lIR text that parses back (new; no Rust counterpart). OWNER: package R.

;; Section 2.2 of docs/design/lair-in-fibber.md: `dump(parse(print(parse(text))))` equals `dump(parse(text))`; and at stage 9 the text of an AST
;; the emitter built equals the text it prints today.
;;
;; The text is one form per line, each line the whole form (no indentation): it reads back to the same tree, with other positions. A floating
;; literal is written as the shortest decimal that reads back to the same f64; a NaN is written `nan` (its payload is not kept).
(ns lir.print
  (:use lir.diag lir.types lir.lit lir.ast))

;; The module as lIR text, items in order, one top-level form per line.
(defun print-module (m: LModule) -> str
  (str-join (vec (map (fn (it: LItem) (str (print-item it) "\n")) (. m items)))))

;; One expression as lIR text.
(defun print-expr (e: LExpr) -> str
  (print-kind (. e kind)))

;; ---------------------------------------------------------------- helpers

(defun joined :private (parts: (Vec str)) -> str (str-join-all " " parts))

;; `(a b c)`.
(defun form :private (parts: (Vec str)) -> str (str "(" (joined parts) ")"))

;; The parts joined by sep, linear in their total length.
(defun str-join-all :private (sep: str parts: (Vec str)) -> str
  (str-join (loop ((i 0) (out []))
              (if (>= i (count parts)) out (recur (+ i 1) (if (= i 0) (conj out (nth parts 0)) (conj (conj out sep) (nth parts i))))))))

(defun exprs-text :private (es: (Vec LExpr)) -> (Vec str) (vec (map print-expr es)))

(defun hex2 :private (b: i64) -> str
  (str (str-slice "0123456789abcdef" (shr b 4) (+ (shr b 4) 1)) (str-slice "0123456789abcdef" (bit-and b 15) (+ (bit-and b 15) 1))))

(defun string-text :private (bs: (Array i8)) -> str
  (str "\""
       (str-join (loop ((i 0) (out []))
                   (if (>= i (array-len bs))
                       out
                       (let ((b (zext i64 (array-get bs i))))
                         (recur (+ i 1)
                                (conj out (cond (= b 92) "\\\\" (= b 34) "\\\"" (= b 10) "\\n" (= b 13) "\\r" (= b 9) "\\t"
                                                (and (>= b 32) (<= b 126)) (ascii-char b)
                                                :else (str "\\x" (hex2 b)))))))))
       "\""))

(defun ascii-char :private (b: i64) -> str
  (str-from-bytes (array 1 (trunc i8 b))))

(defun float-text :private (v: f64) -> str
  (cond (not (= v v)) "nan"
        (not (= (- v v) 0.0)) (if (> v 0.0) "inf" "-inf")
        :else (str v)))

;; The number token of a literal written bare in a vector.
(defun vector-element-text :private (e: LExpr) -> str
  (match (. e kind)
    ((KInt _ v) (lit-str v))
    ((KFloat _ v) (float-text v))
    ((KNull) "null")
    (_ (print-expr e))))

;; ---------------------------------------------------------------- operator words

(defun binop-word :private (o: LBinOp) -> str
  (match o
    ((BAdd) "add") ((BSub) "sub") ((BMul) "mul") ((BSDiv) "sdiv") ((BUDiv) "udiv") ((BSRem) "srem") ((BURem) "urem")
    ((BFAdd) "fadd") ((BFSub) "fsub") ((BFMul) "fmul") ((BFDiv) "fdiv") ((BFRem) "frem") ((BAnd) "and") ((BOr) "or")
    ((BXor) "xor") ((BShl) "shl") ((BLShr) "lshr") ((BAShr) "ashr")))

(defun unop-word :private (o: LUnOp) -> str (match o ((UFNeg) "fneg") ((UCtpop) "ctpop")))

(defun ovf-word :private (o: LOvfOp) -> str
  (match o ((OvSAdd) "sadd-overflow") ((OvSSub) "ssub-overflow") ((OvSMul) "smul-overflow")))

(defun cast-word :private (o: LCastOp) -> str
  (match o
    ((CTrunc) "trunc") ((CZExt) "zext") ((CSExt) "sext") ((CFpTrunc) "fptrunc") ((CFpExt) "fpext") ((CFpToSi) "fptosi")
    ((CFpToUi) "fptoui") ((CSiToFp) "sitofp") ((CUiToFp) "uitofp") ((CPtrToInt) "ptrtoint") ((CIntToPtr) "inttoptr")
    ((CBitcast) "bitcast") ((CFpToSiSat) "fptosi-sat") ((CFpToUiSat) "fptoui-sat")))

(defun ipred-word :private (p: LIPred) -> str
  (match p
    ((IEq) "eq") ((INe) "ne") ((ISlt) "slt") ((ISle) "sle") ((ISgt) "sgt") ((ISge) "sge") ((IUlt) "ult") ((IUle) "ule")
    ((IUgt) "ugt") ((IUge) "uge")))

(defun fpred-word :private (p: LFPred) -> str
  (match p
    ((FOeq) "oeq") ((FOne) "one") ((FOlt) "olt") ((FOle) "ole") ((FOgt) "ogt") ((FOge) "oge") ((FOrd) "ord") ((FUeq) "ueq")
    ((FUne) "une") ((FUlt) "ult") ((FUle) "ule") ((FUgt) "ugt") ((FUge) "uge") ((FUno) "uno")))

(defun ord-word :private (o: LOrdering) -> str
  (match o
    ((OUnordered) "unordered") ((OMonotonic) "monotonic") ((OAcquire) "acquire") ((ORelease) "release") ((OAcqRel) "acq_rel")
    ((OSeqCst) "seq_cst")))

(defun rmw-word :private (o: LRmwOp) -> str
  (match o
    ((RXchg) "xchg") ((RAdd) "add") ((RSub) "sub") ((RAnd) "and") ((RNand) "nand") ((ROr) "or") ((RXor) "xor") ((RMax) "max")
    ((RMin) "min") ((RUMax) "umax") ((RUMin) "umin") ((RFAdd) "fadd") ((RFSub) "fsub") ((RFMax) "fmax") ((RFMin) "fmin")))

(defun scope-words :private (s: LScope) -> (Vec str)
  (match s ((ScSystem) []) ((ScSingleThread) ["singlethread"])))

(defun align-words :private (a: (Option i64)) -> (Vec str)
  (match a ((some n) [(str "(align " n ")")]) (nil [])))

(defun flag-words :private (on: bool word: str) -> (Vec str) (if on [word] []))

(defun concat-parts :private (vs: (Vec (Vec str))) -> (Vec str)
  (loop ((i 0) (out []))
    (if (>= i (count vs))
        out
        (recur (+ i 1) (loop ((j 0) (o out)) (if (>= j (count (nth vs i))) o (recur (+ j 1) (conj o (nth (nth vs i) j)))))))))

;; ---------------------------------------------------------------- expressions

(defun print-kind :private (k: LKind) -> str
  (match k
    ((KLocal n) n)
    ((KGlobal n) (str "@" n))
    ((KInt t v) (form [(type-str t) (lit-str v)]))
    ((KFloat t v) (form [(type-str t) (float-text v)]))
    ((KNull) "(ptr null)")
    ((KVector t es) (form (concat-parts [[(type-str t)] (vec (map vector-element-text es))])))
    ((KStr b) (form ["string" (string-text b)]))
    ((KStruct n es)
     (match n
       ((some s) (form (concat-parts [[(str "%struct." s)] (exprs-text es)])))
       (nil (str "{ " (joined (exprs-text es)) " }"))))
    ((KArray t es) (form (concat-parts [[(type-str t)] (exprs-text es)])))
    ((KZero t) (form ["zeroinitializer" (type-str t)]))
    (_ (print-op k))))

(defun print-op :private (k: LKind) -> str
  (match k
    ((KBin op a b) (form [(binop-word op) (print-expr a) (print-expr b)]))
    ((KUn op a) (form [(unop-word op) (print-expr a)]))
    ((KOverflow op a b) (form [(ovf-word op) (print-expr a) (print-expr b)]))
    ((KICmp p a b) (form ["icmp" (ipred-word p) (print-expr a) (print-expr b)]))
    ((KFCmp p a b) (form ["fcmp" (fpred-word p) (print-expr a) (print-expr b)]))
    ((KCast op t v) (form [(cast-word op) (type-str t) (print-expr v)]))
    ((KSelect c a b) (form ["select" (print-expr c) (print-expr a) (print-expr b)]))
    ((KExtractElement v i) (form ["extractelement" (print-expr v) (print-expr i)]))
    ((KInsertElement v x i) (form ["insertelement" (print-expr v) (print-expr x) (print-expr i)]))
    ((KShuffle a b m) (form ["shufflevector" (print-expr a) (print-expr b) (print-expr m)]))
    ((KExtractValue a ix) (form (concat-parts [["extractvalue" (print-expr a)] (vec (map lit-str ix))])))
    ((KInsertValue a v ix) (form (concat-parts [["insertvalue" (print-expr a) (print-expr v)] (vec (map lit-str ix))])))
    (_ (print-memory k))))

(defun print-memory :private (k: LKind) -> str
  (match k
    ((KAlloca t count align)
     (form (concat-parts [["alloca"] (align-words align) [(type-str t)] (match count ((some c) [(print-expr c)]) (nil []))])))
    ((KLoad t p vol align)
     (form (concat-parts [["load"] (flag-words vol "volatile") (align-words align) [(type-str t) (print-expr p)]])))
    ((KStore v p vol align)
     (form (concat-parts [["store"] (flag-words vol "volatile") (align-words align) [(print-expr v) (print-expr p)]])))
    ((KGep inb t p ix)
     (form (concat-parts [["getelementptr"] (flag-words inb "inbounds") [(type-str t) (print-expr p)] (exprs-text ix)])))
    ((KAtomicLoad sc ord t p)
     (form (concat-parts [["atomic-load"] (scope-words sc) [(ord-word ord) (type-str t) (print-expr p)]])))
    ((KAtomicStore sc ord v p)
     (form (concat-parts [["atomic-store"] (scope-words sc) [(ord-word ord) (print-expr v) (print-expr p)]])))
    ((KAtomicRmw op sc ord p v)
     (form (concat-parts [["atomicrmw" (rmw-word op)] (scope-words sc) [(ord-word ord) (print-expr p) (print-expr v)]])))
    ((KCmpXchg weak sc succ fail p e n)
     (form (concat-parts [["cmpxchg"] (flag-words weak "weak") (scope-words sc)
                          [(ord-word succ) (ord-word fail) (print-expr p) (print-expr e) (print-expr n)]])))
    ((KFence sc ord) (form (concat-parts [["fence"] (scope-words sc) [(ord-word ord)]])))
    (_ (print-control k))))

(defun print-control :private (k: LKind) -> str
  (match k
    ((KTrap) "(trap)")
    ((KBarrier) "(barrier)")
    ((KSreg r) (str "(sreg " r ")"))
    ((KIntrin name flags ty args align)
     (form (concat-parts [[name] (fm-words flags) (match ty ((some t) [(type-str t)]) (nil [])) (exprs-text args) (align-words align)])))
    ((KCall callee args tail) (print-call callee args tail))
    ((KRet v) (match v ((some x) (form ["ret" (print-expr x)])) (nil "(ret)")))
    ((KBr l) (form ["br" l]))
    ((KCondBr c t f) (form ["br" (print-expr c) t f]))
    ((KSwitch v d cases)
     (form (concat-parts [["switch" (print-expr v) d]
                          (vec (map (fn (c: LCase) (form [(print-expr (. c value)) (. c label)])) cases))])))
    ((KUnreachable) "(unreachable)")
    ((KPhi t bs) (form (concat-parts [["phi" (type-str t)] (vec (map binding-text bs))])))
    ((KLet bs body)
     (form (concat-parts [["let" (form (vec (map binding-text bs)))] (exprs-text body)])))
    (_ "")))

(defun binding-text :private (b: LBinding) -> str (form [(. b name) (print-expr (. b value))]))

(defun print-call :private (callee: LCallee args: (Vec LExpr) tail: bool) -> str
  (match callee
    ((CalDirect n) (form (concat-parts [[(if tail "tailcall" "call") (str "@" n)] (exprs-text args)])))
    ((CalIndirect c ty)
     (form (concat-parts [[(if tail "indirect-tailcall" "indirect-call") (print-expr c) (fn-type-str ty)] (exprs-text args)])))))

;; ---------------------------------------------------------------- items

(defun linkage-words :private (m: LModifiers) -> (Vec str)
  (concat-parts [(match (. m linkage) ((LkExternal) []) ((LkInternal) ["internal"]) ((LkPrivate) ["private"]))
                 (flag-words (. m hidden) "hidden")]))

(defun cc-words :private (f: LFnType) -> (Vec str)
  (match (. f cc) ((CcC) []) ((CcTail) ["tailcc"]) ((CcKernel) ["kernelcc"])))

(defun print-item :private (it: LItem) -> str
  (match it
    ((ItStruct s) (form ["defstruct" (. s name) (form (vec (map type-str (. s fields))))]))
    ((ItGlobal g)
     (form (concat-parts [[(if (. g constant) "constant" "global")] (linkage-words (. g mods)) (flag-words (. g shared) "shared")
                          [(. g name) (type-str (. g ty)) (print-expr (. g init))]])))
    ((ItDeclareGlobal g) (form (concat-parts [["declare-global"] (flag-words (. g hidden) "hidden") [(. g name) (type-str (. g ty))]])))
    ((ItDeclare f)
     (form (concat-parts [["declare"] (flag-words (. f hidden) "hidden") (cc-words (. f ty))
                          [(. f name) (ret-str (. (. f ty) ret)) (fn-params-str (. f ty))]])))
    ((ItTarget t)
     (form ["target" (form ["cpu" (str "\"" (. t cpu) "\"")]) (form ["features" (str "\"" (. t features) "\"")])]))
    ((ItDefine f)
     (form (concat-parts [["define"] (linkage-words (. f mods)) (cc-words (. f ty))
                          [(form [(. f name) (ret-str (. (. f ty) ret))]) (params-text f)]
                          (vec (map block-text (. f blocks)))])))))

(defun params-text :private (f: LFunction) -> str
  (form (loop ((i 0) (out []))
          (if (>= i (count (. f params)))
              out
              (recur (+ i 1) (conj out (form [(type-str (nth (. (. f ty) params) i)) (. (nth (. f params) i) name)])))))))

(defun block-text :private (b: LBlock) -> str
  (form (concat-parts [["block" (. b label)] (exprs-text (. b body))])))
