;; compiler/lir/check/intrin.fib: the type rules of the intrinsic forms (spec/lir.md 6.1, 6.4, 6.5; lir.intrin has the table). The Rust checker has
;; none of these. OWNER: package P0 (SIMD wave 2).

;; Operands are typed with `fcx-val`, left to right, as in lir.check.arith, so that the first error is the one the spec's order gives.

(ns lir.check.intrin
  (:use lir.diag lir.types lir.lit lir.ast lir.intrin lir.check.fcx lir.check.arith lir.check.memory lir.check.ownforms))


;; The type of the form (nil for void).
(defun check-intrin (fcx: Fcx e: LExpr) -> (Result (Option LType) Diagnostic)
  (match (. e kind)
    ((KIntrin name flags ty args _)
     (let ((c (intrin-class name)) (p (. e pos)))
       (cond (or (= c "f1") (= c "f2") (= c "f3") (= c "fbin")) (some-t (check-float-fn fcx name args p))
             (or (= c "i1") (= c "i2")) (some-t (check-int-fn fcx name args p))
             (or (= c "red-i") (= c "red-m") (= c "red-f")) (some-t (check-reduce fcx name c args p))
             (= c "warp") (some-t (check-warp fcx name args p))
             (= c "hint") (Ok nil)
             (= c "const") (Ok (some ty-i64))
             (= c "ibin") (some-t (check-int-fact fcx name flags args p))
             (= c "assume") (check-assume fcx args p)
             (= c "rload") (check-range-load fcx e)
             (= c "own") (check-own-form fcx name ty args p)
             :else (check-masked fcx name c ty args p))))
    (_ (err (. e pos) "internal error: not an intrinsic form"))))

;; The warp forms (spec/lir.md 6.9a): `(shfl-MODE v lane)` is `v`'s type (i32 or float) with an i32 lane operand; `(ballot c)` takes an i1 and is an i32.
(defun check-warp :private (fcx: Fcx name: str args: (Vec LExpr) pos: i64) -> (Result LType Diagnostic)
  (if (= name "ballot")
      (try-let ((tc (fcx-val fcx (nth args 0))))
        (if (= tc ty-i1) (Ok ty-i32) (err pos (str "ballot needs an i1 operand, found " (type-str tc)))))
      (try-let ((tv (fcx-val fcx (nth args 0))) (tl (fcx-val fcx (nth args 1))))
        (cond (not (or (= tv ty-i32) (= tv ty-float))) (err pos (str name " needs an i32 or float value, found " (type-str tv)))
              (not (= tl ty-i32)) (err pos (str name " needs an i32 lane, found " (type-str tl)))
              :else (Ok tv)))))

(defun some-t :private (r: (Result LType Diagnostic)) -> (Result (Option LType) Diagnostic)
  (match r ((Ok t) (Ok (some t))) ((Err d) (Err d))))

;; The operands after the first, each of the type of the first: `NAME: operand K has type X, expected Y`.
(defun same-rest :private (fcx: Fcx name: str args: (Vec LExpr) ta: LType pos: i64) -> (Result unit Diagnostic)
  (loop ((k 1))
    (if (>= k (count args))
        (Ok ())
        (match (fcx-val fcx (nth args k))
          ((Err d) (Err d))
          ((Ok tk) (match (fcx-same fcx name (+ k 1) tk ta pos)
                     ((Err d) (Err d))
                     ((Ok _) (recur (+ k 1)))))))))

(defun check-float-fn :private (fcx: Fcx name: str args: (Vec LExpr) pos: i64) -> (Result LType Diagnostic)
  (try-let ((ta (fcx-val fcx (nth args 0))))
    (if (not (type-float-like? ta))
        (err pos (str name " needs float operands, found " (type-str ta)))
        (try-let ((_ (same-rest fcx name args ta pos))) (Ok ta)))))

(defun check-int-fn :private (fcx: Fcx name: str args: (Vec LExpr) pos: i64) -> (Result LType Diagnostic)
  (try-let ((ta (fcx-val fcx (nth args 0))))
    (if (not (type-int-like? ta))
        (err pos (str name " needs integer operands, found " (type-str ta)))
        (try-let ((_ (same-rest fcx name args ta pos))) (Ok ta)))))

;; The element type of a vector whose elements satisfy `ok`, else the error naming `what`.
(defun vector-elem :private (name: str what: str ok: (fn (LType) bool) t: LType pos: i64) -> (Result LType Diagnostic)
  (match t
    ((TVector _ el) (if (ok el) (Ok el) (err pos (str name " needs " what " vector operand, found " (type-str t)))))
    (_ (err pos (str name " needs " what " vector operand, found " (type-str t))))))

(defun check-reduce :private (fcx: Fcx name: str c: str args: (Vec LExpr) pos: i64) -> (Result LType Diagnostic)
  (cond (= c "red-i") (try-let ((tv (fcx-val fcx (nth args 0)))) (vector-elem name "an integer" type-int? tv pos))
        (= c "red-m") (try-let ((tv (fcx-val fcx (nth args 0)))) (vector-elem name "a float" type-float? tv pos))
        :else (try-let ((ta (fcx-val fcx (nth args 0)))
                        (tv (fcx-val fcx (nth args 1)))
                        (el (vector-elem name "a float" type-float? tv pos))
                        (_ (fcx-same fcx name 1 ta el pos)))
                (Ok el))))

;; `<N x i1>` for the lanes of the vector type `t`.
(defun mask-of :private (t: LType) -> LType
  (match t ((TVector n _) (TVector n ty-i1)) (_ ty-i1)))

(defun ptrs-of :private (t: LType) -> LType
  (match t ((TVector n _) (TVector n ty-ptr)) (_ ty-ptr)))

;; A vector of integers or floats: the operand or type of a masked access.
(defun mem-vector :private (name: str t: LType what: str pos: i64) -> (Result unit Diagnostic)
  (match t
    ((TVector _ el) (if (or (type-int? el) (type-float? el))
                        (Ok ())
                        (err pos (str name " needs a vector of integers or floats, found " (type-str t)))))
    (_ (err pos (str name " needs " what ", found " (type-str t))))))

(defun ptr-operand :private (fcx: Fcx name: str e: LExpr pos: i64) -> (Result unit Diagnostic)
  (try-let ((tp (fcx-val fcx e)))
    (if (= tp ty-ptr) (Ok ()) (err pos (str name " needs a ptr operand, found " (type-str tp))))))

(defun operand-is :private (fcx: Fcx name: str k: i64 e: LExpr want: LType pos: i64) -> (Result unit Diagnostic)
  (try-let ((t (fcx-val fcx e)))
    (fcx-same fcx name k t want pos)))

(defun check-masked :private (fcx: Fcx name: str c: str ty: (Option LType) args: (Vec LExpr) pos: i64) -> (Result (Option LType) Diagnostic)
  (cond (= c "mload")
        (let ((t (unwrap-or ty ty-i32)))
          (try-let ((u1 (fcx-valid fcx t pos)) (u2 (mem-vector name t "a vector type" pos))
                    (u3 (ptr-operand fcx name (nth args 0) pos))
                    (u4 (operand-is fcx name 2 (nth args 1) (mask-of t) pos))
                    (u5 (operand-is fcx name 3 (nth args 2) t pos)))
            (Ok (some t))))
        (= c "gather")
        (let ((t (unwrap-or ty ty-i32)))
          (try-let ((u6 (fcx-valid fcx t pos)) (u7 (mem-vector name t "a vector type" pos))
                    (u8 (operand-is fcx name 1 (nth args 0) (ptrs-of t) pos))
                    (u9 (operand-is fcx name 2 (nth args 1) (mask-of t) pos))
                    (u10 (operand-is fcx name 3 (nth args 2) t pos)))
            (Ok (some t))))
        (= c "mstore")
        (try-let ((tv (fcx-val fcx (nth args 0)))
                  (u11 (mem-vector name tv "a vector operand" pos))
                  (u12 (ptr-operand fcx name (nth args 1) pos))
                  (u13 (operand-is fcx name 3 (nth args 2) (mask-of tv) pos)))
          (Ok nil))
        :else
        (try-let ((tv (fcx-val fcx (nth args 0)))
                  (u14 (mem-vector name tv "a vector operand" pos))
                  (u15 (operand-is fcx name 2 (nth args 1) (ptrs-of tv) pos))
                  (u16 (operand-is fcx name 3 (nth args 2) (mask-of tv) pos)))
          (Ok nil))))

;; ---------------------------------------------------------------- facts (spec/lir.md 6.13)

(defun fact-binop :private (name: str) -> LBinOp
  (cond (= name "add") BAdd (= name "sub") BSub (= name "mul") BMul :else BShl))

;; `(add nsw a b)` and kin: the rules of the unflagged form, then the literal rule: two literal operands whose operation wraps as a flag
;; says it does not are an error, since the fact is already false.
(defun check-int-fact :private (fcx: Fcx name: str flags: i64 args: (Vec LExpr) pos: i64) -> (Result LType Diagnostic)
  (try-let ((t (check-bin fcx (fact-binop name) (nth args 0) (nth args 1) pos)))
    (match (literal-wrap name flags t (nth args 0) (nth args 1))
      ((some w) (err pos (str name " " w " wraps on its literal operands")))
      (nil (Ok t)))))

;; The flag word that two scalar literal operands violate, nil when they are not both literals or none is violated.
;; The flag word that two scalar literal operands violate, nil when they are not both literals or none is violated.
(defun literal-wrap :private (name: str flags: i64 t: LType a: LExpr b: LExpr) -> (Option str)
  (match t
    ((TInt k)
     (if-some (x (expr-int-literal a))
       (if-some (y (expr-int-literal b))
         (cond (and (not (= (bit-and flags ifl-nsw) 0)) (not (fits-signed? k (int-op name k x y true)))) (some "nsw")
               (and (not (= (bit-and flags ifl-nuw) 0)) (not (fits-unsigned? k (int-op name k x y false)))) (some "nuw")
               :else nil)
         nil)
       nil))
    (_ nil)))

;; The literal's value as a `k`-bit integer read signed or unsigned.
(defun read-as :private (k: i64 v: LLit signed: bool) -> LLit
  (let ((u (lit-low v k)))
    (cond (not signed) (LLit 0 u)
          (>= k 64) (lit-of u)
          :else (lit-of (sar (shl u (- 64 k)) (- 64 k))))))

;; The exact result of the operation on the two operands read as `k`-bit integers (a shift amount is below `k`: check-bin's rule).
(defun int-op :private (name: str k: i64 x: LLit y: LLit signed: bool) -> LLit
  (let ((a (read-as k x signed)) (b (read-as k y signed)))
    (cond (= name "add") (lit-add a b)
          (= name "sub") (lit-add a (lit-neg b))
          (= name "mul") (lit-mul a b)
          :else (lit-mul a (lit-pow2 (lit-low y k))))))

(defun fits-signed? :private (k: i64 v: LLit) -> bool
  (and (>= (lit-cmp v (lit-neg (lit-pow2 (- k 1)))) 0) (lit-lt? v (lit-pow2 (- k 1)))))

(defun fits-unsigned? :private (k: i64 v: LLit) -> bool
  (and (not (lit-negative? v)) (lit-lt? v (lit-pow2 k))))

;; `(assume c)`: `c` an i1; void. A literal false is an error: the fact is already false.
(defun check-assume :private (fcx: Fcx args: (Vec LExpr) pos: i64) -> (Result (Option LType) Diagnostic)
  (try-let ((t (fcx-val fcx (nth args 0))))
    (cond (not (= t ty-i1)) (err pos (str "assume needs an i1 operand, found " (type-str t)))
          (literal-false? (nth args 0)) (err pos "assume of a literal false")
          :else (Ok nil))))

(defun literal-false? :private (e: LExpr) -> bool
  (match (expr-int-literal e) ((some v) (= (lit-low v 1) 0)) (nil false)))

;; `(load (range LO HI) T p)`: the rules of the plain load, then `T` a scalar integer and `-2^(K-1) <= LO < HI <= 2^(K-1)`, read signed,
;; not every value of `T` (LLVM's `!range` may not be the full set).
(defun check-range-load :private (fcx: Fcx e: LExpr) -> (Result (Option LType) Diagnostic)
  (match (. e kind)
    ((KIntrin _ _ ty args align)
     (let ((t (unwrap-or ty ty-i32)) (pos (. e pos)))
       (try-let ((r (check-memory fcx (LExpr (KLoad t (nth args 0) false align) pos))))
         (match t
           ((TInt k) (if-some (lo (expr-int-literal (nth args 1)))
                       (if-some (hi (expr-int-literal (nth args 2)))
                         (range-rules k t lo hi pos)
                         (err pos "range must be (range LO HI) with two integers"))
                       (err pos "range must be (range LO HI) with two integers")))
           (_ (err pos (str "range needs an integer load type, found " (type-str t))))))))
    (_ (err (. e pos) "internal error: not a range load"))))

(defun range-rules :private (k: i64 t: LType lo: LLit hi: LLit pos: i64) -> (Result (Option LType) Diagnostic)
  (let ((min (lit-neg (lit-pow2 (- k 1)))) (top (lit-pow2 (- k 1))))
    (cond (lit-lt? lo min) (err pos (str "range bound " (lit-str lo) " is out of range for " (type-str t)))
          (lit-lt? top hi) (err pos (str "range bound " (lit-str hi) " is out of range for " (type-str t)))
          (not (lit-lt? lo hi)) (err pos (str "range needs LO < HI, found " (lit-str lo) " " (lit-str hi)))
          (and (= (lit-cmp lo min) 0) (= (lit-cmp hi top) 0)) (err pos (str "range covers every value of " (type-str t)))
          :else (Ok (some t)))))
