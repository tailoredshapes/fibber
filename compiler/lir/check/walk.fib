;; compiler/lir/check/walk.fib: walking expressions: sub-expressions in evaluation order, a block's statements, the names a function binds, and constants (crates/lir/src/check/walk.rs, and `is_constant` and `emits` of check/expr.rs). OWNER: package K1.

;; `constant?` and `emits?` live here, and not with the dispatcher, because phi.rs and globals.rs use them and the dispatcher requires phi.

(ns lir.check.walk
  (:use lir.diag lir.types lir.ast))


;; Where each name is bound: the block index of a `let`, -1 for a parameter (Rust `None`); and the names bound directly to an uncounted
;; `alloca`, with its type (walk.rs `Bindings`).
(defstruct Bindings (defs: (Map str i64) allocas: (Map str LType)))

;; The expressions of a callee head, then the arguments.
(defun call-children (callee: LCallee args: (Vec LExpr)) -> (Vec LExpr)
  (match callee
    ((CalIndirect p _) (into [p] args))
    ((CalDirect _) args)))

;; The values of the bindings, then the body.
(defun let-children (binds: (Vec LBinding) body: (Vec LExpr)) -> (Vec LExpr)
  (loop ((i 0) (acc (vec-empty)))
    (if (>= i (count binds))
        (into acc body)
        (recur (+ i 1) (conj acc (. (nth binds i) value))))))

(defun case-values (v: LExpr cases: (Vec LCase)) -> (Vec LExpr)
  (loop ((i 0) (acc [v]))
    (if (>= i (count cases))
        acc
        (recur (+ i 1) (conj acc (. (nth cases i) value))))))

(defun phi-values (inc: (Vec LBinding)) -> (Vec LExpr)
  (loop ((i 0) (acc (vec-empty)))
    (if (>= i (count inc))
        acc
        (recur (+ i 1) (conj acc (. (nth inc i) value))))))

;; Direct sub-expressions in evaluation order (spec/lir.md 5.2). (walk.rs `children`)
(defun children (e: LExpr) -> (Vec LExpr)
  (match (. e kind)
    ((KVector _ es) es)
    ((KStruct _ es) es)
    ((KArray _ es) es)
    ((KUn _ a) [a])
    ((KCast _ _ a) [a])
    ((KExtractValue a _) [a])
    ((KAtomicLoad _ _ _ a) [a])
    ((KLoad _ a _ _) [a])
    ((KRet v) (match v ((some a) [a]) (nil (vec-empty))))
    ((KCondBr a _ _) [a])
    ((KAlloca _ c _) (match c ((some a) [a]) (nil (vec-empty))))
    ((KStore a b _ _) [a b])
    ((KBin _ a b) [a b])
    ((KOverflow _ a b) [a b])
    ((KICmp _ a b) [a b])
    ((KFCmp _ a b) [a b])
    ((KExtractElement a b) [a b])
    ((KInsertValue a b _) [a b])
    ((KAtomicStore _ _ a b) [a b])
    ((KAtomicRmw _ _ _ a b) [a b])
    ((KSelect a b c) [a b c])
    ((KInsertElement a b c) [a b c])
    ((KShuffle a b c) [a b c])
    ((KGep _ _ p idx) (into [p] idx))
    ((KCmpXchg _ _ _ _ p x n) [p x n])
    ((KCall callee args _) (call-children callee args))
    ((KSwitch v _ cases) (case-values v cases))
    ((KPhi _ inc) (phi-values inc))
    ((KLet binds body) (let-children binds body))
    (_ (vec-empty))))

;; The statements of a body, appended to `acc`.
(defun statements-into (body: (Vec LExpr) acc: (Vec LExpr)) -> (Vec LExpr)
  (loop ((i 0) (acc acc))
    (if (>= i (count body))
        acc
        (let ((e (nth body i)))
          (recur (+ i 1)
                 (match (. e kind)
                   ((KLet _ inner) (statements-into inner acc))
                   (_ (conj acc e))))))))

;; A block's statements: its forms, a top-level `let` contributing its body (spec/lir.md 5.1). (walk.rs `statements`)
(defun statements (body: (Vec LExpr)) -> (Vec LExpr)
  (if (any-let? body 0)
      (statements-into body (vec-empty))
      body))

;; Whether a form of `body` from index i on is a `let`; with none the statements are the body itself, shared, not copied.
(defun any-let? :private (body: (Vec LExpr) i: i64) -> bool
  (loop ((i i))
    (if (>= i (count body))
        false
        (match (. (nth body i) kind)
          ((KLet _ _) true)
          (_ (recur (+ i 1)))))))

;; The state of the collection: the two maps, in cells so that an `assoc` writes in place, and the function's name for messages. The walk
;; answers the diagnostic that stops it, nil for none, so that a node costs no Result and no new Bindings (the profile of `check` had this
;; walk, with its `children` vector at every node, as the largest part of the checker).
(defstruct Collector (defs: (Cell (Map str i64)) allocas: (Cell (Map str LType)) fname: str))

;; Records the name `name` bound in block `blk` (-1: a parameter), or the error of a second binding. (walk.rs `add`)
(defun bind-add (c: Collector name: str blk: i64 pos: i64) -> (Option Diagnostic)
  (let ((defs (. c defs)))
    (if (contains? @defs name)
        (some (Diagnostic pos (str "duplicate name " name " in @" (. c fname))))
        (do (update! defs (fn (m) (assoc m name blk))) nil))))

;; The binding of `bind` and everything inside its value. (walk.rs `collect`, one binding of a `let`)
(defun collect-bind (c: Collector bind: LBinding blk: i64) -> (Option Diagnostic)
  (match (collect c (. bind value) blk)
    ((some d) (some d))
    (nil (match (bind-add c (. bind name) blk (. bind pos))
           ((some d) (some d))
           (nil (match (. (. bind value) kind)
                  ((KAlloca ty nil _) (let ((al (. c allocas)) (name (. bind name))) (do (update! al (fn (m) (assoc m name ty))) nil)))
                  (_ nil)))))))

;; Every expression of `es` from index `from`, collected in order.
(defun collect-all (c: Collector es: (Vec LExpr) from: i64 blk: i64) -> (Option Diagnostic)
  (loop ((i from))
    (if (>= i (count es))
        nil
        (match (collect c (nth es i) blk)
          (nil (recur (+ i 1)))
          (d d)))))

(defun collect-binds (c: Collector binds: (Vec LBinding) blk: i64) -> (Option Diagnostic)
  (loop ((i 0))
    (if (>= i (count binds))
        nil
        (match (collect-bind c (nth binds i) blk)
          (nil (recur (+ i 1)))
          (d d)))))

(defun collect-2 (c: Collector a: LExpr b: LExpr blk: i64) -> (Option Diagnostic)
  (match (collect c a blk)
    (nil (collect c b blk))
    (d d)))

(defun collect-3 (c: Collector a: LExpr b: LExpr x: LExpr blk: i64) -> (Option Diagnostic)
  (match (collect c a blk)
    (nil (collect-2 c b x blk))
    (d d)))

(defun collect-opt (c: Collector o: (Option LExpr) blk: i64) -> (Option Diagnostic)
  (match o
    ((some a) (collect c a blk))
    (nil nil)))

;; The expressions of `children` in its order, collected, without the vector `children` would make for the fixed shapes.
(defun collect-kids (c: Collector e: LExpr blk: i64) -> (Option Diagnostic)
  (match (. e kind)
    ((KVector _ es) (collect-all c es 0 blk))
    ((KStruct _ es) (collect-all c es 0 blk))
    ((KArray _ es) (collect-all c es 0 blk))
    ((KUn _ a) (collect c a blk))
    ((KCast _ _ a) (collect c a blk))
    ((KExtractValue a _) (collect c a blk))
    ((KAtomicLoad _ _ _ a) (collect c a blk))
    ((KLoad _ a _ _) (collect c a blk))
    ((KRet v) (collect-opt c v blk))
    ((KCondBr a _ _) (collect c a blk))
    ((KAlloca _ n _) (collect-opt c n blk))
    ((KStore a b _ _) (collect-2 c a b blk))
    ((KBin _ a b) (collect-2 c a b blk))
    ((KOverflow _ a b) (collect-2 c a b blk))
    ((KICmp _ a b) (collect-2 c a b blk))
    ((KFCmp _ a b) (collect-2 c a b blk))
    ((KExtractElement a b) (collect-2 c a b blk))
    ((KInsertValue a b _) (collect-2 c a b blk))
    ((KAtomicStore _ _ a b) (collect-2 c a b blk))
    ((KAtomicRmw _ _ _ a b) (collect-2 c a b blk))
    ((KSelect a b x) (collect-3 c a b x blk))
    ((KInsertElement a b x) (collect-3 c a b x blk))
    ((KShuffle a b x) (collect-3 c a b x blk))
    ((KCmpXchg _ _ _ _ p x n) (collect-3 c p x n blk))
    ((KGep _ _ p idx) (match (collect c p blk) (nil (collect-all c idx 0 blk)) (d d)))
    ((KCall callee args _)
     (match callee
       ((CalIndirect p _) (match (collect c p blk) (nil (collect-all c args 0 blk)) (d d)))
       ((CalDirect _) (collect-all c args 0 blk))))
    (_ (collect-vec c e blk))))

;; The shapes with a vector of bindings or cases, through `children`.
(defun collect-vec :private (c: Collector e: LExpr blk: i64) -> (Option Diagnostic)
  (match (. e kind)
    ((KSwitch _ _ _) (collect-all c (children e) 0 blk))
    ((KPhi _ _) (collect-all c (children e) 0 blk))
    (_ nil)))

(defun collect (c: Collector e: LExpr blk: i64) -> (Option Diagnostic)
  (match (. e kind)
    ((KLet binds body)
     (match (collect-binds c binds blk)
       (nil (collect-all c body 0 blk))
       (d d)))
    (_ (collect-kids c e blk))))

(defun collect-blocks (c: Collector f: LFunction) -> (Option Diagnostic)
  (loop ((i 0))
    (if (>= i (count (. f blocks)))
        nil
        (match (collect-all c (. (nth (. f blocks) i) body) 0 i)
          (nil (recur (+ i 1)))
          (d d)))))

(defun collect-params (c: Collector f: LFunction) -> (Option Diagnostic)
  (loop ((i 0))
    (if (>= i (count (. f params)))
        nil
        (let ((p (nth (. f params) i)))
          (match (bind-add c (. p name) -1 (. p pos))
            (nil (recur (+ i 1)))
            (d d))))))

;; Collects every binding of `f`, rejecting a name bound twice: `duplicate name X in @f`. (walk.rs `bindings`)
(defun bindings (f: LFunction) -> (Result Bindings Diagnostic)
  (let ((c (Collector (cell {}) (cell {}) (. f name))))
    (match (collect-params c f)
      ((some d) (Err d))
      (nil (match (collect-blocks c f)
             ((some d) (Err d))
             (nil (Ok (Bindings @(. c defs) @(. c allocas)))))))))

;; A constant written in place: literals, `@name`, strings, `zeroinitializer` and structs or arrays of constants (spec/lir.md 6.11, 9). (expr.rs `is_constant`)
(defun constant? (e: LExpr) -> bool
  (match (. e kind)
    ((KInt _ _) true)
    ((KFloat _ _) true)
    ((KNull) true)
    ((KVector _ _) true)
    ((KStr _) true)
    ((KGlobal _) true)
    ((KZero _) true)
    ((KStruct _ fs) (every? constant? fs))
    ((KArray _ fs) (every? constant? fs))
    (_ false)))

;; Whether evaluating `e` emits an instruction of its own (a phi must come before any, spec/lir.md 5.4). (expr.rs `emits`)
(defun emits? (e: LExpr) -> bool
  (match (. e kind)
    ((KLocal _) false)
    ((KGlobal _) false)
    ((KInt _ _) false)
    ((KFloat _ _) false)
    ((KNull) false)
    ((KVector _ _) false)
    ((KStr _) false)
    ((KZero _) false)
    ((KLet _ _) false)
    ((KPhi _ _) false)
    ((KStruct _ fs) (not (every? constant? fs)))
    ((KArray _ fs) (not (every? constant? fs)))
    (_ true)))
