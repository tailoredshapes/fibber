;; compiler/lir/check/env.fib: the module environment: structs, functions and globals, with the module-level rules of spec/lir.md 4.1 (crates/lir/src/check/env.rs). OWNER: package K1.

;; An `LEnv` is built once by `env-build` and only borrowed afterwards.

(ns lir.check.env
  (:use lir.diag lir.types lir.ast))


;; What a global name denotes (env.rs `Symbol`).
(defenum LSymbol
  (SymFunc ty: LFnType)
  (SymVar ty: LType constant: bool))

;; env.rs `Env`: struct bodies by name and symbols by name.
(defstruct LEnv (structs: (Map str (Vec LType)) symbols: (Map str LSymbol)))

(defstruct StructAt (name: str pos: i64))

;; The environment under construction: the env, the struct names with their positions in order, and the errors so far.
(defstruct EnvAcc (env: LEnv order: (Vec StructAt) errs: (Vec Diagnostic)))

(defun acc-err (a: EnvAcc d: Diagnostic) -> EnvAcc
  (EnvAcc (. a env) (. a order) (conj (. a errs) d)))

;; Adds a global name. (env.rs `add`, the non-struct items)
(defun env-add-symbol (a: EnvAcc name: str pos: i64 sym: LSymbol) -> EnvAcc
  (cond (starts-with? name "llvm.") (acc-err a (Diagnostic pos (str "name @" name " is reserved")))
        (contains? (. (. a env) symbols) name)
        (acc-err (EnvAcc (LEnv (. (. a env) structs) (assoc (. (. a env) symbols) name sym)) (. a order) (. a errs))
                 (Diagnostic pos (str "duplicate definition of @" name)))
        :else (EnvAcc (LEnv (. (. a env) structs) (assoc (. (. a env) symbols) name sym)) (. a order) (. a errs))))

(defun env-add-struct (a: EnvAcc s: LStructDef) -> EnvAcc
  (let ((env (LEnv (assoc (. (. a env) structs) (. s name) (. s fields)) (. (. a env) symbols))))
    (if (contains? (. (. a env) structs) (. s name))
        (acc-err (EnvAcc env (. a order) (. a errs)) (Diagnostic (. s pos) (str "duplicate struct %struct." (. s name))))
        (EnvAcc env (conj (. a order) (StructAt (. s name) (. s pos))) (. a errs)))))

(defun env-add (a: EnvAcc item: LItem) -> EnvAcc
  (match item
    ((ItStruct s) (env-add-struct a s))
    ((ItGlobal g) (env-add-symbol a (. g name) (. g pos) (SymVar (. g ty) (. g constant))))
    ((ItDeclareGlobal g) (env-add-symbol a (. g name) (. g pos) (SymVar (. g ty) false)))
    ((ItDeclare d) (env-add-symbol a (. d name) (. d pos) (SymFunc (. d ty))))
    ((ItDefine f) (env-add-symbol a (. f name) (. f pos) (SymFunc (. f ty))))))

;; Every struct `t` names is defined: `undefined struct %struct.N`. (env.rs `Env::valid`)
(defun env-valid (env: LEnv t: LType pos: i64) -> (Result unit Diagnostic)
  (match t
    ((TNamed n) (if (contains? (. env structs) n) (Ok ()) (err pos (str "undefined struct %struct." n))))
    ((TAnon fs) (env-valid-all env fs pos))
    ((TVector _ e) (env-valid env e pos))
    ((TArray _ e) (env-valid env e pos))
    (_ (Ok ()))))

(defun env-valid-all (env: LEnv ts: (Vec LType) pos: i64) -> (Result unit Diagnostic)
  (loop ((i 0))
    (if (>= i (count ts))
        (Ok ())
        (match (env-valid env (nth ts i) pos)
          ((Ok _) (recur (+ i 1)))
          ((Err d) (Err d))))))

;; The result and every parameter are valid. (env.rs `Env::valid_fn`)
(defun env-valid-fn (env: LEnv f: LFnType pos: i64) -> (Result unit Diagnostic)
  (match (. f ret)
    ((some r) (try-let ((_ (env-valid env r pos))) (env-valid-all env (. f params) pos)))
    (nil (env-valid-all env (. f params) pos))))

(defun env-item-types (env: LEnv item: LItem) -> (Result unit Diagnostic)
  (match item
    ((ItStruct s) (env-valid-all env (. s fields) (. s pos)))
    ((ItGlobal g) (env-valid env (. g ty) (. g pos)))
    ((ItDeclareGlobal g) (env-valid env (. g ty) (. g pos)))
    ((ItDeclare d) (env-valid-fn env (. d ty) (. d pos)))
    ((ItDefine f) (env-valid-fn env (. f ty) (. f pos)))))

;; Whether struct `name` contains itself by value. (env.rs `acyclic`)
(defun env-cyclic? (env: LEnv name: str) -> bool
  (let ((e: (Vec LType) (vec-empty)))
    (loop ((stack (match (get (. env structs) name) ((some fs) fs) (nil e))) (seen #{}))
      (if (= (count stack) 0)
          false
          (let ((t (peek-type stack)) (rest (pop stack)))
            (match t
              ((TNamed n)
               (cond (= n name) true
                     (contains? seen n)
                     (recur rest seen)
                     :else (recur (into rest (match (get (. env structs) n) ((some fs) fs) (nil e))) (conj seen n))))
              ((TAnon fs) (recur (into rest fs) seen))
              ((TArray _ el) (recur (conj rest el) seen))
              (_ (recur rest seen))))))))

(defun peek-type (v: (Vec LType)) -> LType (nth v (- (count v) 1)))

(defun env-collect-types (a: EnvAcc items: (Vec LItem)) -> EnvAcc
  (loop ((i 0) (a a))
    (if (>= i (count items))
        a
        (recur (+ i 1)
               (match (env-item-types (. a env) (nth items i))
                 ((Ok _) a)
                 ((Err d) (acc-err a d)))))))

(defun env-collect-cycles (a: EnvAcc) -> EnvAcc
  (loop ((i 0) (a a))
    (if (>= i (count (. a order)))
        a
        (let ((p (nth (. a order) i)))
          (recur (+ i 1)
                 (if (env-cyclic? (. a env) (. p name))
                     (acc-err a (Diagnostic (. p pos) (str "struct %struct." (. p name) " contains itself by value")))
                     a))))))


;; Collects every definition, reporting duplicates, reserved names, undefined and self-containing structs, in the Rust's order. (env.rs `Env::build`)
(defun env-build (m: LModule) -> (Result LEnv (Vec Diagnostic))
  (let ((items (. m items))
        (a0 (EnvAcc (LEnv {} {}) (vec-empty) (vec-empty)))
        (a1 (loop ((i 0) (a a0))
              (if (>= i (count items)) a (recur (+ i 1) (env-add a (nth items i))))))
        (a2 (env-collect-types a1 items))
        (a3 (if (= (count (. a2 errs)) 0) (env-collect-cycles a2) a2)))
    (if (= (count (. a3 errs)) 0) (Ok (. a3 env)) (Err (. a3 errs)))))

;; The fields of a struct type, named or anonymous; nil for another type. (env.rs `Env::fields`)
(defun env-fields (env: LEnv t: LType) -> (Option (Vec LType))
  (match t
    ((TNamed n) (get (. env structs) n))
    ((TAnon fs) (some fs))
    (_ nil)))

;; A function's type, or the error for a call of `@name`. (env.rs `Env::function`)
(defun env-function (env: LEnv name: str pos: i64) -> (Result LFnType Diagnostic)
  (match (get (. env symbols) name)
    ((some (SymFunc f)) (Ok f))
    ((some (SymVar _ _)) (err pos (str "@" name " is not a function")))
    (nil (err pos (str "undefined function @" name)))))
