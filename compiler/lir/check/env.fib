;; compiler/lir/check/env.fib: the module environment: structs, functions and globals, with the module-level rules of spec/lir.md 4.1 (crates/lir/src/check/env.rs). OWNER: package K1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; An `LEnv` is built once by `env-build` and only borrowed afterwards.

(ns lir.check.env
  (:use lir.diag lir.types lir.ast))


;; What a global name denotes (env.rs `Symbol`).
(defenum LSymbol
  (SymFunc ty: LFnType)
  (SymVar ty: LType constant: bool))

;; env.rs `Env`: struct bodies by name and symbols by name.
(defstruct LEnv (structs: (Map str (Vec LType)) symbols: (Map str LSymbol)))

;; Collects every definition, reporting duplicates, reserved names, undefined and self-containing structs, in the Rust's order. (env.rs `Env::build`)
(defun env-build (m: LModule) -> (Result LEnv (Vec Diagnostic))
  (trap "todo: lir.check.env env-build"))

;; Every struct `t` names is defined: `undefined struct %struct.N`. (env.rs `Env::valid`)
(defun env-valid (env: LEnv t: LType pos: i64) -> (Result unit Diagnostic)
  (trap "todo: lir.check.env env-valid"))

;; The result and every parameter are valid. (env.rs `Env::valid_fn`)
(defun env-valid-fn (env: LEnv f: LFnType pos: i64) -> (Result unit Diagnostic)
  (trap "todo: lir.check.env env-valid-fn"))

;; The fields of a struct type, named or anonymous; nil for another type. (env.rs `Env::fields`)
(defun env-fields (env: LEnv t: LType) -> (Option (Vec LType))
  (trap "todo: lir.check.env env-fields"))

;; A function's type, or the error for a call of `@name`. (env.rs `Env::function`)
(defun env-function (env: LEnv name: str pos: i64) -> (Result LFnType Diagnostic)
  (trap "todo: lir.check.env env-function"))
