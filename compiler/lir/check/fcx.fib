;; compiler/lir/check/fcx.fib: the per-function checking context and its statement-level rules (crates/lir/src/check/fcx.rs). OWNER: package K1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; THE SHARED BASE of packages K1 and K2. In Rust `Fcx` is one type with methods spread over fcx.rs, expr.rs, arith.rs, aggr.rs, calls.rs, memory.rs and
;; phi.rs that call one another (`ty` dispatches to `bin`, which calls `val`, which calls `ty`). Fibber allows no cycle between modules, so:
;;   - the context and everything that needs no rule of K2 is here (`val`, `stmt`, `let-form`, `lookup`, ..);
;;   - `ty` (the dispatcher over the forms) and `terminator` are FIELDS of the context, closures set once by lir.check.func: `fcx-val` here
;;     calls `(. fcx ty)`, and the rule modules arith, aggr, calls, memory and phi (K2) call `fcx-val` and `fcx-ty` for their operands, in
;;     the order the Rust does. This keeps the order of errors, which interleaves operand typing with the rule's own checks.
;; The mutable parts (`types`, `cur`, `emitted`, `phis`) are Cells inside the record, as the reader's cursor is.

(ns lir.check.fcx
  (:use lir.diag lir.types lir.ast lir.check.env lir.check.cfg lir.check.walk))


;; A phi whose incoming values are checked after the whole function (phi.rs `PendingPhi`).
(defstruct PendingPhi (block: i64 ty: LType incoming: (Vec LBinding) pos: i64))

(defstruct Fcx
  (env: LEnv
   f: LFunction
   cfg: Cfg
   ;; block label to index
   labels: (Map str i64)
   ;; name to the block that binds it (-1: a parameter); and the types of the uncounted allocas
   defs: (Map str i64)
   allocas: (Map str LType)
   ;; the types of the names checked so far
   types: (Cell (Map str LType))
   ;; the block being checked
   cur: (Cell i64)
   ;; whether an instruction other than a phi has been evaluated in the current block (spec/lir.md 5.4)
   emitted: (Cell bool)
   phis: (Cell (Vec PendingPhi))
   ;; the dispatcher: the type of an expression (nil for void), set by lir.check.func to lir.check.expr/check-ty
   ty: (fn (Fcx LExpr) (Result (Option LType) Diagnostic))
   ;; a terminator in statement position, set to lir.check.calls/check-terminator
   term: (fn (Fcx LExpr) (Result unit Diagnostic))))

;; A context at block 0 whose names are the parameters, with the two dispatchers. (fcx.rs `Fcx::new`)
(defun fcx-new (env: LEnv f: LFunction cfg: Cfg labels: (Map str i64) b: Bindings ty: (fn (Fcx LExpr) (Result (Option LType) Diagnostic)) term: (fn (Fcx LExpr) (Result unit Diagnostic))) -> Fcx
  (trap "todo: lir.check.fcx fcx-new"))

;; The label of block `b`. (fcx.rs `label`)
(defun fcx-label (fcx: Fcx b: i64) -> str
  (trap "todo: lir.check.fcx fcx-label"))

;; Checks one block's statements. (fcx.rs `block`)
(defun fcx-block (fcx: Fcx b: i64) -> (Result unit Diagnostic)
  (trap "todo: lir.check.fcx fcx-block"))

;; A form in statement position: its value, if any, is dropped. (fcx.rs `stmt`)
(defun fcx-stmt (fcx: Fcx e: LExpr) -> (Result unit Diagnostic)
  (trap "todo: lir.check.fcx fcx-stmt"))

;; A form evaluated for its effect where no terminator may appear. (fcx.rs `effect`)
(defun fcx-effect (fcx: Fcx e: LExpr) -> (Result unit Diagnostic)
  (trap "todo: lir.check.fcx fcx-effect"))

;; The type of `e` (nil for void) through the dispatcher field. (expr.rs `ty`)
(defun fcx-ty (fcx: Fcx e: LExpr) -> (Result (Option LType) Diagnostic)
  (trap "todo: lir.check.fcx fcx-ty"))

;; A form whose value is used: never void, never a terminator. (fcx.rs `val`)
(defun fcx-val (fcx: Fcx e: LExpr) -> (Result LType Diagnostic)
  (trap "todo: lir.check.fcx fcx-val"))

;; `(let ((x v)..) body..)`: its value is the last body form's. (fcx.rs `let_form`)
(defun fcx-let-form (fcx: Fcx binds: (Vec LBinding) body: (Vec LExpr) as-value: bool) -> (Result (Option LType) Diagnostic)
  (trap "todo: lir.check.fcx fcx-let-form"))

;; The type of a use of `name` in the current block: undefined, used before its binding, does not dominate. (fcx.rs `lookup`)
(defun fcx-lookup (fcx: Fcx name: str pos: i64) -> (Result LType Diagnostic)
  (trap "todo: lir.check.fcx fcx-lookup"))

;; The type of a use of `name` at the end of block `m`, a phi's incoming value. (fcx.rs `lookup_at_end`)
(defun fcx-lookup-at-end (fcx: Fcx name: str m: i64 pos: i64) -> (Result LType Diagnostic)
  (trap "todo: lir.check.fcx fcx-lookup-at-end"))

;; `t` must be a valid type of this module. (fcx.rs `valid`)
(defun fcx-valid (fcx: Fcx t: LType pos: i64) -> (Result unit Diagnostic)
  (trap "todo: lir.check.fcx fcx-valid"))

;; `op: operand k has type X, expected Y` unless `got == want`. (expr.rs `same`)
(defun fcx-same (fcx: Fcx op: str k: i64 got: LType want: LType pos: i64) -> (Result unit Diagnostic)
  (trap "todo: lir.check.fcx fcx-same"))
