;; The order in which blocks are checked and lowered: reachable blocks in reverse postorder, then the unreachable in source order. For a checked function. (func.rs `block_order`)
(defun block-order (f: LFunction) -> (Result (Vec i64) Diagnostic)
  (trap "todo: lir.check.func block-order"))
