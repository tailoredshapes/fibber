;; compiler/lir/sexp/lexer.fib: tokens of lIR (sexp/lexer.rs): parentheses, braces, brackets, strings, vector types and atoms. OWNER: package R.
;; STUB. The interface of this module is internal to package R (only `lir.sexp/read` is fixed for the others); the signature below is the
;; Rust one, and R may replace it with a streaming lexer that never builds a token vector (docs/design/lair-in-fibber.md 1.4).
(ns lir.sexp.lexer
  (:use lir.diag))

;; sexp/lexer.rs `Tok`.
(defenum Tok
  TokOpen TokClose TokBraceOpen TokBraceClose TokBracketOpen TokBracketClose
  (TokAtom text: str)
  (TokStr bytes: (Array i8))
  (TokVecType n: str elem: str))

(defstruct Token (tok: Tok pos: i64))

;; Splits `src` into tokens with their positions (sexp/lexer.rs `tokens`).
(defun tokens (src: str) -> (Result (Vec Token) Diagnostic)
  (trap "todo: lir.sexp.lexer tokens"))
