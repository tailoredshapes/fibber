;; compiler/lir/intrin.fib: the table of the intrinsic forms of lIR (spec/lir.md 6.1, 6.4, 6.5; SIMD wave 2, package P0): the parser, the checker, the
;; printer and the lowering all read it, so a word is added in one place. The Rust `lair` has none of these forms.
;;
;; A form is `KIntrin name flags ty args align` (lir.ast). Its CLASS says how many operands it has and which rule types them:
;;   f1 f2 f3     float (or vector of floats) in, same type out, 1, 2 or 3 operands
;;   fbin         `fadd fsub fmul fdiv frem` carrying fast-math flags: 2 operands, as the unflagged `KBin`
;;   i1 i2        integer (or vector of integers), 1 or 2 operands
;;   red-i        a vector of integers folded to its element type
;;   red-f        `reduce-fadd` and `reduce-fmul`: the start value and a vector of floats
;;   red-m        a vector of floats folded by min or max
;;   warp         the kernel target's warp forms (spec/lir.md 6.9a): `shfl-down shfl-up shfl-xor shfl-idx` (a value, i32 or float, and an i32 lane operand, same type out),
;;                `ballot` (an i1, answering the i32 of the warp's votes); `llvm` is the prefix of the NVPTX intrinsic (the type is appended for a shuffle)
;;   mload gather a leading type, then 3 operands; mstore scatter: 3 operands (the vector first)
;;   hint         `spin-hint`: no operands, void (spec/lir.md 6.6a): the target's pause instruction, nothing where it has none
;;   const        `cache-line`: no operands, an i64 the target decides (spec/lir.md 6.6a); `stack-addr`: no operands, an i64, the stack pointer of the
;;                function (spec/lir.md 6.6b, docs/design/stack-check.md)
;;   ibin         the facts `add sub mul shl` carrying `nsw`/`nuw` (spec/lir.md 6.13): 2 operands, as the unflagged `KBin`
;;   assume       `assume`: one i1 operand, void (`llvm.assume`)
;;   rload        `load` with `(range LO HI)`: the type, the pointer and the two bounds (written by lir.parse.memory, never by `parse-intrin`)
;;   own          the ownership forms of spec/lir.md 6.14.3, parsed by lir.parse.own and lir.parse.memory (never by `parse-intrin`), typed by
;;                lir.check.ownforms, verified by lir.own and erased by lir.own.erase before any backend: `copy-value destroy-value is-unique`
;;                `dealloc-stack` (one operand), `alloc-object` (the struct type, the type id and an optional count), `alloc-stack` (the type and the id),
;;                `load-copy load-borrow load-take` (written `(load copy (ptr 1) a)`: the type and the address), `store-init store-assign
;;                store-borrow` (written `(store init v a)`: the value and the address), `addrspacecast` (the type and the value) and
;;                `managed-null` (written `((ptr 1) null)`: the type, no operand)
(ns lir.intrin)


(defstruct IntrinInfo (class: str llvm: str))

(def intrin-table: (Map str IntrinInfo)
  {"fma" (IntrinInfo "f3" "llvm.fma") "fmuladd" (IntrinInfo "f3" "llvm.fmuladd")
   "fsqrt" (IntrinInfo "f1" "llvm.sqrt") "fabs" (IntrinInfo "f1" "llvm.fabs") "ffloor" (IntrinInfo "f1" "llvm.floor")
   "fceil" (IntrinInfo "f1" "llvm.ceil") "ftrunc" (IntrinInfo "f1" "llvm.trunc") "fround" (IntrinInfo "f1" "llvm.round")
   "froundeven" (IntrinInfo "f1" "llvm.roundeven")
   "fcopysign" (IntrinInfo "f2" "llvm.copysign") "fmin" (IntrinInfo "f2" "llvm.minimum") "fmax" (IntrinInfo "f2" "llvm.maximum")
   "fminnum" (IntrinInfo "f2" "llvm.minnum") "fmaxnum" (IntrinInfo "f2" "llvm.maxnum")
   "smin" (IntrinInfo "i2" "llvm.smin") "smax" (IntrinInfo "i2" "llvm.smax") "umin" (IntrinInfo "i2" "llvm.umin")
   "umax" (IntrinInfo "i2" "llvm.umax") "abs" (IntrinInfo "i1" "llvm.abs")
   "cttz" (IntrinInfo "i1" "llvm.cttz") "ctlz" (IntrinInfo "i1" "llvm.ctlz")
   "fadd" (IntrinInfo "fbin" "fadd") "fsub" (IntrinInfo "fbin" "fsub") "fmul" (IntrinInfo "fbin" "fmul")
   "fdiv" (IntrinInfo "fbin" "fdiv") "frem" (IntrinInfo "fbin" "frem")
   "reduce-add" (IntrinInfo "red-i" "llvm.vector.reduce.add") "reduce-mul" (IntrinInfo "red-i" "llvm.vector.reduce.mul")
   "reduce-and" (IntrinInfo "red-i" "llvm.vector.reduce.and") "reduce-or" (IntrinInfo "red-i" "llvm.vector.reduce.or")
   "reduce-xor" (IntrinInfo "red-i" "llvm.vector.reduce.xor") "reduce-smin" (IntrinInfo "red-i" "llvm.vector.reduce.smin")
   "reduce-smax" (IntrinInfo "red-i" "llvm.vector.reduce.smax") "reduce-umin" (IntrinInfo "red-i" "llvm.vector.reduce.umin")
   "reduce-umax" (IntrinInfo "red-i" "llvm.vector.reduce.umax")
   "reduce-fadd" (IntrinInfo "red-f" "llvm.vector.reduce.fadd") "reduce-fmul" (IntrinInfo "red-f" "llvm.vector.reduce.fmul")
   "reduce-fmin" (IntrinInfo "red-m" "llvm.vector.reduce.fminimum") "reduce-fmax" (IntrinInfo "red-m" "llvm.vector.reduce.fmaximum")
   "reduce-fminnum" (IntrinInfo "red-m" "llvm.vector.reduce.fmin") "reduce-fmaxnum" (IntrinInfo "red-m" "llvm.vector.reduce.fmax")
   "masked-load" (IntrinInfo "mload" "llvm.masked.load") "masked-store" (IntrinInfo "mstore" "llvm.masked.store")
   "gather" (IntrinInfo "gather" "llvm.masked.gather") "scatter" (IntrinInfo "scatter" "llvm.masked.scatter")
   "shfl-down" (IntrinInfo "warp" "llvm.nvvm.shfl.sync.down") "shfl-up" (IntrinInfo "warp" "llvm.nvvm.shfl.sync.up")
   "shfl-xor" (IntrinInfo "warp" "llvm.nvvm.shfl.sync.bfly") "shfl-idx" (IntrinInfo "warp" "llvm.nvvm.shfl.sync.idx")
   "ballot" (IntrinInfo "warp" "llvm.nvvm.vote.ballot.sync")
   "spin-hint" (IntrinInfo "hint" "") "cache-line" (IntrinInfo "const" "")
   "stack-addr" (IntrinInfo "const" "llvm.stacksave")
   "add" (IntrinInfo "ibin" "add") "sub" (IntrinInfo "ibin" "sub") "mul" (IntrinInfo "ibin" "mul") "shl" (IntrinInfo "ibin" "shl")
   "assume" (IntrinInfo "assume" "llvm.assume") "load" (IntrinInfo "rload" "")
   "copy-value" (IntrinInfo "own" "") "destroy-value" (IntrinInfo "own" "") "is-unique" (IntrinInfo "own" "")
   "alloc-object" (IntrinInfo "own" "") "alloc-stack" (IntrinInfo "own" "") "dealloc-stack" (IntrinInfo "own" "")
   "load-copy" (IntrinInfo "own" "") "load-borrow" (IntrinInfo "own" "") "load-take" (IntrinInfo "own" "")
   "store-init" (IntrinInfo "own" "") "store-assign" (IntrinInfo "own" "") "store-borrow" (IntrinInfo "own" "")
   "addrspacecast" (IntrinInfo "own" "") "managed-null" (IntrinInfo "own" "")})

;; Whether the form is an ownership form (class `own`, spec/lir.md 6.14.3).
(defun intrin-own? (name: str) -> bool (= (intrin-class name) "own"))

;; The word after `load` or `store` of an ownership load or store (`copy`, `init`, ..), "" for another form.
(defun own-access-word (name: str) -> str
  (cond (= name "load-copy") "copy" (= name "load-borrow") "borrow" (= name "load-take") "take"
        (= name "store-init") "init" (= name "store-assign") "assign" (= name "store-borrow") "borrow"
        :else ""))

(defun intrin-info (name: str) -> (Option IntrinInfo) (get intrin-table name))

(defun intrin-class (name: str) -> str
  (match (get intrin-table name) ((some i) (. i class)) (nil "")))

(defun intrin-llvm (name: str) -> str
  (match (get intrin-table name) ((some i) (. i llvm)) (nil "")))

;; How many value operands the form takes (not counting its leading type, flags or alignment).
(defun intrin-arity (name: str) -> i64
  (let ((c (intrin-class name)))
    (cond (= name "ballot") 1
          (or (= c "hint") (= c "const")) 0
          (= c "warp") 2
          (or (= c "f1") (= c "i1") (= c "red-i") (= c "red-m") (= c "assume")) 1
          (or (= c "f2") (= c "i2") (= c "fbin") (= c "red-f") (= c "ibin")) 2
          :else 3)))

;; Whether the form takes flag words: fast-math flags (spec/lir.md 6.1), or `nsw`/`nuw` on the integer forms (6.13).
(defun intrin-flags? (name: str) -> bool
  (let ((c (intrin-class name)))
    (or (= c "fbin") (= c "red-f") (= name "fma") (= c "ibin"))))

;; Whether the flag words are the integer ones, `nsw` and `nuw`.
(defun intrin-int-flags? (name: str) -> bool (= (intrin-class name) "ibin"))

;; Whether the form is a fact (spec/lir.md 6.13): droppable, lowered by the check mode.
(defun intrin-fact? (name: str) -> bool
  (let ((c (intrin-class name)))
    (or (= c "ibin") (= c "assume") (= c "rload"))))

;; Whether the form starts with a type operand.
(defun intrin-typed? (name: str) -> bool
  (or (= name "masked-load") (= name "gather") (= name "load")
      (= name "alloc-object") (= name "alloc-stack") (= name "addrspacecast") (= name "managed-null")
      (starts-with? name "load-")))

;; Whether the form may end in `(align N)`.
(defun intrin-aligned? (name: str) -> bool
  (let ((c (intrin-class name)))
    (or (= c "mload") (= c "mstore") (= c "gather") (= c "scatter"))))
