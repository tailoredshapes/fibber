;; compiler/fibc.fib: the compiler in fibber, `fibc` (spec/compiler.md §1, spec/bootstrap.md; package D1 of M6 step 5): the port of
;; crates/fibc/src/main.rs, command.rs and front.rs over the passes already in fibber (the reader, expander, type checker, ownership
;; checker and lIR emitter of compiler/) and lair through its C interface (compiler/lair): `emit FILE` prints the lIR module, `build FILE
;; -o OUT [-O N] [-L dir].. [-l lib]..` makes the executable, `run [--trace] [-O N] FILE [-- arg..]` runs `main` through the JIT, `explain
;; FILE` prints the ownership checker's decisions, `emit-dump` is the emitter's oracle tool (compiler/emit.fib), `help`. `-I DIR` and
;; the directories of FIB_LIB are the roots a module is looked for in (spec/syntax.md §5).
;; Exit status as the Rust: 0, `main`'s result for `run`, 2 for usage or a file that does not read, 3 the front end rejected the
;; program, 4 the compiler cannot lower it yet (`unsupported`), 5 lair refused the module or the link failed. Added here: 1 for a
;; program that needs a macro under `--no-runner` (a word among the options, not in the Rust: the stage-2a behaviour, every macro call pending;
;; the default is the macro runner of macros.runner, which JITs each macro through lair); for `emit-dump` the statuses of
;; compiler/emit.fib (0, 1, 2, 3, 70 pending).
;; `lsp` serves the language server (lsp.server `lsp-main`, packages L0 to L5) on standard input and output; it takes `-I`.
;; `test [PATH..] [options]` is driver.test (docs/design/test-harness.md 6). `cases DIR [--only PREFIX..]` is driver.harness (H1). Not ported (the Rust test harness stays Rust): `itrace`, `gen`: each is refused with status 2.
;; Build: `fibc build compiler/fibc.fib -I compiler -I lib -L /usr/lib/llvm-21/lib -l LLVM-21 -o OUT`, run from the repository root (lair is native.*, fibber over LLVM: no liblair).
(ns main
  (:require [driver.args :as a] [driver.commands :as c] [driver.native :as native] [expand.roots :as roots] [expand.maker :as mk]
            [macros.runner :as mr] [driver.harness :as hn] [driver.test :as dt] [driver.version :as v] [lsp.server :as lsp]))

(defun refuse (word: str) -> i64
  (do (eprintln (str-join ["fibc: `" word "` is a command of the Rust compiler (the test harness)"])) 2))

(defun dispatch (cmd: a/Command rts: roots/Roots rm: mk/RunnerMaker dirs: (Vec str)) -> i64
  (match cmd
    ((a/CmdRun file trace args opt) (c/cmd-run file trace args opt rts rm))
    ((a/CmdBuild file out dirs libs opt) (c/cmd-build file out dirs libs opt rts rm))
    ((a/CmdEmit file) (c/cmd-emit file rts rm))
    ((a/CmdEmitDump opts files) (c/cmd-emit-dump files opts rts rm))
    ((a/CmdExplain file) (c/cmd-explain file rts rm))
    ((a/CmdLsp) (lsp/lsp-main rts))
    ((a/CmdCases dir only jobs) (hn/cmd-cases dir only jobs))
    ((a/CmdTest words) (dt/cmd-test words dirs))
    ((a/CmdHarness word) (refuse word))
    ((a/CmdHelp) (do (println a/usage) 0))
    ((a/CmdVersion) (do (println (v/version-line)) 0))
    ((a/CmdInvalid) (do (eprintln a/usage) 2))))

;; `--exe` before the first `--` (with `emit`): the lIR of an executable, as `build` makes it (its `main` does not print the result), by FIB_EMIT_EXE.
;; `--target TRIPLE` before the first `--`: removed, and FIB_TARGET_TRIPLE set (the front end's lane counts and the code generator read it;
;; docs/design/aarch64.md). The JIT that runs macros stays on the host.
(defun take-target :private (words: (Vec str)) -> (Vec str)
  (loop ((i 0) (out []))
    (cond (>= i (count words)) out
          (= (nth words i) "--") (into out (drop i words))
          (= (nth words i) "--exe") (do (native/setenv-set "FIB_EMIT_EXE" "1") (recur (+ i 1) out))
          (and (= (nth words i) "--target") (< (+ i 1) (count words)))
            (do (native/setenv-set "FIB_TARGET_TRIPLE" (nth words (+ i 1))) (recur (+ i 2) out))
          :else (recur (+ i 1) (conj out (nth words i))))))

(defun main () -> i64
  (let ((_ (native/ignore-sigpipe))
        (nr (mk/take-no-runner (take-target (vec (args)))))
        (split (a/split-roots (. nr words)))
        (cmd (a/parse (. split rest))))
    (if (and (not (empty? (. split dirs))) (not (a/takes-roots? cmd)))
        (do (eprintln (str-join ["fibc: -I belongs to a command that reads a program\n" a/usage])) 2)
        (dispatch cmd (roots/roots-from-env (. split dirs) (native/getenv-opt "FIB_LIB")) (mr/maker-for (. nr no-runner)) (. split dirs)))))
