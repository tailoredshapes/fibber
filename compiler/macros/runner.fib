;; compiler/macros/runner.fib: the macro runner of stage 2 (package M2b; spec/bootstrap.md §5.4, §5.5, spec/compiler.md §6, §9): what runs
;; a user macro at expansion time. It is the Rust `JitRunner` (crates/fibc/src/macros/{mod,module,bridge}.rs) in fibber, over lair's C
;; interface (compiler/lair): for the macro `m`, its module is the macro's forms (`macro-forms`) checked with the prelude,
;; emitted (`compile-macro`, E11) and added to a JIT session, once for each macro key; a call converts the argument trees to `Form`
;; objects, runs the entry on a mailbox's worker, answers the hooks the macro calls, and reads the result back as a tree.
;;
;; The module sits above the expander and the front end, which it needs (the macro's module goes through the whole pipeline while the
;; program's own expansion is suspended): the passes below take a `RunnerMaker` (expand.maker), a function value, and a tool builds
;; it here (`runner-maker`).
;;
;; Where this differs from the Rust, and why:
;; - The JIT session is made at the first macro run, not with the runner (a program with no user macro starts no JIT).
;; - The hooks of the Rust runner are Rust functions given to the module as pointers; fibber cannot give C a function, so lair supplies
;;   two hooks (gensym, reflection) and the compiler answers them in `serve` (lair.expand does so for a table of answers; here the
;;   answers are the context's: `ctx-gensym`, `ctx-reflect`). The trap hook has four arguments and lair has none of that arity, so
;;   it is a function of the macro module itself (`trap-shim`, appended to the module's text, not part of `compile-macro`'s): it
;;   hands the position and the message to the reflection hook, which `serve` tells from a reflection call by its operation word
;;   (a reflection call names one of the seven operations of expand.reflect, a trap's first word is its position or null) and never
;;   answers, so the worker stays parked for good, as the Rust trap hook parks its thread.
;; - A Rust `ExpandError` raised in a hook (a reflection error) is the first one kept and ends the expansion after the macro has run to
;;   its end, as in the Rust runner.
;; - A macro whose module does not check because it calls a function of the program is `MacroPhase`, as the interpreter's evaluator
;;   (the oracle of `fibref expand`) says it, not `MacroFailed` of the checker's text as the Rust JitRunner does (`check-failure`).
;; - A reflection call names its own position in the operation string (`OP FILE:LINE:COL:START:END`), so a reflection error is at the
;;   builtin call in the macro's body, as the evaluator's (the Rust hook ABI is the same: bridge.rs `split_call`).
;; Rust: macros/mod.rs `JitRunner::{module, build, run}`, bridge.rs, module.rs `Fns::{input_object, input_items, to_form}`.
(ns macros.runner
  (:require [native.api :as jit] [native.call :as call] [macros.fibm :as fibm] [lair.ffi :as ffi] [fib.string :as s] [emit.compile :as ec]
            [emit.macros.abi :as abi] [own.driver :as od] [own.error :as oerr] [expand.macrons :as macrons] [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f])
  (:use syntax.pos syntax.form expand.error expand.types expand.ctx expand.maker))

;; The state of one runner: the forms of the prelude the macros are checked with, the JIT session (made at the first macro), the
;; modules made so far by macro key (a failed build is kept: the Rust keeps it too), and how many were added to the session.
(defstruct Session
  (prelude: (Vec Stx) names: (Map str bool) jit: (Cell (Option jit/Jit)) mods: (Cell (Map str (Result fibm/Fibm ExpandErrKind)))
   built: (Cell i64)
   ;; the key of each module's content, by ns, set by a server that keeps a session between requests (serve.incr); empty for a tool that makes one
   chains: (Cell (Map str str))
   ;; the hash of each module's own text, by ns (serve.incr), and the key of each module's dependency closure derived from them (`dep-key`; dropped
   ;; when a text changes), and the keys the macros of a (macro key) were built under, newest first (`builds-max` are kept)
   owns: (Cell (Map str str)) deps: (Cell (Map str str)) builds: (Cell (Map str (Vec str)))))

;; The names the program's modules define at top level: `defun` and `def`, also inside a `do`, a trailing `:` of a `def` taken off.
;; Rust: eval/macros.rs collect_names
(defun collect-names :private (f: Stx names: (Map str bool)) -> (Map str bool)
  (match (. f kind)
    ((SList items)
     (match (if (empty? items) SNil (. (nth items 0) kind))
       ((SSym h)
        (cond (or (= h "defun") (= h "def"))
              (match (if (> (count items) 1) (. (nth items 1) kind) SNil)
                ((SSym n) (assoc names (if (s/ends-with? n ":") (str-slice n 0 (- (str-len n) 1)) n) true))
                (_ names))
              (= h "do") (reduce (fn (acc: (Map str bool) x: Stx) (collect-names x acc)) names (vec (drop 1 items)))
              :else names))
       (_ names)))
    (_ names)))

(defun session-new (prelude: (Vec Stx) program: (Vec Stx)) -> Session
  (Session prelude (reduce (fn (acc: (Map str bool) f: Stx) (collect-names f acc)) (map-empty) program) (cell nil) (cell (map-empty)) (cell 0) (cell (map-empty))
           (cell (map-empty)) (cell (map-empty)) (cell (map-empty))))

;; A server keeps one session between requests: the same session with the names of this request's program, its JIT and the macros built so far
;; shared (the cells are the same cells). A macro is built once for the content of its module (`session-key`), so an edit rebuilds the macros
;; of the modules from the edit on and no others.
(defun session-reuse (s: Session program: (Vec Stx)) -> Session
  (Session (. s prelude) (reduce (fn (acc: (Map str bool) f: Stx) (collect-names f acc)) (map-empty) program) (. s jit) (. s mods) (. s built) (. s chains) (. s owns) (. s deps) (. s builds)))

;; Says that the module `ns` has the content key `chain` from now on.
(defun session-note-chain (s: Session ns: str chain: str) -> unit
  (set! (. s chains) (assoc @(. s chains) ns chain)))

;; Says that the text of module `ns` hashes to `h` (serve.incr, as it expands the module): a text that changed drops the dependency keys.
(defun session-note-text (s: Session ns: str h: str) -> unit
  (do (when (not (= (get @(. s owns) ns) (some h))) (set! (. s deps) (map-empty)))
      (set! (. s owns) (assoc @(. s owns) ns h))))

;; The modules macro-time code of module `ns` can use: `ns`, and what each module in the set requires, uses, re-exports or sees implicitly
;; (`spec-deps`), as far as the context has them; sorted by name.
(defun dep-closure :private (ctx: ExpandCtx ns: str) -> (Vec str)
  (loop ((todo [ns]) (seen (set-empty)) (out (vec-empty)))
    (match (first todo)
      (nil (vec (sort out)))
      ((some n)
       (if (set-contains? seen n)
           (recur (vec (rest todo)) seen out)
           (recur (into (vec (rest todo)) (match (macrons/macro-ns-of ctx n) ((some m) (spec-deps (. m spec))) (nil []))) (conj seen n) (conj out n)))))))

;; The key a macro's module is kept under: the macro, and the text of every module its code can use (`dep-closure`), so a module after an edited
;; one is not built again unless it depends on it. When a module of the closure has no text noted (a tool that does not note them) the key is that
;; of the module's place in the load order, as before: the chain `session-note-chain` was given.
(defun session-key :private (s: Session ctx: ExpandCtx def: MacroDef) -> str
  (str-join [(. def key) "@"
             (match (get @(. s deps) (. def ns))
               ((some k) k)
               (nil (let ((k (closure-key s ctx (. def ns))))
                      (do (set! (. s deps) (assoc @(. s deps) (. def ns) k)) k))))]))

(defun closure-key :private (s: Session ctx: ExpandCtx ns: str) -> str
  (let ((names (dep-closure ctx ns))
        (owns @(. s owns)))
    (if (every? (fn (n: str) (some? (get owns n))) names)
        (str-join (mapv (fn (n: str) (str n "=" (unwrap-or (get owns n) ""))) names))
        (unwrap-or (get @(. s chains) ns) ""))))

;; ---------------------------------------------------------------- the module of a macro

(defun failed :private (def: MacroDef message: str) -> ExpandErrKind
  (MacroFailed (. def name) message))

;; Why the macro's forms did not check: a call of a function the program defines, which is not there at expansion time, is `MacroPhase`
;; (as the interpreter's evaluator says it; the Rust JitRunner says `MacroFailed` of the checker's text); else the checker's text.
;; Rust: eval/macros.rs check_error
(defun check-failure :private (s: Session def: MacroDef e: oerr/CheckError) -> ExpandErrKind
  (let ((phase (first (filter (fn (f: str) (some? (get (. s names) f)))
                              (mapv (fn (msg: str) (str-slice msg 13 (str-len msg)))
                                    (filter (fn (msg: str) (s/starts-with? msg "unbound name ")) (oerr/check-error-messages e)))))))
    (match phase
      ((some f) (MacroPhase (. def name) f))
      (nil (failed def (oerr/check-error-text e))))))

;; The session's JIT, made on first use.
(defun session-jit :private (s: Session) -> (Result jit/Jit str)
  (match @(. s jit)
    ((some j) (Ok j))
    (nil
     (match (jit/jit-new-fast-codegen 0)
       ((Err m) (Err (str-concat "cannot start the JIT: " m)))
       ((Ok j) (do (set! (. s jit) (some j)) (Ok j)))))))

;; The trap hook of the module made for the k-th macro (see the header): `(fn void (ptr ptr ptr i64))` over the context, the position
;; (a C string or null), the message's bytes and their count; the message goes to the reflection hook as a `str` object.
(defun trap-shim :private (k: str) -> la/LItem
  (la/ItDefine (f/external (f/make (str "fibm.trap-shim." k) nil
    [(Pair "cx" lt/ty-ptr) (Pair "pos" lt/ty-ptr) (Pair "bytes" lt/ty-ptr) (Pair "n" lt/ty-i64)] lt/cc-c
    [(f/block "entry" [(f/bound [(f/binding "s" (n/call "fib.str-new" [(n/local "n")]))]
        [(n/call "memcpy" [(n/call "fib.str-bytes-ptr" [(n/local "s")]) (n/local "bytes") (n/local "n")])
         (n/indirect-call (n/load lt/ty-ptr (n/global "fibm.reflect-hook") nil)
                          (lt/LFnType lt/cc-c (some lt/ty-ptr) [lt/ty-ptr lt/ty-ptr lt/ty-ptr] false)
                          [(n/local "cx") (n/local "pos") (n/local "s")] false)
         (n/unreachable)])])]))))

;; Installs the trap shim of the module k in the module.
(defun install-trap-hook :private (j: jit/Jit k: i64) -> (Result unit str)
  (match (jit/jit-c-entry j (str-concat "fibm.set-trap-hook." (show k)))
    ((Err m) (Err m))
    ((Ok set)
     (match (jit/jit-c-entry j (str-concat "fibm.trap-shim." (show k)))
       ((Err m) (Err m))
       ((Ok shim)
        (match (call/call-i64 set [shim])
          ((Err m) (Err m))
          ((Ok _) (Ok ()))))))))

;; Adds the module text to the session as the k-th, looks its surface up, starts its runtime and hooks its traps.
(defun load-module :private (s: Session def: MacroDef k: i64 ast: la/LModule) -> (Result fibm/Fibm ExpandErrKind)
  (match (session-jit s)
    ((Err m) (Err (failed def m)))
    ((Ok j)
     (match (jit/jit-add-module j (str-join ["macro." (. def name) "." (show k)]) (la/LModule (conj (. ast items) (trap-shim (show k)))))
       ((Err m) (Err (failed def m)))
       ((Ok _)
        (do (set! (. s built) (+ k 1))
            (match (fibm/fibm-lookup j k)
              ((Err m) (Err (failed def m)))
              ((Ok fm)
               (do (fibm/fibm-init fm)
                   (match (install-trap-hook j k)
                     ((Err m) (Err (failed def m)))
                     ((Ok _) (Ok fm))))))))))))

;; ---------------------------------------------------------------- macro-time helpers (syntax §3.16 "Phase separation")

;; Whether a form is a `defmacro`: a module's macros are not part of the macro-time module (they ran already, and one of the same name
;; as the macro would be taken for it).
(defun macro-form? :private (f: Stx) -> bool
  (match (. f kind)
    ((SList items) (and (> (count items) 0) (match (. (nth items 0) kind) ((SSym h) (= h "defmacro")) (_ false))))
    (_ false)))

;; The modules a module depends on (requires, uses, re-exports and, for a module that sees them, the implicit ones).
(defun spec-deps :private (spec: ModuleSpec) -> (Vec str)
  (into (into (into (mapv (fn (r: Require) (. r ns)) (. spec requires)) (. spec uses)) (. spec exports)) (. spec implicit)))

;; The modules `names` and those they depend on, each after its dependencies and once, as expanded (without their macros): what a
;; macro of a module that names them may call at expansion time. A module with no expanded forms (the prelude, one not ended) is left out.
(defun deps-in-order :private (ctx: ExpandCtx names: (Vec str) done: (Map str bool) out: (Vec Expanded)) -> (Pair (Map str bool) (Vec Expanded))
  (reduce (fn (acc: (Pair (Map str bool) (Vec Expanded)) ns: str)
            (if (some? (get (. acc fst) ns))
                acc
                (match (macrons/macro-ns-of ctx ns)
                  (nil (Pair (assoc (. acc fst) ns true) (. acc snd)))
                  ((some m)
                   (let ((below (deps-in-order ctx (spec-deps (. m spec)) (assoc (. acc fst) ns true) (. acc snd))))
                     (if (empty? (. m forms))
                         below
                         (Pair (. below fst) (conj (. below snd) (Expanded (. m spec) (vec (remove macro-form? (. m forms))))))))))))
          (Pair done out) names))

;; The macro-time program of `def` with helpers: the modules its module requires and uses (not its implicit ones, not itself), then the
;; macro's own forms in a module of its name that sees them as its module does. None when its module names no module with forms.
(defun helper-program :private (ctx: ExpandCtx def: MacroDef) -> (Option (Vec Expanded))
  (match (macrons/macro-ns-of ctx (. def ns))
    (nil nil)
    ((some m)
     (let ((spec (. m spec))
           (deps (. (deps-in-order ctx (into (into (mapv (fn (r: Require) (. r ns)) (. spec requires)) (. spec uses)) (. spec exports))
                                   (assoc (map-empty) (. def ns) true) (vec-empty))
                    snd)))
       (if (empty? deps)
           nil
           (let ((have (fn (ns: str) (some? (first (filter (fn (e: Expanded) (= (. (. e spec) ns) ns)) deps))))))
             (some (conj deps (Expanded (ModuleSpec (. spec ns) (vec (filter (fn (r: Require) (have (. r ns))) (. spec requires)))
                                                    (vec (filter have (. spec uses))) (vec (filter have (. spec exports))) (vec-empty))
                                        (abi/macro-forms def))))))))))

;; The macro's forms checked: with the prelude alone (Rust: JitRunner::build), else, when that fails and its module requires or uses
;; modules, with those modules too; the first failure is the one reported.
(defun check-macro :private (s: Session def: MacroDef ctx: ExpandCtx) -> (Result od/Checked ExpandErrKind)
  (match (od/own-check-forms (abi/macro-forms def) (. s prelude))
    ((Ok c) (Ok c))
    ((Err e)
     (match (helper-program ctx def)
       (nil (Err (check-failure s def e)))
       ((some modules)
        (match (od/own-check-modules-on-demand modules (. s prelude))
          ((Ok c) (Ok c))
          ((Err _) (Err (check-failure s def e)))))))))

;; The module of macro `def`: its forms checked (`check-macro`), emitted and loaded.
(defun build-module :private (s: Session def: MacroDef ctx: ExpandCtx) -> (Result fibm/Fibm ExpandErrKind)
  (match (check-macro s def ctx)
    ((Err k) (Err k))
    ((Ok c)
     (let ((k @(. s built))
           (n (+ (count (. def params)) (if (some? (. def rest)) 1 0))))
       (match (ec/compile-macro (. c typed) (. c owned) (. def name) n k)
         ((Err m) (Err (failed def m)))
         ((Ok mm) (load-module s def k (. mm ast))))))))

;; The module of the macro, built on its first use. Rust: JitRunner::module
;; How many builds of one macro are kept: the current text's and the one before (an edit undone is a hit).
(def builds-max: i64 2)

;; The macro's module under its key; the builds of the macro past `builds-max` go from the map (their code stays in the JIT session).
(defun keep-build :private (s: Session macro: str key: str r: (Result fibm/Fibm ExpandErrKind)) -> unit
  (let ((mine (into [key] (unwrap-or (get @(. s builds) macro) []))))
    (do (set! (. s mods) (reduce (fn (acc: (Map str (Result fibm/Fibm ExpandErrKind)) k: str) (dissoc acc k)) (assoc @(. s mods) key r) (vec (drop builds-max mine))))
        (set! (. s builds) (assoc @(. s builds) macro (vec (take builds-max mine)))))))

(defun session-module :private (s: Session def: MacroDef ctx: ExpandCtx) -> (Result fibm/Fibm ExpandErrKind)
  (match (get @(. s mods) (session-key s ctx def))
    ((some r) r)
    (nil
     (let ((t0 (sys-clock-now)) (r (build-module s def ctx)))
       (do (keep-build s (. def key) (session-key s ctx def) r)
           (when (= (sys-getenv "FIB_TIME") (some "1")) (eprintln (str "time macro.build " (. def name) " " (quot (- (sys-clock-now) t0) 1000000) " ms")))
           r)))))

;; ---------------------------------------------------------------- one call

;; How a macro's call ended: it returned (with the first error a hook found, if any), or it trapped with this text.
(defenum Served (Returned error: (Option ExpandError)) (Trapped message: str))

;; What the hooks see of one call: the module, the mailbox, the macro, the context, the call's position and the forms the macro was given.
(defstruct Call (m: fibm/Fibm mb: call/Mailbox def: MacroDef ctx: ExpandCtx pos: Pos inputs: (Map i64 Stx)))

(def reflect-names: (Vec str) :private ["struct?" "struct-fields" "struct-params" "struct-field-types" "enum?" "enum-params" "enum-variants"])

(defun reflect-name? :private (op: str) -> bool
  (some? (first (filter (fn (n: str) (= n op)) reflect-names))))

;; The operation and the position of a reflection call: the name the module passes is `OP FILE:LINE:COL:START:END`, or `OP` alone.
;; Rust: bridge.rs split_call
(defun num-or-neg :private (text: str) -> i64
  (match (parse-long text) ((some n) n) (nil -1)))

(defun split-call :private (text: str) -> (Pair str (Option Pos))
  (let ((halves (s/split text " " 2)))
    (if (< (count halves) 2)
        (Pair text nil)
        (let ((parts (s/split (nth halves 1) ":")) (n (count parts)) (op (nth halves 0)))
          (if (< n 5)
              (Pair op nil)
              (let ((line (num-or-neg (nth parts (- n 4)))) (col (num-or-neg (nth parts (- n 3))))
                    (start (num-or-neg (nth parts (- n 2)))) (end (num-or-neg (nth parts (- n 1)))))
                (if (or (< line 0) (< col 0) (< start 0) (< end 0))
                    (Pair op nil)
                    (Pair op (some (Pos (s/join ":" (vec (take (- n 4) parts))) line col start end))))))))))

;; The text of a trap: `POS: trap: MSG`, or `trap: MSG` where the runtime does not know the position. Rust: bridge.rs trap_hook
(defun trap-text :private (c: Call op-addr: i64 msg-obj: i64) -> str
  (let ((msg (fibm/str-text (. c m) msg-obj)))
    (if (= op-addr 0)
        (str-concat "trap: " msg)
        (str-join [(ffi/c-string-at op-addr) ": trap: " msg]))))

;; A reflection call `(op form)`: the context's answer as a `Form` object, and the first error. Rust: bridge.rs reflect_hook
(defun reflect-reply :private (c: Call call: str arg: i64 err: (Option ExpandError)) -> (Pair i64 (Option ExpandError))
  (let ((m (. c m)) (pos (. c pos)) (sp (split-call call))
        (at (match (. sp snd) ((some p) p) (nil pos)))
        (f (match (fibm/to-stx-in m arg pos (. c inputs)) ((Ok f) f) ((Err _) (Stx SNil pos)))))
    (match (ctx-reflect (. c ctx) (. sp fst) f at)
      ((Ok out) (Pair (fibm/to-object m out) err))
      ((Err e) (Pair (fibm/to-object m (Stx SNil pos)) (if (some? err) err (some e)))))))

;; Answers the hook the worker is parked at: a gensym, a reflection call, or the trap, which ends the call. Rust: bridge.rs
(defun answer :private (c: Call arity: i64 err: (Option ExpandError)) -> (Result (Option ExpandError) Served)
  (let ((m (. c m)) (mb (. c mb)))
    (if (= arity 1)
        (let ((sym (ctx-gensym (. c ctx) (fibm/str-text m (call/call-hook-arg mb 0)) (. c pos))))
          (do (call/call-hook-reply mb (fibm/to-object m sym)) (Ok err)))
        (let ((at (call/call-hook-arg mb 0)))
          (if (or (= at 0) (not (reflect-name? (. (split-call (ffi/c-string-at at)) fst))))
              (Err (Trapped (trap-text c at (call/call-hook-arg mb 1))))
              (let ((r (reflect-reply c (ffi/c-string-at at) (call/call-hook-arg mb 1) err)))
                (do (call/call-hook-reply mb (. r fst)) (Ok (. r snd)))))))))

;; Serves the hooks until the call returns, or traps, or the mailbox faults (a message, as a `trap` of the Rust runner's thread).
(defun serve :private (c: Call) -> (Result Served str)
  (loop ((err nil))
    (match (call/call-wait (. c mb))
      ((Err e) (Err e))
      ((Ok (call/Done)) (Ok (Returned err)))
      ((Ok (call/Nested)) (Err "a nested call returned, but none was asked for"))
      ((Ok (call/Hook k))
       (match (answer c k err)
         ((Err t) (Ok t))
         ((Ok e) (recur e)))))))

;; The objects a macro entry takes: one for each fixed argument and, when the macro has a rest parameter, a `(Vec Form)` of the others.
;; Rust: JitRunner::run (`input_object`, `input_items`)
(defun entry-objects :private (m: fibm/Fibm def: MacroDef args: (Vec Stx) ins: fibm/Inputs) -> (Vec i64)
  (let ((fixed (min (count (. def params)) (count args)))
        (objs (fibm/to-objects-in m (vec (take fixed args)) ins)))
    (if (some? (. def rest))
        (conj objs (fibm/vec-object m (fibm/to-objects-in m (vec (drop fixed args)) ins)))
        objs)))

(defun macro-error :private (def: MacroDef pos: Pos message: str) -> ExpandError
  (ExpandError (failed def message) pos))

;; The result as a tree, once the call returned: the first hook error is the expansion's, else the object read back with the inputs'
;; own positions. Rust: JitRunner::run (the end), module.rs to_form
(defun finish :private (c: Call err: (Option ExpandError)) -> (Result Stx ExpandError)
  (match err
    ((some e) (Err e))
    (nil
     (match (fibm/to-stx-in (. c m) (call/call-result (. c mb)) (. c pos) (. c inputs))
       ((Ok f) (Ok f))
       ((Err message) (Err (macro-error (. c def) (. c pos) message)))))))

;; Hooks installed, entry started, hooks served, result read.
(defun run-call :private (c: Call objs: (Vec i64)) -> (Result Stx ExpandError)
  (let ((h (call/hook-addresses)) (fail (fn (msg: str) (macro-error (. c def) (. c pos) msg))))
    (match (call/call-i64 (. (. c m) set-hooks) [(. h one) (. h two) (. (. c mb) handle)])
      ((Err e) (Err (fail e)))
      ((Ok _)
       (match (call/call-start (. c mb) (. (. c m) entry) objs)
         ((Err e) (Err (fail e)))
         ((Ok _)
          (match (serve c)
            ((Err e) (Err (fail e)))
            ((Ok (Trapped t)) (Err (fail t)))
            ((Ok (Returned err)) (finish c err)))))))))

;; Runs the macro in module `m` on the arguments of its call. Rust: JitRunner::run
(defun call-macro :private (m: fibm/Fibm def: MacroDef args: (Vec Stx) ctx: ExpandCtx) -> (Result Stx ExpandError)
  (let ((pos @(. ctx call-pos)) (ins (fibm/inputs-new)))
    (match (call/call-new)
      ((Err e) (Err (macro-error def pos (str-concat "cannot start a thread for the macro: " e))))
      ((Ok mb)
       (let ((objs (entry-objects m def args ins))
             (r (run-call (Call m mb def ctx pos @(. ins by-address)) objs)))
         (do (call/call-free mb) r))))))

;; ---------------------------------------------------------------- the runner

;; Runs `def` on its arguments in the context; its module is made once (`session-module`).
(defun run-macro :private (s: Session def: MacroDef args: (Vec Stx) ctx: ExpandCtx) -> (Result Stx ExpandError)
  (match (session-module s def ctx)
    ((Err k) (Err (ExpandError k @(. ctx call-pos))))
    ((Ok m) (call-macro m def args ctx))))

;; The runner of a program whose prelude is `prelude`.
(defun runner-new (prelude: (Vec Stx) program: (Vec Stx)) -> Runner
  (let ((s (session-new prelude program)))
    (Runner (fn (def: MacroDef args: (Vec Stx) ctx: ExpandCtx) (run-macro s def args ctx)))))

;; The runner over an existing session (a server's).
(defun runner-of (s: Session) -> Runner
  (Runner (fn (def: MacroDef args: (Vec Stx) ctx: ExpandCtx) (run-macro s def args ctx))))

;; What a tool hands the passes: the runner of this module.
(defun runner-maker () -> RunnerMaker
  (RunnerMaker (fn (prelude: (Vec Stx) program: (Vec Stx)) (runner-new prelude program))))

;; The maker a tool uses: the runner, or none (`--no-runner`).
(defun maker-for (no-runner: bool) -> RunnerMaker
  (if no-runner (no-runner-maker) (runner-maker)))
