;; compiler/emit/wasi.fib: the runtime of a WASI program (docs/design/targets.md 5.1, docs/design/wasm.md): rt/*.lir adapted for wasm32-wasip1 and wasi-libc, in the
;; way emit.os adapts it for Darwin and musl: the text of each part is rewritten at the places the platform differs, and a shim of lIR definitions is appended.
;;
;; What differs, and what is done about it:
;;   * pointers are 4 bytes: the element size of an array of pointers (the vector trie's child arrays, the worklist) is 4 where the text says 8 (the sizes the compiler computes
;;     come from `emit.layout/size-align-pb`);
;;   * `size_t` and `long` are `i32`: native.lower narrows the calls of `lir.targets/libc-narrow-names`, nothing here;
;;   * no threads (docs/adr/0008, wasm has none without the threads proposal): the pool starts no worker (a joiner runs the queue itself, as it does when it waits; the
;;     work-stealing pool of rt/sched.lir has a count of 0 and `fork-task` runs the task at the fork), `pthread_create`
;;     is a shim that fails with EAGAIN so that `spawn` of a thread says "cannot start" and a program that never spawns a thread never calls it, `pthread_exit` is `abort`;
;;   * the clock takes a pointer to a clock object (`_CLOCK_MONOTONIC`, `_CLOCK_REALTIME`) where Linux takes a number, and a `timespec`'s `tv_nsec` is a 4-byte `long`;
;;   * `AT_FDCWD` is -2 and the open flags are WASI's (`fib.w.oflags` maps the Linux words the library passes);
;;   * no `madvise`, no `mallopt` (wasi-libc's malloc grows the linear memory with `memory.grow`: that is the page provider), no `pipe` or `dup`.
(ns emit.wasi (:require [lir.ast :as la] [lir.types :as lt] [lir.rewrite :as rewrite]
                             [emit.node :as n] [emit.function :as f] [lir.print :as print]))

(defun replace :private (text: str old: str new: str) -> str
  (loop [offset 0 parts: (Vec str) []]
    (match (str-find text old offset)
      (nil (str-join (conj parts (str-slice text offset (str-len text)))))
      ((some at) (recur (+ at (str-len old)) (conj (conj parts (str-slice text offset at)) new))))))

(defun rewrites-sizes :private () -> (Vec (Pair str str))
  [
   (Pair "(CALL (GLOBAL fib.array-elem) arr (AND (LSHR i level) (I64 31)) (I64 8))"
         "(CALL (GLOBAL fib.array-elem) arr (AND (LSHR i level) (I64 31)) (I64 4))")
   (Pair "(CALL (GLOBAL fib.array-alloc) m tnarr (I64 8))"
         "(CALL (GLOBAL fib.array-alloc) m tnarr (I64 4))")
   (Pair "(CALL (GLOBAL fib.array-elem) karr ki (I64 8))"
         "(CALL (GLOBAL fib.array-elem) karr ki (I64 4))")
   (Pair "(nw (CALL (GLOBAL realloc) (LOAD PTR (GLOBAL fib.kwd-names)) (MUL cap2 (I64 8))))"
         "(nw (CALL (GLOBAL realloc) (LOAD PTR (GLOBAL fib.kwd-names)) (MUL cap2 (I64 4))))")
   (Pair "(bigger (CALL (GLOBAL malloc) (MUL cap2 (I64 8))))"
         "(bigger (CALL (GLOBAL malloc) (MUL cap2 (I64 4))))")
   (Pair "(CALL (GLOBAL memcpy) bigger base (MUL len (I64 8)))"
         "(CALL (GLOBAL memcpy) bigger base (MUL len (I64 4)))")
   ])

(defun rewrites-rest :private () -> (Vec (Pair str str))
  [
   (Pair "(DEFINE INTERNAL (fib.pool-quiesce VOID) ()\n  (BLOCK entry (CALL (GLOBAL fib.sched-quiesce)) (CALL (GLOBAL fib.rq-lock)) (BR test))\n  (BLOCK test\n    (BR (AND (ICMP EQ (LOAD PTR (GLOBAL fib.rq-head)) (PTR NULL)) (ICMP EQ (LOAD I32 (GLOBAL fib.pool-busy)) (I32 0))) done sleep))\n  (BLOCK sleep\n    (CALL (GLOBAL pthread_cond_wait) (LOAD PTR (GLOBAL fib.rq-cond)) (LOAD PTR (GLOBAL fib.rq-mutex)))\n    (BR test))\n  (BLOCK done (CALL (GLOBAL fib.rq-unlock)) (CALL (GLOBAL fib.lc-report)) (RET)))"
         "(DEFINE INTERNAL (fib.pool-quiesce VOID) ()\n  (BLOCK entry (BR test))\n  (BLOCK test\n    (LET ((t (CALL (GLOBAL fib.dequeue))))\n      (BR (ICMP EQ t (PTR NULL)) done run)))\n  (BLOCK run (CALL (GLOBAL fib.run-one) t) (BR test))\n  (BLOCK done (CALL (GLOBAL fib.lc-report)) (RET)))")
   (Pair "(CALL (GLOBAL pthread_cond_wait) (LOAD PTR (GLOBAL fib.rq-cond)) (LOAD PTR (GLOBAL fib.rq-mutex)))"
         "(CALL (GLOBAL fib.w.deadlock))")
   (Pair "(LET ((e (LOAD I32 (CALL (GLOBAL __errno_location)))))"
         "(LET ((e (CALL (GLOBAL fib.w.errno-linux) (LOAD I32 (CALL (GLOBAL __errno_location))))))")
   (Pair "(LET ((p (CALL (GLOBAL strerror) (TRUNC I32 e))))"
         "(LET ((p (CALL (GLOBAL strerror) (CALL (GLOBAL fib.w.errno-wasi) (TRUNC I32 e)))))")
   (Pair "(DECLARE madvise I32 (PTR I64 I32))\n"
         "")
   (Pair "(CALL (GLOBAL madvise) (INTTOPTR PTR lo) (SUB hi lo) (I32 14))"
         "(ADD (I32 0) (I32 0))")
   (Pair "(DECLARE mallopt I32 (I32 I32))\n"
         "")
   (Pair "(CALL (GLOBAL mallopt) (I32 -3) (I32 131072))"
         "(ADD (I32 0) (I32 0))")
   (Pair "(CALL (GLOBAL openat) (I32 -100) (CALL (GLOBAL fib.str-bytes-ptr) path) (TRUNC I32 flags) (TRUNC I32 mode))"
         "(CALL (GLOBAL openat) (I32 -2) (CALL (GLOBAL fib.str-bytes-ptr) path) (CALL (GLOBAL fib.w.oflags) flags) (TRUNC I32 mode))")
   (Pair "(r (CALL (GLOBAL pipe) fds))"
         "(r (CALL (GLOBAL fib.w.nosys)))")
   (Pair "(CALL (GLOBAL dup) (TRUNC I32 fd))"
         "(CALL (GLOBAL fib.w.nosys))")
   (Pair "(DECLARE pipe I32 (PTR))\n"
         "")
   (Pair "(DECLARE dup I32 (I32))\n"
         "")
   (Pair "(rc (CALL (GLOBAL pthread_create) handle attr entry task))"
         "(rc (CALL (GLOBAL fib.w.run-inline) entry task))")
   (Pair "(DECLARE pthread_create I32 (PTR PTR PTR PTR))\n"
         "")
   (Pair "(DECLARE pthread_detach I32 (I64))\n"
         "")
   (Pair "(DECLARE pthread_exit VOID (PTR))\n"
         "")
   (Pair "(n (SELECT (ICMP SLT n0 (I64 1)) (I64 1) n0))"
         "(n (I64 0))")
   ])

(defun rewrites-pool :private () -> (Vec (Pair str str))
  [
   ;; the work-stealing pool (rt/sched.lir, rt/deque.lir): no worker, so a fork runs the task at once; no affinity call
   (Pair "(LET ((cached (LOAD I64 (GLOBAL fib.sched-n))))\n      (BR (ICMP NE cached (I64 0)) have compute)))"
         "(LET ((cached (I64 0)))\n      (BR (ICMP EQ cached (I64 0)) have compute)))")
   (Pair "(CALL (GLOBAL pthread_cond_wait) (LOAD PTR (GLOBAL fib.sched-cond)) (LOAD PTR (GLOBAL fib.sched-mutex)))"
         "(CALL (GLOBAL fib.w.deadlock))")
   (Pair "(CALL (GLOBAL pthread_cond_wait) (LOAD PTR (GLOBAL fib.sched-jcond)) (LOAD PTR (GLOBAL fib.sched-mutex)))"
         "(CALL (GLOBAL fib.w.deadlock))")
   (Pair "(DECLARE sched_getaffinity I32 (I32 I64 PTR))\n"
         "")
   (Pair "(rc (CALL (GLOBAL sched_getaffinity) (I32 0) (I64 128) mask))"
         "(rc (I32 1))")
   ])

;; The pointer-size rewrites first, then the rest: the order the texts are rewritten in.
(defun rewrites :private () -> (Vec (Pair str str))
  (into (into (rewrites-sizes) (rewrites-rest)) (rewrites-pool)))

;; The texts `adapt` rewrites, for the unit that checks each is in the runtime (compiler/tests/emit/unit-wasi.fib).
;; The rewrites that the stack guard of rt/thread.lir needs (the guard region itself is cut out by `without-guard`): a thread attribute has no guard size.
(defun guard-rewrites :private () -> (Vec (Pair str str))
  [(Pair "    (CALL (GLOBAL pthread_attr_setguardsize) a (LOAD I64 (GLOBAL fib.thread-guard)))\n" "")
   (Pair "(DECLARE pthread_attr_setguardsize I32 (PTR I64))\n" "")])

(defun all-rewrites :private () -> (Vec (Pair str str)) (into (rewrites) (guard-rewrites)))

(defun rewrite-patterns () -> (Vec str) (mapv (fn (r: (Pair str str)) (. r fst)) (all-rewrites)))

;; One part of the runtime for WASI. Every rewrite is of text that is in exactly one part; a text that is not there leaves the part as it was.
(defun adapt (text: str) -> str
  (reduce (fn (t: str r: (Pair str str)) (replace t (. r fst) (. r snd))) (without-guard text) (all-rewrites)))

;; The stack guard of rt/thread.lir (between its `guard-begin` and `guard-end` marks) needs signals and threads: a WASI runtime has neither, and the host
;; reports the exhaustion of the stack itself (docs/design/stack.md). The shim has the three calls the rest of the runtime makes.
(defun without-guard :private (text: str) -> str
  (match (str-find text ";; guard-begin\n" 0)
    (nil text)
    ((some a) (match (str-find text ";; guard-end\n" a)
                (nil text)
                ((some b) (str-concat (str-slice text 0 a) (str-slice text (+ b 13) (str-len text))))))))

;; The errno numbers of WASI and of Linux, for the errors the runtime and the library tell apart: (WASI Linux). The runtime's `sys-*` answer the negated Linux number
;; and `fib.os` reads the Linux numbers (lib/platform/wasi/fib/os/backend.fib maps the same table for the `errno` it reads itself); `strerror` takes WASI's.
(defun errnos :private () -> (Vec (Pair i64 i64))
  [(Pair 44 2) (Pair 63 1) (Pair 2 13) (Pair 20 17) (Pair 28 22) (Pair 8 9) (Pair 27 4) (Pair 64 32) (Pair 54 20) (Pair 6 11) (Pair 73 110) (Pair 15 104)
   (Pair 13 103) (Pair 14 111) (Pair 3 98) (Pair 52 38) (Pair 55 39) (Pair 31 21) (Pair 48 12) (Pair 58 95) (Pair 75 18) (Pair 51 28) (Pair 76 25)
   (Pair 29 5) (Pair 70 34)])

;; `(define internal (NAME i32) ((i32 e)) ..)` mapping `e` from the `from` side of `errnos` to the other, any other number unchanged.
(defun errno-map :private (name: str from: (fn ((Pair i64 i64)) i64) to: (fn ((Pair i64 i64)) i64)) -> str
  (let ((rows (errnos)))
    (let ((head (str-join ["(DEFINE INTERNAL (" name " I32) ((I32 e))\n  (BLOCK entry (SWITCH e other"]))
          (cases (str-join (mapv (fn (r: (Pair i64 i64)) (str-join [" ((I32 " (str (from r)) ") m" (str (from r)) ")"])) rows)))
          (blocks (str-join (mapv (fn (r: (Pair i64 i64)) (str-join ["  (BLOCK m" (str (from r)) " (RET (I32 " (str (to r)) ")))\n"])) rows))))
      (str-join [head cases "))\n  (BLOCK other (RET e))\n" blocks ")\n"]))))

;; The shim: what the text above calls and wasi-libc does not provide. The open flags are the Linux ones the library passes (O_CREAT 64, O_EXCL 128, O_TRUNC 512, O_APPEND 1024,
;; O_NONBLOCK 2048, O_DIRECTORY 65536, the access mode in the low two bits), mapped to wasi-libc's (fcntl.h: O_RDONLY 0x04000000, O_WRONLY 0x10000000, O_CREAT 1<<12, O_DIRECTORY
;; 2<<12, O_EXCL 4<<12, O_TRUNC 8<<12, O_APPEND 1, O_NONBLOCK 4); close-on-exec is dropped. `fib.w.nosys` is ENOSYS (WASI's 52) and -1.
(defun shim () -> str
  (str-join
    [
     "(DEFINE INTERNAL (pthread_create I32) ((PTR h) (PTR a) (PTR f) (PTR x)) (BLOCK entry (RET (I32 6))))\n"
     "(DEFINE INTERNAL (fib.w.run-inline I32) ((PTR f) (PTR x)) (BLOCK entry (INDIRECT-CALL f (FUNCTION PTR (PTR)) x) (RET (I32 0))))\n"
     (errno-map "fib.w.errno-linux" (fn (r: (Pair i64 i64)) (. r fst)) (fn (r: (Pair i64 i64)) (. r snd)))
     (errno-map "fib.w.errno-wasi" (fn (r: (Pair i64 i64)) (. r snd)) (fn (r: (Pair i64 i64)) (. r fst)))
     "(DEFINE INTERNAL (fib.w.deadlock VOID) () (BLOCK entry (CALL (GLOBAL fib.fatal-c) (STRING \"deadlock: this wait needs another thread, and a WASI program has one\")) (UNREACHABLE)))\n"
     "(DEFINE INTERNAL (fib.guard-enter VOID) ((I64 size)) (BLOCK entry (RET)))\n"
     "(DEFINE INTERNAL (fib.guard-leave VOID) () (BLOCK entry (RET)))\n"
     "(DEFINE INTERNAL (fib.run-main VOID) ((PTR body)) (BLOCK entry (INDIRECT-CALL body (FUNCTION VOID ())) (RET)))\n"
     "(DEFINE INTERNAL (pthread_detach I32) ((I64 t)) (BLOCK entry (RET (I32 0))))\n"
     "(DEFINE INTERNAL (pthread_exit VOID) ((PTR v)) (BLOCK entry (CALL (GLOBAL abort)) (UNREACHABLE)))\n"
     "(DEFINE INTERNAL (fib.w.nosys I32) () (BLOCK entry (STORE (I32 52) (CALL (GLOBAL __errno_location))) (RET (I32 -1))))\n"
     "(DEFINE INTERNAL (fib.w.oflags I32) ((I64 f))\n"
     "  (BLOCK entry\n"
     "    (LET ((m (AND f (I64 3)))\n"
     "          (acc (SELECT (ICMP EQ m (I64 0)) (I64 67108864) (SELECT (ICMP EQ m (I64 1)) (I64 268435456) (I64 335544320))))\n"
     "          (a1 (OR acc (SELECT (ICMP NE (AND f (I64 64)) (I64 0)) (I64 4096) (I64 0))))\n"
     "          (a2 (OR a1 (SELECT (ICMP NE (AND f (I64 128)) (I64 0)) (I64 16384) (I64 0))))\n"
     "          (a3 (OR a2 (SELECT (ICMP NE (AND f (I64 512)) (I64 0)) (I64 32768) (I64 0))))\n"
     "          (a4 (OR a3 (SELECT (ICMP NE (AND f (I64 1024)) (I64 0)) (I64 1) (I64 0))))\n"
     "          (a5 (OR a4 (SELECT (ICMP NE (AND f (I64 2048)) (I64 0)) (I64 4) (I64 0))))\n"
     "          (a6 (OR a5 (SELECT (ICMP NE (AND f (I64 65536)) (I64 0)) (I64 8192) (I64 0)))))\n"
     "      (RET (TRUNC I32 a6)))))\n"]))

;; The whole module of a WASI program, after the runtime and the library are in it: `clock_gettime` (the runtime's calls and `fib.os.time`'s extern) is the shim's, which takes the
;; numeric clock id (0 realtime, anything else monotonic) where wasi-libc takes a pointer to a clock object, and leaves `tv_nsec` as the 8-byte word every reader of a
;; `timespec` here expects (it is a 4-byte `long` in wasi-libc, and the 4 bytes after it are not written).
(defun clock-references :private (expr: la/LExpr) -> la/LExpr
  (let ((mapped (rewrite/map-children expr clock-references)))
    (match (. mapped kind)
      ((la/KGlobal "clock_gettime") (la/LExpr (la/KGlobal "fib.w.clock-gettime") (. mapped pos)))
      ((la/KCall (la/CalDirect "clock_gettime") args tail)
       (la/LExpr (la/KCall (la/CalDirect "fib.w.clock-gettime") args tail) (. mapped pos)))
      (_ mapped))))

(defun clock-item :private (it: la/LItem) -> la/LItem
  (match it
    ((la/ItDefine func)
     (la/ItDefine (la/LFunction (. func name) (. func ty) (. func params)
                     (mapv (fn (b: la/LBlock) (la/LBlock (. b label) (mapv clock-references (. b body)) (. b pos))) (. func blocks))
                     (. func mods) (. func pos))))
    ((la/ItGlobal g)
     (la/ItGlobal (la/LGlobalDef (. g name) (. g ty) (clock-references (. g init)) (. g constant) (. g mods) (. g pos) (. g shared))))
    (_ it)))

(defun clock-wrapper :private () -> la/LItem
  (la/ItDefine (f/make "fib.w.clock-gettime" (some lt/ty-i32) [(Pair "id" lt/ty-i32) (Pair "ts" lt/ty-ptr)] lt/cc-c
    [(f/block "entry" [(f/bound
       [(f/binding "r" (n/call "clock_gettime" [(n/select (n/compare-int la/IEq (n/local "id") (n/integer lt/ty-i32 0))
                                                                      (n/global "_CLOCK_REALTIME") (n/global "_CLOCK_MONOTONIC")) (n/local "ts")]))
        (f/binding "at" (n/gep lt/ty-i8 (n/local "ts") [(n/integer lt/ty-i64 8)]))]
       [(n/store (n/cast la/CSExt lt/ty-i64 (n/load lt/ty-i32 (n/local "at") nil)) (n/local "at") nil) (n/ret (some (n/local "r")))])])])) )

(defun finish-module (module: la/LModule) -> la/LModule
  (let ((items (filterv (fn (it: la/LItem) (match it ((la/ItDeclare d) (not (= (. d name) "clock_gettime"))) (_ true))) (. module items))))
    (la/LModule (into (mapv clock-item items)
      [(la/ItDeclareGlobal (la/LGlobalDecl "_CLOCK_MONOTONIC" lt/ty-i32 false 0))
       (la/ItDeclareGlobal (la/LGlobalDecl "_CLOCK_REALTIME" lt/ty-i32 false 0))
       (la/ItDeclare (la/LDeclare "clock_gettime" (lt/LFnType lt/cc-c (some lt/ty-i32) [lt/ty-ptr lt/ty-ptr] false) false 0))
       (clock-wrapper)]))))
