;; The runtime is maintained as external lIR source. Read it at that boundary;
;; generated instructions, helpers, layouts and constants never use this path.
(ns emit.lirdata (:use lir.ast lir.diag)
  (:require [lir.parse :as parse]))

(defun read-runtime (source: str) -> (Vec LItem)
  (match (parse/parse-source source)
    ((Ok module) (. module items))
    ((Err diagnostic) (trap (str "invalid embedded runtime lIR: " (diag-str diagnostic))))))
