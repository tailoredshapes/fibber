;; compiler/emit/statics.fib: static data (types §8.2): string literals, keyword ids, the immortal closures of named functions, and vtables,
;; each an lIR `constant` with count 0 and the `IMMORTAL` flag. Replaces crates/fibc/src/statics.rs. The bytes of a
;; string are the bytes of its `str`; the Rust `Vec<u8>` key of the string index is the `str` itself.
(ns emit.statics
  (:require [fib.string :as s] [emit.node :as n] [lir.ast :as la] [lir.types :as lt] [lir.print :as print])
  (:use emit.value emit.layout))

;; A string constant: the text of its type id and its bytes, and its rendered `constant` (made once, when the string is first
;; wanted, because a module is assembled again for every `def`). Rust: statics.rs:13 `strings`
(defstruct StaticStr (tid: i64 text: str item: la/LItem))
;; An immortal closure: its name, its code, its type id. Rust: statics.rs:18 `closures`
(defstruct StaticClosure (name: str code: str tid: i64))
;; A vtable: its name and its slots. Rust: statics.rs:20 `vtables`
(defstruct StaticVtable (name: str slots: (Vec str)))

;; The static objects of a program. Rust: statics.rs:11 Statics
(defstruct Statics
  (strings: (Cell (Vec StaticStr)) string-index: (Cell (Map str str))
   keywords: (Cell (Vec str)) keyword-index: (Cell (Map str i64)) keywords-sealed: (Cell bool)
   closures: (Cell (Vec StaticClosure)) closure-index: (Cell (Map str str))
   vtables: (Cell (Vec StaticVtable)) vtable-index: (Cell (Map str str))
   ;; The C strings the emitter writes at many sites (a trap's message, a position), each text once: its constant `cstr.N`, by text.
   cstrs: (Cell (Vec la/LItem)) cstr-index: (Cell (Map str str))
   ;; Module-level items written in full by whoever needs them (the host index state and the shared-memory windows of fib.gpu,
   ;; emit.lower.gpu; the kernel table of a kernel target, emit.compile), by name, each once.
   items: (Cell (Vec la/LItem)) item-index: (Cell (Set str))))

(defun statics-new () -> Statics
  (Statics (cell []) (cell (map-empty)) (cell []) (cell (map-empty)) (cell false)
           (cell []) (cell (map-empty)) (cell []) (cell (map-empty)) (cell []) (cell (map-empty)) (cell []) (cell (set-empty))))

;; The module item `lir` under the name `name`, added once; the answer is `@name`.
(defun statics-item (st: Statics name: str item: la/LItem) -> str
  (do (when (not (contains? @(. st item-index) name))
        (do (cell-update! (. st items) (fn (items: (Vec la/LItem)) (conj items item)))
            (cell-update! (. st item-index) (fn (names: (Set str)) (conj names name)))))
      (str-join ["@" name])))

;; The address of the immortal `str` object holding `text`. Rust: statics.rs:26 Statics::string
(defun statics-string (st: Statics text: str tid-str: i64) -> str
  (if-some [n (get @(. st string-index) text)]
    n
    (let ((i (count @(. st strings)))
          (name (str-join ["@str." (str (count @(. st strings)))])))
      (do (cell-update! (. st strings) (fn (strings: (Vec StaticStr)) (conj strings (StaticStr tid-str text (render-string i tid-str text)))))
          (cell-update! (. st string-index) (fn (names: (Map str str)) (assoc names text name)))
          name))))

;; The address of the private constant holding `text` and a NUL, the one of every site that names this text: `@cstr.N`, made when the
;; text is first wanted. spec/lir.md 3 makes each `(string ..)` its own constant, so the emitter writes a message it repeats (the trap
;; of every checked `+` says "integer overflow in + at i64") once here rather than as a `(string ..)` at each site.
(defun statics-cstring (st: Statics text: str) -> str
  (if-some [n (get @(. st cstr-index) text)]
    n
    (let ((i (count @(. st cstrs))) (name (str-join ["@cstr." (str i)])))
      (do (cell-update! (. st cstrs) (fn (items: (Vec la/LItem)) (conj items (render-cstring i text))))
          (cell-update! (. st cstr-index) (fn (names: (Map str str)) (assoc names text name)))
          name))))

;; The interned id of a keyword. Once the table is sealed, a keyword that is not in it is a broken invariant: a trap, as the
;; Rust panic. Rust: statics.rs:42 Statics::keyword
(defun statics-keyword (st: Statics k: str) -> i64
  (if-some [id (get @(. st keyword-index) k)]
    id
    (if @(. st keywords-sealed)
        (trap (str-join ["the keyword :" k " was interned after the keyword table was sealed"]))
        (let ((id (count @(. st keywords))))
          (do (cell-update! (. st keywords) (fn (keywords: (Vec str)) (conj keywords k)))
              (cell-update! (. st keyword-index) (fn (ids: (Map str i64)) (assoc ids k id)))
              id)))))

;; Seals the table: the ids given out so far are the table a macro module exports (`fibm.kw.K`, compiler.md §6), so a keyword that
;; is not already in it must not be interned from here on. Rust: statics.rs:62 Statics::seal_keywords
(defun statics-seal-keywords (st: Statics) -> unit
  (set! (. st keywords-sealed) true))

;; Every keyword interned so far, by id. Rust: statics.rs:67 Statics::keywords
(defun statics-keywords (st: Statics) -> (Vec str)
  @(. st keywords))

;; The address of the immortal closure whose code is `code` (§8.4). Rust: statics.rs:72 Statics::closure
;; `by-content` (live mode, LE2 of docs/design/live-incremental.md 2.2 item 3): the name is `clo.CODE`, the same in every program of a
;; session, so a cut declares the base's closure object instead of making another; else `clo.N` by the program's count, as before.
(defun statics-closure (st: Statics code: str tid: i64 by-content: bool) -> str
  (if-some [n (get @(. st closure-index) code)]
    n
    (let ((name (if by-content (str "@clo." code) (str-join ["@clo." (str (count @(. st closures)))]))))
      (do (cell-update! (. st closures) (fn (closures: (Vec StaticClosure)) (conj closures (StaticClosure name code tid))))
          (cell-update! (. st closure-index) (fn (names: (Map str str)) (assoc names code name)))
          name))))

;; The immortal closures made so far, by address name (`@clo.N`). Rust: statics.rs:83 Statics::closure_names
(defun statics-closure-names (st: Statics) -> (Vec str)
  (mapv (fn (c: StaticClosure) (. c name)) @(. st closures)))

;; The address of the vtable named `name` with these slots (§8.5), or of the one registered under that name before.
;; `by-content` (live mode, LE2): the global is `vt.NAME`, the same in every program of a session; else `vt.N` by the program's count.
;; Rust: statics.rs:89 Statics::vtable
(defun statics-vtable (st: Statics name: str slots: (Vec str) by-content: bool) -> str
  (if-some [n (get @(. st vtable-index) name)]
    n
    (let ((global (if by-content (str "@vt." name) (str-join ["@vt." (str (count @(. st vtables)))]))))
      (do (cell-update! (. st vtables) (fn (vtables: (Vec StaticVtable)) (conj vtables (StaticVtable global slots))))
          (cell-update! (. st vtable-index) (fn (names: (Map str str)) (assoc names name global)))
          global))))

;; Whether a vtable of this name exists already. Rust: statics.rs:100 Statics::has_vtable
(defun statics-has-vtable (st: Statics name: str) -> bool
  (contains? @(. st vtable-index) name))

;; Whether `name` is a static numbered per program: a quoted form `q.N` (emit.program `program-fresh-quote`, by the program's own
;; counter), and outside live mode a closure constant `clo.N` and a vtable `vt.N` (above). Two programs of a live session give the same
;; such name to different things, so the session copies one into every cut and never exports one from a cut, declares one from the base
;; or keeps a def value that names one (serve.livesess, serve.livesplit, emit.defs.cache). In live mode closures and vtables are named
;; by content (`clo.CODE`, `vt.NAME`: `shared-static?`, LE2 of docs/design/live-incremental.md 2.2 item 3) and shared by name as a
;; string `str.N`, a keyword and a constant `def.N` are.
(defun program-static? (name: str) -> bool
  (s/starts-with? name "q."))

;; Whether `name` is a closure constant or a vtable: in live mode named by what it holds, so one name is one object in the session.
(defun shared-static? (name: str) -> bool
  (or (s/starts-with? name "clo.") (s/starts-with? name "vt.")))

;; An address name without its `@`.
(defun unat :private (name: str) -> str
  (str-slice name 1 (str-len name)))

;; The bytes of s as `(i8 B)` words, then the terminating zero.
(defun byte-words :private (text: str) -> (Vec la/LExpr)
  (conj (mapv (fn (i: i64) (n/integer lt/ty-i8 (zext i64 (str-byte-at text i)))) (range (str-len text)))
        (n/integer lt/ty-i8 0)))

(defun render-string :private (i: i64 tid: i64 text: str) -> la/LItem
  (let ((count (str-len text)) (array-ty (lt/TArray (+ (str-len text) 1) lt/ty-i8)))
    (la/ItGlobal (la/LGlobalDef (str "str." i) (lt/TAnon [lt/ty-i64 lt/ty-i32 lt/ty-i32 lt/ty-i64 array-ty])
                              (n/aggregate [(n/integer lt/ty-i64 0) (n/integer lt/ty-i32 tid) (n/integer lt/ty-i32 flag-immortal)
                                            (n/integer lt/ty-i64 count) (n/array-value array-ty (byte-words text))])
                              true (la/LModifiers la/lk-internal false false false false false nil) 0 false))))

;; `(constant private cstr.I [N x i8] ..)`: the bytes of `text` and a NUL.
(defun render-cstring :private (i: i64 text: str) -> la/LItem
  (let ((ty (lt/TArray (+ (str-len text) 1) lt/ty-i8)))
    (la/ItGlobal (la/LGlobalDef (str "cstr." i) ty (n/array-value ty (byte-words text))
                              true (la/LModifiers la/lk-private false false false false false nil) 0 false))))

;; The constants: strings, C strings, immortal closures, vtables, one piece each (the pieces `statics-render` joins; a string's is made once).
;; Rust: statics.rs:105 Statics::render
(defun statics-render-pieces (st: Statics) -> (Vec str)
  (mapv (fn (item: la/LItem) (print/print-module (la/LModule [item]))) (statics-items st)))

(defun statics-render (st: Statics) -> str
  (str-join (statics-render-pieces st)))


(defun statics-items (st: Statics) -> (Vec la/LItem)
  (into (into (into (into (mapv (fn (s: StaticStr) (. s item)) @(. st strings)) @(. st cstrs)) @(. st items))
              (mapv (fn (c: StaticClosure)
                      (la/ItGlobal (la/LGlobalDef (unat (. c name)) (lt/TAnon [lt/ty-i64 lt/ty-i32 lt/ty-i32 lt/ty-ptr])
                                                (n/aggregate [(n/integer lt/ty-i64 0) (n/integer lt/ty-i32 (. c tid))
                                                              (n/integer lt/ty-i32 flag-immortal) (n/global (. c code))])
                                                true (la/LModifiers la/lk-internal false false false false false nil) 0 false))) @(. st closures)))
        (mapv (fn (v: StaticVtable)
                (let ((ty (lt/TArray (count (. v slots)) lt/ty-ptr)))
                  (la/ItGlobal (la/LGlobalDef (unat (. v name)) ty
                                            (n/array-value ty (mapv (fn (slot: str) (if (= slot "(ptr null)") (n/null) (n/reference slot))) (. v slots)))
                                            true (la/LModifiers la/lk-internal false false false false false nil) 0 false)))) @(. st vtables))))
