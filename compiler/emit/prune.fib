;; compiler/emit/prune.fib: PRUNE-1. The lIR of a program without what nothing reaches: the internal functions, globals and constants of the
;; runtime and of the program that `main` (and what has an outside role) cannot get to, and the `def`s made at run time whose value nobody reads.
;; The bodies the program asks for are already demanded one by one (emit.mono's queue); what stays in the text after that is the whole runtime
;; (about half of it dead in a small program), the globals and constants of values nothing reads, and the initialisers of every `def` of every
;; loaded module (`fib.unix` alone makes a dozen before `main`).
;;
;; Roots: every item that is not `internal` or `private` (`main`, the exports of a library), every piece of text that is not an item (the
;; `declare`s, `defstruct`s, `target`), the kernel table `fib.kernel.*` (driver.commands reads it from the text), what the text of `main` names
;; (`root-text`), and the initialisers that may do something. A `def` made at run time is dropped only when it is pure and nobody reads its slot:
;; its body calls, through the program's own functions, only the runtime of core, str, array, vec, vecbuild, weak and alloc (which allocate and
;; count, nothing a program can see) and makes no indirect call (a closure may be anything). A call of anything else (an `extern`, I/O, an atom,
;; a thread, a task) keeps it. A trap or an out-of-memory in the initialiser of an unread, pure `def` is not preserved: that is the one change of
;; behaviour, and it is the point (a `def` is evaluated for its value).
;; The text is cut where a line starts with `(` at the left margin, which the emitter does for every item and never inside one (strings escape
;; their line breaks).
(ns emit.prune
  (:require [emit.runtime :as rt])
  (:use emit.assemble emit.program))

;; The search: the items by name (the program's, the runtime's), the names found live, the names to scan, and, for a pure `def`, its slot's
;; name and the name of its body (reaching the slot reaches the body).
(defstruct Search (prog: (Map str str) rts: (Map str str) pure-rt: (Map str bool) live: (Cell (Map str bool)) work: (Cell (Vec str))
                   lazy: (Map str str)))

;; --- the text in pieces
;; The text in pieces that join back to it: each ends after the line break that comes before a line starting with `(`.
(defun split-pieces (text: str) -> (Vec str)
  (loop ((from 0) (out []))
    (match (str-find text "\n(" from)
      (nil (conj out (str-slice text from (str-len text))))
      ((some i) (recur (+ i 1) (conj out (str-slice text from (+ i 1))))))))

;; Whether the byte ends a name: a space or control character, a parenthesis, a quote.
(defun name-end? :private (c: i8) -> bool
  (or (<= c 32i8) (= c 40i8) (= c 41i8) (= c 34i8)))

;; The end of the word that starts at `i`.
(defun word-end :private (s: str i: i64) -> i64
  (loop ((k i)) (if (and (< k (str-len s)) (not (name-end? (str-byte-at s k)))) (recur (+ k 1)) k)))

(defun skip-space :private (s: str i: i64) -> i64
  (loop ((k i)) (if (and (< k (str-len s)) (<= (str-byte-at s k) 32i8)) (recur (+ k 1)) k)))

(defun modifier? :private (w: str) -> bool
  (or (= w "hidden") (= w "shared") (= w "external") (= w "tailcc") (= w "ccc") (= w "kernelcc")))

;; The name an item defines, from the position after its keyword, and whether the item is internal or private; the name is "" for a word we do not know.
(defun item-name :private (s: str from: i64 define: bool) -> (Pair str bool)
  (loop ((i from) (local false))
    (let ((j (skip-space s i)))
      (if (>= j (str-len s))
          (Pair "" false)
          (if (and define (= (str-byte-at s j) 40i8))
              (Pair (str-slice s (+ j 1) (word-end s (+ j 1))) local)
              (let ((e (word-end s j)) (w (str-slice s j (word-end s j))))
                (cond (or (= w "internal") (= w "private")) (recur e true)
                      (modifier? w) (recur e local)
                      define (Pair "" false)
                      :else (Pair w local))))))))

;; The name of the item a piece is and whether it is internal; the name is "" for text that is not a definition.
(defun piece-item :private (s: str) -> (Pair str bool)
  (cond (starts-with? s "(define ") (item-name s 8 true)
        (starts-with? s "(global ") (item-name s 8 false)
        (starts-with? s "(constant ") (item-name s 10 false)
        :else (Pair "" false)))

;; Every name that follows an `@` in the text.
(defun refs-of (s: str) -> (Vec str)
  (loop ((from 0) (out []))
    (match (str-find s "@" from)
      (nil out)
      ((some i) (let ((e (word-end s (+ i 1))))
                  (recur e (if (> e (+ i 1)) (conj out (str-slice s (+ i 1) e)) out)))))))

;; --- the search
(defun reach :private (st: Search name: str) -> unit
  (when (not (contains? @(. st live) name))
    (do (set! (. st live) (assoc @(. st live) name true))
        (set! (. st work) (conj @(. st work) name)))))

(defun reach-all :private (st: Search names: (Vec str)) -> unit
  (doseq [n names] (reach st n)))

(defun text-of :private (st: Search name: str) -> (Option str)
  (match (get (. st prog) name)
    ((some t) (some t))
    (nil (get (. st rts) name))))

;; Scans the names found live until none is left: what an item mentions is live, and so is the body of a `def` whose slot it is.
(defun run-work :private (st: Search) -> unit
  (loop ()
    (let ((w @(. st work)))
      (when (> (count w) 0)
        (let ((n (nth w (- (count w) 1))))
          (do (set! (. st work) (vec-pop w))
              (match (text-of st n) ((some t) (reach-all st (refs-of t))) (nil ()))
              (match (get (. st lazy) n) ((some b) (reach st b)) (nil ()))
              (recur)))))))

;; Whether the body `name` does nothing a program can see: see the header. A depth-first walk over the program's own items.
(defun pure-body? (st: Search name: str) -> bool
  (let ((seen (cell {})) (work (cell [name])) (ok (cell true)))
    (do (loop ()
          (let ((w @work))
            (when (and @ok (> (count w) 0))
              (let ((n (nth w (- (count w) 1))))
                (do (set! work (vec-pop w))
                    (when (not (contains? @seen n))
                      (do (set! seen (assoc @seen n true))
                          (cond (contains? (. st pure-rt) n) ()
                                (contains? (. st rts) n) (set! ok false)
                                :else (match (get (. st prog) n)
                                        (nil (set! ok false))
                                        ((some t) (if (some? (str-find t "(indirect-" 0))
                                                      (set! ok false)
                                                      (doseq [r (refs-of t)] (set! work (conj @work r)))))))))
                    (recur))))))
        @ok)))

;; --- the runtime's pure part
;; The names of the items of the parts of the runtime that allocate, count and build values, and do nothing else.
(defun pure-runtime-names () -> (Map str bool)
  (reduce (fn (acc: (Map str bool) part: str)
            (reduce (fn (a: (Map str bool) p: str)
                      (let ((it (piece-item p))) (if (= (. it fst) "") a (assoc a (. it fst) true))))
                    acc (split-pieces part)))
          {} [rt/RT-CORE rt/RT-STR rt/RT-ARRAY rt/RT-VEC rt/RT-VECBUILD rt/RT-WEAK rt/RT-ALLOC]))

;; --- the whole
(defstruct Field (pieces: (Vec str) items: (Vec (Pair str bool))))

(defun field-of :private (text: str) -> Field
  (let ((ps (split-pieces text))) (Field ps (mapv piece-item ps))))

;; Indexes the named pieces of the field in `m` and notes the roots: what is not internal, and the text that is not an item.
(defun index-field :private (f: Field m: (Map str str) roots: (Cell (Vec str))) -> (Map str str)
  (let ((acc (cell m)))
    (do (dotimes (k (count (. f pieces)))
          (let ((it (nth (. f items) k)) (p (nth (. f pieces) k)))
            (if (= (. it fst) "")
                (set! roots (conj @roots p))
                (do (set! acc (assoc @acc (. it fst) p))
                    (when (or (not (. it snd)) (starts-with? (. it fst) "fib.kernel.")) (set! roots (conj @roots p)))))))
        @acc)))

(defun live-text :private (f: Field live: (Map str bool)) -> str
  (str-join (mapv (fn (k: i64) -> str
                    (let ((it (nth (. f items) k)))
                      (if (or (= (. it fst) "") (not (. it snd)) (starts-with? (. it fst) "fib.kernel.") (contains? live (. it fst))) (nth (. f pieces) k) "")))
                  (vec (range (count (. f pieces)))))))

(defun slot-name :private (i: Init) -> str (str-join ["def.slot." (str (. i def-id))]))

;; Seeds the search: the roots' own mentions, the text of `main`, the fixed names, and the initialisers that may do something.
(defun seed :private (st: Search roots: (Vec str) root-text: str inits: (Vec Init)) -> unit
  (do (doseq [r roots] (reach-all st (refs-of r)))
      (reach-all st (refs-of root-text))
      (reach-all st ["fib.initdef" "fib.immortalise" "fib.init-done"])
      (doseq [i inits]
        (when (not (contains? (. st lazy) (slot-name i)))
          (do (reach st (. i body)) (reach st (slot-name i)))))
      (run-work st)))

;; The pure initialisers: their slots to their bodies.
(defun lazy-inits :private (st: Search inits: (Vec Init)) -> (Map str str)
  (reduce (fn (m: (Map str str) i: Init) (if (pure-body? st (. i body)) (assoc m (slot-name i) (. i body)) m)) {} inits))

;; The parts of the module without what nothing reaches, and the initialisers that stay (in their order). `root-text` is the text of `main`
;; with no initialiser in it.
(defun prune-parts (parts: Parts root-text: str inits: (Vec Init)) -> (Pair Parts (Vec Init))
  (let ((fs (mapv field-of [(. parts runtime) (. parts externs) (. parts types) (. parts statics) (. parts keywords) (. parts defs) (. parts quotes)]))
        (fns (mapv field-of (. parts fns)))
        (roots (cell [])))
    (let ((rts (index-field (nth fs 0) {} roots))
          (pure-rt (pure-runtime-names)))
      (let ((prog (reduce (fn (m: (Map str str) f: Field) (index-field f m roots)) {} (into (mapv (fn (k: i64) (nth fs k)) [1 2 3 4 5 6]) fns))))
        (let ((lazy (lazy-inits (Search prog rts pure-rt (cell {}) (cell []) {}) inits)))
          (let ((st (Search prog rts pure-rt (cell {}) (cell []) lazy)))
            (do (seed st @roots root-text inits)
                (let ((live @(. st live)))
                  (Pair (Parts (live-text (nth fs 0) live) (live-text (nth fs 1) live) (live-text (nth fs 2) live) (live-text (nth fs 3) live)
                               (live-text (nth fs 4) live) (live-text (nth fs 5) live) (live-text (nth fs 6) live)
                               (filterv (fn (t: str) (not (= t ""))) (mapv (fn (f: Field) (live-text f live)) fns)))
                        (filterv (fn (i: Init) (or (not (contains? lazy (slot-name i))) (contains? live (slot-name i)))) inits))))))))))
