;; Reachability and initializer safety operate on lIR nodes. String constants
;; never create symbol dependencies. Initializers retain their source order.
(ns emit.prune
  (:use emit.assemble emit.program)
  (:require [lir.ast :as la] [lir.check.walk :as walk]))

(defstruct Search (prog: (Map str la/LItem) rts: (Map str la/LItem)
                   live: (Cell (Map str bool)) work: (Cell (Vec str)) lazy: (Map str str)))

(defun item-name (it: la/LItem) -> str
  (match it ((la/ItDefine f) (. f name)) ((la/ItGlobal g) (. g name)) (_ "")))

(defun root? :private (it: la/LItem) -> bool
  (let ((name (item-name it)))
    (or (= name "") (starts-with? name "fib.kernel.")
        (match it
          ((la/ItDefine f) (la/linkage-exported? (. (. f mods) linkage)))
          ((la/ItGlobal g) (la/linkage-exported? (. (. g mods) linkage)))
          (_ true)))))

(defun expr-refs :private (expr: la/LExpr out: (Cell (Vec str))) -> unit
  (do (match (. expr kind)
        ((la/KGlobal name) (set! out (conj @out name)))
        ((la/KCall (la/CalDirect name) _ _) (set! out (conj @out name)))
        (_ ()))
      (doseq [child (walk/children expr)] (expr-refs child out))))

(defun refs-of (it: la/LItem) -> (Vec str)
  (let ((out (cell [])))
    (do (match it
          ((la/ItDefine f) (doseq [b (. f blocks)] (doseq [e (. b body)] (expr-refs e out))))
          ((la/ItGlobal g) (expr-refs (. g init) out))
          (_ ()))
        @out)))

(defun reach :private (st: Search name: str) -> unit
  (when (not (contains? @(. st live) name))
    (do (set! (. st live) (assoc @(. st live) name true))
        (set! (. st work) (conj @(. st work) name)))))

(defun reach-all :private (st: Search names: (Vec str)) -> unit (doseq [n names] (reach st n)))
(defun item-of :private (st: Search name: str) -> (Option la/LItem)
  (match (get (. st prog) name) ((some it) (some it)) (nil (get (. st rts) name))))

(defun run-work :private (st: Search) -> unit
  (loop ()
    (let ((w @(. st work)))
      (when (> (count w) 0)
        (let ((name (nth w (- (count w) 1))))
          (do (set! (. st work) (vec-pop w))
              (match (item-of st name) ((some it) (reach-all st (refs-of it))) (nil ()))
              (match (get (. st lazy) name) ((some body) (reach st body)) (nil ()))
              (recur)))))))

;; Operations whose evaluation can trap, loop, or act prevent lazy elimination.
(defun risky? :private (e: la/LExpr) -> bool
  (or (match (. e kind)
        ((la/KBin op _ _) (includes? op [la/BSDiv la/BUDiv la/BSRem la/BURem la/BFDiv la/BFRem]))
        ((la/KOverflow _ _ _) true) ((la/KTrap) true) ((la/KUnreachable) true)
        ((la/KCast (la/CIntToPtr) _ _) true)
        ((la/KAtomicLoad _ _ _ _) true) ((la/KAtomicStore _ _ _ _) true)
        ((la/KAtomicRmw _ _ _ _ _) true) ((la/KCmpXchg _ _ _ _ _ _ _) true) ((la/KFence _ _) true)
        ((la/KCall (la/CalIndirect _ _) _ _) true)
        ((la/KBr _) true) ((la/KCondBr _ _ _) true) ((la/KSwitch _ _ _) true)
        ((la/KIntrin name _ _ _ _) (or (some? (str-find name "div" 0)) (some? (str-find name "rem" 0))))
        (_ false))
      (some? (find-first risky? (walk/children e)))))

(defun ref-ok? :private (st: Search name: str) -> bool
  (or (= name "fib.retain") (= name "fib.release")
      (match (get (. st prog) name) ((some (la/ItGlobal _)) true) (_ false))))

(defun pure-body? (st: Search name: str) -> bool
  (match (get (. st prog) name)
    ((some (la/ItDefine f))
     (and (= (count (. f blocks)) 1)
          (not-any? risky? (. (nth (. f blocks) 0) body))
          (every? (fn (r: str) (ref-ok? st r)) (refs-of (la/ItDefine f)))))
    (_ false)))

(defun index-items :private (items: (Vec la/LItem) roots: (Cell (Vec la/LItem))) -> (Map str la/LItem)
  (reduce (fn (m: (Map str la/LItem) it: la/LItem)
            (do (when (root? it) (set! roots (conj @roots it)))
                (if (= (item-name it) "") m (assoc m (item-name it) it)))) {} items))

(defun live-items :private (items: (Vec la/LItem) live: (Map str bool)) -> (Vec la/LItem)
  (filterv (fn (it: la/LItem) (or (root? it) (contains? live (item-name it)))) items))

(defun slot-name :private (i: Init) -> str (. i slot))
(defun lazy-inits :private (st: Search inits: (Vec Init)) -> (Map str str)
  (reduce (fn (m: (Map str str) i: Init) (if (pure-body? st (. i body)) (assoc m (slot-name i) (. i body)) m)) {} inits))

(defun seed :private (st: Search roots: (Vec la/LItem) main: (Vec la/LItem) inits: (Vec Init) extra: (Vec str)) -> unit
  (do (doseq [it (into roots main)] (reach-all st (refs-of it)))
      (reach-all st (into ["fib.initdef" "fib.immortalise" "fib.init-done"] extra))
      (doseq [i inits]
        (when (not (contains? (. st lazy) (slot-name i)))
          (do (reach st (. i body)) (reach st (slot-name i)))))
      (run-work st)))

;; `extra`: names kept alive besides what `main` reaches (a live program keeps the runtime's `fib_live_ctl` and `fib.live-patch` for the
;; attach thread of its session, rt/live.lir, whether or not the program calls a pause point).
(defun prune-parts (parts: Parts main: (Vec la/LItem) inits: (Vec Init) extra: (Vec str)) -> (Pair Parts (Vec Init))
  (let ((roots (cell [])))
    (let ((rts (index-items (. parts runtime) roots))
          (prog (index-items (into (into (into (into (into (into (. parts externs) (. parts types)) (. parts statics))
                                                   (. parts keywords)) (. parts defs)) (. parts quotes)) (. parts fns)) roots)))
      (let ((lazy (lazy-inits (Search prog rts (cell {}) (cell []) {}) inits)))
        (let ((st (Search prog rts (cell {}) (cell []) lazy)))
          (do (seed st @roots main inits extra)
              (let ((live @(. st live)))
                (Pair (Parts (live-items (. parts runtime) live) (live-items (. parts externs) live)
                             (live-items (. parts types) live) (live-items (. parts statics) live)
                             (live-items (. parts keywords) live) (live-items (. parts defs) live)
                             (live-items (. parts quotes) live) (live-items (. parts fns) live) (. parts links))
                      (filterv (fn (i: Init) (or (not (contains? lazy (slot-name i))) (contains? live (slot-name i)))) inits)))))))))
