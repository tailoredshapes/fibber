;; compiler/emit/resume.fib: resumable frames: turns the function being built into one that can suspend at its await points (spec/compiler.md §7).
;; Replaces crates/fibc/src/resume.rs (470 lines before its tests; its private liveness analysis `Live` and the
;; helpers are E9's). It reads a `FnBuilder` only, so it can be judged on hand-built builders (resume.rs:476-535).
;; STATUS: every public function below is a STUB of package E9, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/resume.rs, 535 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.resume
  (:use emit.value emit.ir emit.objects))

;; Where the function suspends. Rust: resume.rs:27 Shape
(defstruct ResumeShape (tsname: str prologue: i64 points: (Vec str) complete: str point-field: i64))

;; Rust: resume.rs:37
(defun make-resumable (f: FnBuilder shape: ResumeShape) -> (Result (Vec FrameSlot) str)
  (trap "todo: E9 make-resumable"))
