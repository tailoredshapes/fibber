;; compiler/emit/resume.fib: resumable frames: turns the function being built into one that can suspend at its
;; await points (spec/compiler.md §7, §8 item 3). Replaces crates/fibc/src/resume.rs (470 lines before its
;; tests; its private liveness analysis `Live` is here too). It reads and rewrites a
;; `FnBuilder` only, so it is judged alone on hand-built builders (compiler/tests/emit/unit-resume.fib,
;; the tests of resume.rs:476-535 and more).
;;
;; The body is lowered like any function, each `await` ending its block (`store point k`,
;; `fib.await-or-park`, a branch to a `ret` or to the continuation block of state k); this pass then
;; makes it resumable in place: the entry block keeps its prologue (the captures) and ends in a `switch`
;; on the task's resume point to `start` (the body's first block) or to a state's continuation; every
;; value live into a continuation lives in a slot of the task frame (stored after its definition, loaded
;; before each use, so no SSA value crosses a park and no `phi` is rebuilt); every `alloca` becomes a
;; byte slot of the frame; every `ret v` becomes the task's completion and a bare `ret`.
;;
;; Decided here (the Rust and the plan are silent or wrong):
;; - ORDER. The Rust iterates two hash tables whose order reaches the text: the live-in set of each
;;   continuation (the order of the frame's slots and of the `sN` names) and the `edge_loads` of a block
;;   (the order of the loads before its terminator). `fibc emit` is therefore not deterministic on an
;;   async body with several live values (S2 fixes it in resume.rs). This port implements the intended
;;   behaviour through TWO functions, the only places that choose an order, so that they are easy to
;;   change when S2's choice is read from resume.rs:
;;   `order-live-names` (the names a point adds, per point in `points` order) and `order-edge-loads` (the
;;   loads that go before one block's terminator). S2's resume.rs (4e509b8) chose: the live names sorted by
;;   the builder's creation order (the number of `tN`, rising: t9 before t10; ties by name), the edge loads
;;   in the order the phis are met, which is the order they are made here. Fresh names are handed out in
;;   the Rust's order (blocks in order, phis in order, edges in order), which is deterministic.
;; - the `Unsupported(String)` errors are `Err` strings with the Rust's text (`no continuation block L`,
;;   `live value N of unknown type`).
;; - a label is looked up as the FIRST block of that name (Rust: `position`); liveness used `collect` into
;;   a map (the last wins); labels are unique so the two agree.
;; - `FnBuilder.ret` is a Cell now (emit.ir), because `make_resumable` ends with `f.ret = None`.
(ns emit.resume
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt] [lir.check.walk :as walk] [lir.rewrite :as rewrite])
  (:use emit.value emit.ir emit.objects))

;; Where the function suspends: the task struct, where its prologue ends, the continuation block of each
;; state (state k is `points[k-1]`), the completion function, and the index of the frame's first field
;; (the resume point; the slots follow it). Rust: resume.rs:27 Shape
(defstruct ResumeShape (tsname: str prologue: i64 points: (Vec str) complete: str point-field: i64))

;; Only local operands of the builder's tN form participate in frame liveness.
(defun ssa-name? :private (name: str) -> bool
  (and (> (str-len name) 1) (= (str-byte-at name 0) 116i8)
       (every? (fn (i: i64) (let ((c (str-byte-at name i))) (and (>= c 48i8) (<= c 57i8)))) (range 1 (str-len name)))))

(defun item-expr :private (it: IrItem) -> la/LExpr
  (match it ((ItBind _ e _) e) ((ItStmt e) e)))

;; The address of field `k` of the task frame.
(defun slot-address :private (tsname: str k: i64) -> la/LExpr
  (nx/gep (lt/TNamed tsname) (nx/local "env") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 k)]))

;; ---- the two places that choose an order (see the header)

;; The names a point adds to the demoted values, each point's in this order: by creation order (`tN`, N
;; rising: not as text, where t10 would precede t9), ties by name. Rust: resume.rs:53 and name_order.
(defun order-live-names :private (names: (Vec str)) -> (Vec str)
  (vec (sort-by (fn (n: str) (unwrap-or (parse-long (subs n 1)) 9223372036854775807)) (sort names))))

;; A value loaded before a block's terminator for the phi operand of an edge out of that block.
(defstruct EdgeLoad :private (value: str name: str expr: la/LExpr ty: LirTy))

;; The loads that go before one block's terminator, in the order they are printed: the order the phis met
;; them, which is the order `edge-load!` made them in (Rust: the `edge_loads` list, resume.rs:261).
(defun order-edge-loads :private (loads: (Vec EdgeLoad)) -> (Vec EdgeLoad)
  loads)

;; ---- the rewriting, in the order of make_resumable

;; The prologue stays in `entry`; the rest of it becomes `start`. Rust: resume.rs:75 split_entry
(defun split-entry :private (f: FnBuilder prologue: i64) -> unit
  (let ((blocks @(. f blocks)) (entry (nth blocks 0)) (items @(. entry items)) (closed @(. entry closed)))
    (do (set! (. entry items) (vec (take prologue items)))
        (set! (. entry closed) true)
        (set! (. f blocks) (into [entry (Block "start" (cell []) (cell (vec (drop prologue items))) (cell closed) false)] (drop 1 blocks)))
        (doseq [b @(. f blocks)]
          (set! (. b phis)
                (mapv (fn (p: Phi)
                        (Phi (. p name)
                             (match (. (. p expr) kind)
                               ((la/KPhi ty edges)
                                (nx/node (la/KPhi ty (mapv (fn (e: la/LBinding)
                                                            (la/LBinding (if (= (. e name) "entry") "start" (. e name)) (. e value) (. e pos))) edges))))
                               (_ (. p expr))) (. p ty))) @(. b phis)))))))

;; The operand text of a block's last item when it is `(ret ..)`: empty for `(ret)`.
(defun last-ret-operand :private (items: (Vec IrItem)) -> (Option (Option la/LExpr))
  (match (peek items)
    ((some (ItStmt e)) (match (. e kind) ((la/KRet value) (some value)) (_ nil)))
    (_ nil)))

;; `(ret v)` completes the task with `v`; `(ret)` with nothing. The `ret` of a park block (labelled
;; `park..` by `await_task`) is the resume returning with the task parked, and stays.
;; Rust: resume.rs:98 complete_returns
(defun complete-returns :private (f: FnBuilder complete: str) -> unit
  (doseq [b @(. f blocks)]
    (when-not (starts-with? (. b label) "park")
      (match (last-ret-operand @(. b items))
        ((some value)
         (set! (. b items)
               (into (pop @(. b items))
                     [(ItStmt (nx/call complete (into [(nx/local "env")] (match value ((some v) [v]) (nil [])))))
                      (ItStmt (nx/ret nil))])))
        (nil ())))))

;; Each `alloca` becomes a byte slot of the frame, its name bound to the slot's address in the prologue;
;; `first` is the field index of the first slot. Returns the slots. Rust: resume.rs:122 move_allocas
(defun move-allocas :private (f: FnBuilder tsname: str first: i64) -> (Vec FrameSlot)
  (let ((allocas @(. f allocas))
        (entry (nth @(. f blocks) 0)))
    (do (set! (. f allocas) [])
        (set! (. entry items)
              (into (mapv (fn (i: i64) (ItBind (. (nth allocas i) name) (slot-address tsname (+ first i)) LirPtr))
                          (range (count allocas)))
                    @(. entry items)))
        (mapv (fn (a: Alloca) (FrBytes (max (. a size) 1))) allocas))))

;; ---- liveness

;; The first block of each label.
(defun label-index :private (blocks: (Vec Block)) -> (Map str i64)
  (reduce (fn (m: (Map str i64) i: i64)
            (let ((label (. (nth blocks i) label)))
              (if (contains? m label) m (assoc m label i))))
          (map-empty) (range (count blocks))))

;; What a block defines and the names it uses before defining them.
(defstruct DefUse :private (defs: (Set str) uses: (Set str)))

;; A block's phis define their names first; then each item uses the names its text mentions that are not
;; yet defined and, if it binds one, defines it.
(defun def-use :private (b: Block) -> DefUse
  (reduce (fn (acc: DefUse it: IrItem)
            (let ((uses (into (. acc uses)
                              (filter (fn (u: str) (not (contains? (. acc defs) u))) (expr-names-in (item-expr it))))))
              (match it
                ((ItBind n _ _) (DefUse (conj (. acc defs) n) uses))
                ((ItStmt _) (DefUse (. acc defs) uses)))))
          (DefUse (set (mapv (fn (p: Phi) (. p name)) @(. b phis))) (set-empty))
          @(. b items)))

;; The blocks a closed block's terminator names.
(defun successors :private (b: Block index: (Map str i64)) -> (Vec i64)
  (if @(. b closed)
      (match (peek @(. b items))
        ((some (ItStmt last))
         (reduce (fn (acc: (Vec i64) l: str)
                   (match (get index l) ((some i) (conj acc i)) (nil acc)))
                 [] (ir-targets last)))
        (_ []))
      []))

;; (p, s) -> the SSA names the phis of block s take from block p: a use at the end of p.
(defun phi-uses :private (blocks: (Vec Block) index: (Map str i64)) -> (Map (Pair i64 i64) (Set str))
  (let ((acc (cell (map-empty))))
    (do (doseq [i (range (count blocks)) p @(. (nth blocks i) phis) e (phi-incoming (. p expr))]
          (when-some [pred (get index (. e name))]
            (match (. (. e value) kind)
              ((la/KLocal name) (when (ssa-name? name)
                                  (set! acc (assoc @acc (Pair pred i) (conj (get @acc (Pair pred i) (set-empty)) name)))))
              (_ ()))))
        @acc)))

;; The live-in set of block i given the sets of the blocks after it: what it uses, and what its
;; successors need (and its phis take from it) that it does not define.
(defun live-in-of :private (i: i64 du: (Vec DefUse) succ: (Vec (Vec i64)) pu: (Map (Pair i64 i64) (Set str))
                            live: (Vec (Set str))) -> (Set str)
  (let ((out (reduce (fn (acc: (Set str) s: i64)
                       (let ((acc (into acc (nth live s))))
                         (match (get pu (Pair i s)) ((some used) (into acc used)) (nil acc))))
                     (set-empty) (nth succ i))))
    (into (. (nth du i) uses) (filter (fn (v: str) (not (contains? (. (nth du i) defs) v))) out))))

;; Backward liveness over the blocks to a fixed point. Rust: resume.rs:145 liveness
(defun liveness :private (blocks: (Vec Block) index: (Map str i64)) -> (Vec (Set str))
  (let ((du (mapv def-use blocks))
        (succ (mapv (fn (b: Block) (successors b index)) blocks))
        (pu (phi-uses blocks index)))
    (loop ((live (mapv (fn (_: Block) (set-empty)) blocks)))
      (let ((next (reduce (fn (acc: (Vec (Set str)) i: i64) (assoc acc i (live-in-of i du succ pu acc)))
                          live (reverse (range (count blocks))))))
        (if (= next live) live (recur next))))))

;; The values to demote: those live into some continuation, each point's new ones in `order-live-names`
;; order, without the prologue's definitions (`entry` runs again on a resume) and `env`.
(defun demoted-names :private (f: FnBuilder shape: ResumeShape) -> (Result (Vec str) str)
  (let ((blocks @(. f blocks))
        (index (label-index blocks))
        (live (liveness blocks index))
        (prologue (set (reduce (fn (acc: (Vec str) it: IrItem) (match it ((ItBind n _ _) (conj acc n)) (_ acc)))
                               [] @(. (nth blocks 0) items)))))
    (try-let ((names (reduce (fn (acc: (Result (Vec str) str) label: str)
                               (try-let ((so-far acc))
                                 (match (get index label)
                                   ((some i) (Ok (into so-far (order-live-names
                                                               (filterv (fn (n: str) (not (includes? n so-far)))
                                                                        (vec (nth live i)))))))
                                   (nil (Err (str-join ["no continuation block " label]))))))
                             (Ok []) (. shape points))))
      (Ok (filterv (fn (n: str) (not (or (contains? prologue n) (= n "env")))) names)))))

;; ---- demotion

;; A demoted value: its name, the frame field that holds it (its address is `s` and the field), its type.
(defstruct Slot :private (value: str field: i64 ty: LirTy))

(defun slot-name :private (s: Slot) -> str (str-join ["s" (str (. s field))]))

(defun load-text :private (s: Slot) -> la/LExpr
  (nx/load (lir-type (. s ty)) (nx/local (slot-name s)) (lir-align (. s ty))))

;; The type of each value the builder binds: its phis and `ItBind`s.
(defun value-types :private (blocks: (Vec Block)) -> (Map str LirTy)
  (let ((m (cell (map-empty))))
    (do (doseq [b blocks]
          (do (doseq [p @(. b phis)] (set! m (assoc @m (. p name) (. p ty))))
              (doseq [it @(. b items)]
                (match it
                  ((ItBind n _ ty) (set! m (assoc @m n ty)))
                  ((ItStmt _) ())))))
        @m)))

;; A slot per name, from field `first` on; a value the builder never bound is an error.
(defun slot-table :private (names: (Vec str) first: i64 types: (Map str LirTy)) -> (Result (Vec Slot) str)
  (reduce (fn (acc: (Result (Vec Slot) str) nm: str)
            (try-let ((slots acc))
              (match (get types nm)
                ((some t) (Ok (conj slots (Slot nm (+ first (count slots)) t))))
                (nil (Err (str-join ["live value " nm " of unknown type"]))))))
          (Ok []) names))

;; The load of the slot of `v` that goes before the terminator of block p, made once per (p, v).
(defun edge-load! :private (f: FnBuilder loads: (Cell (Map i64 (Vec EdgeLoad))) p: i64 s: Slot) -> str
  (match (find-first (fn (e: EdgeLoad) (= (. e value) (. s value))) (get @loads p []))
    ((some e) (. e name))
    (nil (let ((n (fb-fresh f)))
           (do (set! loads (assoc @loads p (conj (get @loads p []) (EdgeLoad (. s value) n (load-text s) (. s ty)))))
               n)))))

;; The operands of a phi that are demoted values come from the end of the block they come from, loaded.
(defun rewrite-phi :private (f: FnBuilder labels: (Map str i64) table: (Map str Slot)
                             loads: (Cell (Map i64 (Vec EdgeLoad))) p: Phi) -> Phi
  (Phi (. p name)
       (match (. (. p expr) kind)
         ((la/KPhi ty edges)
          (nx/node (la/KPhi ty (mapv (fn (e: la/LBinding)
                                      (match (. (. e value) kind)
                                        ((la/KLocal name)
                                         (match (Pair (get table name) (get labels (. e name)))
                                           ((Pair (some slot) (some pred))
                                            (la/LBinding (. e name) (nx/local (edge-load! f loads pred slot)) (. e pos)))
                                           (_ e)))
                                        (_ e))) edges))))
         (_ (. p expr))) (. p ty)))

;; One item with a load before it for each demoted value it uses, and a store after it when it binds one.
(defun demote-item :private (f: FnBuilder table: (Map str Slot) out: (Cell (Vec IrItem)) it: IrItem) -> unit
  (let ((names (cell (map-empty))))
    (do (doseq [u (expr-names-in (item-expr it))]
          (when-some [slot (get table u)]
            (let ((name (fb-fresh f)))
              (do (set! out (conj @out (ItBind name (load-text slot) (. slot ty))))
                  (set! names (assoc @names u name))))))
        (let ((expr (rewrite/substitute-locals (item-expr it) @names)))
          (match it
            ((ItBind name _ ty)
             (do (set! out (conj @out (ItBind name expr ty)))
                 (when-some [slot (get table name)]
                   (set! out (conj @out (ItStmt (nx/store (nx/local name) (nx/local (slot-name slot)) (lir-align (. slot ty)))))))))
            ((ItStmt _) (set! out (conj @out (ItStmt expr)))))))))

;; A block's items rewritten: its demoted phis stored first, then each item, the edge loads of the block
;; going in before its terminator.
(defun demote-block :private (f: FnBuilder table: (Map str Slot) loads: (Cell (Map i64 (Vec EdgeLoad)))
                              bi: i64 b: Block) -> unit
  (let ((items @(. b items))
        (last (max 0 (- (count items) 1)))
        (out (cell (into [] (keep (fn (p: Phi) (match (get table (. p name))
                                                  ((some s) (some (ItStmt (nx/store (nx/local (. p name)) (nx/local (slot-name s)) (lir-align (. s ty))))))
                                                  (nil nil)))
                                  @(. b phis))))))
    (do (doseq [k (range (count items))]
          (do (when (and (= k last) @(. b closed))
                (doseq [e (order-edge-loads (get @loads bi []))]
                  (set! out (conj @out (ItBind (. e name) (. e expr) (. e ty))))))
              (demote-item f table out (nth items k))))
        (set! (. b items) @out))))

;; Gives each demoted value a slot: a store after its definition, a load before each use. Returns the
;; frame's slots for them. Rust: resume.rs:218 demote
(defun demote :private (f: FnBuilder tsname: str names: (Vec str) first: i64) -> (Result (Vec FrameSlot) str)
  (let ((blocks @(. f blocks)))
    (try-let ((slots (slot-table names first (value-types blocks))))
      (let ((table (reduce (fn (m: (Map str Slot) s: Slot) (assoc m (. s value) s)) (map-empty) slots))
            (labels (label-index blocks))
            (loads (cell (map-empty)))
            (entry (nth blocks 0)))
        (do (set! (. entry items)
                  (into (mapv (fn (s: Slot) (ItBind (slot-name s) (slot-address tsname (. s field)) LirPtr)) slots)
                        @(. entry items)))
            (doseq [b (drop 1 blocks)]
              (set! (. b phis) (mapv (fn (p: Phi) (rewrite-phi f labels table loads p)) @(. b phis))))
            (doseq [bi (range 1 (count blocks))]
              (demote-block f table loads bi (nth blocks bi)))
            (Ok (mapv (fn (s: Slot) (FrVal (. s ty))) slots)))))))

;; The entry's terminator: a `switch` on the resume point. Rust: resume.rs:339 switch_entry
(defun switch-entry :private (f: FnBuilder shape: ResumeShape) -> unit
  (let ((pp (fb-fresh f)) (pt (fb-fresh f)) (entry (nth @(. f blocks) 0))
        (cases (mapv (fn (i: i64) (la/LCase (nx/integer lt/ty-i32 (+ i 1)) (nth (. shape points) i)))
                     (range (count (. shape points))))))
    (set! (. entry items)
          (into @(. entry items)
                [(ItBind pp (slot-address (. shape tsname) (. shape point-field)) LirPtr)
                 (ItBind pt (nx/load lt/ty-i32 (nx/local pp) nil) LirI32)
                 (ItStmt (nx/switch (nx/local pt) "start" cases))]))))

;; Rewrites `f` as described above and returns the frame's layout: the resume point, then the slots
;; (the allocas', then the demoted values'). Rust: resume.rs:37 make_resumable
(defun make-resumable (f: FnBuilder shape: ResumeShape) -> (Result (Vec FrameSlot) str)
  (do (set! (. f blocks) (filterv (fn (b: Block) (not (. b dead))) @(. f blocks)))
      (split-entry f (. shape prologue))
      (complete-returns f (. shape complete))
      (let ((first (+ (. shape point-field) 1))
            (bytes (move-allocas f (. shape tsname) first)))
        (try-let ((names (demoted-names f shape))
                  (vals (demote f (. shape tsname) names (+ first (count bytes)))))
          (do (switch-entry f shape)
              (set! (. f ret) nil)
              (Ok (into (into [(FrVal LirI32)] bytes) vals)))))))


(defun phi-incoming :private (expr: la/LExpr) -> (Vec la/LBinding)
  (match (. expr kind) ((la/KPhi _ edges) edges) (_ [])))

(defun expr-names-in (expr: la/LExpr) -> (Vec str)
  (loop ((stack [expr]) (out []))
    (match (peek stack)
      (nil out)
      ((some e)
       (recur (into (pop stack) (reverse (walk/children e)))
              (match (. e kind)
                ((la/KLocal name) (if (and (ssa-name? name) (not (includes? name out))) (conj out name) out))
                (_ out)))))))
