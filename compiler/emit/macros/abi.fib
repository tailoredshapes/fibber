;; compiler/emit/macros/abi.fib: the ABI of a macro module: the layout of `Form` and the text of the entry the expander calls (spec/compiler.md §6).
;; Replaces crates/fibc/src/macros/abi.rs (`compile_macro` and `macro_forms` are E11's too, in emit.compile and here).
;; STATUS: every public function below is a STUB of package E11, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/macros/abi.rs, 174 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.macros.abi
  (:use emit.value emit.lower.cx))

;; The layout of the built-in `Form`. Rust: macros/abi.rs:14 FormLayout (`tags: [u32; 11]`)
(defstruct FormLayout (sname: str tid: i64 tags: (Vec i64) size: i64 vec: VecIds keyword-strs: (Vec str)))

;; The integer and float widths and the variants of `Form`, in tag order. Rust: macros/abi.rs:31, :34
(defun abi-widths () -> (Vec str) ["i8" "i16" "i32" "i64" "f32" "f64"])
(defun abi-variants () -> (Vec str) ["Sym" "Kw" "Int" "Flt" "Str" "Chr" "Bool" "Nil" "List" "Vec" "Map"])

;; Rust: macros/abi.rs:40 render
(defun abi-render (f: FormLayout body: str n: i64 k: i64) -> str
  (trap "todo: E11 abi-render"))
