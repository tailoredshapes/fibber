;; compiler/emit/macros/abi.fib: the ABI of a macro module: the layout of `Form`, the table of the keywords the module interned and the text of
;; the entry the expander calls (spec/compiler.md §6): the C-callable surface of a macro-time module, its entry that runs the macro, the
;; constructors and readers of `Form` objects for the expander's forms, the hooks the module calls back for `gensym` and reflection, all
;; `ccc` and exported. Replaces crates/fibc/src/macros/abi.rs (the text is the Rust's, byte for byte) and `macro_forms` of
;; macros/mod.rs; `compile-macro` is emit.compile's.
(ns emit.macros.abi
  (:require [fib.string :as s] [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f] [lir.print :as print])
  (:use syntax.pos syntax.form expand.types emit.value emit.layout emit.lower.cx))

;; The layout of the built-in `Form`. Rust: macros/abi.rs:14 FormLayout (`tags: [u32; 11]`): `sname` is the `Form` object's struct name
;; (its variants are `.vN`), `tags` the variant index of each name in the order of `abi-variants`, `size` the size of a `Form` object,
;; and `keyword-strs` the static `str` constant (`@str.N`) holding each interned keyword's name, by keyword id.
(defstruct FormLayout (sname: str tid: i64 tags: (Vec i64) size: i64 vec: VecIds keyword-strs: (Vec str)))

;; The width suffixes `compile-macro` interns before anything else, so that a form of any width can be given an id by name, and the
;; variants of `Form` in tag order. Rust: macros/abi.rs:31 WIDTHS, :34 VARIANTS
(defun abi-widths () -> (Vec str) ["i8" "i16" "i32" "i64" "f32" "f64"])
(defun abi-variants () -> (Vec str) ["Sym" "Kw" "Int" "Flt" "Str" "Chr" "Bool" "Nil" "List" "Vec" "Map"])

(defun surface :private (word: str k: str ret: (Option lt/LType) params: (Vec (Pair str lt/LType)) blocks: (Vec la/LBlock)) -> la/LItem
  (la/ItDefine (f/external (f/make (str "fibm." word "." k) ret params lt/cc-c blocks))))

(defun abi-keyword-items (strs: (Vec str) k: i64) -> (Vec la/LItem)
  (let ((suffix (str k))
        (cases (mapv (fn (i: i64) (la/LCase (n/integer lt/ty-i64 i) (str "kw" i))) (range (count strs))))
        (blocks (mapv (fn (i: i64) (f/block (str "kw" i) [(n/ret (some (n/reference (nth strs i))))])) (range (count strs)))))
    [(surface "kw-count" suffix (some lt/ty-i64) [] [(f/block "entry" [(n/ret (some (n/integer lt/ty-i64 (count strs))))])])
     (surface "kw" suffix (some lt/ty-ptr) [(Pair "id" lt/ty-i64)]
       (conj (into [(f/block "entry" [(n/switch (n/local "id") "none" cases)])] blocks)
             (f/block "none" [(n/ret (some (n/null)))])))]))

(defun abi-render-keywords (strs: (Vec str) k: i64) -> str
  (print/print-module (la/LModule (abi-keyword-items strs k))))

(defun abi-entry :private (body: str count: i64 k: str) -> la/LItem
  (surface "entry" k (some lt/ty-ptr)
    (mapv (fn (i: i64) (Pair (str "a" i) lt/ty-ptr)) (range count))
    [(f/block "entry" [(n/ret (some (n/call body (mapv (fn (i: i64) (n/local (str "a" i))) (range count)))))])]))

(defun abi-form :private (layout: FormLayout k: str) -> la/LItem
  (let ((sn (. layout sname)) (tags (. layout tags)))
    (let ((cases (mapv (fn (i: i64)
                        (la/LCase (n/integer lt/ty-i32 (nth tags i))
                                  (cond (= i 2) "intf" (= i 3) "fltf" (= i 5) "chrf" (= i 6) "boolf" :else "ptrf")))
                      [0 1 2 3 4 5 6 8 9 10])))
      (surface "form" k (some lt/ty-ptr) [(Pair "tag" lt/ty-i32) (Pair "a" lt/ty-i64) (Pair "b" lt/ty-i64) (Pair "p" lt/ty-ptr)]
        [(f/block "entry" [(f/bound [(f/binding "o" (n/call "fib.alloc" [(n/integer lt/ty-i64 (. layout size)) (n/integer lt/ty-i32 (. layout tid))]))
                                    (f/binding "f0" (f/field (str sn ".v0") (n/local "o") 4))
                                    (f/binding "f1" (f/field (str sn ".v2") (n/local "o") 5))]
                          [(n/store (n/integer lt/ty-i32 flag-immortal) (f/field "fib.hdr" (n/local "o") 2) nil)
                           (n/store (n/integer lt/ty-i64 0) (f/field "fib.hdr" (n/local "o") 0) nil)
                           (n/store (n/local "tag") (f/field sn (n/local "o") 3) nil)
                           (n/switch (n/local "tag") "done" cases)])])
         (f/block "ptrf" [(n/store (n/local "p") (n/local "f0") nil) (n/branch "done")])
         (f/block "intf" [(n/store (n/local "a") (n/local "f0") nil) (n/store (n/local "b") (n/local "f1") nil) (n/branch "done")])
         (f/block "fltf" [(n/store (n/cast la/CBitcast lt/ty-double (n/local "a")) (n/local "f0") nil)
                          (n/store (n/local "b") (n/local "f1") nil) (n/branch "done")])
         (f/block "chrf" [(n/store (n/cast la/CTrunc lt/ty-i32 (n/local "a")) (f/field (str sn ".v5") (n/local "o") 4) nil) (n/branch "done")])
         (f/block "boolf" [(n/store (n/cast la/CTrunc lt/ty-i1 (n/local "a")) (f/field (str sn ".v6") (n/local "o") 4) nil) (n/branch "done")])
         (f/block "done" [(n/ret (some (n/local "o")))])]))))

(defun abi-constructors :private (layout: FormLayout k: str) -> (Vec la/LItem)
  [(surface "str" k (some lt/ty-ptr) [(Pair "bytes" lt/ty-ptr) (Pair "n" lt/ty-i64)]
     [(f/block "entry" [(f/bound [(f/binding "r" (n/call "fib.str-new" [(n/local "n")]))]
                                 [(n/call "memcpy" [(n/call "fib.str-bytes-ptr" [(n/local "r")]) (n/local "bytes") (n/local "n")])
                                  (n/ret (some (n/local "r")))])])])
   (abi-form layout k)])

(defun form-reader :private (layout: FormLayout k: str word: str variant: str slot: i64 ty: lt/LType widen: bool) -> la/LItem
  (let ((value (n/load ty (f/field (str (. layout sname) variant) (n/local "o") slot) nil)))
    (surface word k (some (if widen lt/ty-i32 ty)) [(Pair "o" lt/ty-ptr)]
      [(f/block "entry" [(n/ret (some (if widen (n/cast la/CZExt lt/ty-i32 value) value)))])])) )

(defun call-reader :private (k: str word: str runtime: str ty: lt/LType) -> la/LItem
  (surface word k (some ty) [(Pair "s" lt/ty-ptr)] [(f/block "entry" [(n/ret (some (n/call runtime [(n/local "s")])))])]))

(defun abi-readers :private (layout: FormLayout k: str) -> (Vec la/LItem)
  (let ((v (. layout vec)))
    [(surface "vec" k (some lt/ty-ptr) [(Pair "buf" lt/ty-ptr) (Pair "n" lt/ty-i64)]
       [(f/block "entry" [(n/ret (some (n/call "fib.vec-build" [(n/local "buf") (n/local "n") (n/integer lt/ty-i64 8) (n/integer lt/ty-i8 1)
                              (n/integer lt/ty-i32 (. v tvec)) (n/integer lt/ty-i32 (. v tnode)) (n/integer lt/ty-i32 (. v tarr)) (n/integer lt/ty-i32 (. v tnarr))])))])])
     (form-reader layout k "tag" "" 3 lt/ty-i32 false)
     (form-reader layout k "f0-ptr" ".v0" 4 lt/ty-ptr false)
     (form-reader layout k "f0-i64" ".v2" 4 lt/ty-i64 false)
     (form-reader layout k "f0-f64" ".v3" 4 lt/ty-double false)
     (form-reader layout k "f0-i32" ".v5" 4 lt/ty-i32 false)
     (form-reader layout k "f0-i1" ".v6" 4 lt/ty-i1 true)
     (form-reader layout k "f1-i64" ".v2" 5 lt/ty-i64 false)
     (call-reader k "str-len" "fib.str-len" lt/ty-i64)
     (call-reader k "str-ptr" "fib.str-bytes-ptr" lt/ty-ptr)
     (call-reader k "vec-len" "fib.vec-len" lt/ty-i64)
     (surface "vec-elem" k (some lt/ty-ptr) [(Pair "v" lt/ty-ptr) (Pair "i" lt/ty-i64)]
       [(f/block "entry" [(n/ret (some (n/load lt/ty-ptr (n/call "fib.vec-elem-ptr" [(n/local "v") (n/local "i") (n/integer lt/ty-i64 8)]) nil)))])])
     (surface "set-hooks" k nil [(Pair "gensym" lt/ty-ptr) (Pair "reflect" lt/ty-ptr) (Pair "cx" lt/ty-ptr)]
       [(f/block "entry" [(n/store (n/local "gensym") (n/global "fibm.gensym-hook") nil) (n/store (n/local "reflect") (n/global "fibm.reflect-hook") nil)
                          (n/store (n/local "cx") (n/global "fibm.hook-cx") nil) (n/ret nil)])])
     (surface "set-trap-hook" k nil [(Pair "trap" lt/ty-ptr)] [(f/block "entry" [(n/store (n/local "trap") (n/global "fibm.trap-hook") nil) (n/ret nil)])])
     (surface "init" k nil [] [(f/block "entry" [(n/call "fib.init" []) (n/ret nil)])])]))

(defun abi-items (layout: FormLayout body: str count: i64 k: i64) -> (Vec la/LItem)
  (into (into (conj (abi-keyword-items (. layout keyword-strs) k) (abi-entry body count (str k)))
              (abi-constructors layout (str k))) (abi-readers layout (str k))))

(defun abi-render (layout: FormLayout body: str count: i64 k: i64) -> str
  (print/print-module (la/LModule (abi-items layout body count k))))

;; ---- the forms of a macro-time module

;; The macro-time module's forms: the `defmacro` and a `main`, as the interpreter's runner builds them. Rust: macros/mod.rs:219 macro_forms
(defun macro-forms (m: MacroDef) -> (Vec Stx)
  (let ((p (. m pos)))
    (let ((sym (fn (s: str) (Stx (SSym s) p)))
          (params (into (mapv (fn (s: str) (Stx (SSym s) p)) (. m params))
                        (match (. m rest) (nil []) ((some r) [(Stx (SSym "...") p) (Stx (SSym r) p)])))))
      [(Stx (SList (into [(sym "defmacro") (sym (. m name)) (Stx (SList params) p)] (. m body))) p)
       (Stx (SList [(sym "defun") (sym "main") (Stx (SList []) p) (sym "->") (sym "i64") (Stx (SInt 0 I64) p)]) p)])))
