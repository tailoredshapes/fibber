;; compiler/emit/macros/front.fib: the front of `emit-dump --macro NAME` (spec/bootstrap.md §8): the program read, loaded and expanded as
;; `fibc emit-dump` expands it, with the expander's context kept, because the macros a module defined are in the context and not in
;; the expanded forms. Rust: emit_dump/front.rs:57 `expand` and the first half of :113 `macro_text`; the check of the macro's forms, the
;; module and the printing are emit.dump's. types.dump's `dump-file` hands a check only the expanded modules, so the loop is written
;; again here (its records are private there). There is no macro runner in stage 2 (`no-runner`): a file whose own macro uses another
;; macro ends in the expander's `MacroNeedsEvaluator` record where the Rust prints the module (pending until stage 2b).
(ns emit.macros.front
  (:require [syntax.dump :as sdump] [expand.modules :as mods] [expand.program :as prog] [types.driver :as driver]
            [types.dump :as dump] [lair.ffi :as ffi])
  (:use syntax.form syntax.error expand.error expand.types expand.ctx expand.roots))

(def no-position: str "0:0 0..0")

(extern getenv :private (ptr) -> ptr)

;; The value of the environment variable `name`, or nil if it is not set (as driver.native `getenv-opt`: the tool reads FIB_LIB as
;; fibc does, so that the library files and the stdlib support modules are found where the Rust finds them, under the same names).
(defun getenv-opt :private (name: str) -> (Option str)
  (let ((key (ffi/bytes-new name))
        (at (unsafe (ffi/ptr->addr (getenv key)))))
    (do (ffi/free-addr (ffi/ptr->addr key))
        (if (= at 0) nil (some (ffi/c-string-at at))))))

;; The macro of a file, as the front finds it: the lines printed so far (the header), the definition, the prelude's forms.
(defstruct MacroInput (lines: (Vec str) def: MacroDef prelude: (Vec Stx)))

;; `error KIND AT: MESSAGE`. Rust: expand_dump::record
(defun record :private (kind: str at: str message: str) -> str
  (str-join ["error " kind " " at ": " message]))

(defun read-record :private (e: ReadError home: str) -> str
  (record (err-name (. e kind)) (sdump/span-in (. e pos) home) (err-message (. e kind))))

(defun expand-record :private (e: ExpandError home: str) -> str
  (record (expand-err-name (. e kind)) (sdump/span-in (. e pos) home) (expand-err-message (. e kind))))

;; The record of a program that could not be loaded.
(defun load-record :private (e: LoadErr home: str) -> str
  (match e
    ((LoadRead r) (read-record r home))
    ((LoadSpec pos what) (record "BadNs" (sdump/span-in pos home) what))
    ((LoadMissing _ _) (record "ModuleMissing" no-position (mods/load-err-message e)))
    ((LoadCycle _ _) (record "ModuleCycle" no-position (mods/load-err-message e)))
    ((LoadMismatch _ _ _) (record "ModuleMismatch" no-position (mods/load-err-message e)))))

;; The output of a file that ended in a record: status 1.
(defun failed :private (lines: (Vec str) text: str) -> dump/Dumped
  (dump/Dumped (conj lines text) 1))

;; Expands the modules of `loaded` in order in `ctx`, each begun and ended. The first expansion error ends the expansion; it is `Err`, a
;; record under its `-- module NS FILE` line, except that a call of a user macro (`MacroNeedsEvaluator`: stage 2 has no runner yet) is
;; `Ok` of that record: the macros defined before it are in the context and their modules do not depend on what follows.
(defun expand-loaded :private (lines: (Vec str) ctx: ExpandCtx loaded: (Vec Loaded)) -> (Result (Option dump/Dumped) dump/Dumped)
  (loop ((i 0))
    (if (>= i (count loaded))
        (Ok nil)
        (let ((l (nth loaded i)))
          (do (mods/begin-spec ctx (. l spec))
              (match (prog/expand-program (. l forms) ctx (no-runner))
                ((Err e)
                 (let ((d (failed (conj lines (str-join ["-- module " (. (. l spec) ns) " " (. l file)])) (expand-record e (. l file)))))
                   (if (= (expand-err-name (. e kind)) "MacroNeedsEvaluator") (Ok (some d)) (Err d))))
                ((Ok _) (do (ctx-end-module ctx) (recur (+ i 1))))))))))

;; The first macro, in the order of the keys, whose key or whose name is `name`. Rust: `defs.iter().find(..)` of macro_text
(defun find-macro :private (ctx: ExpandCtx name: str) -> (Option MacroDef)
  (let ((ms (ctx-macros-by-key ctx)))
    (loop ((i 0))
      (cond (>= i (count ms)) nil
            (or (= (. (nth ms i) key) name) (= (. (nth ms i) name) name)) (some (nth ms i))
            :else (recur (+ i 1))))))

;; The macro `name` of the source of `file`, expanded, or what ends the file's output: a record of the front end, `NoMacro` when the
;; file has no such macro.
(defun macro-of :private (lines: (Vec str) source: str file: str name: str) -> (Result MacroInput dump/Dumped)
  (let ((ctx (ctx-new)))
    (match (driver/prelude-forms ctx)
      ((Err m) (Err (failed lines (record "Prelude" no-position m))))
      ((Ok prelude)
       (match (mods/try-load-with source file (roots-from-env [] (getenv-opt "FIB_LIB")) (mods/implicit-lib))
         ((Err e) (Err (failed lines (load-record e file))))
         ((Ok loaded)
          (try-let ((cut (expand-loaded lines ctx loaded)))
            (match (find-macro ctx name)
              ((some m) (Ok (MacroInput lines m prelude)))
              (nil (Err (unwrap-or cut (failed lines (record "NoMacro" no-position (str-join ["no macro " name]))))))))))))))

;; The file's header and its macro: `unreadable` for a file that is not there. Rust: files_here and the start of `macro_text`
(defun macro-front (file: str name: str) -> (Result MacroInput dump/Dumped)
  (let ((header [(str-concat "== " file)]))
    (match (read-file file)
      (nil (Err (dump/Dumped (conj header "unreadable") 2)))
      ((some source) (macro-of header source file name)))))
