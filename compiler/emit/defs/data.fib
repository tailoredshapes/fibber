;; compiler/emit/defs/data.fib: the structured constants of the `def`s (spec/compiler.md §5, types §8.10).
;; Replaces crates/fibc/src/defs/mod.rs (147 lines of Rust: `Defs`, `all_def_ids` (emit.inits'), `def_ids`, `Defs::emit_array`,
;; `emit_object`, `field_types`, `fresh`). It is below emit.defs.jit (the reader of the JIT's memory builds constants through
;; these) and emit.defs.mod (`emit-defs`, which `:export-from`s this module so that `Defs` is still seen where it was).
(ns emit.defs.data
  (:require [fib.string :as s] [emit.node :as n] [lir.types :as lt])
  (:use lir.ast types.ty types.decls emit.value emit.layout emit.program emit.inits))

;; Constant items and their values stay structured throughout evaluation.
(defstruct Defs (items: (Cell (Vec LItem)) values: (Cell (Map i64 DefValue)) constants: (Cell (Vec str)) counter: (Cell i64)))

(defun defs-new () -> Defs (defs-new-from 0))

;; `Defs` whose constants are numbered past `n`: a live session's program numbers its own past every number the session gave out
;; (emit.program `DefCache.next`), so that a constant replayed from the session and a fresh one never share a name.
(defun defs-new-from (n: i64) -> Defs
  (Defs (cell []) (cell (map-empty)) (cell []) (cell n)))

;; The `def`s made at compile time as static data: those whose initialiser is a constant expression (syntax §3.19); the others are
;; made at run time by the init functions of emit.inits. Rust: defs/mod.rs:58 def_ids
(defun def-ids (p: Program) -> (Vec i64)
  (vec (filter (fn (d: i64) (. (g-def (program-g p) d) constant)) (all-def-ids p))))

;; The number of the next constant, recorded as `@def.N` in `constants`. Rust: defs/mod.rs:140 fresh
(defun defs-fresh :private (d: Defs) -> i64
  (let ((n (+ @(. d counter) 1)))
    (do (set! (. d counter) n)
        (cell-update! (. d constants) (fn (constants: (Vec str)) (conj constants (str-join ["@def." (str n)]))))
        n)))

(defun defs-append (d: Defs item: LItem) -> unit
  (cell-update! (. d items) (fn (items: (Vec LItem)) (conj items item))))

;; An array constant of `t = (Array E)` with these element nodes. Rust: defs/mod.rs:62 Defs::emit_array
(defun defs-emit-array (d: Defs p: Program t: Ty el: LirTy elems: (Vec (Option LExpr))) -> (Result LExpr str)
  (try-let ((o (program-object p t)))
    (let ((length (count elems)) (id (defs-fresh d)) (array-ty (lt/TArray (count elems) (lir-type el))))
      (do (defs-append d (ItGlobal (LGlobalDef (str "def." id) (lt/TAnon [lt/ty-i64 lt/ty-i32 lt/ty-i32 lt/ty-i64 array-ty])
                                              (n/aggregate [(n/integer lt/ty-i64 0) (n/integer lt/ty-i32 (. o fst))
                                                            (n/integer lt/ty-i32 flag-immortal) (n/integer lt/ty-i64 length)
                                                            (n/array-value array-ty (vec (keep (fn (e: (Option LExpr)) e) elems)))])
                                              true (LModifiers lk-internal false false) 0 false)))
          (Ok (n/global (str "def." id)))))))

;; A struct or variant constant of nominal type `t` with these optional field nodes (a unit field is absent and skipped).
;; Rust: defs/mod.rs:85 Defs::emit_object
(defun defs-emit-object (d: Defs p: Program t: Ty tag: (Option i64) fields: (Vec (Option LExpr))) -> (Result LExpr str)
  (try-let ((o (program-object p t)))
    (let ((sname (match tag (nil (. o snd)) ((some i) (str (. o snd) ".v" i))))
          (head [(n/integer lt/ty-i64 0) (n/integer lt/ty-i32 (. o fst)) (n/integer lt/ty-i32 flag-immortal)])
          (tagged (match tag (nil []) ((some i) [(n/integer lt/ty-i32 i)])))
          (given (vec (keep (fn (f: (Option LExpr)) f) fields))))
      (let ((id (defs-fresh d)))
        (do (defs-append d (ItGlobal (LGlobalDef (str "def." id) (lt/TNamed sname) (n/named-aggregate sname (into (into head tagged) given))
                                                true (LModifiers lk-internal false false) 0 false)))
            (Ok (n/global (str "def." id))))))))

;; The field types of the struct, or of variant `tag`, of nominal type `t`. Rust: defs/mod.rs:118 Defs::field_types
(defun field-types (p: Program t: Ty tag: (Option i64)) -> (Result (Vec Ty) str)
  (match t
    ((TCon (KNominal id) args)
     (try-let ((vs (variants (program-g p) id args)))
       (Ok (. (nth vs (unwrap-or tag 0)) tys))))
    (_ (Err "an object at a non-nominal type"))))
