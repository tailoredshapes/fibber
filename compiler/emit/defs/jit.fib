;; compiler/emit/defs/jit.fib: a `def`'s value through the JIT (types §8.10, spec/compiler.md §5, §9). Replaces crates/fibc/src/defs/jit.rs
;; (310 lines of Rust): the initialiser is lowered as the body `d.NAME`, the module so far (runtime, tables, the constants of the earlier
;; `def`s, every body) is JIT-compiled through lair (compiler/lair/jit.fib, the C interface), the initialiser is called, and its value is
;; read out of the JIT's memory by the type table's layouts into constants (emit.defs.data). The self-hosted compiler has only this
;; mechanism; there is no interpreter to fall back on.
;;
;; fibber cannot call a function pointer of another result type than an `i64` or a `double` (lair.call), so the entry of a `def`
;; widens its result in lIR: a narrow integer by `sext` (`zext` for an `i1`), a `float` by `fpext`. The text of this module is
;; never printed, only the constants it makes. Memory is read through raw pointers (`unsafe`), from addresses held as `i64`s.
(ns emit.defs.jit
  (:require [native.api :as jit] [native.call :as call] [lair.ffi :as ffi] [emit.defs.astmod :as am] [emit.defs.cache :as dc] [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f])
  (:use types.ty own.program emit.value emit.text emit.layout emit.objects emit.statics emit.mono emit.program emit.assemble emit.defs.data))

;; What a `def`'s entry returned, or a field held. Rust: defs/jit.rs:88 Raw (the `f32` is widened, as `float_text(f64::from(x))`)
;; `DrOpt` is an `(Option scalar)` held as the pair `{ i1 t }`: its tag and its payload.
(defenum DefRaw DrUnit (DrInt n: i64) (DrFlt x: f64) (DrPtr a: i64) (DrOpt tag: i64 payload: DefRaw))

;; The constants already made for the objects at these JIT addresses (the earlier `def`s, the immortal closures, and each object read
;; so far, so that a shared object is one constant). Rust: defs/jit.rs:157 Reader
(defstruct Reader (names: (Cell (Map i64 la/LExpr))))

;; --- the JIT's memory ---

(defun mem-i8 :private (a: i64) -> i64 (unsafe (sext i64 (load-i8 (ffi/addr->ptr a)))))
(defun mem-u8 :private (a: i64) -> i64 (unsafe (zext i64 (load-i8 (ffi/addr->ptr a)))))
(defun mem-i16 :private (a: i64) -> i64 (unsafe (sext i64 (load-i16 (ffi/addr->ptr a)))))
(defun mem-i32 :private (a: i64) -> i64 (unsafe (sext i64 (load-i32 (ffi/addr->ptr a)))))
(defun mem-u32 :private (a: i64) -> i64 (unsafe (zext i64 (load-i32 (ffi/addr->ptr a)))))
(defun mem-i64 :private (a: i64) -> i64 (unsafe (load-i64 (ffi/addr->ptr a))))
(defun mem-f32 :private (a: i64) -> f64 (unsafe (fpext f64 (bits->f32 (load-i32 (ffi/addr->ptr a))))))
(defun mem-f64 :private (a: i64) -> f64 (unsafe (bits->f64 (load-i64 (ffi/addr->ptr a)))))

;; A raw read of `l` at `a`: an address inside an object the JIT allocated, at a field of that type by the type table's layout.
;; Rust: defs/jit.rs:167 read
(defun read-raw :private (a: i64 l: LirTy) -> (Result DefRaw str)
  (match l
    ((LirI1) (Ok (DrInt (bit-and (mem-u8 a) 1))))
    ((LirI8) (Ok (DrInt (mem-i8 a))))
    ((LirI16) (Ok (DrInt (mem-i16 a))))
    ((LirI32) (Ok (DrInt (mem-i32 a))))
    ((LirI64) (Ok (DrInt (mem-i64 a))))
    ((LirFloat) (Ok (DrFlt (mem-f32 a))))
    ((LirDouble) (Ok (DrFlt (mem-f64 a))))
    ((LirPtr) (Ok (DrPtr (mem-i64 a))))
    ((LirDyn) (Err "a def holding a dyn"))
    ((LirVec _ _) (Err "a def holding a lane vector"))
    ((LirOpt inner)
     ;; the tag byte, then the payload at its alignment
     (let ((offsets (field-offsets [(Pair 1 1) (size-align inner)])))
       (try-let ((payload (read-raw (+ a (nth offsets 1)) inner)))
         (Ok (DrOpt (bit-and (mem-u8 a) 1) payload)))))
    ((LirRaw) (Err "a def holding a raw ptr"))))

;; --- the entry ---

;; An entry of result type `ty` that returns `expr`.
(defun entry-word :private (entry: str ty: lt/LType expr: la/LExpr) -> la/LItem
  (la/ItDefine (f/external (f/make entry (some ty) [] lt/cc-c [(f/block "entry" [(n/ret (some expr))])]))))

;; The type an entry returns for a value `c` of lIR type `l` and the text that widens `c` to it.
(defun widened :private (l: LirTy value: la/LExpr) -> (Pair lt/LType la/LExpr)
  (match l
    ((LirI1) (Pair lt/ty-i64 (n/cast la/CZExt lt/ty-i64 value)))
    ((LirI8) (Pair lt/ty-i64 (n/cast la/CSExt lt/ty-i64 value)))
    ((LirI16) (Pair lt/ty-i64 (n/cast la/CSExt lt/ty-i64 value)))
    ((LirI32) (Pair lt/ty-i64 (n/cast la/CSExt lt/ty-i64 value)))
    ((LirFloat) (Pair lt/ty-double (n/cast la/CFpExt lt/ty-double value)))
    (_ (Pair (lir-type l) value))))

;; The entries of a def held as the pair `{ i1 t }`: `entry` gives the tag and `entry.v` the payload, each calling the body (a
;; def's initialiser is evaluated twice; the pair is a scalar's, so this costs nothing but time).
(defun pair-entries :private (entry: str body: str inner: LirTy) -> (Vec la/LItem)
  (let ((call (n/call body [])) (wide (widened inner (n/local "p"))))
    [(entry-word entry lt/ty-i64 (n/cast la/CZExt lt/ty-i64 (n/extract call 0)))
     (la/ItDefine (f/external (f/make (str entry ".v") (some (. wide fst)) [] lt/cc-c
                                    [(f/block "entry" [(f/bound [(f/binding "p" (n/extract call 1))] [(n/ret (some (. wide snd)))])])])))]))

;; The entry `fib.defentry.K` of the body `body` of type `lt`: what `call-entry` can call. Rust: defs/jit.rs:36 (the `define` text)
(defun entry-text :private (entry: str body: str ltype: (Option LirTy)) -> (Vec la/LItem)
  (match ltype
    (nil [(la/ItDefine (f/external (f/make entry nil [] lt/cc-c [(f/block "entry" [(n/call body []) (n/ret nil)])])))] )
    ((some l)
     (match l
       ((LirOpt inner) (pair-entries entry body inner))
       (_ (let ((wide (widened l (n/call body [])))) [(entry-word entry (. wide fst) (. wide snd))]))))))

;; Calls the entry with the signature its lIR result type gives. Rust: defs/jit.rs:112 call_entry
(defun call-entry :private (j: jit/Jit entry: str lt: (Option LirTy)) -> (Result DefRaw str)
  (match (jit/jit-c-entry j entry)
    ((Err m) (Err (str-concat "def entry: " m)))
    ((Ok addr)
     (match lt
       (nil (try-let ((_a (tag-err (call/call-i64 addr []) "def entry: "))) (Ok DrUnit)))
       ((some (LirDyn)) (Err "a def holding a dyn"))
       ((some (LirOpt inner))
        (try-let ((tag (tag-err (call/call-i64 addr []) "def entry: ")) (payload (call-entry j (str-concat entry ".v") (some inner))))
          (Ok (DrOpt tag payload))))
       ((some (LirRaw)) (Err "a def holding a raw ptr"))
       ((some (LirFloat)) (try-let ((x (tag-err (call/call-f64 addr []) "def entry: "))) (Ok (DrFlt x))))
       ((some (LirDouble)) (try-let ((x (tag-err (call/call-f64 addr []) "def entry: "))) (Ok (DrFlt x))))
       ((some (LirPtr)) (try-let ((w (tag-err (call/call-i64 addr []) "def entry: "))) (Ok (DrPtr w))))
       (_ (try-let ((w (tag-err (call/call-i64 addr []) "def entry: "))) (Ok (DrInt w))))))))

;; `Err` with a prefix on its message.
(defun tag-err :private (r: (Result a str) prefix: str) -> (Result a str)
  (match r
    ((Ok v) (Ok v))
    ((Err m) (Err (str-concat prefix m)))))

;; --- the statics a value may point to ---

;; The exported getter of each static's address (`fib.defaddr.K.I`): the statics are `internal`, so a value pointing at one is
;; shared, not copied. Rust: defs/jit.rs:73 address_getters
(defun address-getters :private (k: i64 known: (Vec str)) -> (Vec la/LItem)
  (mapv (fn (i: i64) (entry-word (str "fib.defaddr." k "." i) lt/ty-ptr (n/reference (nth known i)))) (range (count known))))

;; The JIT address of each of the statics `known`, as the name it has in the module. Rust: defs/jit.rs:140 known_addresses
(defun known-addresses :private (j: jit/Jit k: i64 known: (Vec str)) -> (Result (Map i64 la/LExpr) str)
  (loop ((i 0) (names (map-empty)))
    (if (< i (count known))
        (try-let ((get (tag-err (jit/jit-c-entry j (str-join ["fib.defaddr." (str k) "." (str i)])) "def constants: "))
                  (a (tag-err (call/call-i64 get []) "def constants: ")))
          (recur (+ i 1) (assoc names a (n/reference (nth known i)))))
        (Ok names))))

;; --- the reader ---

(defun lit-text :private (l: LirTy body: str) -> str
  (str-join ["(" (lir-ty-text l) " " body ")"]))

;; The elements of the array at `a` (its elements follow the header and the length, at the stride of `el`) as value texts.
(defun read-elems :private (r: Reader d: Defs p: Program a: i64 el: LirTy elem: Ty) -> (Result (Vec (Option la/LExpr)) str)
  (let ((n (mem-i64 (+ a 16)))
        (stride (. (size-align el) fst)))
    (loop ((i 0) (out []))
      (if (< i n)
          (try-let ((raw (read-raw (+ a (+ 24 (* i stride))) el))
                    (v (reader-value r d p raw elem)))
            (recur (+ i 1) (conj out v)))
          (Ok out)))))

;; The fields of the struct, or of the variant `tag`, at `a`, one text per declared field (empty for a unit field).
(defun read-fields :private (r: Reader d: Defs p: Program a: i64 info: ObjInfo tag: (Option i64) tys: (Vec Ty)) -> (Result (Vec (Option la/LExpr)) str)
  (let ((slots (obj-slots info tag))
        (offsets (obj-offsets info tag)))
    (loop ((i 0) (slot 0) (out []))
      (if (< i (min (count tys) (count slots)))
          (match (nth slots i)
            (nil (recur (+ i 1) slot (conj out nil)))
            ((some l)
             (try-let ((raw (read-raw (+ a (nth offsets slot)) l))
                       (v (reader-value r d p raw (nth tys i))))
               (recur (+ i 1) (+ slot 1) (conj out v)))))
          (Ok out)))))

;; The constant of the struct or enum object at `a`, of type `t`.
(defun read-nominal :private (r: Reader d: Defs p: Program a: i64 t: Ty info: ObjInfo) -> (Result la/LExpr str)
  (let ((tag (match (. info kind) ((ObEnum _) (some (mem-i32 (+ a 16)))) (_ nil))))
    (try-let ((tys (field-types p t tag))
              (texts (read-fields r d p a info tag tys)))
      (defs-emit-object d p t tag texts))))

;; The constant of the array at `a`, of type `t`, its elements of lIR type `el`.
(defun read-array :private (r: Reader d: Defs p: Program a: i64 t: Ty el: LirTy) -> (Result la/LExpr str)
  (match t
    ((TCon (KArray) args)
     (try-let ((elems (read-elems r d p a el (nth args 0))))
       (defs-emit-array d p t el elems)))
    (_ (Err "an array at a non-array type"))))

;; The constant for the object at `a` that is not yet one, by the kind of the object the header says it is.
(defun read-object :private (r: Reader d: Defs p: Program a: i64 t: Ty) -> (Result la/LExpr str)
  (let ((info (objects-get (. p objects) (mem-u32 (+ a 8)))))
    (match (. info kind)
      ((ObStr) (Ok (n/reference (statics-string (. p statics) (ffi/text-at (+ a 24) (mem-i64 (+ a 16))) 0))))
      ((ObArray el) (read-array r d p a t el))
      ((ObStruct _) (read-nominal r d p a t info))
      ((ObEnum _) (read-nominal r d p a t info))
      ((ObClosure _) (Err "a def holding a closure"))
      (_ (Err "a def holding a cell, an atom, a weak reference or a task")))))

;; The constant for the object at `a`, of type `t`: null, one already made, or made now. Rust: defs/jit.rs:243 Reader::object
(defun reader-object (r: Reader d: Defs p: Program a: i64 t: Ty) -> (Result la/LExpr str)
  (if (= a 0)
      (Ok (n/null))
      (match (get @(. r names) a)
        ((some n) (Ok n))
        (nil (try-let ((name (read-object r d p a t)))
               (do (set! (. r names) (assoc @(. r names) a name))
                   (Ok name)))))))

;; A pointer where `t` is an object, or an `Option` of one: a null `Option` is `nil`, a boxed one a nil object when null (a generic
;; payload gave the plan no allocation, so the constant is the nil object either way, as the interpreter's).
(defun reader-pointer :private (r: Reader d: Defs p: Program a: i64 t: Ty) -> (Result la/LExpr str)
  (match (option-payload (program-g p) t)
    ((some payload)
     (try-let ((rep (option-rep (program-g p) payload)))
       (match rep
         ((OptNull) (if (= a 0) (Ok (n/null)) (reader-object r d p a payload)))
         ((OptValue) (Err "a def holding an Option of a scalar"))
         ((OptBoxed) (if (= a 0) (defs-emit-object d p t (some 0) []) (reader-object r d p a t))))))
    (nil (reader-object r d p a t))))

;; The lIR text of a value of type `t`: a literal, or the address of its constant. Rust: defs/jit.rs:176 Reader::value
(defun reader-value (r: Reader d: Defs p: Program raw: DefRaw t: Ty) -> (Result (Option la/LExpr) str)
  (try-let ((ltype (program-lir p t)))
    (match ltype
      (nil (Ok nil))
      ((some l)
       (match raw
         ((DrUnit) (Ok nil))
         ((DrInt value) (Ok (some (n/integer (lir-type l) value))))
         ((DrFlt value) (Ok (some (n/floating (lir-type l) (if (= value value) value (bits->f64 9221120237041090560))))))
         ((DrOpt tag payload)
          (match (option-payload (program-g p) t)
            (nil (Err "a pair where an Option of a scalar was expected"))
            ((some inner) (try-let ((value (reader-value r d p payload inner)))
                            (Ok (some (n/aggregate (into [(n/integer lt/ty-i1 tag)] (match value ((some v) [v]) (nil []))))))))))
         ((DrPtr address)
          (match l
            ((LirPtr) (try-let ((value (reader-pointer r d p address t))) (Ok (some value))))
            (_ (Err (str-join ["a pointer where " (lir-ty-text l) " was expected"]))))))))))

;; --- one def ---

;; Inside the session: adds the module, runs the runtime's initialiser, reads the statics' addresses, calls the entry and reads
;; its value. Not `fib.init`, which would also read FIB_TRACE: the objects a `def` allocates at compile time are not in the trace
;; of the run (compiler.md §4), whatever the environment says. Rust: defs/jit.rs:55-66
(defun read-in-session :private (j: jit/Jit p: Program d: Defs k: i64 m: la/LModule entry: str known: (Vec str) t: Ty lt: (Option LirTy))
    -> (Result (Option la/LExpr) str)
  (try-let ((_a (tag-err (jit/jit-add-module j (str-join ["def." (str k)]) m) (str-join ["def " (str k) ": "])))
            (init (tag-err (jit/jit-c-entry j (str-join ["fib.definit." (str k)])) (str-join ["def " (str k) ": "])))
            (_b (tag-err (call/call-i64 init []) (str-join ["def " (str k) ": "])))
            (names (known-addresses j k known))
            (raw (call-entry j entry lt)))
    (reader-value (Reader (cell names)) d p raw t)))

(defun in-session :private (p: Program d: Defs k: i64 m: la/LModule entry: str known: (Vec str) t: Ty lt: (Option LirTy)) -> (Result (Option la/LExpr) str)
  (match (jit/jit-new-fast-codegen 0)
    ((Err m) (Err (str-join ["def " (str k) ": " m])))
    ((Ok j)
     (let ((r (read-in-session j p d k m entry known t lt)))
       (do (jit/jit-free j) r)))))

;; The text of what a session adds to the module so far for def k: the entry, the runtime initialiser, the address getters.
(defun session-tail :private (k: i64 body: str entry: str ltype: (Option LirTy) known: (Vec str)) -> (Vec la/LItem)
  (into (conj (entry-text entry body ltype)
              (la/ItDefine (f/external (f/make (str "fib.definit." k) nil [] lt/cc-c
                                             [(f/block "entry" [(n/call "fib.rq-init" []) (n/ret nil)])]))))
        (address-getters k known)))

;; The module the JIT is given for def k: the module so far, then the tail, as trees (emit.defs.astmod); with FIB_AST_VERIFY set, they are
;; checked to print as the text of the module so far and the tail do.
(defun session-module :private (p: Program d: Defs k: i64 tail: (Vec la/LItem)) -> (Result la/LModule str)
  (try-let ((m (am/module-ast p d tail)))
    (if (am/verifying?)
        (try-let ((_ (am/verify-module p d tail m)))
          (Ok m))
        (Ok m))))

;; The value of def number k, whose initialiser is the body `body` of type `t`, evaluated through the JIT: the module so far with the
;; entry, the runtime initialiser and the address getters of the constants so far, in a session of its own.
(defun evaluate-def :private (p: Program defs: Defs k: i64 body: str t: Ty lt: (Option LirTy)) -> (Result DefValue str)
  (let ((entry (str-join ["fib.defentry." (str k)]))
        (known (into @(. defs constants) (statics-closure-names (. p statics)))))
    (try-let ((m (session-module p defs k (session-tail k body entry lt known)))
              (v (in-session p defs k m entry known t lt)))
      (Ok (DefValue v lt)))))

(defun record-def :private (p: Program defs: Defs d: i64 dv: DefValue) -> unit
  (do (set! (. p def-values) (assoc @(. p def-values) d dv))
      (set! (. defs values) (assoc @(. defs values) d dv))))

;; FIB_LIVE_EMIT=verify: the value kept for `body` evaluated again, into a copy of the module so far numbered so that the fresh constants
;; get the kept names, and compared as text with the kept value and items; a difference is the refusal `live/EmitVerify`.
(defun verify-replay :private (p: Program defs: Defs k: i64 body: str t: Ty lt: (Option LirTy) e: DefEntry) -> (Result unit str)
  (let ((scratch (dc/defs-copy-at defs (dc/number-before (. e items) @(. defs counter)))))
    (try-let ((fresh (evaluate-def p scratch k body t lt)))
      (let ((kept (dc/printed (. e value) (. e items)))
            (got (dc/printed fresh (vec (drop (count @(. defs items)) @(. scratch items))))))
        (if (= kept got)
            (Ok ())
            (Err (str "verify: the value the session keeps for " body " differs from its evaluation: kept " (clipped kept) " evaluated " (clipped got))))))))

;; The first 200 bytes of a text (a value's items can be a table of thousands of lines).
(defun clipped :private (text: str) -> str
  (if (> (str-len text) 200) (str (str-slice text 0 200) " ..") text))

;; The program state before a def's body is lowered (LE3): the length of `funcs` and the queue's cursor, so a cache miss can undo the
;; cheap skip-on lowering and lower again with the resident set cleared, so that the fresh JIT the value is evaluated in has the
;; resident code the body reaches (a function held as a value, a resident function called by the initialiser). A hit never pays this.
(defstruct DefSnap (funcs: i64 resident: (Set str) pending: (Vec Inst) head: i64 names: (Map Inst str)))

(defun def-snapshot :private (p: Program) -> DefSnap
  (let ((q (. p queue))) (DefSnap (count @(. p funcs)) @(. p resident) @(. q pending) @(. q head) @(. q names))))

;; `p` wound back to `s` with its resident set replaced (empty, to lower the body's reachable code; or the real set, to restore it).
(defun def-restore :private (p: Program s: DefSnap resident: (Set str)) -> unit
  (let ((q (. p queue)))
    (do (set! (. p funcs) (vec (take (. s funcs) @(. p funcs))))
        (set! (. q pending) (. s pending)) (set! (. q head) (. s head)) (set! (. q names) (. s names))
        (set! (. p resident) resident))))

;; A cache hit: the kept value's items are replayed and recorded; under `verify` the value is evaluated again and compared.
(defun replay-def :private (p: Program c: DefCache defs: Defs k: i64 d: i64 body: str t: Ty lt: (Option LirTy) e: DefEntry) -> (Result unit str)
  (try-let ((_v (if (= (live-emit-mode) "verify") (verify-replay p defs k body t lt e) (Ok ())))
            (_r (dc/cache-replay defs (. e items))))
    (do (dc/cache-numbered c @(. defs counter))
        (Ok (record-def p defs d (. e value))))))

;; A cache miss: the skip-on lowering is wound back and the body lowered again with the resident set cleared, so the body's reachable
;; resident code is in the program and so in the fresh JIT the value is evaluated in; then the value is evaluated and kept.
(defun miss-def :private (p: Program c: DefCache defs: Defs k: i64 d: i64 t: Ty lt: (Option LirTy) snap: DefSnap source: str) -> (Result unit str)
  (do (def-restore p snap (set-empty))
      (let ((body (program-request p (BodyDef d) [])))
        (try-let ((_a (emit-all p))
                  (_r (Ok (set! (. p resident) (. snap resident))))
                  (n0 (Ok (count @(. defs items))))
                  (dv (evaluate-def p defs k body t lt)))
          (do (dc/cache-store c body source dv (vec (drop n0 @(. defs items))))
              (dc/cache-numbered c @(. defs counter))
              (Ok (record-def p defs d dv)))))))

;; A def of a live session's program (emit.program `DefCache`, emit.defs.cache): the value the session keeps for this definition is
;; replayed; else it is evaluated (with the resident code it reaches lowered, LE3) and kept.
(defun cached-def :private (p: Program c: DefCache defs: Defs k: i64 d: i64 t: Ty lt: (Option LirTy) snap: DefSnap body: str) -> (Result unit str)
  (let ((source (dc/def-source p body)))
    (match (dc/cache-lookup c body source)
      ((some e) (replay-def p c defs k d body t lt e))
      (nil (miss-def p c defs k d t lt snap source)))))

;; Evaluates the initialiser of def number k (`d`, a constant) and records its value for the ones after (syntax §3.19); in a live
;; session, replays the value the session keeps for it (`cached-def`). The body is lowered first either way: the statics it names must
;; exist in this program. Rust: defs/jit.rs:25-69, the body of the loop of `emit_defs`
(defun emit-def (p: Program defs: Defs k: i64 d: i64) -> (Result unit str)
  (match (get (. (. p typed) def-types) d)
    (nil (Err "a def without a type"))
    ((some t)
     ;; Under verify every def is evaluated again (a hit's value is checked against a fresh evaluation), so lower the body's reachable
     ;; resident code now (the resident set cleared), as a miss does; otherwise skip resident and only a miss pays to re-lower.
     (let ((snap (def-snapshot p))
           (_v (when (= (live-emit-mode) "verify") (set! (. p resident) (set-empty))))
           (body (program-request p (BodyDef d) [])))
       (try-let ((_a (emit-all p))
                 (_r (Ok (set! (. p resident) (. snap resident))))
                 (lt (program-lir p t)))
         (match (. p def-cache)
           (nil (try-let ((dv (evaluate-def p defs k body t lt))) (Ok (record-def p defs d dv))))
           ((some c) (cached-def p c defs k d t lt snap body))))))))
