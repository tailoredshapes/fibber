;; Constant-evaluation sessions receive generated nodes directly. Parsing here is
;; restricted to the optional printer round-trip check, never session assembly.
(ns emit.defs.astmod
  (:require [lir.parse :as parse] [lir.print :as print] [fib.unix :as unix] [fib.string :as s])
  (:use lir.ast lir.diag emit.program emit.defs.data)
  (:require [emit.assemble :as assembly]))

(defun module-ast (p: Program d: Defs tail: (Vec LItem)) -> (Result LModule str)
  (let ((parts (assembly/module-parts-with (. p runtime-host) p @(. d items))))
    (let ((items (if (= (unix/getenv "FIB_AST_VERIFY") (some "fault"))
                    (assembly/parts-items (assembly/Parts [] (. parts externs) (. parts types) (. parts statics)
                                                       (. parts keywords) (. parts defs) (. parts quotes) (. parts fns) (. parts links)))
                    (assembly/parts-items parts))))
      (Ok (LModule (into items tail))))))

(defun verifying? () -> bool (some? (unix/getenv "FIB_AST_VERIFY")))

(defun verify-module (p: Program d: Defs tail: (Vec LItem) m: LModule) -> (Result unit str)
  (let ((text (str (assembly/assemble-parts p @(. d items)) (print/print-module (LModule tail)))))
    (match (parse/parse-source text)
      ((Err e) (Err (str "FIB_AST_VERIFY: the text does not read: " (diag-str e))))
      ((Ok whole)
       (if (= (print/print-module m) (print/print-module whole))
           (Ok ())
           (Err "FIB_AST_VERIFY: the generated trees differ from the printed module"))))))
