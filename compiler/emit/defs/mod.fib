;; compiler/emit/defs/mod.fib: the values of `def`s, computed at compile time by running their initialisers through the JIT (spec/compiler.md §5).
;; Replaces crates/fibc/src/defs/mod.rs and defs/jit.rs (defs/interp.rs, the non-llvm backend, stays Rust: stage 2 has only the JIT).
;; `Defs`, the constants' text and `def-ids` are emit.defs.data's (exported again here, so `:use emit.defs.mod` still sees them); the
;; reading of the JIT's memory (`Reader`, the address getters, the entry) and the loop's body `emit-def` are emit.defs.jit's.
;; A tool that uses this module is built linked to liblair: `fibc build compiler/emit.fib -I compiler -I lib -L DIR -l lair -o OUT`.
(ns emit.defs.mod
  (:use emit.program emit.defs.jit)
  (:export-from emit.defs.data))

;; Evaluates every constant `def` of the user module through the JIT and serialises its value, in source order, each seeing the
;; constants of the ones before it. Rust: defs/mod.rs:37, defs/jit.rs:23 emit_defs
(defun emit-defs (p: Program) -> (Result Defs str)
  (let ((defs (defs-new))
        (ids (def-ids p)))
    (loop ((k 0))
      (if (< k (count ids))
          (try-let ((_a (emit-def p defs k (nth ids k))))
            (recur (+ k 1)))
          (Ok defs)))))
