;; compiler/emit/defs/mod.fib: the values of `def`s, computed at compile time by running their initialisers through the JIT (spec/compiler.md §5).
;; Replaces crates/fibc/src/defs/mod.rs and defs/jit.rs (defs/interp.rs, the non-llvm backend, stays Rust);
;; `emit_defs` is one function here: mod.rs:37 dispatches to the backend, jit.rs:23 is the JIT one, and the reading of
;; the JIT's memory (`Raw`, `Reader`, the address getters, jit.rs:88-310) is E10's, in emit/defs/jit.fib.
;; STATUS: every public function below is a STUB of package E10, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/defs/mod.rs + defs/jit.rs, 136 + 310 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.defs.mod
  (:use types.ty types.decls emit.value emit.program))

;; The text, values and constants of the defs. Rust: defs/mod.rs:28 Defs
(defstruct Defs (text: (Cell str) values: (Cell (Map i64 DefValue)) constants: (Cell (Vec str)) counter: (Cell i64)))

;; Rust: defs/mod.rs:37, defs/jit.rs:23
(defun emit-defs (p: Program) -> (Result Defs str)
  (trap "todo: E10 emit-defs"))

;; Rust: defs/mod.rs:49
(defun def-ids (p: Program) -> (Vec i64)
  (trap "todo: E10 def-ids"))

;; Rust: defs/mod.rs:62 Defs::emit_array
(defun defs-emit-array (d: Defs p: Program t: Ty el: LirTy elems: (Vec str)) -> (Result str str)
  (trap "todo: E10 defs-emit-array"))

;; Rust: defs/mod.rs:85 Defs::emit_object
(defun defs-emit-object (d: Defs p: Program t: Ty tag: (Option i64) fields: (Vec str)) -> (Result str str)
  (trap "todo: E10 defs-emit-object"))

;; Rust: defs/mod.rs:118
(defun field-types (p: Program t: Ty tag: (Option i64)) -> (Result (Vec Ty) str)
  (trap "todo: E10 field-types"))
