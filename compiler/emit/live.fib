;; compiler/emit/live.fib: live mode's stubs and slots (docs/design/live-repl.md 3.1, package LV0). In a program compiled with
;; `fibc run --live` (FIB_LIVE; emit.program `live-mode?`) every body of the program's own modules (a function, its all-owned twin, a
;; method of its impls; never the library's, the prelude's or a macro module's) is lowered under a generation name, `NAME.g0`, and the
;; name every caller, closure constant and vtable uses, `NAME`, is a stub: it loads the current generation's address from the slot
;; `live.NAME` (a global holding `@NAME.g0`) with an acquire load and tail-jumps to it. A later generation (LV2) stores the address of
;; `NAME.gK` into the slot with a release store: the callers follow without being touched, and a caller that loaded the old address runs
;; the old body, which stays mapped. The stub is a `tailcall`, so it adds no frame: a recursion a million deep (cases/ownership 53 and
;; 164) is as deep as without it. Where the result could be returned in memory (spec/lir.md 7.3 rule 5: more than two leaves) the
;; checker refuses a tail call, and the stub is a call and a return instead.
;; The closure literals of a generation carry its name (`l.NAME.g0.N`, emit.names `closure-name` over the code name), so a later
;; generation's literals are its own and a heap closure made by an old body keeps naming old code.
;; A session (LV2, serve.liveswap) names the generation each FAMILY of bodies is lowered under (`Program.live-gens`: a function, its
;; all-owned twin and its specialisations are one family, named `f.NAME`; a method's family is its own name) and reads which stubbed
;; bodies a program made (`Program.live-bodies`, registered by `add-stub`), so that a swap emits a family under its next generation and
;; cuts exactly its bodies out.
(ns emit.live
  (:require [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f] [emit.mono :as mono])
  (:use types.ty types.decls types.table types.display own.program emit.program emit.statics emit.names))

;; The runtime a live program keeps whether or not it reaches them (emit.prune, emit.compile `finished`): what the session's attach
;; thread asks of it (`fib_live_ctl`: the pause and the quiescence of rt/live.lir, package LV3) and the release store of a swap.
;; A redefinition of a `def` (LT4, serve.livedefs) shares the new value (`fib.share`) and drops the old one (`fib.flags`, `fib.release`).
(def runtime-roots: (Vec str) ["fib_live_ctl" "fib.live-patch" "fib.share" "fib.flags" "fib.release"])

;; `live.NAME`: the slot the stub of NAME loads.
(defun slot-name (name: str) -> str (str "live." name))

;; The modules whose bodies are live, by name, when the program is compiled in a project (docs/design/live-meshql.md 4, package LT3), a
;; field of the program's `Globals` (`live-modules`): the driver (driver.front `note-live-modules`) sets it from FIB_LIVE_ROOTS, which
;; `fibc` fills in a project with its own roots (`deps.fib` :paths, with `test` its test paths) and, under `--live-deps` (FIB_LIVE_DEPS),
;; the libraries' (pkg.modules `live-roots`), so that a dependency's code stays a direct call unless asked for. `nil` (outside a project,
;; or a session that never set it) is the name rule (emit.program `program-module?`): every module not named `fib.*` is the program's.
(defun set-live-modules (g: Globals names: (Option (Set str))) -> unit
  (set! (. g live-modules) names))

;; The specialisation's types as the printer wrote them (LE3): a swap reads them back to re-request a registered generic body.
(defun tys-text :private (g: Globals inst: mono/Inst) -> (Vec str)
  (mapv (fn (t: Ty) (printer-ty (printer-new g) t)) (. inst tys)))

;; The record of a stubbed body for the session (emit.program `LiveBody`): the function's name and its module (nil for the main
;; module's), so a session can ask for its body by name, the all-owned flag, whether it is a specialisation, a method's `impl` key,
;; and the specialisation's types as text (LE3).
(defun live-body :private (g: Globals inst: mono/Inst name: str) -> LiveBody
  (let ((generic (not (empty? (. inst tys)))) (tt (tys-text g inst)))
    (match (. inst key)
      ((BodyFun fid) (LiveBody name (some (. (g-fun g fid) name)) false generic nil tt (fun-module g fid)))
      ((BodyAllOwned fid) (LiveBody name (some (. (g-fun g fid) name)) true generic nil tt (fun-module g fid)))
      ((BodyMethod i _) (LiveBody name nil false generic (some (impl-key g i)) tt nil))
      ((BodyMethodOwned i _) (LiveBody name nil true generic (some (impl-key g i)) tt nil))
      ((BodyDef _) (LiveBody name nil false generic nil tt nil)))))

;; The module of a function by name, nil for the main module's (whose bodies are asked for by the bare name).
(defun fun-module :private (g: Globals fid: i64) -> (Option str)
  (let ((d (g-fun g fid))) (if (= (. d module) @(. g main)) nil (some (g-module-name g (. d module))))))

;; `impl:PROTO HEAD`, as serve.replcore keys an `impl` form: the protocol's name and the head type printed with the instance's own
;; variable names (`(Vec a)`), which is the form's own text when it was written so.
(defun impl-key (g: Globals i: i64) -> str
  (let ((inst (table-get (. g instances) i)))
    (str "impl:" (. (g-proto g (. inst proto)) name) " " (printer-ty (printer-with-names g (. inst var-names) []) (. inst head)))))

(defun register-body :private (p: Program family: str body: LiveBody) -> unit
  (let ((have (unwrap-or (get @(. p live-bodies) family) [])))
    (when (not-any? (fn (b: LiveBody) (= (. b name) (. body name))) have)
      (set! (. p live-bodies) (assoc @(. p live-bodies) family (conj have body))))))

;; How many scalars or vectors a result holds, structs and arrays flattened; a named struct counts as too many (its fields are not known
;; here), a vector wider than 512 bits too.
(defun leaves :private (t: lt/LType) -> i64
  (match t
    ((lt/TAnon fs) (reduce (fn (acc: i64 x: lt/LType) (+ acc (leaves x))) 0 fs))
    ((lt/TArray k e) (* k (leaves e)))
    ((lt/TNamed _) 3)
    ((lt/TVector _ _) (if (> (unwrap-or (lt/type-bits t) 0) 512) 3 1))
    (_ 1)))

;; Whether the stub can tail-jump (spec/lir.md 7.3 rule 5); else it calls and returns.
(defun tail-jump? :private (ty: lt/LFnType) -> bool
  (match (. ty ret) (nil true) ((some r) (<= (leaves r) 2))))

;; The current generation's address: an acquire load of the slot (the swap's store is a release store, so the code the address names
;; is complete when the load sees it).
(defun slot-load :private (slot: str) -> la/LExpr
  (n/node (la/KAtomicLoad la/ScSystem la/OAcquire lt/ty-ptr (n/global slot))))

(defun stub-body :private (ty: lt/LFnType args: (Vec la/LExpr)) -> (Vec la/LExpr)
  (if (tail-jump? ty)
      [(n/indirect-call (n/local "at") ty args true)]
      (match (. ty ret)
        (nil [(n/indirect-call (n/local "at") ty args false) (n/ret nil)])
        ((some _) [(f/bound [(f/binding "r" (n/indirect-call (n/local "at") ty args false))] [(n/ret (some (n/local "r")))])]))))

;; The stub `name` of the body `body`: the body's type, convention and parameter names, one block.
(defun stub-function (name: str body: la/LFunction) -> la/LFunction
  (let ((args (mapv (fn (q: la/LParam) (n/local (. q name))) (. body params))))
    (la/LFunction name (. body ty) (. body params)
                  [(f/block "entry" [(f/bound [(f/binding "at" (slot-load (slot-name name)))] (stub-body (. body ty) args))])]
                  (la/LModifiers la/lk-internal false false false false) 0)))

;; The slot of `name`, holding generation 0's address.
(defun slot-item :private (name: str body: la/LFunction) -> la/LItem
  (la/ItGlobal (la/LGlobalDef (slot-name name) lt/ty-ptr (n/global (. body name)) false (la/LModifiers la/lk-internal false false false false) 0 false)))

;; The function `code` of the program: the last one added, in the ordinary course.
(defun function-named :private (p: Program code: str) -> (Option la/LFunction)
  (let ((fs @(. p funcs)))
    (loop ((i (- (count fs) 1)))
      (cond (< i 0) nil
            (= (. (nth fs i) name) code) (some (nth fs i))
            :else (recur (- i 1))))))

;; Adds the stub `name` and its slot for the body of `inst` lowered under `code`, once the body is in the program, and registers the
;; body with its family for the session.
(defun add-stub (p: Program inst: mono/Inst name: str code: str) -> (Result unit str)
  (match (function-named p code)
    (nil (Err (str "live: no body " code " to stub")))
    ((some body)
     (do (statics-item (. p statics) (slot-name name) (slot-item name body))
         (program-add-function p (stub-function name body))
         (register-body p (family-name (program-g p) (. inst key)) (live-body (program-g p) inst name))
         (Ok ())))))
