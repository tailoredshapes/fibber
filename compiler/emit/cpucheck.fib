;; compiler/emit/cpucheck.fib: the start-up CPU check of an x86-64 executable (docs/adr/0008). A binary built for x86-64-v3 (AVX2, FMA, BMI1/2, F16C,
;; LZCNT, MOVBE) dies of SIGILL on an older CPU at the first instruction it lacks, wherever that is. Instead `main` first calls `fib.cpu-check`, which
;; asks glibc which features are active (`__x86_get_cpuid_feature_leaf`, glibc 2.33 and later: CPUID with the OS's register-state support folded in, the
;; `active` words of sys/platform/x86.h) and, when one the binary was built for is missing, writes
;;   trap: this program needs x86-64-v3 (AVX2, FMA); this CPU lacks: AVX2, FMA
;; and aborts (status 134, as a trap). The cost is one call at start; nothing after it. The check uses no vector code and no memcpy (written piece by
;; piece with `write`), so it runs on the CPU it refuses.
;; What is required comes from the target the binary is built for (the module's target, lir.target): a named CPU's level (x86-64-v2, -v3, -v4 and the
;; CPU names of lir.targets' table), else the host's feature list (`+avx2,+fma,..`) intersected with the features below. x86-64 itself, a CPU the table
;; does not know, any other architecture and any OS but Linux (glibc) get no check: aarch64 has FMA in its baseline, and a build for a CPU with more
;; (FIB_TARGET_CPU=apple-m2, say) is not checked there (docs/adr/0008, Consequences).
(ns emit.cpucheck (:use lir.target lir.targets) (:require [expand.targetos :as tos] [lir.ast :as la] [lir.types :as lt]
    [emit.node :as n] [emit.function :as f] [lir.print :as print]))

;; A feature: LLVM's name, the name the message shows, and where glibc keeps its active bit: leaf (0 is CPUID 1, 1 is CPUID 7, 2 is CPUID 0x80000001,
;; glibc's CPUID_INDEX_*), register (0 eax, 1 ebx, 2 ecx, 3 edx) and bit.
(defstruct CpuFeature (name: str shown: str leaf: i64 reg: i64 bit: i64))
(derive Eq CpuFeature)

(defun cpu-features () -> (Vec CpuFeature)
  [(CpuFeature "avx2" "AVX2" 1 1 5) (CpuFeature "fma" "FMA" 0 2 12) (CpuFeature "avx512f" "AVX512F" 1 1 16)
   (CpuFeature "avx512bw" "AVX512BW" 1 1 30) (CpuFeature "avx512cd" "AVX512CD" 1 1 28) (CpuFeature "avx512dq" "AVX512DQ" 1 1 17)
   (CpuFeature "avx512vl" "AVX512VL" 1 1 31) (CpuFeature "avx" "AVX" 0 2 28) (CpuFeature "bmi" "BMI1" 1 1 3) (CpuFeature "bmi2" "BMI2" 1 1 8)
   (CpuFeature "f16c" "F16C" 0 2 29) (CpuFeature "lzcnt" "LZCNT" 2 2 5) (CpuFeature "movbe" "MOVBE" 0 2 22) (CpuFeature "sse3" "SSE3" 0 2 0)
   (CpuFeature "ssse3" "SSSE3" 0 2 9) (CpuFeature "sse4.1" "SSE4.1" 0 2 19) (CpuFeature "sse4.2" "SSE4.2" 0 2 20) (CpuFeature "popcnt" "POPCNT" 0 2 23)
   (CpuFeature "cx16" "CX16" 0 2 13)])

(defun level-v2 :private () -> (Vec str) ["sse3" "ssse3" "sse4.1" "sse4.2" "popcnt" "cx16"])
(defun level-v3 :private () -> (Vec str) (into (level-v2) ["avx" "avx2" "bmi" "bmi2" "f16c" "fma" "lzcnt" "movbe"]))
(defun level-v4 :private () -> (Vec str) (into (level-v3) ["avx512f" "avx512bw" "avx512cd" "avx512dq" "avx512vl"]))

;; The CPUs of lir.targets' x86 table that have AVX-512 (the rest of the table is x86-64-v3).
(defun avx512-cpu? :private (cpu: str) -> bool
  (contains? (set ["x86-64-v4" "skylake-avx512" "skx" "cascadelake" "cooperlake" "cannonlake" "icelake-client" "icelake-server" "tigerlake"
                   "rocketlake" "sapphirerapids" "graniterapids" "znver4" "znver5"]) cpu))

(defun x86-cpu? :private (cpu: str) -> bool
  (or (starts-with? cpu "x86-64") (match (cpu-row cpu) ((some r) (= (. r family) "x86")) (nil false))))

(defun split-commas :private (s: str) -> (Vec str)
  (loop ((i 0) (from 0) (out []))
    (cond (>= i (str-len s)) (if (> i from) (conj out (str-slice s from i)) out)
          (= (str-byte-at s i) 44i8) (recur (+ i 1) (+ i 1) (if (> i from) (conj out (str-slice s from i)) out))
          :else (recur (+ i 1) from out))))

;; The LLVM names a target asks for: the `+name`s of its feature list, else its named CPU's level.
(defun wanted-names (t: Target) -> (Vec str)
  (cond (not (= (. t features) "")) (mapv (fn (f: str) (str-slice f 1 (str-len f))) (filterv (fn (f: str) (starts-with? f "+")) (split-commas (. t features))))
        (= (. t cpu) "x86-64-v2") (level-v2)
        (avx512-cpu? (. t cpu)) (level-v4)
        (x86-cpu? (. t cpu)) (if (= (. t cpu) "x86-64") [] (level-v3))
        :else []))

;; The features the check requires of the CPU: the checkable ones the target asks for, in the table's order.
(defun required-features (t: Target) -> (Vec CpuFeature)
  (let ((want (set (wanted-names t))))
    (filterv (fn (f: CpuFeature) (contains? want (. f name))) (cpu-features))))

;; Whether the target is x86-64 Linux: FIB_TARGET_TRIPLE's arch and OS, else the host's OS and an x86 CPU or feature list.
(defun x86-linux? (t: Target) -> bool
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    ((some tr) (if (or (= tr "") (= tr "host")) (host-x86-linux? t) (and (= (arch-of-triple tr) "x86_64") (= (os-of-triple tr) "linux"))))
    (nil (host-x86-linux? t))))

(defun host-x86-linux? :private (t: Target) -> bool
  (and (= (tos/host-platform-name) "Linux")
       (or (x86-cpu? (. t cpu)) (some? (str-find (str-join ["," (. t features) ","]) ",+sse2," 0)))))

;; The few features the message names after the CPU: AVX-512F, AVX2 and FMA when required, else all of them.
(defun headline (fs: (Vec CpuFeature)) -> str
  (let ((top (filterv (fn (f: CpuFeature) (contains? (set ["avx512f" "avx2" "fma"]) (. f name))) fs)))
    (reduce (fn (acc: str f: CpuFeature) (if (= acc "") (. f shown) (str-join [acc ", " (. f shown)]))) "" (if (empty? top) fs top))))

;; The text of the message up to the first missing feature.
(defun message-head (t: Target fs: (Vec CpuFeature)) -> str
  (str-join ["trap: this program needs " (. t cpu) " (" (headline fs) "); this CPU lacks: "]))

;; ---- the lIR

;; The mask of bit `b` of an i32, as lIR writes the constant (bit 31 is the sign).
(defun bit-mask :private (b: i64) -> i64
  (if (= b 31) -2147483648 (shl 1 b)))

;; The test of feature `k` (block `cK`): its active word, the bit, on to `mK` when it is clear, else to the next test.
(defun test-block :private (k: i64 feature: CpuFeature) -> (Vec la/LBlock)
  (let ((leaf (str "l" k)) (word (str "w" k)) (next (str "c" (+ k 1))))
    [(f/block (str "c" k)
       [(f/bound [(f/binding leaf (n/call "__x86_get_cpuid_feature_leaf" [(n/integer lt/ty-i32 (. feature leaf))]))
                  (f/binding word (n/load lt/ty-i32 (n/gep lt/ty-i8 (n/local leaf) [(n/integer lt/ty-i64 (+ 16 (* 4 (. feature reg))))]) nil))]
                 [(n/conditional (n/compare-int la/IEq (n/binary la/BAnd (n/local word) (n/integer lt/ty-i32 (bit-mask (. feature bit))))
                                                      (n/integer lt/ty-i32 0)) (str "m" k) next)])])
     (f/block (str "m" k) [(n/call "fib.cpu-lacks" [(n/local "first") (n/string (. feature shown)) (n/integer lt/ty-i64 (str-len (. feature shown)))])
                            (n/branch next)])]))

;; `fib.cpu-check` and its helper for the target `t`, or "" when the target gets no check.
(defun cpu-check-items (t: Target) -> (Vec la/LItem)
  (let ((features (required-features t)))
    (if (or (empty? features) (not (x86-linux? t))) []
        (let ((head (message-head t features)))
          [(la/ItDeclare (la/LDeclare "__x86_get_cpuid_feature_leaf" (lt/LFnType lt/cc-c (some lt/ty-ptr) [lt/ty-i32] false) false 0))
           (cpu-lacks-item head)
           (la/ItDefine (f/make "fib.cpu-check" nil [] lt/cc-c
             (into (into [(f/block "entry" [(f/bound [(f/binding "first" (n/alloca lt/ty-i64))]
                          [(n/store (n/integer lt/ty-i64 0) (n/local "first") nil) (n/branch "c0")])])]
                         (vec (mapcat (fn (k: i64) (test-block k (nth features k))) (range (count features)))))
                   [(f/block (str "c" (count features)) [(n/conditional (n/compare-int la/IEq (n/load lt/ty-i64 (n/local "first") nil) (n/integer lt/ty-i64 0)) "fine" "missing")])
                    (f/block "fine" [(n/ret nil)])
                    (f/block "missing" [(n/call "write" [(n/integer lt/ty-i32 2) (n/string "\n") (n/integer lt/ty-i64 1)])
                                         (n/call "abort" []) (n/unreachable)])])))]))))

(defun cpu-lacks-item :private (head: str) -> la/LItem
  (la/ItDefine (f/make "fib.cpu-lacks" nil [(Pair "first" lt/ty-ptr) (Pair "name" lt/ty-ptr) (Pair "n" lt/ty-i64)] lt/cc-c
    [(f/block "entry" [(n/conditional (n/compare-int la/IEq (n/load lt/ty-i64 (n/local "first") nil) (n/integer lt/ty-i64 0)) "head" "more")])
     (f/block "head" [(n/call "write" [(n/integer lt/ty-i32 2) (n/string head) (n/integer lt/ty-i64 (str-len head))])
                       (n/store (n/integer lt/ty-i64 1) (n/local "first") nil) (n/branch "put")])
     (f/block "more" [(n/call "write" [(n/integer lt/ty-i32 2) (n/string ", ") (n/integer lt/ty-i64 2)]) (n/branch "put")])
     (f/block "put" [(n/call "write" [(n/integer lt/ty-i32 2) (n/local "name") (n/local "n")]) (n/ret nil)])])))

(defun cpu-check-defs (t: Target) -> str
  (print/print-module (la/LModule (cpu-check-items t))))

;; The first statement of an executable's `main` when the target has a check.
(defun cpu-check-code (t: Target) -> (Vec la/LExpr)
  (if (or (empty? (required-features t)) (not (x86-linux? t))) [] [(n/call "fib.cpu-check" [])]))

(defun cpu-check-call (t: Target) -> str
  (if (empty? (cpu-check-code t)) "" "(CALL (GLOBAL fib.cpu-check))\n    "))
