;; compiler/emit/compile.fib: the driver of the emission: `compile` and `compile-module` (spec/compiler.md §2, types §8): the runtime, the
;; type table, the static data, every specialised body reached from `main`, and lIR's `main`. Replaces crates/fibc/src/compile.rs. `compile`
;; takes the two parts of the Rust `Checked`; `Unsupported(String)` is the `str` of a `(Result a str)`.
;; Where the rest of compile.rs went: RUNTIME and `runtime_declaration` are emit.rt's (over the generated emit.runtime), `emit_all`, `Parts`,
;; `Module`, `module_parts` and `assemble_parts` are emit.assemble's (emit.defs.mod needs them), the init functions of inits.rs are emit.inits.
;; `compile-module` does not fail at a stub (an error message starting `todo: `, package E4 and later): the `Module` it returns has `pending`
;; set and holds what needs no body, the runtime and `main`.
;; `compile-macro` (E11) is the macro-time module of one `defmacro` (macros/abi.rs's text is emit.macros.abi's).
(ns emit.compile
  (:require [fib.string :as s] [emit.defs.astmod :as am] [emit.cpucheck :as cc] [emit.wasi :as wasi] [expand.targetos :as tos] [types.targets :as tt])
  (:use types.ty types.table types.decls types.init types.program own.program emit.value emit.names emit.objects emit.statics emit.program emit.inits
        emit.assemble emit.defs.mod emit.lower.cx emit.lower.mod emit.macros.abi types.target))

;; The text of a macro module. Rust: compile.rs:88 MacroModule
(defstruct MacroModule (text: str))

;; With FIB_RESULT_STDOUT=1 an executable prints its result as `fibc run` does and exits 0, instead of returning it as the status (a status keeps 8 bits): the harness of a target
;; that cannot run the case under `fibc run` (compiler/tests/wasm/suite.py) reads the result from standard output.
;; The fixed end of a module: `main`, which §8.8 has join every thread still running before the result is printed (fibc run) or
;; returned (an executable), calling the program's entry function. Rust: compile.rs:296 main_text
(defun main-text :private (entry: str executable: bool init: str check: str uw: bool) -> str
  (let ((end (if (and executable (not (= (sys-getenv "FIB_RESULT_STDOUT") (some "1"))))
                 "(ret (trunc i32 r))"
                 "(call @printf (string \"%lld\\n\") r)\n      (ret (i32 0))")))
    (str-join ["(declare printf i32 (ptr ...))\n(global internal fib.main-r i64 (i64 0))\n"
               ;; The program runs from `fib.main-body` on the main stack that `fib.run-main` makes (docs/design/stack.md): the initialisers of the `def`s and the entry.
               "(define internal (fib.main-body void) ()\n  (block entry\n    " init "\n    (let ((r " (if uw (str-join ["(extractvalue (call @" entry ") 0)"]) (str-join ["(call @" entry ")"]))
               "))\n      (store r @fib.main-r)\n      (ret))))\n"
               "(define (main i32) ((i32 argc) (ptr argv))\n  (block entry\n    " check "(call @fib.init)\n"
               "    (call @fib.set-args argc argv)\n    (call @fib.run-main @fib.main-body)\n    (let ((r (load i64 @fib.main-r)))\n      (call @fib.join-all)\n"
               "      (call @fib.pool-quiesce)\n      " end ")))\n"])))

;; The constant `def`s are made by `emit-defs`, which runs each through the JIT; a program with none has no defs to make (the Rust
;; `emit_defs` loops over none and returns the empty `Defs`), so it never reaches that package.
(defun make-defs :private (p: Program) -> (Result Defs str)
  (if (empty? (filter (fn (d: i64) (. (g-def (program-g p) d) constant)) (all-def-ids p)))
      (Ok (defs-new))
      (emit-defs p)))

;; The constant `def`s of a program for a target whose pointers are not the host's: they are evaluated by the JIT, which runs on the host, so the program is
;; laid out and lowered for the host while it makes them, and the constants come back as text (struct constants: LLVM lays them out for the target). The program
;; the rest is lowered for is a fresh one at the target's pointer width (`program-rebuilt`: the bodies, closures and vtables the JIT's pass made are lowered again).
(defun make-defs-at :private (p: Program) -> (Result (Pair Program Defs) str)
  (let ((pb (program-pb p)))
    (if (or (= pb 8) (empty? (filter (fn (d: i64) (. (g-def (program-g p) d) constant)) (all-def-ids p))))
        (try-let ((d (make-defs p))) (Ok (Pair p d)))
        (do (set! (. p pb) 8)
            (try-let ((d (emit-defs p)))
              (Ok (Pair (program-rebuilt p pb) d)))))))

;; The `main` section: the init functions, then `main` calling the entry. Nothing in it depends on a body being emitted. An executable for x86-64
;; Linux first checks that the CPU has what it was built for (emit.cpucheck, docs/adr/0008).
(defun main-part :private (p: Program entry: str executable: bool) -> str
  ;; §3.19, L15: the init functions of the `def`s made at run time come before `main`, which calls them after the arguments are known.
  (let ((check (match (if executable @(. (program-g p) target) nil)
                 (nil (Pair "" ""))
                 ((some t) (Pair (cc/cpu-check-defs t) (cc/cpu-check-call t))))))
    (str-join [(inits-render p) (. check fst) (main-text entry executable (if (empty? @(. p inits)) "" "(call @fib.defs-init)") (. check snd)
                                    (and (. p unwinding) (not @(. p macro-module))))])))

;; A stub reached is an error whose message starts `todo: `: the module is then pending, with what needs no body.
(defun pending-or-error :private (p: Program entry: str executable: bool m: str) -> (Result Module str)
  (if (starts-with? m "todo: ")
      (Ok (Module (parts-pending) (main-part p entry executable) (some m)))
      (Err m)))

;; With FIB_AST_VERIFY set, the module as trees (emit.defs.astmod) must print as the text of the module does.
(defun verified :private (p: Program defs: Defs m: Module) -> (Result Module str)
  (if (am/verifying?)
      (try-let ((ast (am/module-ast p defs (. m main)))
                (_ (am/verify-module p defs (. m main) ast)))
        (Ok m))
      (Ok m)))

;; The Module of a program that has a `main`, planned, with its defs made and its entry requested. Rust: compile.rs:60 compile_module
;; The entry's name is the same whenever it is requested (names carry no counter): a module that stops at the defs knows it.
(defun compile-module (typed: TypedProgram owned: OwnedProgram executable: bool) -> (Result Module str)
  (match (program-fun typed "main")
    (nil (Err "the program has no main"))
    ((some main)
     (let ((p (emit.program/program-new typed owned)))
       (try-let ((_ (inits-plan p)))
         (match (make-defs-at p)
           ((Err m) (pending-or-error p (body-name (program-g p) (BodyFun main) []) executable m))
           ((Ok [q defs])
            (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
                (inits-request q)
                (host-kernel-table q)
                (let ((entry (program-request q (BodyFun main) [])))
                  (match (emit-all q)
                    ((Ok _) (verified q defs (Module (module-parts q @(. defs text)) (main-part q entry executable) nil)))
                    ((Err m) (pending-or-error q entry executable m))))))))))))

;; The module's `(target (cpu ..) (features ..))` form (spec/lir.md 4.5) for the target the front end was told: the CPU the checker chose its lane
;; counts for, so that `lair` builds for the CPU the program was checked against. Nothing when the checker was told none (its unit tests).
(defun target-form :private (typed: TypedProgram) -> str
  (match @(. (. typed globals) target)
    (nil "")
    ((some t) (str-join ["(target (cpu \"" (. t cpu) "\")" (if (= (. t features) "") "" (str-join [" (features \"" (. t features) "\")"])) ")\n"]))))

;; --- exported functions (docs/design/wasm.md 5): `fibc build --export NAME[=SYMBOL]` makes the function NAME of the program a symbol of the object that the host can call,
;; with the C convention and scalar or raw pointer arguments. There is no `main`: the module is a library, its runtime starts on the first call (`fib.export-ready`).
(defun export-specs () -> (Vec (Pair str str))
  (match (sys-getenv "FIB_EXPORTS")
    (nil [])
    ((some t)
     (vec (mapv (fn (w: str) (match (str-find w "=" 0)
                               ((some i) (Pair (str-slice w (+ i 1) (str-len w)) (str-slice w 0 i)))
                               (nil (Pair w w))))
                (filter (fn (w: str) (not (= w ""))) (s/split t ",")))))))

;; The header of the lowered body `name`: its result type and the parameters `((T n) ..)`, from the text of the function. Only a function that is not generic, takes no
;; hidden slot (a program that catches returns a failure next to the value) and has a scalar or raw pointer for each of them can be exported.
(defun export-header :private (p: Program name: str) -> (Result (Pair str str) str)
  (let ((prefix (str-join ["(define internal tailcc (" name " "])))
    (match (first (filter (fn (f: str) (starts-with? f prefix)) @(. p funcs)))
      (nil (Err (str-join ["export: no code for " name])))
      ((some f)
       (let ((line (match (str-find f "\n" 0) ((some i) (str-slice f 0 i)) (nil f)))
             (from (str-len prefix)))
         (match (str-find line ") (" from)
           (nil (Err (str-join ["export: cannot read the signature of " name])))
           ((some i) (Ok (Pair (str-slice line from i) (str-slice line (+ i 2) (- (str-len line) 0)))))))))))

(defun scalar-word? :private (w: str) -> bool
  (some? (first (filter (fn (x: str) (= x w)) ["i1" "i8" "i16" "i32" "i64" "float" "double" "ptr" "void"]))))

;; The parameter names of `((T a) (U b))`, and whether every type is one an export takes.
(defun export-params :private (ps: str) -> (Result (Vec str) str)
  (let ((inner (str-slice ps 1 (- (str-len ps) 1))))
    (let ((chunks (filter (fn (c: str) (not (= (s/trim c) ""))) (s/split inner ")"))))
      (let ((words (mapv (fn (c: str) (s/split (s/trim (str-slice (s/trim c) 1 (str-len (s/trim c)))) " ")) chunks)))
        (if (every? (fn (w: (Vec str)) (and (= (count w) 2) (scalar-word? (nth w 0)))) words)
          (Ok (mapv (fn (w: (Vec str)) (nth w 1)) words))
          (Err "export: every parameter must be an integer, a float or a raw ptr"))))))

(defun export-wrapper :private (p: Program sym: str name: str) -> (Result str str)
  (try-let ((h (export-header p name)))
    (let ((ret (. h fst)) (ps (. h snd)))
      (if (not (scalar-word? ret))
        (Err (str-join ["export: " sym " must return an integer, a float, a raw ptr or nothing"]))
        (try-let ((names (export-params ps)))
          (let ((call (str-join ["(call @" name (str-join (mapv (fn (n: str) (str-join [" " n])) names)) ")"])))
            (Ok (str-join ["(define (" sym " " ret ") " ps "\n  (block entry\n    (call @fib.export-ready)\n    "
                           (if (= ret "void") (str-join [call "\n    (ret)"]) (str-join ["(let ((r " call "))\n      (ret r))"])) "))\n"]))))))))

(defun export-ready :private (p: Program) -> str
  (str-join ["(global internal fib.exported i32 (i32 0))\n"
             "(define internal (fib.export-ready void) ()\n  (block entry (br (icmp eq (load i32 @fib.exported) (i32 0)) first done))\n"
             "  (block first (store (i32 1) @fib.exported) (call @fib.init) (call @fib.set-args (i32 0) (ptr null))\n    "
             (if (empty? @(. p inits)) "" "(call @fib.defs-init)") " (ret))\n  (block done (ret)))\n"]))

;; The module of a library: the runtime, the program's functions reached from the exports, the wrappers and the init of the runtime on the first call.
(defun compile-library :private (typed: TypedProgram owned: OwnedProgram specs: (Vec (Pair str str))) -> (Result Module str)
  (let ((p (emit.program/program-new typed owned)))
    (try-let ((_ (inits-plan p)))
      (match (make-defs-at p)
        ((Err m) (Err m))
        ((Ok [q defs])
         (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
             (inits-request q)
             (try-let ((names (try-map (fn (s: (Pair str str))
                                         (match (program-fun typed (. s snd))
                                           (nil (Err (str-join ["export: the program has no function " (. s snd)])))
                                           ((some f) (Ok (program-request q (BodyFun f) [])))))
                                       specs))
                       (_ (emit-all q))
                       (wrappers (try-map (fn (i: i64) (export-wrapper q (. (nth specs i) fst) (nth names i))) (vec (range (count specs))))))
               (Ok (Module (module-parts q @(. defs text)) (str-join [(inits-render q) (export-ready q) (str-join wrappers)]) nil)))))))))

;; The module text as the target's runtime wants it: WASI's finishing pass (emit.wasi), nothing for the others.
(defun for-target :private (text: str) -> str
  (if (= (tos/target-platform-name) "Wasi") (wasi/finish text) text))

;; The lIR text of a whole program for `fibc run`: runtime, static data, bodies, and a `main` that prints the result.
;; Rust: compile.rs:47 compile
(defun compile (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (match (compile-module typed owned false)
    ((Err m) (Err m))
    ((Ok m) (match (. m pending) ((some msg) (Err msg)) (nil (Ok (for-target (str-concat (target-form typed) (module-text m)))))))))

;; The kernel table (docs/design/gpu.md 4.2): one `(constant internal fib.kernel.NAME ptr @F)` per kernel of the program (`defkernel`, in any module;
;; types.decls `kernels`), NAME the kernel's name as a driver asks for it, `@F` its function. On a kernel target native.kernel reads the table
;; to find the entries; on the host it says the program has kernels (`fibc build` refuses an executable without a kernel target, driver.commands).
(defun kernel-table :private (p: Program names: (Vec str)) -> unit
  (let ((g (program-g p)) (ks @(. g kernels)))
    (dotimes (i (count ks))
      (let ((k (. (g-fun g (nth ks i)) name)))
        (statics-item (. p statics) (str-join ["fib.kernel." k]) (str-join ["(constant internal fib.kernel." k " ptr @" (nth names i) ")
"]))))))

;; The module of a kernel target (docs/design/gpu.md 4.2): the runtime, the kernels and what they reach, the kernel table; no `main`, no wrappers
;; (native.kernel extracts the kernel module from this one).
(defun compile-kernels :private (typed: TypedProgram owned: OwnedProgram) -> (Result Module str)
  (let ((p (emit.program/program-new typed owned)) (ks @(. (. typed globals) kernels)))
    (try-let ((_ (inits-plan p)))
      (match (make-defs-at p)
        ((Err m) (Err m))
        ((Ok [q defs])
         (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
             (inits-request q)
             (let ((names (mapv (fn (f: i64) (program-request q (BodyFun f) [])) ks)))
               (try-let ((_ (emit-all q)))
                 (do (kernel-table q names)
                     (Ok (Module (module-parts q @(. defs text)) (inits-render q) nil)))))))))))

;; The kernel table of a host program: the kernels' functions are requested (so a kernel body is checked and lowered for the host, the
;; one-language guard of gpu.md 3.5) and the table written.
(defun host-kernel-table (p: Program) -> unit
  (let ((ks @(. (program-g p) kernels)))
    (when (not (empty? ks))
      (kernel-table p (mapv (fn (f: i64) (program-request p (BodyFun f) [])) ks)))))

;; The same for an executable, whose `main` returns the result as the process status and prints nothing (compiler.md §1); on a kernel target the
;; module is the kernels' (`compile-kernels`).
;; Rust: compile.rs:53 compile_executable
(defun compile-executable (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (match (cond (tt/kernel-triple? (sys-getenv "FIB_TARGET_TRIPLE")) (compile-kernels typed owned)
               (empty? (export-specs)) (compile-module typed owned true)
               :else (compile-library typed owned (export-specs)))
    ((Err m) (Err m))
    ((Ok m) (match (. m pending) ((some msg) (Err msg)) (nil (Ok (for-target (str-concat (target-form typed) (module-text m)))))))))

;; The first `defmacro` of the program called `name`: its function id.
(defun macro-index :private (g: Globals name: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (table-count (. g funs))) nil
          (and (. (g-fun g i) is-macro) (= (. (g-fun g i) name) name)) (some i)
          :else (recur (+ i 1)))))

;; The index of the first variant called `v`.
(defun variant-index :private (vs: (Vec VariantDef) v: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (count vs)) nil
          (= (. (nth vs i) name) v) (some i)
          :else (recur (+ i 1)))))

;; The variant index of each name of `abi-variants` in the enum `Form`: they must be in the order the ABI assumes.
(defun form-tags :private (g: Globals form-id: i64) -> (Result (Vec i64) str)
  (match (. (g-ty g form-id) shape)
    ((TsEnum vs)
     (loop ((i 0) (tags []))
       (if (>= i (count (abi-variants)))
           (Ok tags)
           (let ((v (nth (abi-variants) i)))
             (match (variant-index vs v)
               (nil (Err (str-join ["Form has no variant " v])))
               ((some tag) (if (= tag i)
                               (recur (+ i 1) (conj tags tag))
                               (Err "Form's variants are not in the expected order"))))))))
    (_ (Err "Form is not an enum"))))

;; The layout of `Form`, once its object, the `Vec` ids and the body of macro `f` are made. The keyword table is complete when the
;; bodies are emitted: it is sealed, so that a keyword interned later (assembling the text) traps and does not leave an id the table
;; lacks. Rust: compile.rs:149-159
(defun macro-layout :private (p: Program sname: str tid: i64 tags: (Vec i64) vec: VecIds) -> FormLayout
  (let ((keyword-strs (mapv (fn (k: str) (statics-string (. p statics) k 0)) (statics-keywords (. p statics)))))
    (do (statics-seal-keywords (. p statics))
        (FormLayout sname tid tags (obj-size (objects-get (. p objects) tid)) vec keyword-strs))))

;; The module of macro `f`: the program's runtime, tables and functions, then the surface of `abi-render`.
(defun macro-text :private (p: Program f: i64 form-ty: Ty vec-id: i64 tags: (Vec i64) obj: (Pair i64 str) n: i64 k: i64)
    -> (Result MacroModule str)
  (try-let ((vec (vec-ids-of p (ty-nominal vec-id [form-ty]) form-ty)) (defs (make-defs p)))
    (do (set! (. p def-values) @(. defs values))
        (let ((body (program-request p (BodyFun f) [])))
          (try-let ((_ (emit-all p)))
            (let ((layout (macro-layout p (. obj snd) (. obj fst) tags vec)))
              (Ok (MacroModule (str-join [(assemble-parts p @(. defs text)) (abi-render layout body n k)])))))))))

;; The macro-time module of a program whose `defmacro` is `name`, taking `n` `Form` (or rest vector) arguments, as the first macro
;; module of a run is numbered `k`. Rust: compile.rs:96 compile_macro
(defun compile-macro (typed: TypedProgram owned: OwnedProgram name: str n: i64 k: i64) -> (Result MacroModule str)
  (let ((g (. typed globals)))
    (match (macro-index g name)
      (nil (Err (str-join ["no macro " name])))
      ((some f)
       (let ((p (emit.program/program-new typed owned)))
         (do (set! (. p macro-module) true)
             (set! (. p pb) 8)
             (doseq [w (abi-widths)] (statics-keyword (. p statics) w))
             (match @(. g form)
               (nil (Err "the prelude defines no Form"))
               ((some form-id)
                (let ((form-ty (ty-nominal form-id [])))
                  (try-let ((obj (program-object p form-ty)) (tags (form-tags g form-id)))
                    (match @(. g vec)
                      (nil (Err "the prelude defines no Vec"))
                      ((some vec-id) (macro-text p f form-ty vec-id tags obj n k)))))))))))))
