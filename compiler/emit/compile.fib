;; compiler/emit/compile.fib: the driver of the emission: `compile` and `compile-module` (spec/compiler.md §2, types §8): the runtime, the
;; type table, the static data, every specialised body reached from `main`, and lIR's `main`. Replaces crates/fibc/src/compile.rs. `compile`
;; takes the two parts of the Rust `Checked`; `Unsupported(String)` is the `str` of a `(Result a str)`.
;; Where the rest of compile.rs went: RUNTIME and `runtime_declaration` are emit.rt's (over the generated emit.runtime), `emit_all`, `Parts`,
;; `Module`, `module_parts` and `assemble_parts` are emit.assemble's (emit.defs.mod needs them), the init functions of inits.rs are emit.inits.
;; `compile-module` does not fail at a stub (an error message starting `todo: `, package E4 and later): the `Module` it returns has `pending`
;; set and holds what needs no body, the runtime and `main`.
;; `compile-macro` (E11) is the macro-time module of one `defmacro` (macros/abi.rs's text is emit.macros.abi's).
(ns emit.compile
  (:require [fib.string :as s] [emit.defs.astmod :as am] [emit.cpucheck :as cc] [emit.live :as live] [emit.livedef :as eld] [emit.wasi :as wasi] [expand.targetos :as tos] [types.targets :as tgt] [emit.typetext :as tt] [emit.prune :as pr] [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f] [lir.print :as print])
  (:use types.ty types.ast types.table types.decls types.names types.init types.program own.program emit.value emit.names emit.objects emit.statics emit.program emit.inits
        emit.assemble emit.defs.mod emit.lower.cx emit.lower.mod emit.macros.abi types.target))

;; The text of a macro module. Rust: compile.rs:88 MacroModule
(defstruct MacroModule (ast: la/LModule))
(defstruct Emitted (ast: la/LModule links: (Vec (Pair str str))))
(defun emitted-text (m: Emitted) -> str (str (link-text (. m links)) (print/print-module (. m ast))))

;; With FIB_RESULT_STDOUT=1 an executable prints its result as `fibc run` does and exits 0, instead of returning it as the status (a status keeps 8 bits): the harness of a target
;; that cannot run the case under `fibc run` (compiler/tests/wasm/suite.py) reads the result from standard output.
;; The fixed end of a module: `main`, which §8.8 has join every thread still running before the result is printed (fibc run) or
;; returned (an executable), calling the program's entry function. Rust: compile.rs:296 main_text
(defun main-items :private (entry: str executable: bool init: (Vec la/LExpr) check: (Vec la/LExpr) uw: bool) -> (Vec la/LItem)
  (let ((call (n/call entry [])))
    (let ((result (if uw (n/extract call 0) call))
          (end (if (and executable (not (= (sys-getenv "FIB_RESULT_STDOUT") (some "1"))))
                   [(n/ret (some (n/cast la/CTrunc lt/ty-i32 (n/local "r"))))]
                   [(n/call "printf" [(n/string "%lld\n") (n/local "r")]) (n/ret (some (n/integer lt/ty-i32 0)))])))
      [(la/ItDeclare (la/LDeclare "printf" (lt/LFnType lt/cc-c (some lt/ty-i32) [lt/ty-ptr] true) false 0))
       (la/ItGlobal (la/LGlobalDef "fib.main-r" lt/ty-i64 (n/integer lt/ty-i64 0) false (la/LModifiers la/lk-internal false) 0 false))
       (la/ItDefine (f/make "fib.main-body" nil [] lt/cc-c
         [(f/block "entry" (into init [(f/bound [(f/binding "r" result)] [(n/store (n/local "r") (n/global "fib.main-r") nil) (n/ret nil)])]))]))
       (la/ItDefine (f/external (f/make "main" (some lt/ty-i32) [(Pair "argc" lt/ty-i32) (Pair "argv" lt/ty-ptr)] lt/cc-c
         [(f/block "entry" (into check [(n/call "fib.init" []) (n/call "fib.set-args" [(n/local "argc") (n/local "argv")])
                                       (n/call "fib.run-main" [(n/global "fib.main-body")])
                                       (f/bound [(f/binding "r" (n/load lt/ty-i64 (n/global "fib.main-r") nil))]
                                                (into [(n/call "fib.join-all" []) (n/call "fib.pool-quiesce" []) (n/call "fib.defs-drop" [])] end))]))])))])))

;; The constant `def`s are made by `emit-defs`, which runs each through the JIT; a program with none has no defs to make (the Rust
;; `emit_defs` loops over none and returns the empty `Defs`), so it never reaches that package.
(defun make-defs :private (p: Program) -> (Result Defs str)
  (if (empty? (filter (fn (d: i64) (. (g-def (program-g p) d) constant)) (all-def-ids p)))
      (Ok (defs-new))
      (emit-defs p)))

;; The constant `def`s of a program for a target whose pointers are not the host's: they are evaluated by the JIT, which runs on the host, so the program is
;; laid out and lowered for the host while it makes them, and the constants come back as text (struct constants: LLVM lays them out for the target). The program
;; the rest is lowered for is a fresh one at the target's pointer width (`program-rebuilt`: the bodies, closures and vtables the JIT's pass made are lowered again).
(defun make-defs-at :private (p: Program) -> (Result (Pair Program Defs) str)
  (let ((pb (program-pb p)))
    (if (or (= pb 8) (empty? (filter (fn (d: i64) (. (g-def (program-g p) d) constant)) (all-def-ids p))))
        (try-let ((d (make-defs p))) (Ok (Pair p d)))
        (do (set! (. p pb) 8)
            (try-let ((d (emit-defs p)))
              (Ok (Pair (program-rebuilt p pb) d)))))))

;; The `main` section: the init functions, then `main` calling the entry. Nothing in it depends on a body being emitted. An executable for x86-64
;; Linux first checks that the CPU has what it was built for (emit.cpucheck, docs/adr/0008).
(defun main-part :private (p: Program entry: str executable: bool) -> (Vec la/LItem)
  (let ((target (if executable @(. (program-g p) target) nil)))
    (let ((checks (match target (nil []) ((some t) (cc/cpu-check-items t))))
          (calls (match target (nil []) ((some t) (cc/cpu-check-code t))))
          (init (if (empty? @(. p inits)) [] [(n/call "fib.defs-init" [])])))
      (into (into (inits-items p) checks) (main-items entry executable init calls (and (. p unwinding) (not @(. p macro-module))))))))

;; A stub reached is an error whose message starts `todo: `: the module is then pending, with what needs no body.
(defun pending-or-error :private (p: Program entry: str executable: bool m: str) -> (Result Module str)
  (if (starts-with? m "todo: ")
      (Ok (Module (parts-pending) (main-part p entry executable) (some m)))
      (Err m)))

;; With FIB_AST_VERIFY set, the module as trees (emit.defs.astmod) must print as the text of the module does.
(defun verified :private (p: Program defs: Defs m: Module) -> (Result Module str)
  (if (am/verifying?)
      (try-let ((ast (am/module-ast p defs (. m main)))
                (_ (am/verify-module p defs (. m main) ast)))
        (Ok m))
      (Ok m)))

;; PRUNE-1 (emit.prune) applies to the text of an executable or a `fibc run` program for a posix target; FIB_PRUNE=0 turns it off (to measure what it saves).
(defun prune? :private () -> bool
  (and (not (= (sys-getenv "FIB_PRUNE") (some "0"))) (not (am/verifying?)) (not (= (tos/target-platform-name) "Wasi"))))

;; The text of `main` with no initialiser in it: what the text of the program must keep alive besides its items.
(defun main-roots :private (p: Program entry: str executable: bool) -> (Vec la/LItem)
  (let ((saved @(. p inits)))
    (do (set! (. p inits) [])
        (let ((t (main-part p entry executable)))
          (do (set! (. p inits) saved) t)))))

;; The module of the program once the bodies are emitted: without what nothing reaches (emit.prune), and with the initialisers of the `def`s made at run time
;; that stay. With `keep-all` nothing is pruned: the bodies `compile-module-with` was asked for are not reached by `main`.
(defun finished :private (p: Program defs-items: (Vec la/LItem) entry: str executable: bool keep-all: bool) -> Module
  (if (and (prune?) (not keep-all))
      (let ((r (pr/prune-parts (module-parts p defs-items) (main-roots p entry executable) @(. p inits) (if (. p live) live/runtime-roots []))))
        (do (set! (. p inits) (. r snd))
            (Module (. r fst) (main-part p entry executable) nil)))
      (Module (module-parts p defs-items) (main-part p entry executable) nil)))

;; A body a live session asks for whether or not `main` reaches it (compiler/live, serve.liveswap): the function's name as the program
;; knows it, whether the all-owned closure body (`f.NAME.owned`, types §8.4) is meant rather than the function's own, and the types of
;; the specialisation (none for a monomorphic function); or, with `impl` (`impl:PROTO HEAD`, emit.live `impl-key`), every method of that
;; instance. A name the program has no function of is skipped, as is a body the ownership pass made no plan for (an all-owned body of
;; a function whose value nothing takes).
;; `tys-text` (LE3): a registered specialisation's types as text (emit.live `tys-text`), resolved in this program's globals when the
;; request is made (`request-tys`); a swap requests a generic body this way, since the queue mode does not reach it from a resident
;; caller. Empty for a monomorphic request, which uses `tys` as before.
;; `module` (LM1): the module the function is of when it is not the main module's (a `load` of a program module, serve.liveload:
;; `f.routes.route` is the function `route` of module `routes`); nil looks the bare name up in the main module as before.
;; `impl` "def:" (LT4) asks for the initialiser of the `def` `name` (of `module`), lowered even when the running program has it.
(defstruct BodyRequest (name: str owned: bool tys: (Vec Ty) impl: (Option str) tys-text: (Vec str) module: (Option str)))

;; The function a request names: of its module when it has one, else of the main module.
(defun request-fun :private (typed: TypedProgram r: BodyRequest) -> (Option i64)
  (match (. r module)
    (nil (program-fun typed (. r name)))
    ((some m) (program-fun-in typed m (. r name)))))

;; The types of a request in this program's terms: `tys` when the request has no text; else the text read back (emit.typetext), or
;; nil when a type it names has no definition here (an input's private type: the specialisation keeps its slot, docs 2.4 item 4).
(defun request-tys :private (typed: TypedProgram r: BodyRequest) -> (Option (Vec Ty))
  (if (empty? (. r tys-text)) (some (. r tys)) (tt/tys-of-text (. typed globals) (. r tys-text))))

;; The bodies of `requests` queued.
(defun request-all :private (q: Program typed: TypedProgram owned: OwnedProgram requests: (Vec BodyRequest)) -> unit
  (doseq [r requests]
    (match (. r impl)
      ((some key) (if (= key "def:") (request-def q typed r) (request-impl q typed owned key)))
      (nil (match (request-fun typed r)
             (nil ())
             ((some f) (let ((key (if (. r owned) (BodyAllOwned f) (BodyFun f))))
                         (when (contains? (. owned bodies) key)
                           (match (request-tys typed r) ((some tys) (do (program-request q key tys) ())) (nil ()))))))))))

;; A `def`'s initialiser (`impl` "def:", LT4: a live session redefining the def runs the new one under a name of its own): lowered even
;; when the running program has a body of that name (it is taken out of the resident set).
(defun request-def :private (q: Program typed: TypedProgram r: BodyRequest) -> unit
  (let ((g (. typed globals)))
    (match (def-of-request g r)
      (nil ())
      ((some d) (do (set! (. q resident) (disj @(. q resident) (body-name g (BodyDef d) []))) (program-request q (BodyDef d) []) (eld/live-const-slot q d) ())))))

(defun def-of-request :private (g: Globals r: BodyRequest) -> (Option i64)
  (let ((m (match (. r module)
             (nil (some @(. g main)))
             ((some name) (find-first (fn (i: i64) (= (g-module-name g i) name)) (range (table-count (. g modules))))))))
    (match m (nil nil) ((some i) (match (g-value g i (. r name)) ((some (GDef d)) (some d)) (_ nil))))))

;; The methods of the instances keyed `key` (and their all-owned bodies where a method value may run them).
(defun request-impl :private (q: Program typed: TypedProgram owned: OwnedProgram key: str) -> unit
  (let ((g (. typed globals)))
    (doseq [i (range (table-count (. g instances)))]
      (when (= (live/impl-key g i) key)
        (doseq [m (range (count (. (table-get (. g instances) i) methods)))]
          (doseq [k [(BodyMethod i m) (BodyMethodOwned i m)]]
            (when (contains? (. owned bodies) k) (do (program-request q k []) ()))))))))

;; The Module of a program that has a `main`, planned, with its defs made and its entry requested. Rust: compile.rs:60 compile_module
;; The entry's name is the same whenever it is requested (names carry no counter): a module that stops at the defs knows it.
(defun compile-module (typed: TypedProgram owned: OwnedProgram executable: bool) -> (Result Module str)
  (compile-module-with typed owned executable nil []))

;; As `compile-module`, numbered in `tables` when given (emit.program `program-new-with`: a live session's, shared by every program of
;; the session) and with the bodies of `requests` emitted whether or not `main` reaches them (then nothing is pruned): a live session's
;; functions are called by code that is already resident, not by this program's `main`.
(defun compile-module-with (typed: TypedProgram owned: OwnedProgram executable: bool tables: (Option Tables) requests: (Vec BodyRequest))
    -> (Result Module str)
  (match (program-fun typed "main")
    (nil (Err "the program has no main"))
    ((some main)
     (let ((p (emit.program/program-new-with typed owned tables)))
       (try-let ((_ (inits-plan p)))
         (match (make-defs-at p)
           ((Err m) (pending-or-error p (body-name (program-g p) (BodyFun main) []) executable m))
           ((Ok [q defs])
            (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
                (inits-request q)
                (host-kernel-table q)
                (request-all q typed owned requests)
                (let ((entry (program-request q (BodyFun main) [])))
                  (match (emit-all q)
                    ((Ok _) (verified q defs (finished q @(. defs items) entry executable (not (empty? requests)))))
                    ((Err m) (pending-or-error q entry executable m))))))))))))

;; The module's `(target (cpu ..) (features ..))` form (spec/lir.md 4.5) for the target the front end was told: the CPU the checker chose its lane
;; counts for, so that `lair` builds for the CPU the program was checked against. Nothing when the checker was told none (its unit tests).
(defun target-items :private (typed: TypedProgram) -> (Vec la/LItem)
  (match @(. (. typed globals) target)
    (nil []) ((some t) [(la/ItTarget (la/LTarget (. t cpu) (. t features) 0))])))

;; --- exported functions (docs/design/wasm.md 5): `fibc build --export NAME[=SYMBOL]` makes the function NAME of the program a symbol of the object that the host can call,
;; with the C convention and scalar or raw pointer arguments. There is no `main`: the module is a library, its runtime starts on the first call (`fib.export-ready`).
(defun export-specs () -> (Vec (Pair str str))
  (match (sys-getenv "FIB_EXPORTS")
    (nil [])
    ((some t)
     (vec (mapv (fn (w: str) (match (str-find w "=" 0)
                               ((some i) (Pair (str-slice w (+ i 1) (str-len w)) (str-slice w 0 i)))
                               (nil (Pair w w))))
                (filter (fn (w: str) (not (= w ""))) (s/split t ",")))))))

;; The header of the lowered body `name`: its result type and the parameters `((T n) ..)`, from the text of the function. Only a function that is not generic, takes no
;; hidden slot (a program that catches returns a failure next to the value) and has a scalar or raw pointer for each of them can be exported.
(defun export-header :private (p: Program name: str) -> (Result la/LFunction str)
  (match (first (filter (fn (f: la/LFunction) (= (. f name) name)) @(. p funcs)))
    (nil (Err (str "export: no code for " name))) ((some f) (Ok f))))

(defun scalar-type? :private (ty: lt/LType) -> bool
  (match ty ((lt/TInt _) true) ((lt/TFloat) true) ((lt/TDouble) true) ((lt/TPtr) true) (_ false)))

;; The parameter names of `((T a) (U b))`, and whether every type is one an export takes.
(defun export-params :private (func: la/LFunction) -> (Result (Vec la/LExpr) str)
  (if (every? scalar-type? (. (. func ty) params))
      (Ok (mapv (fn (p: la/LParam) (n/local (. p name))) (. func params)))
      (Err "export: every parameter must be an integer, a float or a raw ptr")))

(defun export-wrapper :private (p: Program sym: str name: str) -> (Result la/LItem str)
  (try-let ((func (export-header p name)))
    (let ((ty (. func ty)))
      (if (match (. ty ret) (nil false) ((some ret) (not (scalar-type? ret))))
          (Err (str "export: " sym " must return an integer, a float, a raw ptr or nothing"))
          (try-let ((args (export-params func)))
            (let ((call (n/call name args)))
              (let ((body (match (. ty ret)
                            (nil [call (n/ret nil)])
                            ((some _) [(f/bound [(f/binding "r" call)] [(n/ret (some (n/local "r")))])]))))
                (Ok (la/ItDefine (f/external (f/make sym (. ty ret)
                      (mapv (fn (i: i64) (Pair (. (nth (. func params) i) name) (nth (. ty params) i))) (range (count (. func params))))
                      lt/cc-c [(f/block "entry" (into [(n/call "fib.export-ready" [])] body))])))))))))))

(defun export-ready :private (p: Program) -> (Vec la/LItem)
  [(la/ItGlobal (la/LGlobalDef "fib.exported" lt/ty-i32 (n/integer lt/ty-i32 0) false (la/LModifiers la/lk-internal false) 0 false))
   (la/ItDefine (f/make "fib.export-ready" nil [] lt/cc-c
     [(f/block "entry" [(n/conditional (n/compare-int la/IEq (n/load lt/ty-i32 (n/global "fib.exported") nil) (n/integer lt/ty-i32 0)) "first" "done")])
      (f/block "first" (into [(n/store (n/integer lt/ty-i32 1) (n/global "fib.exported") nil) (n/call "fib.init" [])
                              (n/call "fib.set-args" [(n/integer lt/ty-i32 0) (n/null)])]
                             (into (if (empty? @(. p inits)) [] [(n/call "fib.defs-init" [])]) [(n/ret nil)])))
      (f/block "done" [(n/ret nil)])]))])

;; The module of a library: the runtime, the program's functions reached from the exports, the wrappers and the init of the runtime on the first call.
(defun compile-library :private (typed: TypedProgram owned: OwnedProgram specs: (Vec (Pair str str))) -> (Result Module str)
  (let ((p (emit.program/program-new typed owned)))
    (try-let ((_ (inits-plan p)))
      (match (make-defs-at p)
        ((Err m) (Err m))
        ((Ok [q defs])
         (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
             (inits-request q)
             (try-let ((names (try-map (fn (s: (Pair str str))
                                         (match (program-fun typed (. s snd))
                                           (nil (Err (str-join ["export: the program has no function " (. s snd)])))
                                           ((some f) (Ok (program-request q (BodyFun f) [])))))
                                       specs))
                       (_ (emit-all q))
                       (wrappers (try-map (fn (i: i64) (export-wrapper q (. (nth specs i) fst) (nth names i))) (vec (range (count specs))))))
               (Ok (Module (module-parts q @(. defs items)) (into (into (inits-items q) (export-ready q)) wrappers) nil)))))))))

;; The module text as the target's runtime wants it: WASI's finishing pass (emit.wasi), nothing for the others.
(defun for-target :private (ast: la/LModule) -> la/LModule
  (if (= (tos/target-platform-name) "Wasi") (wasi/finish-module ast) ast))

(defun finished-product :private (typed: TypedProgram result: (Result Module str)) -> (Result Emitted str)
  (try-let ((m result))
    (match (. m pending)
      ((some message) (Err message))
      (nil (Ok (Emitted (for-target (la/LModule (into (target-items typed) (. (module-ast m) items)))) (. (. m parts) links)))))))

;; The lIR text of a whole program for `fibc run`: runtime, static data, bodies, and a `main` that prints the result.
;; Rust: compile.rs:47 compile
(defun compile-ast (typed: TypedProgram owned: OwnedProgram) -> (Result Emitted str)
  (finished-product typed (compile-module typed owned false)))

(defun compile (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (try-let ((m (compile-ast typed owned))) (Ok (emitted-text m))))

;; The kernel table (docs/design/gpu.md 4.2): one `(constant internal fib.kernel.NAME ptr @F)` per kernel of the program (`defkernel`, in any module;
;; types.decls `kernels`), NAME the kernel's name as a driver asks for it, `@F` its function. On a kernel target native.kernel reads the table
;; to find the entries; on the host it says the program has kernels (`fibc build` refuses an executable without a kernel target, driver.commands).
(defun kernel-table :private (p: Program names: (Vec str)) -> unit
  (let ((g (program-g p)) (ks @(. (program-g p) kernels)))
    (dotimes (i (count ks))
      (let ((name (str "fib.kernel." (. (g-fun g (nth ks i)) name))))
        (statics-item (. p statics) name (la/ItGlobal (la/LGlobalDef name lt/ty-ptr (n/global (nth names i)) true
                                                          (la/LModifiers la/lk-internal false) 0 false)))))))

;; The module of a kernel target (docs/design/gpu.md 4.2): the runtime, the kernels and what they reach, the kernel table; no `main`, no wrappers
;; (native.kernel extracts the kernel module from this one).
(defun compile-kernels :private (typed: TypedProgram owned: OwnedProgram) -> (Result Module str)
  (let ((p (emit.program/program-new typed owned)) (ks @(. (. typed globals) kernels)))
    (try-let ((_ (inits-plan p)))
      (match (make-defs-at p)
        ((Err m) (Err m))
        ((Ok [q defs])
         (do (set! (. q def-values) (merge @(. q def-values) @(. defs values)))
             (inits-request q)
             (let ((names (mapv (fn (f: i64) (program-request q (BodyFun f) [])) ks)))
               (try-let ((_ (emit-all q)))
                 (do (kernel-table q names)
                     (Ok (Module (module-parts q @(. defs items)) (inits-items q) nil)))))))))))

;; The kernel table of a host program: the kernels' functions are requested (so a kernel body is checked and lowered for the host, the
;; one-language guard of gpu.md 3.5) and the table written.
(defun host-kernel-table (p: Program) -> unit
  (let ((ks @(. (program-g p) kernels)))
    (when (not (empty? ks))
      (kernel-table p (mapv (fn (f: i64) (program-request p (BodyFun f) [])) ks)))))

;; The same for an executable, whose `main` returns the result as the process status and prints nothing (compiler.md §1); on a kernel target the
;; module is the kernels' (`compile-kernels`).
;; Rust: compile.rs:53 compile_executable
(defun compile-executable-ast (typed: TypedProgram owned: OwnedProgram) -> (Result Emitted str)
  (finished-product typed
    (cond (tgt/kernel-triple? (sys-getenv "FIB_TARGET_TRIPLE")) (compile-kernels typed owned)
          (empty? (export-specs)) (compile-module typed owned true)
          :else (compile-library typed owned (export-specs)))))

;; The executable's module (the host, no kernels, no exports) numbered in a live session's `tables`, with the bodies of `requests`
;; (`compile-module-with`).
(defun compile-executable-ast-with (typed: TypedProgram owned: OwnedProgram tables: (Option Tables) requests: (Vec BodyRequest)) -> (Result Emitted str)
  (finished-product typed (compile-module-with typed owned true tables requests)))

(defun compile-executable (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (try-let ((m (compile-executable-ast typed owned))) (Ok (emitted-text m))))

;; The first `defmacro` of the program called `name`: its function id.
(defun macro-index :private (g: Globals name: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (table-count (. g funs))) nil
          (and (. (g-fun g i) is-macro) (= (. (g-fun g i) name) name)) (some i)
          :else (recur (+ i 1)))))

;; The index of the first variant called `v`.
(defun variant-index :private (vs: (Vec VariantDef) v: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (count vs)) nil
          (= (. (nth vs i) name) v) (some i)
          :else (recur (+ i 1)))))

;; The variant index of each name of `abi-variants` in the enum `Form`: they must be in the order the ABI assumes.
(defun form-tags :private (g: Globals form-id: i64) -> (Result (Vec i64) str)
  (match (. (g-ty g form-id) shape)
    ((TsEnum vs)
     (loop ((i 0) (tags []))
       (if (>= i (count (abi-variants)))
           (Ok tags)
           (let ((v (nth (abi-variants) i)))
             (match (variant-index vs v)
               (nil (Err (str-join ["Form has no variant " v])))
               ((some tag) (if (= tag i)
                               (recur (+ i 1) (conj tags tag))
                               (Err "Form's variants are not in the expected order"))))))))
    (_ (Err "Form is not an enum"))))

;; The layout of `Form`, once its object, the `Vec` ids and the body of macro `f` are made. The keyword table is complete when the
;; bodies are emitted: it is sealed, so that a keyword interned later (assembling the text) traps and does not leave an id the table
;; lacks. Rust: compile.rs:149-159
(defun macro-layout :private (p: Program sname: str tid: i64 tags: (Vec i64) vec: VecIds) -> FormLayout
  (let ((keyword-strs (mapv (fn (k: str) (statics-string (. p statics) k 0)) (statics-keywords (. p statics)))))
    (do (statics-seal-keywords (. p statics))
        (FormLayout sname tid tags (obj-size (objects-get (. p objects) tid)) vec keyword-strs))))

;; The module of macro `f`: the program's runtime, tables and functions, then the surface of `abi-render`.
(defun macro-module :private (p: Program f: i64 form-ty: Ty vec-id: i64 tags: (Vec i64) obj: (Pair i64 str) n: i64 k: i64)
    -> (Result MacroModule str)
  (try-let ((vec (vec-ids-of p (ty-nominal vec-id [form-ty]) form-ty)) (defs (make-defs p)))
    (do (set! (. p def-values) @(. defs values))
        (let ((body (program-request p (BodyFun f) [])))
          (try-let ((_ (emit-all p)))
            (let ((layout (macro-layout p (. obj snd) (. obj fst) tags vec)))
              (Ok (MacroModule (la/LModule (into (parts-items (module-parts-with (. p runtime-host) p @(. defs items))) (abi-items layout body n k)))))))))))

;; The macro-time module of a program whose `defmacro` is `name`, taking `n` `Form` (or rest vector) arguments, as the first macro
;; module of a run is numbered `k`. Rust: compile.rs:96 compile_macro
(defun compile-macro (typed: TypedProgram owned: OwnedProgram name: str n: i64 k: i64) -> (Result MacroModule str)
  (let ((g (. typed globals)))
    (match (macro-index g name)
      (nil (Err (str-join ["no macro " name])))
      ((some f)
       (let ((p (emit.program/program-new typed owned)))
         (do (set! (. p macro-module) true)
             (set! (. p pb) 8)
             (doseq [w (abi-widths)] (statics-keyword (. p statics) w))
             (match @(. g form)
               (nil (Err "the prelude defines no Form"))
               ((some form-id)
                (let ((form-ty (ty-nominal form-id [])))
                  (try-let ((obj (program-object p form-ty)) (tags (form-tags g form-id)))
                    (match @(. g vec)
                      (nil (Err "the prelude defines no Vec"))
                      ((some vec-id) (macro-module p f form-ty vec-id tags obj n k)))))))))))))
