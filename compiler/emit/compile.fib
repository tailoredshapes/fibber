;; compiler/emit/compile.fib: the driver of the emission: the runtime declarations, the assembly of the module text from its parts, `compile`
;; and `compile_macro` (spec/compiler.md §2, §6). Replaces crates/fibc/src/compile.rs. `compile` takes the two parts
;; of the Rust `Checked`; `Unsupported(String)` is the `str` of a `(Result a str)`.
;; STATUS: every public function below is a STUB of package E3, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/compile.rs, 326 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.compile
  (:use types.program own.program emit.value emit.program))

;; The text of a macro module. Rust: compile.rs:88 MacroModule
(defstruct MacroModule (text: str))

;; Rust: compile.rs:36
(defun runtime-declaration (name: str) -> (Option str)
  (trap "todo: E3 runtime-declaration"))

;; Rust: compile.rs:47
(defun compile (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (trap "todo: E3 compile"))

;; Rust: compile.rs:53
(defun compile-executable (typed: TypedProgram owned: OwnedProgram) -> (Result str str)
  (trap "todo: E3 compile-executable"))

;; Rust: compile.rs:71
(defun emit-all (p: Program) -> (Result unit str)
  (trap "todo: E3 emit-all"))

;; Rust: compile.rs:96
(defun compile-macro (typed: TypedProgram owned: OwnedProgram name: str n: i64 k: i64) -> (Result MacroModule str)
  (trap "todo: E3 compile-macro"))

;; Rust: compile.rs:175
(defun assemble-parts (p: Program defs: str) -> str
  (trap "todo: E3 assemble-parts"))
