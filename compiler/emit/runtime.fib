;; compiler/emit/runtime.fib: GENERATED by compiler/tests/emit/gen-runtime.fib from rt/*.lir; do not edit.
;; The runtime module `fib.rt` (spec/compiler.md §3) as lIR text, one def per file, in the order of compile.rs:20.
;; compiler/tests/emit/runtime.sh regenerates this file and compares it with the committed one.
(ns emit.runtime)

;; core.lir
(def RT-CORE: str
";; fib.rt, core (spec/types.md §8.2, spec/compiler.md §3): the object
;; header, allocation, the count operations, drop, the unique test,
;; traps, stack objects, and the trace of compiler.md §4.
;;
;; The compiler appends the type table @fib.types and the class table
;; @fib.classes (one byte per type id) to the module this text opens.
(declare malloc ptr (i64))
(declare calloc ptr (i64 i64))
(declare free void (ptr))
(declare memcpy ptr (ptr ptr i64))
(declare memmove ptr (ptr ptr i64))
(declare memcmp i32 (ptr ptr i64))
(declare write i64 (i32 ptr i64))
(declare abort void ())
(declare madvise i32 (ptr i64 i32))
(declare getenv ptr (ptr))
(declare strlen i64 (ptr))
(declare snprintf i32 (ptr i64 ptr ...))
;; the quotient of float `quot` is rounded toward zero by libm (lower/arith.rs)
(declare trunc double (double))
(declare truncf float (float))
(defstruct fib.hdr (i64 i32 i32))
(defstruct fib.typerec (ptr ptr ptr i64 ptr))
;; The prefix every closure object shares: header, code (§8.4).
(defstruct fib.closure (i64 i32 i32 ptr))

;; Trace mode (compiler.md §4): 1 when FIB_TRACE is set; the next
;; ordinal; and a buffer for one line.
(global internal fib.tracing i32 (i32 0))
;; The expansion-time hooks of a macro module (compiler.md §6): null
;; in a program, where the builtins they serve never run.
(global internal fibm.gensym-hook ptr (ptr null))
(global internal fibm.reflect-hook ptr (ptr null))
;; `(trap msg)` of a macro: the hook fails the expansion and does not
;; return (macros/bridge.rs); a program's trap is `fib.trap`.
(global internal fibm.trap-hook ptr (ptr null))
(global internal fibm.hook-cx ptr (ptr null))
(global internal fib.ordinal i64 (i64 0))
;; The pthread key under which a spawned task's thread keeps its task (fib.thread-enter): what a trap on that thread
;; completes as failed (fib.trap-bytes). Created by fib.init; the main thread and the pool's workers have no value.
(global internal fib.task-key i32 (i32 0))
;; The pthread key under which a thread keeps its catch state (fib.exc-state): what `catch-run` and a trap read; made on the first
;; catch of the thread and freed when the thread ends.
(global internal fib.exc-key i32 (i32 0))
(declare pthread_key_create i32 (ptr ptr))
(declare pthread_setspecific i32 (i32 ptr))
(declare pthread_getspecific ptr (i32))
(declare pthread_exit void (ptr))

(define internal (fib.init void) ()
  (block entry
    (call @fib.rq-init)
    (call @pthread_key_create @fib.task-key (ptr null))
    (call @pthread_key_create @fib.exc-key @free)
    (call @fib.lc-init)
    (let ((v (call @getenv (string \"FIB_TRACE\"))))
      (br (icmp eq v (ptr null)) done set)))
  (block set (store (i32 1) @fib.tracing) (br done))
  (block done (ret)))

;; One trace line: \"K n c\\n\" or \"K n\\n\" (c = 0: no class).
(define internal (fib.trace-line void) ((i8 kind) (i64 n) (i8 class))
  (block entry
    (let ((buf (alloca i8 (i32 64))))
      (br (icmp eq class (i8 0)) short long)))
  (block long
    (let ((len (call @snprintf buf (i64 64) (string \"%c %lld %c\\n\") (zext i32 kind) n (zext i32 class))))
      (call @write (i32 2) buf (sext i64 len))
      (ret)))
  (block short
    (let ((len2 (call @snprintf buf (i64 64) (string \"%c %lld\\n\") (zext i32 kind) n)))
      (call @write (i32 2) buf (sext i64 len2))
      (ret))))

(define internal (fib.next-ordinal i64) ()
  (block entry (ret (add (atomicrmw add monotonic @fib.ordinal (i64 1)) (i64 1)))))

(define internal (fib.class i8) ((i32 tid))
  (block entry (ret (load i8 (getelementptr i8 @fib.classes (zext i64 tid))))))

;; The small-object free lists (spec/types.md §8.2, the allocator). An object
;; of at most 512 bytes is a block of 16 * cls bytes, cls = 1..32, and its
;; class sits in bits 8.. of its flags word (no flag test reads them: they
;; test bits 0-3). A dead block of a class goes on that class's list (its
;; first word is the link) and the next allocation of the class pops it,
;; with no call to malloc or free. Only while the program has one thread:
;; `fib.mt` is set before the first thread starts (fib.spawn, fib.pool-start)
;; and from then on every block comes from malloc and goes back to free, so
;; the lists need no lock; the blocks still on them stay there. A block is
;; always a plain malloc block, so it may be freed by free from any thread
;; or runtime that reads the class. Trace mode keeps malloc and free for
;; every object (the 16 bytes of ordinal in front), class 0.
;;
;; `fib.mt` is atomic (monotonic), not plain: every spawn stores 1 again while other threads read it, a data race in the memory model
;; (found by ThreadSanitizer, scripts/tsan.sh). Monotonic is enough, and acquire/release is not needed: the first store happens on the
;; one thread that exists, before pthread_create, which orders it before everything the new thread does; a later store writes the
;; same 1; no other data is published through the flag (the lists are never written once it is 1). On x86 and arm64 a monotonic
;; i32 load and store are the plain mov / ldr and str.
(global internal fib.mt i32 (i32 0))
(global internal fib.fl [33 x ptr] (zeroinitializer [33 x ptr]))

;; §8.2: count 1, tid, flags 0 (and the class). In trace mode 16 bytes in
;; front hold the ordinal (compiler.md §4). A failed malloc is the trap
;; \"out of memory\", not a write through a null pointer.
;;
;; `fib.alloc` is the inlinable fast path: a class of at most 32, not tracing,
;; one thread, a block on the class's list. Everything else is `fib.alloc-slow`
;; (a name ending in `-slow` is never inlined: lair marks it `noinline`,
;; else LLVM inlines an internal function with one call site whatever its
;; size, and every allocation, retain and release becomes a real call).
(define internal (fib.alloc ptr) ((i64 size) (i32 tid))
  (block entry
    (let ((cls (lshr (add size (i64 15)) (i64 4)))
          (quiet (and (icmp eq (load i32 @fib.tracing) (i32 0)) (icmp eq (atomic-load monotonic i32 @fib.mt) (i32 0)))))
      (br (and quiet (icmp ule cls (i64 32))) hit miss)))
  (block hit
    (let ((slot (getelementptr ptr @fib.fl cls))
          (head (load ptr slot)))
      (br (icmp ne head (ptr null)) pop miss)))
  (block pop
    (store (load ptr head) slot)
    (call @fib.init-hdr head tid (shl (trunc i32 cls) (i32 8)))
    (ret head))
  (block miss (ret (call @fib.alloc-slow size tid))))

;; A block of 4 MiB or more asks for transparent huge pages (madvise MADV_HUGEPAGE, 14) on the whole pages inside it, as NumPy does for
;; its arrays: a fresh array of 1e7 doubles is otherwise 20000 page faults of 4 KiB, which cost more than the arithmetic that fills it.
;; Advice only: a kernel without THP, or one set to `never`, ignores it, and the result of madvise is not used.
(define internal (fib.advise-huge void) ((ptr p) (i64 size))
  (block entry
    (let ((lo (and (add (ptrtoint i64 p) (i64 4095)) (i64 -4096)))
          (hi (and (add (ptrtoint i64 p) size) (i64 -4096))))
      (br (icmp ult lo hi) go done)))
  (block go
    (call @madvise (inttoptr ptr lo) (sub hi lo) (i32 14))
    (br done))
  (block done (ret)))

(define internal (fib.alloc-slow ptr) ((i64 size) (i32 tid))
  (block entry (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced plain))
  (block plain
    (let ((cls (lshr (add size (i64 15)) (i64 4))))
      (br (icmp ule cls (i64 32)) small big)))
  (block small
    (let ((slot (getelementptr ptr @fib.fl cls))
          (head (load ptr slot)))
      (br (icmp ne (atomic-load monotonic i32 @fib.mt) (i32 0)) fresh single)))
  (block single
    (br (icmp ne head (ptr null)) pop fresh))
  (block pop
    (store (load ptr head) slot)
    (br made))
  (block fresh
    ;; A small block from malloc (more than one thread, or an empty list): the large-block cache's decay check (rt/alloc.lir), so
    ;; that a threaded server whose requests are small still gives a spike's blocks back. An atomic load while the cache is empty.
    (call @fib.lc-tick)
    (let ((q (call @malloc (shl cls (i64 4)))))
      (br (icmp eq q (ptr null)) oom made)))
  (block made
    (let ((p (phi ptr (pop head) (fresh q))))
      (call @fib.init-hdr p tid (shl (trunc i32 cls) (i32 8)))
      (ret p)))
  (block big
    (let ((p1 (call @fib.lc-get size)))
      (br (icmp eq p1 (ptr null)) oom bigok)))
  (block bigok
    (call @fib.init-hdr p1 tid (i32 0))
    (br (icmp uge size (i64 4194304)) huge fin))
  (block huge
    (call @fib.advise-huge p1 size)
    (br fin))
  (block fin (ret p1))
  (block traced
    (let ((q2 (call @fib.lc-get (add size (i64 16)))))
      (br (icmp eq q2 (ptr null)) oom tracedok)))
  (block tracedok
    (let ((n (call @fib.next-ordinal))
          (p2 (getelementptr i8 q2 (i64 16))))
      (store n q2)
      (call @fib.init-hdr p2 tid (i32 0))
      (call @fib.trace-line (i8 65) n (call @fib.class tid))
      (ret p2)))
  (block oom
    (call @fib.fatal-c (string \"out of memory\"))
    (unreachable)))

;; Gives a dead object's block back: onto its class's list while there is
;; one thread, else to free; a block of no class (above 512 bytes) to the
;; large-block cache (rt/alloc.lir), which frees what it does not keep.
;; `f` is the flags word read before the drop.
(define internal (fib.free-block void) ((ptr p) (i32 f))
  (block entry
    (let ((cls (zext i64 (lshr f (i32 8)))))
      (br (icmp ne cls (i64 0)) classed large)))
  (block classed
    (br (icmp eq (atomic-load monotonic i32 @fib.mt) (i32 0)) push plain))
  (block push
    (let ((cls2 (zext i64 (lshr f (i32 8))))
          (slot (getelementptr ptr @fib.fl cls2)))
      (store (load ptr slot) p)
      (store p slot)
      (call @fib.lc-every)
      (ret)))
  (block plain (call @free p) (ret))
  (block large (call @fib.lc-put p) (ret)))

;; The program's `(alloc n)` after its `calloc` (syntax §3.15): the block,
;; or the trap \"out of memory\" when there is none, as the interpreter
;; traps, not a null pointer for the program to write through. A size of
;; 0 may be answered with null by calloc: that is no failure.
(define internal (fib.alloc-check ptr) ((ptr p) (i64 n))
  (block entry (br (icmp ne p (ptr null)) ok none))
  (block ok (ret p))
  (block none (br (icmp eq n (i64 0)) ok oom))
  (block oom
    (call @fib.fatal-c (string \"out of memory\"))
    (unreachable)))

(define internal (fib.init-hdr void) ((ptr p) (i32 tid) (i32 flags))
  (block entry
    (store (select (icmp eq (and flags (i32 15)) (i32 0)) (i64 1) (i64 0)) (getelementptr %struct.fib.hdr p (i32 0) (i32 0)))
    (store tid (getelementptr %struct.fib.hdr p (i32 0) (i32 1)))
    (store flags (getelementptr %struct.fib.hdr p (i32 0) (i32 2)))
    (ret)))

;; A STACK object's header (§8.2, §6.11): count 0, flags STACK; in
;; trace mode the ordinal in the count word (compiler.md §4).
(define internal (fib.stack-init void) ((ptr p) (i32 tid))
  (block entry
    (call @fib.init-hdr p tid (i32 4))
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced done))
  (block traced
    (let ((n (call @fib.next-ordinal)))
      (store n (getelementptr %struct.fib.hdr p (i32 0) (i32 0)))
      (call @fib.trace-line (i8 83) n (call @fib.class tid))
      (br done)))
  (block done (ret)))

(define internal (fib.stack-end void) ((ptr p))
  (block entry (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced done))
  (block traced
    (call @fib.trace-line (i8 68) (load i64 (getelementptr %struct.fib.hdr p (i32 0) (i32 0))) (i8 0))
    (br done))
  (block done (ret)))

(define internal (fib.flags i32) ((ptr p))
  (block entry (ret (atomic-load monotonic i32 (getelementptr %struct.fib.hdr p (i32 0) (i32 2))))))

(define internal (fib.tid i32) ((ptr p))
  (block entry (ret (load i32 (getelementptr %struct.fib.hdr p (i32 0) (i32 1))))))

(define internal (fib.retain-slow void) ((ptr p) (i32 f))
  (block entry
    (br (icmp ne (and f (i32 12)) (i32 0)) done counted))
  (block counted
    (let ((cp (getelementptr %struct.fib.hdr p (i32 0) (i32 0))))
      (atomicrmw add monotonic cp (i64 1))
      (br done)))
  (block done (ret)))

;; The fast path is the one that is small enough to be inlined at every
;; call: null, a STACK or IMMORTAL object (bits 4, 8: no count, nothing to
;; do) and a plain object (not SHARED, bit 1; HAS-WEAK does not matter
;; here), whose count is incremented. The rest is retain-slow.
(define internal (fib.retain void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done check))
  (block check
    (let ((f (call @fib.flags p)))
      (br (icmp ne (and f (i32 12)) (i32 0)) done counted)))
  (block counted (br (icmp eq (and f (i32 1)) (i32 0)) local slow))
  (block local
    (let ((cp (getelementptr %struct.fib.hdr p (i32 0) (i32 0))))
      (store (add (load i64 cp) (i64 1)) cp)
      (br done)))
  (block slow (call @fib.retain-slow p f) (br done))
  (block done (ret)))

;; The release of an object that is SHARED (count atomic) or whose
;; flags are not known to be plain; counted objects only reach the
;; atomic branch.
(define internal (fib.release-slow void) ((ptr p) (i32 f))
  (block entry
    (br (icmp ne (and f (i32 12)) (i32 0)) done counted))
  (block counted
    (let ((cp (getelementptr %struct.fib.hdr p (i32 0) (i32 0))))
      (br (icmp ne (and f (i32 1)) (i32 0)) shared local)))
  (block shared
    (let ((old (atomicrmw sub acq_rel cp (i64 1))))
      (br (icmp eq old (i64 1)) drop done)))
  (block local
    (let ((c (load i64 cp)))
      (br (icmp eq c (i64 1)) drop dec)))
  (block dec (store (sub c (i64 1)) cp) (br done))
  (block drop (call @fib.drop p) (br done))
  (block done (ret)))

;; Small enough to be inlined at every call: a STACK or IMMORTAL object
;; (bits 4, 8) is no work; a plain object (not SHARED) whose count is above
;; 1 is decremented in place; everything else is release-slow.
(define internal (fib.release void) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) done check))
  (block check
    (let ((f (call @fib.flags p)))
      (br (icmp ne (and f (i32 12)) (i32 0)) done counted)))
  (block counted (br (icmp eq (and f (i32 1)) (i32 0)) local slow))
  (block local
    (let ((cp (getelementptr %struct.fib.hdr p (i32 0) (i32 0)))
          (c (load i64 cp)))
      (br (icmp ugt c (i64 1)) dec slow)))
  (block dec (store (sub c (i64 1)) cp) (br done))
  (block slow (call @fib.release-slow p f) (br done))
  (block done (ret)))

;; §8.2: the drop of an object whose count reached zero: weak-clear if
;; flagged, the type's drop (hands the children to the worklist `wl`),
;; then free, from 16 bytes before the object in trace mode. The drop
;; never releases a child itself: a chain a million objects long would
;; otherwise be a recursion a million frames deep (spec/types.md §8.2).
(define internal (fib.drop-one void) ((ptr wl) (ptr p))
  (block entry
    (let ((f (call @fib.flags p)))
      (br (icmp ne (and f (i32 2)) (i32 0)) weak children)))
  (block weak (call @fib.weak-clear p) (br children))
  (block children
    (let ((tid (call @fib.tid p))
          (rec (getelementptr %struct.fib.typerec @fib.types tid (i32 0))))
      (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced plain)))
  (block plain
    (indirect-call (load ptr rec) (fn void (ptr ptr)) p wl)
    (call @fib.free-block p f)
    (ret))
  (block traced
    ;; The free is traced before the children's releases, as the
    ;; interpreter's trace orders them (heap/event.rs: Free, then the
    ;; releases of what the object held).
    (let ((q (getelementptr i8 p (i64 -16))))
      (call @fib.trace-line (i8 70) (load i64 q) (i8 0))
      (indirect-call (load ptr rec) (fn void (ptr ptr)) p wl)
      (call @fib.lc-put q)
      (ret))))

;; The worklist of a drop: the objects whose release is still to run,
;; as a stack in the order of the recursion it replaces (the type's drop
;; pushes its children last to first, so the first is released first and
;; its whole subtree before the second). Its fields: the buffer, the
;; number of entries, the capacity, and the inline buffer that a drop
;; starts with on its own stack frame. It is private to one drop, so
;; there is no state shared between threads.
(defstruct fib.wl (ptr i64 i64 ptr i64))

;; A worklist on the buffer `buf` of `cap` entries. Its fifth field, the mode, says what a share-marking does to the objects it queues
;; (rt/atom.lir: 1 SHARED, 2 IMMORTAL for a `def`, 3 IMMORTAL for `freeze`); a drop does not read it. The mode lives in the worklist, which
;; is private to one walk, and not in a global, so that a `freeze` and a `spawn` on two threads at once do not disturb each other.
(define internal (fib.wl-init void) ((ptr wl) (ptr buf) (i64 cap))
  (block entry
    (store buf (getelementptr %struct.fib.wl wl (i32 0) (i32 0)))
    (store (i64 0) (getelementptr %struct.fib.wl wl (i32 0) (i32 1)))
    (store cap (getelementptr %struct.fib.wl wl (i32 0) (i32 2)))
    (store buf (getelementptr %struct.fib.wl wl (i32 0) (i32 3)))
    (store (i64 1) (getelementptr %struct.fib.wl wl (i32 0) (i32 4)))
    (ret)))

;; Doubles the capacity, moving to the heap; the inline buffer is never
;; freed. A failed malloc is the trap \"out of memory\".
(define internal (fib.wl-grow void) ((ptr wl))
  (block entry
    (let ((base (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 0))))
          (len (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 1))))
          (cap (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 2))))
          (inline (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 3))))
          (cap2 (mul cap (i64 2)))
          (bigger (call @malloc (mul cap2 (i64 8)))))
      (br (icmp eq bigger (ptr null)) oom copy)))
  (block copy
    (call @memcpy bigger base (mul len (i64 8)))
    (store bigger (getelementptr %struct.fib.wl wl (i32 0) (i32 0)))
    (store cap2 (getelementptr %struct.fib.wl wl (i32 0) (i32 2)))
    (br (icmp eq base inline) done old))
  (block old (call @free base) (br done))
  (block done (ret))
  (block oom
    (call @fib.fatal-c (string \"out of memory\"))
    (unreachable)))

;; Frees the heap buffer, if the worklist moved to one.
(define internal (fib.wl-free void) ((ptr wl))
  (block entry
    (let ((base (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 0))))
          (inline (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 3)))))
      (br (icmp eq base inline) done heap)))
  (block heap (call @free base) (br done))
  (block done (ret)))

;; Appends p to the worklist, growing it when it is full.
(define internal (fib.wl-push void) ((ptr wl) (ptr p))
  (block entry
    (let ((len (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 1))))
          (cap (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 2)))))
      (br (icmp eq len cap) grow push)))
  (block grow (call @fib.wl-grow wl) (br push))
  (block push
    (let ((base (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 0))))
          (n (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 1)))))
      (store p (getelementptr ptr base n))
      (store (add n (i64 1)) (getelementptr %struct.fib.wl wl (i32 0) (i32 1)))
      (ret))))

;; Removes and returns the last entry; the worklist is not empty.
(define internal (fib.wl-pop ptr) ((ptr wl))
  (block entry
    (let ((n1 (sub (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 1))) (i64 1)))
          (base (load ptr (getelementptr %struct.fib.wl wl (i32 0) (i32 0)))))
      (store n1 (getelementptr %struct.fib.wl wl (i32 0) (i32 1)))
      (ret (load ptr (getelementptr ptr base n1))))))

(define internal (fib.wl-empty i1) ((ptr wl))
  (block entry
    (ret (icmp eq (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 1))) (i64 0)))))

;; What a drop does in place of releasing a child: queue it. Null and
;; the objects no count reaches (IMMORTAL, STACK) are skipped now, as
;; their flags never change; the count is touched only when the entry
;; is taken off the worklist, so every release runs in the order the
;; recursion ran it (the order of the frees in the trace, compiler.md §4).
(define internal (fib.defer void) ((ptr wl) (ptr p))
  (block entry (br (icmp eq p (ptr null)) done check))
  (block check
    (let ((f (call @fib.flags p)))
      (br (icmp ne (and f (i32 12)) (i32 0)) done push)))
  (block push (call @fib.wl-push wl p) (br done))
  (block done (ret)))

;; fib.release of a queued object (never null, immortal or a stack
;; object): a count that reaches zero drops it into the same worklist.
(define internal (fib.release-queued void) ((ptr wl) (ptr p))
  (block entry
    (let ((f (call @fib.flags p))
          (cp (getelementptr %struct.fib.hdr p (i32 0) (i32 0))))
      (br (icmp ne (and f (i32 1)) (i32 0)) shared local)))
  (block shared
    (let ((old (atomicrmw sub acq_rel cp (i64 1))))
      (br (icmp eq old (i64 1)) drop done)))
  (block local
    (let ((c (load i64 cp)))
      (br (icmp eq c (i64 1)) drop dec)))
  (block dec (store (sub c (i64 1)) cp) (br done))
  (block drop (call @fib.drop-one wl p) (br done))
  (block done (ret)))

;; Releases the queued objects, last in first out, until none is left.
(define internal (fib.drain void) ((ptr wl))
  (block entry (br loop))
  (block loop (br (call @fib.wl-empty wl) done pop))
  (block pop
    (call @fib.release-queued wl (call @fib.wl-pop wl))
    (br loop))
  (block done (ret)))

;; §8.2: the drop of an object whose count reached zero, with every
;; release it causes: the native stack stays as deep as one drop.
(define internal (fib.drop void) ((ptr p))
  (block entry
    (let ((wl (alloca %struct.fib.wl))
          (buf (alloca (align 8) i8 (i32 256))))
      (call @fib.wl-init wl buf (i64 32))
      (call @fib.drop-one wl p)
      (call @fib.drain wl)
      (call @fib.wl-free wl)
      (ret))))

;; A stack object's scope end (§6.11): its children are released; it
;; is not freed. The type's drop is slot 0 of the type table.
(define internal (fib.drop-fields void) ((ptr p))
  (block entry
    (let ((wl (alloca %struct.fib.wl))
          (buf (alloca (align 8) i8 (i32 256)))
          (rec (getelementptr %struct.fib.typerec @fib.types (call @fib.tid p) (i32 0))))
      (call @fib.wl-init wl buf (i64 32))
      (indirect-call (load ptr rec) (fn void (ptr ptr)) p wl)
      (call @fib.drain wl)
      (call @fib.wl-free wl)
      (ret))))

;; §8.2: neither SHARED, IMMORTAL, STACK nor HAS-WEAK, and count 1.
(define internal (fib.unique? i1) ((ptr p))
  (block entry
    (let ((f (call @fib.flags p)))
      (br (icmp ne (and f (i32 15)) (i32 0)) no test)))
  (block no (ret (i1 0)))
  (block test (ret (icmp eq (load i64 (getelementptr %struct.fib.hdr p (i32 0) (i32 0))) (i64 1)))))

;; The size of an object: its type's record.
(define internal (fib.size-of i64) ((i32 tid))
  (block entry
    (ret (load i64 (getelementptr %struct.fib.typerec @fib.types tid (i32 3))))))

;; While the init functions of the `def`s run (L15), the text \"def NAME: \"
;; of the `def` being made, else null: a trap in an initialiser names it.
(global internal fib.initdef ptr (ptr null))

;; The init functions are done: in trace mode the line \"I k\", k the last
;; ordinal handed out. The objects the initialisers allocated (and
;; made immortal) are not part of the trace (compiler.md §4), as the
;; interpreter's trace leaves out its `def` evaluation: the reader of
;; the trace drops every line up to this one and numbers from k.
(define internal (fib.init-done void) ()
  (block entry
    (store (ptr null) @fib.initdef)
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced done))
  (block traced
    (call @fib.trace-line (i8 73) (load i64 @fib.ordinal) (i8 0))
    (br done))
  (block done (ret)))

;; §8.12, §2.11: \"trap: MESSAGE\\n\" to fd 2, then abort.
;; In a macro module (the trap hook is set) the trap fails the expansion
;; instead (macros/bridge.rs): `pos` is the C string POS of the faulting
;; expression, or null where the runtime does not know it. The hook does
;; not return.
(define internal (fib.trap-hooked void) ((ptr pos) (ptr bytes) (i64 n))
  (block entry
    (let ((hook (load ptr @fibm.trap-hook))
          (cx (load ptr @fibm.hook-cx)))
      (indirect-call hook (fn void (ptr ptr ptr i64)) cx pos bytes n)
      (unreachable))))

;; `trap` and a fault of a macro module's own code, with the position.
(define internal (fib.trap-at void) ((ptr pos) (ptr s))
  (block entry
    (call @fib.trap-hooked pos (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0))
      (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))
    (unreachable)))

(define internal (fib.trap-at-c void) ((ptr pos) (ptr msg))
  (block entry
    (call @fib.trap-hooked pos msg (call @strlen msg))
    (unreachable)))

;; \"trap: MESSAGE\\n\" to fd 2, then abort: what a trap is where it is not isolated, and what a fatal failure is everywhere.
(define internal (fib.fatal-bytes void) ((ptr bytes) (i64 n))
  (block entry
    (call @write (i32 2) (string \"trap: \") (i64 6))
    (let ((pre (load ptr @fib.initdef)))
      (br (icmp eq pre (ptr null)) body named)))
  (block named
    (call @write (i32 2) pre (call @strlen pre))
    (br body))
  (block body
    (call @write (i32 2) bytes n)
    (call @write (i32 2) (string \"\\n\") (i64 1))
    (call @abort)
    (unreachable)))

;; A failure the program cannot survive whatever runs it: out of memory (a handler and the unwinder allocate), a thread or a
;; worker that cannot be started. Never isolated, never caught (docs/design/exceptions.md 1.2, the owner's list of 2026-10-05).
(define internal (fib.fatal-c void) ((ptr msg))
  (block entry
    (call @fib.fatal-bytes msg (call @strlen msg))
    (unreachable)))

;; A trap on the thread of a spawned task ends that task, not the process (docs/design/exceptions.md 4.1, stage 1): the message
;; goes to fd 2 as `trap in task: MESSAGE` in ONE write (a trace line of another thread must not land inside it), a share-marked copy of it is stored as the task's failure, the task completes (state
;; done, its waiters woken: a joiner finds the failure and traps in its turn, or try-join returns it), the thread releases its
;; count of the task and ends. What the task's frames owned is abandoned (never freed): audit: abandoned. A pool task (sched.lir)
;; fails the worker's chain of tasks instead, and the worker is replaced (fib.sched-fail).
(define internal (fib.fail-task void) ((ptr task) (ptr bytes) (i64 n))
  (block entry
    (let ((line (call @malloc (add n (i64 16)))))
      (br (icmp eq line (ptr null)) record print)))
  (block print
    (call @memcpy line (string \"trap in task: \") (i64 14))
    (call @memcpy (getelementptr i8 line (i64 14)) bytes n)
    (store (i8 10) (getelementptr i8 line (add n (i64 14))))
    (call @write (i32 2) line (add n (i64 15)))
    (call @free line)
    (br record))
  (block record
    (let ((msg (call @fib.str-from-bytes bytes n)))
      (call @fib.share msg)
      (atomic-store release msg (getelementptr %struct.fib.task task (i32 0) (i32 10)))
      (br (call @fib.sched-pool-task task) pool thread)))
  (block pool
    (call @fib.sched-fail task msg)
    (unreachable))
  (block thread
    (call @fib.task-complete task)
    (call @fib.release task)
    (call @fib.thread-done)
    (call @pthread_exit (ptr null))
    (unreachable)))

(define internal (fib.trap-bytes void) ((ptr bytes) (i64 n))
  (block entry
    (br (icmp ne (load ptr @fibm.trap-hook) (ptr null)) hooked check))
  (block hooked
    (call @fib.trap-hooked (ptr null) bytes n)
    (unreachable))
  (block check
    (br (call @fib.in-finally) fin task))
  (block fin
    (call @fib.fatal-finally bytes n)
    (unreachable))
  (block task
    (let ((tk (call @pthread_getspecific (load i32 @fib.task-key))))
      (br (icmp ne tk (ptr null)) in-task plain)))
  (block in-task
    (call @fib.fail-task (call @pthread_getspecific (load i32 @fib.task-key)) bytes n)
    (unreachable))
  (block plain
    (call @fib.fatal-bytes bytes n)
    (unreachable)))

(define internal (fib.trap-c void) ((ptr msg))
  (block entry
    (call @fib.trap-bytes msg (call @strlen msg))
    (unreachable)))

(define internal (fib.trap void) ((ptr s))
  (block entry
    (call @fib.trap-bytes (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0))
      (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))
    (unreachable)))

;; A fresh object of the same type with the bytes after the header
;; copied (§8.3: a changed copy for a unique write that cannot be in
;; place); the caller retains the children and replaces the field.
(define internal (fib.copy-object ptr) ((ptr p) (i64 size) (i32 tid))
  (block entry
    (let ((q (call @fib.alloc size tid)))
      (call @memcpy (getelementptr i8 q (i64 16)) (getelementptr i8 p (i64 16)) (sub size (i64 16)))
      (ret q))))

;; The interpreter's message for an index out of range (eval/arrays.rs).
(define internal (fib.trap-index void) ((i64 i) (i64 n))
  (block entry
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"array index %lld out of range 0..%lld\") i n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable))))

;; ---- catching traps (stage 2, docs/design/exceptions.md 4.2, ADR 0009)
;; A program that calls `catch-run` is compiled so that its functions return a failure next to their value (`{ T ptr }`, or `ptr` for
;; unit): null when they returned, else the failure in flight, which every caller releases its frame for and returns in its turn. The
;; failure is a thrown object, or a str message tagged with bit 0 (a trap). A trap unwinds only while a catch-run is active on its
;; thread and no finally clause runs for an unwinding; otherwise it is the trap of fib.trap-bytes, as before (abort, or the task's failure).

;; The catch state of a thread: the number of catch-runs active, the failure caught last (until catch-run's caller takes it), and the
;; number of finally clauses running for an unwinding.
(defstruct fib.exc (i64 ptr i64))

(define internal (fib.exc-state ptr) ()
  (block entry
    (let ((s (call @pthread_getspecific (load i32 @fib.exc-key))))
      (br (icmp eq s (ptr null)) make done)))
  (block make
    (let ((n (call @calloc (i64 1) (i64 24))))
      (br (icmp eq n (ptr null)) oom set)))
  (block oom
    (call @fib.fatal-c (string \"out of memory\"))
    (unreachable))
  (block set
    (call @pthread_setspecific (load i32 @fib.exc-key) n)
    (ret n))
  (block done (ret s)))

;; Whether a trap on this thread unwinds: a catch-run is active.
(define internal (fib.catching i1) ()
  (block entry
    (let ((s (call @pthread_getspecific (load i32 @fib.exc-key))))
      (br (icmp eq s (ptr null)) no yes)))
  (block no (ret (i1 0)))
  (block yes (ret (icmp sgt (load i64 (getelementptr %struct.fib.exc s (i32 0) (i32 0))) (i64 0)))))

;; Whether a finally clause runs for an unwinding on this thread (a trap there is fatal).
(define internal (fib.in-finally i1) ()
  (block entry
    (let ((s (call @pthread_getspecific (load i32 @fib.exc-key))))
      (br (icmp eq s (ptr null)) no yes)))
  (block no (ret (i1 0)))
  (block yes (ret (icmp sgt (load i64 (getelementptr %struct.fib.exc s (i32 0) (i32 2))) (i64 0)))))

(define internal (fib.catch-enter ptr) ()
  (block entry
    (let ((s (call @fib.exc-state))
          (dp (getelementptr %struct.fib.exc s (i32 0) (i32 0))))
      (store (add (load i64 dp) (i64 1)) dp)
      (ret s))))

;; The end of a catch-run: the depth restored; 0 when the body returned, else the failure is kept for the caller to take (1: a trap's
;; message, 2: a thrown object).
(define internal (fib.catch-leave i64) ((ptr s) (ptr ex))
  (block entry
    (let ((dp (getelementptr %struct.fib.exc s (i32 0) (i32 0))))
      (store (sub (load i64 dp) (i64 1)) dp)
      (br (icmp eq ex (ptr null)) ok caught)))
  (block ok (ret (i64 0)))
  (block caught
    (let ((sp (getelementptr %struct.fib.exc s (i32 0) (i32 1))))
      (call @fib.release (inttoptr ptr (and (ptrtoint i64 (load ptr sp)) (i64 -2))))
      (store ex sp)
      (ret (select (icmp ne (and (ptrtoint i64 ex) (i64 1)) (i64 0)) (i64 1) (i64 2))))))

;; The failure caught last, taken (its count moves to the caller): `want` 1 the message str of a trap, 0 a thrown object; asking for the
;; other kind, or when nothing was caught, is a trap.
(define internal (fib.caught-take ptr) ((i64 want))
  (block entry
    (let ((s (call @fib.exc-state))
          (sp (getelementptr %struct.fib.exc s (i32 0) (i32 1)))
          (ex (load ptr sp))
          (tag (and (ptrtoint i64 ex) (i64 1))))
      (br (icmp eq ex (ptr null)) none kind)))
  (block kind (br (icmp eq tag want) take none))
  (block none
    (call @fib.trap-c (string \"caught: no failure of that kind was caught\"))
    (unreachable))
  (block take
    (store (ptr null) sp)
    (ret (inttoptr ptr (and (ptrtoint i64 ex) (i64 -2))))))

;; A trap of the message at bytes: the failure to unwind with when a catch is active (a fresh tagged str), else the trap as before.
(define internal (fib.raise-bytes ptr) ((ptr bytes) (i64 n))
  (block entry
    (br (icmp ne (load ptr @fibm.trap-hook) (ptr null)) plain check))
  (block check (br (call @fib.catching) unwind plain))
  (block plain
    (call @fib.trap-bytes bytes n)
    (unreachable))
  (block unwind
    (let ((m (call @fib.str-from-bytes bytes n)))
      (ret (inttoptr ptr (or (ptrtoint i64 m) (i64 1)))))))

(define internal (fib.raise-c ptr) ((ptr msg))
  (block entry (ret (call @fib.raise-bytes msg (call @strlen msg)))))

(define internal (fib.raise ptr) ((ptr s))
  (block entry
    (ret (call @fib.raise-bytes (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0))
           (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3)))))))

(define internal (fib.raise-index ptr) ((i64 i) (i64 n))
  (block entry
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"array index %lld out of range 0..%lld\") i n)))
      (ret (call @fib.raise-bytes buf (sext i64 len))))))

;; `throw-object`: the object (its count) is the failure; outside a catch there is no one to take it.
(define internal (fib.raise-object ptr) ((ptr p))
  (block entry (br (call @fib.catching) unwind plain))
  (block plain
    (call @fib.trap-c (string \"throw: no catch is active\"))
    (unreachable))
  (block unwind (ret p)))

;; A failure that reached a function that cannot pass it on (a def's initialiser, an async body, a region that left a slot moved from):
;; the trap it was, reported as before.
(define internal (fib.unwound-fatal void) ((ptr ex))
  (block entry
    (br (icmp ne (and (ptrtoint i64 ex) (i64 1)) (i64 0)) msg obj))
  (block msg
    (let ((s (inttoptr ptr (and (ptrtoint i64 ex) (i64 -2)))))
      (call @fib.trap-bytes (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0))
        (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))
      (unreachable)))
  (block obj
    (call @fib.trap-c (string \"a thrown exception reached code that cannot unwind\"))
    (unreachable)))

;; The failure a thread's entry finds (none can reach it: no catch is active below it).
(define internal (fib.unwound-check void) ((ptr ex))
  (block entry (br (icmp eq ex (ptr null)) done bad))
  (block bad
    (call @fib.unwound-fatal ex)
    (unreachable))
  (block done (ret)))

;; A finally clause run for an unwinding: no catch is active inside it, and a trap there is fatal. Returns the depth to restore.
(define internal (fib.finally-enter i64) ()
  (block entry
    (let ((s (call @fib.exc-state))
          (dp (getelementptr %struct.fib.exc s (i32 0) (i32 0)))
          (d (load i64 dp))
          (fp (getelementptr %struct.fib.exc s (i32 0) (i32 2))))
      (store (i64 0) dp)
      (store (add (load i64 fp) (i64 1)) fp)
      (ret d))))

(define internal (fib.finally-leave void) ((i64 d))
  (block entry
    (let ((s (call @fib.exc-state))
          (fp (getelementptr %struct.fib.exc s (i32 0) (i32 2))))
      (store d (getelementptr %struct.fib.exc s (i32 0) (i32 0)))
      (store (sub (load i64 fp) (i64 1)) fp)
      (ret))))

(define internal (fib.fatal-finally void) ((ptr bytes) (i64 n))
  (block entry
    (call @write (i32 2) (string \"trap: in a finally clause run while unwinding: \") (i64 47))
    (call @write (i32 2) bytes n)
    (call @write (i32 2) (string \"\\n\") (i64 1))
    (call @abort)
    (unreachable)))

;; (hash x) on a float (types §2.12): the bits of the value as a double,
;; except that -0.0 hashes as 0.0 and every NaN as the quiet NaN's bits
;; 0x7ff8000000000000, so that = implies equal hashes (eval/arith.rs
;; float_hash). A float is widened first: the hash of an f32 is that of
;; its f64.
(define internal (fib.double-hash i64) ((double x))
  (block entry
    (let ((bits (bitcast i64 x))
          (is-zero (fcmp oeq x (double 0.0)))
          (is-nan (fcmp uno x x)))
      (ret (select is-nan (i64 9221120237041090560) (select is-zero (i64 0) bits))))))
")

;; str.lir
(def RT-STR: str
";; fib.rt, strings (types §8.3): a str is the header, the byte length,
;; then the UTF-8 bytes and a NUL in the same allocation. Every
;; function allocates exactly where the interpreter's string natives do
;; (eval/strings.rs).
(define internal (fib.str-len i64) ((ptr s))
  (block entry (ret (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))))

(define internal (fib.str-bytes-ptr ptr) ((ptr s))
  (block entry (ret (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0)))))

;; A fresh str of n bytes (type id 0), NUL-terminated; the bytes are
;; the caller's to fill.
(define internal (fib.str-new ptr) ((i64 n))
  (block entry
    (let ((s (call @fib.alloc (add n (i64 25)) (i32 0))))
      (store n (getelementptr %struct.fib.str s (i32 0) (i32 3)))
      (store (i8 0) (getelementptr %struct.fib.str s (i32 0) (i32 4) n))
      (ret s))))

;; A fresh str of the n bytes at p.
(define internal (fib.str-from-bytes ptr) ((ptr p) (i64 n))
  (block entry
    (let ((s (call @fib.str-new n)))
      (call @memcpy (call @fib.str-bytes-ptr s) p n)
      (ret s))))

(define internal (fib.str-copy ptr) ((ptr s))
  (block entry
    (ret (call @fib.str-from-bytes (call @fib.str-bytes-ptr s) (call @fib.str-len s)))))

;; (hash s) on a str: 64-bit FNV-1a over the bytes (eval/arith.rs fnv).
(define internal (fib.str-hash i64) ((ptr s))
  (block entry
    (let ((p (call @fib.str-bytes-ptr s))
          (n (call @fib.str-len s)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2)))
          (h (phi i64 (entry (i64 -3750763034362895579)) (body h2))))
      (br (icmp slt i n) body done)))
  (block body
    (let ((b (zext i64 (load i8 (getelementptr i8 p i))))
          (h2 (mul (xor h b) (i64 1099511628211)))
          (i2 (add i (i64 1))))
      (br loop)))
  (block done (ret h)))

;; The native Show instances (types §2.12), each a fresh str with the
;; interpreter's text (eval/arith.rs show).
(define internal (fib.show-int ptr) ((i64 n))
  (block entry
    (let ((buf (alloca i8 (i32 24)))
          (len (call @snprintf buf (i64 24) (string \"%lld\") n)))
      (ret (call @fib.str-from-bytes buf (sext i64 len))))))

(define internal (fib.show-ptr ptr) ((ptr p))
  (block entry
    (let ((buf (alloca i8 (i32 24)))
          (len (call @snprintf buf (i64 24) (string \"#ptr%llx\") (ptrtoint i64 p))))
      (ret (call @fib.str-from-bytes buf (sext i64 len))))))

(define internal (fib.show-bool ptr) ((i1 b))
  (block entry (br b yes no))
  (block yes (ret (call @fib.str-from-bytes (string \"true\") (i64 4))))
  (block no (ret (call @fib.str-from-bytes (string \"false\") (i64 5)))))

;; show of a float (types §2.12, Decided 2026-10-01, stdlib design C12):
;; Clojure's text, which is Java's Double.toString (Float.toString at
;; single width), the interpreter's (eval/floattext.rs float_text). The
;; digits are the shortest decimal that reads back at the value's width,
;; the one nearest the value among those of that length (an exact tie
;; goes up, where Java takes the even digit), except that when one digit
;; would do the nearest decimal of two is written, as Java does (4.9E-324
;; for the smallest double, not 5E-324). The layout is positional with at
;; least one digit after the point for 1e-3 <= |x| < 1e7, else d.dddE<e>
;; with at least one digit after the point and `-` on a negative
;; exponent only; ##NaN, ##Inf, ##-Inf (Clojure's reader forms, not
;; Java's text, X3). The digits are found with
;; libc:
;;
;; - `%.800e` writes the exact decimal expansion of the value (a double
;;   has at most 767 significant digits), whose first n digits D are
;;   the n-digit decimal just below it in magnitude;
;; - for n = 2, 3, .. the decimals of n digits that can read back are
;;   D and D plus one unit in the last place, the two that bracket the
;;   value (every other n-digit decimal is farther, and the values that
;;   read back to x are an interval around it). Starting at 2 gives the
;;   two-digit rule: if a one-digit decimal reads back, so does one of
;;   the two brackets at n = 2 (the interval is convex and holds the
;;   one-digit decimal, a two-digit decimal), and the nearer is written;
;;   its trailing zero, if any, is dropped again by `fib.fp-text`;
;; - each one is read back with strtod (strtof at single width), so the
;;   boundaries of the interval and the narrow interval below a power
;;   of two are decided by libc's rounding and not by a rule of ours;
;; - the first n where one reads back wins; when both do, the nearer:
;;   D plus a unit is nearer when the next digit of the expansion is 5
;;   or more (a tie, 5 then zeros, goes up).
(declare strtod double (ptr ptr))
(declare strtof float (ptr ptr))
(declare memset ptr (ptr i32 i64))

;; Whether the %e text in buf reads back to x, at single precision or
;; double.
(define internal (fib.fp-exact i1) ((ptr buf) (double x) (i1 single))
  (block entry (br single narrow wide))
  (block wide
    (ret (icmp eq (bitcast i64 (call @strtod buf (ptr null))) (bitcast i64 x))))
  (block narrow
    (ret (icmp eq (bitcast i32 (call @strtof buf (ptr null))) (bitcast i32 (fptrunc float x))))))

;; The digits of a %e text (no sign, no point) into digits, its
;; exponent into exp; returns the count of digits.
(define internal (fib.fp-parse i64) ((ptr buf) (ptr digits) (ptr exp))
  (block entry
    (let ((neg (icmp eq (load i8 buf) (i8 45)))
          (start (select neg (i64 1) (i64 0))))
      (br scan)))
  (block scan
    (let ((i (phi i64 (entry start) (skip i2) (keep i2)))
          (n (phi i64 (entry (i64 0)) (skip n) (keep n2)))
          (c (load i8 (getelementptr i8 buf i)))
          (i2 (add i (i64 1))))
      (br (icmp eq c (i8 101)) expo point?)))
  (block point? (br (icmp eq c (i8 46)) skip keep))
  (block keep
    (store c (getelementptr i8 digits n))
    (let ((n2 (add n (i64 1)))) (br scan)))
  (block skip (br scan))
  (block expo
    (let ((s (load i8 (getelementptr i8 buf i2)))
          (eneg (icmp eq s (i8 45)))
          (j0 (add i2 (i64 1))))
      (br eloop)))
  (block eloop
    (let ((j (phi i64 (expo j0) (edigit j2)))
          (e (phi i64 (expo (i64 0)) (edigit e2)))
          (d (load i8 (getelementptr i8 buf j))))
      (br (icmp eq d (i8 0)) edone edigit)))
  (block edigit
    (let ((e2 (add (mul e (i64 10)) (sext i64 (sub d (i8 48)))))
          (j2 (add j (i64 1))))
      (br eloop)))
  (block edone
    (store (select eneg (sub (i64 0) e) e) exp)
    (ret n)))

;; The positional text of the value d1.d2..dn x 10^e into out, with a
;; leading - when neg and .0 when integral; returns its length. Used for
;; -3 <= e <= 6 (fib.fp-text), where the text is at most 17 digits, the
;; point and the zeros that pad to it.
(define internal (fib.fp-layout i64) ((ptr out) (ptr digits) (i64 n) (i64 e) (i1 neg))
  (block entry
    (store (i8 45) out)
    (let ((o0 (select neg (i64 1) (i64 0)))
          (ef (add e (i64 1))))
      (br (icmp slt e (i64 0)) small big)))
  (block big
    (let ((ni (select (icmp slt n ef) n ef))
          (pad (sub ef ni))
          (o1 (add o0 ef)))
      (call @memcpy (getelementptr i8 out o0) digits ni)
      (call @memset (getelementptr i8 out (add o0 ni)) (i32 48) pad)
      (br (icmp sgt n ef) frac intg)))
  (block frac
    (let ((nf (sub n ef)))
      (store (i8 46) (getelementptr i8 out o1))
      (call @memcpy (getelementptr i8 out (add o1 (i64 1))) (getelementptr i8 digits ef) nf)
      (ret (add (add o1 (i64 1)) nf))))
  (block intg
    (store (i8 46) (getelementptr i8 out o1))
    (store (i8 48) (getelementptr i8 out (add o1 (i64 1))))
    (ret (add o1 (i64 2))))
  (block small
    (let ((z (sub (i64 -1) e))
          (o2 (add o0 (i64 2))))
      (store (i8 48) (getelementptr i8 out o0))
      (store (i8 46) (getelementptr i8 out (add o0 (i64 1))))
      (call @memset (getelementptr i8 out o2) (i32 48) z)
      (call @memcpy (getelementptr i8 out (add o2 z)) digits n)
      (ret (add (add o2 z) n)))))

;; The scientific text of the value d1.d2..dn x 10^e into out, as Java
;; writes it: d1, a point, the other digits or a 0, E, the exponent with
;; a - when it is negative; with a leading - when neg. Returns its length.
(define internal (fib.fp-sci i64) ((ptr out) (ptr digits) (i64 n) (i64 e) (i1 neg))
  (block entry
    (store (i8 45) out)
    (let ((o0 (select neg (i64 1) (i64 0)))
          (more (icmp sgt n (i64 1)))
          (nf (select more (sub n (i64 1)) (i64 1)))
          (end (add (add o0 (i64 2)) nf)))
      (store (load i8 digits) (getelementptr i8 out o0))
      (store (i8 46) (getelementptr i8 out (add o0 (i64 1))))
      (br more fraction zero)))
  (block fraction
    (call @memcpy (getelementptr i8 out (add o0 (i64 2))) (getelementptr i8 digits (i64 1)) nf)
    (br tail))
  (block zero
    (store (i8 48) (getelementptr i8 out (add o0 (i64 2))))
    (br tail))
  (block tail
    (let ((k (call @snprintf (getelementptr i8 out end) (i64 16) (string \"E%d\") (trunc i32 e))))
      (ret (add end (sext i64 k))))))

;; The Java text of the value d1.d2..dn x 10^e into out (n digits, the
;; last of which may be a 0, and then dropped), with a leading - when
;; neg; returns its length: positional for -3 <= e <= 6, else scientific.
(define internal (fib.fp-text i64) ((ptr out) (ptr digits) (i64 n) (i64 e) (i1 neg))
  (block entry (br trim))
  (block trim
    (let ((k (phi i64 (entry n) (drop k2)))
          (last (load i8 (getelementptr i8 digits (sub k (i64 1))))))
      (br (and (icmp sgt k (i64 1)) (icmp eq last (i8 48))) drop done)))
  (block drop
    (let ((k2 (sub k (i64 1))))
      (br trim)))
  (block done
    (br (or (icmp slt e (i64 -3)) (icmp sgt e (i64 6))) sci pos))
  (block sci (ret (call @fib.fp-sci out digits k e neg)))
  (block pos (ret (call @fib.fp-layout out digits k e neg))))

;; Whether the decimal d.ddd e<e> of the n digits, with a leading - when
;; neg, reads back to x: it is written into buf (at least 40 bytes) and
;; read with strtod or strtof.
(define internal (fib.fp-reads i1) ((ptr buf) (ptr digits) (i64 n) (i64 e) (i1 neg) (double x) (i1 single))
  (block entry
    (store (i8 45) buf)
    (let ((at (getelementptr i8 buf (select neg (i64 1) (i64 0))))
          (first (zext i32 (load i8 digits)))
          (prec (trunc i32 (sub n (i64 1))))
          (rest (getelementptr i8 digits (i64 1))))
      (call @snprintf at (i64 40) (string \"%c.%.*se%d\") first prec rest (trunc i32 e))
      (ret (call @fib.fp-exact buf x single)))))

;; Adds one to the n-digit decimal at d, in place. Returns whether it
;; was all nines: then it is now 1 then zeros, and the caller adds one
;; to the exponent.
(define internal (fib.fp-bump i1) ((ptr d) (i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry n) (nine k))))
      (br (icmp eq i (i64 0)) carry step)))
  (block step
    (let ((k (sub i (i64 1)))
          (p (getelementptr i8 d k))
          (c (load i8 p)))
      (br (icmp eq c (i8 57)) nine bump)))
  (block nine
    (store (i8 48) p)
    (br loop))
  (block bump
    (store (add c (i8 1)) p)
    (ret (i1 0)))
  (block carry
    (store (i8 49) d)
    (ret (i1 1))))

;; The n-digit decimal to show, if one reads back: ds holds the digits of
;; the exact expansion and e its exponent. Of the two decimals that
;; bracket the value, D (the first n digits) and D plus a unit, the one
;; that reads back is written into cand with its exponent into eout and
;; 1 is returned; when both read back, the nearer; when neither, 0.
(define internal (fib.fp-at i1) ((ptr ds) (i64 n) (i64 e) (ptr cand) (ptr buf) (i1 neg) (double x) (i1 single) (ptr eout))
  (block entry
    (call @memcpy cand ds n)
    (let ((down (call @fib.fp-reads buf cand n e neg x single))
          (carry (call @fib.fp-bump cand n))
          (e2 (add e (zext i64 carry)))
          (up (call @fib.fp-reads buf cand n e2 neg x single))
          (half (icmp uge (load i8 (getelementptr i8 ds n)) (i8 53)))
          (nearer (or half (xor down (i1 1)))))
      (br (and up nearer) take-up check-down)))
  (block take-up
    (store e2 eout)
    (ret (i1 1)))
  (block check-down (br down take-down none))
  (block take-down
    (call @memcpy cand ds n)
    (store e eout)
    (ret (i1 1)))
  (block none (ret (i1 0))))

(define internal (fib.show-fp ptr) ((double x) (i1 single))
  (block entry (br (fcmp uno x x) nan finite))
  (block nan (ret (call @fib.str-from-bytes (string \"##NaN\") (i64 5))))
  (block finite
    (let ((buf (alloca i8 (i32 832)))
          (len0 (call @snprintf buf (i64 832) (string \"%.800e\") x))
          (c0 (load i8 buf))
          (c1 (load i8 (getelementptr i8 buf (i64 1)))))
      (br (or (icmp eq c0 (i8 105)) (icmp eq c1 (i8 105))) inf prep)))
  (block inf
    (br (icmp eq c0 (i8 45)) minus plus))
  (block minus (ret (call @fib.str-from-bytes (string \"##-Inf\") (i64 6))))
  (block plus (ret (call @fib.str-from-bytes (string \"##Inf\") (i64 5))))
  (block prep
    (let ((ds (alloca i8 (i32 832)))
          (exp (alloca i64))
          (eout (alloca i64))
          (cand (alloca i8 (i32 24)))
          (cbuf (alloca i8 (i32 48)))
          (neg (icmp eq c0 (i8 45))))
      (call @fib.fp-parse buf ds exp)
      (let ((e0 (load i64 exp)))
        (br search))))
  (block search
    (let ((n (phi i64 (prep (i64 2)) (more n2)))
          (hit (call @fib.fp-at ds n e0 cand cbuf neg x single eout)))
      (br hit found more)))
  (block more
    (let ((n2 (add n (i64 1))))
      (br (icmp sgt n2 (i64 17)) bad search)))
  (block bad
    (call @fib.trap-c (string \"show: no shortest digits\"))
    (unreachable))
  (block found
    (let ((out (alloca i8 (i32 400)))
          (m (call @fib.fp-text out cand n (load i64 eout) neg)))
      (ret (call @fib.str-from-bytes out m)))))

(define internal (fib.show-double ptr) ((double x))
  (block entry (ret (call @fib.show-fp x (i1 0)))))

(define internal (fib.show-float ptr) ((float x))
  (block entry (ret (call @fib.show-fp (fpext double x) (i1 1)))))

;; The UTF-8 encoding of the scalar value c.
(define internal (fib.show-char ptr) ((i32 c))
  (block entry
    (let ((buf (alloca i8 (i32 4))))
      (br (icmp slt c (i32 128)) one more1)))
  (block one
    (store (trunc i8 c) buf)
    (ret (call @fib.str-from-bytes buf (i64 1))))
  (block more1 (br (icmp slt c (i32 2048)) two more2))
  (block two
    (store (trunc i8 (or (lshr c (i32 6)) (i32 192))) buf)
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (ret (call @fib.str-from-bytes buf (i64 2))))
  (block more2 (br (icmp slt c (i32 65536)) three four))
  (block three
    (store (trunc i8 (or (lshr c (i32 12)) (i32 224))) buf)
    (store (trunc i8 (or (and (lshr c (i32 6)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 2)))
    (ret (call @fib.str-from-bytes buf (i64 3))))
  (block four
    (store (trunc i8 (or (lshr c (i32 18)) (i32 240))) buf)
    (store (trunc i8 (or (and (lshr c (i32 12)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 1)))
    (store (trunc i8 (or (and (lshr c (i32 6)) (i32 63)) (i32 128))) (getelementptr i8 buf (i64 2)))
    (store (trunc i8 (or (and c (i32 63)) (i32 128))) (getelementptr i8 buf (i64 3)))
    (ret (call @fib.str-from-bytes buf (i64 4)))))

(define internal (fib.str-cmp i32) ((ptr a) (ptr b))
  (block entry
    (let ((na (call @fib.str-len a))
          (nb (call @fib.str-len b))
          (n (select (icmp slt na nb) na nb))
          (c (call @memcmp (call @fib.str-bytes-ptr a) (call @fib.str-bytes-ptr b) n)))
      (br (icmp ne c (i32 0)) differ prefix)))
  (block differ (ret c))
  (block prefix (ret (select (icmp slt na nb) (i32 -1) (select (icmp sgt na nb) (i32 1) (i32 0))))))

(define internal (fib.str-eq i1) ((ptr a) (ptr b))
  (block entry (ret (icmp eq (call @fib.str-cmp a b) (i32 0)))))

(define internal (fib.str-starts-with i1) ((ptr s) (ptr prefix))
  (block entry
    (let ((n (call @fib.str-len s))
          (m (call @fib.str-len prefix)))
      (br (icmp sgt m n) no cmp)))
  (block no (ret (i1 0)))
  (block cmp (ret (icmp eq (call @memcmp (call @fib.str-bytes-ptr s) (call @fib.str-bytes-ptr prefix) m) (i32 0)))))

(define internal (fib.str-concat ptr) ((ptr a) (ptr b))
  (block entry
    (let ((na (call @fib.str-len a))
          (nb (call @fib.str-len b))
          (s (call @fib.str-new (add na nb)))
          (d (call @fib.str-bytes-ptr s)))
      (call @memcpy d (call @fib.str-bytes-ptr a) na)
      (call @memcpy (getelementptr i8 d na) (call @fib.str-bytes-ptr b) nb)
      (ret s))))

;; The interpreter's traps for a bad slice (eval/strings.rs).
(define internal (fib.str-slice ptr) ((ptr s) (i64 i) (i64 j))
  (block entry
    (let ((n (call @fib.str-len s))
          (bad (or (icmp slt i (i64 0)) (or (icmp sgt i j) (icmp sgt j n)))))
      (br bad range check-i)))
  (block range
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"str-slice [%lld, %lld) out of range 0..%lld\") i j n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block check-i
    (let ((p (call @fib.str-bytes-ptr s)))
      (br (call @fib.splits-char p i n) split check-j)))
  (block check-j (br (call @fib.splits-char p j n) split ok))
  (block split
    (let ((buf2 (alloca i8 (i32 96)))
          (len2 (call @snprintf buf2 (i64 96) (string \"str-slice [%lld, %lld) splits a character\") i j)))
      (call @fib.trap-bytes buf2 (sext i64 len2))
      (unreachable)))
  (block ok
    (let ((m (sub j i))
          (r (call @fib.str-new m)))
      (call @memcpy (call @fib.str-bytes-ptr r) (getelementptr i8 p i) m)
      (ret r))))

;; Whether byte k of a string of n bytes is a UTF-8 continuation byte
;; (10xxxxxx): a boundary there splits a character.
(define internal (fib.splits-char i1) ((ptr p) (i64 k) (i64 n))
  (block entry (br (icmp sge k n) no test))
  (block no (ret (i1 0)))
  (block test (ret (icmp eq (and (load i8 (getelementptr i8 p k)) (i8 -64)) (i8 -128)))))

;; (str-byte-at s i): byte i of s, with the interpreter's trap (eval/strings.rs).
;; An unsigned compare refuses a negative index with the rest.
(define internal (fib.str-byte-at i8) ((ptr s) (i64 i))
  (block entry
    (let ((n (call @fib.str-len s)))
      (br (icmp ult i n) ok bad)))
  (block bad
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"str-byte-at: index %lld out of range 0..%lld\") i n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok (ret (load i8 (getelementptr i8 (call @fib.str-bytes-ptr s) i)))))

;; (str-find s pat from): the byte offset of the first pat at or after
;; from, or -1; the interpreter's traps for a bad from (eval/strings.rs).
;; The caller makes the Option. Nothing is allocated here.
(define internal (fib.str-find i64) ((ptr s) (ptr pat) (i64 from))
  (block entry
    (let ((n (call @fib.str-len s)))
      (br (or (icmp slt from (i64 0)) (icmp sgt from n)) range check)))
  (block range
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"str-find: from %lld out of range 0..%lld\") from n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block check
    (let ((p (call @fib.str-bytes-ptr s)))
      (br (call @fib.splits-char p from n) split scan)))
  (block split
    (let ((buf2 (alloca i8 (i32 96)))
          (len2 (call @snprintf buf2 (i64 96) (string \"str-find: from %lld splits a character\") from)))
      (call @fib.trap-bytes buf2 (sext i64 len2))
      (unreachable)))
  (block scan
    (let ((m (call @fib.str-len pat))
          (q (call @fib.str-bytes-ptr pat))
          (last (sub n m)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (scan from) (next i2))))
      (br (icmp sgt i last) none try)))
  ;; the first byte decides almost every position: the libc call is made only where it matches (an empty pattern matches at once)
  (block try
    (br (icmp eq m (i64 0)) hit first))
  (block first
    (br (icmp eq (load i8 (getelementptr i8 p i)) (load i8 q)) full next))
  (block full
    (br (icmp eq (call @memcmp (getelementptr i8 p i) q m) (i32 0)) hit next))
  (block next
    (let ((i2 (add i (i64 1))))
      (br loop)))
  (block hit (ret i))
  (block none (ret (i64 -1))))

;; (str-bytes s): a fresh (Array i8) of the bytes.
(define internal (fib.str-bytes ptr) ((ptr s) (i32 tid))
  (block entry
    (let ((n (call @fib.str-len s))
          (a (call @fib.array-alloc n tid (i64 1))))
      (call @memcpy (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)) (call @fib.str-bytes-ptr s) n)
      (ret a))))

;; Whether byte j of the n at p exists and lies in lo..=hi.
(define internal (fib.utf8-cont i1) ((ptr p) (i64 n) (i64 j) (i32 lo) (i32 hi))
  (block entry (br (icmp sge j n) no test))
  (block no (ret (i1 0)))
  (block test
    (let ((b (zext i32 (load i8 (getelementptr i8 p j)))))
      (ret (and (icmp sge b lo) (icmp sle b hi))))))

;; The UTF-8 sequence at byte i of the n at p, as Rust's from_utf8
;; reads it (the shortest encodings of the scalar values): its length,
;; 1 to 4, or when the bytes there are not UTF-8 minus the length of the
;; longest prefix of a sequence that they do begin, -1 to -3: the
;; \"maximal subpart\" that String::from_utf8_lossy replaces as one.
(define internal (fib.utf8-step i64) ((ptr p) (i64 n) (i64 i))
  (block entry
    (let ((b (zext i32 (load i8 (getelementptr i8 p i)))))
      (br (icmp slt b (i32 128)) one two?)))
  (block one (ret (i64 1)))
  (block two? (br (and (icmp sge b (i32 194)) (icmp sle b (i32 223))) two three?))
  (block two
    (ret (select (call @fib.utf8-cont p n (add i (i64 1)) (i32 128) (i32 191)) (i64 2) (i64 -1))))
  (block three? (br (and (icmp sge b (i32 224)) (icmp sle b (i32 239))) three four?))
  (block three
    (let ((lo3 (select (icmp eq b (i32 224)) (i32 160) (i32 128)))
          (hi3 (select (icmp eq b (i32 237)) (i32 159) (i32 191)))
          (c31 (call @fib.utf8-cont p n (add i (i64 1)) lo3 hi3))
          (c32 (call @fib.utf8-cont p n (add i (i64 2)) (i32 128) (i32 191))))
      (ret (select c31 (select c32 (i64 3) (i64 -2)) (i64 -1)))))
  (block four? (br (and (icmp sge b (i32 240)) (icmp sle b (i32 244))) four bad))
  (block four
    (let ((lo4 (select (icmp eq b (i32 240)) (i32 144) (i32 128)))
          (hi4 (select (icmp eq b (i32 244)) (i32 143) (i32 191)))
          (c41 (call @fib.utf8-cont p n (add i (i64 1)) lo4 hi4))
          (c42 (call @fib.utf8-cont p n (add i (i64 2)) (i32 128) (i32 191)))
          (c43 (call @fib.utf8-cont p n (add i (i64 3)) (i32 128) (i32 191))))
      (ret (select c41 (select c42 (select c43 (i64 4) (i64 -3)) (i64 -2)) (i64 -1)))))
  (block bad (ret (i64 -1))))

;; Whether the n bytes at p are UTF-8 (the interpreter's rule for
;; str-from-bytes: Rust's from_utf8).
(define internal (fib.utf8-valid i1) ((ptr p) (i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (adv inext) (wadv iw) (adv2 j2) (adv3 j3))))
      (br (icmp sge i n) ok wide)))
  ;; JSON-3: eight ASCII bytes at a time (a word with no byte of 0x80 or more is eight one-byte sequences); the common two- and three-byte sequences (C2..DF, E1..EC and EE..EF
  ;; with their continuation bytes in 80..BF) inline; the step for everything else (E0, ED, F0..F4, and every error), which decides exactly as before.
  (block wide
    (br (icmp sle (add i (i64 8)) n) word head))
  (block word
    (let ((w (load i64 (getelementptr i8 p i)))
          (iw (add i (i64 8))))
      (br (icmp eq (and w (i64 -9187201950435737472)) (i64 0)) wadv head)))
  (block wadv (br loop))
  (block head
    (let ((b0 (zext i32 (load i8 (getelementptr i8 p i))))
          (ia (add i (i64 1)))
          (ib (add i (i64 2))))
      (br (and (icmp uge b0 (i32 194)) (icmp ule b0 (i32 223))) two chk3)))
  (block two
    (br (icmp slt ia n) two2 slow))
  (block two2
    (let ((c1 (zext i32 (load i8 (getelementptr i8 p ia)))))
      (br (icmp eq (and c1 (i32 192)) (i32 128)) adv2 slow)))
  (block adv2 (let ((j2 (add i (i64 2)))) (br loop)))
  (block chk3
    (br (and (icmp uge b0 (i32 225)) (and (icmp ule b0 (i32 239)) (icmp ne b0 (i32 237)))) three slow))
  (block three
    (br (icmp slt ib n) three2 slow))
  (block three2
    (let ((d1 (zext i32 (load i8 (getelementptr i8 p ia))))
          (d2 (zext i32 (load i8 (getelementptr i8 p ib)))))
      (br (and (icmp eq (and d1 (i32 192)) (i32 128)) (icmp eq (and d2 (i32 192)) (i32 128))) adv3 slow)))
  (block adv3 (let ((j3 (add i (i64 3)))) (br loop)))
  (block slow
    (let ((k (call @fib.utf8-step p n i)))
      (br (icmp sgt k (i64 0)) adv bad)))
  (block adv (let ((inext (add i k))) (br loop)))
  (block ok (ret (i1 1)))
  (block bad (ret (i1 0))))

;; The length of the lossy conversion of the n bytes at p: a valid
;; sequence stays as it is, each maximal invalid prefix is the 3 bytes
;; of U+FFFD.
(define internal (fib.lossy-len i64) ((ptr p) (i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (step i2)))
          (len (phi i64 (entry (i64 0)) (step len2))))
      (br (icmp slt i n) step done)))
  (block step
    (let ((k (call @fib.utf8-step p n i))
          (ok (icmp sgt k (i64 0)))
          (i2 (add i (select ok k (sub (i64 0) k))))
          (len2 (add len (select ok k (i64 3)))))
      (br loop)))
  (block done (ret len)))

;; A fresh str of the n bytes at p, which need not be UTF-8: each
;; invalid sequence is replaced by U+FFFD (EF BF BD) exactly as Rust's
;; String::from_utf8_lossy replaces it, one for each maximal prefix of
;; a sequence (a stray continuation byte, an overlong or surrogate
;; lead, a lead cut short by the next byte or by the end, FE, FF).
;; The command line of a built executable is read through it (syntax
;; §4.3, `(args)`); `fibc run` and `fibref run` make the same strings
;; in Rust, in fibref::cmdline, before the program starts.
(define internal (fib.str-from-lossy ptr) ((ptr p) (i64 n))
  (block entry
    (let ((s (call @fib.str-new (call @fib.lossy-len p n)))
          (dst (call @fib.str-bytes-ptr s)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (next i2)))
          (o (phi i64 (entry (i64 0)) (next o2))))
      (br (icmp slt i n) step done)))
  (block step
    (let ((k (call @fib.utf8-step p n i))
          (ok (icmp sgt k (i64 0))))
      (br ok copy replace)))
  (block copy
    (call @memcpy (getelementptr i8 dst o) (getelementptr i8 p i) k)
    (br next))
  (block replace
    (store (i8 -17) (getelementptr i8 dst o))
    (store (i8 -65) (getelementptr i8 dst (add o (i64 1))))
    (store (i8 -67) (getelementptr i8 dst (add o (i64 2))))
    (br next))
  (block next
    (let ((i2 (add i (select ok k (sub (i64 0) k))))
          (o2 (add o (select ok k (i64 3)))))
      (br loop)))
  (block done (ret s)))

;; (str-from-bytes a): a fresh str of the array's bytes, which must be
;; UTF-8 (the interpreter traps with the same message).
(define internal (fib.str-from-array ptr) ((ptr arr))
  (block entry
    (let ((n (load i64 (getelementptr %struct.fib.array.i8 arr (i32 0) (i32 3))))
          (p (getelementptr %struct.fib.array.i8 arr (i32 0) (i32 4) (i64 0))))
      (br (call @fib.utf8-valid p n) ok bad)))
  (block ok (ret (call @fib.str-from-bytes p n)))
  (block bad
    (call @fib.trap-c (string \"str-from-bytes: invalid UTF-8\"))
    (unreachable)))

;; (i32->char n): traps unless n is a Unicode scalar value.
(define internal (fib.i32-to-char i32) ((i32 n))
  (block entry
    (let ((neg (icmp slt n (i32 0)))
          (surrogate (and (icmp sge n (i32 55296)) (icmp sle n (i32 57343))))
          (big (icmp sgt n (i32 1114111))))
      (br (or neg (or surrogate big)) bad ok)))
  (block bad
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"i32->char of %d, not a Unicode scalar value\") n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok (ret n)))

;; Keywords made at run time (`str->keyword`, LIBFIX-1, emit.kwdyn). The keywords of a program have ids 0 .. N-1 (its literals); one made from a string that is none
;; of them takes the id N + i, i the index of its name in this table, which grows by doubling under a spinlock (fib.lock). The name is a copy, frozen (IMMORTAL and SHARED, never freed, and a trace-mode audit sees it freed, as it does a `freeze`), so
;; the table owns it for good and a trace-mode audit counts no leak. Lookup is a walk: a program makes few keywords from strings, and the common
;; one is a literal, found by emit.kwdyn's `kw.intern` before this is called.
(global internal fib.kwd-lock i32 (i32 0))
(global internal fib.kwd-names ptr (ptr null))
(global internal fib.kwd-n i64 (i64 0))
(global internal fib.kwd-cap i64 (i64 0))

(define internal (fib.kwd-count i64) ()
  (block entry (ret (atomic-load monotonic i64 @fib.kwd-n))))

(define internal (fib.kwd-name ptr) ((i64 i))
  (block entry
    (call @fib.lock @fib.kwd-lock)
    (let ((names (load ptr @fib.kwd-names))
          (s (load ptr (getelementptr ptr names i))))
      (call @fib.unlock @fib.kwd-lock)
      (ret s))))

(define internal (fib.kwd-intern i64) ((ptr s))
  (block entry
    (call @fib.lock @fib.kwd-lock)
    (br scan))
  (block scan
    (let ((i (phi i64 (entry (i64 0)) (next i2)))
          (n (load i64 @fib.kwd-n)))
      (br (icmp slt i n) test add)))
  (block test
    (let ((names (load ptr @fib.kwd-names))
          (t (load ptr (getelementptr ptr names i))))
      (br (call @fib.str-eq t s) hit next)))
  (block next
    (let ((i2 (add i (i64 1))))
      (br scan)))
  (block hit
    (call @fib.unlock @fib.kwd-lock)
    (ret i))
  (block add
    (let ((cap (load i64 @fib.kwd-cap)))
      (br (icmp sge n cap) grow put)))
  (block grow
    (let ((cap2 (select (icmp eq cap (i64 0)) (i64 64) (mul cap (i64 2))))
          (nw (call @realloc (load ptr @fib.kwd-names) (mul cap2 (i64 8)))))
      (br (icmp eq nw (ptr null)) oom grown)))
  (block oom
    (call @fib.fatal-c (string \"out of memory\"))
    (unreachable))
  (block grown
    (store nw @fib.kwd-names)
    (store cap2 @fib.kwd-cap)
    (br put))
  (block put
    (let ((c (call @fib.str-copy s))
          (names2 (load ptr @fib.kwd-names)))
      (call @fib.freeze c)
      (store c (getelementptr ptr names2 n))
      (store (add n (i64 1)) @fib.kwd-n)
      (call @fib.unlock @fib.kwd-lock)
      (ret n))))
")

;; array.lir
(def RT-ARRAY: str
";; fib.rt, arrays (types §8.3): header, length, then the elements in
;; the same allocation. The element type is the caller's; these
;; functions see only its size.

;; A fresh array of n elements of esize bytes, of type id tid; the
;; elements are the caller's to fill. A negative n traps as the
;; interpreter does (eval/arrays.rs).
(define internal (fib.array-alloc ptr) ((i64 n) (i32 tid) (i64 esize))
  (block entry (br (icmp slt n (i64 0)) bad ok))
  (block bad
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"array of negative length %lld\") n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok
    (let ((a (call @fib.alloc (add (i64 24) (mul n esize)) tid)))
      (store n (getelementptr %struct.fib.array.i8 a (i32 0) (i32 3)))
      (ret a))))

(define internal (fib.array-len i64) ((ptr a))
  (block entry (ret (load i64 (getelementptr %struct.fib.array.i8 a (i32 0) (i32 3))))))

;; The elements [i, j) of a as a fresh array (array-copy), not yet
;; retained; out of range traps with the interpreter's message.
(define internal (fib.array-slice ptr) ((ptr a) (i64 i) (i64 j) (i32 tid) (i64 esize))
  (block entry
    (let ((n (call @fib.array-len a))
          (bad (or (icmp slt i (i64 0)) (or (icmp sgt i j) (icmp sgt j n)))))
      (br bad range ok)))
  (block range
    (let ((buf (alloca i8 (i32 96)))
          (len (call @snprintf buf (i64 96) (string \"array-copy [%lld, %lld) out of range 0..%lld\") i j n)))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok
    (let ((m (sub j i))
          (r (call @fib.array-alloc m tid esize))
          (src (getelementptr i8 (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)) (mul i esize)))
          (dst (getelementptr %struct.fib.array.i8 r (i32 0) (i32 4) (i64 0))))
      (call @memcpy dst src (mul m esize))
      (ret r))))

;; `array-blit!` (spec/types.md 2.13.3): n elements of src from si into dst from di, in place (dst is the unique array the compiler
;; made of the cell). Any index or count outside either array traps, nothing is written. memmove: src may be dst.
(define internal (fib.array-blit void) ((ptr dst) (i64 di) (ptr src) (i64 si) (i64 n) (i64 esize))
  (block entry
    (let ((dn (call @fib.array-len dst)) (sn (call @fib.array-len src))
          (bad (or (or (icmp slt di (i64 0)) (icmp slt si (i64 0)))
                   (or (icmp slt n (i64 0)) (or (icmp sgt n (sub dn di)) (icmp sgt n (sub sn si)))))))
      (br bad range ok)))
  (block range
    (let ((buf (alloca i8 (i32 128)))
          (len (call @snprintf buf (i64 128) (string \"array-blit! of %lld elements at dst %lld (of %lld) from src %lld (of %lld) is out of range\")
                     n di (call @fib.array-len dst) si (call @fib.array-len src))))
      (call @fib.trap-bytes buf (sext i64 len))
      (unreachable)))
  (block ok
    (let ((d (getelementptr i8 (getelementptr %struct.fib.array.i8 dst (i32 0) (i32 4) (i64 0)) (mul di esize)))
          (s (getelementptr i8 (getelementptr %struct.fib.array.i8 src (i32 0) (i32 4) (i64 0)) (mul si esize))))
      (call @memmove d s (mul n esize))
      (ret))))

;; `array-push!` (in-place-update.md §2): a copy of a with room for 32 elements
;; (the vector tail's whole range), the elements not yet retained. ROOMY (flag
;; bit 4, no reader of the flags tests it: they mask bits 0-3) says the block holds
;; 32 elements, len of them used, so a unique ROOMY array grows in place. A length
;; of 32 or more gets exactly one more element and no flag.

;; `array-push!` (in-place-update.md §2): a copy of a with room to grow, the elements not yet retained. The capacity of a
;; ROOMY block (flag bit 4, no reader of the flags tests it: they mask bits 0-3) is not stored; it is a function of the
;; length: the smallest power of two that is at least max(len, 32) (`fib.array-cap`). So a unique ROOMY array grows in
;; place while len is below 32, or is not a power of two; at a power of two the next push copies into a block of twice the
;; room (amortised constant time per push, LIBFIX-1: an array of 32 or more elements used to get exactly one more element
;; per copy, so a loop of pushes was quadratic). A pop only shortens len, so the block always has at least that capacity.
(define internal (fib.array-cap i64) ((i64 n))
  (block entry (br loop))
  (block loop
    (let ((c (phi i64 (entry (i64 32)) (step c1))))
      (br (icmp ult c n) step done)))
  (block step
    (let ((c1 (shl c (i64 1))))
      (br loop)))
  (block done (ret c)))

(define internal (fib.array-room ptr) ((ptr a) (i32 tid) (i64 esize))
  (block entry
    (let ((n (call @fib.array-len a))
          (cap (call @fib.array-cap (add n (i64 1))))
          (r (call @fib.alloc (add (i64 24) (mul cap esize)) tid))
          (src (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)))
          (dst (getelementptr %struct.fib.array.i8 r (i32 0) (i32 4) (i64 0)))
          (fp (getelementptr %struct.fib.hdr r (i32 0) (i32 2))))
      (store n (getelementptr %struct.fib.array.i8 r (i32 0) (i32 3)))
      (call @memcpy dst src (mul n esize))
      (store (or (load i32 fp) (i32 16)) fp)
      (ret r))))

;; True when a is unique and ROOMY with a free slot: array-push! writes it in place. Below 32 there is always room; from 32 on
;; the capacity is the power of two at or above len, so there is room unless len is a power of two.
(define internal (fib.array-roomy? i1) ((ptr a))
  (block entry
    (br (call @fib.unique? a) test no))
  (block test
    (br (icmp ne (and (call @fib.flags a) (i32 16)) (i32 0)) full no))
  (block full
    (let ((n (call @fib.array-len a)))
      (br (icmp slt n (i64 32)) yes big)))
  (block big
    (let ((m (and n (sub n (i64 1)))))
      (ret (icmp ne m (i64 0)))))
  (block yes (ret (i1 1)))
  (block no (ret (i1 0))))
")

;; vec.lir
(def RT-VEC: str
";; fib.rt, the prelude's Vec (types §8.3, \"Vector patterns\"): the
;; pattern compiler's core view of (Vec a) — VecEmpty, or (VecOf cnt
;; shift root tail) over VNode arrays — and fib.vec-drop, which builds
;; the rest of a vector pattern in the layout the interpreter's
;; build_vec builds (fibref eval/vecs.rs), allocating in the same
;; order: the tail array, then each leaf's array and node, then each
;; level's arrays and nodes, then the VecOf. Elements are esize bytes;
;; counted is 0 for scalars, 1 for pointers (retained into the new
;; arrays), 2 for two-word dyn values (their first word retained).
(defstruct fib.vecof (i64 i32 i32 i32 i64 i64 ptr ptr))
(defstruct fib.vnode (i64 i32 i32 i32 ptr))

(define internal (fib.vec-len i64) ((ptr v))
  (block entry (br (icmp eq (load i32 (getelementptr %struct.fib.vecof v (i32 0) (i32 3))) (i32 0)) empty of))
  (block empty (ret (i64 0)))
  (block of (ret (load i64 (getelementptr %struct.fib.vecof v (i32 0) (i32 4))))))

(define internal (fib.array-elem ptr) ((ptr a) (i64 i) (i64 esize))
  (block entry
    (ret (getelementptr i8 (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0)) (mul i esize)))))

;; The address of element i of a non-empty vector, i < cnt.
(define internal (fib.vec-elem-ptr ptr) ((ptr v) (i64 i) (i64 esize))
  (block entry
    (let ((cnt (load i64 (getelementptr %struct.fib.vecof v (i32 0) (i32 4))))
          (tail (load ptr (getelementptr %struct.fib.vecof v (i32 0) (i32 7))))
          (tailoff (sub cnt (call @fib.array-len tail))))
      (br (icmp sge i tailoff) intail intrie)))
  (block intail (ret (call @fib.array-elem tail (sub i tailoff) esize)))
  (block intrie
    (let ((root (load ptr (getelementptr %struct.fib.vecof v (i32 0) (i32 6))))
          (shift (load i64 (getelementptr %struct.fib.vecof v (i32 0) (i32 5)))))
      (br walk)))
  (block walk
    (let ((node (phi ptr (intrie root) (down kid)))
          (level (phi i64 (intrie shift) (down level2)))
          (arr (load ptr (getelementptr %struct.fib.vnode node (i32 0) (i32 4))))
          (leaf (icmp eq (load i32 (getelementptr %struct.fib.vnode node (i32 0) (i32 3))) (i32 0))))
      (br leaf atleaf down)))
  (block atleaf (ret (call @fib.array-elem arr (and i (i64 31)) esize)))
  (block down
    (let ((kid (load ptr (call @fib.array-elem arr (and (lshr i level) (i64 31)) (i64 8))))
          (level2 (sub level (i64 5))))
      (br walk))))

;; Retains the element at p (counted 1: a pointer; 2: a dyn's object).
(define internal (fib.retain-elem void) ((ptr p) (i8 counted))
  (block entry (br (icmp eq counted (i8 0)) done yes))
  (block yes (call @fib.retain (load ptr p)) (br done))
  (block done (ret)))

;; A fresh array of the n elements of v from index from on, each
;; retained.
(define internal (fib.vec-slice-array ptr) ((ptr v) (i64 from) (i64 n) (i64 esize) (i8 counted) (i32 tid))
  (block entry
    (let ((a (call @fib.array-alloc n tid esize)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2))))
      (br (icmp slt i n) body done)))
  (block body
    (let ((src (call @fib.vec-elem-ptr v (add from i) esize))
          (dst (call @fib.array-elem a i esize))
          (i2 (add i (i64 1))))
      (call @memcpy dst src esize)
      (call @fib.retain-elem dst counted)
      (br loop)))
  (block done (ret a)))

;; A VNode of the variant holding arr (consumed).
(define internal (fib.vnode-new ptr) ((i32 variant) (ptr arr) (i32 tid))
  (block entry
    (let ((n (call @fib.alloc (call @fib.size-of tid) tid)))
      (store variant (getelementptr %struct.fib.vnode n (i32 0) (i32 3)))
      (store arr (getelementptr %struct.fib.vnode n (i32 0) (i32 4)))
      (ret n))))

;; (fib.vec-drop v k ..): the vector of v's elements from k on.
(define internal (fib.vec-drop ptr) ((ptr v) (i64 k) (i64 esize) (i8 counted) (i32 tvec) (i32 tnode) (i32 tarr) (i32 tnarr))
  (block entry
    (let ((len (call @fib.vec-len v))
          (k2 (select (icmp sgt k len) len k))
          (n (sub len k2)))
      (br (icmp eq n (i64 0)) empty some)))
  (block empty
    (let ((e (call @fib.alloc (call @fib.size-of tvec) tvec)))
      (store (i32 0) (getelementptr %struct.fib.vecof e (i32 0) (i32 3)))
      (ret e)))
  (block some
    ;; split = n - ((n - 1) % 32 + 1): the elements before the tail.
    (let ((split (sub n (add (srem (sub n (i64 1)) (i64 32)) (i64 1))))
          (tail (call @fib.vec-slice-array v (add k2 split) (sub n split) esize counted tarr)))
      (br (icmp eq split (i64 0)) noroot leaves)))
  (block noroot
    (ret (call @fib.vecof-new n (i64 5) (ptr null) tail tvec)))
  ;; The leaves: one array and one VLeaf per 32 elements, kept in a
  ;; scratch array of node pointers.
  (block leaves
    (let ((nleaves (sdiv split (i64 32)))
          (scratch (call @malloc (mul nleaves (i64 8)))))
      (br lloop)))
  (block lloop
    (let ((li (phi i64 (leaves (i64 0)) (lbody li2))))
      (br (icmp slt li nleaves) lbody levels)))
  (block lbody
    (let ((arr (call @fib.vec-slice-array v (add k2 (mul li (i64 32))) (i64 32) esize counted tarr))
          (node (call @fib.vnode-new (i32 0) arr tnode))
          (li2 (add li (i64 1))))
      (store node (getelementptr ptr scratch li))
      (br lloop)))
  ;; The levels: group the nodes by 32 into VBranches until one is left.
  (block levels
    (let ((count (phi i64 (lloop nleaves) (lnext up)))
          (shift (phi i64 (lloop (i64 5)) (lnext shift2)))
          (groups (sdiv (add count (i64 31)) (i64 32))))
      (br gloop)))
  (block gloop
    (let ((gi (phi i64 (levels (i64 0)) (kdone gi2))))
      (br (icmp slt gi groups) gbody lnext)))
  (block gbody
    (let ((start (mul gi (i64 32)))
          (m (select (icmp slt (sub count start) (i64 32)) (sub count start) (i64 32)))
          (karr (call @fib.array-alloc m tnarr (i64 8))))
      (br kloop)))
  (block kloop
    (let ((ki (phi i64 (gbody (i64 0)) (kbody ki2))))
      (br (icmp slt ki m) kbody kdone)))
  (block kbody
    ;; The node moves into the array: retained by the store, released
    ;; as the interpreter's give_back does; the two cancel.
    (let ((kid (load ptr (getelementptr ptr scratch (add start ki))))
          (ki2 (add ki (i64 1))))
      (store kid (call @fib.array-elem karr ki (i64 8)))
      (br kloop)))
  (block kdone
    (let ((branch (call @fib.vnode-new (i32 1) karr tnode))
          (gi2 (add gi (i64 1))))
      (store branch (getelementptr ptr scratch gi))
      (br gloop)))
  (block lnext
    (let ((up groups)
          (shift2 (add shift (i64 5))))
      (br (icmp eq groups (i64 1)) rooted levels)))
  (block rooted
    (let ((root (load ptr (getelementptr ptr scratch (i64 0)))))
      (call @free scratch)
      (ret (call @fib.vecof-new n shift root tail tvec)))))

;; A VecOf (cnt shift root tail), root and tail consumed.
(define internal (fib.vecof-new ptr) ((i64 cnt) (i64 shift) (ptr root) (ptr tail) (i32 tvec))
  (block entry
    (let ((o (call @fib.alloc (call @fib.size-of tvec) tvec)))
      (store (i32 1) (getelementptr %struct.fib.vecof o (i32 0) (i32 3)))
      (store cnt (getelementptr %struct.fib.vecof o (i32 0) (i32 4)))
      (store shift (getelementptr %struct.fib.vecof o (i32 0) (i32 5)))
      (store root (getelementptr %struct.fib.vecof o (i32 0) (i32 6)))
      (store tail (getelementptr %struct.fib.vecof o (i32 0) (i32 7)))
      (ret o))))
")

;; vecbuild.lir
(def RT-VECBUILD: str
";; fib.rt, building a Vec from a buffer of elements (types §8.3, the
;; interpreter's build_vec in eval/vecs.rs): the tail array first, then
;; each leaf's array and node, then each level's arrays and nodes, then
;; the VecOf. fib.vec-gather copies a vector's elements into such a
;; buffer (for concat, syntax §3.16), fib.vec-build makes the vector,
;; retaining every element it copies out of the buffer.

;; Copies v's elements to buf from index at on; returns the next index.
(define internal (fib.vec-gather i64) ((ptr v) (ptr buf) (i64 at) (i64 esize))
  (block entry
    (let ((n (call @fib.vec-len v)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2))))
      (br (icmp slt i n) body done)))
  (block body
    (let ((src (call @fib.vec-elem-ptr v i esize))
          (dst (getelementptr i8 buf (mul (add at i) esize)))
          (i2 (add i (i64 1))))
      (call @memcpy dst src esize)
      (br loop)))
  (block done (ret (add at n))))

;; An array of the n elements of buf from index from, each retained.
(define internal (fib.buf-slice-array ptr) ((ptr buf) (i64 from) (i64 n) (i64 esize) (i8 counted) (i32 tid))
  (block entry
    (let ((a (call @fib.array-alloc n tid esize)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2))))
      (br (icmp slt i n) body done)))
  (block body
    (let ((src (getelementptr i8 buf (mul (add from i) esize)))
          (dst (call @fib.array-elem a i esize))
          (i2 (add i (i64 1))))
      (call @memcpy dst src esize)
      (call @fib.retain-elem dst counted)
      (br loop)))
  (block done (ret a)))

;; The vector of the n elements of buf.
(define internal (fib.vec-build ptr) ((ptr buf) (i64 n) (i64 esize) (i8 counted) (i32 tvec) (i32 tnode) (i32 tarr) (i32 tnarr))
  (block entry (br (icmp eq n (i64 0)) empty some))
  (block empty
    (let ((e (call @fib.alloc (call @fib.size-of tvec) tvec)))
      (store (i32 0) (getelementptr %struct.fib.vecof e (i32 0) (i32 3)))
      (ret e)))
  (block some
    (let ((split (sub n (add (srem (sub n (i64 1)) (i64 32)) (i64 1))))
          (tail (call @fib.buf-slice-array buf split (sub n split) esize counted tarr)))
      (br (icmp eq split (i64 0)) noroot leaves)))
  (block noroot
    (ret (call @fib.vecof-new n (i64 5) (ptr null) tail tvec)))
  (block leaves
    (let ((nleaves (sdiv split (i64 32)))
          (scratch (call @malloc (mul nleaves (i64 8)))))
      (br lloop)))
  (block lloop
    (let ((li (phi i64 (leaves (i64 0)) (lbody li2))))
      (br (icmp slt li nleaves) lbody levels)))
  (block lbody
    (let ((arr (call @fib.buf-slice-array buf (mul li (i64 32)) (i64 32) esize counted tarr))
          (node (call @fib.vnode-new (i32 0) arr tnode))
          (li2 (add li (i64 1))))
      (store node (getelementptr ptr scratch li))
      (br lloop)))
  (block levels
    (let ((count (phi i64 (lloop nleaves) (lnext up)))
          (shift (phi i64 (lloop (i64 5)) (lnext shift2)))
          (groups (sdiv (add count (i64 31)) (i64 32))))
      (br gloop)))
  (block gloop
    (let ((gi (phi i64 (levels (i64 0)) (kdone gi2))))
      (br (icmp slt gi groups) gbody lnext)))
  (block gbody
    (let ((start (mul gi (i64 32)))
          (m (select (icmp slt (sub count start) (i64 32)) (sub count start) (i64 32)))
          (karr (call @fib.array-alloc m tnarr (i64 8))))
      (br kloop)))
  (block kloop
    (let ((ki (phi i64 (gbody (i64 0)) (kbody ki2))))
      (br (icmp slt ki m) kbody kdone)))
  (block kbody
    (let ((kid (load ptr (getelementptr ptr scratch (add start ki))))
          (ki2 (add ki (i64 1))))
      (store kid (call @fib.array-elem karr ki (i64 8)))
      (br kloop)))
  (block kdone
    (let ((branch (call @fib.vnode-new (i32 1) karr tnode))
          (gi2 (add gi (i64 1))))
      (store branch (getelementptr ptr scratch gi))
      (br gloop)))
  (block lnext
    (let ((up groups)
          (shift2 (add shift (i64 5))))
      (br (icmp eq groups (i64 1)) rooted levels)))
  (block rooted
    (let ((root (load ptr (getelementptr ptr scratch (i64 0)))))
      (call @free scratch)
      (ret (call @fib.vecof-new n shift root tail tvec)))))
")

;; atom.lir
(def RT-ATOM: str
";; fib.rt, atoms and share marking (types §8.6, §8.8): the spinlock of
;; an atom or a weak box (a cmpxchg on its i32 lock word), and
;; fib.share, which marks an object and everything reachable from it
;; SHARED through the type table's trace functions.
(declare sched_yield i32 ())

;; The lock of an object atom, a weak box and a task's result (the atom of a scalar takes none: emit.lower.atoms): a `cmpxchg` (acquire) that
;; takes it when the word is 0, and a `sched_yield` after each failure, so that a waiter gives its CPU to the holder and does not hammer the
;; line. P-count-a measured the alternatives (docs/shootout/atoms.md, \"the lock\"): test-and-test-and-set with bounded spinning (read the word
;; up to K times, K from 16 to 1024 and doubling, then yield; K 16 to 64; K from 4 to 16; 4 or 32 loads then yield each round) was no faster
;; than this at 28 tasks and 1.5 to 4 times slower at 2 to 8 (an `@a` of a Vec: 5.0, 22, 105 ms at 2, 4, 8 tasks here, 12-19, 46-71, 166-190 ms
;; with the spinners): what a waiter waits for is the holder's retain of a shared count (a contended atomic), not the lock word, and a waiter
;; that sleeps in `sched_yield` keeps its traffic off that line. The cost of an object atom under contention is the count of the object
;; (P-count-b: `freeze`, borrowed reads), not this lock. Held for a load and a retain, or a compare and a store; never across a call of `f`.
(define internal (fib.lock void) ((ptr lockp))
  (block entry (br spin))
  (block spin
    (let ((r (cmpxchg acquire monotonic lockp (i32 0) (i32 1))))
      (br (extractvalue r 1) done wait)))
  (block wait (call @sched_yield) (br spin))
  (block done (ret)))

(define internal (fib.unlock void) ((ptr lockp))
  (block entry (atomic-store release (i32 0) lockp) (ret)))

;; §8.8: set SHARED with atomicrmw or, stopping at objects already
;; SHARED and at IMMORTAL ones, then walk the children. Each type's share
;; function (slot 4 of the type table; slot 1, the trace function, calls
;; a callback and serves the retains of copies) queues the children it
;; finds on a worklist (core.lir), so that a chain of a million objects
;; takes no native frame per link. An object is marked when it is queued,
;; so it is queued once.
;; What the walk does to an object it queues is the MODE of its worklist
;; (core.lir, the fifth field; a field of the walk and no global, so that
;; two threads may walk at once: a `freeze` on one and a `spawn` on another):
;;   1 share:      flags |= SHARED; stops at SHARED and IMMORTAL objects.
;;   2 def:        flags |= SHARED|IMMORTAL and count := 0 (§8.2, fib.immortalise);
;;                 stops at IMMORTAL ones; runs before `main`.
;;   3 freeze:     as 2, for `(freeze x)` while the program runs (P-count-b): stops at
;;                 IMMORTAL and STACK objects, refuses a cell, atom, weak reference or
;;                 task (fib.freeze-check), and in trace mode reports each object frozen
;;                 as `F n`: it is never freed, and the audit counts it as intended, as a
;;                 literal is (it was not allocated by the program's own account).
(define internal (fib.walk-mode i64) ((ptr wl))
  (block entry (ret (load i64 (getelementptr %struct.fib.wl wl (i32 0) (i32 4))))))

;; An object that `freeze` must not publish: a cell, an atom, a weak
;; reference or a task is mutable in place (or observes its target); as
;; IMMORTAL data it would be written by one thread while all others read it
;; with no count and no lock to order them. Kind 0 is anything else
;; (rt table `fib.kinds`, emitted with the type table).
(define internal (fib.freeze-check void) ((ptr p))
  (block entry
    (let ((k (load i8 (getelementptr i8 @fib.kinds (zext i64 (call @fib.tid p))))))
      (br (icmp eq k (i8 0)) done r0)))
  (block r0 (br (icmp eq k (i8 5)) done refuse))
  (block refuse (br (icmp eq k (i8 1)) cell r2))
  (block r2 (br (icmp eq k (i8 2)) atom r3))
  (block r3 (br (icmp eq k (i8 3)) weak task))
  (block cell (call @fib.trap-c (string \"freeze: a cell is reachable from the value (a cell is mutable in place)\")) (unreachable))
  (block atom (call @fib.trap-c (string \"freeze: an atom is reachable from the value (an atom is mutable in place)\")) (unreachable))
  (block weak (call @fib.trap-c (string \"freeze: a weak reference is reachable from the value\")) (unreachable))
  (block task (call @fib.trap-c (string \"freeze: a task is reachable from the value\")) (unreachable))
  (block done (ret)))

(define internal (fib.share-queue void) ((ptr wl) (ptr p))
  (block entry (br (icmp eq p (ptr null)) done check))
  (block check
    (let ((f (call @fib.flags p))
          (mode (call @fib.walk-mode wl))
          (skip (select (icmp eq mode (i64 1)) (i32 9) (select (icmp eq mode (i64 3)) (i32 12) (i32 8)))))
      (br (icmp ne (and f skip) (i32 0)) done mark)))
  (block mark (br (icmp eq mode (i64 3)) refuse set))
  (block refuse (call @fib.freeze-check p) (br set))
  (block set
    (atomicrmw or monotonic (getelementptr %struct.fib.hdr p (i32 0) (i32 2)) (select (icmp eq mode (i64 1)) (i32 1) (i32 9)))
    (br (icmp eq mode (i64 1)) push forever))
  (block forever
    (store (i64 0) (getelementptr %struct.fib.hdr p (i32 0) (i32 0)))
    (br (icmp eq mode (i64 3)) maybetrace push))
  (block maybetrace (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced push))
  (block traced
    (call @fib.trace-line (i8 70) (load i64 (getelementptr i8 p (i64 -16))) (i8 0))
    (br push))
  (block push
    (call @fib.wl-push wl p)
    (br done))
  (block done (ret)))

;; §8.2 (syntax §3.19, L15): the value of a `def` made at run time and
;; everything reachable from it become IMMORTAL, and SHARED: every task
;; reaches them, and an atom among them locks. Count 0, never freed,
;; count operations no-ops. Single-threaded: the init functions run
;; before `main`.
(define internal (fib.immortalise void) ((ptr p))
  (block entry
    (call @fib.walk p (i64 2))
    (ret)))

;; `(freeze x)` (P-count-b, spec/types.md 8.2): the value graph of x becomes
;; IMMORTAL and SHARED, so that a retain or a release of any object in it is a
;; flag test and nothing else, whatever the number of threads; and `fib.unique?`
;; is false on each, so an update through a place that holds one copies. Never
;; freed. Safe to call while other threads run: the walk keeps no global, an
;; object of x's graph that other threads also hold is already SHARED (their
;; counts are atomic) and a count they change after the flag is set is
;; never read again. Traps (nothing is undone: the objects above the one
;; refused stay frozen, which is safe) at a cell, atom, weak reference or task.
(define internal (fib.freeze void) ((ptr p))
  (block entry
    (call @fib.walk p (i64 3))
    (ret)))

;; `(private-copy x)` (P-count-b): a shallow copy of the object x with a count of its own: count 1, not SHARED, the children retained once.
;; A closure that many tasks call is one object whose count every call touches (the caller retains the closure it calls and the callee
;; releases it: an atomic pair on a SHARED closure, 60 ns at 8 threads, docs/shootout/parallel.md); a task that calls a private copy of it
;; pays a plain count (1 to 2 ns), and the captured values are retained once per copy, not once per call. The copy is not shared until
;; it is handed to another thread (the hand-off marks it then). An IMMORTAL object has no count and is returned as it is; an object with
;; an identity (a cell, atom, weak reference or task, fib.kinds) and a string or an array (whose size the type table does not give) are
;; returned retained, not copied: they are immutable or have an identity, so one count more is all a user of the \"copy\" needs. A STACK object is copied to the heap.
;; The size of an object is its record's (header included).
(define internal (fib.private-copy ptr) ((ptr p))
  (block entry (br (icmp eq p (ptr null)) same check))
  (block check
    (let ((f (call @fib.flags p))
          (tid (call @fib.tid p))
          (k (load i8 (getelementptr i8 @fib.kinds (zext i64 tid)))))
      (br (icmp ne (and f (i32 8)) (i32 0)) same kind)))
  (block kind (br (icmp ne k (i8 0)) identity copy))
  (block identity (call @fib.retain p) (br same))
  (block same (ret p))
  (block copy
    (let ((size (call @fib.size-of tid))
          (q (call @fib.alloc size tid))
          (rec (getelementptr %struct.fib.typerec @fib.types tid (i32 1))))
      (call @memcpy (getelementptr i8 q (i64 16)) (getelementptr i8 p (i64 16)) (sub size (i64 16)))
      (indirect-call (load ptr rec) (fn void (ptr ptr)) p @fib.retain)
      (ret q))))

(define internal (fib.frozen i1) ((ptr p))
  (block entry (ret (icmp ne (and (call @fib.flags p) (i32 8)) (i32 0)))))

(define internal (fib.share void) ((ptr p))
  (block entry
    (call @fib.walk p (i64 1))
    (ret)))

(define internal (fib.walk void) ((ptr p) (i64 mode))
  (block entry
    (let ((wl (alloca %struct.fib.wl))
          (buf (alloca (align 8) i8 (i32 256))))
      (call @fib.wl-init wl buf (i64 32))
      (store mode (getelementptr %struct.fib.wl wl (i32 0) (i32 4)))
      (call @fib.share-queue wl p)
      (br loop)))
  (block loop (br (call @fib.wl-empty wl) done walk))
  (block walk
    (let ((q (call @fib.wl-pop wl))
          (rec (getelementptr %struct.fib.typerec @fib.types (call @fib.tid q) (i32 4))))
      (indirect-call (load ptr rec) (fn void (ptr ptr)) q wl)
      (br loop)))
  (block done (call @fib.wl-free wl) (ret)))

;; Share-marks v when the holder h is SHARED (§8.6: a value stored
;; into a shared atom is marked before the store).
(define internal (fib.share-into void) ((ptr h) (ptr v))
  (block entry (br (icmp ne (and (call @fib.flags h) (i32 1)) (i32 0)) yes done))
  (block yes (call @fib.share v) (br done))
  (block done (ret)))

;; A number that is the same for the calls of one thread (and, in practice, differs between threads), for the stripe of a counter that
;; many threads add to (lib/fib/adder.fib): the address of a local, which lies in the thread's own stack (stacks are 8 MB apart), shifted
;; by 21 bits so that the frames of one thread's calls agree, multiplied by an odd constant (Fibonacci hashing) and cut to 31 bits. A
;; hint only: two threads may share a value, and one thread may see two (a deep call chain, a task resumed on another thread); every
;; value of the hint is a correct stripe, only the contention differs.
(define internal (fib.sys-thread-stripe i64) ()
  (block entry
    (let ((slot (alloca i64))
          (a (lshr (ptrtoint i64 slot) (i64 21)))
          (h (mul a (i64 -7046029254386353131))))
      (ret (and (lshr h (i64 32)) (i64 2147483647))))))
")

;; thread.lir
(def RT-THREAD: str
";; fib.rt, threads (types §8.8): a spawned task runs on an OS thread of
;; its own (pthreads). The thread is detached when it starts, so the
;; system reclaims its stack and descriptor the moment it ends (a
;; program that spawns in a loop keeps no thread's resources for the
;; tasks that are done); what main's return needs is only to wait until
;; every thread has finished its releases, so the threads are counted:
;; fib.threads-live, under the run queue's mutex, is incremented before
;; a thread starts and decremented, with a broadcast, by the thread
;; entry's last runtime call (fib.thread-done), after the task is
;; released. Tasks, the run queue and the joins are in task.lir.
(declare pthread_create i32 (ptr ptr ptr ptr))
(declare pthread_detach i32 (i64))
(declare pthread_attr_init i32 (ptr))
(declare pthread_attr_setstacksize i32 (ptr i64))
(declare pthread_attr_destroy i32 (ptr))
(declare pthread_attr_setguardsize i32 (ptr i64))
(global internal fib.threads-live i32 (i32 0))
;; The threads this runtime started and that are still running: spawned threads (fib.spawn .. fib.thread-done), async workers, pool workers. The program's own thread is not in it
;; (`fib_thread_count` adds it). The operating system's count is not the program's: a program run by `fibc run` shares its process with the compiler's own threads (its stack thread, the
;; parked first thread), and on macOS there is no /proc to tell them apart by name.
(global internal fib.thread-total i64 (i64 0))

;; What fib.os.process/thread-count answers (extern: bound to this definition): the threads of the program, its own thread and the ones the runtime started for it.
;; extern: (declare fib_thread_count i64 ())
(define internal (fib_thread_count i64) ()
  (block entry (ret (add (i64 1) (atomic-load monotonic i64 @fib.thread-total)))))
;; The stack of a task's thread and of a pool worker, in bytes (docs/design/stack.md), and the guard below it.
(global internal fib.thread-stack i64 (i64 8388608))
(global internal fib.thread-guard i64 (i64 65536))

;; A thread attribute with the stack size set explicitly (8 MiB: glibc's default from `ulimit -s`; musl's own default is 128 KiB and Darwin's 512 KiB,
;; too small for the recursion a task may do). The attribute is 56 bytes on LP64 Linux and 64 on Darwin: 128 bytes, in the caller's frame, are enough.
;; The caller makes room for it and destroys it after pthread_create.
(define internal (fib.thread-attr i32) ((ptr a))
  (block entry
    (call @pthread_attr_init a)
    (call @pthread_attr_setguardsize a (load i64 @fib.thread-guard))
    (ret (call @pthread_attr_setstacksize a (load i64 @fib.thread-stack)))))

;; Starts entry(task) on a new detached thread and counts it; in trace
;; mode writes the T line (compiler.md §4).
(define internal (fib.spawn void) ((ptr task) (ptr entry))
  (block entry
    (atomicrmw add monotonic @fib.thread-total (i64 1))
    (atomic-store monotonic (i32 1) @fib.mt)
    (call @fib.rq-lock)
    (store (add (load i32 @fib.threads-live) (i32 1)) @fib.threads-live)
    (call @fib.rq-unlock)
    (let ((handle (alloca i64))
          (attr (alloca (align 8) i8 (i32 128)))
          (_a (call @fib.thread-attr attr))
          (rc (call @pthread_create handle attr entry task)))
      (call @pthread_attr_destroy attr)
      (br (icmp ne rc (i32 0)) failed started)))
  (block failed
    (call @fib.fatal-c (string \"spawn: cannot start a thread\"))
    (unreachable))
  (block started
    (call @pthread_detach (load i64 handle))
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced done))
  (block traced (call @write (i32 2) (string \"T\\n\") (i64 2)) (br done))
  (block done (ret)))

;; The first runtime call of a thread entry: the task this thread runs is what a trap on it fails (fib.trap-bytes).
(define internal (fib.thread-enter void) ((ptr task))
  (block entry
    (call @pthread_setspecific (load i32 @fib.task-key) task)
    (call @fib.guard-enter (load i64 @fib.thread-stack))
    (ret)))

;; The last runtime call of a thread entry: one thread fewer, and
;; whoever waits in fib.join-all is told.
(define internal (fib.thread-done void) ()
  (block entry
    (call @fib.guard-leave)
    (atomicrmw sub monotonic @fib.thread-total (i64 1))
    (call @fib.rq-lock)
    (store (sub (load i32 @fib.threads-live) (i32 1)) @fib.threads-live)
    (call @fib.rq-broadcast)
    (call @fib.rq-unlock)
    (ret)))

;; Waits until every thread started so far, including those started
;; while waiting, has finished.
(define internal (fib.join-all void) ()
  (block entry (call @fib.rq-lock) (br test))
  (block test
    (br (icmp sgt (load i32 @fib.threads-live) (i32 0)) sleep done))
  (block sleep
    (call @pthread_cond_wait (load ptr @fib.rq-cond) (load ptr @fib.rq-mutex))
    (br test))
  (block done (call @fib.rq-unlock) (ret)))

;; ---- The stack guard (docs/design/stack.md). A stack that overflows ends in a SIGSEGV on its guard page: no code of the program runs, so it cannot be a
;; trap that unwinds (docs/adr/0009: stack overflow is fatal, in a `try` too). What the runtime does is say so: every thread that runs the program keeps a
;; signal stack of its own (`sigaltstack`: the handler cannot run on the stack that is gone) with a header of the bounds of the thread's stack, and one
;; handler for SIGSEGV and SIGBUS reads it. A fault address within a megabyte of the end of the stack is `trap: stack overflow` and abort (the status of
;; every trap, 134); any other fault is \"fatal signal N at 0xADDR\" and then the signal's own death, so a memory bug is never taken for a deep recursion.
;; The handler uses write, sigaltstack, abort and sigaction only (all async-signal-safe). `main` runs on a stack the runtime makes (`fib.run-main`).
;; Left out of a WASI runtime (emit.wasi), which has neither signals nor threads, and adapted for Darwin by emit.os.
;; guard-begin
(declare sigaction i32 (i32 ptr ptr))
(declare sigaltstack i32 (ptr ptr))
(declare pthread_join i32 (i64 ptr))
(declare getrlimit i32 (i32 ptr))
(declare prctl i32 (i32 ptr i64 i64 i64))
(declare strtol i64 (ptr ptr i32))
(global internal fib.guard-sigbus i32 (i32 7))
(global internal fib.guard-ss-disable i32 (i32 2))
(global internal fib.main-fn ptr (ptr null))
(global internal fib.main-stack i64 (i64 0))
;; The distance from the end of a stack within which a fault is its overflow (the guard of the main stack is a megabyte, of a task's thread 64 KiB).
(global internal fib.guard-window i64 (i64 1048576))

;; Fills the stack_t at ss. Linux: ss_sp, ss_flags (int, at 8), ss_size (at 16). Darwin: ss_sp, ss_size (at 8), ss_flags (int, at 16).
(define internal (fib.guard-ss void) ((ptr ss) (ptr sp) (i64 size) (i32 flags))
  (block entry
    (store sp ss)
    (store flags (getelementptr i8 ss (i64 8)))
    (store size (getelementptr i8 ss (i64 16)))
    (ret)))

;; This thread is about to run program code on a stack of `size` bytes whose top is near here: gives it its signal stack, 64 KiB with the bounds
;; of the stack in its first 16 bytes. Fails quietly (the thread then has no guard message, as before) when there is no memory for it.
(define internal (fib.guard-enter void) ((i64 size))
  (block entry
    (let ((here (alloca i64))
          (ss (alloca (align 8) i8 (i32 32)))
          (blk (call @malloc (i64 65536))))
      (br (icmp eq blk (ptr null)) out set)))
  (block set
    (let ((hi (ptrtoint i64 here)))
      (store (sub hi size) blk)
      (store hi (getelementptr i8 blk (i64 8)))
      (call @fib.guard-ss ss (getelementptr i8 blk (i64 16)) (i64 65520) (i32 0))
      (br (icmp ne (call @sigaltstack ss (ptr null)) (i32 0)) undo out)))
  (block undo (call @free blk) (br out))
  (block out (ret)))

;; This thread ends: its signal stack is disabled and freed (a task's thread comes and goes; a program that spawns in a loop must not leak one each).
(define internal (fib.guard-leave void) ()
  (block entry
    (let ((cur (alloca (align 8) i8 (i32 32)))
          (off (alloca (align 8) i8 (i32 32)))
          (_q (call @sigaltstack (ptr null) cur))
          (sp (load ptr cur)))
      (br (icmp eq sp (ptr null)) out drop)))
  (block drop
    (call @fib.guard-ss off (ptr null) (i64 0) (load i32 @fib.guard-ss-disable))
    (call @sigaltstack off (ptr null))
    (call @free (getelementptr i8 sp (i64 -16)))
    (br out))
  (block out (ret)))

;; What fib.os.process asks around a `fork` (extern: bound to this definition). op 0: the base of this thread's signal stack, 0 when it has none (taken in the
;; parent just before the fork). op 1: in the child, with that base: a thread that has no signal stack gets the parent's back (the child's memory has it, with its
;; bounds header). Linux keeps the signal stack across a fork, so there it does nothing; XNU does not (the new thread starts with none, and a child that
;; outruns its stack was killed by SIGILL, the kernel having no stack to push the signal frame on, with no message). Returns 1 when it set the stack.
;; extern: (declare fib_guard_ctl i64 (i64 i64))
(define internal (fib_guard_ctl i64) ((i64 op) (i64 saved))
  (block entry
    (let ((cur (alloca (align 8) i8 (i32 32)))
          (ss (alloca (align 8) i8 (i32 32)))
          (_q (call @sigaltstack (ptr null) cur))
          (sp (load ptr cur)))
      (br (icmp eq op (i64 0)) query restore)))
  (block query (ret (ptrtoint i64 sp)))
  (block restore
    (br (and (icmp eq sp (ptr null)) (icmp ne saved (i64 0))) set none))
  (block set
    (call @fib.guard-ss ss (inttoptr ptr saved) (i64 65520) (i32 0))
    (br (icmp eq (call @sigaltstack ss (ptr null)) (i32 0)) done none))
  (block done (ret (i64 1)))
  (block none (ret (i64 0))))

;; \"fatal signal N at 0xADDR\\n\" in one write: N is a signal number of at most two digits.
(define internal (fib.guard-unknown void) ((i32 sig) (i64 addr))
  (block entry
    (let ((buf (alloca (align 8) i8 (i32 64)))
          (_h (call @memcpy buf (string \"fatal signal \") (i64 13)))
          (tens (udiv sig (i32 10)))
          (ones (urem sig (i32 10))))
      (br (icmp eq tens (i32 0)) units two)))
  (block two
    (store (trunc i8 (add tens (i32 48))) (getelementptr i8 buf (i64 13)))
    (store (trunc i8 (add ones (i32 48))) (getelementptr i8 buf (i64 14)))
    (call @memcpy (getelementptr i8 buf (i64 15)) (string \" at 0x\") (i64 6))
    (br digits))
  (block units
    (store (trunc i8 (add ones (i32 48))) (getelementptr i8 buf (i64 13)))
    (call @memcpy (getelementptr i8 buf (i64 14)) (string \" at 0x\") (i64 6))
    (br digits))
  (block digits
    (let ((at (phi i64 (two (i64 21)) (units (i64 20)))))
      (br loop)))
  (block loop
    (let ((i (phi i64 (digits (i64 0)) (loop2 i2)))
          (nib (and (lshr addr (sub (i64 60) (shl i (i64 2)))) (i64 15)))
          (ch (select (icmp ult nib (i64 10)) (add nib (i64 48)) (add nib (i64 87)))))
      (store (trunc i8 ch) (getelementptr i8 buf (add at i)))
      (br loop2)))
  (block loop2
    (let ((i2 (add i (i64 1))))
      (br (icmp ult i2 (i64 16)) loop done)))
  (block done
    (store (i8 10) (getelementptr i8 buf (add at (i64 16))))
    (call @write (i32 2) buf (add at (i64 17)))
    (ret)))

;; The handler of SIGSEGV and SIGBUS (sa_sigaction: signal, siginfo_t, ucontext). si_addr is at 16 on Linux and 24 on Darwin.
(define internal (fib.guard-handler void) ((i32 sig) (ptr info) (ptr uc))
  (block entry
    (let ((addr (ptrtoint i64 (load ptr (getelementptr i8 info (i64 16)))))
          (cur (alloca (align 8) i8 (i32 32)))
          (_q (call @sigaltstack (ptr null) cur))
          (sp (load ptr cur)))
      (br (icmp eq sp (ptr null)) unknown check)))
  (block check
    (let ((lo (load i64 (getelementptr i8 sp (i64 -16))))
          (w (load i64 @fib.guard-window)))
      (br (icmp ult (sub addr (sub lo w)) (shl w (i64 1))) overflow unknown)))
  (block overflow
    (call @write (i32 2) (string \"trap: stack overflow\\n\") (i64 21))
    (call @abort)
    (unreachable))
  (block unknown
    (call @fib.guard-unknown sig addr)
    (let ((dfl (alloca (align 8) i8 (i32 160))))
      (call @memset dfl (i32 0) (i64 160))
      (call @sigaction sig dfl (ptr null))
      (ret))))

;; The handler for SIGSEGV and SIGBUS. `old` (two 160-byte slots) receives their previous actions, for fib.guard-restore.
;; struct sigaction: the handler at 0 and the mask at 8 (128 bytes on Linux), sa_flags at 136 on Linux (SA_SIGINFO 4 | SA_ONSTACK 0x08000000);
;; Darwin: the mask is 4 bytes, sa_flags at 12 (SA_SIGINFO 0x40 | SA_ONSTACK 1).
(define internal (fib.guard-install void) ((ptr old))
  (block entry
    (let ((sa (alloca (align 8) i8 (i32 160))))
      (call @memset sa (i32 0) (i64 160))
      (store @fib.guard-handler sa)
      (store (i32 134217732) (getelementptr i8 sa (i64 136)))
      (call @sigaction (i32 11) sa old)
      (call @sigaction (load i32 @fib.guard-sigbus) sa (getelementptr i8 old (i64 160)))
      (ret))))

(define internal (fib.guard-restore void) ((ptr old))
  (block entry
    (call @sigaction (i32 11) old (ptr null))
    (call @sigaction (load i32 @fib.guard-sigbus) (getelementptr i8 old (i64 160)) (ptr null))
    (ret)))

;; The size of the main stack in MiB: FIB_STACK_MB when set (0: the process's own stack), else 256. Anything but a whole number is a fatal error that says so.
(define internal (fib.main-stack-mb i64) ()
  (block entry
    (let ((v (call @getenv (string \"FIB_STACK_MB\"))))
      (br (icmp eq v (ptr null)) default parse)))
  (block default (ret (i64 256)))
  (block parse
    (let ((end (alloca ptr))
          (n (call @strtol v end (i32 10)))
          (good (and (icmp ne (load i8 v) (i8 0))
                     (and (icmp eq (load i8 (load ptr end)) (i8 0))
                          (and (icmp sge n (i64 0)) (icmp sle n (i64 1048576)))))))
      (br good ok bad)))
  (block ok (ret n))
  (block bad
    (call @fib.fatal-c (string \"FIB_STACK_MB is not a whole number of MiB from 0 to 1048576\"))
    (unreachable)))

;; What runs on the main stack: the guard of this thread, then the program (fib.main-fn).
(define internal (fib.main-tramp ptr) ((ptr arg))
  (block entry
    (call @fib.guard-enter (load i64 @fib.main-stack))
    (indirect-call (load ptr @fib.main-fn) (fn void ()))
    (ret (ptr null))))

;; Runs `body` (no arguments) on a stack of FIB_STACK_MB MiB (default 256) that the runtime makes: a thread whose stack is mapped, committed as it is
;; touched, with a megabyte of guard below it, so that how deep a program may recurse is the same on every system and not what `ulimit -s` says.
;; FIB_STACK_MB=0, and a system that will not make the thread, run `body` on the process's own stack, sized by RLIMIT_STACK (the guard bounds
;; are then from that limit; unlimited is taken as 1 GiB). The signal handlers the process had are put back when `body` has returned. The first thread of
;; the process, which only waits, is named `fib-parked` (Linux: prctl PR_SET_NAME, a comm of /proc) so that fib.os.process does not count it as another thread (a thread keeps the name its creator had when it was made: the name is set after the
;; program's thread exists).
(define internal (fib.run-main void) ((ptr body))
  (block entry
    (let ((old (alloca (align 8) i8 (i32 320)))
          (mb (call @fib.main-stack-mb))
          (attr (alloca (align 8) i8 (i32 128)))
          (tid (alloca i64)))
      (call @fib.guard-install old)
      (store body @fib.main-fn)
      (br (icmp eq mb (i64 0)) here spawn)))
  (block spawn
    (store (shl mb (i64 20)) @fib.main-stack)
    (call @pthread_attr_init attr)
    (call @pthread_attr_setguardsize attr (i64 1048576))
    (let ((rs (call @pthread_attr_setstacksize attr (shl mb (i64 20)))))
      (br (icmp eq rs (i32 0)) create refused)))
  (block refused (call @pthread_attr_destroy attr) (br here))
  (block create
    (let ((rc (call @pthread_create tid attr @fib.main-tramp (ptr null))))
      (call @pthread_attr_destroy attr)
      (br (icmp eq rc (i32 0)) joined here)))
  (block joined
    (call @prctl (i32 15) (string \"fib-parked\") (i64 0) (i64 0) (i64 0))
    (call @pthread_join (load i64 tid) (ptr null))
    (call @prctl (i32 15) (string \"fib-main\") (i64 0) (i64 0) (i64 0))
    (call @fib.guard-restore old)
    (ret))
  (block here
    (let ((lim (alloca (align 8) i8 (i32 16)))
          (_g (call @getrlimit (i32 3) lim))
          (cur (load i64 lim)))
      (store (select (icmp ult cur (i64 1073741824)) cur (i64 1073741824)) @fib.main-stack)
      (call @fib.guard-enter (load i64 @fib.main-stack))
      (indirect-call (load ptr @fib.main-fn) (fn void ()))
      (call @fib.guard-leave)
      (call @fib.guard-restore old)
      (ret))))
;; guard-end
")

;; task.lir
(def RT-TASK: str
";; fib.rt, tasks (types §8.8): the run queue, the pool of workers that
;; take tasks from it, the joiners that drive it too, parking at an
;; await and the wake at a completion. A task's state word: 0 pending
;; (never resumed), 1 running or queued, 2 done, 3 parked (registered
;; as a waiter of another task). Its driver word: 0 free, 1 claimed;
;; resume runs only under a claim, and a task in state 3 is never
;; resumed until its wake sets 1 and queues it. The queue is under a
;; pthread mutex with one condition variable, broadcast at every
;; enqueue and every completion, so an idle worker or a waiting joiner
;; sleeps instead of spinning.
(declare sysconf i64 (i32))
(declare pthread_mutex_init i32 (ptr ptr))
(declare pthread_mutex_lock i32 (ptr))
(declare pthread_mutex_unlock i32 (ptr))
(declare pthread_cond_init i32 (ptr ptr))
(declare pthread_cond_wait i32 (ptr ptr))
(declare pthread_cond_broadcast i32 (ptr))
(global internal fib.rq-head ptr (ptr null))
(global internal fib.rq-tail ptr (ptr null))
(global internal fib.rq-mutex ptr (ptr null))
(global internal fib.rq-cond ptr (ptr null))
(global internal fib.pool-started i32 (i32 0))
;; Workers inside a task: counted under the mutex, for fib.pool-quiesce.
(global internal fib.pool-busy i32 (i32 0))

;; From fib.init: the mutex (40 bytes on glibc x86-64) and the
;; condition variable (48 bytes), allocated and initialised.
(define internal (fib.rq-init void) ()
  (block entry
    (let ((m (call @malloc (i64 64)))
          (c (call @malloc (i64 64))))
      (call @pthread_mutex_init m (ptr null))
      (call @pthread_cond_init c (ptr null))
      (store m @fib.rq-mutex)
      (store c @fib.rq-cond)
      (ret))))

(define internal (fib.rq-lock void) ()
  (block entry (call @pthread_mutex_lock (load ptr @fib.rq-mutex)) (ret)))

(define internal (fib.rq-unlock void) ()
  (block entry (call @pthread_mutex_unlock (load ptr @fib.rq-mutex)) (ret)))

(define internal (fib.rq-broadcast void) ()
  (block entry (call @pthread_cond_broadcast (load ptr @fib.rq-cond)) (ret)))

;; A queue node: task, next. Appended under the mutex; every sleeper
;; is woken.
(define internal (fib.enqueue void) ((ptr task))
  (block entry
    (let ((node (call @malloc (i64 16))))
      (store task node)
      (store (ptr null) (getelementptr i8 node (i64 8)))
      (call @fib.rq-lock)
      (br (icmp eq (load ptr @fib.rq-tail) (ptr null)) first append)))
  (block first
    (store node @fib.rq-head)
    (store node @fib.rq-tail)
    (br out))
  (block append
    (store node (getelementptr i8 (load ptr @fib.rq-tail) (i64 8)))
    (store node @fib.rq-tail)
    (br out))
  (block out
    (call @fib.rq-broadcast)
    (call @fib.rq-unlock)
    (call @fib.pool-start)
    (ret)))

;; The head node unlinked, or null; the mutex is held.
(define internal (fib.pop-locked ptr) ()
  (block entry
    (let ((node (load ptr @fib.rq-head)))
      (br (icmp eq node (ptr null)) empty take)))
  (block empty (ret (ptr null)))
  (block take
    (let ((next (load ptr (getelementptr i8 node (i64 8))))
          (task (load ptr node)))
      (store next @fib.rq-head)
      (br (icmp eq next (ptr null)) last more)))
  (block last (store (ptr null) @fib.rq-tail) (br out))
  (block more (br out))
  (block out (call @free node) (ret task)))

;; The task at the head of the queue, or null.
(define internal (fib.dequeue ptr) ()
  (block entry
    (call @fib.rq-lock)
    (let ((task (call @fib.pop-locked)))
      (call @fib.rq-unlock)
      (ret task))))

;; The head of the queue for a worker, sleeping until there is one;
;; the worker counts as busy from here until fib.worker-done.
(define internal (fib.dequeue-wait ptr) ()
  (block entry (call @fib.rq-lock) (br test))
  (block test
    (let ((task (call @fib.pop-locked)))
      (br (icmp eq task (ptr null)) sleep got)))
  (block sleep
    (call @pthread_cond_wait (load ptr @fib.rq-cond) (load ptr @fib.rq-mutex))
    (br test))
  (block got
    (store (add (load i32 @fib.pool-busy) (i32 1)) @fib.pool-busy)
    (call @fib.rq-unlock)
    (ret task)))

;; A worker has finished a task: no longer busy; sleepers told.
(define internal (fib.worker-done void) ()
  (block entry
    (call @fib.rq-lock)
    (store (sub (load i32 @fib.pool-busy) (i32 1)) @fib.pool-busy)
    (call @fib.rq-broadcast)
    (call @fib.rq-unlock)
    (ret)))

;; At the program's exit, after its spawned threads are joined: waits
;; until the queue is empty and no worker is inside a task, so every
;; release a worker owes has been done (compiler.md §4: the trace must
;; hold every free before the process ends); the work-stealing pool
;; (sched.lir) drains first.
(define internal (fib.pool-quiesce void) ()
  (block entry (call @fib.sched-quiesce) (call @fib.rq-lock) (br test))
  (block test
    (br (and (icmp eq (load ptr @fib.rq-head) (ptr null)) (icmp eq (load i32 @fib.pool-busy) (i32 0))) done sleep))
  (block sleep
    (call @pthread_cond_wait (load ptr @fib.rq-cond) (load ptr @fib.rq-mutex))
    (br test))
  (block done (call @fib.rq-unlock) (call @fib.lc-report) (ret)))

;; A joiner with nothing to run sleeps until the queue has a task or
;; its own task is done; both are broadcast.
(define internal (fib.idle-wait void) ((ptr task))
  (block entry
    (call @fib.rq-lock)
    (br (icmp ne (load ptr @fib.rq-head) (ptr null)) out check))
  (block check
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task task (i32 0) (i32 3))) (i32 2)) out sleep))
  (block sleep
    (call @pthread_cond_wait (load ptr @fib.rq-cond) (load ptr @fib.rq-mutex))
    (br out))
  (block out (call @fib.rq-unlock) (ret)))

;; Starts the workers once, on the first enqueue: one per processor,
;; and a T line in trace mode (compiler.md §4), since from here on the
;; program's allocations interleave with the workers'.
(define internal (fib.pool-start void) ()
  (block entry
    (let ((r (cmpxchg acq_rel acquire @fib.pool-started (i32 0) (i32 1))))
      (br (extractvalue r 1) start done)))
  (block start
    (atomic-store monotonic (i32 1) @fib.mt)
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced spawn))
  (block traced (call @write (i32 2) (string \"T\\n\") (i64 2)) (br spawn))
  (block spawn
    (let ((n0 (call @sysconf (i32 84)))
          (n (select (icmp slt n0 (i64 1)) (i64 1) n0)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (spawn (i64 0)) (next i2))))
      (br (icmp slt i n) one done)))
  (block one
    (let ((handle (alloca i64))
          (attr (alloca (align 8) i8 (i32 128)))
          (_a (call @fib.thread-attr attr))
          (rc (call @pthread_create handle attr @fib.worker (ptr null))))
      (atomicrmw add monotonic @fib.thread-total (i64 1))
      (call @pthread_attr_destroy attr)
      (br (icmp ne rc (i32 0)) failed next)))
  (block failed
    (call @fib.fatal-c (string \"async: cannot start a worker thread\"))
    (unreachable))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block done (ret)))

;; A worker: runs whatever the queue holds, sleeping when it is empty.
(define internal (fib.worker ptr) ((ptr arg))
  (block entry (call @fib.guard-enter (load i64 @fib.thread-stack)) (br loop))
  (block loop
    (let ((t (call @fib.dequeue-wait)))
      (call @fib.run-one t)
      (call @fib.worker-done)
      (br loop))))

;; Runs a queued task under a claim of its driver; a task whose driver
;; is still held goes back on the queue; one a joiner drove meanwhile
;; to its completion or to a park is left alone. The queue's count on
;; the task is released afterwards.
(define internal (fib.run-one void) ((ptr t))
  (block entry
    (let ((dp (getelementptr %struct.fib.task t (i32 0) (i32 4)))
          (r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed busy)))
  (block busy (call @sched_yield) (call @fib.enqueue t) (ret))
  (block claimed
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task t (i32 0) (i32 3))) (i32 1)) resume unclaim))
  (block resume
    (indirect-call (load ptr (getelementptr %struct.fib.task t (i32 0) (i32 6))) (fn void (ptr)) t)
    (br unclaim))
  (block unclaim
    (atomic-store release (i32 0) dp)
    (call @fib.release t)
    (ret)))

;; join/block-on (§8.8): drives the executor until the task is done,
;; resuming the task itself when it can claim it, running other queued
;; tasks meanwhile, sleeping when there is nothing to run. A pool task
;; (sched.lir) is joined by the pool's own join, which helps instead.
(define internal (fib.drive void) ((ptr task))
  (block entry
    (let ((sp (getelementptr %struct.fib.task task (i32 0) (i32 3)))
          (dp (getelementptr %struct.fib.task task (i32 0) (i32 4))))
      (br (call @fib.sched-pool-task task) pool loop)))
  (block pool (call @fib.sched-join task) (ret))
  (block loop
    (br (icmp eq (atomic-load acquire i32 sp) (i32 2)) done claim))
  (block claim
    (let ((r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed other)))
  (block claimed
    (let ((s (atomic-load acquire i32 sp)))
      (br (icmp eq s (i32 2)) unclaim-done check-parked)))
  (block check-parked (br (icmp eq s (i32 3)) parked resume))
  (block unclaim-done (atomic-store release (i32 0) dp) (ret))
  (block resume
    (atomic-store release (i32 1) sp)
    (indirect-call (load ptr (getelementptr %struct.fib.task task (i32 0) (i32 6))) (fn void (ptr)) task)
    (atomic-store release (i32 0) dp)
    (br loop))
  (block parked (atomic-store release (i32 0) dp) (br other))
  (block other
    (let ((u (call @fib.dequeue)))
      (br (icmp eq u (ptr null)) idle run)))
  (block idle (call @fib.idle-wait task) (br loop))
  (block run (call @fib.run-one u) (br loop))
  (block done (ret)))

;; A task that another thread is about to reach is SHARED first (its count atomic, what it captured marked too), as a spawned task is
;; (lcx-spawn): an `async` task is made, driven and released on one thread until it is awaited, so its counts are plain; from
;; await-or-park on, the awaited task is queued for a worker and the awaiting one is registered for a waker on another thread, and
;; their counts, read and written from several threads with plain loads and stores, were a data race (scripts/tsan.sh, cases
;; ownership/24, 32, 44, 174, 233: `fib.release` against `fib.release`, and a task freed while another thread still read it). The
;; mark must come BEFORE the other thread can have the task (a waker sets the state and queues it; after that a joiner may drive
;; it), so await-or-park does it while it still holds the task alone. The waiters of the task are not objects (nodes of a
;; list, slot 8), though the type's walker visits the slot: they are taken out of the task for the walk and put back.
(define internal (fib.share-task void) ((ptr t))
  (block entry
    (br (icmp ne (and (call @fib.flags t) (i32 9)) (i32 0)) done mark))
  (block mark
    (let ((wp (getelementptr %struct.fib.task t (i32 0) (i32 8))))
      (let ((saved (load ptr wp)))
        (store (ptr null) wp)
        (call @fib.share t)
        (store saved wp)
        (br done))))
  (block done (ret)))

;; `await e` from the running task `self`: 0 when `e` is done (the
;; result can be read at once), else `self` is registered as a waiter
;; of `e`, marked parked, and 1 says return from the resume. A pending
;; `e` is queued so that a worker or a joiner starts it (syntax §3.12:
;; the executor runs a task when it is awaited).
(define internal (fib.await-or-park i1) ((ptr self) (ptr e))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task e (i32 0) (i32 5)))
          (sp (getelementptr %struct.fib.task e (i32 0) (i32 3))))
      (call @fib.lock lockp)
      (let ((s (atomic-load acquire i32 sp)))
        (br (icmp eq s (i32 2)) done pending?))))
  (block done (call @fib.unlock lockp) (ret (i1 0)))
  (block pending? (br (icmp eq s (i32 0)) start register))
  (block start
    (atomic-store release (i32 1) sp)
    (call @fib.share-task e)
    (call @fib.retain e)
    (call @fib.enqueue e)
    (br register))
  (block register
    (call @fib.share-task self)
    (let ((node (call @malloc (i64 16)))
          (wp (getelementptr %struct.fib.task e (i32 0) (i32 8))))
      (call @fib.retain self)
      (store self node)
      (store (load ptr wp) (getelementptr i8 node (i64 8)))
      (atomic-store release node wp)
      (atomic-store release (i32 3) (getelementptr %struct.fib.task self (i32 0) (i32 3)))
      (call @fib.unlock lockp)
      (ret (i1 1)))))

;; Completion (§8.8): state done, then every waiter is woken: marked
;; runnable and queued, the registration's count passing to the queue.
(define internal (fib.task-complete void) ((ptr task))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task task (i32 0) (i32 5)))
          (wp (getelementptr %struct.fib.task task (i32 0) (i32 8))))
      (atomic-store release (i32 2) (getelementptr %struct.fib.task task (i32 0) (i32 3)))
      (call @fib.lock lockp)
      (let ((list (load ptr wp)))
        (atomic-store release (ptr null) wp)
        (call @fib.unlock lockp)
        (br wake))))
  (block wake
    (let ((node (phi ptr (entry list) (woken next))))
      (br (icmp eq node (ptr null)) done woken)))
  (block woken
    (let ((w (load ptr node))
          (next (load ptr (getelementptr i8 node (i64 8)))))
      (call @free node)
      (atomic-store release (i32 1) (getelementptr %struct.fib.task w (i32 0) (i32 3)))
      (call @fib.enqueue w)
      (br wake)))
  (block done (call @fib.rq-lock) (call @fib.rq-broadcast) (call @fib.rq-unlock) (ret)))

;; The message a task failed with (a share-marked str, null when it did not fail). `task-failure` and `fib.raise-failed` read it
;; after the task is done: the store of fib.fail-task precedes the release store of the state.
(define internal (fib.task-failure ptr) ((ptr task))
  (block entry
    (ret (atomic-load acquire ptr (getelementptr %struct.fib.task task (i32 0) (i32 10))))))

;; `join` and `@t` of a task that failed trap in the joiner with the task's own message; a task that did not fail is left alone.
(define internal (fib.raise-failed void) ((ptr task))
  (block entry
    (let ((msg (call @fib.task-failure task)))
      (br (icmp ne msg (ptr null)) failed done)))
  (block failed
    (call @fib.trap msg)
    (unreachable))
  (block done (ret)))
")

;; deque.lir
(def RT-DEQUE: str
";; fib.rt, the deques of the work-stealing pool (docs/design/parallelism.md 2.3 and 3.1; the pool itself is sched.lir): a Chase-Lev
;; deque per worker (Le, Pop, Cohen, Nardelli 2013, in the lIR of docs/design/parallelism/proto/cl.lir, whose orderings are kept as
;; they are: the stress test of that experiment finds a missing compare-and-swap and a missing race for the last item, and not a
;; weakened fence, which a model checker would), the injector list for threads that are not workers, and the worker count.
;; A worker record (256 bytes, sched.lir): 0 top, 64 bottom (lines of their own), 128 ring of 4096 task pointers, 136 index, 144 rng,
;; 160 tasks run, 168 steals, 176 forks, 184 forks run inline (ring full), 192 chain, 200 depth, 208 the count flag of the next run.
(declare sched_getaffinity i32 (i32 i64 ptr))
(global internal fib.sched-recs ptr (ptr null))
(global internal fib.sched-live i64 (i64 0))
(global internal fib.sched-n i64 (i64 0))
(global internal fib.sched-inj-head ptr (ptr null))
(global internal fib.sched-inj-tail ptr (ptr null))
(global internal fib.sched-inj-lock i32 (i32 0))
;; The ring of a deque has 4096 slots.
(global internal fib.sched-mask i64 (i64 4095))

;; The record of worker `i`.
(define internal (fib.sched-rec ptr) ((i64 i))
  (block entry (ret (load ptr (getelementptr ptr (load ptr @fib.sched-recs) i)))))

;; ---- the deque (cl.lir: push and pop by the owner, steal by anyone)

;; The owner pushes; 0 when the ring is full.
(define internal (fib.sched-push i1) ((ptr w) (ptr t))
  (block entry
    (let ((b (atomic-load monotonic i64 (getelementptr i8 w (i64 64))))
          (top (atomic-load acquire i64 w)))
      (br (icmp sge (sub b top) (i64 4096)) full room)))
  (block full (ret (i1 0)))
  (block room
    (atomic-store release t (getelementptr ptr (load ptr (getelementptr i8 w (i64 128))) (and b (load i64 @fib.sched-mask))))
    (fence release)
    (atomic-store monotonic (add b (i64 1)) (getelementptr i8 w (i64 64)))
    (ret (i1 1))))

;; The owner pops its newest task, or null.
(define internal (fib.sched-pop ptr) ((ptr w))
  (block entry
    (let ((bp (getelementptr i8 w (i64 64)))
          (b (sub (atomic-load monotonic i64 bp) (i64 1))))
      (atomic-store monotonic b bp)
      (fence seq_cst)
      (let ((t (atomic-load monotonic i64 w)))
        (br (icmp sle t b) nonempty empty))))
  (block empty (atomic-store monotonic (add b (i64 1)) bp) (ret (ptr null)))
  (block nonempty
    (let ((x (atomic-load acquire ptr (getelementptr ptr (load ptr (getelementptr i8 w (i64 128))) (and b (load i64 @fib.sched-mask))))))
      (br (icmp eq t b) last more)))
  (block more (ret x))
  (block last
    (let ((r (cmpxchg seq_cst monotonic w t (add t (i64 1)))))
      (atomic-store monotonic (add b (i64 1)) bp)
      (ret (select (extractvalue r 1) x (ptr null))))))

;; A thief takes the oldest task of `w`, or null.
(define internal (fib.sched-steal ptr) ((ptr w))
  (block entry
    (let ((t (atomic-load acquire i64 w)))
      (fence seq_cst)
      (let ((b (atomic-load acquire i64 (getelementptr i8 w (i64 64)))))
        (br (icmp slt t b) some none))))
  (block none (ret (ptr null)))
  (block some
    (let ((x (atomic-load acquire ptr (getelementptr ptr (load ptr (getelementptr i8 w (i64 128))) (and t (load i64 @fib.sched-mask)))))
          (r (cmpxchg seq_cst monotonic w t (add t (i64 1)))))
      (ret (select (extractvalue r 1) x (ptr null))))))

;; Whether any deque or the injector holds a task (the re-check before a sleep; a plain sweep).
(define internal (fib.sched-any-work i1) ()
  (block entry (br (icmp ne (atomic-load acquire ptr @fib.sched-inj-head) (ptr null)) yes sweep))
  (block sweep
    (let ((n (atomic-load acquire i64 @fib.sched-live))) (br loop)))
  (block loop
    (let ((i (phi i64 (sweep (i64 0)) (next i2))))
      (br (icmp slt i n) look no)))
  (block look
    (let ((w (call @fib.sched-rec i))
          (t (atomic-load acquire i64 w))
          (b (atomic-load acquire i64 (getelementptr i8 w (i64 64)))))
      (br (icmp slt t b) yes next)))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block yes (ret (i1 1)))
  (block no (ret (i1 0))))

;; ---- the injector: a list of (task, next) nodes under a spinlock, for forks from threads that are not workers

(define internal (fib.sched-inject void) ((ptr t))
  (block entry
    (let ((node (call @malloc (i64 16))))
      (store t node)
      (store (ptr null) (getelementptr i8 node (i64 8)))
      (call @fib.lock @fib.sched-inj-lock)
      (br (icmp eq (load ptr @fib.sched-inj-tail) (ptr null)) first append)))
  (block first (atomic-store release node @fib.sched-inj-head) (store node @fib.sched-inj-tail) (br out))
  (block append (store node (getelementptr i8 (load ptr @fib.sched-inj-tail) (i64 8))) (store node @fib.sched-inj-tail) (br out))
  (block out (call @fib.unlock @fib.sched-inj-lock) (ret)))

(define internal (fib.sched-take-injected ptr) ()
  (block entry
    (br (icmp eq (atomic-load acquire ptr @fib.sched-inj-head) (ptr null)) empty locked))
  (block empty (ret (ptr null)))
  (block locked
    (call @fib.lock @fib.sched-inj-lock)
    (let ((node (atomic-load acquire ptr @fib.sched-inj-head)))
      (br (icmp eq node (ptr null)) none take)))
  (block none (call @fib.unlock @fib.sched-inj-lock) (ret (ptr null)))
  (block take
    (let ((next (load ptr (getelementptr i8 node (i64 8))))
          (t (load ptr node)))
      (atomic-store release next @fib.sched-inj-head)
      (br (icmp eq next (ptr null)) last more)))
  (block last (store (ptr null) @fib.sched-inj-tail) (br out))
  (block more (br out))
  (block out (call @fib.unlock @fib.sched-inj-lock) (call @free node) (ret t)))

;; ---- the worker count: FIB_THREADS, else the affinity mask capped by the cgroup quota (1 to 256)

;; The decimal number at p (leading blanks skipped, digits only; no sign), -1 when there is none; *endp is left after the digits. No
;; strtol: a WASI runtime has none of the guard section's declarations, and a number this small needs no more.
(define internal (fib.sched-num i64) ((ptr p) (ptr endp))
  (block entry (br skip))
  (block skip
    (let ((q (phi ptr (entry p) (blank q2)))
          (c (load i8 q)))
      (br (icmp eq c (i8 32)) blank digits)))
  (block blank (let ((q2 (getelementptr i8 q (i64 1)))) (br skip)))
  (block digits
    (br (and (icmp uge (load i8 q) (i8 48)) (icmp ule (load i8 q) (i8 57))) scan none))
  (block none (store q endp) (ret (i64 -1)))
  (block scan (br loop))
  (block loop
    (let ((r (phi ptr (scan q) (more r2)))
          (acc (phi i64 (scan (i64 0)) (more acc2)))
          (d (load i8 r)))
      (br (and (icmp uge d (i8 48)) (icmp ule d (i8 57))) more done)))
  (block more
    (let ((acc2 (select (icmp ult acc (i64 100000000000)) (add (mul acc (i64 10)) (zext i64 (sub d (i8 48)))) acc))
          (r2 (getelementptr i8 r (i64 1))))
      (br loop)))
  (block done (store r endp) (ret acc)))

;; FIB_THREADS as a number, or 0 when unset or not a number from 1 to 256.
(define internal (fib.sched-env-threads i64) ()
  (block entry
    (let ((v (call @getenv (string \"FIB_THREADS\"))))
      (br (icmp eq v (ptr null)) none parse)))
  (block none (ret (i64 0)))
  (block parse
    (let ((end (alloca ptr))
          (n (call @fib.sched-num v end))
          (good (and (icmp ne (load i8 v) (i8 0))
                     (and (icmp eq (load i8 (load ptr end)) (i8 0)) (and (icmp sge n (i64 1)) (icmp sle n (i64 256)))))))
      (ret (select good n (i64 0))))))

;; The CPUs of this process's affinity mask (0 where the call is not available: Darwin, emit.os).
(define internal (fib.sched-affinity i64) ()
  (block entry
    (let ((mask (alloca (align 8) i64 (i32 16)))
          (rc (call @sched_getaffinity (i32 0) (i64 128) mask)))
      (br (icmp ne rc (i32 0)) none count)))
  (block none (ret (i64 0)))
  (block count (br loop))
  (block loop
    (let ((i (phi i64 (count (i64 0)) (next i2)))
          (acc (phi i64 (count (i64 0)) (next acc2))))
      (br (icmp slt i (i64 16)) word done)))
  (block word
    (let ((acc2 (add acc (ctpop (load i64 (getelementptr i64 mask i)))))
          (i2 (add i (i64 1))))
      (br next)))
  (block next (br loop))
  (block done (ret acc)))

;; The cgroup v2 quota of /sys/fs/cgroup/cpu.max (\"max PERIOD\" or \"QUOTA PERIOD\"), rounded up to whole CPUs; 0 when there is none.
(define internal (fib.sched-cgroup i64) ()
  (block entry
    (let ((fd (call @openat (i32 -100) (string \"/sys/fs/cgroup/cpu.max\") (i32 0))))
      (br (icmp slt fd (i32 0)) none read)))
  (block none (ret (i64 0)))
  (block read
    (let ((buf (alloca i8 (i32 64)))
          (n (call @read fd buf (i64 63))))
      (call @close fd)
      (br (icmp sle n (i64 0)) none parse)))
  (block parse
    (store (i8 0) (getelementptr i8 buf n))
    (br (icmp eq (load i8 buf) (i8 109)) none numbers))
  (block numbers
    (let ((end (alloca ptr))
          (quota (call @fib.sched-num buf end))
          (period (call @fib.sched-num (load ptr end) end)))
      (br (and (icmp sgt quota (i64 0)) (icmp sgt period (i64 0))) ratio none)))
  (block ratio (ret (udiv (add quota (sub period (i64 1))) period))))

;; The number of workers: computed once.
(define internal (fib.sched-count i64) ()
  (block entry
    (let ((cached (load i64 @fib.sched-n)))
      (br (icmp ne cached (i64 0)) have compute)))
  (block have (ret cached))
  (block compute
    (let ((env (call @fib.sched-env-threads)))
      (br (icmp ne env (i64 0)) forced detect)))
  (block forced (store env @fib.sched-n) (ret env))
  (block detect
    (let ((aff (call @fib.sched-affinity))
          (onl (call @sysconf (i32 84)))
          (cpus (select (icmp sgt aff (i64 0)) aff onl))
          (quota (call @fib.sched-cgroup))
          (capped (select (and (icmp sgt quota (i64 0)) (icmp slt quota cpus)) quota cpus))
          (n (select (icmp slt capped (i64 1)) (i64 1) (select (icmp sgt capped (i64 256)) (i64 256) capped))))
      (store n @fib.sched-n)
      (ret n))))
")

;; sched.lir
(def RT-SCHED: str
";; fib.rt, the work-stealing pool (docs/design/parallelism.md 3.1, P-sched): the tier T1 of tasks, `fork-task`. A pool task is a
;; `(Task a)` as `spawn` makes one (closure in slot 9, result atom in 7, failure in 10) whose resume function (slot 6) is the pool
;; runner the compiler emits for its result type (emit.lower.threads `pool-entry`); a task with both a closure and a resume function is
;; a pool task, which is how fib.drive tells the tiers apart. Workers start on the first fork, W = FIB_THREADS, else the CPUs of the
;; affinity mask (the affinity call of Linux), capped by the cgroup v2 quota of /sys/fs/cgroup/cpu.max; one Chase-Lev deque per worker (Le, Pop,
;; Cohen, Nardelli 2013: the orderings of docs/design/parallelism/proto/cl.lir, unchanged; a ring of 4096, a full ring runs the task
;; inline at the fork); an injector list for the threads that are not workers (main, spawned threads); random-victim stealing; an
;; eventcount (an epoch word, a count of sleepers, one mutex and one condition variable for the sleep itself) with the re-check after
;; the announcement that keeps a wake-up from being lost. A worker that joins helps: it runs the joined task itself when it can claim
;; it, else its own deque, the injector and other deques, and parks only when there is nothing. A thread that is not a worker never
;; runs a pool task (a trap in one is isolated only on a worker, below): it parks until the task is done. With no worker at all (a
;; target without threads: emit.wasi gives a count of 0) a join runs the task inline.
;; Traps: in a program that catches (ADR 0009) the runner calls the closure under a catch of its own, so a trap unwinds to the runner,
;; which records it as the task's failure and no thread dies. Otherwise a trap on a worker fails every task the worker was running
;; (the one that trapped and the ones whose joins it was helping inside: their joiners would have trapped on the failure anyway, there
;; being no `try` in such a program), a replacement worker takes over its record and the thread ends (fib.sched-fail).
;; The exit waits for the pool to drain (fib.sched-quiesce, from fib.pool-quiesce): every task forked is run before main's return.
(declare pthread_cond_signal i32 (ptr))
(global internal fib.sched-state i32 (i32 0))
(global internal fib.sched-key i32 (i32 0))
(global internal fib.sched-ec i32 (i32 0))
(global internal fib.sched-sleepers i32 (i32 0))
;; Workers in the spin phase of fib.sched-idle (FIB_SCHED_SKIP, default 1: a fork does not signal while one is looking: on WSL2 a fork-join with idle workers was 14 us with the futex wake of every fork, 0.7 us without), and the rounds of the
;; spin phase (FIB_SPIN, default 32): tuning knobs, read once at the start of the pool (docs/shootout/parallel.md, P-sched).
(global internal fib.sched-idlers i32 (i32 0))
(global internal fib.sched-skip i32 (i32 1))
(global internal fib.sched-spin i64 (i64 32))
;; At most this many idle workers spin at once (FIB_SPINNERS, default 2); the others park at once. Every idle worker spinning (a sched_yield a round, a sweep of every deque) cost more
;; than it found: case 8645 (a million tiny tasks) took 0.1 s a run at one worker and 0.9 s at eight on an M1 Ultra (sched_yield is a system call there), 1.5 s at 16 on x86-64 Linux, and 0.4 to 0.7 s
;; with the limit (docs/design/parallelism.md, DARWIN-3). A spinner that finds work leaves the count, so the next fork wakes the next sleeper.
(global internal fib.sched-spinners i32 (i32 2))
(global internal fib.sched-yield-after i64 (i64 0))
(global internal fib.sched-usehint i32 (i32 0))
(global internal fib.sched-hint i32 (i32 0))
(global internal fib.sched-active i64 (i64 0))
(global internal fib.sched-blocked i64 (i64 0))
;; 1 in a program that catches (set by the fork of a pool task in such a program, emit.lower.threads): the runner isolates a trap
;; on any thread then, so a thread that is not a worker may run the task it joins itself.
(global internal fib.sched-catching i32 (i32 0))
(global internal fib.sched-mutex ptr (ptr null))
(global internal fib.sched-cond ptr (ptr null))
;; The condition a thread that is not a worker waits on for its task (it is no sleeper of the eventcount: a fork's signal is for a worker).
(global internal fib.sched-jcond ptr (ptr null))
;; A worker inside 4000 tasks or more (the frames of inline runs and helps nest) sleeps, as a thread that is not a worker does, at a join
;; it cannot run itself instead of helping with other work; a chain of inline runs itself is bounded only by the stack (as the same recursion without tasks would be).
(global internal fib.sched-max-depth i64 (i64 4000))
;; The chain of a worker (the tasks it is inside) has 65536 entries; a deeper nesting of inline runs is a fatal error.
(global internal fib.sched-chain-size i64 (i64 65536))

;; This thread's worker record, or null (not a worker, or no pool yet).
(define internal (fib.sched-self ptr) ()
  (block entry
    (br (icmp eq (atomic-load acquire i32 @fib.sched-state) (i32 2)) up none))
  (block none (ret (ptr null)))
  (block up (ret (call @pthread_getspecific (load i32 @fib.sched-key)))))

;; A pool task: a closure and a resume function (an async task has no closure, a spawned task no resume function).
(define internal (fib.sched-pool-task i1) ((ptr t))
  (block entry
    (ret (and (icmp ne (load ptr (getelementptr %struct.fib.task t (i32 0) (i32 9))) (ptr null))
              (icmp ne (load ptr (getelementptr %struct.fib.task t (i32 0) (i32 6))) (ptr null))))))

;; ---- starting the pool

;; A fresh record of worker `i`, with its ring and chain.
(define internal (fib.sched-new-rec ptr) ((i64 i))
  (block entry
    (let ((w (call @calloc (i64 1) (i64 256))))
      (br (icmp eq w (ptr null)) oom fill)))
  (block oom (call @fib.fatal-c (string \"fork-task: cannot start a worker thread\")) (unreachable))
  (block fill
    (store (call @calloc (i64 4096) (i64 8)) (getelementptr i8 w (i64 128)))
    (store i (getelementptr i8 w (i64 136)))
    (store (add (mul i (i64 2654435761)) (i64 88172645463325252)) (getelementptr i8 w (i64 144)))
    (store (call @calloc (load i64 @fib.sched-chain-size) (i64 8)) (getelementptr i8 w (i64 192)))
    (ret w)))

;; One detached worker thread over the record `w` (also the replacement of a worker that ended on a trap).
(define internal (fib.sched-start-thread void) ((ptr w))
  (block entry
    (let ((handle (alloca i64))
          (attr (alloca (align 8) i8 (i32 128)))
          (_a (call @fib.thread-attr attr))
          (rc (call @pthread_create handle attr @fib.sched-worker w)))
      (atomicrmw add monotonic @fib.thread-total (i64 1))
      (call @pthread_attr_destroy attr)
      (br (icmp ne rc (i32 0)) failed started)))
  (block failed (call @fib.fatal-c (string \"fork-task: cannot start a worker thread\")) (unreachable))
  (block started (call @pthread_detach (load i64 handle)) (ret)))

;; Starts the pool once, on the first fork: the key, the mutex and condition of the eventcount, 2W records (W workers; up to W more for
;; `blocking` sections), the W threads. A second caller that finds the start under way waits for it.
(define internal (fib.sched-start void) ()
  (block entry
    (br (icmp eq (atomic-load acquire i32 @fib.sched-state) (i32 2)) done claim))
  (block claim
    (let ((r (cmpxchg acq_rel acquire @fib.sched-state (i32 0) (i32 1))))
      (br (extractvalue r 1) start wait)))
  (block wait
    (call @sched_yield)
    (br (icmp eq (atomic-load acquire i32 @fib.sched-state) (i32 2)) done wait))
  (block start
    (atomic-store monotonic (i32 1) @fib.mt)
    (call @fib.sched-knobs)
    (call @pthread_key_create @fib.sched-key (ptr null))
    (let ((m (call @malloc (i64 64))) (c (call @malloc (i64 64))) (j (call @malloc (i64 64))))
      (call @pthread_mutex_init m (ptr null))
      (call @pthread_cond_init c (ptr null))
      (call @pthread_cond_init j (ptr null))
      (store m @fib.sched-mutex)
      (store c @fib.sched-cond)
      (store j @fib.sched-jcond))
    (let ((n (call @fib.sched-count))
          (recs (call @calloc (mul n (i64 2)) (i64 8))))
      (store recs @fib.sched-recs)
      (br alloc)))
  (block alloc
    (let ((i (phi i64 (start (i64 0)) (alloc2 i2))))
      (br (icmp slt i (mul n (i64 2))) one spawn)))
  (block one
    (store (call @fib.sched-new-rec i) (getelementptr ptr recs i))
    (br alloc2))
  (block alloc2 (let ((i2 (add i (i64 1)))) (br alloc)))
  (block spawn
    (atomic-store release n @fib.sched-live)
    (atomic-store release n @fib.sched-active)
    (br (icmp ne (load i32 @fib.tracing) (i32 0)) traced threads))
  (block traced (call @write (i32 2) (string \"T\\n\") (i64 2)) (br threads))
  (block threads
    (let ((k (phi i64 (spawn (i64 0)) (traced (i64 0)) (threads2 k2))))
      (br (icmp slt k n) thread up)))
  (block thread (call @fib.sched-start-thread (call @fib.sched-rec k)) (br threads2))
  (block threads2 (let ((k2 (add k (i64 1)))) (br threads)))
  (block up (atomic-store release (i32 2) @fib.sched-state) (br done))
  (block done (ret)))

;; The tuning knobs from the environment: FIB_SPIN (rounds, 0 to 100000), FIB_SCHED_SKIP (0 or 1) and FIB_SPINNERS (idle workers that may spin at once).
(define internal (fib.sched-knobs void) ()
  (block entry
    (let ((a (call @getenv (string \"FIB_SPIN\")))
          (b (call @getenv (string \"FIB_SCHED_SKIP\")))
          (end (alloca ptr)))
      (br (icmp eq a (ptr null)) second spin)))
  (block spin
    (let ((n (call @fib.sched-num a end)))
      (store (select (icmp slt n (i64 0)) (i64 32) n) @fib.sched-spin)
      (br second)))
  (block second
    (br (icmp eq b (ptr null)) third skip))
  (block skip
    (let ((m (call @fib.sched-num b end)))
      (store (select (icmp eq m (i64 0)) (i32 0) (i32 1)) @fib.sched-skip)
      (br third)))
  (block third
    (let ((h (call @getenv (string \"FIB_SPIN_HINT\"))))
      (br (icmp eq h (ptr null)) third1 hintk)))
  (block hintk
    (store (trunc i32 (call @fib.sched-num h end)) @fib.sched-usehint)
    (br third1))
  (block third1
    (let ((y (call @getenv (string \"FIB_SPIN_YIELD_AFTER\"))))
      (br (icmp eq y (ptr null)) third2 yafter)))
  (block yafter
    (store (call @fib.sched-num y end) @fib.sched-yield-after)
    (br third2))
  (block third2
    (let ((c (call @getenv (string \"FIB_SPINNERS\"))))
      (br (icmp eq c (ptr null)) done spinners)))
  (block spinners
    (let ((k (call @fib.sched-num c end)))
      (store (select (icmp slt k (i64 0)) (i32 2) (trunc i32 (select (icmp sgt k (i64 1000000)) (i64 1000000) k))) @fib.sched-spinners)
      (br done)))
  (block done (ret)))

;; ---- forking and running

;; `fork-task` (emit.lower.threads): the task, share-marked and with the handle's count, goes to this worker's deque, or to the
;; injector from a thread that is not a worker; the deque's count is taken here. A full ring, or a pool with no worker at all
;; (emit.wasi), runs the task now, on this thread.
(define internal (fib.sched-fork void) ((ptr task))
  (block entry
    (call @fib.sched-start)
    (call @fib.retain task)
    (let ((w (call @fib.sched-self)))
      (br (icmp eq w (ptr null)) other push)))
  (block other (br (icmp eq (load i64 @fib.sched-n) (i64 0)) full inject))
  (block inject (call @fib.sched-inject task) (br signal))
  (block push
    (let ((fp (getelementptr i8 w (i64 176))))
      (store (add (load i64 fp) (i64 1)) fp)
      (br (call @fib.sched-push w task) signal full)))
  (block full
    (let ((ip (getelementptr i8 w (i64 184))))
      (store (add (load i64 ip) (i64 1)) ip)
      (call @fib.sched-run task)
      (ret)))
  (block signal (call @fib.sched-signal) (ret)))

;; Runs a task taken from a deque or the injector under a claim of its driver: a task its joiner claimed first, or one already
;; done, is left alone. The deque's count is released afterwards.
(define internal (fib.sched-run void) ((ptr t))
  (block entry
    (let ((dp (getelementptr %struct.fib.task t (i32 0) (i32 4)))
          (sp (getelementptr %struct.fib.task t (i32 0) (i32 3)))
          (r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed out)))
  (block claimed
    (br (icmp ult (atomic-load acquire i32 sp) (i32 2)) resume unclaim))
  (block resume
    (atomic-store release (i32 1) sp)
    (call @fib.sched-note-count)
    (indirect-call (load ptr (getelementptr %struct.fib.task t (i32 0) (i32 6))) (fn void (ptr)) t)
    (br unclaim))
  (block unclaim (atomic-store release (i32 0) dp) (br out))
  (block out (call @fib.release t) (ret)))

;; Before a run from a deque or the injector: this worker's next entered task holds the deque's count (released by fib.sched-fail if
;; the task ends in a trap, by fib.sched-run otherwise).
(define internal (fib.sched-note-count void) ()
  (block entry
    (let ((w (call @fib.sched-self)))
      (br (icmp eq w (ptr null)) done note)))
  (block note (store (i64 1) (getelementptr i8 w (i64 208))) (br done))
  (block done (ret)))

;; The first call of the pool runner: the task becomes this thread's task (fib.task-key: a trap fails it) and, on a worker, the
;; innermost of its chain (bit 0 of the entry: the run holds the deque's count); returns the task that was current before.
(define internal (fib.sched-enter ptr) ((ptr t))
  (block entry
    (let ((prev (call @pthread_getspecific (load i32 @fib.task-key)))
          (w (call @fib.sched-self)))
      (call @pthread_setspecific (load i32 @fib.task-key) t)
      (br (icmp eq w (ptr null)) done chain)))
  (block chain
    (let ((dp (getelementptr i8 w (i64 200)))
          (d (load i64 dp))
          (rp (getelementptr i8 w (i64 160)))
          (np (getelementptr i8 w (i64 208)))
          (tagged (inttoptr ptr (or (ptrtoint i64 t) (load i64 np)))))
      (br (icmp sge d (load i64 @fib.sched-chain-size)) toodeep record)))
  (block toodeep
    (call @fib.fatal-c (string \"fork-task: joins nested too deep on one worker\"))
    (unreachable))
  (block record
    (store tagged (getelementptr ptr (load ptr (getelementptr i8 w (i64 192))) d))
    (store (i64 0) np)
    (store (add d (i64 1)) dp)
    (store (add (load i64 rp) (i64 1)) rp)
    (br done))
  (block done (ret prev)))

;; The task is done: its waiters are woken (async waiters queued; a parked thread, marked by a node whose word is 1, by the eventcount).
;; The store of the state and the load of the waiters are ordered by a seq_cst fence against a joiner's store of its node and load of
;; the state (fib.sched-wait): one of the two sees the other, so no joiner registers after a completion that saw no waiter.
(define internal (fib.sched-wake-waiters void) ((ptr task))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task task (i32 0) (i32 5)))
          (wp (getelementptr %struct.fib.task task (i32 0) (i32 8))))
      (atomic-store release (i32 2) (getelementptr %struct.fib.task task (i32 0) (i32 3)))
      (fence seq_cst)
      (br (icmp eq (atomic-load acquire ptr wp) (ptr null)) nobody locked)))
  (block locked
    (call @fib.lock lockp)
    (let ((list (load ptr wp)))
      (atomic-store release (ptr null) wp)
      (call @fib.unlock lockp)
      (br wake)))
  (block wake
    (let ((node (phi ptr (locked list) (woken next) (thread next)))
          (any (phi i1 (locked (i1 0)) (woken any) (thread (i1 1)))))
      (br (icmp eq node (ptr null)) done woken?)))
  (block woken?
    (let ((w (load ptr node))
          (next (load ptr (getelementptr i8 node (i64 8)))))
      (call @free node)
      (br (icmp eq (ptrtoint i64 w) (i64 1)) thread woken)))
  (block thread (br wake))
  (block woken
    (atomic-store release (i32 1) (getelementptr %struct.fib.task w (i32 0) (i32 3)))
    (call @fib.enqueue w)
    (br wake))
  (block done (br any all nobody))
  (block all (call @fib.sched-wake-all) (br nobody))
  (block nobody (ret)))

;; The last call of the pool runner: state done, waiters woken, the thread's task put back, the chain popped.
(define internal (fib.sched-complete void) ((ptr task) (ptr prev))
  (block entry
    (call @fib.sched-wake-waiters task)
    (call @pthread_setspecific (load i32 @fib.task-key) prev)
    (let ((w (call @fib.sched-self)))
      (br (icmp eq w (ptr null)) done pop)))
  (block pop
    (let ((dp (getelementptr i8 w (i64 200))))
      (store (sub (load i64 dp) (i64 1)) dp)
      (br done)))
  (block done (ret)))

;; A failure the runner caught (a catching program): a trap's message is the task's failure; a thrown object is released and
;; the failure says so. `trap in task:` on fd 2 as a thread's trap does (fib.fail-task).
(define internal (fib.sched-failed void) ((ptr task) (ptr ex))
  (block entry
    (br (icmp ne (and (ptrtoint i64 ex) (i64 1)) (i64 0)) msg obj))
  (block msg
    (let ((s (inttoptr ptr (and (ptrtoint i64 ex) (i64 -2)))))
      (call @fib.sched-record-failure task s)
      (ret)))
  (block obj
    (call @fib.release ex)
    (call @fib.sched-record-failure task (call @fib.str-from-bytes (string \"throw: an object was thrown in a task\") (i64 37)))
    (ret)))

;; Records the share-marked message `s` (its count passes to the task) as the task's failure and prints the trap line.
(define internal (fib.sched-record-failure void) ((ptr task) (ptr s))
  (block entry
    (let ((n (load i64 (getelementptr %struct.fib.str s (i32 0) (i32 3))))
          (line (call @malloc (add n (i64 16)))))
      (call @fib.share s)
      (call @memcpy line (string \"trap in task: \") (i64 14))
      (call @memcpy (getelementptr i8 line (i64 14)) (getelementptr %struct.fib.str s (i32 0) (i32 4) (i64 0)) n)
      (store (i8 10) (getelementptr i8 line (add n (i64 14))))
      (call @write (i32 2) line (add n (i64 15)))
      (call @free line)
      (atomic-store release s (getelementptr %struct.fib.task task (i32 0) (i32 10)))
      (ret))))

;; A trap in a pool task that did not unwind (fib.fail-task: the message is recorded already). On a worker every task of its chain
;; fails with the message (each joiner would trap on it) and the deque's count of each is released (what the tasks' frames owned is
;; abandoned: audit `abandoned`), the record gets a new thread and this one ends; on any other thread (a target with no workers runs
;; tasks inline) the trap is the process's, as a trap outside a task is.
(define internal (fib.sched-fail void) ((ptr task) (ptr msg))
  (block entry
    (let ((w (call @fib.sched-self)))
      (br (icmp eq w (ptr null)) fatal chain)))
  (block fatal (call @abort) (unreachable))
  (block chain
    (let ((dp (getelementptr i8 w (i64 200)))
          (chainp (load ptr (getelementptr i8 w (i64 192)))))
      (br loop)))
  (block loop
    (let ((d (load i64 dp)))
      (br (icmp sgt d (i64 0)) one restart)))
  (block one
    (let ((e (ptrtoint i64 (load ptr (getelementptr ptr chainp (sub d (i64 1))))))
          (t (inttoptr ptr (and e (i64 -2))))
          (fp (getelementptr %struct.fib.task t (i32 0) (i32 10))))
      (store (sub d (i64 1)) dp)
      (br (icmp eq (atomic-load acquire ptr fp) (ptr null)) mark wake)))
  (block mark (call @fib.retain msg) (atomic-store release msg fp) (br wake))
  (block wake
    (call @fib.sched-wake-waiters t)
    (br (icmp ne (and e (i64 1)) (i64 0)) counted loop))
  (block counted (call @fib.release t) (br loop))
  (block restart
    (call @pthread_setspecific (load i32 @fib.task-key) (ptr null))
    (call @fib.guard-leave)
    (call @fib.sched-start-thread w)
    (atomicrmw sub monotonic @fib.thread-total (i64 1))
    (call @pthread_exit (ptr null))
    (unreachable)))

;; ---- workers

(define internal (fib.sched-random i64) ((ptr w))
  (block entry
    (let ((rp (getelementptr i8 w (i64 144)))
          (x0 (load i64 rp))
          (x1 (xor x0 (shl x0 (i64 13))))
          (x2 (xor x1 (lshr x1 (i64 7))))
          (x3 (xor x2 (shl x2 (i64 17)))))
      (store x3 rp)
      (ret (lshr x3 (i64 1))))))

;; Work for `w`: its own deque, the injector, two random victims, then every other deque in turn; null when there is none.
(define internal (fib.sched-find ptr) ((ptr w))
  (block entry
    (let ((own (call @fib.sched-pop w)))
      (br (icmp ne own (ptr null)) found injected)))
  (block injected
    (let ((inj (call @fib.sched-take-injected)))
      (br (icmp ne inj (ptr null)) found random)))
  (block random
    (let ((n (atomic-load acquire i64 @fib.sched-live))
          (v1 (call @fib.sched-steal (call @fib.sched-rec (urem (call @fib.sched-random w) n)))))
      (br (icmp ne v1 (ptr null)) stolen random2)))
  (block random2
    (let ((v2 (call @fib.sched-steal (call @fib.sched-rec (urem (call @fib.sched-random w) n)))))
      (br (icmp ne v2 (ptr null)) stolen sweep)))
  (block sweep (br loop))
  (block loop
    (let ((i (phi i64 (sweep (i64 0)) (next i2))))
      (br (icmp slt i n) look none)))
  (block look
    (let ((v (call @fib.sched-steal (call @fib.sched-rec i))))
      (br (icmp ne v (ptr null)) stolen next)))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block stolen
    (let ((x (phi ptr (random v1) (random2 v2) (look v)))
          (sp (getelementptr i8 w (i64 168))))
      (store (add (load i64 sp) (i64 1)) sp)
      (ret x)))
  (block found (ret (phi ptr (entry own) (injected inj))))
  (block none (ret (ptr null))))

;; An idle worker: a few rounds of looking with a yield between them, then the eventcount: announce, re-check, sleep. The re-check
;; after the announcement is what keeps a wake-up from being lost (a fork that saw no sleeper is seen here).
(define internal (fib.sched-idle void) ((ptr w))
  (block entry
    (let ((o (atomicrmw add seq_cst @fib.sched-idlers (i32 1))))
      (br (icmp sge o (load i32 @fib.sched-spinners)) leave spin)))
  (block spin
    (let ((i (phi i64 (entry (i64 0)) (again i2))))
      (br (icmp slt i (load i64 @fib.sched-spin)) look leave)))
  (block look
    (br (icmp slt i (load i64 @fib.sched-yield-after)) sweep yield))
  (block yield (call @sched_yield) (br sweep))
  (block sweep
    (br (icmp eq (load i32 @fib.sched-usehint) (i32 0)) check hintcheck))
  (block hintcheck
    (br (icmp eq (atomic-load acquire i32 @fib.sched-hint) (i32 0)) again take))
  (block take
    (let ((old (atomicrmw xchg acq_rel @fib.sched-hint (i32 0))))
      (br (icmp ne old (i32 0)) check again)))
  (block check
    (br (call @fib.sched-any-work) found again))
  (block found
    (br (icmp eq (load i32 @fib.sched-usehint) (i32 0)) found2 rehint))
  (block rehint (atomic-store release (i32 1) @fib.sched-hint) (br found2))
  (block found2 (atomicrmw sub seq_cst @fib.sched-idlers (i32 1)) (br out))
  (block leave (atomicrmw sub seq_cst @fib.sched-idlers (i32 1)) (br park))
  (block again (let ((i2 (add i (i64 1)))) (br spin)))
  (block park
    (let ((epoch (call @fib.sched-announce)))
      (br (call @fib.sched-any-work) withdraw sleep)))
  (block withdraw (atomicrmw sub seq_cst @fib.sched-sleepers (i32 1)) (br out))
  (block sleep
    (atomicrmw sub seq_cst @fib.sched-active (i64 1))
    (call @fib.sched-sleep epoch)
    (atomicrmw add seq_cst @fib.sched-active (i64 1))
    (br out))
  (block out (ret)))

;; A worker thread: its record is its argument; runs what it finds, idles when there is nothing.
(define internal (fib.sched-worker ptr) ((ptr w))
  (block entry
    (call @pthread_setspecific (load i32 @fib.sched-key) w)
    (call @fib.guard-enter (load i64 @fib.thread-stack))
    (br loop))
  (block loop
    (let ((t (call @fib.sched-find w)))
      (br (icmp eq t (ptr null)) idle run)))
  (block run (call @fib.sched-run t) (br loop))
  (block idle (call @fib.sched-idle w) (br loop)))
")

;; park.lir
(def RT-PARK: str
";; fib.rt, parking and joining for the work-stealing pool (docs/design/parallelism.md 3.1; the pool itself is sched.lir, the deques deque.lir): the eventcount
;; (epoch word, sleepers count, one mutex and condition variable: the re-check after the announcement is what keeps a wake-up from being lost), the
;; short spin before a joiner parks, the waiter nodes of a task, `join` (help-while-waiting), `(blocking ..)`, the drain at exit and the control
;; function the library asks (lib/fib/os/sched.fib). The tuning knobs, the globals and the records are in sched.lir and deque.lir.
;; ---- the eventcount

;; After a push: a sleeper, if there is one, is woken. The fence orders the push before the read of the sleepers against a sleeper's
;; announcement before its re-check (fib.sched-announce), so one of the two sees the other.
(define internal (fib.sched-signal void) ()
  (block entry
    (fence seq_cst)
    (br (icmp eq (atomic-load monotonic i32 @fib.sched-hint) (i32 0)) hint start))
  (block hint (atomic-store release (i32 1) @fib.sched-hint) (br start))
  (block start
    (br (and (icmp ne (load i32 @fib.sched-skip) (i32 0)) (icmp sgt (atomic-load monotonic i32 @fib.sched-idlers) (i32 0))) done sleepers?))
  (block sleepers?
    (br (icmp sgt (atomic-load monotonic i32 @fib.sched-sleepers) (i32 0)) wake done))
  (block wake
    (call @pthread_mutex_lock (load ptr @fib.sched-mutex))
    (atomic-store release (add (atomic-load monotonic i32 @fib.sched-ec) (i32 1)) @fib.sched-ec)
    (call @pthread_mutex_unlock (load ptr @fib.sched-mutex))
    (call @pthread_cond_signal (load ptr @fib.sched-cond))
    (br done))
  (block done (ret)))

;; A completion with a parked joiner: every sleeper is woken (a joiner waits for its own task's state, not for work).
(define internal (fib.sched-wake-all void) ()
  (block entry
    (call @pthread_mutex_lock (load ptr @fib.sched-mutex))
    (atomic-store release (add (atomic-load monotonic i32 @fib.sched-ec) (i32 1)) @fib.sched-ec)
    (call @pthread_mutex_unlock (load ptr @fib.sched-mutex))
    (call @pthread_cond_broadcast (load ptr @fib.sched-cond))
    (call @pthread_cond_broadcast (load ptr @fib.sched-jcond))
    (ret)))

;; A thread that is not a worker sleeps until the epoch moves, on the joiners' condition.
(define internal (fib.sched-sleep-joiner void) ((i32 epoch))
  (block entry
    (call @pthread_mutex_lock (load ptr @fib.sched-mutex))
    (br test))
  (block test
    (br (icmp eq (atomic-load acquire i32 @fib.sched-ec) epoch) wait out))
  (block wait
    (call @pthread_cond_wait (load ptr @fib.sched-jcond) (load ptr @fib.sched-mutex))
    (br test))
  (block out (call @pthread_mutex_unlock (load ptr @fib.sched-mutex)) (ret)))

;; The epoch to sleep against, read before the announcement; then \"I am about to sleep\".
(define internal (fib.sched-announce i32) ()
  (block entry
    (let ((epoch (atomic-load acquire i32 @fib.sched-ec)))
      (atomicrmw add seq_cst @fib.sched-sleepers (i32 1))
      (fence seq_cst)
      (ret epoch))))

;; Sleeps until the epoch moves (the caller has announced and re-checked), then withdraws the announcement.
(define internal (fib.sched-sleep void) ((i32 epoch))
  (block entry
    (call @pthread_mutex_lock (load ptr @fib.sched-mutex))
    (br test))
  (block test
    (br (icmp eq (atomic-load acquire i32 @fib.sched-ec) epoch) wait out))
  (block wait
    (call @pthread_cond_wait (load ptr @fib.sched-cond) (load ptr @fib.sched-mutex))
    (br test))
  (block out
    (call @pthread_mutex_unlock (load ptr @fib.sched-mutex))
    (atomicrmw sub seq_cst @fib.sched-sleepers (i32 1))
    (ret)))

;; ---- joining

;; Runs `task` on this thread if its driver can be claimed and it has not started (a joiner's inline run); 1 when it ran.
(define internal (fib.sched-claim-run i1) ((ptr task))
  (block entry
    (let ((dp (getelementptr %struct.fib.task task (i32 0) (i32 4)))
          (sp (getelementptr %struct.fib.task task (i32 0) (i32 3)))
          (r (cmpxchg acq_rel acquire dp (i32 0) (i32 1))))
      (br (extractvalue r 1) claimed no)))
  (block claimed
    (br (icmp eq (atomic-load acquire i32 sp) (i32 0)) resume unclaim))
  (block resume
    (atomic-store release (i32 1) sp)
    (indirect-call (load ptr (getelementptr %struct.fib.task task (i32 0) (i32 6))) (fn void (ptr)) task)
    (atomic-store release (i32 0) dp)
    (ret (i1 1)))
  (block unclaim (atomic-store release (i32 0) dp) (br no))
  (block no (ret (i1 0))))

;; Takes the waiter `node` out of the task's list, under its lock; 0 when it is not there (the completion took the list and wakes).
(define internal (fib.sched-unregister i1) ((ptr task) (ptr node))
  (block entry
    (let ((lockp (getelementptr %struct.fib.task task (i32 0) (i32 5)))
          (wp (getelementptr %struct.fib.task task (i32 0) (i32 8))))
      (call @fib.lock lockp)
      (br find)))
  (block find
    (let ((linkp (phi ptr (entry wp) (next nextp)))
          (cur (load ptr linkp)))
      (br (icmp eq cur (ptr null)) gone test)))
  (block test (br (icmp eq cur node) unlink next))
  (block next (let ((nextp (getelementptr i8 cur (i64 8)))) (br find)))
  (block unlink
    (atomic-store release (load ptr (getelementptr i8 node (i64 8))) linkp)
    (call @fib.unlock lockp)
    (call @free node)
    (ret (i1 1)))
  (block gone (call @fib.unlock lockp) (ret (i1 0))))

;; Parks this thread until `task` is done or the epoch moves (a completion with a parked joiner; for a worker a fork too): a waiter
;; node whose word is 1 on the task, under its lock, after the epoch is read; then the check of the state (a seq_cst fence between,
;; against the completion's: fib.sched-wake-waiters), the re-check of work for a worker, and the sleep. A worker is a sleeper of the
;; eventcount while it waits (a fork wakes it to help); another thread is not.
(define internal (fib.sched-wait void) ((ptr task) (i1 worker))
  (block entry (br worker announce plain))
  (block announce (let ((e1 (call @fib.sched-announce))) (br go)))
  (block plain (let ((e2 (atomic-load acquire i32 @fib.sched-ec))) (br go)))
  (block go
    (let ((epoch (phi i32 (announce e1) (plain e2)))
          (lockp (getelementptr %struct.fib.task task (i32 0) (i32 5)))
          (sp (getelementptr %struct.fib.task task (i32 0) (i32 3)))
          (node (call @malloc (i64 16)))
          (wp (getelementptr %struct.fib.task task (i32 0) (i32 8))))
      (store (inttoptr ptr (i64 1)) node)
      (call @fib.lock lockp)
      (store (load ptr wp) (getelementptr i8 node (i64 8)))
      (atomic-store release node wp)
      (call @fib.unlock lockp)
      (fence seq_cst)
      (br (icmp eq (atomic-load acquire i32 sp) (i32 2)) done registered)))
  (block done (br (call @fib.sched-unregister task node) withdraw registered))
  (block registered (br worker recheck joiner))
  (block recheck (br (call @fib.sched-any-work) abandon sleep))
  (block abandon (call @fib.sched-unregister task node) (br withdraw))
  (block sleep (call @fib.sched-sleep epoch) (call @fib.sched-unregister task node) (ret))
  (block joiner (call @fib.sched-sleep-joiner epoch) (call @fib.sched-unregister task node) (ret))
  (block withdraw
    (br worker withdraw2 out))
  (block withdraw2 (atomicrmw sub seq_cst @fib.sched-sleepers (i32 1)) (br out))
  (block out (ret)))

;; A joiner about to park looks at the task's state a few thousand times first: a task a thief took a moment ago is mostly done within
;; a microsecond, and a park (a futex wait and the completion's wake-up) costs more than that. 1 when the task is done.
(define internal (fib.sched-spin-done i1) ((ptr task))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (next i2))))
      (br (icmp slt i (i64 3000)) look no)))
  (block look
    (br (icmp eq (atomic-load acquire i32 (getelementptr %struct.fib.task task (i32 0) (i32 3))) (i32 2)) yes next))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block yes (ret (i1 1)))
  (block no (ret (i1 0))))

;; `join` of a pool task (from fib.drive). A worker runs the task itself when it can claim it, else helps with any work there is,
;; and parks when there is none or it is too deep in helps. Another thread runs the task itself when it can claim it and the program
;; catches (the runner isolates a trap then), else parks: a trap in a task run on a thread without a worker's chain could not be
;; isolated. With no workers at all the task runs inline.
(define internal (fib.sched-join void) ((ptr task))
  (block entry
    (let ((sp (getelementptr %struct.fib.task task (i32 0) (i32 3))))
      (br loop)))
  (block loop
    (br (icmp eq (atomic-load acquire i32 sp) (i32 2)) done who))
  (block who
    (let ((w (call @fib.sched-self)))
      (br (icmp eq w (ptr null)) other worker)))
  (block other
    (br (icmp eq (load i64 @fib.sched-n) (i64 0)) inline catching?))
  (block inline (call @fib.sched-claim-run task) (br loop))
  (block catching?
    (br (icmp ne (atomic-load monotonic i32 @fib.sched-catching) (i32 0)) try park))
  (block try (br (call @fib.sched-claim-run task) loop park))
  (block park (br (call @fib.sched-spin-done task) loop park2))
  (block park2 (call @fib.sched-wait task (i1 0)) (br loop))
  (block worker
    (br (call @fib.sched-claim-run task) loop help))
  (block help
    (br (icmp sge (load i64 (getelementptr i8 w (i64 200))) (load i64 @fib.sched-max-depth)) deep find))
  (block find
    (let ((t (call @fib.sched-find w)))
      (br (icmp eq t (ptr null)) deep? run)))
  (block deep? (br (call @fib.sched-spin-done task) loop idle))
  (block idle (call @fib.sched-wait task (i1 1)) (br loop))
  (block run (call @fib.sched-run t) (br loop))
  (block deep (call @fib.sched-wait task (i1 0)) (br loop))
  (block done (ret)))

;; ---- blocking sections and the exit

;; `(blocking ..)` on a worker: one more worker for the duration (up to W more; a spare that was started stays, parked, after).
(define internal (fib.sched-block-enter void) ()
  (block entry
    (br (icmp eq (call @fib.sched-self) (ptr null)) done count))
  (block count
    (let ((b (add (atomicrmw add acq_rel @fib.sched-blocked (i64 1)) (i64 1)))
          (n (load i64 @fib.sched-n)))
      (call @fib.lock @fib.sched-inj-lock)
      (let ((live (atomic-load acquire i64 @fib.sched-live)))
        (br (and (icmp sgt (add n b) live) (icmp slt live (mul n (i64 2)))) more enough))))
  (block more
    (atomic-store release (add live (i64 1)) @fib.sched-live)
    (atomicrmw add seq_cst @fib.sched-active (i64 1))
    (call @fib.sched-start-thread (call @fib.sched-rec live))
    (br enough))
  (block enough (call @fib.unlock @fib.sched-inj-lock) (br done))
  (block done (ret)))

(define internal (fib.sched-block-leave void) ()
  (block entry
    (br (icmp eq (call @fib.sched-self) (ptr null)) done count))
  (block count (atomicrmw sub acq_rel @fib.sched-blocked (i64 1)) (br done))
  (block done (ret)))

;; At the exit (fib.pool-quiesce): waits until every worker is parked with nothing left anywhere; a program that never forked
;; returns at once.
(define internal (fib.sched-quiesce void) ()
  (block entry
    (br (icmp eq (atomic-load acquire i32 @fib.sched-state) (i32 2)) test done))
  (block test
    (br (icmp eq (atomic-load acquire i64 @fib.sched-active) (i64 0)) check sleep))
  (block check
    (br (call @fib.sched-any-work) sleep done))
  (block sleep
    (let ((ts (alloca (align 8) i64 (i32 2))))
      (store (i64 0) ts)
      (store (i64 200000) (getelementptr i64 ts (i32 1)))
      (call @nanosleep ts (ptr null))
      (br test)))
  (block done (ret)))

;; The sum over the live records of the counter at `off`.
(define internal (fib.sched-sum i64) ((i64 off))
  (block entry (let ((n (atomic-load acquire i64 @fib.sched-live))) (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (next i2)))
          (acc (phi i64 (entry (i64 0)) (next acc2))))
      (br (icmp slt i n) one done)))
  (block one
    (let ((acc2 (add acc (load i64 (getelementptr i8 (call @fib.sched-rec i) off))))
          (i2 (add i (i64 1))))
      (br next)))
  (block next (br loop))
  (block done (ret acc)))

;; What the library asks the pool (lib/fib/os/sched.fib): 0 the worker count; 1 blocking enter; 2 blocking leave; 3 whether this
;; thread is a worker; 4 tasks run by workers; 5 steals; 6 live workers; 7 forks run inline for a full ring; 8 whether the pool started; 9 the cap on idle workers that spin (fib.sched-spinners).
;; extern: (declare fib_sched_ctl i64 (i64 i64))
(define internal (fib_sched_ctl i64) ((i64 op) (i64 a))
  (block entry
    (switch op other ((i64 0) count) ((i64 1) enter) ((i64 2) leave) ((i64 3) self) ((i64 4) run) ((i64 5) steals)
      ((i64 6) live) ((i64 7) inline) ((i64 8) started) ((i64 9) spinners)))
  (block count (ret (call @fib.sched-count)))
  (block enter (call @fib.sched-block-enter) (ret (i64 0)))
  (block leave (call @fib.sched-block-leave) (ret (i64 0)))
  (block self (ret (select (icmp ne (call @fib.sched-self) (ptr null)) (i64 1) (i64 0))))
  (block run (ret (call @fib.sched-sum (i64 160))))
  (block steals (ret (call @fib.sched-sum (i64 168))))
  (block live (ret (atomic-load acquire i64 @fib.sched-live)))
  (block inline (ret (call @fib.sched-sum (i64 184))))
  (block started (ret (select (icmp eq (atomic-load acquire i32 @fib.sched-state) (i32 2)) (i64 1) (i64 0))))
  (block spinners (ret (zext i64 (load i32 @fib.sched-spinners))))
  (block other (ret (i64 -1))))
")

;; weak.lir
(def RT-WEAK: str
";; fib.rt, weak references (types §8.7). A weak box is the header, a
;; lock, the target, and the link of the global table, which is a
;; list of the registered boxes threaded through that link under one
;; spinlock (the table's data structure is the runtime's; §8.7 fixes
;; only its behaviour: one box per object, found through HAS-WEAK).
(global internal fib.weak-lock i32 (i32 0))
(global internal fib.weak-list ptr (ptr null))

(define internal (fib.weak-find ptr) ((ptr target))
  (block entry (let ((first (load ptr @fib.weak-list))) (br scan)))
  (block scan
    (let ((b (phi ptr (entry first) (next b2))))
      (br (icmp eq b (ptr null)) none test)))
  (block test
    (br (icmp eq (load ptr (getelementptr %struct.fib.weakbox b (i32 0) (i32 4))) target) found next))
  (block next
    (let ((b2 (load ptr (getelementptr %struct.fib.weakbox b (i32 0) (i32 5)))))
      (br scan)))
  (block found (ret b))
  (block none (ret (ptr null))))

;; A fresh box (count 1) for target.
(define internal (fib.weak-box ptr) ((ptr target) (i32 tid))
  (block entry
    (let ((b (call @fib.alloc (i64 40) tid)))
      (store (i32 0) (getelementptr %struct.fib.weakbox b (i32 0) (i32 3)))
      (store target (getelementptr %struct.fib.weakbox b (i32 0) (i32 4)))
      (store (ptr null) (getelementptr %struct.fib.weakbox b (i32 0) (i32 5)))
      (ret b))))

;; (weak x): the object's one box, retained, made and registered on
;; the first weak of it; an IMMORTAL target gets a fresh box that is
;; never registered and never cleared.
(define internal (fib.weak ptr) ((ptr x) (i32 tid))
  (block entry
    (let ((f (call @fib.flags x)))
      (br (icmp ne (and f (i32 8)) (i32 0)) immortal mutable)))
  (block immortal (ret (call @fib.weak-box x tid)))
  (block mutable
    (call @fib.lock @fib.weak-lock)
    (br (icmp ne (and f (i32 2)) (i32 0)) flagged fresh))
  (block flagged
    (let ((b (call @fib.weak-find x)))
      (br (icmp eq b (ptr null)) fresh reuse)))
  (block reuse
    (call @fib.retain b)
    (call @fib.unlock @fib.weak-lock)
    (ret b))
  (block fresh
    (let ((nb (call @fib.weak-box x tid)))
      (store (load ptr @fib.weak-list) (getelementptr %struct.fib.weakbox nb (i32 0) (i32 5)))
      (store nb @fib.weak-list)
      (atomicrmw or monotonic (getelementptr %struct.fib.hdr x (i32 0) (i32 2)) (i32 2))
      (call @fib.unlock @fib.weak-lock)
      (ret nb))))

;; @w: the target retained if alive (a cmpxchg loop refusing zero),
;; or null. The count is read atomically (monotonic): a SHARED target's count is
;; changed by other threads' atomic read-modify-writes at the same time, and a plain
;; read of it is a data race (found by scripts/tsan.sh, case 110); the cmpxchg
;; that follows decides, so no stronger order is needed for the read.
(define internal (fib.upgrade ptr) ((ptr b))
  (block entry
    (let ((lockp (getelementptr %struct.fib.weakbox b (i32 0) (i32 3))))
      (call @fib.lock lockp)
      (let ((t (load ptr (getelementptr %struct.fib.weakbox b (i32 0) (i32 4)))))
        (br (icmp eq t (ptr null)) dead alive))))
  (block dead (call @fib.unlock lockp) (ret (ptr null)))
  (block alive
    (let ((f (call @fib.flags t)))
      (br (icmp ne (and f (i32 12)) (i32 0)) uncounted counted)))
  (block uncounted (call @fib.unlock lockp) (ret t))
  (block counted
    (let ((cp (getelementptr %struct.fib.hdr t (i32 0) (i32 0))))
      (br retry)))
  (block retry
    (let ((c (atomic-load monotonic i64 cp)))
      (br (icmp eq c (i64 0)) gone bump)))
  (block gone (call @fib.unlock lockp) (ret (ptr null)))
  (block bump
    (let ((r (cmpxchg acq_rel monotonic cp c (add c (i64 1)))))
      (br (extractvalue r 1) got retry)))
  (block got (call @fib.unlock lockp) (ret t)))

;; From fib.drop, before the children are released: the box's target
;; is cleared and the box leaves the table.
(define internal (fib.weak-clear void) ((ptr obj))
  (block entry
    (call @fib.lock @fib.weak-lock)
    (let ((b (call @fib.weak-find obj)))
      (br (icmp eq b (ptr null)) done clear)))
  (block clear
    (let ((lockp (getelementptr %struct.fib.weakbox b (i32 0) (i32 3))))
      (call @fib.lock lockp)
      (store (ptr null) (getelementptr %struct.fib.weakbox b (i32 0) (i32 4)))
      (call @fib.unlock lockp)
      (call @fib.weak-unlink-locked b)
      (br done)))
  (block done (call @fib.unlock @fib.weak-lock) (ret)))

;; Removes b from the list; the table lock is held.
(define internal (fib.weak-unlink-locked void) ((ptr b))
  (block entry (br scan))
  (block scan
    (let ((slot (phi ptr (entry @fib.weak-list) (next slot2)))
          (cur (load ptr slot)))
      (br (icmp eq cur (ptr null)) done test)))
  (block test (br (icmp eq cur b) unlink next))
  (block unlink
    (store (load ptr (getelementptr %struct.fib.weakbox b (i32 0) (i32 5))) slot)
    (br done))
  (block next
    (let ((slot2 (getelementptr %struct.fib.weakbox cur (i32 0) (i32 5))))
      (br scan)))
  (block done (ret)))

;; The drop of a weak box (its count reached zero): it leaves the
;; table if it is still in it; the target is not counted.
(define internal (fib.weak-drop void) ((ptr b))
  (block entry
    (call @fib.lock @fib.weak-lock)
    (call @fib.weak-unlink-locked b)
    (call @fib.unlock @fib.weak-lock)
    (ret)))
")

;; io.lir
(def RT-IO: str
";; fib.rt, the program's surroundings (syntax §4.3, M5): the command
;; line main received, and whole files as strings through the C
;; library's stdio; the interpreter's eval/io.rs gives the same results.
(declare fopen ptr (ptr ptr))
(declare fclose i32 (ptr))
(declare fread i64 (ptr i64 i64 ptr))
(declare fwrite i64 (ptr i64 i64 ptr))
(declare ferror i32 (ptr))
(declare realloc ptr (ptr i64))
(global internal fib.argc i32 (i32 0))
(global internal fib.argv ptr (ptr null))

;; From main: the command line, whose arguments after the program are
;; (args).
(define internal (fib.set-args void) ((i32 argc) (ptr argv))
  (block entry
    (store argc @fib.argc)
    (store argv @fib.argv)
    (ret)))

(define internal (fib.args-count i64) ()
  (block entry
    (let ((n (sext i64 (load i32 @fib.argc))))
      (ret (select (icmp slt n (i64 1)) (i64 0) (sub n (i64 1)))))))

;; Fills buf with a fresh str (count 1) per argument after the program.
;; An argument need not be UTF-8: each invalid sequence in it becomes
;; U+FFFD (syntax §4.3), as the interpreter's command line makes it.
(define internal (fib.args-fill void) ((ptr buf))
  (block entry
    (let ((n (call @fib.args-count)))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (next i2))))
      (br (icmp slt i n) one done)))
  (block one
    (let ((c (load ptr (getelementptr ptr (load ptr @fib.argv) (add i (i64 1)))))
          (s (call @fib.str-from-lossy c (call @strlen c))))
      (store s (getelementptr ptr buf i))
      (br next)))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block done (ret)))

;; Releases the strs the builder copied out of buf (its own counts).
(define internal (fib.args-release void) ((ptr buf) (i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (next i2))))
      (br (icmp slt i n) one done)))
  (block one (call @fib.release (load ptr (getelementptr ptr buf i))) (br next))
  (block next (let ((i2 (add i (i64 1)))) (br loop)))
  (block done (ret)))

;; Whether path names a file at all: fopen reads its name as a C string,
;; so a NUL inside the str would silently name the file before it. The
;; interpreter's std::fs refuses such a name.
(define internal (fib.path-ok i1) ((ptr path))
  (block entry
    (ret (icmp eq (call @strlen (call @fib.str-bytes-ptr path)) (call @fib.str-len path)))))

;; (read-file path): the whole file as a str, or null when the path
;; cannot be opened, cannot be read to its end, or is not UTF-8. A
;; directory opens and then fails its first read (EISDIR), so every
;; file is read until fread falls short, and a short read is the end of
;; the file only when ferror says it was not an error. (A size from
;; fseek and ftell is no help: lseek says LONG_MAX for a directory on
;; ext4 and fails on a /proc file, whose text the interpreter does read.)
(define internal (fib.read-file ptr) ((ptr path))
  (block entry (br (call @fib.path-ok path) open none))
  (block none (ret (ptr null)))
  (block open
    (let ((f (call @fopen (call @fib.str-bytes-ptr path) (string \"rb\"))))
      (br (icmp eq f (ptr null)) none opened)))
  (block opened
    (let ((b0 (call @malloc (i64 4096))))
      (br (icmp eq b0 (ptr null)) nomem loop)))
  (block nomem (call @fclose f) (ret (ptr null)))
  (block loop
    (let ((buf (phi ptr (opened b0) (grown b1)))
          (len (phi i64 (opened (i64 0)) (grown len2)))
          (cap (phi i64 (opened (i64 4096)) (grown cap2)))
          (room (sub cap len))
          (got (call @fread (getelementptr i8 buf len) (i64 1) room f))
          (len2 (add len got)))
      (br (icmp eq got room) grow done)))
  (block grow
    (let ((cap2 (mul cap (i64 2)))
          (b1 (call @realloc buf cap2)))
      (br (icmp eq b1 (ptr null)) nomem2 grown)))
  (block nomem2 (call @free buf) (call @fclose f) (ret (ptr null)))
  (block grown (br loop))
  (block done
    (let ((bad (call @ferror f)))
      (call @fclose f)
      (br (and (icmp eq bad (i32 0)) (call @fib.utf8-valid buf len2)) ok fail)))
  (block ok
    (let ((s (call @fib.str-from-bytes buf len2)))
      (call @free buf)
      (ret s)))
  (block fail (call @free buf) (ret (ptr null))))

;; (write-file path text): whether the whole text was written.
(define internal (fib.write-file i1) ((ptr path) (ptr text))
  (block entry (br (call @fib.path-ok path) open no))
  (block open
    (let ((f (call @fopen (call @fib.str-bytes-ptr path) (string \"wb\"))))
      (br (icmp eq f (ptr null)) no opened)))
  (block no (ret (i1 0)))
  (block opened
    (let ((n (call @fib.str-len text))
          (w (call @fwrite (call @fib.str-bytes-ptr text) (i64 1) n f))
          (c (call @fclose f)))
      (ret (and (icmp eq w n) (icmp eq c (i32 0)))))))
")

;; sys.lir
(def RT-SYS: str
";; fib.rt, the unix primitives (stdlib \"sys primitives\"): descriptors as
;; i64, every failure the negated errno in the result and never a trap.
;; The interpreter's eval/sys.rs gives the same results; the two are
;; compared by cases/stdlib 3600 to 3649.
;; openat(AT_FDCWD, ..) is open(..): a program of ours already declares `open` with another type (compiler/driver/native.fib), and the
;; runtime and an extern of one name must agree.
(declare openat i32 (i32 ptr i32 ...))
(declare close i32 (i32))
(declare read i64 (i32 ptr i64))
(declare lseek i64 (i32 i64 i32))
(declare pipe i32 (ptr))
(declare dup i32 (i32))
(declare isatty i32 (i32))
(declare unlink i32 (ptr))
(declare mkdir i32 (ptr i32))
(declare rmdir i32 (ptr))
(declare strerror ptr (i32))
(declare clock_gettime i32 (i32 ptr))
(declare nanosleep i32 (ptr ptr))
(declare __errno_location ptr ())

;; r when the call succeeded (not negative), else the negated errno.
(define internal (fib.sys-ret i64) ((i64 r))
  (block entry (br (icmp slt r (i64 0)) bad ok))
  (block bad
    (let ((e (load i32 (call @__errno_location))))
      (ret (sub (i64 0) (sext i64 e)))))
  (block ok (ret r)))

;; The same for a call that answers an i32.
(define internal (fib.sys-ret32 i64) ((i32 r))
  (block entry (ret (call @fib.sys-ret (sext i64 r)))))

;; (sys-open path flags mode): a path with a NUL in it is EINVAL (22).
(define internal (fib.sys-open i64) ((ptr path) (i64 flags) (i64 mode))
  (block entry (br (call @fib.path-ok path) go bad))
  (block bad (ret (i64 -22)))
  (block go
    (let ((r (call @openat (i32 -100) (call @fib.str-bytes-ptr path) (trunc i32 flags) (trunc i32 mode))))
      (ret (call @fib.sys-ret32 r)))))

(define internal (fib.sys-close i64) ((i64 fd))
  (block entry (ret (call @fib.sys-ret32 (call @close (trunc i32 fd))))))

;; A fresh array of the 8 bytes of status and then the len at buf.
(define internal (fib.sys-pack ptr) ((i64 status) (ptr buf) (i64 len) (i32 tid))
  (block entry
    (let ((a (call @fib.array-alloc (add len (i64 8)) tid (i64 1)))
          (data (getelementptr %struct.fib.array.i8 a (i32 0) (i32 4) (i64 0))))
      (store status data)
      (br (icmp sgt len (i64 0)) copy done)))
  (block copy
    (call @memcpy (getelementptr i8 data (i64 8)) buf len)
    (br done))
  (block done (ret a)))

;; (sys-read fd n): the status and the bytes read, in one array. n is
;; clamped to 2^30, as the interpreter's is; a negative n is EINVAL.
(define internal (fib.sys-read ptr) ((i64 fd) (i64 n) (i32 tid))
  (block entry
    (let ((m (select (icmp sgt n (i64 1073741824)) (i64 1073741824) n)))
      (br (icmp slt n (i64 0)) bad alloc)))
  (block bad (ret (call @fib.sys-pack (i64 -22) (ptr null) (i64 0) tid)))
  (block alloc
    (let ((buf (call @malloc (add m (i64 1)))))
      (br (icmp eq buf (ptr null)) nomem go)))
  (block nomem (ret (call @fib.sys-pack (i64 -12) (ptr null) (i64 0) tid)))
  (block go
    (let ((st (call @fib.sys-ret (call @read (trunc i32 fd) buf m)))
          (got (select (icmp slt st (i64 0)) (i64 0) st))
          (a (call @fib.sys-pack st buf got tid)))
      (call @free buf)
      (ret a))))

;; (sys-write fd bytes off n): the range off, off+n must lie inside the
;; array, else EINVAL.
(define internal (fib.sys-write i64) ((i64 fd) (ptr arr) (i64 off) (i64 n))
  (block entry
    (let ((len (call @fib.array-len arr))
          (bad (or (or (icmp slt off (i64 0)) (icmp slt n (i64 0)))
                   (or (icmp sgt off len) (icmp sgt n (sub len off))))))
      (br bad no go)))
  (block no (ret (i64 -22)))
  (block go
    (let ((p (getelementptr i8 (getelementptr %struct.fib.array.i8 arr (i32 0) (i32 4) (i64 0)) off)))
      (ret (call @fib.sys-ret (call @write (trunc i32 fd) p n))))))

(define internal (fib.sys-seek i64) ((i64 fd) (i64 off) (i64 whence))
  (block entry (ret (call @fib.sys-ret (call @lseek (trunc i32 fd) off (trunc i32 whence))))))

;; The read end shifted left 32 bits, or'd with the write end.
(define internal (fib.sys-pipe i64) ()
  (block entry
    (let ((fds (alloca (align 8) i8 (i32 8)))
          (r (call @pipe fds)))
      (br (icmp slt r (i32 0)) bad ok)))
  (block bad (ret (call @fib.sys-ret (i64 -1))))
  (block ok
    (let ((rd (sext i64 (load i32 fds)))
          (wr (sext i64 (load i32 (getelementptr i8 fds (i64 4))))))
      (ret (or (shl rd (i64 32)) wr)))))

(define internal (fib.sys-dup i64) ((i64 fd))
  (block entry (ret (call @fib.sys-ret32 (call @dup (trunc i32 fd))))))

(define internal (fib.sys-isatty i1) ((i64 fd))
  (block entry (ret (icmp eq (call @isatty (trunc i32 fd)) (i32 1)))))

(define internal (fib.sys-unlink i64) ((ptr path))
  (block entry (br (call @fib.path-ok path) go bad))
  (block bad (ret (i64 -22)))
  (block go (ret (call @fib.sys-ret32 (call @unlink (call @fib.str-bytes-ptr path))))))

(define internal (fib.sys-mkdir i64) ((ptr path) (i64 mode))
  (block entry (br (call @fib.path-ok path) go bad))
  (block bad (ret (i64 -22)))
  (block go
    (ret (call @fib.sys-ret32 (call @mkdir (call @fib.str-bytes-ptr path) (trunc i32 mode))))))

(define internal (fib.sys-rmdir i64) ((ptr path))
  (block entry (br (call @fib.path-ok path) go bad))
  (block bad (ret (i64 -22)))
  (block go (ret (call @fib.sys-ret32 (call @rmdir (call @fib.str-bytes-ptr path))))))

;; strerror's text, made UTF-8 as the interpreter does.
(define internal (fib.sys-errno-text ptr) ((i64 e))
  (block entry
    (let ((p (call @strerror (trunc i32 e))))
      (ret (call @fib.str-from-lossy p (call @strlen p))))))

;; The variable's value as a str, or null when unset (or the name has a
;; NUL in it).
(define internal (fib.sys-getenv ptr) ((ptr name))
  (block entry (br (call @fib.path-ok name) go none))
  (block none (ret (ptr null)))
  (block go
    (let ((p (call @getenv (call @fib.str-bytes-ptr name))))
      (br (icmp eq p (ptr null)) none some)))
  (block some (ret (call @fib.str-from-lossy p (call @strlen p)))))

(define internal (fib.sys-clock i64) ((i32 id))
  (block entry
    (let ((t (alloca (align 8) i8 (i32 16))))
      (call @clock_gettime id t)
      (ret (add (mul (load i64 t) (i64 1000000000)) (load i64 (getelementptr i8 t (i64 8))))))))

(define internal (fib.sys-clock-now i64) ()
  (block entry (ret (call @fib.sys-clock (i32 1)))))

(define internal (fib.sys-wall-now i64) ()
  (block entry (ret (call @fib.sys-clock (i32 0)))))

;; Sleeps at least ns nanoseconds, resuming after a signal; returns 0. On waking, the large-block cache's decay check (rt/alloc.lir):
;; a program that sleeps between bursts gives back what it no longer uses.
(define internal (fib.sys-sleep i64) ((i64 ns))
  (block entry
    (let ((t (alloca (align 8) i8 (i32 16))))
      (br (icmp sle ns (i64 0)) done go)))
  (block go
    (store (sdiv ns (i64 1000000000)) t)
    (store (srem ns (i64 1000000000)) (getelementptr i8 t (i64 8)))
    (br again))
  (block again
    (let ((r (call @nanosleep t t)))
      (br (icmp eq r (i32 0)) done again)))
  (block done (call @fib.lc-tick) (ret (i64 0))))
")

;; alloc.lir
(def RT-ALLOC: str
";; fib.rt, the large-block cache (docs/design/allocator.md): a freed block of 128 KiB or more is kept in a list of its size class and
;; handed to the next request of that class; a block kept longer than the decay time (FIB_ALLOC_DECAY_MS, default 1000) goes back to
;; `free`, and the cache never holds more than FIB_ALLOC_CACHE_MAX bytes (default 1 GiB). Blocks are plain malloc blocks: a request is
;; rounded up to its class, a freed block is filed down by its usable size, so any runtime may `free` a block made here and any
;; malloc block may be filed here. `fib.lc-get` and `fib.lc-put` serve objects (fib.alloc-slow, fib.free-block) and trace mode's
;; blocks (fib.drop-one); a cached block is runtime memory, in no trace line.
;;
;; Classes: four per power of two, size (k+1) * 2^(e-2) for k in 4..7, index (e-10)*4 + k-4; index 27 is 128 KiB, 147 is 2^47.
;; A cached block's first word is the next block of its class, its second the time it was filed (fib.lc-now, ns); newest first.
;; Every list, the stats and the peak are under @fib.lc-lock (fib.lock, the atoms' spinlock); @fib.lc-bytes and @fib.lc-next
;; are also read without it (fib.lc-tick), so every access of those two is atomic. The time is read only while the cache holds
;; something: at a large or medium allocation or free, and at the end of `sys-sleep`; no thread runs in the background.
(declare malloc_usable_size i64 (ptr))
(declare mallopt i32 (i32 i32))

;; 1 while the cache is on (FIB_ALLOC_DECAY_MS not 0); the decay in ns; the cap in bytes.
(global internal fib.lc-on i32 (i32 1))
(global internal fib.lc-decay i64 (i64 1000000000))
(global internal fib.lc-cap i64 (i64 1073741824))
(global internal fib.lc-lock i32 (i32 0))
(global internal fib.lc-heads [148 x ptr] (zeroinitializer [148 x ptr]))
;; The smallest block the cache keeps (and the smallest request it serves): 128 KiB; emit.os sets 4 KiB for a musl target, whose malloc maps and unmaps
;; a group of every block from 2 KiB up each time (24,339 mmap calls for the strings benchmark, docs/design/allocator.md, section 9). At least 1025.
(global internal fib.lc-floor i64 (i64 131072))
;; The bytes held (by class size), and the time of the next sweep (the oldest block's filing time plus the decay).
(global internal fib.lc-bytes i64 (i64 0))
(global internal fib.lc-next i64 (i64 0))
;; 0 hits, 1 misses, 2 bytes returned, 3 blocks returned, 4 blocks refused by the cap, 5 peak bytes held.
(global internal fib.lc-stats [6 x i64] (zeroinitializer [6 x i64]))

;; The coarse monotonic clock (CLOCK_MONOTONIC_COARSE, 6; Darwin's CLOCK_MONOTONIC_RAW_APPROX through emit.os): no system call.
(define internal (fib.lc-now i64) ()
  (block entry
    (let ((t (alloca (align 8) i8 (i32 16))))
      (call @clock_gettime (i32 6) t)
      (ret (add (mul (load i64 t) (i64 1000000000)) (load i64 (getelementptr i8 t (i64 8))))))))

;; malloc_usable_size (Darwin's malloc_size through emit.os).
(define internal (fib.lc-usable i64) ((ptr p))
  (block entry (ret (call @malloc_usable_size p))))

;; glibc's mmap threshold pinned at 128 KiB (M_MMAP_THRESHOLD, -3), which also stops it sliding: every block the cache holds is then
;; its own mapping, and the free of decay is an munmap. Darwin has no mallopt (emit.os drops the call).
(define internal (fib.lc-os-init void) ()
  (block entry
    (let ((r (call @mallopt (i32 -3) (i32 131072))))
      (ret))))

;; floor(log2 x) for x >= 1.
(define internal (fib.lc-log2 i64) ((i64 x))
  (block entry (br loop))
  (block loop
    (let ((e (phi i64 (entry (i64 0)) (step e1)))
          (v (phi i64 (entry x) (step v1))))
      (br (icmp ugt v (i64 1)) step done)))
  (block step
    (let ((e1 (add e (i64 1)))
          (v1 (lshr v (i64 1))))
      (br loop)))
  (block done (ret e)))

;; The class of a request of n bytes (fib.lc-floor <= n <= 2^47): the smallest class size not below n.
(define internal (fib.lc-class-up i64) ((i64 n))
  (block entry
    (let ((m (sub n (i64 1)))
          (e (call @fib.lc-log2 m))
          (k (lshr m (sub e (i64 2)))))
      (ret (add (mul (sub e (i64 10)) (i64 4)) (sub k (i64 4)))))))

;; The class a block of u usable bytes (u >= fib.lc-floor) is filed in: the largest class size not above u; above 147 it is not cached.
(define internal (fib.lc-class-down i64) ((i64 u))
  (block entry
    (let ((e (call @fib.lc-log2 u))
          (k (lshr u (sub e (i64 2)))))
      (ret (add (mul (sub e (i64 10)) (i64 4)) (sub k (i64 5)))))))

(define internal (fib.lc-class-size i64) ((i64 idx))
  (block entry
    (let ((e (add (udiv idx (i64 4)) (i64 10)))
          (k (add (urem idx (i64 4)) (i64 4))))
      (ret (shl (add k (i64 1)) (sub e (i64 2)))))))

(define internal (fib.lc-stat-add void) ((i64 k) (i64 d))
  (block entry
    (let ((p (getelementptr i64 @fib.lc-stats k)))
      (store (add (load i64 p) d) p)
      (ret))))

;; A block of at least n bytes, from the cache when n is a cached size and its class has one, else from malloc (null when malloc
;; fails: the caller traps).
(define internal (fib.lc-get ptr) ((i64 n))
  (block entry
    (let ((on (atomic-load monotonic i32 @fib.lc-on)))
      (br (and (icmp ne on (i32 0)) (and (icmp uge n (load i64 @fib.lc-floor)) (icmp ule n (i64 140737488355328)))) cached plain)))
  (block plain
    (call @fib.lc-tick)
    (ret (call @malloc n)))
  (block cached
    (let ((idx (call @fib.lc-class-up n))
          (size (call @fib.lc-class-size idx))
          (slot (getelementptr ptr @fib.lc-heads idx)))
      (call @fib.lock @fib.lc-lock)
      (let ((head (load ptr slot)))
        (br (icmp ne head (ptr null)) hit miss))))
  (block hit
    (store (load ptr head) slot)
    (atomic-store monotonic (sub (atomic-load monotonic i64 @fib.lc-bytes) size) @fib.lc-bytes)
    (call @fib.lc-stat-add (i64 0) (i64 1))
    (call @fib.unlock @fib.lc-lock)
    (call @fib.lc-tick)
    (ret head))
  (block miss
    (call @fib.lc-stat-add (i64 1) (i64 1))
    (call @fib.unlock @fib.lc-lock)
    (call @fib.lc-tick)
    (ret (call @malloc size))))

;; Takes back the malloc block p: filed in its class while the cache is on, the block is large enough and the cap allows, else freed.
(define internal (fib.lc-put void) ((ptr p))
  (block entry
    (br (icmp ne (atomic-load monotonic i32 @fib.lc-on) (i32 0)) sized plain))
  (block sized
    (let ((u (call @fib.lc-usable p)))
      (br (icmp uge u (load i64 @fib.lc-floor)) classed plain)))
  (block classed
    (let ((idx (call @fib.lc-class-down u)))
      (br (icmp ule idx (i64 147)) file plain)))
  (block file
    (let ((size (call @fib.lc-class-size idx))
          (now (call @fib.lc-now))
          (slot (getelementptr ptr @fib.lc-heads idx)))
      (call @fib.lock @fib.lc-lock)
      (let ((b (atomic-load monotonic i64 @fib.lc-bytes))
            (nb (add b size)))
        (br (icmp ugt nb (atomic-load monotonic i64 @fib.lc-cap)) refuse keep))))
  (block keep
    (store (load ptr slot) p)
    (store now (getelementptr i8 p (i64 8)))
    (store p slot)
    (atomic-store monotonic nb @fib.lc-bytes)
    (let ((pk (getelementptr i64 @fib.lc-stats (i64 5))))
      (store (select (icmp ugt nb (load i64 pk)) nb (load i64 pk)) pk)
      (br (icmp eq b (i64 0)) first kept)))
  (block first
    (atomic-store monotonic (add now (atomic-load monotonic i64 @fib.lc-decay)) @fib.lc-next)
    (br kept))
  (block kept
    (call @fib.unlock @fib.lc-lock)
    (call @fib.lc-tick)
    (ret))
  (block refuse
    (call @fib.lc-stat-add (i64 4) (i64 1))
    (call @fib.unlock @fib.lc-lock)
    (call @free p)
    (call @fib.lc-tick)
    (ret))
  (block plain
    (call @free p)
    (call @fib.lc-tick)
    (ret)))

;; Every 256th small free while the program has one thread (fib.free-block's push, the only path that runs then): the decay check,
;; so that a single-threaded server whose requests allocate only from the free lists still gives a spike's blocks back. A plain
;; counter: the push path never runs once a second thread exists (fib.mt), and a thread's start orders it before that thread.
(global internal fib.lc-count i32 (i32 256))
(define internal (fib.lc-every void) ()
  (block entry
    (let ((c (sub (load i32 @fib.lc-count) (i32 1))))
      (br (icmp eq c (i32 0)) check keep)))
  (block keep (store c @fib.lc-count) (ret))
  (block check
    (store (i32 256) @fib.lc-count)
    (call @fib.lc-tick)
    (ret)))

;; The decay check: while the cache holds something and the next deadline has passed, one sweep.
(define internal (fib.lc-tick void) ()
  (block entry
    (br (icmp eq (atomic-load monotonic i64 @fib.lc-bytes) (i64 0)) done check))
  (block check
    (let ((now (call @fib.lc-now)))
      (br (icmp sge now (atomic-load monotonic i64 @fib.lc-next)) sweep done)))
  (block sweep
    (call @fib.lc-sweep (sub now (atomic-load monotonic i64 @fib.lc-decay)))
    (br done))
  (block done (ret)))

;; Under the lock: takes out of the list at `slot` every block filed at or before `cutoff` (a tail, the list being newest first)
;; and returns its first block, or null.
(define internal (fib.lc-cut ptr) ((ptr slot) (i64 cutoff))
  (block entry (br walk))
  (block walk
    (let ((link (phi ptr (entry slot) (keep cur)))
          (cur (load ptr link)))
      (br (icmp eq cur (ptr null)) none test)))
  (block test
    (br (icmp sle (load i64 (getelementptr i8 cur (i64 8))) cutoff) cut keep))
  (block keep (br walk))
  (block cut
    (store (ptr null) link)
    (ret cur))
  (block none (ret (ptr null))))

;; Under the lock: counts the blocks of `chain` (class idx) as returned, and links the chain in front of `out`; the new head.
(define internal (fib.lc-splice ptr) ((ptr chain) (ptr out) (i64 idx))
  (block entry
    (let ((size (call @fib.lc-class-size idx)))
      (br (icmp eq chain (ptr null)) none walk)))
  (block walk
    (let ((n (phi ptr (entry chain) (step nx)))
          (nx (load ptr n)))
      (call @fib.lc-stat-add (i64 2) size)
      (call @fib.lc-stat-add (i64 3) (i64 1))
      (atomic-store monotonic (sub (atomic-load monotonic i64 @fib.lc-bytes) size) @fib.lc-bytes)
      (br (icmp eq nx (ptr null)) tail step)))
  (block step (br walk))
  (block tail
    (store out n)
    (ret chain))
  (block none (ret out)))

;; Under the lock: the filing time of the oldest block at `slot`, or the largest i64 when there is none.
(define internal (fib.lc-oldest i64) ((ptr slot))
  (block entry
    (let ((first (load ptr slot)))
      (br (icmp eq first (ptr null)) none walk)))
  (block walk
    (let ((n (phi ptr (entry first) (step nx)))
          (nx (load ptr n)))
      (br (icmp eq nx (ptr null)) last step)))
  (block step (br walk))
  (block last (ret (load i64 (getelementptr i8 n (i64 8)))))
  (block none (ret (i64 9223372036854775807))))

(define internal (fib.lc-free-chain void) ((ptr chain))
  (block entry (br test))
  (block test
    (let ((n (phi ptr (entry chain) (go nx))))
      (br (icmp eq n (ptr null)) done go)))
  (block go
    (let ((nx (load ptr n)))
      (call @free n)
      (br test)))
  (block done (ret)))

;; Gives back every block filed at or before `cutoff` (the decay: now minus the decay time; trim: the largest i64) and sets the next
;; deadline from the oldest block kept; the frees run after the lock is released. The bytes given back.
(define internal (fib.lc-sweep i64) ((i64 cutoff))
  (block entry
    (call @fib.lock @fib.lc-lock)
    (let ((before (load i64 (getelementptr i64 @fib.lc-stats (i64 2)))))
      (br loop)))
  (block loop
    (let ((idx (phi i64 (entry (i64 0)) (loop idx1)))
          (out (phi ptr (entry (ptr null)) (loop out1)))
          (oldest (phi i64 (entry (i64 9223372036854775807)) (loop old1)))
          (slot (getelementptr ptr @fib.lc-heads idx))
          (out1 (call @fib.lc-splice (call @fib.lc-cut slot cutoff) out idx))
          (t (call @fib.lc-oldest slot))
          (old1 (select (icmp slt t oldest) t oldest))
          (idx1 (add idx (i64 1))))
      (br (icmp ult idx1 (i64 148)) loop done)))
  (block done
    (let ((left (atomic-load monotonic i64 @fib.lc-bytes))
          (gone (sub (load i64 (getelementptr i64 @fib.lc-stats (i64 2))) before)))
      (atomic-store monotonic (select (icmp eq left (i64 0)) (i64 0) (add old1 (atomic-load monotonic i64 @fib.lc-decay))) @fib.lc-next)
      (call @fib.unlock @fib.lc-lock)
      (call @fib.lc-free-chain out1)
      (ret gone))))

;; The decimal value of the environment variable `name`, or `dflt` when it is unset, empty, not all digits or too large.
(define internal (fib.lc-env-int i64) ((ptr name) (i64 dflt))
  (block entry
    (let ((s (call @getenv name)))
      (br (icmp eq s (ptr null)) no loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (digit inext)))
          (v (phi i64 (entry (i64 0)) (digit v1)))
          (c (zext i64 (load i8 (getelementptr i8 s i)))))
      (br (icmp eq c (i64 0)) end check)))
  (block check
    (br (and (icmp uge c (i64 48)) (and (icmp ule c (i64 57)) (icmp slt v (i64 92233720368547757)))) digit no))
  (block digit
    (let ((inext (add i (i64 1)))
          (v1 (add (mul v (i64 10)) (sub c (i64 48)))))
      (br loop)))
  (block end (br (icmp eq i (i64 0)) no yes))
  (block yes (ret v))
  (block no (ret dflt)))

;; Sets the decay (ms) and the cap (bytes). A decay of 0 or less turns the cache off and empties it.
(define internal (fib.lc-configure void) ((i64 ms) (i64 cap))
  (block entry
    (atomic-store monotonic (select (icmp slt cap (i64 0)) (i64 0) cap) @fib.lc-cap)
    (br (icmp sgt ms (i64 0)) on off))
  (block on
    (atomic-store monotonic (mul ms (i64 1000000)) @fib.lc-decay)
    (call @fib.lc-os-init)
    (atomic-store monotonic (i32 1) @fib.lc-on)
    (ret))
  (block off
    (atomic-store monotonic (i32 0) @fib.lc-on)
    (call @fib.lc-sweep (i64 9223372036854775807))
    (ret)))

;; From fib.init, and `configure-from-env!`: the two variables, as at start-up.
(define internal (fib.lc-init void) ()
  (block entry
    (call @fib.lc-configure (call @fib.lc-env-int (string \"FIB_ALLOC_DECAY_MS\") (i64 1000))
          (call @fib.lc-env-int (string \"FIB_ALLOC_CACHE_MAX\") (i64 1073741824)))
    (ret)))

(define internal (fib.lc-stat i64) ((i64 k))
  (block entry
    (call @fib.lock @fib.lc-lock)
    (let ((v (load i64 (getelementptr i64 @fib.lc-stats k))))
      (call @fib.unlock @fib.lc-lock)
      (ret v))))

;; extern: (declare fib_alloc_ctl i64 (i64 i64 i64))
;; The library's door (fib.os.memory; emit.rt binds an `extern` of this name to this definition): op 0 trim (the bytes given back),
;; 1 bytes held, 2 hits, 3 misses, 4 bytes returned, 5 blocks returned, 6 blocks refused by the cap, 7 peak bytes held, 8 the decay
;; in ms (0: off), 9 the cap, 10 configure decay a ms and cap b bytes, 11 read the environment again, 12 the smallest block the cache keeps (bytes); -1 for any other op.
(define internal (fib_alloc_ctl i64) ((i64 op) (i64 a) (i64 b))
  (block entry
    (switch op other ((i64 0) trim) ((i64 1) held) ((i64 2) stat) ((i64 3) stat) ((i64 4) stat) ((i64 5) stat) ((i64 6) stat)
            ((i64 7) stat) ((i64 8) decay) ((i64 9) cap) ((i64 10) conf) ((i64 11) env) ((i64 12) floor)))
  (block trim (ret (call @fib.lc-sweep (i64 9223372036854775807))))
  (block held (ret (atomic-load monotonic i64 @fib.lc-bytes)))
  (block stat (ret (call @fib.lc-stat (sub op (i64 2)))))
  (block decay
    (br (icmp eq (atomic-load monotonic i32 @fib.lc-on) (i32 0)) zero ms))
  (block zero (ret (i64 0)))
  (block ms (ret (sdiv (atomic-load monotonic i64 @fib.lc-decay) (i64 1000000))))
  (block cap (ret (atomic-load monotonic i64 @fib.lc-cap)))
  (block conf (call @fib.lc-configure a b) (ret (i64 0)))
  (block env (call @fib.lc-init) (ret (i64 0)))
  (block floor (ret (load i64 @fib.lc-floor)))
  (block other (ret (i64 -1))))

;; At the end of `main` (fib.pool-quiesce) when FIB_ALLOC_STATS is set: one line of the cache's counts on standard error.
(define internal (fib.lc-report void) ()
  (block entry
    (br (icmp eq (call @getenv (string \"FIB_ALLOC_STATS\")) (ptr null)) done say))
  (block say
    (let ((buf (alloca i8 (i32 400)))
          (len (call @snprintf buf (i64 400)
                     (string \"fib.alloc: held %lld B (peak %lld), hits %lld, misses %lld, returned %lld B in %lld blocks, refused %lld; decay %lld ms, cap %lld B\\n\")
                     (call @fib_alloc_ctl (i64 1) (i64 0) (i64 0)) (call @fib_alloc_ctl (i64 7) (i64 0) (i64 0))
                     (call @fib_alloc_ctl (i64 2) (i64 0) (i64 0)) (call @fib_alloc_ctl (i64 3) (i64 0) (i64 0))
                     (call @fib_alloc_ctl (i64 4) (i64 0) (i64 0)) (call @fib_alloc_ctl (i64 5) (i64 0) (i64 0))
                     (call @fib_alloc_ctl (i64 6) (i64 0) (i64 0)) (call @fib_alloc_ctl (i64 8) (i64 0) (i64 0))
                     (call @fib_alloc_ctl (i64 9) (i64 0) (i64 0)))))
      (call @write (i32 2) buf (sext i64 len))
      (br done)))
  (block done (ret)))
")

