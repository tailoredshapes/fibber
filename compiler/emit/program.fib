;; compiler/emit/program.fib: the state of the emission: the typed program and the ownership tables it reads, the object table, the static
;; data, the queue of work and the text made so far (spec/compiler.md §2). Replaces crates/fibc/src/program.rs.
;; `Program` is a struct of Cells passed borrowed (plan D1); the Rust `c: &Checked` is its two parts, `typed`
;; and `owned` (own.driver's `Checked` is not needed here). The `closures` VecDeque is a Vec with a head index;
;; `helpers` (a HashSet) is a `(Map str bool)`; Rust's `(String, Option<LirTy>)` of a def is a `DefValue`.
;; STATUS: every public function below is a STUB of package E3, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/program.rs, 347 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.program
  (:use types.ty types.ast types.decls types.program own.program emit.value emit.mono emit.objects emit.statics))

;; The work the queue hands out: a body, or a closure of an owner. Rust: program.rs:24 Work
(defenum Work (WorkBody inst: Inst) (WorkClosure owner: Inst lit: i64 name: str))

;; The address and lIR type of a def's value. Rust: program.rs:48 `(String, Option<LirTy>)`
(defstruct DefValue (text: str ty: (Option LirTy)))

;; Rust: program.rs:37 Program (13 fields; `c` is two)
(defstruct Program
  (typed: TypedProgram owned: OwnedProgram objects: Objects statics: Statics queue: Queue
   closures: (Cell (Vec Work)) closures-head: (Cell i64) funcs: (Cell (Vec str)) externs: (Cell (Vec str))
   helpers: (Cell (Map str bool)) def-values: (Cell (Map i64 DefValue)) quotes: (Cell (Map i64 str))
   quote-text: (Cell str) quote-counter: (Cell i64) keyword-helpers: (Cell bool)))

;; Rust: program.rs:60 Program::new
(defun program-new (typed: TypedProgram owned: OwnedProgram) -> Program
  (trap "todo: E3 program-new"))

;; Rust: program.rs:93 Program::g
(defun program-g (p: Program) -> Globals
  (trap "todo: E3 program-g"))

;; Rust: program.rs:98 Program::ty_of
(defun program-ty-of (p: Program inst: Inst e: i64) -> (Result Ty str)
  (trap "todo: E3 program-ty-of"))

;; Rust: program.rs:108 Program::lir
(defun program-lir (p: Program t: Ty) -> (Result (Option LirTy) str)
  (trap "todo: E3 program-lir"))

;; Rust: program.rs:113 Program::request
(defun program-request (p: Program key: BodyKey tys: (Vec Ty)) -> str
  (trap "todo: E3 program-request"))

;; Rust: program.rs:125 Program::request_closure
(defun program-request-closure (p: Program owner: Inst owner-name: str lit: i64) -> str
  (trap "todo: E3 program-request-closure"))

;; Rust: program.rs:136 Program::next_work
(defun program-next-work (p: Program) -> (Option Work)
  (trap "todo: E3 program-next-work"))

;; Rust: program.rs:145 Program::object
(defun program-object (p: Program t: Ty) -> (Result (Pair i64 str) str)
  (trap "todo: E3 program-object"))

;; Rust: program.rs:221 Program::declare_extern
(defun program-declare-extern (p: Program d: ExternDef) -> (Result unit str)
  (trap "todo: E3 program-declare-extern"))

;; Rust: program.rs:258 Program::fresh_quote
(defun program-fresh-quote (p: Program) -> str
  (trap "todo: E3 program-fresh-quote"))

;; Rust: program.rs:264 Program::has_helper
(defun program-has-helper (p: Program name: str) -> bool
  (trap "todo: E3 program-has-helper"))

;; Rust: program.rs:269 Program::add_helper
(defun program-add-helper (p: Program name: str text: str) -> unit
  (trap "todo: E3 program-add-helper"))

;; Rust: program.rs:275 Program::render_externs
(defun program-render-externs (p: Program) -> str
  (trap "todo: E3 program-render-externs"))

;; Rust: program.rs:285 Program::render_keyword_helpers
(defun program-render-keyword-helpers (p: Program) -> str
  (trap "todo: E3 program-render-keyword-helpers"))

;; Rust: program.rs:315 Program::task_object
(defun program-task-object (p: Program code: str caps: (Vec LirTy)) -> (Pair i64 str)
  (trap "todo: E3 program-task-object"))

;; Rust: program.rs:329 Program::closure_object
(defun program-closure-object (p: Program code: str caps: (Vec LirTy)) -> (Pair i64 str)
  (trap "todo: E3 program-closure-object"))

;; Rust: program.rs:339
(defun tyname (t: LirTy) -> str
  (trap "todo: E3 tyname"))
