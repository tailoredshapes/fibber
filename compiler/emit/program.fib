;; compiler/emit/program.fib: the state of the emission: the typed program and the ownership tables it reads, the object table, the static
;; data, the queue of work and generated functions made so far (spec/compiler.md §2). Replaces crates/fibc/src/program.rs.
;; `Program` is a struct of Cells passed borrowed (plan D1); the Rust `c: &Checked` is its two parts, `typed`
;; and `owned` (own.driver's `Checked` is not needed here). The `closures` VecDeque is a Vec with a head index;
;; `helpers` (a HashSet) is a `(Map str bool)`; Rust's `(String, Option<LirTy>)` of a def is a `DefValue`.
;; E3 ported it all (E2 wrote the object functions, `--layout` needs them). X8 added two fields to the Rust `Program`
;; (`def_slots`, `inits`, with `Init` which inits.rs defines): they are `def-slots` and `inits` here, and `Init` is below.
;; The runtime's own `declare` (`runtime-declaration`) is emit.rt's.
;; E11 added the last field, `macro-module` (Rust `macro_module: bool`, set by `compile-macro`): a trap of a macro module fails the expansion.
(ns emit.program
  (:require [fib.string :as s] [fib.unix :as unix] [emit.os :as os] [lir.ast :as la] [lir.types :as lt] [emit.node :as node] [emit.lirdata :as data] [lir.print :as print] [expand.targetos :as tos] [emit.function :as f])
  (:use types.ty types.ast types.decls types.display types.init types.program own.program emit.value emit.layout emit.names
        emit.mono emit.objects emit.statics emit.rt emit.kwdyn))

;; The work the queue hands out: a body, or a closure of an owner. Rust: program.rs:24 Work
(defenum Work (WorkBody inst: Inst) (WorkClosure owner: Inst lit: i64 name: str))

;; The address and lIR type of a def's value. Rust: program.rs:48 `(String, Option<LirTy>)`
(defstruct DefValue (expr: (Option la/LExpr) ty: (Option LirTy)))

;; One `def` made at run time (X8, L15): the `def`, the module that defines it, the code name of its initialiser's body, and whether
;; its value is an object to make immortal. Rust: inits.rs:42 Init
(defstruct Init (def-id: i64 module: i64 body: str object: bool))

;; Rust: program.rs:37 Program (13 fields; `c` is two) and, since X8, `def_slots` (the slot, a global of the module, and the type of
;; every `def` made at run time, as a `DefValue`) and `inits` (those `def`s in the order their init functions make them)
(defstruct Program
  (typed: TypedProgram owned: OwnedProgram objects: Objects statics: Statics queue: Queue
   closures: (Cell (Vec Work)) closures-head: (Cell i64) funcs: (Cell (Vec la/LFunction)) externs: (Cell (Vec la/LItem))
   helpers: (Cell (Map str bool)) def-values: (Cell (Map i64 DefValue)) quotes: (Cell (Map i64 str))
   quote-text: (Cell (Vec la/LItem)) quote-counter: (Cell i64) keyword-helpers: (Cell bool)
   def-slots: (Cell (Map i64 DefValue)) inits: (Cell (Vec Init))
   macro-module: (Cell bool) unwinding: bool
   ;; live mode (`live-mode?`): the bodies of the program's own modules are emitted behind stubs and slots (emit.live), and the program catches.
   live: bool
   ;; the session's generations and stubbed bodies (`Tables`): shared by every program of a live session, the program's own otherwise.
   live-gens: (Cell (Map str i64)) live-bodies: (Cell (Map str (Vec LiveBody)))
   ;; the bytes of a pointer in the target's memory (4 on wasm32): the layouts of the objects are computed from it. 8 while the JIT runs, which is the host's.
   pb: (Cell i64) runtime: (Vec la/LItem) runtime-host: (Vec la/LItem) link-notes: (Cell (Vec (Pair str str)))))

;; Whether the program catches (stage 2 of docs/design/exceptions.md, ADR 0009): some body calls `catch-run`. Only then do its functions
;; return a failure next to their value (emit.lower.call); a program that never catches has no observer of a failure, so a trap aborts
;; as before and no function pays for the convention. FIB_CATCH=all compiles every program as one that catches (to measure the cost).
(defun program-unwinds? (typed: TypedProgram owned: OwnedProgram) -> bool
  (or (= (unix/getenv "FIB_CATCH") (some "all"))
      (some? (find-first (fn (body: BodyOwn)
                           (some? (find-first (fn (c: CallOwn)
                                                (match (. c callee)
                                                  ((CalBuiltin b) (= (. (nth (. typed builtins) b) name) "catch-run"))
                                                  (_ false)))
                                              (vals (. body calls)))))
                         (vals (. owned bodies))))))

;; Live mode (docs/design/live-repl.md, package LV0): `fibc run --live`, or FIB_LIVE set to anything but "" or "0". The program is
;; compiled as a catching one (ADR 0009: a trap in a later live session is a failure, not an abort) and every body of its own modules
;; sits behind a stub and a slot (emit.live), so that a later generation of the body can be swapped in by one store. Nothing of this
;; is emitted otherwise: the lIR of a program is the same as before live mode existed.
(defun live-mode? () -> bool
  (match (unix/getenv "FIB_LIVE") (nil false) ((some v) (not (or (= v "") (= v "0"))))))

;; The id tables a program numbers its objects and statics in: the type ids (`fib.types`' rows, read by `fib.release` and every walker)
;; and the names of strings, keywords, immortal closures and vtables (`str.N`, `clo.N`). They are plain literals in the emitted code,
;; given out in the order of first use, so two programs that differ in one body disagree on them. A live session (compiler/live) gives
;; every program of the session the same `Tables`: a type or static already numbered keeps its number and a new one is appended
;; (compiler/live/FINDINGS.md says what broke without this). A program made with `program-new` has tables of its own.
(defstruct Tables (objects: Objects statics: Statics
   ;; live mode across the programs of a session (docs/design/live-repl.md 3.1, package LV2): the generation each family of bodies is
   ;; lowered under (`f.NAME` for a function, its all-owned twin and specialisations; a method's name for a method), 0 when unnamed, and
   ;; every stubbed body the programs made, by family, as `emit.live/add-stub` registers them (the live table reads it)
   generations: (Cell (Map str i64)) bodies: (Cell (Map str (Vec LiveBody)))))

;; A body behind a stub: its name (`f.NAME.$T_`, `f.NAME.owned`, `m.P.NAME.$T_`), the function's name when it is one of the main
;; module (for `emit.compile/BodyRequest`), whether it is the all-owned twin, whether it is a specialisation (its types are not kept:
;; a type's id is one program's, and two programs of a session number their types differently), and for a method the key of its
;; `impl` as the REPL keys one (`impl:PROTO HEAD`).
(defstruct LiveBody (name: str fun: (Option str) owned: bool generic: bool impl: (Option str)))

(defun tables-new () -> Tables (Tables (objects-new) (statics-new) (cell (map-empty)) (cell (map-empty))))

;; The statics of a program numbered in `shared`: the same strings, keywords, closures and vtables (the cells are shared, so an
;; addition is seen by every program of the session), and `items` of the program's own (the module-level items written in full by name:
;; the slots of live mode, the kernel table, the gpu windows belong to one module).
(defun shared-statics :private (shared: Statics) -> Statics
  (Statics (. shared strings) (. shared string-index) (. shared keywords) (. shared keyword-index) (. shared keywords-sealed)
           (. shared closures) (. shared closure-index) (. shared vtables) (. shared vtable-index) (cell []) (cell (set-empty))))

;; `str` is type id 0: the literals need it before any body runs; the runtime's own text names the byte array and the weak box.
;; (E2 wrote this and the object functions below, which `--layout` needs; E3 owns the rest of this module.)
;; Rust: program.rs:60 Program::new
(defun program-new (typed: TypedProgram owned: OwnedProgram) -> Program
  (program-new-with typed owned nil))

;; A program numbered in `tables` when given (a live session's), else in tables of its own.
(defun program-new-with (typed: TypedProgram owned: OwnedProgram tables: (Option Tables)) -> Program
  (let ((p (Program typed owned (match tables ((some t) (. t objects)) (nil (objects-new)))
                    (match tables ((some t) (shared-statics (. t statics))) (nil (statics-new)))
                    (queue-new) (cell []) (cell 0) (cell []) (cell [])
                    (cell (map-empty)) (cell (map-empty)) (cell (map-empty)) (cell []) (cell 0) (cell false)
                    (cell (map-empty)) (cell []) (cell false) (or (live-mode?) (program-unwinds? typed owned)) (live-mode?)
                    (match tables ((some t) (. t generations)) (nil (cell (map-empty))))
                    (match tables ((some t) (. t bodies)) (nil (cell (map-empty))))
                    (cell (os/target-pointer-bytes)) (runtime-items-target) (runtime-items-host) (cell []))))
    (do (objects-intern (. p objects) "fib.str" "str" ObStr)
        (objects-intern (. p objects) "fib.array.i8" "(Array i8)" (ObArray LirI8))
        (objects-intern (. p objects) "fib.weakbox" "weak box" ObWeak)
        (objects-intern (. p objects) "fib.task" "task" (ObTask [] []))
        p)))

;; The program the rest of the module is lowered for after the JIT made the constants at the host's pointer width: the same types, objects (their layouts are computed on
;; demand), static data and definitions of the `def`s and their values, and the same work to do: every body and closure the first pass asked for is lowered again, at `pb`
;; (the queue is copied with its head at the start; the closures are asked for again by the bodies that make them, so each name is the one the statics and the constants already hold), into functions made afresh.
(defun program-rebuilt (p: Program pb: i64) -> Program
  (let ((q (. p queue)))
    (Program (. p typed) (. p owned) (. p objects) (. p statics)
             (Queue (cell @(. q pending)) (cell 0) (cell @(. q names)) (cell nil))
             (cell []) (cell 0) (cell []) (cell [])
             (cell (map-empty)) (cell @(. p def-values)) (cell (map-empty)) (cell []) (cell 0) (cell false)
             (cell @(. p def-slots)) (cell @(. p inits)) (cell false) (. p unwinding) (. p live) (. p live-gens) (. p live-bodies)
             (cell pb) (. p runtime) (. p runtime-host) (cell @(. p link-notes)))))

;; The bytes of a pointer of the program's layouts.
(defun program-pb (p: Program) -> i64 @(. p pb))

;; Rust: program.rs:93 Program::g
(defun program-g (p: Program) -> Globals
  (. (. p typed) globals))

;; Rust: program.rs:98 Program::ty_of
(defun program-ty-of (p: Program inst: Inst e: i64) -> (Result Ty str)
  (match (get (. (. p typed) expr-types) e)
    (nil (Err (str-join ["expression ExprId(" (str e) ") has no type"])))
    ((some t) (Ok (inst-subst inst t)))))

;; Rust: program.rs:108 Program::lir
(defun program-lir (p: Program t: Ty) -> (Result (Option LirTy) str)
  (lir-ty (program-g p) t))

;; Rust: program.rs:113 Program::request
(defun program-request (p: Program key: BodyKey tys: (Vec Ty)) -> str
  ;; Colours have no representation (§8.4): one specialisation serves every colour instantiation.
  (queue-request (. p queue) (program-g p)
                 (Inst key (mapv (fn (t: Ty) (ty-map-colours t (fn (k: Colour) CLocal))) tys))))

;; Rust: program.rs:125 Program::request_closure
(defun program-request-closure (p: Program owner: Inst owner-name: str lit: i64) -> str
  (let ((name (closure-name owner-name lit)))
    (do (cell-update! (. p closures) (fn (closures: (Vec Work)) (conj closures (WorkClosure owner lit name))))
        name)))

;; Rust: program.rs:136 Program::next_work
(defun program-next-work (p: Program) -> (Option Work)
  (let ((h @(. p closures-head)))
    (if (< h (count @(. p closures)))
        (do (set! (. p closures-head) (+ h 1))
            (some (nth @(. p closures) h)))
        (match (queue-pop (. p queue))
          (nil nil)
          ((some inst) (some (WorkBody inst)))))))

;; What an object type is called in the table and what it is.
(defstruct ObjSpec :private (sname: str kind: ObjKind))

;; The element layout of a container; a `unit` content takes an `i1` slot that nothing reads (an atom of `unit` is a task's
;; result holder). Rust: program.rs:220 elem_lir
(defun elem-lir :private (g: Globals args: (Vec Ty)) -> (Result LirTy str)
  (match (first args)
    (nil (Err "a constructor without its argument"))
    ((some t) (try-let ((l (lir-ty g t))) (Ok (unwrap-or l LirI1))))))

;; A container's object: `fib.NAME.ELEM` with its element's short name.
(defun container-spec :private (g: Globals args: (Vec Ty) word: str mk: (fn (LirTy) ObjKind) :borrow) -> (Result ObjSpec str)
  (try-let ((e (elem-lir g args)))
    (Ok (ObjSpec (str-join ["fib." word "." (tyname e)]) (mk e)))))

;; The struct name and kind of the nominal type `t` with arguments `args`. Rust: program.rs:145 Program::object, the last two arms
(defun nominal-spec :private (g: Globals t: Ty id: i64 args: (Vec Ty)) -> (Result ObjSpec str)
  (if (= id @(. g option))
      (let ((payload (unwrap-or (option-payload g t) (ty-unit))))
        (try-let ((rep (option-rep g payload)))
          (if (not (= rep OptBoxed))
              (Err "an Option held as a null pointer or as a value has no object")
              (try-let ((f (lir-ty g payload)))
                (Ok (ObjSpec (str-join ["o." (mangle g t)]) (ObEnum [[] [f]])))))))
      (try-let ((vs (variants g id args))
                (lowered (try-map (fn (v: Variant) (try-map (fn (f: Ty) (lir-ty g f)) (. v tys))) vs)))
        (Ok (ObjSpec (str-join ["o." (mangle g t)])
                     (match (. (nth vs 0) name)
                       (nil (ObStruct (nth lowered 0)))
                       ((some _) (ObEnum lowered))))))))

;; The type id and struct name of the object type `t` (a struct, an enum with fields, `str`, an array, a boxed `Option`).
;; Rust: program.rs:145 Program::object
(defun program-object (p: Program t: Ty) -> (Result (Pair i64 str) str)
  (let ((g (program-g p)))
    (try-let ((spec (match t
                      ((TCon (KStr) _) (Ok (ObjSpec "fib.str" ObStr)))
                      ((TCon (KArray) args) (container-spec g args "array" (fn (e: LirTy) (ObArray e))))
                      ((TCon (KCell) args) (container-spec g args "cell" (fn (e: LirTy) (ObCell e))))
                      ((TCon (KAtom) args) (container-spec g args "atom" (fn (e: LirTy) (ObAtom e))))
                      ((TCon (KWeak) _) (Ok (ObjSpec "fib.weakbox" ObWeak)))
                      ((TCon (KTask) _) (Ok (ObjSpec "fib.task" (ObTask [] []))))
                      ((TCon (KNominal id) args) (nominal-spec g t id args))
                      (_ (Err (str-join ["no object layout for " (mangle g t)]))))))
      (let ((tid (objects-intern (. p objects) (. spec sname) (printer-ty (printer-new g) t) (. spec kind))))
        (Ok (Pair tid (. spec sname)))))))

;; Rust: program.rs:221 Program::declare_extern
(defun program-declare-extern (p: Program d: ExternDef) -> (Result unit str)
  (match (. d ty)
    ((TFn _ params ret)
     (let ((g (program-g p)))
       (try-let ((ps (try-map (fn (t: Ty)
                                (try-let ((l (lir-ty g t)))
                                  (match l (nil (Err "a unit extern parameter")) ((some x) (Ok (lir-type x)))))) params))
                 (result (lir-ty g ret)))
         (let ((fixed (if (and (. d varargs) (>= (. d fixed) 0) (< (. d fixed) (count ps))) (vec (take (. d fixed) ps)) ps))
               (rtype (match result ((some t) (some (lir-type t))) (nil nil))))
           (let ((ty (lt/LFnType lt/cc-c rtype fixed (. d varargs)))
                 (decl (la/ItDeclare (la/LDeclare (. d name) (lt/LFnType lt/cc-c rtype fixed (. d varargs)) false 0))))
             (match (runtime-declaration (. d name))
               ((some own)
                (match (first (data/read-runtime own))
                  ((some (la/ItDeclare runtime))
                   (if (= (. runtime ty) ty) (Ok ()) (Err (str-join ["extern " (. d name) " conflicts with the runtime's " own]))))
                  (_ (Err (str "invalid runtime declaration of " (. d name))))))
               (nil
                (do (when (not-any? (fn (item: la/LItem) (match item ((la/ItDeclare other) (= (. other name) (. d name))) (_ false))) @(. p externs))
                      (cell-update! (. p externs) (fn (externs: (Vec la/LItem)) (conj externs decl))))
                    (when-not (= (. d lib) "")
                      (let ((note (Pair (. d lib) (. d owner))))
                        (when-not (includes? note @(. p link-notes))
                          (cell-update! (. p link-notes) (fn (notes: (Vec (Pair str str))) (conj notes note))))))
                    (Ok ())))))))))
    (_ (Err "an extern without a function type"))))

;; Rust: program.rs:258 Program::fresh_quote
(defun program-fresh-quote (p: Program) -> str
  (let ((n (+ @(. p quote-counter) 1)))
    (do (set! (. p quote-counter) n)
        (str-join ["@q." (str n)]))))

;; Rust: program.rs:264 Program::has_helper
(defun program-has-helper (p: Program name: str) -> bool
  (contains? @(. p helpers) name))

;; Rust: program.rs:269 Program::add_helper
(defun program-add-helper (p: Program name: str func: la/LFunction) -> unit
  (do (program-mark-helper p name)
      (program-add-function p func)))

(defun program-add-function (p: Program func: la/LFunction) -> unit
  (cell-update! (. p funcs) (fn (funcs: (Vec la/LFunction)) (conj funcs func))))

(defun program-mark-helper (p: Program name: str) -> unit
  (cell-update! (. p helpers) (fn (helpers: (Map str bool)) (assoc helpers name true))))

;; Rust: program.rs:275 Program::render_externs
(defun program-render-externs (p: Program) -> str
  (print/print-module (la/LModule @(. p externs))))

;; Rust: program.rs:285 Program::render_keyword_helpers
(defun program-keyword-items (p: Program) -> (Vec la/LItem)
  (cond (not @(. p keyword-helpers)) []
        (program-has-helper p "kw.dyn") (dyn-keyword-items (. p statics) (statics-keywords (. p statics)))
        :else (static-keyword-items (. p statics) (statics-keywords (. p statics)))))

(defun program-render-keyword-helpers (p: Program) -> str
  (print/print-module (la/LModule (program-keyword-items p))))

(defun static-keyword-items :private (st: Statics names: (Vec str)) -> (Vec la/LItem)
  (let ((n (count names)))
    ;; Intern :k before k, retaining the order of the static string identities.
    (let ((pairs (mapv (fn (i: i64)
                         (let ((colon (statics-string st (str ":" (nth names i)) 0))
                               (name (statics-string st (nth names i) 0)))
                           (Pair (f/block (str "k" i) [(node/ret (some (node/call "fib.str-copy" [(node/reference colon)])))])
                                 (f/block (str "k" i) [(node/ret (some (node/call "fib.str-hash" [(node/reference name)])))])))) (range n)))
          (cases (mapv (fn (i: i64) (la/LCase (node/integer lt/ty-i64 i) (str "k" i))) (range n)))
          (order (sort-by (fn (i: i64) (nth names i)) (range n))))
      (let ((entry (f/block "entry" [(node/switch (node/local "k") "bad" cases)]))
            (bad (f/block "bad" [(node/unreachable)]))
            (ranks (mapv (fn (i: i64) (f/block (str "k" (nth order i)) [(node/ret (some (node/integer lt/ty-i64 i)))])) (range n))))
        [(la/ItDefine (f/make "kw.show" (some lt/ty-ptr) [(Pair "k" lt/ty-i64)] lt/cc-c
                              (conj (into [entry] (mapv (fn (q: (Pair la/LBlock la/LBlock)) (. q fst)) pairs)) bad)))
         (la/ItDefine (f/make "kw.hash" (some lt/ty-i64) [(Pair "k" lt/ty-i64)] lt/cc-c
                              (conj (into [entry] (mapv (fn (q: (Pair la/LBlock la/LBlock)) (. q snd)) pairs)) bad)))
         (la/ItDefine (f/make "kw.rank" (some lt/ty-i64) [(Pair "k" lt/ty-i64)] lt/cc-c (conj (into [entry] ranks) bad)))]))))

;; Rust: program.rs:315 Program::task_object
(defun program-task-object (p: Program code: str caps: (Vec LirTy)) -> (Pair i64 str)
  (let ((sname (str-join ["task." code])))
    (Pair (objects-intern (. p objects) sname (str-join ["task " code]) (ObTask caps [])) sname)))

;; Rust: program.rs:329 Program::closure_object
(defun program-closure-object (p: Program code: str caps: (Vec LirTy)) -> (Pair i64 str)
  (let ((sname (str-join ["clo." code])))
    (Pair (objects-intern (. p objects) sname (str-join ["closure " code]) (ObClosure caps)) sname)))

;; Rust: program.rs:339
(defun tyname (t: LirTy) -> str
  (match t
    ((LirDyn) "dyn")
    ;; Not `ptr`: `(Array ptr)` and `(Array str)` have one layout but not one drop, and a name is one object type.
    ((LirRaw) "raw")
    ((LirOpt s) (str-join ["opt." (tyname s)]))
    ((LirVec e n) (str-join ["vec" (str n) "x" (tyname e)]))
    (_ (lir-ty-text t))))


(defun runtime-items-host :private () -> (Vec la/LItem) (data/read-runtime (runtime-text-host)))
(defun runtime-items-target :private () -> (Vec la/LItem) (data/read-runtime (runtime-text)))
