;; compiler/emit/assemble.fib: the module's structured items in their sections, and the loop that emits every body and closure queued
;; (spec/compiler.md §2). Replaces compile.rs:71 `emit_all`, :175 `module_parts`, `assemble_parts` and the types `Parts` and `Module`
;; (compile.rs:211-262), which are not in emit.compile because emit.defs.mod needs `emit-all` and `assemble-parts` (it assembles
;; the module so far for every `def` it runs) and emit.compile needs `emit-defs`: a module cannot call its caller.
;; A stub reached makes `emit-body` and `emit-closure` return an error whose message starts with `todo: ` (pending, never a pass):
;; `emit-all` passes it on, and emit.compile makes it the `pending` of the `Module`.
(ns emit.assemble
  (:require [lir.ast :as la] [lir.print :as print] [emit.lirdata :as data])
  (:use types.ty own.program emit.value emit.mono emit.objects emit.statics emit.program emit.inits emit.rt emit.lower.mod emit.defs.data))

;; The text of a module before its `main`, in the pieces `assemble-parts` puts together, in this order (`fibc emit-dump --sections`):
;; the runtime, the `extern` declarations, the object structs and the type table, the static data, the keyword helpers, the values
;; of the `def`s, the quoted constants, then every function in the order its body was finished. Rust: compile.rs:211 Parts
(defstruct Parts (runtime: (Vec la/LItem) externs: (Vec la/LItem) types: (Vec la/LItem)
                  statics: (Vec la/LItem) keywords: (Vec la/LItem) defs: (Vec la/LItem)
                  quotes: (Vec la/LItem) fns: (Vec la/LItem) links: (Vec (Pair str str))))

;; A program's lIR module: Parts, then lIR's `main`; `pending` is the first stub reached, when emitting stopped at one (the parts
;; after the runtime are then empty). Rust: compile.rs:243 Module
(defstruct Module (parts: Parts main: (Vec la/LItem) pending: (Option str)))

;; The parts of a module that stopped at a stub: only the runtime is known.
(defun parts-pending () -> Parts
  (Parts (data/read-runtime (runtime-text)) [] [] [] [] [] [] [] []))

;; The pieces one after the other, the `dependent-library` forms first. Rust: compile.rs:226 Parts::text
(defun parts-items (parts: Parts) -> (Vec la/LItem)
  (into (into (into (into (into (into (into (into (link-items (. parts links)) (. parts runtime)) (. parts externs)) (. parts types)) (. parts statics))
                                (. parts keywords)) (. parts defs)) (. parts quotes)) (. parts fns)))

;; The native libraries the program reaches (`:lib "NAME"` on an extern, noted with the module that wrote it) as lIR's `(dependent-library "NAME")`
;; (spec/lir.md 4.9), each once: lair links them and the JIT loads them from the form, and reads nothing beside the module.
(defun link-items (links: (Vec (Pair str str))) -> (Vec la/LItem)
  (reduce (fn (out: (Vec la/LItem) l: (Pair str str))
            (if (some? (first (filter (fn (it: la/LItem) (match it ((la/ItDependentLibrary d) (= (. d name) (. l fst))) (_ false))) out)))
                out
                (conj out (la/ItDependentLibrary (la/LDependentLibrary (. l fst) 0)))))
          [] links))

(defun parts-text (parts: Parts) -> str
  (print/print-module (la/LModule (parts-items parts))))

;; The text `fibc emit` prints. Rust: compile.rs:253 Module::text
(defun module-ast (m: Module) -> la/LModule
  (la/LModule (into (parts-items (. m parts)) (. m main))))

(defun module-text (m: Module) -> str
  (print/print-module (module-ast m)))

;; The runtime, the tables, the static data and every function: what a program and a macro module share, and what `emit_defs`
;; assembles again for every `def` it runs, so the program's functions and quoted constants are copied and left in place.
;; Rust: compile.rs:269 module_parts
(defun module-parts (p: Program defs: (Vec la/LItem)) -> Parts
  (module-parts-with (. p runtime) p defs))

;; `module-parts` with the text of the runtime `rt` (the target's for a program, the host's for what the JIT runs: emit.rt).
(defun module-parts-with (rt: (Vec la/LItem) p: Program defs: (Vec la/LItem)) -> Parts
  ;; Keywords intern their strings before statics are collected.
  (let ((keywords (program-keyword-items p))
        (types (objects-items-pb (. p objects) (program-pb p))))
    (Parts rt @(. p externs) types (statics-items (. p statics)) keywords
           (into (inits-slot-items p) defs) @(. p quote-text)
           (mapv (fn (f: la/LFunction) (la/ItDefine f)) @(. p funcs)) @(. p link-notes))))

;; The host module's items so far, reused by each constant-evaluation session.
(defun module-items (p: Program d: Defs) -> (Vec la/LItem)
  (parts-items (module-parts-with (. p runtime-host) p @(. d items))))

;; Rust: compile.rs:285 assemble_parts
(defun assemble-parts (p: Program defs: (Vec la/LItem)) -> str
  (parts-text (module-parts-with (. p runtime-host) p defs)))

;; Emits every body and closure queued so far. Rust: compile.rs:71 emit_all
(defun emit-all (p: Program) -> (Result unit str)
  (loop ()
    (match (program-next-work p)
      (nil (Ok ()))
      ((some w)
       (try-let ((_ (match w
                      ((WorkBody inst) (emit-body p inst))
                      ((WorkClosure owner lit name) (emit-closure p owner lit name)))))
         (match (queue-overflow (. p queue))
           ((some body)
            (Err (str-join [body " is wanted at ever larger types, a polymorphic recursion that never ends (types §3.6): "
                            "the compilation would never finish"])))
           (nil (recur))))))))
