;; compiler/emit/rt.fib: what the compiler does with the runtime's lIR text (spec/compiler.md §3): the text of the module's first
;; section and the runtime's own `declare` of a C function. The text is the data of emit.runtime, generated from rt/*.lir.
;; Replaces compile.rs:20 RUNTIME and compile.rs:36 runtime_declaration.
(ns emit.rt
  (:use emit.runtime) (:require [emit.os :as os] [emit.wasi :as wasi] [expand.targetos :as tos]))

;; The eleven parts in the order compile.rs:20 `include_str!`s them: core str array vec vecbuild atom thread task weak io sys; then alloc,
;; the large-block cache (rt/alloc.lir), which the Rust runtime does not have.
(defun runtime-parts-for (os-name: str) -> (Vec str)
  (if (= os-name "Wasi")
    (conj (mapv wasi/adapt [RT-CORE RT-STR RT-ARRAY RT-VEC RT-VECBUILD RT-ATOM RT-THREAD RT-TASK RT-WEAK RT-IO RT-SYS RT-ALLOC]) (wasi/shim))
    (runtime-parts-posix os-name)))

(defun runtime-parts-posix :private (os-name: str) -> (Vec str)
  [(os/sys-for os-name RT-CORE) RT-STR RT-ARRAY RT-VEC RT-VECBUILD RT-ATOM (os/sys-for os-name RT-THREAD) (os/sys-for os-name RT-TASK) RT-WEAK RT-IO
   (os/sys-for os-name RT-SYS) (os/sys-for os-name RT-ALLOC)])

;; The runtime of the program being generated: for the OS of FIB_TARGET_TRIPLE, else the host's (expand.targetos).
(defun runtime-parts () -> (Vec str)
  (runtime-parts-for (tos/target-platform-name)))

;; The runtime of what runs in this process, the macro modules and `def`s the JIT runs while the program is compiled: the host's, whatever the target.
(defun runtime-text-host () -> str
  (str-join (vec (mapcat (fn (part: str) [part "\n"]) (runtime-parts-for (tos/host-platform-name))))))

;; The first section of a module: every part followed by a line break. Rust: compile.rs:249 `runtime` of module_parts
(defun runtime-text () -> str
  (str-join (vec (mapcat (fn (part: str) [part "\n"]) (runtime-parts)))))

;; The line of `part` that starts at byte `start`, without its line break (`str-find` counts bytes).
(defun line-from :private (part: str start: i64) -> str
  (match (str-find part "\n" start)
    (nil (str-slice part start (str-len part)))
    ((some e) (str-slice part start e))))

;; The first line of `part` that starts with `head`.
(defun declaration-in :private (part: str head: str) -> (Option str)
  (if (starts-with? part head)
      (some (line-from part 0))
      (match (str-find part (str-join ["\n" head]) 0)
        (nil nil)
        ((some i) (some (line-from part (+ i 1)))))))

;; The runtime's own `declare` of the C function `name`, if any: a program's `extern` of the same name must agree with it and is then
;; not declared again. Rust: compile.rs:36 runtime_declaration. Added: a runtime function marked by a line `;; extern: (declare ...)`
;; (rt/alloc.lir's `fib_alloc_ctl`) answers with that declaration, so a library's `extern` of it binds to the runtime's definition.
(defun runtime-declaration (name: str) -> (Option str)
  (let ((head (str-join ["(declare " name " "]))
        (marked (str-join [";; extern: (declare " name " "])))
    (reduce (fn (found: (Option str) part: str)
              (match found
                ((some _) found)
                (nil (match (declaration-in part head)
                       ((some d) (some d))
                       (nil (match (declaration-in part marked)
                              ((some m) (some (str-slice m 11 (str-len m))))
                              (nil nil)))))))
            nil (runtime-parts))))
