;; compiler/emit/objects/walk.fib: the `drop`, `trace` and `share` functions of the object types (types §8.2, §8.3): which slots of an
;; object are children, and a function that acts on each. A slot is a child when its lIR type says it is a counted pointer (`ptr`,
;; an object's) or a `dyn`; a raw `ptr` (`LirRaw`, types §8.1) is an address with no count and is never one.
;; A `drop` does not release its children: it queues them on the worklist of the drop in progress (`fib.defer`, rt/core.lir), last
;; child first, so that taking them off in turn releases them in field order; a `share` queues them on the worklist of a
;; share-marking (`fib.share-queue`, rt/atom.lir); a `trace` is the one-level walk that calls a callback on each child.
;; Replaces crates/fibc/src/objects/walk.rs (150 lines of Rust before its test). The Rust `walker` takes the action as a closure;
;; its three callers are the three words `drop`, `trace` and `share`, so the word picks the action here.
(ns emit.objects.walk
  (:require [fib.string :as s] [emit.node :as n] [emit.function :as f] [lir.ast :as la] [lir.types :as lt])
  (:use emit.value emit.objects.kinds))

;; The struct a group of children is read through, and the index of each child slot in it.
(defstruct Group (sname: str slots: (Vec i64)))

(defun counted-ty :private (t: LirTy) -> bool
  (or (= t LirPtr) (= t LirDyn)))

;; The index of each counted slot among the declared fields `fs` (a unit field has no slot), the first slot being `base`.
(defun counted :private (fs: (Vec (Option LirTy)) base: i64) -> (Vec i64)
  (. (reduce (fn (acc: (Pair i64 (Vec i64)) f: (Option LirTy))
               (match f
                 ((some t) (Pair (+ (. acc fst) 1)
                                 (if (counted-ty t) (conj (. acc snd) (. acc fst)) (. acc snd))))
                 (nil acc)))
             (Pair base []) fs)
     snd))

(defun some-of :private (ts: (Vec LirTy)) -> (Vec (Option LirTy))
  (mapv (fn (t: LirTy) (some t)) ts))

;; The child pointers of an object: a struct name and the slot indexes for a pointer or `dyn` field, per variant for an enum.
;; Rust: walk.rs:34 child_fields
(defun child-fields :private (o: ObjInfo) -> (Vec Group)
  (let ((sn (. o sname)))
    (match (. o kind)
      ((ObStruct fs) [(Group sn (counted fs slot-struct-field0))])
      ((ObEnum vs) (vec (map-indexed (fn (i: i64 v: (Vec (Option LirTy)))
                                       (Group (obj-variant-sname o i) (counted v slot-variant-field0)))
                                     vs)))
      ((ObCell t) [(Group sn (if (counted-ty t) [slot-cell-value] []))])
      ((ObAtom t) [(Group sn (if (counted-ty t) [slot-atom-value] []))])
      ((ObClosure caps) [(Group sn (counted (some-of caps) slot-capture0))])
      ;; The captures first, then the result, the waiters and the message the task failed with.
      ((ObTask caps _) [(Group sn (conj (conj (conj (counted (some-of caps) slot-task-capture0) slot-task-result)
                                              slot-task-waiters)
                                        slot-task-failure))])
      (_ [(Group sn [])]))))

;; What a `drop`, a `trace` or a `share` does to a child, whose text is `child`.
(defun act :private (what: str child: la/LExpr) -> la/LExpr
  (cond (= what "drop") (n/call "fib.defer" [(n/local "wl") child])
        (= what "trace") (n/indirect-call (n/local "cb") (lt/LFnType lt/cc-c nil [lt/ty-ptr] false) [child] false)
        :else (n/call "fib.share-queue" [(n/local "wl") child])))

(defun gep :private (sn: str i: i64) -> la/LExpr (f/field sn (n/local "p") i))

;; The action on each child slot, the children read as `ptr` (a `dyn` slot's first word is its object, as a `ptr` slot is).
;; Rust: walk.rs:155 releases
(defun releases :private (what: str g: Group) -> (Vec la/LExpr)
  (mapv (fn (i: i64) (act what (n/load lt/ty-ptr (gep (. g sname) i) nil))) (. g slots)))

;; The walker of an array of counted elements: a loop up, or down for a drop. Rust: walk.rs:128 array_walker
(defun array-walker :private (o: ObjInfo what: str) -> (Vec la/LBlock)
  (let ((sn (. o sname)) (down (= what "drop"))
        (start (if (= what "drop") (n/local "last") (n/integer lt/ty-i64 0)))
        (more (n/compare-int (if (= what "drop") la/ISge la/ISlt) (n/local "i") (if (= what "drop") (n/integer lt/ty-i64 0) (n/local "n"))))
        (step (n/binary (if (= what "drop") la/BSub la/BAdd) (n/local "i") (n/integer lt/ty-i64 1))))
    [(f/block "entry" [(f/bound [(f/binding "n" (n/load lt/ty-i64 (gep sn slot-len) nil))
                                (f/binding "last" (n/binary la/BSub (n/local "n") (n/integer lt/ty-i64 1)))] [(n/branch "loop")])])
     (f/block "loop" [(f/bound [(f/binding "i" (n/node (la/KPhi lt/ty-i64 [(f/binding "entry" start) (f/binding "next" (n/local "i2"))])))]
                               [(n/conditional more "body" "done")])])
     (f/block "body" [(f/bound [(f/binding "e" (n/load lt/ty-ptr (n/gep (lt/TNamed sn) (n/local "p")
                                                                                [(n/integer lt/ty-i32 0) (n/integer lt/ty-i32 slot-elems) (n/local "i")]) nil))]
                               [(act what (n/local "e")) (n/branch "next")])])
     (f/block "next" [(f/bound [(f/binding "i2" step)] [(n/branch "loop")])])
     (f/block "done" [(n/ret nil)])]))

;; The text of the walker of an enum: a switch on the tag, a block per variant.
(defun enum-walker :private (o: ObjInfo what: str groups: (Vec Group)) -> (Vec la/LBlock)
  (let ((cases (mapv (fn (i: i64) (la/LCase (n/integer lt/ty-i32 i) (str "v" i))) (range (count groups))))
        (blocks (vec (map-indexed (fn (i: i64 g: Group) (f/block (str "v" i) (conj (releases what g) (n/branch "done")))) groups))))
    (conj (into [(f/block "entry" [(n/switch (n/load lt/ty-i32 (gep (. o sname) slot-enum-tag) nil) "done" cases)])] blocks)
          (f/block "done" [(n/ret nil)]))))

;; A `drop.N`, `trace.N` or `share.N` function (WHAT is `drop`, `trace` or `share`): the action on each child pointer of
;; the object (an enum's by its tag through `switch`; an array's elements in a loop). A drop goes through the fields in
;; reverse, for the worklist. Rust: walk.rs:77 walker
(defun walker (o: ObjInfo what: str) -> la/LFunction
  (let ((drop (= what "drop"))
        (params [(Pair "p" lt/ty-ptr) (Pair (if (= what "trace") "cb" "wl") lt/ty-ptr)]))
    (f/make (str what "." (. o tid)) nil params lt/cc-c
            (cond (match (. o kind) ((ObArray t) (counted-ty t)) (_ false)) (array-walker o what)
                  (and drop (match (. o kind) ((ObWeak) true) (_ false)))
                  [(f/block "entry" [(n/call "fib.weak-drop" [(n/local "p")]) (n/ret nil)])]
                  :else (let ((groups (mapv (fn (g: Group) (if drop (Group (. g sname) (vec (reverse (. g slots)))) g)) (child-fields o))))
                          (match (. o kind)
                            ((ObEnum _) (enum-walker o what groups))
                            (_ [(f/block "entry" (conj (releases what (nth groups 0)) (n/ret nil)))])))))))
