;; Generated helpers are ordinary lIR functions. The constructors preserve
;; binding scopes and calling conventions without assembling source text.
(ns emit.function (:use lir.ast lir.types)
  (:require [emit.node :as node]))

(defun make (name: str ret: (Option LType) params: (Vec (Pair str LType)) cc: LCc blocks: (Vec LBlock)) -> LFunction
  (LFunction name (LFnType cc ret (mapv (fn (p: (Pair str LType)) (. p snd)) params) false)
             (mapv (fn (p: (Pair str LType)) (LParam (. p fst) 0)) params)
             blocks (LModifiers lk-internal false false false false false nil) 0))

(defun block (label: str body: (Vec LExpr)) -> LBlock (LBlock label body 0))
(defun binding (name: str value: LExpr) -> LBinding (LBinding name value 0))
(defun bound (binds: (Vec LBinding) body: (Vec LExpr)) -> LExpr (node/node (KLet binds body)))
(defun field (sname: str object: LExpr slot: i64) -> LExpr
  (node/gep (TNamed sname) object [(node/integer ty-i32 0) (node/integer ty-i32 slot)]))

(defun external (func: LFunction) -> LFunction
  (LFunction (. func name) (. func ty) (. func params) (. func blocks) (with (. func mods) (linkage lk-external) (hidden false)) (. func pos)))

;; An export of a library: `external`, and `(export-name NAME)` (spec/lir.md 4.3, LLVM's `"wasm-export-name"`: a wasm module exports it under
;; that name; a native library exports it by its linkage and visibility).
(defun exported (func: LFunction) -> LFunction
  (let ((e (external func)))
    (with e (mods (with (. e mods) (export-name (some (. func name))))))))
