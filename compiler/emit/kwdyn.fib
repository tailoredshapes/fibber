;; Keyword helpers share the emitter's lIR nodes, including their loop phis.
(ns emit.kwdyn
  (:use emit.statics lir.ast lir.types)
  (:require [emit.node :as n] [emit.function :as f] [lir.print :as print]))

(defun name-items :private (st: Statics names: (Vec str)) -> LItem
  (let ((length (count names))
        (cases (mapv (fn (i: i64) (LCase (n/integer ty-i64 i) (str "k" i))) (range (count names))))
        (blocks (mapv (fn (i: i64) (f/block (str "k" i) [(n/ret (some (n/reference (statics-string st (nth names i) 0))))])) (range (count names)))))
    (ItDefine (f/make "kw.name" (some ty-ptr) [(Pair "k" ty-i64)] cc-c
      (conj (into [(f/block "entry" [(n/switch (n/local "k") "dyn" cases)])] blocks)
            (f/block "dyn" [(n/ret (some (n/call "fib.kwd-name" [(n/binary BSub (n/local "k") (n/integer ty-i64 length))])))]))))))

(defun phi-zero :private (name: str) -> LExpr
  (n/node (KPhi ty-i64 [(f/binding "entry" (n/integer ty-i64 0)) (f/binding "step" (n/local name))])))

(defun rank-item :private (length: i64) -> LItem
  (ItDefine (f/make "kw.rank" (some ty-i64) [(Pair "k" ty-i64)] cc-c
    [(f/block "entry" [(f/bound [(f/binding "me" (n/call "kw.name" [(n/local "k")]))
                                (f/binding "total" (n/binary BAdd (n/integer ty-i64 length) (n/call "fib.kwd-count" [])))] [(n/branch "loop")])])
     (f/block "loop" [(f/bound [(f/binding "j" (phi-zero "j2")) (f/binding "r" (phi-zero "r2"))]
                              [(n/conditional (n/compare-int ISlt (n/local "j") (n/local "total")) "body" "done")])])
     (f/block "body" [(f/bound [(f/binding "less" (n/compare-int ISlt
                               (n/call "fib.str-cmp" [(n/call "kw.name" [(n/local "j")]) (n/local "me")]) (n/integer ty-i32 0)))] [(n/branch "step")])])
     (f/block "step" [(f/bound [(f/binding "j2" (n/binary BAdd (n/local "j") (n/integer ty-i64 1)))
                               (f/binding "r2" (n/binary BAdd (n/local "r") (n/select (n/local "less") (n/integer ty-i64 1) (n/integer ty-i64 0))))]
                              [(n/branch "loop")])])
     (f/block "done" [(n/ret (some (n/local "r")))]) ])))

(defun intern-item :private (length: i64) -> LItem
  (ItDefine (f/make "kw.intern" (some ty-i64) [(Pair "s" ty-ptr)] cc-c
    [(f/block "entry" [(n/branch "loop")])
     (f/block "loop" [(f/bound [(f/binding "j" (phi-zero "j2"))]
                              [(n/conditional (n/compare-int ISlt (n/local "j") (n/integer ty-i64 length)) "body" "miss")])])
     (f/block "body" [(n/conditional (n/call "fib.str-eq" [(n/call "kw.name" [(n/local "j")]) (n/local "s")]) "hit" "step")])
     (f/block "step" [(f/bound [(f/binding "j2" (n/binary BAdd (n/local "j") (n/integer ty-i64 1)))] [(n/branch "loop")])])
     (f/block "hit" [(n/ret (some (n/local "j")))])
     (f/block "miss" [(n/ret (some (n/binary BAdd (n/integer ty-i64 length) (n/call "fib.kwd-intern" [(n/local "s")]))))]) ])))

(defun dyn-keyword-items (st: Statics names: (Vec str)) -> (Vec LItem)
  (let ((colon (n/reference (statics-string st ":" 0))))
    [(name-items st names)
     (ItDefine (f/make "kw.show" (some ty-ptr) [(Pair "k" ty-i64)] cc-c
                       [(f/block "entry" [(n/ret (some (n/call "fib.str-concat" [colon (n/call "kw.name" [(n/local "k")])])))])]))
     (ItDefine (f/make "kw.hash" (some ty-i64) [(Pair "k" ty-i64)] cc-c
                       [(f/block "entry" [(n/ret (some (n/call "fib.str-hash" [(n/call "kw.name" [(n/local "k")])])))])]))
     (rank-item (count names)) (intern-item (count names))]))

(defun dyn-keyword-helpers (st: Statics names: (Vec str)) -> str
  (print/print-module (LModule (dyn-keyword-items st names))))
