;; Adapt the frozen seed runtime at its boundary without changing the Rust seed.
(ns emit.os (:use fib.core fib.seq fib.coll) (:require [lir.targets :as tt]))
(defun replace :private (text: str old: str new: str) -> str
  (loop [offset 0 parts: (Vec str) []]
    (match (str-find text old offset)
      (nil (str-join (conj parts (str-slice text offset (str-len text)))))
      ((some at) (recur (+ at (str-len old)) (conj (conj parts (str-slice text offset at)) new))))))
;; The bytes of a pointer on the target of this run: FIB_TARGET_TRIPLE's row (4 on wasm32), else 8 (the host's: every host this compiler runs on has
;; 64-bit pointers). `emit.program/program-new` reads it once per program; the macros' programs and the JIT's run on the host and keep 8.
(defun target-pointer-bytes () -> i64
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    (nil 8)
    ((some t) (if (= t "") 8 (quot (. (tt/target-row-of-triple t) pointer-bits) 8)))))
;; Darwin's pthread_key_t is an unsigned long (8 bytes; glibc's is 4): the two key globals of rt/core.lir are 8 bytes there, so
;; pthread_key_create writes inside them, and the key is passed as an i64.
(defun darwin-keys :private (text: str) -> str
  (replace (replace (replace (replace (replace (replace text
    "(GLOBAL INTERNAL fib.task-key I32 (I32 0))" "(GLOBAL INTERNAL fib.task-key I64 (I64 0))")
    "(GLOBAL INTERNAL fib.exc-key I32 (I32 0))" "(GLOBAL INTERNAL fib.exc-key I64 (I64 0))")
    "(DECLARE pthread_setspecific I32 (I32 PTR))" "(DECLARE pthread_setspecific I32 (I64 PTR))")
    "(DECLARE pthread_getspecific PTR (I32))" "(DECLARE pthread_getspecific PTR (I64))")
    "(LOAD I32 (GLOBAL fib.task-key))" "(LOAD I64 (GLOBAL fib.task-key))")
    "(LOAD I32 (GLOBAL fib.exc-key))" "(LOAD I64 (GLOBAL fib.exc-key))"))
;; The pool (rt/sched.lir, rt/deque.lir) on Darwin: its pthread key is 8 bytes too, and there is no sched_getaffinity (the count falls back to sysconf).
;; The bounds of a thread's stack for the stack check (rt/thread.lir fib.stk-query) on Darwin: pthread_get_stackaddr_np is the top, pthread_get_stacksize_np the size,
;; and the key of fib.stk-key is 8 bytes like the others. Not run on a Mac in this package (written to the ABI: scripts/mac-check.sh).
(defun replace-between :private (text: str from: str to: str new: str) -> str
  (match (str-find text from 0)
    (nil text)
    ((some a) (match (str-find text to a)
                (nil text)
                ((some b) (str-concat (str-concat (str-slice text 0 a) new) (str-slice text (+ b (str-len to)) (str-len text))))))))
(defun darwin-stk :private (text: str) -> str
  (replace (replace (replace (replace-between (replace text
    "(GLOBAL INTERNAL fib.stk-key I32 (I32 0))" "(GLOBAL INTERNAL fib.stk-key I64 (I64 0))")
    ";; stk-query-begin\n" ";; stk-query-end\n"
    "(DECLARE pthread_get_stackaddr_np PTR (PTR))\n(DECLARE pthread_get_stacksize_np I64 (PTR))\n(DEFINE INTERNAL (fib.stk-query I1) ((PTR out))\n  (BLOCK entry\n    (LET ((t (INTTOPTR PTR (CALL (GLOBAL pthread_self))))\n          (top (PTRTOINT I64 (CALL (GLOBAL pthread_get_stackaddr_np) t)))\n          (sz (CALL (GLOBAL pthread_get_stacksize_np) t)))\n      (STORE (SUB top sz) out)\n      (STORE top (GETELEMENTPTR I64 out (I64 1)))\n      (RET (I1 1)))))\n")
    "(DECLARE pthread_getattr_np I32 (I64 PTR))\n" "")
    "(DECLARE pthread_attr_getstack I32 (PTR PTR PTR))\n" "")
    "(LOAD I32 (GLOBAL fib.stk-key))" "(LOAD I64 (GLOBAL fib.stk-key))"))
(defun darwin-sched :private (text: str) -> str
  (replace (replace (replace (replace (replace text
    "(GLOBAL INTERNAL fib.sched-key I32 (I32 0))" "(GLOBAL INTERNAL fib.sched-key I64 (I64 0))")
    "(GLOBAL INTERNAL fib.sched-spinners I32 (I32 1000000))" "(GLOBAL INTERNAL fib.sched-spinners I32 (I32 2))")
    "(LOAD I32 (GLOBAL fib.sched-key))" "(LOAD I64 (GLOBAL fib.sched-key))")
    "(DECLARE sched_getaffinity I32 (I32 I64 PTR))\n" "")
    "(rc (CALL (GLOBAL sched_getaffinity) (I32 0) (I64 128) mask))" "(rc (I32 1))"))
;; The stack guard of rt/thread.lir for Darwin: SIGBUS is 10 and SS_DISABLE 4; stack_t has ss_size before ss_flags; si_addr is at 24 in siginfo_t; struct sigaction has
;; a 4-byte mask and sa_flags at 12, SA_SIGINFO 0x40 | SA_ONSTACK 1 (docs/design/stack.md).
(defun darwin-guard :private (text: str) -> str
  (replace (replace (replace (replace (replace (replace (replace (replace text
    "(DECLARE prctl I32 (I32 PTR I64 I64 I64))\n" "")
    "    (CALL (GLOBAL prctl) (I32 15) (STRING \"fib-parked\") (I64 0) (I64 0) (I64 0))\n" "")
    "    (CALL (GLOBAL prctl) (I32 15) (STRING \"fib-main\") (I64 0) (I64 0) (I64 0))\n" "")
    "(GLOBAL INTERNAL fib.guard-sigbus I32 (I32 7))" "(GLOBAL INTERNAL fib.guard-sigbus I32 (I32 10))")
    "(GLOBAL INTERNAL fib.guard-ss-disable I32 (I32 2))" "(GLOBAL INTERNAL fib.guard-ss-disable I32 (I32 4))")
    "(STORE flags (GETELEMENTPTR I8 ss (I64 8)))\n    (STORE size (GETELEMENTPTR I8 ss (I64 16)))"
    "(STORE size (GETELEMENTPTR I8 ss (I64 8)))\n    (STORE flags (GETELEMENTPTR I8 ss (I64 16)))")
    "(GETELEMENTPTR I8 info (I64 16))" "(GETELEMENTPTR I8 info (I64 24))")
    "(STORE (I32 134217732) (GETELEMENTPTR I8 sa (I64 136)))" "(STORE (I32 65) (GETELEMENTPTR I8 sa (I64 12)))"))
;; Whether the code is for a musl Linux (a row of lir.targets whose libc is musl: `--static`, docs/design/static-linking.md). musl has no mallopt: its
;; allocator already gives every block of 128 KiB or more its own mapping (the threshold the large-block cache pins glibc's to), so the call is dropped. Its malloc
;; also maps a group of 32 KiB or more for every block from 2 KiB up and unmaps it at the free, so the cache's floor is 4 KiB there (docs/design/allocator.md, section 9).
(defun musl? :private () -> bool
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    (nil false)
    ((some t) (and (not (= t "")) (= (. (tt/target-row-of-triple t) libc) "musl")))))
(defun sys-for (platform: str text: str) -> str
  (if (= platform "Linux")
    (if (musl?)
      (replace (replace (replace text "(DECLARE mallopt I32 (I32 I32))\n" "") "(CALL (GLOBAL mallopt) (I32 -3) (I32 131072))" "(ADD (I32 0) (I32 0))")
               "(GLOBAL INTERNAL fib.lc-floor I64 (I64 131072))" "(GLOBAL INTERNAL fib.lc-floor I64 (I64 4096))")
      text)
    (if (= platform "Darwin")
      ;; _SC_NPROCESSORS_ONLN: 84 on glibc, 58 on Darwin (the pool's worker count);
      ;; the large-block cache (rt/alloc.lir): malloc_size for malloc_usable_size, CLOCK_MONOTONIC_RAW_APPROX (5) for
      ;; CLOCK_MONOTONIC_COARSE (6), and no mallopt (Darwin's malloc has none; its large blocks go back to the system on free)
      (darwin-sched (darwin-stk (darwin-guard (darwin-keys (replace (replace (replace (replace (replace (replace (replace (replace text "__errno_location" "__error")
        "(GLOBAL openat) (I32 -100)" "(GLOBAL openat) (I32 -2)") "(GLOBAL fib.sys-clock) (I32 1)" "(GLOBAL fib.sys-clock) (I32 6)")
        "(GLOBAL sysconf) (I32 84)" "(GLOBAL sysconf) (I32 58)")
        "malloc_usable_size" "malloc_size") "(GLOBAL clock_gettime) (I32 6)" "(GLOBAL clock_gettime) (I32 5)")
        "(DECLARE mallopt I32 (I32 I32))\n" "") "(CALL (GLOBAL mallopt) (I32 -3) (I32 131072))" "(ADD (I32 0) (I32 0))")))))
      (trap (str "fib.os: unsupported runtime platform " platform)))))
