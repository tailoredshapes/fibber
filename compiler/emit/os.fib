;; Adapt the frozen seed runtime at its boundary without changing the Rust seed.
(ns emit.os (:use fib.core fib.seq fib.coll))
(defun replace :private (text: str old: str new: str) -> str
  (loop [offset 0 parts: (Vec str) []]
    (match (str-find text old offset)
      (nil (str-join (conj parts (str-slice text offset (str-len text)))))
      ((some at) (recur (+ at (str-len old)) (conj (conj parts (str-slice text offset at)) new))))))
(defun sys-for (platform: str text: str) -> str
  (if (= platform "Linux") text
    (if (= platform "Darwin")
      (replace (replace (replace text "__errno_location" "__error")
        "@openat (i32 -100)" "@openat (i32 -2)") "@fib.sys-clock (i32 1)" "@fib.sys-clock (i32 6)")
      (trap (str "fib.os: unsupported runtime platform " platform)))))
