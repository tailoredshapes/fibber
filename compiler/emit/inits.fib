;; compiler/emit/inits.fib: the `def`s made at run time (syntax §3.19, types §2.16, L15, X8). Replaces crates/fibc/src/inits.rs
;; (159 lines of Rust; its header there is the description of the scheme). A `def` whose initialiser is a constant expression is
;; evaluated while compiling and emitted as static data (emit.defs.mod); any other is evaluated before `main`, once, by an init
;; function: `inits-plan` chooses those `def`s, gives each a slot (`def.slot.N`, a global of the module; `live.d.NAME` with its setter for
;; a `def` of the program's own in live mode, emit.livedef `live-def-slot`) and requests its body;
;; `inits-slot-text` is the globals and `inits-render` the init functions and `fib.defs-init`, which calls them in order, a
;; maximal run of `def`s of one module being one init function, `fib.init.mN.K`.
;; `all-def-ids` is the Rust `defs::all_def_ids` (defs/mod.rs:50): emit.defs.mod's `def-ids` (the constants) is E10's.
(ns emit.inits
  (:require [fib.string :as s] [emit.node :as n] [lir.ast :as la] [lir.types :as lt] [emit.function :as f] [lir.print :as print] [emit.livedef :as eld])
  (:use types.ty types.decls types.init types.program types.infer.mod own.program emit.value emit.program emit.names))

;; Every `def` of the program, in the order the checker typed them, which is the order they are evaluated in (syntax §3.19).
;; Rust: defs/mod.rs:50 all_def_ids
(defun all-def-ids (p: Program) -> (Vec i64)
  (vec (mapcat (fn (u: UnitRef) (match u ((UDef d) [d]) (_ []))) (. (. p typed) units))))

;; Plans one `def`: nothing for a constant, else its slot, its place among the inits and the name its body will have. The body is NOT requested here:
;; `inits-request` does that once the constants are made. A requested body is lowered by the first `emit-all` (the one `emit-def` runs for the first
;; constant), and a body that reads a constant `def` (`(def twice (* base 2))`) is lowered there before `base` has a value: "def base is read where it
;; has no value" (LANG-2 item 4; a `def` that calls a function that reads one fails the same way).
(defun plan-one :private (p: Program d: i64) -> (Result unit str)
  (let ((dd (g-def (program-g p) d)))
    (if (. dd constant)
        (Ok ())
        (match (get (. (. p typed) def-types) d)
          (nil (Err "a def without a type"))
          ((some t)
           (try-let ((lt (program-lir p t)))
             (match lt
               ((some (LirDyn)) (Err (str-join ["def " (. dd name) ": a def made at run time holds a dyn value"])))
               (_ (let ((body (body-name (program-g p) (BodyDef d) []))
                        (object (match lt ((some (LirPtr)) true) (_ false)))
                        (slot (unwrap-or (eld/live-def-slot p d lt) (str "def.slot." d))))
                    (do (set! (. p def-slots) (assoc @(. p def-slots) d (DefValue (some (n/global slot)) lt)))
                        (set! (. p inits) (conj @(. p inits) (Init d (. dd module) body object slot)))
                        (Ok ())))))))))))

;; Chooses the `def`s made at run time and gives each its slot. Runs before the constants are made, because a function a constant names may
;; read one of these `def`s (it loads the slot). Rust: inits.rs:57 plan
(defun inits-plan (p: Program) -> (Result unit str)
  (try-let ((_ (try-map (fn (d: i64) (plan-one p d)) (all-def-ids p))))
    (Ok ())))

;; Requests the bodies of the planned inits: after the constants are made, so that what a body reads of them has its value (see `plan-one`).
(defun inits-request (p: Program) -> unit
  (do (doseq [i @(. p inits)] (program-request p (BodyDef (. i def-id)) []))
      ()))

;; The zero a global of the type starts as. Rust: inits.rs:104 zero
(defun slot-zero :private (l: LirTy) -> la/LExpr (lir-zero-node l))

;; The globals of the slots: `(global internal def.slot.N T zero)`. Rust: inits.rs:92 slot_text
(defun inits-slot-text (p: Program) -> str (print/print-module (la/LModule (inits-slot-items p))))

;; The init function of one run of `def`s of a module. Rust: inits.rs:146 init_function
(defun init-body :private (p: Program run: (Vec Init)) -> (Vec la/LExpr)
  (loop ((k (- (count run) 1)) (tail [(n/ret nil)]))
    (if (< k 0) tail
        (let ((i (nth run k)) (value (str "v" k)))
          (let ((head (n/store (n/string (str "def " (. (g-def (program-g p) (. i def-id)) name) ": ")) (n/global "fib.initdef") nil)))
            (let ((next (match (get @(. p def-slots) (. i def-id))
                          ((some dv)
                           (match (. dv ty)
                             (nil (into [head (n/call (. i body) [])] tail))
                             ((some l) [head (f/bound [(f/binding value (n/call (. i body) []))]
                                             (into (if (. i object) [(n/call "fib.immortalise" [(n/local value)])] [])
                                                   (into [(slot-store (. i slot) l (n/local value) (unwrap (. dv expr)))] tail)))])))
                          (nil (into [head] tail)))))
              (recur (- k 1) next)))))))

;; The store of an initialiser's value into its slot: a boxed live slot (emit.livedef) through its setter, which makes the box.
(defun slot-store :private (slot: str l: LirTy v: la/LExpr at: la/LExpr) -> la/LExpr
  (if (and (s/starts-with? slot "live.") (not (eld/live-word? l))) (n/call (str slot ".set") [v]) (n/store v at nil)))

(defun init-function :private (p: Program name: str run: (Vec Init)) -> la/LFunction
  (f/make name nil [] lt/cc-c [(f/block "entry" (init-body p run))]))

;; The inits cut into maximal runs of one module.
(defun module-runs :private (inits: (Vec Init)) -> (Vec (Vec Init))
  (reduce (fn (acc: (Vec (Vec Init)) i: Init)
            (let ((at (- (count acc) 1)))
              (if (and (>= at 0) (= (. (nth (nth acc at) 0) module) (. i module)))
                  (assoc acc at (conj (nth acc at) i))
                  (conj acc [i]))))
          [] inits))

;; The init functions and `fib.defs-init`, or nothing if every `def` is a constant. Rust: inits.rs:118 render
(defun inits-render (p: Program) -> str (print/print-module (la/LModule (inits-items p))))


;; A live slot (`live.d.NAME`, LT4) comes with its setter (and, boxed, its drop; it starts null, the init's setter makes the box).
(defun inits-slot-items (p: Program) -> (Vec la/LItem)
  (vec (mapcat (fn (i: Init)
                 (match (get @(. p def-slots) (. i def-id))
                   ((some dv)
                    (match (. dv ty)
                      ((some ty) (if (s/starts-with? (. i slot) "live.")
                                     (into [(la/ItGlobal (la/LGlobalDef (. i slot) (eld/live-slot-type ty) (if (eld/live-word? ty) (slot-zero ty) (n/null)) false (la/LModifiers la/lk-internal false) 0 false))]
                                           (eld/live-def-items (. i slot) ty nil))
                                     [(la/ItGlobal (la/LGlobalDef (. i slot) (lir-type ty) (slot-zero ty) false (la/LModifiers la/lk-internal false) 0 false))]))
                      (nil [])))
                   (nil []))) @(. p inits))))

(defun inits-items (p: Program) -> (Vec la/LItem)
  (let ((runs (module-runs @(. p inits))))
    (if (empty? runs) []
        (let ((names (mapv (fn (k: i64) (str "fib.init.m" (. (nth (nth runs k) 0) module) "." k)) (range (count runs)))))
          (conj (mapv (fn (k: i64) (la/ItDefine (init-function p (nth names k) (nth runs k)))) (range (count runs)))
                (la/ItDefine (f/make "fib.defs-init" nil [] lt/cc-c
                                    [(f/block "entry" (into (mapv (fn (name: str) (n/call name [])) names)
                                                            [(n/call "fib.init-done" []) (n/ret nil)]))])))))))
