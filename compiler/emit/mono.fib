;; compiler/emit/mono.fib: monomorphisation: the instances of a program and the queue of work (spec/compiler.md §2, §4).
;; Replaces crates/fibc/src/mono.rs. The Rust `Queue` holds a `VecDeque`, a map from instance to name and the
;; overflow message; here the pending instances are a Vec with a head index (conj and pop are O(1)) and the names
;; a Map keyed by `Inst` (derived Hash, plan D6). The porter may re-key by (BodyKey, mangled types).
;; STATUS: every public function below is a STUB of package E2, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/mono.rs, 256 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.mono
  (:use types.ty types.scheme types.decls own.program emit.value))

;; An instance of a body at concrete types. Rust: mono.rs:20 Inst
(defstruct Inst (key: BodyKey tys: (Vec Ty)))
(derive Eq Inst) (derive Hash Inst)

;; How a type is represented, for the monomorphiser: a scalar of that lIR type, a plain object pointer, an
;; Option whose payload is a pointer (nullable), a boxed Option, a dyn, unit. Rust: mono.rs:34 Class
(defenum RepClass (ClsScalar ty: LirTy) ClsPtr ClsOpt ClsBoxed ClsDyn ClsUnit)
(derive Eq RepClass)

;; The limits of the overflow rule. Rust: mono.rs:125-126
(def max-type-depth: i64 64)
(def max-type-size: i64 1000)

;; The work not yet done, the names given, and the first overflow. Rust: mono.rs:161 Queue
(defstruct Queue (pending: (Cell (Vec Inst)) head: (Cell i64) names: (Cell (Map Inst str)) overflow: (Cell (Option str))))

(defun queue-new () -> Queue (Queue (cell []) (cell 0) (cell (map-empty)) (cell nil)))

;; Rust: mono.rs:27 Inst::subst
(defun inst-subst (inst: Inst t: Ty) -> Ty
  (trap "todo: E2 inst-subst"))

;; Rust: mono.rs:48
(defun class-of (g: Globals t: Ty) -> (Result RepClass str)
  (trap "todo: E2 class-of"))

;; Rust: mono.rs:65
(defun representative (g: Globals c: RepClass) -> Ty
  (trap "todo: E2 representative"))

;; Rust: mono.rs:86
(defun bounded (s: Scheme i: i64) -> bool
  (trap "todo: E2 bounded"))

;; Rust: mono.rs:105
(defun fun-key (g: Globals s: Scheme tys: (Vec Ty)) -> (Result (Vec Ty) str)
  (trap "todo: E2 fun-key"))

;; Rust: mono.rs:171 Queue::request
(defun queue-request (q: Queue g: Globals inst: Inst) -> str
  (trap "todo: E2 queue-request"))

;; Rust: mono.rs:190 Queue::pop
(defun queue-pop (q: Queue) -> (Option Inst)
  (trap "todo: E2 queue-pop"))

;; Rust: mono.rs:196 Queue::overflow
(defun queue-overflow (q: Queue) -> (Option str)
  (trap "todo: E2 queue-overflow"))
