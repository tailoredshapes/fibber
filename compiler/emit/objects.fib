;; compiler/emit/objects.fib: the table of object types: the struct of every type the program allocates, its type id (`tid`), its
;; layout and its type record (spec/types.md §8.2-§8.7). Replaces crates/fibc/src/objects.rs; the walkers of
;; objects/walk.rs (private `fn`s: `child_fields`, `array_walker`, `releases`, ..; 221 lines) belong to `objects-render`
;; and are E2's to write in emit/objects/walk.fib. The slots are the Rust constants as numbers.
;; The index of Rust's `HashMap<String, u32>` is a `(Map str i64)`: only looked up, never iterated.
;; STATUS: every public function below is a STUB of package E2, `(trap "todo: PACKAGE NAME")`,
;; with the Rust it replaces in the comment above it (crates/fibc/src/objects.rs, 407 lines of Rust).
;; A stub reached makes a tool exit 70 (pending, never a pass); its signature is final for the callers,
;; the data it names is the porter's to extend.
(ns emit.objects
  (:use types.ty types.decls emit.value))

;; The shape of a task frame slot. Rust: objects.rs:17 FrameSlot
(defenum FrameSlot (FrVal ty: LirTy) (FrBytes bytes: i64))
(derive Eq FrameSlot) (derive Hash FrameSlot)

;; What an object type is. Rust: objects.rs:40 ObjKind
(defenum ObjKind
  ObStr (ObArray elem: LirTy) (ObStruct fields: (Vec (Option LirTy)))
  (ObEnum variants: (Vec (Vec (Option LirTy)))) (ObCell ty: LirTy) (ObAtom ty: LirTy) ObWeak
  (ObClosure caps: (Vec LirTy)) (ObTask caps: (Vec LirTy) frame: (Vec FrameSlot)))
(derive Eq ObjKind) (derive Hash ObjKind)

;; One object type. Rust: objects.rs:77 ObjInfo
(defstruct ObjInfo (tid: i64 sname: str name: str kind: ObjKind))

;; The table, in interning order. Rust: objects.rs:171 Objects
(defstruct Objects (list: (Cell (Vec ObjInfo)) index: (Cell (Map str i64))))

(defun objects-new () -> Objects (Objects (cell []) (cell (map-empty))))

;; Slot numbers of the fields of every object kind (§8.2-§8.7). Rust: objects.rs:177-197
(def slot-struct-field0: i64 3) (def slot-enum-tag: i64 3) (def slot-variant-field0: i64 4)
(def slot-len: i64 3) (def slot-elems: i64 4) (def slot-cell-value: i64 3)
(def slot-atom-lock: i64 3) (def slot-atom-value: i64 4)
(def slot-task-state: i64 3) (def slot-task-result: i64 7) (def slot-task-waiters: i64 8)
(def slot-task-closure: i64 9) (def slot-task-resume: i64 6) (def slot-task-capture0: i64 10)
(def slot-closure-code: i64 3) (def slot-capture0: i64 4)

;; Rust: objects.rs:66 ObjInfo::class
(defun obj-class (o: ObjInfo) -> i64
  (trap "todo: E2 obj-class"))

;; Rust: objects.rs:89 ObjInfo::variant_sname
(defun obj-variant-sname (o: ObjInfo v: i64) -> str
  (trap "todo: E2 obj-variant-sname"))

;; Rust: objects.rs:125 ObjInfo::slots
(defun obj-slots (o: ObjInfo tag: (Option i64)) -> (Vec (Option LirTy))
  (trap "todo: E2 obj-slots"))

;; Rust: objects.rs:135 ObjInfo::offsets
(defun obj-offsets (o: ObjInfo tag: (Option i64)) -> (Vec i64)
  (trap "todo: E2 obj-offsets"))

;; Rust: objects.rs:152 ObjInfo::size
(defun obj-size (o: ObjInfo) -> i64
  (trap "todo: E2 obj-size"))

;; Rust: objects.rs:202 Objects::intern
(defun objects-intern (os: Objects sname: str name: str kind: ObjKind) -> i64
  (trap "todo: E2 objects-intern"))

;; Rust: objects.rs:217 Objects::get
(defun objects-get (os: Objects tid: i64) -> ObjInfo
  (trap "todo: E2 objects-get"))

;; Rust: objects.rs:222 Objects::set_task_frame
(defun objects-set-task-frame (os: Objects tid: i64 frame: (Vec FrameSlot)) -> unit
  (trap "todo: E2 objects-set-task-frame"))

;; Rust: objects.rs:228 Objects::len
(defun objects-len (os: Objects) -> i64
  (trap "todo: E2 objects-len"))

;; Rust: objects.rs:232 Objects::is_empty
(defun objects-is-empty (os: Objects) -> bool
  (trap "todo: E2 objects-is-empty"))

;; Rust: objects.rs:238 Objects::render
(defun objects-render (os: Objects) -> str
  (trap "todo: E2 objects-render"))
