;; compiler/emit/objects.fib: the table of object types: the struct of every type the program allocates, its type id (`tid`), its
;; layout and its type record (spec/types.md §8.2-§8.7). Replaces crates/fibc/src/objects.rs (315 lines of Rust before its tests).
;; The data (`FrameSlot`, `ObjKind`, `ObjInfo`) and the slot numbers are in emit.objects.kinds and exported from here again; the
;; walkers of objects/walk.rs (`child_fields`, `array_walker`, `releases`, ..) are emit.objects.walk, which `objects-render` calls
;; (a module cannot call its importer back, so the data had to be below both).
;; The index of Rust's `HashMap<String, u32>` is a `(Map str i64)`: only looked up, never iterated.
(ns emit.objects
  (:require [fib.string :as s] [emit.node :as n] [lir.ast :as la] [lir.types :as lt] [lir.print :as print])
  (:use types.ty types.decls emit.value emit.text emit.layout emit.objects.walk)
  (:export-from emit.objects.kinds))

;; The table, in interning order. Rust: objects.rs:171 Objects. `structs` and `walkers` hold the text rendered for a type id, so
;; that a module assembled again for every `def` of a program (emit.defs.jit) renders each type once; a task type's entry is dropped
;; when its frame is set, the one change an entry's type undergoes.
(defstruct Objects (list: (Cell (Vec ObjInfo)) index: (Cell (Map str i64)) structs: (Cell (Map i64 (Vec la/LItem))) walkers: (Cell (Map i64 (Vec la/LItem)))))

(defun objects-new () -> Objects (Objects (cell []) (cell (map-empty)) (cell (map-empty)) (cell (map-empty))))

;; The trace class letter (compiler.md §4) as its byte: `c`, `a` or `o`. Rust: objects.rs:66 ObjInfo::class
(defun obj-class (o: ObjInfo) -> i64
  (match (. o kind)
    ((ObCell _) 99)
    ((ObAtom _) 97)
    (_ 111)))

;; The kind of an object type for `freeze` (rt/atom.lir, fib.freeze-check): 0 for what a frozen graph may hold, 1 a cell, 2 an atom, 3 a weak
;; reference, 4 a task: the objects that are mutable in place or watch another; 5 a string or an array, of no fixed size (`private-copy` does not copy it).
(defun obj-kind (o: ObjInfo) -> i64
  (match (. o kind)
    ((ObCell _) 1)
    ((ObAtom _) 2)
    ((ObWeak) 3)
    ((ObTask _ _) 4)
    ((ObStr) 5)
    ((ObArray _) 5)
    (_ 0)))

(defun frame-text :private (f: FrameSlot) -> str
  (match f
    ((FrVal t) (lir-mem-text t))
    ((FrBytes n) (str-join ["[" (str n) " x i8]"]))))

(defun frame-size-align :private (pb: i64 f: FrameSlot) -> (Pair i64 i64)
  (match f
    ((FrVal t) (size-align-pb pb t))
    ((FrBytes n) (Pair n 8))))

(defun frame-vals :private (ts: (Vec LirTy)) -> (Vec FrameSlot)
  (mapv (fn (t: LirTy) (FrVal t)) ts))

;; The types of the declared fields that have a slot (a unit field has none).
(defun slot-tys :private (fs: (Vec (Option LirTy))) -> (Vec LirTy)
  (vec (keep (fn (f: (Option LirTy)) f) fs)))

;; The fields of the object struct (an enum's are its tag prefix; its variants are separate structs). Rust: objects.rs:100 fields
(defun obj-fields :private (o: ObjInfo) -> (Vec FrameSlot)
  (into (frame-vals (layout-header))
        (match (. o kind)
          ((ObStr) (frame-vals [LirI64]))
          ((ObArray _) (frame-vals [LirI64]))
          ((ObStruct fs) (frame-vals (slot-tys fs)))
          ((ObEnum _) (frame-vals [LirI32]))
          ((ObCell t) (frame-vals [t]))
          ((ObAtom t) (frame-vals [LirI32 t]))
          ((ObWeak) (frame-vals [LirI32 LirPtr LirPtr]))
          ((ObClosure caps) (frame-vals (into [LirPtr] caps)))
          ((ObTask caps frame)
           (into (frame-vals (into [LirI32 LirI32 LirI32 LirPtr LirPtr LirPtr LirPtr LirPtr] caps)) frame)))))

;; The lIR slot of each declared field of a struct, or of variant `tag` of an enum (`nil` for a unit field, which has no slot).
;; Rust: objects.rs:125 ObjInfo::slots
(defun obj-slots (o: ObjInfo tag: (Option i64)) -> (Vec (Option LirTy))
  (match (. o kind)
    ((ObStruct fs) fs)
    ((ObEnum vs) (match tag ((some i) (nth vs i)) (nil [])))
    (_ [])))

;; The fields of variant `tag` of an enum: the tag prefix, then the variant's slots.
(defun variant-fields :private (o: ObjInfo tag: (Option i64)) -> (Vec FrameSlot)
  (into (obj-fields o) (frame-vals (slot-tys (obj-slots o tag)))))

;; The byte offset of each user slot of a struct, or of variant `tag` of an enum, after the header (and the tag).
;; A struct's fields already hold its slots; an enum's hold the tag prefix, and the variant's slots follow.
;; Rust: objects.rs:135 ObjInfo::offsets
(defun obj-offsets (o: ObjInfo tag: (Option i64)) -> (Vec i64)
  (obj-offsets-pb o tag 8))

(defun obj-offsets-pb (o: ObjInfo tag: (Option i64) pb: i64) -> (Vec i64)
  (let ((fixed (match (. o kind) ((ObStruct _) (count (layout-header))) (_ (count (obj-fields o)))))
        (all (match (. o kind)
               ((ObEnum _) (variant-fields o tag))
               (_ (obj-fields o)))))
    (vec (drop fixed (field-offsets (mapv (fn (f: FrameSlot) (frame-size-align pb f)) all))))))

;; The size of a fixed-size object; an enum's is its largest variant's. Strings and arrays add their elements at run time.
;; Rust: objects.rs:152 ObjInfo::size
(defun obj-size (o: ObjInfo) -> i64
  (obj-size-pb o 8))

(defun obj-size-pb (o: ObjInfo pb: i64) -> i64
  (let ((of (fn (f: (Vec FrameSlot)) (struct-size-of (mapv (fn (s: FrameSlot) (frame-size-align pb s)) f)))))
    (match (. o kind)
      ((ObEnum vs) (reduce (fn (m: i64 i: i64) (max m (of (variant-fields o (some i))))) 0 (range (count vs))))
      (_ (of (obj-fields o))))))

;; The type id of the object type named `sname` of kind `kind`, registering it on first use. Rust: objects.rs:202 Objects::intern
(defun objects-intern (os: Objects sname: str name: str kind: ObjKind) -> i64
  (if-some [t (get @(. os index) sname)]
    t
    (let ((tid (count @(. os list))))
      (do (set! (. os list) (conj @(. os list) (ObjInfo tid sname name kind)))
          (set! (. os index) (assoc @(. os index) sname tid))
          tid))))

;; Rust: objects.rs:217 Objects::get
(defun objects-get (os: Objects tid: i64) -> ObjInfo
  (nth @(. os list) tid))

;; The frame of task type `tid`, known once its body is lowered. Rust: objects.rs:222 Objects::set_task_frame
(defun objects-set-task-frame (os: Objects tid: i64 frame: (Vec FrameSlot)) -> unit
  (let ((o (nth @(. os list) tid)))
    (match (. o kind)
      ((ObTask caps _)
       (do (set! (. os structs) (dissoc @(. os structs) tid))
           (set! (. os walkers) (dissoc @(. os walkers) tid))
           (set! (. os list) (assoc @(. os list) tid (ObjInfo (. o tid) (. o sname) (. o name) (ObTask caps frame))))))
      (_ ()))))

;; Rust: objects.rs:228 Objects::len
(defun objects-len (os: Objects) -> i64
  (count @(. os list)))

;; Rust: objects.rs:232 Objects::is_empty
(defun objects-is-empty (os: Objects) -> bool
  (empty? @(. os list)))

(defun frame-words :private (fs: (Vec FrameSlot)) -> str
  (s/join " " (mapv frame-text fs)))

;; The `defstruct` of an object, and of each variant of an enum. Rust: objects.rs:285 render_structs
(defun render-structs :private (o: ObjInfo) -> (Vec la/LItem)
  (let ((trailing (match (. o kind) ((ObStr) [(lt/TArray 0 lt/ty-i8)]) ((ObArray t) [(lt/TArray 0 (lir-mem-type t))]) (_ []))))
    (into [(la/ItStruct (la/LStructDef (. o sname) (into (mapv frame-type (obj-fields o)) trailing) 0 false))]
          (match (. o kind)
            ((ObEnum variants)
             (mapv (fn (i: i64) (la/ItStruct (la/LStructDef (obj-variant-sname o i) (mapv frame-type (variant-fields o (some i))) 0 false)))
                   (range (count variants))))
            (_ [])))))

;; The type table and the class table. Rust: objects.rs:317 render_tables
(defun render-tables :private (objects: (Vec ObjInfo) pb: i64) -> (Vec la/LItem)
  (let ((records (mapv (fn (o: ObjInfo)
                        (n/named-aggregate "fib.typerec" [(n/global (str "drop." (. o tid))) (n/global (str "trace." (. o tid)))
                                                         (n/string (. o name)) (n/integer lt/ty-i64 (obj-size-pb o pb))
                                                         (n/global (str "share." (. o tid)))])) objects))
        (types-ty (lt/TArray (count objects) (lt/TNamed "fib.typerec")))
        (bytes-ty (lt/TArray (count objects) lt/ty-i8)))
    [(table-constant "fib.types" types-ty records)
     (table-constant "fib.classes" bytes-ty (mapv (fn (o: ObjInfo) (n/integer lt/ty-i8 (obj-class o))) objects))
     (table-constant "fib.kinds" bytes-ty (mapv (fn (o: ObjInfo) (n/integer lt/ty-i8 (obj-kind o))) objects))]))

;; The text of the `defstruct`s of `o`, and of its three walkers, kept in `os` once rendered.
(defun struct-text :private (os: Objects o: ObjInfo) -> (Vec la/LItem)
  (if-some [items (get @(. os structs) (. o tid))]
    items
    (let ((items (render-structs o)))
      (do (set! (. os structs) (assoc @(. os structs) (. o tid) items)) items))))

(defun walker-text :private (os: Objects o: ObjInfo) -> (Vec la/LItem)
  (if-some [items (get @(. os walkers) (. o tid))]
    items
    (let ((items (mapv (fn (what: str) (la/ItDefine (walker o what))) ["drop" "trace" "share"])))
      (do (set! (. os walkers) (assoc @(. os walkers) (. o tid) items)) items))))

;; Every `defstruct`, `drop`, `trace` and `share` function, and the type and class tables, as the pieces `objects-render` joins: the pieces
;; of an object are the same text every time (`struct-text`, `walker-text`), which the in-memory hand-over parses once (emit.defs.astmod).
;; Rust: objects.rs:238 Objects::render
(defun objects-render-pieces (os: Objects) -> (Vec str)
  (objects-render-pieces-pb os 8))

(defun objects-render-pieces-pb (os: Objects pb: i64) -> (Vec str)
  (mapv (fn (item: la/LItem) (print/print-module (la/LModule [item]))) (objects-items-pb os pb)))

(defun objects-render (os: Objects) -> str
  (str-join (objects-render-pieces os)))

(defun objects-render-pb (os: Objects pb: i64) -> str
  (str-join (objects-render-pieces-pb os pb)))


(defun frame-type :private (slot: FrameSlot) -> lt/LType
  (match slot ((FrVal ty) (lir-mem-type ty)) ((FrBytes count) (lt/TArray count lt/ty-i8))))

(defun table-constant :private (name: str ty: lt/LType values: (Vec la/LExpr)) -> la/LItem
  (la/ItGlobal (la/LGlobalDef name ty (n/array-value ty values) true (la/LModifiers la/lk-internal false false false false false) 0 false)))

(defun objects-items-pb (os: Objects pb: i64) -> (Vec la/LItem)
  (let ((objects @(. os list)))
    (into (into (vec (mapcat (fn (o: ObjInfo) (struct-text os o)) objects))
                (vec (mapcat (fn (o: ObjInfo) (walker-text os o)) objects)))
          (render-tables objects pb))))
