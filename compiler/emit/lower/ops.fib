;; compiler/emit/lower/ops.fib: ownership operations: `retain`, `release`, the sites of the plan (spec/compiler.md §4.2).
;; Replaces crates/fibc/src/lower/ops.rs (94 lines of Rust). `value-sites` (ops.rs:14) is in emit.lower.cx, where the context is
;; built: a constructor cannot call a module above it.
(ns emit.lower.ops
  (:use types.ty types.ast types.init own.program emit.value emit.ir emit.program emit.objects emit.lower.cx))

;; The value a site names; `nil` for a `def` (immortal: every operation on it is a no-op). Rust: lower/ops.rs:33 Cx::site
(defun lcx-site (cx: LowerCx s: Site) -> (Result (Option V) str)
  (match s
    ((SiteBind b) (try-let ((v (lcx-local cx b))) (Ok (some v))))
    ((SiteCapture _ b) (try-let ((v (lcx-local cx b))) (Ok (some v))))
    ((SiteValue e)
     (match (get @(. cx values) e)
       ((some v) (Ok (some v)))
       (nil (Err (str-join ["the plan names value " (str e) ", which has no value here"])))))
    ((SiteEnv _) (Ok @(. cx env)))
    ((SiteGlobal _) (Ok nil))))

;; The operations after expression `e`. Rust: lower/ops.rs:47 Cx::after
(defun lcx-after (cx: LowerCx e: i64) -> (Result unit str)
  (match (get (. (. cx own) exprs) e)
    ((some x) (if (empty? (. x after)) (Ok ()) (lcx-run-ops cx (. x after))))
    (nil (Ok ()))))

;; Rust: lower/ops.rs:55 Cx::run_ops
(defun lcx-run-ops (cx: LowerCx ops: (Vec Op)) -> (Result unit str)
  (try-each (fn (op: Op)
              (try-let ((site (lcx-site cx (. op site))))
                (match site
                  (nil (Ok ()))
                  ((some v) (match (. op kind)
                              ((OpRetain) (Ok (lcx-retain cx v)))
                              ((OpRelease) (Ok (lcx-release cx v)))
                              ((OpEndStack) (end-stack cx v (site-ty cx (. op site)))))))))
            ops))

;; Rust: lower/ops.rs:69 Cx::retain
(defun lcx-retain (cx: LowerCx v: V) -> unit
  (when-some (w (lcx-obj-word cx v))
    (fb-stmt (. cx b) (str-join ["(call @fib.retain " w ")"]))))

;; `PsSteal` of the value `v` of the pattern variable `b` (own.program): when the shell it was read from is unique at run time, `v` moves out
;; of the shell (its slot is nulled) and keeps its count; else it is retained as `PsRetain` does. A variable without an origin, or a value that is
;; not a plain pointer, is retained.
(defun lcx-steal (cx: LowerCx b: i64 v: V) -> unit
  (match (get @(. cx origins) b)
    (nil (lcx-retain cx v))
    ((some o)
     (match (Pair v (. o shell))
       ((Pair (VVal _ (LirPtr)) (VVal sh (LirPtr)))
        (let ((f (. cx b)))
          (let ((unique (fb-val f (str-join ["(call @fib.unique? " sh ")"]) LirI1))
                (ls (fb-label f "steal")) (lk (fb-label f "keep")) (lj (fb-label f "stolen")))
            (do (fb-term f (str-join ["(br " (v-text unique) " " ls " " lk ")"]))
                (fb-open f ls)
                (fb-stmt f (str-join ["(store (ptr null) " (lcx-gep cx (. o sname) sh (. o slot)) ")"]))
                (fb-term f (str-join ["(br " lj ")"]))
                (fb-open f lk)
                (lcx-retain cx v)
                (fb-term f (str-join ["(br " lj ")"]))
                (fb-open f lj)))))
       (_ (lcx-retain cx v))))))

;; The steal of the argument expression `x`, a read of a pattern variable.
(defun lcx-steal-of (cx: LowerCx x: Expr v: V) -> unit
  (match (. x kind)
    ((ELocal b) (lcx-steal cx b v))
    (_ (lcx-retain cx v))))

;; Rust: lower/ops.rs:75 Cx::release
(defun lcx-release (cx: LowerCx v: V) -> unit
  (when-some (w (lcx-obj-word cx v))
    (fb-stmt (. cx b) (str-join ["(call @fib.release " w ")"]))))

;; The type of the value a site names, when the plan says (a binding or an expression); `nil` for the others.
(defun site-ty :private (cx: LowerCx s: Site) -> (Option Ty)
  (match s
    ((SiteBind b) (match (lcx-binding-ty cx b) ((Ok t) (some t)) ((Err _) nil)))
    ((SiteValue e) (match (program-ty-of (. cx p) (. cx inst) e) ((Ok t) (some t)) ((Err _) nil)))
    (_ nil)))

;; The inline drop of a stack cell `w` of type `t`: the release of its one counted slot, which is what `drop.N` queues, without the
;; worklist and the indirect call of `fib.drop-fields` (the cell idiom of the library makes one per update). A cell of a scalar or of
;; unit holds nothing to release. Gives false when `t` is not a cell: the caller drops through the type record.
(defun end-cell :private (cx: LowerCx w: str t: Ty) -> (Result bool str)
  (match t
    ((TCon (KCell) args)
     (try-let ((o (program-object (. cx p) t)) (l (program-lir (. cx p) (nth args 0))))
       (match l
         ((some lt)
          (do (when (or (= lt LirPtr) (= lt LirDyn))
                (lcx-release cx (lcx-load cx lt (lcx-gep cx (. o snd) w slot-cell-value))))
              (Ok true)))
         (nil (Ok true)))))
    (_ (Ok false))))

;; The end of a stack object's scope (§6.11): its inline drop; a stack closure holds only aliases, so there is nothing to release.
;; Rust: lower/ops.rs:84 Cx::end_stack
(defun end-stack :private (cx: LowerCx v: V ty: (Option Ty)) -> (Result unit str)
  (match (lcx-obj-word cx v)
    (nil (Err "the plan ends a scalar as a stack object"))
    ((some w)
     (do (fb-stmt (. cx b) (str-join ["(call @fib.stack-end " w ")"]))
         (if (contains? @(. cx closure-slots) w)
             (Ok ())
             (try-let ((done (match ty (nil (Ok false)) ((some t) (end-cell cx w t)))))
               (do (when (not done) (fb-stmt (. cx b) (str-join ["(call @fib.drop-fields " w ")"])))
                   (Ok ()))))))))
