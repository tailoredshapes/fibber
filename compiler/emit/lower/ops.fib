;; compiler/emit/lower/ops.fib: ownership operations: `retain`, `release`, the sites of the plan (spec/compiler.md §4.2).
;; Replaces crates/fibc/src/lower/ops.rs (94 lines of Rust). `value-sites` (ops.rs:14) is in emit.lower.cx, where the context is
;; built: a constructor cannot call a module above it.
(ns emit.lower.ops
  (:use types.ty types.ast types.init own.program emit.value emit.ir emit.program emit.lower.cx))

;; The value a site names; `nil` for a `def` (immortal: every operation on it is a no-op). Rust: lower/ops.rs:33 Cx::site
(defun lcx-site (cx: LowerCx s: Site) -> (Result (Option V) str)
  (match s
    ((SiteBind b) (try-let ((v (lcx-local cx b))) (Ok (some v))))
    ((SiteCapture _ b) (try-let ((v (lcx-local cx b))) (Ok (some v))))
    ((SiteValue e)
     (match (get @(. cx values) e)
       ((some v) (Ok (some v)))
       (nil (Err (str-join ["the plan names value " (str e) ", which has no value here"])))))
    ((SiteEnv _) (Ok @(. cx env)))
    ((SiteGlobal _) (Ok nil))))

;; The operations after expression `e`. Rust: lower/ops.rs:47 Cx::after
(defun lcx-after (cx: LowerCx e: i64) -> (Result unit str)
  (match (get (. (. cx own) exprs) e)
    ((some x) (if (empty? (. x after)) (Ok ()) (lcx-run-ops cx (. x after))))
    (nil (Ok ()))))

;; Rust: lower/ops.rs:55 Cx::run_ops
(defun lcx-run-ops (cx: LowerCx ops: (Vec Op)) -> (Result unit str)
  (try-each (fn (op: Op)
              (try-let ((site (lcx-site cx (. op site))))
                (match site
                  (nil (Ok ()))
                  ((some v) (match (. op kind)
                              ((OpRetain) (Ok (lcx-retain cx v)))
                              ((OpRelease) (Ok (lcx-release cx v)))
                              ((OpEndStack) (end-stack cx v)))))))
            ops))

;; Rust: lower/ops.rs:69 Cx::retain
(defun lcx-retain (cx: LowerCx v: V) -> unit
  (when-some (w (lcx-obj-word cx v))
    (fb-stmt (. cx b) (str-join ["(call @fib.retain " w ")"]))))

;; Rust: lower/ops.rs:75 Cx::release
(defun lcx-release (cx: LowerCx v: V) -> unit
  (when-some (w (lcx-obj-word cx v))
    (fb-stmt (. cx b) (str-join ["(call @fib.release " w ")"]))))

;; The end of a stack object's scope (§6.11): its inline drop; a stack closure holds only aliases, so there is nothing to release.
;; Rust: lower/ops.rs:84 Cx::end_stack
(defun end-stack :private (cx: LowerCx v: V) -> (Result unit str)
  (match (lcx-obj-word cx v)
    (nil (Err "the plan ends a scalar as a stack object"))
    ((some w)
     (do (fb-stmt (. cx b) (str-join ["(call @fib.stack-end " w ")"]))
         (when (not (contains? @(. cx closure-slots) w))
           (fb-stmt (. cx b) (str-join ["(call @fib.drop-fields " w ")"])))
         (Ok ())))))
