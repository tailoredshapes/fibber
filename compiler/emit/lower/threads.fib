;; compiler/emit/lower/threads.fib: async and threads: spawn, `async` bodies, await, join. Replaces crates/fibc/src/lower/threads.rs (368 lines
;; of Rust); `AsyncFrame` is in emit.lower.cx. `await_task` replaces the frame's record in its Cell (`states` is a plain Vec); the
;; frame's state machine is built by emit.resume, called from emit.lower.mod's `emit-async`, which also calls `lcx-complete-helper`.
;; The text of every instruction is the Rust's, byte for byte (the completion functions are written out as the Rust writes them).
(ns emit.lower.threads
  (:use types.ty types.ast types.init own.program emit.value emit.names emit.ir emit.objects emit.program emit.lower.cx emit.lower.ops
        emit.lower.objects)
  (:require [emit.node :as nx]) (:use emit.lower.threads.helpers) (:export-from emit.lower.threads.helpers) (:require [lir.ast :as la] [lir.types :as lt]))

;; The result type `a` of a `(Task a)`, or the error `what`.
(defun task-arg :private (t: Ty what: str) -> (Result Ty str)
  (match t
    ((TCon (KTask) args) (Ok (nth args 0)))
    (_ (Err what))))

;; The zero of a result slot: a null pointer, a zeroed `dyn`, `0.0` or `0`.
(defun zero-text :private (l: LirTy) -> la/LExpr (lir-zero-node l))

;; `(store v field-i-of-p)`: the field's address first (it takes a name), then the store.
(defun store-at :private (cx: LowerCx sname: str p: la/LExpr i: i64 v: la/LExpr) -> unit
  (let ((q (lcx-gep cx sname p i)))
    (fb-stmt (. cx b) (nx/store v q nil))))

;; `(call @fib.alloc size (i32 tid))`
(defun alloc-text :private (size: la/LExpr tid: i64) -> la/LExpr
  (nx/call "fib.alloc" [size (nx/integer lt/ty-i32 tid)]))

;; The `(i64 size)` text of an object type's fixed size.
(defun size-text :private (cx: LowerCx tid: i64) -> la/LExpr
  (nx/integer lt/ty-i64 (obj-size-pb (objects-get (. (. cx p) objects) tid) (program-pb (. cx p)))))

;; A fresh result atom of `result-ty`, its lock and slot zeroed. Rust: lower/threads.rs:97 LowerCx::result_atom
(defun result-atom :private (cx: LowerCx result-ty: Ty) -> (Result V str)
  (try-let ((obj (program-object (. cx p) (TCon KAtom [result-ty]))))
    (let ((atid (. obj fst))
          (asname (. obj snd))
          (atom (fb-val (. cx b) (alloc-text (size-text cx atid) atid) LirPtr)))
      (do (store-at cx asname (v-expr atom) slot-atom-lock (nx/integer lt/ty-i32 0))
          (let ((vp (lcx-gep cx asname (v-expr atom) slot-atom-value)))
            (try-let ((l (program-lir (. cx p) result-ty)))
              (do (when-some (t l) (fb-stmt (. cx b) (nx/store (lir-zero-node t) vp (lir-align t))))
                  (Ok atom))))))))

;; The fields of a task that `spawn` fills: running, its driver held by the thread, no resume function, no waiters, the result
;; atom and the closure.
(defun init-spawned :private (cx: LowerCx tsname: str task: V atom: V f: V) -> unit
  (let ((t (v-expr task)))
    (do (doseq [k (range 3)]
          (store-at cx tsname t (+ slot-task-state k) (nx/integer lt/ty-i32 (if (< k 2) 1 0))))
        (doseq [i [(+ slot-task-state 3) (+ slot-task-result 1) slot-task-failure]]
          (store-at cx tsname t i (nx/null)))
        (lcx-store cx atom (lcx-gep cx tsname t slot-task-result))
        (lcx-store cx f (lcx-gep cx tsname t slot-task-closure)))))

;; `(spawn f)`: the task handle. Share-marks the closure, makes the result atom and the task (count 2: the handle and the thread),
;; and hands both to a new OS thread whose entry calls the closure, publishes the result and releases the task. Rust: lower/threads.rs:33
(defun lcx-spawn (cx: LowerCx e: Expr f: V) -> (Result V str)
  (try-let ((task-ty (lcx-ty cx e)) (result-ty (task-arg task-ty "spawn without a Task type")))
    (do (fb-stmt (. cx b) (nx/call "fib.share" [(v-expr f)]))
        (try-let ((atom (result-atom cx result-ty)) (obj (program-object (. cx p) task-ty)))
          (let ((ttid (. obj fst))
                (tsname (. obj snd))
                (task (fb-val (. cx b) (alloc-text (size-text cx ttid) ttid) LirPtr)))
            (do (fb-stmt (. cx b) (nx/call "fib.retain" [(v-expr task)]))
                (init-spawned cx tsname task atom f)
                ;; The task and its result atom cross to the new thread: SHARED before the handoff (§8.8).
                (fb-stmt (. cx b) (nx/call "fib.share" [(v-expr task)]))
                (try-let ((entry (thread-entry cx result-ty tsname)))
                  (do (fb-stmt (. cx b) (nx/call "fib.spawn" [(v-expr task) (nx/global entry)]))
                      (Ok task)))))))))

;; The fields of a task that `fork-task` fills: pending, its driver free, the pool runner as its resume function, no waiters, the
;; result atom and the closure (a closure and a resume function together are what makes it a pool task: rt/sched.lir).
(defun init-forked :private (cx: LowerCx tsname: str task: V atom: V f: V entry: str) -> unit
  (let ((t (v-expr task)))
    (do (doseq [k (range 3)] (store-at cx tsname t (+ slot-task-state k) (nx/integer lt/ty-i32 0)))
        (store-at cx tsname t slot-task-resume (nx/global entry))
        (doseq [i [slot-task-waiters slot-task-failure]] (store-at cx tsname t i (nx/null)))
        (lcx-store cx atom (lcx-gep cx tsname t slot-task-result))
        (lcx-store cx f (lcx-gep cx tsname t slot-task-closure)))))

;; `(fork-task f)`: a task of the work-stealing pool (docs/design/parallelism.md 3.1, rt/sched.lir). Share-marks the closure, makes the
;; result atom and the task (count 1: the handle; the pool takes its own), and hands it to fib.sched-fork: this worker's deque, or the
;; injector. `join` (fib.drive) runs it inline when nobody stole it.
(defun lcx-fork-task (cx: LowerCx e: Expr f: V) -> (Result V str)
  (try-let ((task-ty (lcx-ty cx e)) (result-ty (task-arg task-ty "fork-task without a Task type")))
    (do (fb-stmt (. cx b) (nx/call "fib.share" [(v-expr f)]))
        (try-let ((atom (result-atom cx result-ty)) (obj (program-object (. cx p) task-ty)) (entry (pool-entry cx result-ty)))
          (let ((ttid (. obj fst))
                (tsname (. obj snd))
                (task (fb-val (. cx b) (alloc-text (size-text cx ttid) ttid) LirPtr)))
            (do (init-forked cx tsname task atom f entry)
                (fb-stmt (. cx b) (nx/call "fib.share" [(v-expr task)]))
                ;; In a program that catches the runner isolates a trap on any thread: the pool is told, so a joiner that is not a
                ;; worker may run the task itself (rt/sched.lir, fib.sched-join).
                (when (and (. (. cx p) unwinding) (not @(. (. cx p) macro-module)))
                  (fb-stmt (. cx b) (nx/node (la/KAtomicStore la/sc-system la/OMonotonic
                                                               (nx/integer lt/ty-i32 1) (nx/global "fib.sched-catching")))))
                (fb-stmt (. cx b) (nx/call "fib.sched-fork" [(v-expr task)]))
                (Ok task)))))))

;; The captures of an `async` literal as values, each retained when the plan says so.
(defun capture-values :private (cx: LowerCx own: ClosureOwn) -> (Result (Vec V) str)
  (try-map (fn (c: CaptureOwn)
             (try-let ((v (lcx-local cx (. c binding))))
               (do (when (= (. c pass) PsRetain) (lcx-retain cx v))
                   (Ok v))))
           (. own captures)))

;; `(async body)`: a pending task holding the body's captures (retained), its resume point 0 and its resume function, the body's
;; state machine (emit.resume); run when joined or awaited (syntax §3.12, types §8.8). Rust: lower/threads.rs:124
(defun lcx-make-async (cx: LowerCx e: Expr) -> (Result V str)
  (match (get (. (. cx own) closures) (. e id))
    (nil (Err "no plan for an async literal"))
    ((some own)
     (try-let ((task-ty (lcx-ty cx e)) (result-ty (task-arg task-ty "async without a Task type"))
               (caps (lcx-capture-tys cx own)))
       (let ((code (program-request-closure (. cx p) (. cx inst) (. cx name) (. e id)))
             (obj (program-task-object (. cx p) code caps))
             (ttid (. obj fst))
             (tsname (. obj snd)))
         (try-let ((vals (capture-values cx own)) (atom (result-atom cx result-ty)))
           ;; The frame's size is the type table's: the body's slots are known only once it is lowered.
           (let ((task (fb-val (. cx b) (alloc-text (nx/call "fib.size-of" [(nx/integer lt/ty-i32 ttid)]) ttid) LirPtr))
                 (t (v-expr task)))
             (do (doseq [k (range 3)] (store-at cx tsname t (+ slot-task-state k) (nx/integer lt/ty-i32 0)))
                 (doseq [i [(+ slot-task-result 1) slot-task-closure slot-task-failure]] (store-at cx tsname t i (nx/null)))
                 (lcx-store cx atom (lcx-gep cx tsname t slot-task-result))
                 (store-at cx tsname t slot-task-resume (nx/global code))
                 (lcx-store-fields cx tsname t slot-task-capture0 vals)
                 (store-at cx tsname t (+ slot-task-capture0 (count caps)) (nx/integer lt/ty-i32 0))
                 (Ok task)))))))))

;; `(await e)` in an `async` body (§8.8): the next state's point is stored, then `fib.await-or-park` either finds `e` done or
;; registers this task as its waiter, in which case the resume returns here and continues, in a later resume, at the state's block,
;; where `e`'s result is read. Rust: lower/threads.rs:184
(defun lcx-await-task (cx: LowerCx x: Expr) -> (Result V str)
  (try-let ((t (lcx-value cx x)) (tt (lcx-ty cx x)) (result-ty (task-arg tt "await of a non-task")))
    (match @(. cx async-frame)
      (nil (Err "await outside an async body"))
      ((some frame)
       (let ((b (. cx b))
             (pp (lcx-gep cx (. frame tsname) (nx/local "env") (. frame point))))
         (do (fb-stmt b (nx/store (nx/integer lt/ty-i32 (+ (count (. frame states)) 1)) pp nil))
             (let ((parked (fb-val b (nx/call "fib.await-or-park" [(nx/local "env") (v-expr t)]) LirI1))
                   (lpark (fb-label b "park"))
                   (lcont (fb-label b "resume")))
               (do (fb-term b (nx/conditional (v-expr parked) lpark lcont))
                   (fb-open b lpark)
                   (fb-term b (nx/ret nil))
                   (fb-open b lcont)
                   (set! (. cx async-frame) (some (AsyncFrame (. frame tsname) (. frame point) (conj (. frame states) lcont))))
                   (task-value cx t result-ty)))))))))

;; `(task-failure t)`: drives the executor until the task is done, then the message it failed with, or nil when it did not fail. The
;; Option of a str is the str or null; the count passes to the caller. Unlike `join`, it never traps for the task's failure.
(defun lcx-task-failure (cx: LowerCx t: V) -> (Result V str)
  (do (fb-stmt (. cx b) (nx/call "fib.drive" [(v-expr t)]))
      (let ((v (fb-val (. cx b) (nx/call "fib.task-failure" [(v-expr t)]) LirPtr)))
        (do (lcx-retain cx v)
            (Ok v)))))

;; `(join t)`: drives the executor until the task is done (§8.8), then its result, retained. Rust: lower/threads.rs:214
(defun lcx-join (cx: LowerCx e: Expr t: V) -> (Result V str)
  (try-let ((result-ty (lcx-ty cx e)))
    (lcx-join-value cx t result-ty)))

;; `(join t)` of a task whose result has type `result-ty`; also `@t` (types §2.9, the `Deref` instance of `(Task a)`).
;; Rust: lower/threads.rs:221
(defun lcx-join-value (cx: LowerCx t: V result-ty: Ty) -> (Result V str)
  (do (fb-stmt (. cx b) (nx/call "fib.drive" [(v-expr t)]))
      (task-value cx t result-ty)))

;; The result of a task that is done, retained (under its atom's lock, as any atom read). A task that failed (a trap on its thread,
;; docs/design/exceptions.md 4.1) has no result: reading it traps in the reader with the task's own message. Rust: lower/threads.rs:228
;; Where a trap is caught (docs/design/exceptions.md 4.2), the joiner's trap unwinds to its `try` like any other.
(defun task-value :private (cx: LowerCx t: V result-ty: Ty) -> (Result V str)
  (do (if (lcx-catchable? cx)
          (let ((b (. cx b)) (lf (fb-label (. cx b) "failed")) (lk (fb-label (. cx b) "succeeded"))
                (msg (fb-val (. cx b) (nx/call "fib.task-failure" [(v-expr t)]) LirPtr)))
            (do (fb-term b (nx/conditional (nx/compare-int la/INe (v-expr msg) (nx/null)) lf lk))
                (fb-open b lf)
                (lcx-fail cx (nx/call "fib.trap" [(v-expr msg)]) (nx/call "fib.raise" [(v-expr msg)]))
                (fb-open b lk)))
          (fb-stmt (. cx b) (nx/call "fib.raise-failed" [(v-expr t)])))
      (task-result-value cx t result-ty)))

(defun task-result-value :private (cx: LowerCx t: V result-ty: Ty) -> (Result V str)
  (try-let ((aobj (program-object (. cx p) (TCon KAtom [result-ty])))
            (tobj (program-object (. cx p) (TCon KTask [result-ty]))))
    (let ((rp (lcx-gep cx (. tobj snd) (v-expr t) slot-task-result))
          (atom (lcx-load cx LirPtr rp))
          (vp (lcx-gep cx (. aobj snd) (v-expr atom) slot-atom-value)))
      (try-let ((l (program-lir (. cx p) result-ty)))
        (let ((v (match l ((some lt) (lcx-load cx lt vp)) (nil VUnit))))
          (do (lcx-retain cx v)
              (Ok v)))))))
