;; compiler/emit/lower/arith.fib: arithmetic: native methods of the scalar protocols, conversions, overflow traps.
;; Replaces crates/fibc/src/lower/arith.rs (277 lines of Rust): the native instances of `Num`, `Eq`, `Ord` and `Bits` on scalars and
;; strings, with every check types §8.12 requires, and the conversion primitives. The order of the instructions is the Rust's: a fresh
;; name asked for earlier shifts every later one of the function. Where the Rust has `"a" | "b" =>` arms this is `case`.
(ns emit.lower.arith
  (:use types.ty types.ast emit.value emit.ir emit.program emit.layout emit.lower.cx emit.lower.cells emit.lower.show))

(defun arith-some :private (r: (Result V str)) -> (Result (Option V) str)
  (match r ((Ok v) (Ok (some v))) ((Err e) (Err e))))

(defun in? :private (m: str xs: (Vec str)) -> bool
  (some? (first (filter (fn (x: str) (= x m)) xs))))

(defun arith-val :private (cx: LowerCx instr: str t: LirTy) -> V
  (fb-val (. cx b) instr t))

;; The most negative integer of the width `t`.
(defun int-min :private (t: LirTy) -> i64
  (shl -1 (- (lir-ty-bits t) 1)))

;; The `icmp` predicate of a comparison method, unsigned for an `i1`. Rust: arith.rs:262 compare_pred
(defun compare-pred :private (method: str unsigned: bool) -> (Result str str)
  (cond (= method "=") (Ok "eq")
        (= method "!=") (Ok "ne")
        (= method "<") (Ok (if unsigned "ult" "slt"))
        (= method "<=") (Ok (if unsigned "ule" "sle"))
        (= method ">") (Ok (if unsigned "ugt" "sgt"))
        (= method ">=") (Ok (if unsigned "uge" "sge"))
        :else (Err (str-join ["native method " method]))))

;; A comparison of two units: `unit` has one value, so it equals itself and is neither below nor above it (types §2.12).
;; Rust: arith.rs:250 unit_compare
(defun unit-compare :private (method: str) -> (Result V str)
  (cond (in? method ["=" "<=" ">="]) (Ok (v-int LirI1 1))
        (in? method ["!=" "<" ">"]) (Ok (v-int LirI1 0))
        :else (Err (str-join [method " on unit"]))))

;; Traps with `msg` when `c` holds; continues in a fresh block. Rust: arith.rs:200 LowerCx::trap_if
(defun lcx-trap-if (cx: LowerCx c: V msg: str) -> unit
  (let ((lt (fb-label (. cx b) "trap")) (lk (fb-label (. cx b) "ok")))
    (do (fb-term (. cx b) (str-join ["(br " (v-text c) " " lt " " lk ")"]))
        (fb-open (. cx b) lt)
        (lcx-trap-c cx msg)
        (fb-open (. cx b) lk))))

;; `<` and its fellows on strings: the comparison of `fib.str-cmp` with zero.
(defun str-compare :private (cx: LowerCx method: str x: V y: (Option V)) -> (Result V str)
  (match y
    (nil (Err "a string comparison without its second operand"))
    ((some y)
     (let ((c (arith-val cx (str-join ["(call @fib.str-cmp " (v-text x) " " (v-text y) ")"]) LirI32)))
       (try-let ((pred (compare-pred method false)))
         (Ok (arith-val cx (str-join ["(icmp " pred " " (v-text c) " (i32 0))"]) LirI1)))))))

;; ---- floats

;; `fdiv`, the method of `Float`, is the division the `Div` instances of the float types wrap; `quot` is that quotient rounded toward
;; zero by the C library's `trunc` or `truncf` (lIR has no float truncation, and the formula `(a - (rem a b)) / b` differs from
;; `(a / b).trunc()`: 2.9999999999999996 for 9.6 and 2.8, where the truncated quotient is 3.0). Rust: arith.rs:77 float_binary
(defun float-binary :private (cx: LowerCx method: str x: V y: V) -> V
  (let ((t (unwrap-or (v-ty x) LirDouble)) (a (v-text x)) (b (v-text y)))
    (let ((op (fn (name: str) (arith-val cx (str-join ["(" name " " a " " b ")"]) t)))
          (cmp (fn (pred: str) (arith-val cx (str-join ["(fcmp " pred " " a " " b ")"]) LirI1))))
      (cond (= method "+") (op "fadd")
            (= method "-") (op "fsub")
            (= method "*") (op "fmul")
            (= method "fdiv") (op "fdiv")
            (= method "quot") (let ((q (op "fdiv")))
                                (arith-val cx (str-join ["(call @" (if (= t LirFloat) "truncf" "trunc") " " (v-text q) ")"]) t))
            (= method "rem") (op "frem")
            (= method "=") (cmp "oeq")
            (= method "!=") (cmp "une")
            (= method "<") (cmp "olt")
            (= method "<=") (cmp "ole")
            (= method ">") (cmp "ogt")
            :else (cmp "oge")))))

;; ---- integers

;; `+`, `-`, `*` with the overflow trap of §8.12.
(defun int-checked :private (cx: LowerCx method: str t: LirTy a: str b: str) -> V
  (let ((op (cond (= method "+") "sadd-overflow" (= method "-") "ssub-overflow" :else "smul-overflow")))
    (let ((r (arith-val cx (str-join ["(" op " " a " " b ")"]) t)))
      (let ((ovf (arith-val cx (str-join ["(extractvalue " (v-text r) " 1)"]) LirI1)))
        (do (lcx-trap-if cx ovf (str-join ["integer overflow in " method " at " (lir-ty-text t)]))
            (arith-val cx (str-join ["(extractvalue " (v-text r) " 0)"]) t))))))

;; The shifts: the count masked to the width, so no shift is by more than the width.
(defun int-shift :private (cx: LowerCx method: str t: LirTy a: str b: str) -> V
  (let ((w (lir-ty-text t)))
    (let ((m (arith-val cx (str-join ["(and " b " (" w " " (str (- (lir-ty-bits t) 1)) "))"]) t))
          (op (cond (= method "shl") "shl" (= method "shr") "lshr" :else "ashr")))
      (arith-val cx (str-join ["(" op " " a " " (v-text m) ")"]) t))))

;; `/` (and `quot`) or `rem` with the checks of §8.12. `nil` when the operation cannot return: lIR refuses a division by a constant zero
;; outright (lir.md §6.1), so a literal divisor of 0 is the trap alone. Rust: arith.rs:150 int_division
(defun int-division :private (cx: LowerCx method: str a: str b: str t: LirTy) -> (Option V)
  (let ((w (lir-ty-text t)))
    (if (= b (str-join ["(" w " 0)"]))
        (do (lcx-trap-c cx (str-join ["integer " method " by zero"])) nil)
        (let ((zero (arith-val cx (str-join ["(icmp eq " b " (" w " 0))"]) LirI1)))
          (do (lcx-trap-if cx zero (str-join ["integer " method " by zero"]))
              (let ((amin (arith-val cx (str-join ["(icmp eq " a " (" w " " (str (int-min t)) "))"]) LirI1))
                    (bm1 (arith-val cx (str-join ["(icmp eq " b " (" w " -1))"]) LirI1)))
                (let ((both (arith-val cx (str-join ["(and " (v-text amin) " " (v-text bm1) ")"]) LirI1)))
                  (do (lcx-trap-if cx both (str-join ["integer overflow in " method " at " w]))
                      (some (arith-val cx (str-join ["(" (if (= method "/") "sdiv" "srem") " " a " " b ")"]) t))))))))))

;; Comparisons and the rest of the integer methods; `None` when the operation cannot return (a literal division by zero).
;; `quot` is the division the builtin `/` was (stdlib §7 L30); its traps name `/`. Rust: arith.rs:103 int_binary
(defun int-binary :private (cx: LowerCx method0: str x: V y: V) -> (Result (Option V) str)
  (let ((method (if (= method0 "quot") "/" method0)) (t (unwrap-or (v-ty x) LirI64)) (a (v-text x)) (b (v-text y)))
    (cond (in? method ["+" "-" "*"]) (Ok (some (int-checked cx method t a b)))
          (in? method ["/" "rem"]) (Ok (int-division cx method a b t))
          (= method "bit-and") (Ok (some (arith-val cx (str-join ["(and " a " " b ")"]) t)))
          (= method "bit-or") (Ok (some (arith-val cx (str-join ["(or " a " " b ")"]) t)))
          (= method "bit-xor") (Ok (some (arith-val cx (str-join ["(xor " a " " b ")"]) t)))
          (in? method ["shl" "shr" "sar"]) (Ok (some (int-shift cx method t a b)))
          ;; `false` is below `true`: an `i1` is compared as the unsigned 0 and 1 it holds, where `slt` would read `true` as -1. The
          ;; signed integers and the characters (code points, never negative) compare signed.
          :else (try-let ((pred (compare-pred method (= t LirI1))))
                  (Ok (some (arith-val cx (str-join ["(icmp " pred " " a " " b ")"]) LirI1)))))))

;; Rust: arith.rs:178 int_unary
(defun int-unary :private (cx: LowerCx method: str x: V) -> (Result V str)
  (let ((t (unwrap-or (v-ty x) LirI64)) (a (v-text x)))
    (let ((w (lir-ty-text t)))
      (cond (= method "neg")
            (let ((amin (arith-val cx (str-join ["(icmp eq " a " (" w " " (str (int-min t)) "))"]) LirI1)))
              (do (lcx-trap-if cx amin (str-join ["integer overflow in neg at " w]))
                  (Ok (arith-val cx (str-join ["(sub (" w " 0) " a ")"]) t))))
            (= method "bit-not") (Ok (arith-val cx (str-join ["(xor " a " (" w " -1))"]) t))
            (= method "popcount") (Ok (arith-val cx (str-join ["(ctpop " a ")"]) t))
            :else (Err (str-join ["unary " method]))))))

;; `<` and its fellows on keywords: by name, as the interpreter's, where the interned ids only order by first use.
;; Rust: arith.rs:56 keyword_order
(defun keyword-order :private (cx: LowerCx method: str x: V y: V) -> (Result (Option V) str)
  (do (set! (. (. cx p) keyword-helpers) true)
      (let ((a (arith-val cx (str-join ["(call @kw.rank " (v-text x) ")"]) LirI64)))
        (let ((b (arith-val cx (str-join ["(call @kw.rank " (v-text y) ")"]) LirI64)))
          (int-binary cx method a b)))))

;; ---- the method of a native instance

(defun keyword-ty? :private (t: Ty) -> bool
  (match t ((TCon (KScalar (SKeyword)) _) true) (_ false)))

(defun str-ty? :private (t: Ty) -> bool
  (match t ((TCon (KStr) _) true) (_ false)))

(defun float-ty? :private (t: LirTy) -> bool
  (or (= t LirFloat) (= t LirDouble)))

(defun ordering? :private (method: str) -> bool
  (or (= method "<") (= method "<=") (= method ">") (= method ">=")))

;; A method of `Num`, `Eq`, `Ord` or `Bits` on a scalar of the lIR type `t` (the first operand `x`, the second `y` when there is one).
(defun scalar-method :private (cx: LowerCx method: str t: LirTy x: V y: (Option V) t0: Ty) -> (Result (Option V) str)
  (match y
    ((some y2)
     (cond (and (keyword-ty? t0) (ordering? method)) (keyword-order cx method x y2)
           (float-ty? t) (Ok (some (float-binary cx method x y2)))
           :else (int-binary cx method x y2)))
    (nil (if (float-ty? t)
             (Ok (some (arith-val cx (str-join ["(fneg " (v-text x) ")"]) t)))
             (arith-some (int-unary cx method x))))))

;; A method of a native instance. Rust: arith.rs:14 LowerCx::native_method
(defun lcx-native-method (cx: LowerCx proto: str method: str a: (Vec V) tys: (Vec Ty) rt: Ty) -> (Result (Option V) str)
  (match (first a)
    (nil (Err (str-join [method " without a receiver"])))
    ((some x)
     (let ((y (get a 1)) (t0 (nth tys 0)))
       (cond (= proto "Deref") (arith-some (lcx-deref-val cx x t0))
             (= proto "Show") (arith-some (lcx-native-show cx x t0))
             (= proto "Hash") (arith-some (lcx-native-hash cx x t0))
             (str-ty? t0) (arith-some (str-compare cx method x y))
             :else (match (v-ty x)
                     (nil (arith-some (unit-compare method)))
                     ((some t) (scalar-method cx method t x y t0))))))))

;; ---- conversions

;; The instruction of a conversion primitive to the lIR type `to` of the value text `x`.
(defun convert-instr :private (op: ConvOp to: LirTy x: str) -> str
  (let ((tt (lir-ty-text to)))
    (match op
      ((CvIntToInt c) (str-join ["(" (match c ((Trunc) "trunc") ((Zext) "zext") ((Sext) "sext")) " " tt " " x ")"]))
      ((CvFloatToFloat) (if (= to LirFloat) (str-join ["(fptrunc float " x ")"]) (str-join ["(fpext double " x ")"])))
      ((CvFloatToInt signed) (str-join ["(" (if signed "fptosi-sat" "fptoui-sat") " " tt " " x ")"]))
      ((CvIntToFloat signed) (str-join ["(" (if signed "sitofp" "uitofp") " " tt " " x ")"])))))

;; Whether `op` between two types of the same lIR type changes nothing.
(defun convert-noop? :private (op: ConvOp) -> bool
  (match op ((CvIntToInt _) true) ((CvFloatToFloat) true) (_ false)))

;; A conversion primitive (§8.12). Rust: arith.rs:209 LowerCx::convert
(defun lcx-convert (cx: LowerCx op: ConvOp target: Scalar v: V) -> (Result V str)
  (try-let ((l (lir-ty (program-g (. cx p)) (ty-scalar target))))
    (match l
      (nil (Err "conversion to unit"))
      ((some to)
       (match (v-ty v)
         (nil (Err "conversion of unit"))
         ((some from)
          (let ((instr (convert-instr op to (v-text v))))
            (if (and (= from to) (convert-noop? op))
                (Ok v)
                (Ok (arith-val cx instr to))))))))))

;; `f64->bits`, `bits->f64`, `f32->bits`, `bits->f32` (syntax §4.3): the lIR `bitcast` between a float and the integer of its width,
;; which keeps every bit, a NaN's payload and a zero's sign included. Rust: arith.rs:237 LowerCx::float_bits
(defun lcx-float-bits (cx: LowerCx name: str x: V) -> (Result V str)
  (let ((to (cond (= name "f64->bits") (some LirI64)
                  (= name "bits->f64") (some LirDouble)
                  (= name "f32->bits") (some LirI32)
                  (= name "bits->f32") (some LirFloat)
                  :else nil)))
    (match to
      (nil (Err (str-join ["builtin " name])))
      ((some t) (Ok (arith-val cx (str-join ["(bitcast " (lir-ty-text t) " " (v-text x) ")"]) t))))))
