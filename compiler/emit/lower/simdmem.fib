;; compiler/emit/lower/simdmem.fib: lane vectors from and to an `(Array T)` of integers or floats (docs/design/simd-and-tensors.md 2.7):
;;   simd-load a i            lanes i .. i+n-1; trap unless 0 <= i and i + n <= (array-len a)        simd-load-unchecked: no check (unsafe)
;;   simd-load-masked a i m p  lane k is element i+k where the mask is true, else lane k of p; masked-off lanes are not read and not checked; an active lane
;;                            past the array (or before it) traps
;;   simd-load-tail a i       the elements from i on, the lanes past the end 0; traps unless 0 <= i <= (array-len a)
;;   simd-store! &a i v       lanes to i .. i+n-1, checked as the load; copies the array first when it is shared (an array is never written when shared)
;;   simd-store-unchecked! &a i v   no check (unsafe), still unique        simd-store-masked! &a i v m   simd-store-tail! &a i v
;; The vector type is the context's for the loads (`n` is never an argument). Every access promises the alignment of the element only.
(ns emit.lower.simdmem
  (:use types.ty types.scheme types.ast own.program emit.value emit.layout emit.ir emit.program emit.objects.kinds
        emit.lower.cx emit.lower.ops emit.lower.simd emit.lower.simdfn)
  (:require [emit.node :as nx]) (:require [lir.ast :as la] [lir.types :as lt]))

(defstruct SArr (tid: i64 sname: str esize: i64 align: i64 vt: LirTy))

(defun simd-arr :private (cx: LowerCx arr-ty: Ty vec-ty: Ty) -> (Result SArr str)
  (match arr-ty
    ((TCon (KArray) args)
     (try-let ((o (program-object (. cx p) arr-ty)) (l (program-lir (. cx p) (nth args 0))) (vl (program-lir (. cx p) vec-ty)))
       (match (Pair l vl)
         ((Pair (some el) (some (LirVec e n)))
          (if (or (= e LirI1) (not (= el e)))
              (Err "the vector and the array must have the same integer or float element type")
              (let ((sa (size-align-pb (program-pb (. cx p)) el))) (Ok (SArr (. o fst) (. o snd) (. sa fst) (. sa snd) (LirVec e n))))))
         (_ (Err "a vector access needs an array of integers or floats")))))
    (_ (Err "a vector access on a non-array"))))

(defun len-of :private (cx: LowerCx r: SArr arr: la/LExpr) -> V
  (lcx-load cx LirI64 (lcx-gep cx (. r sname) arr slot-len)))

(defun elem-ptr :private (cx: LowerCx r: SArr arr: la/LExpr i: V) -> la/LExpr
  (v-expr (fb-val (. cx b) (nx/gep (lt/TNamed (. r sname)) arr [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 slot-elems) (v-expr i)]) LirPtr)))

(defun lanes-t :private (r: SArr) -> i64 (lanes-of (. r vt)))

(defun mask-t :private (r: SArr) -> LirTy (LirVec LirI1 (lanes-t r)))

(defun iota :private (r: SArr) -> la/LExpr
  (nx/vector-value (lt/TVector (lanes-t r) lt/ty-i64)
                   (mapv (fn (i: i64) (nx/integer lt/ty-i64 i)) (range (lanes-t r)))))

(defun cmp :private (cx: LowerCx op: str a: la/LExpr b: la/LExpr t: LirTy) -> V
  (val cx (nx/operation op a b) t))

;; Traps with `msg` unless `0 <= i` and `i + k <= len` (a whole vector: k the lane count; a tail: k 0).
(defun check-span :private (cx: LowerCx r: SArr arr: la/LExpr i: V k: i64 msg: str) -> unit
  (let ((len (len-of cx r arr)))
    (let ((hi (val cx (nx/binary la/BAdd (v-expr i) (nx/integer lt/ty-i64 k)) LirI64)))
      (let ((b1 (cmp cx "icmp slt" (v-expr i) (nx/integer lt/ty-i64 0) LirI1)) (b2 (cmp cx "icmp sgt" (v-expr hi) (v-expr len) LirI1)))
        (lcx-trap-if cx (cmp cx "or" (v-expr b1) (v-expr b2) LirI1) msg)))))

;; The lane index vector `i + k` and the mask of the lanes whose element does not exist (or lies before the array).
(defun bad-lanes :private (cx: LowerCx r: SArr arr: la/LExpr i: V m: V) -> V
  (let ((it (LirVec LirI64 (lanes-t r))))
    (let ((idx (cmp cx "add" (v-expr (splat-lanes cx it i)) (iota r) it)) (len (len-of cx r arr)))
      (let ((ok (cmp cx "icmp ult" (v-expr idx) (v-expr (splat-lanes cx it len)) (mask-t r))))
        (cmp cx "and" (v-expr m) (v-expr (cmp cx "xor" (v-expr ok) (vconst (mask-t r) (nx/integer lt/ty-i1 1)) (mask-t r))) (mask-t r))))))

(defun check-masked :private (cx: LowerCx r: SArr arr: la/LExpr i: V m: V msg: str) -> unit
  (let ((bad (bad-lanes cx r arr i m)))
    (lcx-trap-if cx (val cx (nx/intrinsic "reduce-or" 0 nil [(v-expr bad)] nil) LirI1) msg)))

;; The mask of the lanes of a tail: lane k is active when k < len - i (after the check 0 <= i <= len).
(defun tail-mask :private (cx: LowerCx r: SArr arr: la/LExpr i: V msg: str) -> V
  (do (check-span cx r arr i 0 msg)
      (let ((it (LirVec LirI64 (lanes-t r))) (rem (cmp cx "sub" (v-expr (len-of cx r arr)) (v-expr i) LirI64)))
        (cmp cx "icmp slt" (iota r) (v-expr (splat-lanes cx it rem)) (mask-t r)))))

(defun zero-vec :private (r: SArr) -> la/LExpr (nx/zero (lir-type (. r vt))))

(defun al :private (r: SArr) -> (Option i64) (some (. r align)))

(defun load-at :private (cx: LowerCx r: SArr arr: la/LExpr i: V name: str a: (Vec V)) -> V
  (let ((vt (lir-type (. r vt))) (p (elem-ptr cx r arr i)))
    (cond (= name "simd-load")
          (do (check-span cx r arr i (lanes-t r) "simd-load: lanes out of range of the array")
              (val cx (nx/load vt p (al r)) (. r vt)))
          (= name "simd-load-unchecked") (val cx (nx/load vt p (al r)) (. r vt))
          (= name "simd-load-masked")
          (do (check-masked cx r arr i (nth a 2) "simd-load-masked: an active lane is out of range of the array")
              (val cx (nx/intrinsic "masked-load" 0 (some vt) [p (v-expr (nth a 2)) (v-expr (nth a 3))] (al r)) (. r vt)))
          :else (let ((m (tail-mask cx r arr i "simd-load-tail: index out of range of the array")))
                  (val cx (nx/intrinsic "masked-load" 0 (some vt) [p (v-expr m) (zero-vec r)] (al r)) (. r vt))))))


;; ---- stores

;; The array in the cell of `&a`, unique: a shared one is copied and the copy takes its place in the cell (in-place-update.md 2); the elements are
;; scalars, so the copy retains nothing. Returns the array now in the cell.
(defun own-array :private (cx: LowerCx r: SArr cell-ty: Ty arr-ty: Ty cell: V) -> (Result V str)
  (try-let ((co (program-object (. cx p) cell-ty)))
    (let ((cell-s (. co snd)) (c (v-expr cell)))
      (try-let ((content ((. (. cx hub) cell-load) cx cell-s c arr-ty)))
        (let ((b (. cx b))
              (ok (fb-val b (nx/call "fib.unique?" [(v-expr content)]) LirI1))
              (lc (fb-label b "scopy")) (lj (fb-label b "sowned")))
          (do (fb-term b (nx/conditional (v-expr ok) lj lc))
              (fb-open b lc)
              (let ((copy (fb-val b (nx/call "fib.array-slice" [(v-expr content) (nx/integer lt/ty-i64 0) (v-expr (len-of cx r (v-expr content))) (nx/integer lt/ty-i32 (. r tid)) (nx/integer lt/ty-i64 (. r esize))]) LirPtr)))
                (do (lcx-store cx copy (lcx-gep cx cell-s c slot-cell-value))
                    (lcx-release cx content)
                    (fb-term b (nx/branch lj))))
              (fb-open b lj)
              ((. (. cx hub) cell-load) cx cell-s c arr-ty)))))))

(defun store-at :private (cx: LowerCx r: SArr arr: la/LExpr i: V name: str a: (Vec V)) -> unit
  (let ((v (v-expr (nth a 2))) (p (elem-ptr cx r arr i)))
    (cond (= name "simd-store!")
          (do (check-span cx r arr i (lanes-t r) "simd-store!: lanes out of range of the array")
              (fb-stmt (. cx b) (nx/store v p (al r))))
          (= name "simd-store-unchecked!") (fb-stmt (. cx b) (nx/store v p (al r)))
          (= name "simd-store-masked!")
          (do (check-masked cx r arr i (nth a 3) "simd-store-masked!: an active lane is out of range of the array")
              (fb-stmt (. cx b) (nx/intrinsic "masked-store" 0 nil [v p (v-expr (nth a 3))] (al r))))
          :else (let ((m (tail-mask cx r arr i "simd-store-tail!: index out of range of the array")))
                  (fb-stmt (. cx b) (nx/intrinsic "masked-store" 0 nil [v p (v-expr m)] (al r)))))))

(defun simd-mem-name? (name: str) -> bool
  (contains? (set ["simd-load" "simd-load-unchecked" "simd-load-masked" "simd-load-tail"
                   "simd-store!" "simd-store-unchecked!" "simd-store-masked!" "simd-store-tail!"]) name))

(defun simd-store-name? :private (name: str) -> bool (starts-with? name "simd-store"))

;; Every simd builtin of this module and of emit.lower.simdfn; `nil` when `name` is none of them. `tys` are the argument types, `e` the call.
(defun lcx-simd-extra (cx: LowerCx name: str e: Expr a: (Vec V) tys: (Vec Ty)) -> (Result V str)
  (cond (simd-ptr-name? name) (lcx-simd-ptr cx name e a tys)
        (simd-mem-name? name)
          (if (simd-store-name? name)
              (match (nth tys 0)
                ((TCon (KCell) args)
                 (try-let ((r (simd-arr cx (nth args 0) (nth tys 2))) (arr (own-array cx r (nth tys 0) (nth args 0) (nth a 0))))
                   (do (store-at cx r (v-expr arr) (nth a 1) name a) (Ok VUnit))))
                (_ (Err (str-join [name " on a non-cell"]))))
              (try-let ((vt (lcx-ty cx e)) (r (simd-arr cx (nth tys 0) vt)))
                (Ok (load-at cx r (v-expr (nth a 0)) (nth a 1) name a))))
        (= name "simd/convert") (try-let ((t (lcx-ty cx e)) (l (program-lir (. cx p) t)))
                                  (match l ((some lt) (lcx-simd-convert cx (nth a 0) lt)) (nil (Err "simd/convert to unit"))))
        (= name "simd/bitcast") (try-let ((t (lcx-ty cx e)) (l (program-lir (. cx p) t)))
                                  (match l ((some lt) (lcx-simd-bitcast cx (nth a 0) lt)) (nil (Err "simd/bitcast to unit"))))
        (= name "simd/movemask") (Ok (lcx-movemask cx (nth a 0)))
        (or (= name "ctz") (= name "clz")) (Ok (lcx-count-zeros cx name (nth a 0)))
        (= name "simd/shuffle") (lcx-simd-shuffle cx e (nth a 0) (nth a 1))
        (= name "simd/reverse") (Ok (lcx-simd-reverse cx (nth a 0)))
        (or (= name "simd/lanes") (= name "simd/kind")) (Ok (lcx-simd-const name (nth a 0)))
        :else (lcx-simd-fn cx name a)))

(defun simd-ptr-name? :private (name: str) -> bool (or (= name "load-simd") (= name "store-simd")))

;; `load-simd p` and `store-simd p v`: one unaligned vector access at the raw pointer, the vector type the context's (a load) or the value's (a store).
(defun lcx-simd-ptr :private (cx: LowerCx name: str e: Expr a: (Vec V) tys: (Vec Ty)) -> (Result V str)
  (if (= name "load-simd")
      (try-let ((vt (lcx-ty cx e)) (l (program-lir (. cx p) vt)))
        (match l
          ((some lt) (Ok (val cx (nx/load (lir-type lt) (v-expr (nth a 0)) (some 1)) lt)))
          (nil (Err "load-simd of unit"))))
    (do (fb-stmt (. cx b) (nx/store (v-expr (nth a 1)) (v-expr (nth a 0)) (some 1))) (Ok VUnit))))

(defun simd-extra-name? (name: str) -> bool (or (simd-mem-name? name) (simd-fn-name? name) (simd-ptr-name? name)))
