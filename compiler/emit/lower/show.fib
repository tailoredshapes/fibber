;; compiler/emit/lower/show.fib: the native `Show` and `Hash` instances (types §2.12) on scalars, field-less enums and `str`,
;; computing what the interpreter computes (eval/arith.rs `show`, `hash`); every `show` allocates one fresh `str`.
;; Replaces crates/fibc/src/lower/show.rs. No or-pattern in the language: the Rust's `I8 | I16 | I32` arm is the last arm of the
;; scalar matches (it follows every other scalar), commented as such.
(ns emit.lower.show
  (:require [fib.string :as s])
  (:use types.ty types.scheme types.ast types.decls own.program emit.value emit.layout emit.names emit.ir emit.statics emit.program
        emit.lower.cx emit.lower.ops emit.lower.simd)
  (:require [emit.node :as nx] [emit.function :as ff]) (:require [lir.ast :as la] [lir.types :as lt]))

;; The call a scalar's `show` is. `x` is the value; an integer narrower than 64 bits is widened first. Rust: show.rs:17
(defun scalar-show :private (cx: LowerCx sc: Scalar value: V) -> la/LExpr
  (if (= sc SUnit)
      (nx/call "fib.str-copy" [(nx/reference (statics-string (. (. cx p) statics) "()" 0))])
      (scalar-show-value cx sc value)))

(defun scalar-show-value :private (cx: LowerCx sc: Scalar x: V) -> la/LExpr
  (let ((xt (v-expr x)) (p (. cx p)))
    (match sc
      ((SBool) (nx/call "fib.show-bool" [xt]))
      ((SChar) (nx/call "fib.show-char" [xt]))
      ((SI64) (nx/call "fib.show-int" [xt]))
      ((SPtr) (nx/call "fib.show-ptr" [xt]))
      ((SUnit) (nx/call "fib.str-copy" [(nx/reference (statics-string (. p statics) "()" 0))]))
      ((SKeyword) (do (set! (. p keyword-helpers) true)
                      (nx/call "kw.show" [xt])))
      ((SF32) (nx/call "fib.show-float" [xt]))
      ((SF64) (nx/call "fib.show-double" [xt]))
      ;; SI8, SI16, SI32
      (_ (let ((w (fb-val (. cx b) (nx/cast la/CSExt lt/ty-i64 xt) LirI64)))
           (nx/call "fib.show-int" [(v-expr w)]))))))

;; `show` on a field-less enum: a fresh copy of the variant's name. The helper function is made once per enum.
;; Rust: show.rs:84 enum_show_helper
(defun enum-show-helper :private (cx: LowerCx id: i64) -> (Result str str)
  (let ((name (str-join ["show.enum." (str id)])) (p (. cx p)))
    (if (program-has-helper p name)
        (Ok name)
        (match (. (g-ty (program-g p) id) shape)
          ((TsStruct _) (Err "show of a struct"))
          ((TsEnum vs)
           (let ((strs (mapv (fn (v: VariantDef) (statics-string (. p statics) (. v name) 0)) vs))
                 (idx (vec (range (count vs)))))
             (let ((cases (mapv (fn (i: i64) (la/LCase (nx/integer lt/ty-i32 i) (str "v" i))) idx))
                   (blocks (mapv (fn (i: i64) (ff/block (str "v" i) [(nx/ret (some (nx/call "fib.str-copy" [(nx/reference (nth strs i))])))])) idx)))
               (do (program-add-helper p name (ff/make name (some lt/ty-ptr) [(Pair "i" lt/ty-i32)] lt/cc-c
                                                       (into (into [(ff/block "entry" [(nx/switch (nx/local "i") "bad" cases)])] blocks)
                                                             [(ff/block "bad" [(nx/unreachable)])])))
                   (Ok name)))))))))

(defun fieldless-enum? :private (g: Globals t: Ty) -> bool
  (match t
    ((TCon (KNominal id) _) (typedef-is-fieldless-enum (g-ty g id)))
    (_ false)))

;; ---- a lane vector: the literal, `<<1 2 3 4>>i32`, the element type visible unless it is i64 or f64 (spec/types.md 1.9, "Show")

(defun simd-suffix :private (sc: Scalar) -> str
  (match sc ((SI8) "i8") ((SI16) "i16") ((SI32) "i32") ((SF32) "f32") (_ "")))

;; A fresh `str` of `text`.
(defun simd-piece :private (cx: LowerCx text: str) -> V
  (fb-val (. cx b) (nx/call "fib.str-copy" [(nx/reference (statics-string (. (. cx p) statics) text 0))]) LirPtr))

;; `acc` and `p` joined into a fresh `str`; both are released.
(defun simd-append :private (cx: LowerCx acc: V p: V) -> V
  (let ((r (fb-val (. cx b) (nx/call "fib.str-concat" [(v-expr acc) (v-expr p)]) LirPtr)))
    (do (lcx-release cx acc) (lcx-release cx p) r)))

(defun simd-show :private (cx: LowerCx x: V sc: Scalar lt: LirTy) -> (Result V str)
  (loop ((i 0) (acc (simd-piece cx "<<")))
    (if (>= i (lanes-of lt))
        (Ok (simd-append cx acc (simd-piece cx (str-join [">>" (simd-suffix sc)]))))
        (try-let ((s (lcx-native-show cx (fb-val (. cx b) (nx/extract-lane (v-expr x) (nx/integer lt/ty-i32 i)) (elem-of lt))
                                      (TCon (KScalar sc) []))))
          (recur (+ i 1) (simd-append cx (if (= i 0) acc (simd-append cx acc (simd-piece cx " "))) s))))))

;; Rust: lower/show.rs:15 LowerCx::native_show
(defun lcx-native-show (cx: LowerCx x: V t: Ty) -> (Result V str)
  (match t
    ((TCon (KSimd) args)
     (match (Pair (v-ty x) (nth args 0))
       ((Pair (some lt) (TCon (KScalar sc) _)) (simd-show cx x sc lt))
       (_ (Err "show of a vector of an unknown element"))))
    (_ (lcx-native-show-plain cx x t))))

(defun lcx-native-show-plain :private (cx: LowerCx x: V t: Ty) -> (Result V str)
  (let ((g (program-g (. cx p))))
    (try-let ((call (match t
                      ((TCon (KScalar sc) _) (Ok (scalar-show cx sc x)))
                      ((TCon (KStr) _) (Ok (nx/call "fib.str-copy" [(v-expr x)])))
                      (_ (if (fieldless-enum? g t)
                             (try-let ((f (match t ((TCon (KNominal id) _) (enum-show-helper cx id)) (_ (Err "show of a non-enum")))))
                               (Ok (nx/call f [(v-expr x)])))
                             (Err (str-join ["show of " (mangle g t)])))))))
      (Ok (fb-val (. cx b) call LirPtr)))))

;; The hash of a scalar, as the 64-bit value `conv` makes of `instr`.
(defun hash-val :private (cx: LowerCx instr: la/LExpr) -> V
  (fb-val (. cx b) instr LirI64))

;; Rust: lower/show.rs:48 LowerCx::native_hash
(defun lcx-native-hash (cx: LowerCx value: V ty: Ty) -> (Result V str)
  (match ty
    ((TCon (KScalar (SUnit)) _) (Ok (v-int LirI64 0)))
    (_ (native-hash-value cx value ty))))

(defun native-hash-value :private (cx: LowerCx x: V t: Ty) -> (Result V str)
  (let ((g (program-g (. cx p))) (xt (v-expr x)))
    (match t
      ((TCon (KScalar sc) _)
       (match sc
         ((SI64) (Ok x))
         ((SBool) (Ok (hash-val cx (nx/cast la/CZExt lt/ty-i64 xt))))
         ((SChar) (Ok (hash-val cx (nx/cast la/CZExt lt/ty-i64 xt))))
         ((SF64) (Ok (hash-val cx (nx/call "fib.double-hash" [xt]))))
         ((SF32) (let ((d (fb-val (. cx b) (nx/cast la/CFpExt lt/ty-double xt) LirDouble)))
                   (Ok (hash-val cx (nx/call "fib.double-hash" [(v-expr d)])))))
         ((SPtr) (Ok (hash-val cx (nx/cast la/CPtrToInt lt/ty-i64 xt))))
         ((SUnit) (Ok (v-int LirI64 0)))
         ((SKeyword) (do (set! (. (. cx p) keyword-helpers) true)
                         (Ok (hash-val cx (nx/call "kw.hash" [xt])))))
         ;; SI8, SI16, SI32
         (_ (Ok (hash-val cx (nx/cast la/CSExt lt/ty-i64 xt))))))
      ((TCon (KStr) _) (Ok (hash-val cx (nx/call "fib.str-hash" [xt]))))
      (_ (if (fieldless-enum? g t)
             (Ok (hash-val cx (nx/cast la/CSExt lt/ty-i64 xt)))
             (Err (str-join ["hash of " (mangle g t)])))))))
