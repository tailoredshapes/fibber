;; compiler/emit/lower/mod.fib: lowering a body (spec/compiler.md §4): `emit_body`, `emit_closure` and `emit_async` (the entry points),
;; the dispatch over expression kinds and the hub that lets the modules below call it. Replaces crates/fibc/src/lower/mod.rs (501
;; lines of Rust). What every module needs from below (`lcx-ty`, `lcx-local`, `lcx-value`, `lcx-gep`, `literals`, ..) is in
;; emit.lower.cx (see its header: a module cannot call upward); here is what only the top needs. `float_text` (mod.rs:493) is
;; `float-lir-text` of emit.text.
(ns emit.lower.mod
  (:use types.ty types.ast types.decls types.program types.table types.init own.program syntax.form emit.value emit.text emit.layout
        emit.ir emit.mono emit.statics emit.objects emit.program emit.resume emit.lower.cx emit.lower.ops emit.lower.ctrl
        emit.lower.values emit.lower.call emit.lower.arith emit.lower.objects emit.lower.cells emit.lower.dynamic
        emit.lower.pattern emit.lower.quote emit.lower.threads emit.lower.simd emit.lower.hoist emit.lower.recur emit.lower.facts)
  (:require [emit.node :as nx]) (:require [lir.ast :as la] [lir.types :as lt] [emit.live :as live] [expand.targetos :as tos]))

;; The functions the modules below call upward, as the Rust methods they stand for (the hub of emit.lower.cx).
(defun hub-default () -> Hub
  (Hub expr-step lcx-method-value lcx-builtin-value lcx-cell-load lcx-emit-call lcx-join-value lcx-instance-of-pred lcx-unwind-exit))

;; Rust: lower/mod.rs:258 Cx::new
(defun lcx-new (p: Program inst: Inst own: BodyOwn name: str params: (Vec LirParam)) -> LowerCx
  (lcx-build p inst own name params true (hub-default) (literals (. p typed) (. p owned) (. inst key))))

;; ---- the entry points

;; A parameter's value in the body and its place in the signature (none for a `unit` parameter).
(defstruct ParamSlot (binding: i64 v: V sig: (Option LirParam)))

(defun param-slot :private (p: Program inst: Inst i: i64 b: i64) -> (Result ParamSlot str)
  (try-let ((t (binding-ty p inst b)) (l (program-lir p t)))
    (Ok (match l
          ((some x) (let ((pn (str-join ["p" (str i)]))) (ParamSlot b (v-local pn x) (some (LirParam x pn)))))
          (nil (ParamSlot b VUnit nil))))))

(defun param-slots :private (p: Program inst: Inst bs: (Vec i64)) -> (Result (Vec ParamSlot) str)
  (try-map (fn (i: i64) (param-slot p inst i (nth bs i))) (vec (range (count bs)))))

(defun params-sig :private (ps: (Vec ParamSlot)) -> (Vec LirParam)
  (vec (keep (fn (s: ParamSlot) (. s sig)) ps)))

(defun bind-params :private (cx: LowerCx ps: (Vec ParamSlot)) -> unit
  (doseq [s ps] (set! (. cx locals) (assoc @(. cx locals) (. s binding) (LocalVal (. s v))))))

(defun ret-term :private (cx: LowerCx v: V) -> unit
  (fb-term (. cx b) (match v ((VUnit) (nx/ret nil)) ((VVal s _) (nx/ret (some s))))))

;; ---- the stack check (docs/design/stack-check.md)

;; Whether the body of the instance can be part of a recursion (emit.lower.recur): a `defun` on a cycle of direct calls or with a call to an unnamed target; a method
;; with any call to code of the program. A function that cannot is a bounded leaf as far as the stack goes: any recursion through it goes through a checked function (stack-check.md 5).
(defun inst-may-recurse? :private (cx: LowerCx body: Expr) -> bool
  (match (. (. cx inst) key)
    ((BodyFun f) (fun-may-recurse? (. cx p) f))
    ((BodyAllOwned f) (fun-may-recurse? (. cx p) f))
    (_ (method-may-recurse? body))))

;; Whether the function tests its stack on entry: the program passes failures on, the target has the table (not WASI), the function is called through
;; the convention (`unwind`), can pass a failure on (a function with `array-take!`, like `conj`, cannot: it is not checked, its callers are, and the margin covers its frame),
;; and can be part of a recursion.
(defun stack-check? :private (cx: LowerCx recurses: bool) -> bool
  (and @(. (. cx b) unwind) (not @(. cx fatal)) (stack-check-wanted?) (not (= (tos/target-platform-name) "Wasi"))
       recurses))

;; The check, on entry: `sp` against the word the table `fib.stk` holds for its 2 MiB block (a page number and a page count, one 64-bit word, so a racing
;; thread never reads half of one); outside the range the word describes, `fib.stack-slow` finds the thread's limit and either registers the block or
;; says the stack is nearly out, which is the trap `stack overflow` of the plan's entry key (own.walk.state `w-put-entry-unwind`): the owned parameters
;; are released and the failure returned. The fast path is about nine instructions and no call.
(defun emit-stack-check :private (cx: LowerCx key: i64) -> unit
  (let ((b (. cx b)) (low (fb-label b "stack-low")) (over (fb-label b "stack-over")) (ok (fb-label b "stack-ok")))
    (let ((sp (fb-val b (nx/intrinsic "stack-addr" 0 nil [] nil) LirI64)))
      (let ((word (fb-val b (nx/atomic-load-relaxed lt/ty-i64
                              (nx/gep lt/ty-i64 (nx/global "fib.stk") [(nx/binary la/BAnd (nx/binary la/BLShr (v-expr sp) (nx/integer lt/ty-i64 21)) (nx/integer lt/ty-i64 4095))]))
                          LirI64)))
        (let ((d (fb-val b (nx/binary la/BSub (nx/binary la/BLShr (v-expr sp) (nx/integer lt/ty-i64 12)) (nx/binary la/BLShr (v-expr word) (nx/integer lt/ty-i64 10))) LirI64))
              (n (fb-val b (nx/binary la/BAnd (v-expr word) (nx/integer lt/ty-i64 1023)) LirI64)))
          (do (fb-term b (nx/conditional (nx/compare-int la/IUge (v-expr d) (v-expr n)) low ok))
              (fb-open b low)
              (fb-term b (nx/conditional (nx/call "fib.stack-slow" [(v-expr sp)]) over ok))
              (fb-open b over)
              (set! (. cx unwind-ops) (get (. (. cx own) guard-fail) key))
              (lcx-trap-c cx "stack overflow")
              (set! (. cx unwind-ops) nil)
              (fb-open b ok)))))))

;; Lowers the body, returns its value, and records the function with the function attributes `attrs` (lIR words: `inline`, `noinline`,
;; `cold`, spec/lir.md 4.3). Rust: lower/mod.rs:276 Cx::finish_with
;; `key` is where the plan keeps what an entry that fails releases (`unwind-entry-key`): the body's expression id, or the `fn` literal's.
(defun finish-with :private (cx: LowerCx body: Expr key: i64 recurses: bool attrs: (Vec str)) -> (Result unit str)
  (try-let ((rt (lcx-ty cx body)) (l (program-lir (. cx p) rt)))
    (do (set! (. (. cx b) ret) l)
        (when (stack-check? cx recurses) (emit-stack-check cx (unwind-entry-key key)))
        (try-let ((flow (lcx-expr cx body)))
          (do (match flow ((FlowVal v) (ret-term cx v)) ((FlowJump) ()))
              (let ((f (fb-function (. cx b))))
                (program-add-function (. cx p) (with-attrs f attrs)))
              (Ok ()))))))

;; `f` with the function attributes `attrs` (lIR words) set.
(defun with-attrs :private (f: la/LFunction attrs: (Vec str)) -> la/LFunction
  (let ((has (fn (w: str) (some? (find-first (fn (a: str) (= a w)) attrs))))
        (m (. f mods)))
    (if (empty? attrs) f (with f (mods (with m (inline (or (. m inline) (has "inline"))) (noinline (or (. m noinline) (has "noinline")))
                                               (cold (or (. m cold) (has "cold")))))))))

;; The function attributes of the body of `key`: `inline` when `inline` (the Vec read path, `inline-body?`), and those its `defun` asks for
;; with `:noinline` and `:cold` (syntax 3.1, types.decls `fun-attrs`), for each instance of the function.
(defun body-attrs :private (g: Globals key: BodyKey inline: bool) -> (Vec str)
  (into (if inline ["inline"] [])
        (match key
          ((BodyFun f) (fun-attrs-of g f))
          ((BodyAllOwned f) (fun-attrs-of g f))
          (_ []))))

(defun fun-attrs-of :private (g: Globals f: i64) -> (Vec str)
  (match (get @(. g fun-attrs) f)
    ((some a) a)
    (nil (if (seed-slow-path? g f) ["noinline"] []))))

;; The library's slow paths that the compiler itself uses: `noinline` here, until their source can say `:noinline`. The seed (SEED) reads
;; this tree's lib/ when it builds the compiler, and a seed that predates `:noinline` reads it as the body. When SEED names a release that
;; knows the mark, write `:noinline` on each of these and delete this function. (Until 2026-10-25 lair marked every name ending `-slow`.)
(defun seed-slow-path? :private (g: Globals f: i64) -> bool
  (let ((ns (g-module-name g (. (g-fun g f) module))) (name (. (g-fun g f) name)))
    (cond (= ns "fib.prelude") (or (= name "vec-nth-slow") (= name "vec-assoc-slow") (= name "vec-conj-slow"))
          (= ns "fib.json.parse") (= name "string-slow")
          (= ns "fib.json.escape") (= name "put-string-slow")
          :else false)))

;; The bodies emitted `inline`, for want of a source-level marker: the Vec read path, the prelude's `vec-nth` and the `nth` of the
;; `Reducible` instance of `Vec` (fib.seq.protocols) that calls it. Out of line, a hot `nth` was a call per element whose checks LLVM
;; could neither drop nor hoist (docs/design/lir-facts.md 2 and 9).
(defun inline-body? :private (g: Globals key: BodyKey) -> bool
  (let ((named? (fn (name: str m: i64 want: str ns: str) (and (= name want) (= (g-module-name g m) ns)))))
    (match key
      ((BodyFun f) (named? (. (g-fun g f) name) (. (g-fun g f) module) "vec-nth" "fib.prelude"))
      ((BodyMethod i m)
       (let ((inst (table-get (. g instances) i)))
         (let ((pd (g-proto g (. inst proto))))
           (and (named? (. pd name) (. pd module) "Reducible" "fib.seq.protocols")
                (= (. (nth (. pd methods) (. (nth (. inst methods) m) index)) name) "nth")
                (match (. inst con)
                  ((KNominal t) (named? (. (g-ty g t) name) (. (g-ty g t) module) "Vec" "fib.prelude"))
                  (_ false))))))
      (_ false))))

;; The parameter bindings of the body a key names.
(defun key-params :private (g: Globals key: BodyKey) -> (Vec i64)
  (let ((of-fun (fn (f: i64) (mapv (fn (q: ParamDecl) (. q binding)) (. (g-fun g f) params))))
        (of-method (fn (i: i64 m: i64) (. (nth (. (table-get (. g instances) i) methods) m) params))))
    (match key
      ((BodyFun f) (of-fun f))
      ((BodyAllOwned f) (of-fun f))
      ((BodyMethod i m) (of-method i m))
      ((BodyMethodOwned i m) (of-method i m))
      ((BodyDef _) []))))

;; Whether a body calls `array-take!` (its own code or a literal's): a failure that unwinds it could leave a slot moved from where a
;; caller reaches it, so such a function does not pass failures on (docs/design/exceptions.md section 2, rule 1; ADR 0009): the trap
;; there is fatal, as before.
(defun takes-slots? :private (p: Program body: Expr) -> bool
  (loop ((stack [body]))
    (match (peek stack)
      (nil false)
      ((some e)
       (match (. e kind)
         ((ECall h _) :when (match (. h kind)
                              ((EGlobal (GBuiltin b)) (= (. (nth (. (. p typed) builtins) b) name) "array-take!"))
                              (_ false))
          true)
         (_ (recur (into (pop stack) (expr-children e)))))))))

;; Emits the function of `inst` into the program. Rust: lower/mod.rs:84 emit_body
;; In live mode a body of the program's own modules is lowered under its generation name and reached through a stub of the name the
;; callers use (emit.live).
(defun emit-body (p: Program inst: Inst) -> (Result unit str)
  (let ((g (program-g p)))
    (match (get (. (. p owned) bodies) (. inst key))
      (nil (Err "no plan for the body"))
      ((some own)
       (let ((name (queue-request (. p queue) g inst))
             (code (body-code-name p (. inst key) name))
             (env (match (. inst key) ((BodyAllOwned _) true) ((BodyMethodOwned _ _) true) (_ false))))
         (try-let ((ps (param-slots p inst (key-params g (. inst key)))))
           (let ((cx (lcx-new p inst own code (into (if env [(LirParam LirPtr "env")] []) (params-sig ps)))))
             (do (bind-params cx ps)
                 (set! (. cx vec-tail) (vec-tail-body? g (. inst key)))
                 (match (. inst key) ((BodyDef _) (lcx-set-unwind cx false)) (_ ()))
                 (set! (. cx fatal) (and @(. (. cx b) unwind) (takes-slots? p (body-expr g (. inst key)))))
                 (when env (set! (. cx env) (some (VVal (nx/local "env") LirPtr))))
                 (try-let ((_ (finish-with cx (body-expr g (. inst key)) (. (body-expr g (. inst key)) id) (inst-may-recurse? cx (body-expr g (. inst key)))
                                           (body-attrs g (. inst key) (and (= code name) (inline-body? g (. inst key)))))))
                   (if (= code name) (Ok ()) (live/add-stub p inst name code)))))))))))

;; The captures of a closure body, loaded from `env` in capture order into their bindings. Rust: lower/mod.rs:462 load_captures
(defun load-captures :private (cx: LowerCx e: Expr) -> (Result unit str)
  (match (get (. (. cx own) closures) (. e id))
    (nil (Err "no plan for a fn literal"))
    ((some oc)
     (try-let ((caps (lcx-capture-tys cx oc)))
       (let ((sname (. (program-closure-object (. cx p) (. cx name) caps) snd)))
         (do (doseq [i (range (min (count (. oc captures)) (count caps)))]
               (let ((slot (lcx-gep cx sname (nx/local "env") (+ slot-capture0 i))))
                 (let ((v (lcx-load cx (nth caps i) slot)))
                   (set! (. cx locals) (assoc @(. cx locals) (. (nth (. oc captures) i) binding) (LocalVal v))))))
             (Ok ())))))))

;; Emits the code of closure literal `lit` of `owner` (§8.4): `env` first, then the parameters; captures loaded from `env`.
;; Rust: lower/mod.rs:132 emit_closure
(defun emit-closure (p: Program owner: Inst lit: i64 name: str) -> (Result unit str)
  (match (get (. (. p owned) bodies) (. owner key))
    (nil (Err "no plan for the owner of a closure"))
    ((some own)
     (let ((lits (literals (. p typed) (. p owned) (. owner key))))
       (match (get lits lit)
         (nil (Err (str-join ["no literal " (str lit)])))
         ((some e)
          (match (. e kind)
            ((EFn f) (emit-fn p owner own lits e f name))
            ((EAsync body _) (emit-async p owner own lits e body name))
            (_ (Err "a literal that is neither fn nor async")))))))))

;; The code of a `fn` literal: its own name (a self-recursive closure) is the closure object, which is `env`.
(defun emit-fn :private (p: Program owner: Inst own: BodyOwn lits: (Map i64 Expr) e: Expr f: FnLit name: str) -> (Result unit str)
  (try-let ((ps (param-slots p owner (mapv (fn (q: FnParam) (. q binding)) (. f params)))))
    (let ((cx (lcx-build p owner own name (into [(LirParam LirPtr "env")] (params-sig ps)) true (hub-default) lits))
          (env (VVal (nx/local "env") LirPtr)))
      (do (set! (. cx env) (some env))
          (set! (. cx fatal) (and @(. (. cx b) unwind) (takes-slots? p (. f body))))
          (when-some (n (. f name)) (set! (. cx locals) (assoc @(. cx locals) n (LocalVal env))))
          (bind-params cx ps)
          (try-let ((loaded (load-captures cx e)))
            (finish-with cx (. f body) (. e id) (closure-may-recurse? (. f body)) []))))))

;; Loads the captures of a task from its object into their bindings; the point of the frame is the field after them.
(defun load-task-captures :private (cx: LowerCx oc: ClosureOwn caps: (Vec LirTy) sname: str) -> unit
  (doseq [i (range (min (count (. oc captures)) (count caps)))]
    (let ((slot (lcx-gep cx sname (nx/local "env") (+ slot-task-capture0 i))))
      (let ((v (lcx-load cx (nth caps i) slot)))
        (set! (. cx locals) (assoc @(. cx locals) (. (nth (. oc captures) i) binding) (LocalVal v)))))))

;; The result type of an `async` literal: the argument of its `Task` type.
(defun task-result :private (t: Ty) -> (Result Ty str)
  (match t
    ((TCon (KTask) args) (Ok (nth args 0)))
    (_ (Err "async without a Task type"))))

;; The resume function of an `async` body (§8.8): `env` is the task object, whose captures follow its fixed fields; the body is
;; lowered like any function, then made a state machine (emit.resume), and the task's frame takes the shape that gives it.
;; Rust: lower/mod.rs:171 emit_async
(defun emit-async :private (p: Program owner: Inst own: BodyOwn lits: (Map i64 Expr) e: Expr body: Expr name: str) -> (Result unit str)
  (let ((cx (lcx-build p owner own name [(LirParam LirPtr "env")] false (hub-default) lits)))
    (do (set! (. cx env) (some (VVal (nx/local "env") LirPtr)))
        (match (get (. own closures) (. e id))
          (nil (Err "no plan for an async literal"))
          ((some oc)
           (try-let ((caps (lcx-capture-tys cx oc)))
             (let ((task (program-task-object p (. cx name) caps)))
               (do (load-task-captures cx oc caps (. task snd))
                   (let ((point (+ slot-task-capture0 (count caps)))
                         (prologue (count @(. (nth @(. (. cx b) blocks) 0) items))))
                     (do (set! (. cx async-frame) (some (AsyncFrame (. task snd) point [])))
                         (async-body cx e body name task point prologue)))))))))))

;; The body of an `async` literal and the state machine made of it.
(defun async-body :private (cx: LowerCx e: Expr body: Expr name: str task: (Pair i64 str) point: i64 prologue: i64) -> (Result unit str)
  (try-let ((ety (lcx-ty cx e)) (result-ty (task-result ety)) (l (program-lir (. cx p) result-ty)))
    (do (set! (. (. cx b) ret) l)
        (try-let ((flow (lcx-expr cx body)))
          (do (match flow ((FlowVal v) (ret-term cx v)) ((FlowJump) ()))
              (try-let ((complete (lcx-complete-helper cx name result-ty)))
                (let ((states (match @(. cx async-frame) ((some f) (. f states)) (nil []))))
                  (do (set! (. cx async-frame) nil)
                      (try-let ((frame (make-resumable (. cx b) (ResumeShape (. task snd) prologue states complete point))))
                        (do (objects-set-task-frame (. (. cx p) objects) (. task fst) frame)
                            (program-add-function (. cx p) (fb-function (. cx b)))
                            (Ok ())))))))))))

;; The Vec runtime ids of `(Vec elem)` outside any body (for the macro surface, `compile_macro`). Any body key whose definition
;; exists will do: the literal table of the context is read from it and not used. Rust: lower/mod.rs:481 vec_ids_of
(defun vec-ids-of (p: Program t: Ty elem: Ty) -> (Result VecIds str)
  (lcx-vec-tids (lcx-new p (Inst (BodyFun 0) [] []) (empty-plan) "fibm.ids" []) t elem))

;; ---- the dispatch over expression kinds

(defun val-flow :private (r: (Result V str)) -> (Result Flow str)
  (match r ((Ok v) (Ok (FlowVal v))) ((Err e) (Err e))))

;; A literal's value. Rust: lower/mod.rs:381 literal
(defun literal-value :private (cx: LowerCx e: Expr l: Lit) -> (Result V str)
  (match l
    ((LitInt n _) (try-let ((t (lcx-ty cx e)) (lt (program-lir (. cx p) t)))
                    (let ((l (unwrap-or lt LirI64)))
                      ;; An integer literal that took a float type (stdlib §7 L19).
                      (if (or (= l LirFloat) (= l LirDouble))
                          (Ok (VVal (nx/floating (lir-type l) (sitofp f64 n)) l))
                          (Ok (v-int l n))))))
    ;; A float literal that took the element type of a vector it is an operand of (types 1.9) has that type, not its own width.
    ((LitFloat x w) (try-let ((ty (lcx-ty cx e)) (lt (program-lir (. cx p) ty)))
                      (let ((t (match lt
                                 ((some (LirFloat)) LirFloat)
                                 ((some (LirDouble)) LirDouble)
                                 (_ (match w ((F32) LirFloat) ((F64) LirDouble))))))
                        (Ok (VVal (nx/floating (lir-type t) x) t)))))
    ((LitStr s) (Ok (VVal (nx/reference (statics-string (. (. cx p) statics) s 0)) LirPtr)))
    ((LitChar c) (Ok (v-int LirI32 (long c))))
    ((LitBool b) (Ok (v-int LirI1 (if b 1 0))))
    ((LitKeyword k) (Ok (v-int LirI64 (statics-keyword (. (. cx p) statics) k))))
    ((LitUnit) (Ok VUnit))))

;; What an expression yields, without the plan's operations after it. Rust: lower/mod.rs:361 form
(defun form :private (cx: LowerCx e: Expr) -> (Result Flow str)
  (match (. e kind)
    ((ELit l) (val-flow (literal-value cx e l)))
    ((ELocal b) (val-flow (lcx-local cx b)))
    ((EGlobal g) (val-flow (lcx-global cx e g)))
    ((ECall h args) (lcx-call cx e h args))
    ((EFn _) (val-flow (lcx-make-fn cx e)))
    ((ELet bs body) (lcx-let-form cx bs body))
    ((EIf c t f) (lcx-if-form cx e c t f))
    ((EDo es) (lcx-do-form cx es))
    ((EMatch s cls) (lcx-match-form cx e s cls))
    ((ELoop vs body) (lcx-loop-hoisted cx e vs body))
    ((ERecur args) (lcx-recur cx e args))
    ((EField x name _) (val-flow (lcx-field-of cx e x name)))
    ((EDeref pl _) (val-flow (if (contains? (. (. cx own) peeks) (. e id)) (lcx-peek-place cx pl) (lcx-deref-place cx pl))))
    ((ESet pl v) (val-flow (lcx-set-place cx pl v)))
    ((ESetField b f v) (val-flow (lcx-set-field cx b f v)))
    ((ETakeField b f) (val-flow (lcx-take-field cx b f)))
    ((EUnsafe b) (lcx-expr cx b))
    ((EDyn pr _ _ b) (val-flow (lcx-dyn-of cx pr b)))
    ((EConvert op t x) (try-let ((v (lcx-value cx x))) (val-flow (lcx-convert cx op t v))))
    ;; X5: the checker elaborates these away before the emitter sees the program (Rust: lower/mod.rs)
    ((EGuarded _) (Err "unsupported: an unelaborated form"))
    ((EAnd _) (Err "unsupported: an unelaborated form"))
    ((EOr _) (Err "unsupported: an unelaborated form"))
    ((EElided) (Err "unsupported: an unelaborated form"))
    ((EAsync _ _) (val-flow (lcx-make-async cx e)))
    ((EAwait x) (val-flow (lcx-await-task cx x)))
    ((EQuote f) (val-flow (lcx-quote cx e f)))
    ((EConcat es) (val-flow (lcx-concat cx e es)))
    ;; lane vectors (types 1.9; emit.lower.simd)
    ((ESimd _ es) (val-flow (lcx-simd cx e es)))
    ((ESplat _ x) (val-flow (lcx-splat cx e x)))))

;; Lowers an expression: its value, then the plan's operations (the hub's `expr`); `at` is the expression being lowered (E11: a trap
;; of a macro module carries its position, lcx-trap-c). Rust: lower/mod.rs:333 Cx::expr
(defun expr-step (cx: LowerCx e: Expr) -> (Result Flow str)
  (let ((outer @(. cx at)))
    (do (set! (. cx at) (some e))
        (try-let ((flow (form cx e)))
          (do (set! (. cx at) outer)
              (match flow
                ((FlowVal v)
                 (do (when (contains? (. cx value-sites) (. e id))
                       (set! (. cx values) (assoc @(. cx values) (. e id) v)))
                     (try-let ((ran (lcx-after cx (. e id)))) (Ok flow))))
                ((FlowJump) (Ok flow))))))))
