;; compiler/emit/lower/simdfn.fib: the functions of a float or an integer, scalar or vector, that are one lIR instruction (spec/lir.md 6.1, "Floating-point
;; functions and integer min/max"), the conversions between lane types (6.3), the shuffles and the constants of a vector type:
;;   simd/fma simd/muladd simd/sqrt simd/floor simd/ceil simd/trunc simd/round simd/round-even simd/abs simd/min simd/max simd/min-num simd/max-num
;;   simd/convert simd/bitcast simd/reverse simd/shuffle simd/lanes simd/kind
;; `simd/fma` is correctly rounded (one rounding, exactly IEEE `fma`). On a target without FMA hardware (docs/adr/0008: wasm, or an x86-64 CPU named below
;; x86-64-v3) it is not emulated and not a libm call: the call site gets a compile-time warning (once, `FILE:LINE:COL: warning: simd/fma has no hardware
;; support on T; ..`) and lowers to a trap with that message. `simd/muladd` is `fmuladd`: one fused instruction where the target has FMA, a multiply and
;; an add where it has not, so its result may differ in the last bit between targets; it is the portable one.
;; `simd/min` and `simd/max` are the NaN-propagating pair (`fmin`, `fmax`: a NaN operand gives NaN, `-0.0` is below `+0.0`), as the library's `min` and `max`;
;; `simd/min-num` and `simd/max-num` are IEEE minNum and maxNum (a NaN operand loses). `simd/abs` of an integer traps on the minimum, as `neg` does.
;; `simd/round` is to nearest with ties away from zero, `simd/round-even` ties to even. Memory access to arrays is emit.lower.simdmem.
(ns emit.lower.simdfn
  (:use types.ty types.ast types.decls emit.value emit.ir emit.program emit.layout emit.lower.cx emit.lower.simd))

(defun ty-of :private (x: V) -> LirTy (unwrap-or (v-ty x) LirI64))

;; The lIR instruction of a one-instruction function, `nil` when `name` is none.
(defun fn-instr :private (name: str fl: bool) -> (Option str)
  (cond (= name "simd/fma") (some "fma")
        (= name "simd/muladd") (some "fmuladd")
        (= name "simd/sqrt") (some "fsqrt")
        (= name "simd/floor") (some "ffloor")
        (= name "simd/ceil") (some "fceil")
        (= name "simd/trunc") (some "ftrunc")
        (= name "simd/round") (some "fround")
        (= name "simd/round-even") (some "froundeven")
        (= name "simd/abs") (some (if fl "fabs" "abs"))
        (= name "simd/min") (some (if fl "fmin" "smin"))
        (= name "simd/max") (some (if fl "fmax" "smax"))
        (= name "simd/min-num") (some "fminnum")
        (= name "simd/max-num") (some "fmaxnum")
        :else nil))

;; Traps when a lane (or the scalar) of `a` is the minimum of its integer type: the absolute value does not fit.
(defun abs-check :private (cx: LowerCx t: LirTy a: str) -> unit
  (let ((m (str (shl -1 (- (lir-ty-bits (elem-of t)) 1)))))
    (if (vec? t)
        (let ((amin (val cx (str-join ["(icmp eq " a " " (vconst t m) ")"]) (LirVec LirI1 (lanes-of t)))))
          (lcx-trap-if cx (val cx (str-join ["(reduce-or " (v-text amin) ")"]) LirI1) (str-join ["integer overflow in abs at " (vec-name t)])))
        (lcx-trap-if cx (val cx (str-join ["(icmp eq " a " (" (lir-ty-text t) " " m "))"]) LirI1)
                     (str-join ["integer overflow in abs at " (lir-ty-text t)])))))

(defun lcx-simd-fn (cx: LowerCx name: str a: (Vec V)) -> (Result V str)
  (let ((t (ty-of (nth a 0))))
    (match (fn-instr name (float-elem? t))
      (nil (Err (str-join ["unsupported: " name])))
      ((some op)
       (do (when (and (= name "simd/abs") (not (float-elem? t))) (abs-check cx t (v-text (nth a 0))))
           (when (and (= name "simd/fma") (not (. (g-target (program-g (. cx p))) has-fma))) (fma-trap cx))
           (Ok (val cx (str-join ["(" (if (= name "simd/fma") (fma-op cx) op) (str-join (mapv (fn (v: V) (str-concat " " (v-text v))) a)) ")"]) t)))))))

;; ---- simd/fma without FMA hardware (docs/adr/0008)

;; The name of the target in the message: FIB_TARGET_TRIPLE's triple, else the CPU the program is built for.
(defun fma-target-name :private (cx: LowerCx) -> str
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    ((some t) (if (or (= t "") (= t "host")) (. (g-target (program-g (. cx p))) cpu) t))
    (nil (. (g-target (program-g (. cx p))) cpu))))

(defun fma-message :private (cx: LowerCx) -> str
  (str-join ["simd/fma has no hardware support on " (fma-target-name cx) "; it traps at run time: use simd/muladd for portable code"]))

;; The instruction of `simd/fma`: `fma` where the target fuses; where it does not, the trap before it has ended the block's live path and the
;; value is never computed, so `fmuladd` (a multiply and an add, no libm call) stands in for the type's sake.
(defun fma-op :private (cx: LowerCx) -> str
  (if (. (g-target (program-g (. cx p))) has-fma) "fma" "fmuladd"))

;; The call site's warning (once per site, in the program's warnings) and an unconditional trap with the same message.
(defun fma-trap :private (cx: LowerCx) -> unit
  (let ((m (fma-message cx)))
    (do (match @(. cx at)
          ((some e) (g-warn (program-g (. cx p)) (str-join [(pos-text (. e pos)) ": warning: " m])))
          (nil (g-warn (program-g (. cx p)) (str-join ["warning: " m]))))
        (lcx-trap-if cx (v-int LirI1 1) m))))

;; ---- conversions

(defun elem-bits :private (e: LirTy) -> i64
  (cond (= e LirFloat) 32 (= e LirDouble) 64 :else (lir-ty-bits e)))

(defun float-lane? :private (e: LirTy) -> bool (or (= e LirFloat) (= e LirDouble)))

;; The cast instruction from lane type `from` to lane type `to`: nil when they are the same type.
(defun conv-instr :private (from: LirTy to: LirTy) -> (Option str)
  (let ((ff (float-lane? from)) (tf (float-lane? to)) (fb (elem-bits from)) (tb (elem-bits to)))
    (cond (and ff tf) (cond (> tb fb) (some "fpext") (< tb fb) (some "fptrunc") :else nil)
          ff (some "fptosi-sat")
          tf (some "sitofp")
          :else (cond (> tb fb) (some "sext") (< tb fb) (some "trunc") :else nil))))

;; `(simd/convert v)` to the vector type `to` of the same lane count: integers to floats, floats to integers (saturating, NaN to 0, as the scalar
;; `fptosi` of types 8.12), wider and narrower lanes (narrowing an integer keeps the low bits, as `trunc`).
(defun lcx-simd-convert (cx: LowerCx x: V to: LirTy) -> (Result V str)
  (let ((from (ty-of x)))
    (cond (not (and (vec? from) (vec? to))) (Err "simd/convert converts a vector to a vector")
          (or (= (elem-of from) LirI1) (= (elem-of to) LirI1)) (Err "simd/convert does not convert a mask")
          :else (match (conv-instr (elem-of from) (elem-of to))
                  (nil (Ok x))
                  ((some op) (Ok (val cx (str-join ["(" op " " (lir-ty-text to) " " (v-text x) ")"]) to)))))))

;; `(simd/bitcast v)` to the vector type `to` (the lane count is the same by the checker's signature): the bits of each lane are the bits of the lane of the
;; result, so the lanes must be as wide as each other (`f64x4` and `i64x4`, `f32x8` and `i32x8`); a mask is not a lane type here.
(defun lcx-simd-bitcast (cx: LowerCx x: V to: LirTy) -> (Result V str)
  (let ((from (ty-of x)))
    (cond (not (and (vec? from) (vec? to))) (Err "simd/bitcast reinterprets a vector as a vector")
          (or (= (elem-of from) LirI1) (= (elem-of to) LirI1)) (Err "simd/bitcast does not reinterpret a mask")
          (not (= (elem-bits (elem-of from)) (elem-bits (elem-of to))))
            (Err (str-join ["simd/bitcast: the lanes of " (vec-name from) " and " (vec-name to) " differ in width"]))
          (= from to) (Ok x)
          :else (Ok (val cx (str-join ["(bitcast " (lir-ty-text to) " " (v-text x) ")"]) to)))))

;; ---- movemask, ctz, clz (JSON-2)

;; `(simd/movemask m)`: the lanes of the mask as the low bits of an i64, lane 0 the lowest bit: `(bitcast iN m)` of the `<N x i1>` (one `pmovmskb`, `vpmovmskb`
;; or `kmov` on x86), the mask padded with false lanes up to 8, 16, 32 or 64 when it has other than those (the lIR has no `i3`), then `zext` to i64.
(defun lcx-movemask (cx: LowerCx x: V) -> V
  (let ((n (lanes-of (ty-of x))))
    (if (and (= (program-pb (. cx p)) 4) (> n 16) (= (rem n 16) 0))
      (lcx-movemask-halves cx x n)
      (lcx-movemask-whole cx x n))))

;; On wasm32 a mask of more than 16 lanes is read 16 lanes at a time: LLVM 21's WebAssembly backend turns `bitcast <32 x i1>` to `i32` into the wrong bits
;; (the lanes of the second half land in the wrong places), and `bitmask` is a 16-lane instruction anyway. Piece k of the mask is lanes 16k..16k+15 as an `i16`,
;; shifted to bit 16k.
(defun lcx-movemask-halves :private (cx: LowerCx x: V n: i64) -> V
  (let ((pieces (mapv (fn (k: i64)
                        (let ((half (val cx (str-join ["(shufflevector " (v-text x) " " (v-text x) " " (mask-text (vec (range (* 16 k) (* 16 (+ k 1))))) ")"]) (LirVec LirI1 16))))
                          (let ((b (val cx (str-join ["(bitcast i16 " (v-text half) ")"]) LirI16)))
                            (let ((z (val cx (str-join ["(zext i64 " (v-text b) ")"]) LirI64)))
                              (if (= k 0) z (val cx (str-join ["(shl " (v-text z) " (i64 " (str (* 16 k)) "))"]) LirI64))))))
                      (range (quot n 16)))))
    (reduce (fn (acc: V v: V) (val cx (str-join ["(or " (v-text acc) " " (v-text v) ")"]) LirI64)) (nth pieces 0) (drop 1 pieces))))

(defun lcx-movemask-whole :private (cx: LowerCx x: V n: i64) -> V
    (let ((w (cond (<= n 8) 8 (<= n 16) 16 (<= n 32) 32 :else 64)))
      (let ((wt (cond (= w 8) LirI8 (= w 16) LirI16 (= w 32) LirI32 :else LirI64))
            (m (if (= n w)
                   x
                   (val cx (str-join ["(shufflevector " (v-text x) " (zeroinitializer " (lir-ty-text (ty-of x)) ") "
                                      (mask-text (mapv (fn (i: i64) (if (< i n) i n)) (range w))) ")"]) (LirVec LirI1 w)))))
        (let ((b (val cx (str-join ["(bitcast " (lir-ty-text wt) " " (v-text m) ")"]) wt)))
          (if (= w 64) b (val cx (str-join ["(zext i64 " (v-text b) ")"]) LirI64))))))

;; `ctz x` and `clz x` of an integer: the lIR `cttz` and `ctlz` (a zero has as many zeros as the type has bits, never poison).
(defun lcx-count-zeros (cx: LowerCx name: str x: V) -> V
  (val cx (str-join ["(" (if (= name "ctz") "cttz" "ctlz") " " (v-text x) ")"]) (ty-of x)))

;; ---- shuffles and constants

;; The literal integer lanes of the call's argument `i`, when it is a vector literal of integer literals.
(defun literal-lanes :private (e: Expr i: i64) -> (Option (Vec i64))
  (match (. e kind)
    ((ECall _ args)
     (match (get args i)
       ((some (ArgExpr x))
        (match (. x kind)
          ((ESimd _ es)
           (let ((vs (mapv (fn (l: Expr) (match (. l kind) ((ELit (LitInt v _)) (some v)) (_ nil))) es)))
             (if (some? (find-first (fn (o: (Option i64)) (nil? o)) vs))
                 nil
                 (some (mapv (fn (o: (Option i64)) (unwrap-or o 0)) vs)))))
          (_ nil)))
       (_ nil)))
    (_ nil)))

;; `(simd/shuffle a b <<i0 i1 ..>>)`: lane k of the result is lane ik of the concatenation of `a` and `b`; the indices are a vector literal of
;; integer literals below twice the lane count.
(defun lcx-simd-shuffle (cx: LowerCx e: Expr a: V b: V) -> (Result V str)
  (let ((t (ty-of a)))
    (match (literal-lanes e 2)
      (nil (Err "simd/shuffle: the indices must be a vector literal of integer literals"))
      ((some idx)
       (if (some? (find-first (fn (i: i64) (or (< i 0) (>= i (* 2 (lanes-of t))))) idx))
           (Err (str-join ["simd/shuffle: an index is outside 0 .. " (str (- (* 2 (lanes-of t)) 1))]))
           (Ok (val cx (str-join ["(shufflevector " (v-text a) " " (v-text b) " " (mask-text idx) ")"]) (LirVec (elem-of t) (count idx)))))))))

(defun lcx-simd-reverse (cx: LowerCx x: V) -> V
  (let ((t (ty-of x)))
    (val cx (str-join ["(shufflevector " (v-text x) " " (v-text x) " " (mask-text (mapv (fn (i: i64) (- (- (lanes-of t) 1) i)) (range (lanes-of t)))) ")"]) t)))

;; The code of a lane type: the width of an integer, 100 plus the width of a float, 1 for a mask.
(defun lane-kind :private (e: LirTy) -> i64
  (cond (= e LirI1) 1 (float-lane? e) (+ 100 (elem-bits e)) :else (lir-ty-bits e)))

(defun lcx-simd-const (name: str x: V) -> V
  (let ((t (ty-of x)))
    (v-int LirI64 (if (= name "simd/lanes") (lanes-of t) (lane-kind (elem-of t))))))

(defun simd-fn-name? (name: str) -> bool
  (contains? (set ["simd/fma" "simd/muladd" "simd/bitcast" "simd/sqrt" "simd/floor" "simd/ceil" "simd/trunc" "simd/round" "simd/round-even" "simd/abs" "simd/min" "simd/max"
                   "simd/min-num" "simd/max-num" "simd/movemask" "ctz" "clz" "simd/convert" "simd/reverse" "simd/shuffle" "simd/lanes" "simd/kind"]) name))
