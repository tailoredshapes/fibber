;; adr.gen: the program a set of ADR blocks becomes (docs/design/executable-adrs.md §3). Each executable block is a module
;; `adrgen.bNNNN-K` with one function `suites` of the Repo; one `main` runs them all through fib.test.run, each scenario's id prefixed with
;; the block's tag `bNNNN-K`. Block code is the author's own text, kept line for line below the header, so a compiler message points at
;; the block (adr.run maps it back to the Markdown).
(ns adr.gen
  (:use fib.core fib.seq fib.coll fib.print fib.string adr.md fib.test.arch.scan))

;; The block's place in a run: the tag of its module and the Markdown line its code starts on.
(defstruct Unit (number: str index: i64 kind: str tag: str doc: str line: i64 text: str))

(defun pad-index (n: i64) -> str (if (< n 10) (str "0" n) (str n)))

(defun tag-of (number: str index: i64) -> str (str "b" number "-" (pad-index index)))

(defun definition? :private (head: str) -> bool
  (or (or (or (= head "defun") (= head "defn")) (or (= head "defmacro") (= head "def")))
      (or (or (or (= head "defstruct") (= head "defenum")) (or (= head "defprotocol") (= head "impl")))
          (or (or (= head "defrecord") (= head "defcontract")) (or (= head "derive") (= head "extern"))))))

;; `;; :use a b` and `;; :require [x :as y]` lines of a block: extra modules for its `ns`.
(defun directive (lines: (Vec str) key: str) -> str
  (join " " (mapv (fn (l: str) (trim (str-slice l (+ (str-len key) 3) (str-len l))))
                  (filterv (fn (l: str) (starts-with? l (str ";; " key))) lines))))

(defun default-uses :private () -> str "fib.core fib.seq fib.coll fib.print fib.string fib.test.core fib.test.gen fib.test.arch")

(defun header (u: Unit lines: (Vec str)) -> str
  (let ((uses (directive lines ":use")) (reqs (directive lines ":require")))
    (str ";; generated by fibc adr from " (. u doc) " block " (. u number) "." (. u index) " (line " (. u line) "); do not edit\n"
         "(ns adrgen." (. u tag) " (:use " (default-uses) " " uses ")" (if (= reqs "") "" (str " (:require " reqs ")")) ")\n")))

(defun suite-type :private (u: Unit) -> str
  (if (= (. u kind) "spec") "fib.test.core/Suite" "fib.test.arch/RuleDef"))

;; The block's line `i` (1-based) with the forms that are expressions wrapped where they stand: `(defun eN (repo: ..) -> T` goes before
;; the form, `)` after it. A form must begin its line and end its line without a trailing comment. Lines stay where the author put them.
(defun wrapped-line :private (u: Unit lines: (Vec str) exprs: (Vec Top) i: i64) -> str
  (let ((k (loop ((j 0)) (cond (>= j (count exprs)) -1 (= (. (nth exprs j) line) i) j :else (recur (+ j 1)))))
        (e (loop ((j 0)) (cond (>= j (count exprs)) -1 (= (. (nth exprs j) end) i) j :else (recur (+ j 1))))))
    (str (if (>= k 0) (str "(defun e" k " (repo: fib.test.arch/Repo) -> " (suite-type u) " ") "")
         (nth lines (- i 1))
         (if (>= e 0) ")" ""))))

(defun suites-fn :private (u: Unit n: i64) -> str
  (let ((calls (join " " (mapv (fn (k: i64) (str "(e" k " repo)")) (range n)))))
    (if (= (. u kind) "spec")
        (str "\n(defun suites (repo: fib.test.arch/Repo) -> (Vec fib.test.core/Suite) [" calls "])\n")
        (str "\n(defun suites (repo: fib.test.arch/Repo) -> (Vec fib.test.core/Suite) [(arch-suite \"" (. u kind) "\" repo [" calls "])])\n"))))

;; The module text of a unit; `(. u text)` is the block body. The two header lines come first: line L of the module is line
;; L + (fence line - 2) of the Markdown.
(defun module-text (u: Unit) -> str
  (let ((lines (split-lines (. u text)))
        (tops (read-tops (. u text))))
    (let ((exprs (filterv (fn (t: Top) (not (definition? (. t head)))) tops)))
      (str (header u lines)
           (join "\n" (mapv (fn (i: i64) (wrapped-line u lines exprs (+ i 1))) (range (count lines))))
           "\n" (suites-fn u (count exprs))))))

(defun main-text (us: (Vec Unit)) -> str
  (str "(ns main (:use fib.core fib.seq fib.coll fib.test.core fib.test.run fib.test.arch)\n  (:require "
       (join " " (mapv (fn (u: Unit) (str "[adrgen." (. u tag) " :as m" (. u tag) "]")) us)) "))\n\n"
       "(defun main () -> i64\n  (let ((repo (load-repo \".\" (default-dirs))))\n    (run-main (reduce (fn (a: (Vec Suite) b: (Vec Suite)) (into a b)) []\n      ["
       (join "\n       " (mapv (fn (u: Unit) (str "(retag \"" (. u tag) "\" (m" (. u tag) "/suites repo))")) us)) "]))))\n"))
