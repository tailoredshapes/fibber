;; compiler/types/display.fib: the printer of types and predicates (package P2).
;; Replaces crates/fibref/src/types/display.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.display
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust `Printer<'a>`: the names of the quantified and rigid variables, the
;; unification variables met so far (a RefCell: a Cell) and an optional
;; qualifier of the module a nominal type is printed with. P2 may change
;; the fields.
(defstruct Printer
  (g: Globals gen-names: (Vec str) rigid-names: (Vec str) vars: (Cell (Vec i64))
   qualifier: (Option (fn (i64) str))))

;; Rust: display.rs:31 Printer::new
(defun printer-new (g: Globals) -> Printer
  (trap "todo: printer-new"))

;; Rust: display.rs:37 with_names
(defun printer-with-names (g: Globals gen-names: (Vec str) rigid-names: (Vec str)) -> Printer
  (trap "todo: printer-with-names"))

;; Rust: display.rs:51 qualified
(defun printer-qualified (g: Globals prefix: (fn (i64) str)) -> Printer
  (trap "todo: printer-qualified"))

;; Rust: display.rs:66 Printer::ty
(defun printer-ty (p: Printer t: Ty) -> str
  (trap "todo: printer-ty"))

;; Rust: display.rs:74 Printer::pred
(defun printer-pred (p: Printer pr: Pred) -> str
  (trap "todo: printer-pred"))

;; Rust: display.rs:128 Printer::colour
(defun printer-colour (p: Printer k: Colour) -> str
  (trap "todo: printer-colour"))

;; Rust: display.rs:223 letter_name
(defun letter-name (i: i64) -> str
  (trap "todo: letter-name"))
