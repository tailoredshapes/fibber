;; compiler/types/infer/cx.fib: the inference context, the tables and the per-unit worklists (package P8).
;; Replaces crates/fibref/src/types/infer/cx.rs.
;; The data is P1's (P8 added nothing); the Rust `impl Cx` methods are the
;; `cx-NAME` functions below, `cx` borrowed, the Cells reached through it.
(ns types.infer.cx
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.display))

;; ---- the data of infer/cx.rs, fixed by P1 (P8 may add to it)

;; What is known of the functions and defs checked so far: the scheme of a
;; FunId and the type of a DefId (Rust `Vec<Option<_>>`: a Map, a missing
;; key is `None`).
(defstruct Env (funs: (Cell (Map i64 Scheme)) defs: (Cell (Map i64 Ty))))

;; How a use of a scheme was instantiated (cx.rs:28).
(defstruct Instantiation (tys: (Vec Ty) colours: (Vec Colour)))

;; What a method call resolved to (cx.rs:37): instance `index` at `args`, a
;; bound of the context, or a trait object.
(defenum Resolution
  (ResInstance index: i64 args: (Vec Ty))
  (ResBound pred: Pred)
  ResDyn)

;; What a unit's inference produced, by expression and binding (cx.rs:56).
(defstruct Tables
  (expr-types: (Cell (Map i64 Ty)) binding-types: (Cell (Map i64 Ty))
   instantiations: (Cell (Map i64 Instantiation))
   resolutions: (Cell (Map i64 Resolution)) fn-colours: (Cell (Map i64 Colour))
   kw-sites: (Cell (Map i64 KwSite))))

;; What a keyword in function position reads (cx.rs KwSite, X6): a field of a struct, or a key
;; of a `(Map keyword v)`. Read by the elaboration only.
(defenum KwSite KwField KwMap)
(derive Eq KwSite)

;; A constraint waiting for its types to be known (cx.rs:73, :86).
(defenum DKind
  (DkProto proto: i64 args: (Vec Ty) method: (Option i64))
  (DkSend ty: Ty path: (Vec str))
  (DkObject ty: Ty what: str)
  (DkWeakable ty: Ty)
  (DkField obj: Ty field: str result: Ty text: str)
  (DkDeref cell: Ty result: Ty text: str)
  (DkFloat ty: Ty)
  ;; the element of a lane vector of `lanes` lanes must be an integer width, f32, f64 or bool
  (DkSimdElem ty: Ty lanes: i64)
  ;; `(simd/bitcast v)` from the vector type `from` to `to`: the lanes must be as wide as each other, neither a mask
  (DkBitcast from: Ty to: Ty)
  ;; a keyword used as a function (X6, L14) at `site`: the argument `S`, the keyword, the result
  ;; `R`, the default's type for `(:k x d)`
  (DkKeyword site: i64 arg: Ty key: str result: Ty dflt: (Option Ty))
  ;; `[p..]` against a scrutinee not known yet: one type per element (cx.rs:107, X4)
  (DkVecPat s: Ty parts: (Vec Ty)))
(defstruct Deferred (kind: DKind pos: Pos site: (Option i64) fun: str))

;; What one attempt at solving a constraint did: solved (these constraints replace it) or not
;; decidable yet (here, from solve.fib, for types.infer.keyword).
(defenum Attempt (AtSolved new: (Vec Deferred)) AtStuck)

;; Why a type is not `Send`: the path to the offending type (cx.rs:107).
(defstruct Witness (path: (Vec str) offending: Ty))

;; Colour constraints (cx.rs:117, :132): `from ⊑ to`, and `colour ⊒ Caps{ty}`.
(defstruct ColourCon
  (from: Colour to: Colour label: (Option str) origin: (Option Witness) pos: Pos))
(defstruct CapsCon (colour: Colour ty: Ty label: str pos: Pos))

;; The monomorphic signature of a function of the SCC being inferred.
(defstruct MonoSig (params: (Vec Ty) amps: (Vec bool) names: (Vec str) ret: Ty))

;; A call of a polymorphically recursive function (Rust: infer/polyrec.rs:37;
;; here so that `Unit` need not depend on `types.infer.polyrec`).
(defstruct PolyCall (caller: i64 callee: i64 site: i64 pos: Pos))

;; The worklists of one unit (an SCC, an impl method, a def): a fresh one
;; per unit (Rust `Unit::default()`), every field a Cell.
(defstruct Unit
  (deferred: (Cell (Vec Deferred)) colours: (Cell (Vec ColourCon))
   caps: (Cell (Vec CapsCon)) rigid-names: (Cell (Vec str))
   rigid-map: (Cell (Map str i64)) rigid-colours: (Cell (Map str Colour))
   fun: (Cell str) mono: (Cell (Map i64 MonoSig)) poly: (Cell (Map i64 Scheme))
   poly-used: (Cell (Set i64)) cur: (Cell (Option i64))
   poly-calls: (Cell (Vec PolyCall)) poly-vars: (Cell (Map i64 (Vec i64)))
   loops: (Cell (Vec (Vec Ty))) givens: (Cell (Option (Vec Pred)))
   exprs: (Cell (Vec i64)) bindings: (Cell (Vec i64))
   fn-lits: (Cell (Vec (Pair i64 Colour))) insts: (Cell (Vec i64))
   sites: (Cell (Vec i64))))

;; The inference context (cx.rs:205): the globals (read only), the
;; environment, the store, the tables and the unit. Every function of
;; infer takes it first.
(defstruct Cx (g: Globals env: Env st: Store t: Tables u: Unit))

;; ---- constructors (written by P1)

(defun env-new () -> Env (Env (cell (map-empty)) (cell (map-empty))))

(defun tables-new () -> Tables
  (Tables (cell (map-empty)) (cell (map-empty)) (cell (map-empty))
          (cell (map-empty)) (cell (map-empty)) (cell (map-empty))))

(defun unit-new () -> Unit
  (Unit (cell []) (cell []) (cell []) (cell []) (cell (map-empty)) (cell (map-empty))
        (cell "") (cell (map-empty)) (cell (map-empty)) (cell (set-empty)) (cell nil)
        (cell []) (cell (map-empty)) (cell []) (cell nil) (cell []) (cell [])
        (cell []) (cell []) (cell [])))

;; ---- the methods of `impl Cx` (infer/cx.rs:218-281)

;; A fresh unification variable.
(defun cx-fresh (cx: Cx) -> Ty
  (store-fresh (. cx st)))

;; Records the type of an expression.
(defun cx-record (cx: Cx id: i64 ty: Ty) -> unit
  (do (set! (. (. cx t) expr-types) (assoc @(. (. cx t) expr-types) id ty))
      (set! (. (. cx u) exprs) (conj @(. (. cx u) exprs) id))))

;; Records the type of a binding.
(defun cx-bind (cx: Cx b: i64 ty: Ty) -> unit
  (do (set! (. (. cx t) binding-types) (assoc @(. (. cx t) binding-types) b ty))
      (set! (. (. cx u) bindings) (conj @(. (. cx u) bindings) b))))

;; The type of a binding (bound earlier in this unit).
(defun cx-binding (cx: Cx b: i64 pos: Pos) -> (Result Ty TypeError)
  (match (get @(. (. cx t) binding-types) b)
    ((some t) (Ok t))
    (nil (Err (type-error-other pos
                (str-join ["internal: " (. (g-binding (. cx g) b) name) " has no type"]))))))

;; Adds a deferred constraint, tagged with the unit's current function.
(defun cx-defer (cx: Cx kind: DKind pos: Pos site: (Option i64)) -> unit
  (set! (. (. cx u) deferred)
        (conj @(. (. cx u) deferred) (Deferred kind pos site @(. (. cx u) fun)))))

;; A zonked type.
(defun cx-zonk (cx: Cx t: Ty) -> Ty
  (store-zonk (. cx st) t))

;; The type as text (zonked first, a printer of its own).
(defun cx-show (cx: Cx t: Ty) -> str
  (let ((z (store-zonk-default (. cx st) t)))
    (printer-ty (printer-with-names (. cx g) [] @(. (. cx u) rigid-names)) z)))

;; `cannot unify a with b`: the two types zonked, printed by one printer
;; (so an unbound variable has the same name in both).
(defun cx-mismatch (cx: Cx a: Ty b: Ty pos: Pos) -> TypeError
  (match (literal-range-error cx a b)
    ((some m) (type-error Unify pos m))
    (nil (cx-mismatch-plain cx a b pos))))

;; A literal that does not fit the integer width it meets (L26 a): `the literal 300 does not fit i8 (-128..127)`; nil for any other mismatch. `a` or `b` is an
;; unbound literal variable (it holds the magnitude of the largest literal that shares it) and the other is `i8`, `i16` or `i32`.
(defun literal-range-error :private (cx: Cx a: Ty b: Ty) -> (Option str)
  (let ((ra (store-resolve (. cx st) a))
        (rb (store-resolve (. cx st) b)))
    (match (lit-width-pair cx ra rb)
      ((some m) (some m))
      (nil (lit-width-pair cx rb ra)))))

(defun lit-width-pair :private (cx: Cx lit: Ty other: Ty) -> (Option str)
  (match lit
    ((TVar v)
     (match (store-lit-of (. cx st) v)
       ((some m)
        (match other
          ((TCon (KScalar s) _)
           (cond (= s SI32) (if (> m 2147483647) (some (lit-range-text m "i32" "-2147483648..2147483647")) nil)
                 (= s SI16) (if (> m 32767) (some (lit-range-text m "i16" "-32768..32767")) nil)
                 (= s SI8) (if (> m 127) (some (lit-range-text m "i8" "-128..127")) nil)
                 :else nil))
          (_ nil)))
       (nil nil)))
    (_ nil)))

(defun lit-range-text :private (m: i64 w: str range: str) -> str
  (str-join ["the literal " (show m) " does not fit " w " (" range "): write it with a suffix of a width that holds it, or convert the other operand"]))

(defun cx-mismatch-plain :private (cx: Cx a: Ty b: Ty pos: Pos) -> TypeError
  (let ((za (store-zonk-default (. cx st) a))
        (zb (store-zonk-default (. cx st) b))
        (p (printer-with-names (. cx g) [] @(. (. cx u) rigid-names))))
    (type-error Unify pos
      (str-join ["cannot unify " (printer-ty p za) " with " (printer-ty p zb)]))))
