;; compiler/types/infer/call.fib: calls, instantiation and constructors (package P11).
;; Replaces crates/fibref/src/types/infer/call.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
;; The mutual recursion of `cx-call` and `cx-infer` (infer/expr.rs): `cx-call` and the pattern functions take `infer` as a :borrow function parameter
;; (plan section 2), P11 decides the final signatures.
(ns types.infer.call
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.infer.cx))

;; Rust: infer/call.rs:54 ann
(defun cx-ann (cx: Cx a: TypeAnn pos: Pos) -> (Result Ty TypeError)
  (trap "todo: cx-ann"))

;; Rust: infer/call.rs:68 instantiate
(defun cx-instantiate (cx: Cx s: Scheme site: i64 who: str pos: Pos method: (Option i64)) -> Ty
  (trap "todo: cx-instantiate"))

;; Rust: infer/call.rs:118 global_value
(defun cx-global-value (cx: Cx id: i64 r: GlobalRef pos: Pos) -> (Result Ty TypeError)
  (trap "todo: cx-global-value"))

;; Rust: infer/call.rs:246 call
(defun cx-call (cx: Cx e: Expr head: Expr args: (Vec Arg)) -> (Result Ty TypeError)
  (trap "todo: cx-call"))

;; Rust: infer/call.rs:370
(defun ctor-is-fn (g: Globals t: i64 v: (Option i64)) -> bool
  (trap "todo: ctor-is-fn"))

;; Rust: infer/call.rs:395
(defun ctor-scheme (g: Globals t: i64 v: (Option i64)) -> Scheme
  (trap "todo: ctor-scheme"))
