;; compiler/types/infer/send.fib: the Send judgement (package P8).
;; Replaces crates/fibref/src/types/infer/send.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.infer.send
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.infer.cx))

;; Rust `Needs` (infer/send.rs:25): the variables and colours a type being
;; `Send` still depends on, each with the path to it.
(defstruct Needs
  (vars: (Vec (Pair Ty (Vec str))) colours: (Vec (Pair Colour (Vec str)))))

;; Rust: infer/send.rs:34
(defun send-eval (g: Globals st: Store ty: Ty path: (Vec str)) -> (Result Needs Witness)
  (trap "todo: send-eval"))

;; Rust: infer/send.rs:142
(defun send-error (g: Globals w: Witness pos: Pos rigid: (Vec str)) -> TypeError
  (trap "todo: send-error"))
