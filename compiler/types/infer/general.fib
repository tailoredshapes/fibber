;; compiler/types/infer/general.fib: generalisation (package P10).
;; Replaces crates/fibref/src/types/infer/general.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.infer.general
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.infer.cx types.infer.colour))

;; Rust `Key`, `Closed`, `GenMap` (infer/general.rs:24, :49, :60): a
;; variable to quantify (a unification variable or a rigid one), the
;; closed variable sets and predicates, and the numbering of the quantified
;; variables. P10 may change the fields of `GenMap`.
(defenum Key (KeyVar tv: i64) (KeyRigid index: i64))
(derive Eq Key) (derive Hash Key)
(defstruct Closed
  (sets: (Vec (Vec Key)) colours: Colours preds: (Vec (Pair Pred (Option i64)))))
(defstruct GenMap
  (vars: (Map Key i64) names: (Vec str) colours: Colours colour-gen: (Map i64 i64)))

;; Rust: infer/general.rs:32 keys
(defun general-keys (st: Store t: Ty) -> (Vec Key)
  (trap "todo: general-keys"))

;; Rust: infer/general.rs:71 GenMap::new
(defun genmap-new (cx: Cx order: (Vec Key) colours: Colours colour-roots: (Vec Ty)) -> GenMap
  (trap "todo: genmap-new"))

;; Rust: infer/general.rs:118 n_colours
(defun genmap-n-colours (m: GenMap) -> i64
  (trap "todo: genmap-n-colours"))

;; Rust: infer/general.rs:123 colour
(defun genmap-colour (m: GenMap k: Colour) -> Colour
  (trap "todo: genmap-colour"))

;; Rust: infer/general.rs:141 apply
(defun genmap-apply (m: GenMap st: Store t: Ty) -> Ty
  (trap "todo: genmap-apply"))

;; Rust: infer/general.rs:156 pred
(defun genmap-pred (m: GenMap st: Store p: Pred) -> Pred
  (trap "todo: genmap-pred"))

;; Rust: infer/general.rs:162 colour_bounds
(defun genmap-colour-bounds (m: GenMap st: Store) -> (Vec ColourBound)
  (trap "todo: genmap-colour-bounds"))

;; Rust: infer/general.rs:206 close
(defun cx-close (cx: Cx roots: (Vec Ty)) -> (Result Closed TypeError)
  (trap "todo: cx-close"))

;; Rust: infer/general.rs:351 finalize
(defun cx-finalize (cx: Cx map: GenMap closed: Closed) -> unit
  (trap "todo: cx-finalize"))

;; Rust: infer/general.rs:396 scheme
(defun cx-scheme (cx: Cx map: GenMap closed: Closed i: i64 root: Ty amps: (Vec bool) params: (Vec str)) -> Scheme
  (trap "todo: cx-scheme"))
