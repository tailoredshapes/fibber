;; compiler/types/infer/colour.fib: colour inference (package P9).
;; Replaces crates/fibref/src/types/infer/colour.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.infer.colour
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.infer.cx))

;; Rust `Colours` (infer/colour.rs:33): the colours raised, the colour
;; variables that must be send, and the constraints kept symbolic.
(defstruct Colours
  (raised: (Map i64 Colour) must-send: (Set i64)
   symbolic: (Vec (Pair Colour Ty)) flows: (Vec (Pair Colour Colour))))

;; Rust: infer/colour.rs:48 Colours::value
(defun colours-value (c: Colours k: Colour) -> Colour
  (trap "todo: colours-value"))

;; Rust: infer/colour.rs:64 solve_colours
(defun cx-solve-colours (cx: Cx) -> (Result Colours TypeError)
  (trap "todo: cx-solve-colours"))
