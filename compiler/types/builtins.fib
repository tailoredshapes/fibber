;; compiler/types/builtins.fib: the builtin table (package P6), as
;; crates/fibref/src/types/builtins.rs (75 rows, the sixteen `sys-` rows of S5 after `write-file`): the
;; builtins and primitives of syntax §4.3 with the escape kind of every
;; parameter (for the ownership pass, types §6.3), and the built-in
;; protocols of §2.9 and §2.12 as fibber source. Signatures are in the type
;; syntax of §1 and are read at start-up (types.init) by the code that
;; reads annotations; `(& T)` marks an `&` position; an omitted colour on a
;; function-typed parameter is a fresh quantified colour variable. Every
;; builtin is a named function, so its own colour is `:send`. `deref` is the
;; method of the built-in `Deref` protocol; `concat` is variadic and has its
;; own rule. The primitive forms `set-field!`, `dyn` and the conversions
;; have rules of their own, not signatures, and are not in the table.
;;
;; The table is data, generated from the Rust table by a script (not kept):
;; one `BuiltinSig` a row, in the Rust order (a `def`'s initialiser is a
;; constant expression, which cannot call the Rust `b` and `u` helpers).
;; Shapes decided where Rust and fibber differ: the variants of `Escape`
;; carry the prefix `Esc` (`EscStore` is Rust's `Escape::Store`);
;; `BUILTINS` is the `def` `builtins`, and `builtin-table` gives it.
(ns types.builtins)

;; How a builtin's argument escapes (builtins.rs:21): a scalar (no count), a
;; borrow (read during the call), stored into the object the builtin
;; returns or updates (E2), consumed by a thread crossing (E4), an `&`
;; position (the variable's own cell), the operand of `weak`, the operand
;; of `raw`.
(defenum Escape EscScalar EscBorrow EscStore EscThread EscInOut EscWeak EscRaw)
(derive Eq Escape)

;; One row of the builtin table: the name, its signature and bounds as
;; text, how each argument escapes, and whether it needs `unsafe`.
(defstruct BuiltinSig
  (name: str sig: str bounds: str escapes: (Vec Escape) unsafe-only: bool))

;; Every builtin function, by BuiltinId (builtins.rs:83 BUILTINS).
(def builtins: (Vec BuiltinSig) :private
  [
   (BuiltinSig "cell" "(fn (a) (Cell a))" "" [EscStore] false)
   (BuiltinSig "set!" "(fn ((Cell a) a) unit)" "" [EscBorrow EscStore] false)
   (BuiltinSig "atom" "(fn (a) (Atom a))" "((Send a))" [EscStore] false)
   (BuiltinSig "swap!" "(fn ((Atom a) (fn (a) a)) a)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "reset!" "(fn ((Atom a) a) unit)" "" [EscBorrow EscStore] false)
   (BuiltinSig "compare-and-set!" "(fn ((Atom a) a a) bool)" "" [EscBorrow EscBorrow EscStore] false)
   (BuiltinSig "weak" "(fn (a) (Weak a))" "((Weakable a))" [EscWeak] false)
   (BuiltinSig "spawn" "(fn ((fn :send () a)) (Task a))" "((Send a))" [EscThread] false)
   (BuiltinSig "join" "(fn ((Task a)) a)" "" [EscBorrow] false)
   (BuiltinSig "task-failure" "(fn ((Task a)) (Option str))" "" [EscBorrow] false)
   (BuiltinSig "trap" "(fn (str) a)" "" [EscBorrow] false)
   (BuiltinSig "not" "(fn (bool) bool)" "" [EscScalar] false)
   (BuiltinSig "array" "(fn (i64 a) (Array a))" "" [EscScalar EscStore] false)
   (BuiltinSig "array-len" "(fn ((Array a)) i64)" "" [EscBorrow] false)
   (BuiltinSig "array-get" "(fn ((Array a) i64) a)" "" [EscBorrow EscScalar] false)
   (BuiltinSig "array-with" "(fn ((Array a) i64 a) (Array a))" "" [EscStore EscScalar EscStore] false)
   (BuiltinSig "array-copy" "(fn ((Array a) i64 i64) (Array a))" "" [EscBorrow EscScalar EscScalar] false)
   (BuiltinSig "array-set!" "(fn ((& (Array a)) i64 a) unit)" "" [EscInOut EscScalar EscStore] false)
   (BuiltinSig "cell-update!" "(fn ((Cell a) (fn :send (a) a)) unit)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "array-take!" "(fn ((& (Array a)) i64) a)" "" [EscInOut EscScalar] false)
   (BuiltinSig "array-push!" "(fn ((& (Array a)) a) unit)" "" [EscInOut EscStore] false)
   (BuiltinSig "array-pop!" "(fn ((& (Array a))) a)" "" [EscInOut] false)
   (BuiltinSig "str-len" "(fn (str) i64)" "" [EscBorrow] false)
   (BuiltinSig "str-bytes" "(fn (str) (Array i8))" "" [EscBorrow] false)
   (BuiltinSig "str-from-bytes" "(fn ((Array i8)) str)" "" [EscBorrow] false)
   (BuiltinSig "args" "(fn () (Vec str))" "" [] false)
   (BuiltinSig "read-file" "(fn (str) (Option str))" "" [EscBorrow] false)
   (BuiltinSig "write-file" "(fn (str str) bool)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "sys-open" "(fn (str i64 i64) i64)" "" [EscBorrow EscScalar EscScalar] false)
   (BuiltinSig "sys-close" "(fn (i64) i64)" "" [EscScalar] false)
   (BuiltinSig "sys-read" "(fn (i64 i64) (Array i8))" "" [EscScalar EscScalar] false)
   (BuiltinSig "sys-write" "(fn (i64 (Array i8) i64 i64) i64)" "" [EscScalar EscBorrow EscScalar EscScalar] false)
   (BuiltinSig "sys-seek" "(fn (i64 i64 i64) i64)" "" [EscScalar EscScalar EscScalar] false)
   (BuiltinSig "sys-pipe" "(fn () i64)" "" [] false)
   (BuiltinSig "sys-dup" "(fn (i64) i64)" "" [EscScalar] false)
   (BuiltinSig "sys-isatty" "(fn (i64) bool)" "" [EscScalar] false)
   (BuiltinSig "sys-unlink" "(fn (str) i64)" "" [EscBorrow] false)
   (BuiltinSig "sys-mkdir" "(fn (str i64) i64)" "" [EscBorrow EscScalar] false)
   (BuiltinSig "sys-rmdir" "(fn (str) i64)" "" [EscBorrow] false)
   (BuiltinSig "sys-errno-text" "(fn (i64) str)" "" [EscScalar] false)
   (BuiltinSig "sys-getenv" "(fn (str) (Option str))" "" [EscBorrow] false)
   (BuiltinSig "sys-clock-now" "(fn () i64)" "" [] false)
   (BuiltinSig "sys-thread-stripe" "(fn () i64)" "" [] false)
   (BuiltinSig "sys-wall-now" "(fn () i64)" "" [] false)
   (BuiltinSig "sys-sleep" "(fn (i64) i64)" "" [EscScalar] false)
   (BuiltinSig "str-concat" "(fn (str str) str)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "str-slice" "(fn (str i64 i64) str)" "" [EscBorrow EscScalar EscScalar] false)
   (BuiltinSig "str-byte-at" "(fn (str i64) i8)" "" [EscBorrow EscScalar] false)
   (BuiltinSig "str-find" "(fn (str str i64) (Option i64))" "" [EscBorrow EscBorrow EscScalar] false)
   (BuiltinSig "str-eq" "(fn (str str) bool)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "starts-with?" "(fn (str str) bool)" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "char->i32" "(fn (char) i32)" "" [EscScalar] false)
   (BuiltinSig "i32->char" "(fn (i32) char)" "" [EscScalar] false)
   (BuiltinSig "f64->bits" "(fn (f64) i64)" "" [EscScalar] false)
   (BuiltinSig "bits->f64" "(fn (i64) f64)" "" [EscScalar] false)
   (BuiltinSig "f32->bits" "(fn (f32) i32)" "" [EscScalar] false)
   (BuiltinSig "bits->f32" "(fn (i32) f32)" "" [EscScalar] false)
   (BuiltinSig "concat" "(fn ((Vec a) (Vec a)) (Vec a))" "" [EscBorrow EscBorrow] false)
   (BuiltinSig "gensym" "(fn (str) Form)" "" [EscBorrow] false)
   (BuiltinSig "struct?" "(fn (Form) bool)" "" [EscBorrow] false)
   (BuiltinSig "struct-fields" "(fn (Form) (Vec Form))" "" [EscBorrow] false)
   (BuiltinSig "struct-params" "(fn (Form) (Vec Form))" "" [EscBorrow] false)
   (BuiltinSig "struct-field-types" "(fn (Form) (Vec Form))" "" [EscBorrow] false)
   (BuiltinSig "enum?" "(fn (Form) bool)" "" [EscBorrow] false)
   (BuiltinSig "enum-params" "(fn (Form) (Vec Form))" "" [EscBorrow] false)
   (BuiltinSig "enum-variants" "(fn (Form) (Vec Form))" "" [EscBorrow] false)
   (BuiltinSig "ptr+" "(fn (ptr i64) ptr)" "" [EscScalar EscScalar] true)
   (BuiltinSig "load-i8" "(fn (ptr) i8)" "" [EscScalar] true)
   (BuiltinSig "load-i16" "(fn (ptr) i16)" "" [EscScalar] true)
   (BuiltinSig "load-i32" "(fn (ptr) i32)" "" [EscScalar] true)
   (BuiltinSig "load-i64" "(fn (ptr) i64)" "" [EscScalar] true)
   (BuiltinSig "load-ptr" "(fn (ptr) ptr)" "" [EscScalar] true)
   (BuiltinSig "store-i8" "(fn (ptr i8) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-i16" "(fn (ptr i16) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-i32" "(fn (ptr i32) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-i64" "(fn (ptr i64) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-ptr" "(fn (ptr ptr) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "alloc" "(fn (i64) ptr)" "" [EscScalar] true)
   (BuiltinSig "free" "(fn (ptr) unit)" "" [EscScalar] true)
   (BuiltinSig "raw" "(fn (a) ptr)" "((Object a))" [EscRaw] true)
   (BuiltinSig "raw-retained" "(fn (a) ptr)" "((Object a))" [EscStore] true)
   (BuiltinSig "release-raw" "(fn (ptr) unit)" "" [EscScalar] true)
   ;; lane vectors (SIMD wave 2, P1; spec/types.md 1.9): not in the Rust table. A comparison gives a mask.
   (BuiltinSig "simd/lt" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/le" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/gt" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/ge" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/eq" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/ne" "(fn ((Simd t n) (Simd t n)) (Simd bool n))" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "lane" "(fn ((Simd t n) i64) t)" "" [EscScalar EscScalar] false)
   (BuiltinSig "with-lane" "(fn ((Simd t n) i64 t) (Simd t n))" "" [EscScalar EscScalar EscScalar] false)
   (BuiltinSig "hsum" "(fn ((Simd t n)) t)" "((Num t))" [EscScalar] false)
   (BuiltinSig "hmin" "(fn ((Simd t n)) t)" "((Num t))" [EscScalar] false)
   (BuiltinSig "hmax" "(fn ((Simd t n)) t)" "((Num t))" [EscScalar] false)
   ;; mask logic and selection (design 2.6)
   (BuiltinSig "simd/and" "(fn ((Simd bool n) (Simd bool n)) (Simd bool n))" "" [EscScalar EscScalar] false)
   (BuiltinSig "simd/or" "(fn ((Simd bool n) (Simd bool n)) (Simd bool n))" "" [EscScalar EscScalar] false)
   (BuiltinSig "simd/xor" "(fn ((Simd bool n) (Simd bool n)) (Simd bool n))" "" [EscScalar EscScalar] false)
   (BuiltinSig "simd/not" "(fn ((Simd bool n)) (Simd bool n))" "" [EscScalar] false)
   (BuiltinSig "simd/any" "(fn ((Simd bool n)) bool)" "" [EscScalar] false)
   (BuiltinSig "simd/all" "(fn ((Simd bool n)) bool)" "" [EscScalar] false)
   (BuiltinSig "simd/blend" "(fn ((Simd bool n) (Simd t n) (Simd t n)) (Simd t n))" "" [EscScalar EscScalar EscScalar] false)
   ;; the wrapping family (spec/stdlib.md 7 L10), for an integer or an integer vector: the opt-out of the checked `+ - *` and `neg`
   (BuiltinSig "unchecked-add" "(fn (t t) t)" "((Bits t))" [EscScalar EscScalar] false)
   (BuiltinSig "unchecked-subtract" "(fn (t t) t)" "((Bits t))" [EscScalar EscScalar] false)
   (BuiltinSig "unchecked-multiply" "(fn (t t) t)" "((Bits t))" [EscScalar EscScalar] false)
   (BuiltinSig "unchecked-negate" "(fn (t) t)" "((Bits t))" [EscScalar] false)
   ;; Unaligned raw float accesses for trusted numerical kernels. Append to preserve builtin ids.
   (BuiltinSig "load-f32" "(fn (ptr) f32)" "" [EscScalar] true)
   (BuiltinSig "load-f64" "(fn (ptr) f64)" "" [EscScalar] true)
   (BuiltinSig "store-f32" "(fn (ptr f32) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-f64" "(fn (ptr f64) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "load-f32x4" "(fn (ptr) (Simd f32 4))" "" [EscScalar] true)
   (BuiltinSig "load-f64x4" "(fn (ptr) (Simd f64 4))" "" [EscScalar] true)
   (BuiltinSig "store-f32x4" "(fn (ptr (Simd f32 4)) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "store-f64x4" "(fn (ptr (Simd f64 4)) unit)" "" [EscScalar EscScalar] true)
   (BuiltinSig "array-uninit-f32" "(fn (i64) (Array f32))" "" [EscScalar] true)
   (BuiltinSig "array-uninit-f64" "(fn (i64) (Array f64))" "" [EscScalar] true)
   (BuiltinSig "load-f32x8" "(fn (ptr) (Simd f32 8))" "" [EscScalar] true)
   (BuiltinSig "store-f32x8" "(fn (ptr (Simd f32 8)) unit)" "" [EscScalar EscScalar] true)
   ;; lane-vector functions, shuffles, conversions and array access (SIMD wave 4, P4b; spec/types.md 1.9, emit.lower.simdfn and emit.lower.simdmem)
   (BuiltinSig "simd/lanes" "(fn ((Simd t n)) i64)" "" [EscScalar] false)
   (BuiltinSig "simd/kind" "(fn ((Simd t n)) i64)" "" [EscScalar] false)
   (BuiltinSig "simd/fma" "(fn (t t t) t)" "((Float t))" [EscScalar EscScalar EscScalar] false)
   (BuiltinSig "simd/sqrt" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/floor" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/ceil" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/trunc" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/round" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/round-even" "(fn (t) t)" "((Float t))" [EscScalar] false)
   (BuiltinSig "simd/abs" "(fn (t) t)" "((Num t))" [EscScalar] false)
   (BuiltinSig "simd/min" "(fn (t t) t)" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/max" "(fn (t t) t)" "((Num t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/min-num" "(fn (t t) t)" "((Float t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/max-num" "(fn (t t) t)" "((Float t))" [EscScalar EscScalar] false)
   (BuiltinSig "simd/convert" "(fn ((Simd s n)) (Simd t n))" "((Num s) (Num t))" [EscScalar] false)
   (BuiltinSig "simd/reverse" "(fn ((Simd t n)) (Simd t n))" "" [EscScalar] false)
   (BuiltinSig "simd/shuffle" "(fn ((Simd t n) (Simd t n) (Simd i64 m)) (Simd t m))" "" [EscScalar EscScalar EscScalar] false)
   (BuiltinSig "simd-load" "(fn ((Array t) i64) (Simd t n))" "" [EscBorrow EscScalar] false)
   (BuiltinSig "simd-load-unchecked" "(fn ((Array t) i64) (Simd t n))" "" [EscBorrow EscScalar] true)
   (BuiltinSig "simd-load-tail" "(fn ((Array t) i64) (Simd t n))" "" [EscBorrow EscScalar] false)
   (BuiltinSig "simd-load-masked" "(fn ((Array t) i64 (Simd bool n) (Simd t n)) (Simd t n))" "" [EscBorrow EscScalar EscScalar EscScalar] false)
   (BuiltinSig "simd-store!" "(fn ((& (Array t)) i64 (Simd t n)) unit)" "" [EscInOut EscScalar EscScalar] false)
   (BuiltinSig "simd-store-unchecked!" "(fn ((& (Array t)) i64 (Simd t n)) unit)" "" [EscInOut EscScalar EscScalar] true)
   (BuiltinSig "simd-store-tail!" "(fn ((& (Array t)) i64 (Simd t n)) unit)" "" [EscInOut EscScalar EscScalar] false)
   (BuiltinSig "simd-store-masked!" "(fn ((& (Array t)) i64 (Simd t n) (Simd bool n)) unit)" "" [EscInOut EscScalar EscScalar EscScalar] false)
   ;; SC1: `simd/muladd` is `a*b+c` fused where the target has an FMA and multiply-then-add where it has not (lIR `fmuladd`); `simd/bitcast` reinterprets
   ;; the bits of every lane as the lane type of the context (the lane widths must agree: checked by the lowering)
   (BuiltinSig "simd/muladd" "(fn (t t t) t)" "((Float t))" [EscScalar EscScalar EscScalar] false)
   (BuiltinSig "simd/bitcast" "(fn ((Simd s n)) (Simd t n))" "((Num s) (Num t))" [EscScalar] false)
])

;; Rust: builtins.rs:83 BUILTINS
(defun builtin-table () -> (Vec BuiltinSig) builtins)

;; The index of the builtin `name` in the table (builtins.rs:183 builtin_index).
(defun builtin-index (name: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (count builtins)) nil
          (= (. (nth builtins i) name) name) (some i)
          :else (recur (+ i 1)))))

;; The built-in protocols: `Deref` (§2.9) and the arithmetic, comparison,
;; bit, hash and show protocols of §2.12, whose built-in instances
;; types.init registers (builtins.rs:193 BUILTIN_PROTOCOLS). `Num` has
;; `quot`, the truncating division, and no `/`: `/` is the method of the
;; library's `Div` (fib.core).
(def builtin-protocols: str "
(defprotocol (Deref c t) (deref (self) -> t))
(defprotocol Num
  (+ (self y: Self) -> Self) (- (self y: Self) -> Self) (* (self y: Self) -> Self)
  (quot (self y: Self) -> Self) (rem (self y: Self) -> Self)
  (neg (self) -> Self))
(defprotocol Float (fdiv (self y: Self) -> Self))
(defprotocol Eq (= (self y: Self) -> bool) (!= (self y: Self) -> bool (not (= self y))))
(defprotocol Ord :requires (Eq)
  (< (self y: Self) -> bool) (<= (self y: Self) -> bool (not (< y self)))
  (> (self y: Self) -> bool (< y self)) (>= (self y: Self) -> bool (not (< self y))))
(defprotocol Bits
  (bit-and (self y: Self) -> Self) (bit-or (self y: Self) -> Self)
  (bit-xor (self y: Self) -> Self) (bit-not (self) -> Self)
  (shl (self n: Self) -> Self) (shr (self n: Self) -> Self)
  (sar (self n: Self) -> Self) (popcount (self) -> Self))
(defprotocol Hash (hash (self) -> i64))
(defprotocol Show (show (self) -> str))
")

;; The conversions of §2.12 whose first operand is a target type
;; (builtins.rs:214 CONVERSIONS).
(def conversions: (Vec str)
  ["trunc" "zext" "sext" "fptrunc" "fpext" "fptosi" "fptoui" "sitofp" "uitofp"])
