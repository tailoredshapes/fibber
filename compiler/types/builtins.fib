;; compiler/types/builtins.fib: the builtin table (package P6; the table is generated by a Rust script).
;; Replaces crates/fibref/src/types/builtins.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.builtins
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; How a builtin's argument escapes (builtins.rs:21).
(defenum Escape EscScalar EscBorrow EscStore EscThread EscInOut EscWeak EscRaw)
(derive Eq Escape)

;; One row of the builtin table: the name, its signature and bounds as
;; text, how each argument escapes, and whether it needs `unsafe`.
(defstruct BuiltinSig
  (name: str sig: str bounds: str escapes: (Vec Escape) unsafe-only: bool))

;; Rust: builtins.rs:83 BUILTINS
(defun builtin-table () -> (Vec BuiltinSig)
  (trap "todo: builtin-table"))

;; Rust: builtins.rs:183 builtin_index
(defun builtin-index (name: str) -> (Option i64)
  (trap "todo: builtin-index"))
