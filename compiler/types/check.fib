;; compiler/types/check.fib: what the unit programs of
;; compiler/tests/types/ share: `check` prints `ok NAME` or `FAIL NAME`
;; for a condition and counts the failures in a Cell, which the program
;; ends with (`finish`: 0 when every check held, 1 otherwise).
(ns types.check)

(defstruct Checks (failed: (Cell i64)))

(defun checks-new () -> Checks (Checks (cell 0)))

(defun check (cs: Checks name: str ok: bool) -> unit
  (if ok
      (println (str-join ["ok " name]))
      (do (set! (. cs failed) (+ @(. cs failed) 1))
          (println (str-join ["FAIL " name])))))

;; The exit status: 0 if no check failed.
(defun finish (cs: Checks) -> i64
  (if (= @(. cs failed) 0) 0 1))
