;; compiler/types/dump.fib: the types dump of spec/bootstrap.md §6.1, as
;; crates/fibref/src/types_dump/mod.rs (430 lines): for a file, the header `== FILE`
;; and then the sections of every module of the program that the checker accepts,
;; or the expander's error record, or the `error` records of the step that failed,
;; or the line `unreadable`. The sections are in types.dump.sections, the numbering
;; of variables in types.dump.normal.
;;
;; Shapes decided where Rust and fibber differ (see also expand.dump, whose
;; shapes these are):
;; - `types_files(files, opts) -> (String, u8)` is the loop of the tool
;;   (compiler/types.fib), which prints each file's output as it is made:
;;   `types-file` is one iteration, giving the lines of the file's section (the
;;   header first, a line that holds a line break being one element) and the
;;   status it adds (0 typed, 1 an error record, 2 unreadable).
;; - the check of an expanded program is a parameter of `dump-file` (a function from the
;;   expanded modules to what is printed: the type checker's `check-and-dump`, or the
;;   ownership pass's of own.dump), so that the file loop, the read, load and expand
;;   records are written once; `types-file` is `dump-file` with the type checker's.
;; - the roots a required module is looked for in are a parameter, as the Rust `Roots` of `types_here`:
;;   `dump-file-in` takes them (the driver's `-I` and FIB_LIB, compiler/driver); `dump-file` is it with `roots-default`.
;; - the `builtins` table `--tables` prints once before the first file: `header-lines`
;;   gives it, and the tool (compiler/types.fib) prints it before the loop over the files.
;; - the record functions of expand.dump are private there, so the three that
;;   print the expander's record (`read-record`, `expand-record`, `load-record`)
;;   are written here again, with the same text.
;; - no runner: stage 2a has no evaluator (see expand.dump `runner-of`), so a
;;   call of a user macro is `MacroNeedsEvaluator` as under `--no-runner`.
(ns types.dump
  (:require [syntax.reader :as reader] [syntax.dump :as sdump] [expand.modules :as mods]
            [expand.program :as prog] [types.driver :as driver] [expand.shared :as sh])
  (:use syntax.pos syntax.form syntax.error expand.error expand.types expand.ctx expand.roots expand.maker
        types.args types.error types.decls types.program types.dump.normal types.dump.tables types.dump.sections))

;; One file's output: its lines and the status it adds. A line has no newline.
(defstruct Dumped (lines: (Vec str) status: i64))

;; The position of an error that has none: a module that cannot be found.
(def no-position: str "0:0 0..0")

;; `error KIND L:C S..E: MESSAGE`: the record of the reader dump.
(defun record :private (kind: str at: str message: str) -> str
  (str-join ["error " kind " " at ": " message]))

(defun read-record :private (e: ReadError home: str) -> str
  (record (err-name (. e kind)) (sdump/span-in (. e pos) home) (err-message (. e kind))))

(defun expand-record :private (e: ExpandError home: str) -> str
  (record (expand-err-name (. e kind)) (sdump/span-in (. e pos) home) (expand-err-message (. e kind))))

;; The record of a program that could not be loaded.
(defun load-record :private (e: LoadErr home: str) -> str
  (match e
    ((LoadRead r) (read-record r home))
    ((LoadSpec pos what) (record "BadNs" (sdump/span-in pos home) what))
    ((LoadMissing _ _) (record "ModuleMissing" no-position (mods/load-err-message e)))
    ((LoadCycle _ _) (record "ModuleCycle" no-position (mods/load-err-message e)))
    ((LoadMismatch _ _ _) (record "ModuleMismatch" no-position (mods/load-err-message e)))))

;; The file's output ended by a record: status 1.
(defun failed :private (lines: (Vec str) text: str) -> Dumped
  (Dumped (conj lines text) 1))

;; The `error` records of a failed step, in order, their positions relative to
;; the main file `home` (`error_dump`); nothing prints when `show` is false (`--sections`
;; leaves `error` out), and the status is 1 all the same.
(defun error-dump (lines: (Vec str) errs: (Vec TypeError) home: str show: bool) -> Dumped
  (Dumped (if show
              (reduce (fn (acc: (Vec str) e: TypeError)
                        (push acc (str-join ["error " (error-kind-name (. e kind)) " "
                                             (sdump/span-in (. e pos) home) ": " (. e message)])))
                      lines errs)
              lines)
          1))

;; The lines of the sections of every module of layout (`sections_text`).
(defun sections-text :private (lines: (Vec str) v: View layout: (Vec Shown) opts: Options) -> (Vec str)
  (reduce (fn (acc: (Vec str) s: Shown) (module-lines acc v s opts)) lines layout))

;; Checks the expanded modules against prelude as far as opts says and prints the
;; sections of the modules of layout, or the errors of the first failing step
;; (`check_and_dump`).
(defun check-and-dump :private (lines: (Vec str) modules: (Vec Expanded) prelude: (Vec Stx)
                                layout: (Vec Shown) home: str opts: Options) -> Dumped
  (match (driver/lower-modules modules prelude)
    ((Err errs) (error-dump lines errs home (wants opts SecError)))
    ((Ok l)
     (if (= (. opts stage) StLower)
         (Dumped (sections-text lines (View (. l globals) nil) layout opts) 0)
         (match (driver/infer-lowered l (not (. opts library)))
           ((Err errs) (error-dump lines errs home (wants opts SecError)))
           ((Ok t) (Dumped (sections-text lines (View (. t globals) (some t)) layout opts) 0)))))))

;; ---- a program

;; The modules that have a section, in order: the prelude first with `--implicit`,
;; then each program module (module i is id i + 2, after the builtins and the
;; prelude), the implicit ones only with `--implicit` (`layout_of`).
(defun layout-of :private (loaded: (Vec Loaded) opts: Options) -> (Vec Shown)
  (loop ((i 0) (out (if (. opts implicit) [(Shown module-prelude prelude-ns "lib/prelude.fib")] [])))
    (if (>= i (count loaded))
        out
        (let ((l (nth loaded i)))
          (recur (+ i 1)
                 (if (or (. opts implicit) (not (. l implicit)))
                     (conj out (Shown (+ i 2) (. (. l spec) ns) (. l file)))
                     out))))))

;; The modules of loaded expanded in order in ctx, each begun, expanded and ended;
;; the first expansion error ends the dump under its `-- module NS FILE` line.
(defun expand-modules :private (lines: (Vec str) ctx: ExpandCtx loaded: (Vec Loaded) runner: Runner)
    -> (Result (Vec Expanded) Dumped)
  (expand-range lines ctx loaded runner 0 (count loaded) (vec-empty)))

;; The modules of loaded from index `from` up to `to`, expanded after those in out.
(defun expand-range :private (lines: (Vec str) ctx: ExpandCtx loaded: (Vec Loaded) runner: Runner from: i64 to: i64
                              out0: (Vec Expanded)) -> (Result (Vec Expanded) Dumped)
  (loop ((i from) (out out0))
    (if (>= i to)
        (Ok out)
        (let ((l (nth loaded i)))
          (do (mods/begin-spec ctx (. l spec))
              (match (prog/expand-program (. l forms) ctx runner)
                ((Err e) (Err (failed (conj lines (str-join ["-- module " (. (. l spec) ns) " " (. l file)]))
                                      (expand-record e (. l file)))))
                ((Ok forms) (recur (+ i 1) (conj out (mods/end-spec ctx (. l spec) forms))))))))))

;; The implicit modules of the dump: those of `--implicit-lib`, else the library's.
(defun implicit-of :private (opts: Options) -> (Vec str)
  (unwrap-or (. opts implicit-lib) (mods/implicit-lib)))

;; The dump of the program whose main module is source (the file `file`)
;; (`dump_program`).
(defun dump-program :private (lines: (Vec str) source: str file: str opts: Options roots: Roots rm: RunnerMaker
                              check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow)
    -> Dumped
  (let ((ctx (ctx-new)))
    (match (driver/prelude-forms ctx)
      ((Err m) (failed lines (record "Prelude" no-position m)))
      ((Ok prelude)
       (match (mods/try-load-with source file roots (implicit-of opts))
         ((Err e) (failed lines (load-record e file)))
         ((Ok loaded)
          (match (expand-modules lines ctx loaded (maker-runner rm prelude loaded))
            ((Err d) d)
            ((Ok modules)
             (check lines modules prelude (layout-of loaded opts) file opts)))))))))

;; ---- a library prelude

;; The dump of source (the file `file`) as a library prelude: the expander's own
;; prelude, then the forms of the file, expanded with no runner in the module
;; `fib.prelude`, which is then checked alone (no `main`) (`dump_prelude`).
(defun dump-prelude :private (lines: (Vec str) source: str file: str opts: Options
                              check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow)
    -> Dumped
  (match (reader/read-all source file)
    ((Err e) (failed lines (read-record e file)))
    ((Ok lib)
     (let ((ctx (ctx-new))
           (head (conj lines (str-join ["-- module " prelude-ns " " file]))))
       (match (prog/expand-prelude ctx)
         ((Err e) (failed head (expand-record e file)))
         ((Ok own)
          (match (prog/expand-program lib ctx (no-runner))
            ((Err e) (failed head (expand-record e file)))
            ((Ok forms)
             (check lines [] (into own forms) [(Shown module-prelude prelude-ns file)] file
                             (Options (. opts stage) (. opts sections) true (. opts implicit)
                                      (. opts implicit-lib) (. opts prelude) (. opts ast)
                                      (. opts tables)))))))))))

;; What a tool prints for one file: the line `== FILE`, then its dump or the line `unreadable`
;; (the body of `types_here`'s loop), the check of an expanded program being `check`: the
;; lines so far, the expanded modules, the prelude's forms, the layout, the main file and the
;; options in, what the file prints out. The modules the program requires are looked for in
;; `roots` (spec/syntax.md §5: beside the file, under each `-I` directory, under each directory of
;; `FIB_LIB`, then the built-in library); a program that is a library prelude needs none.
(defun dump-file-with (file: str opts: Options roots: Roots rm: RunnerMaker
                       check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow)
    -> Dumped
  (let ((header [(str-concat "== " file)]))
    (match (read-file file)
      (nil (Dumped (conj header "unreadable") 2))
      ((some source)
       (if (. opts prelude)
           (dump-prelude header source file opts check)
           (dump-program header source file opts roots rm check))))))

;; `dump-file-with` and no runner at all (stage 2a: a call of a user macro is `MacroNeedsEvaluator`).
(defun dump-file-in (file: str opts: Options roots: Roots
                     check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow)
    -> Dumped
  (dump-file-with file opts roots (no-runner-maker) check))

;; `dump-file-in` with no directory but the built-in library's (`Roots::default`).
(defun dump-file (file: str opts: Options
                  check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow)
    -> Dumped
  (dump-file-in file opts (roots-default) check))

;; What `fibref types` prints for one file: `dump-file` with the type checker's check.
(defun types-file (file: str opts: Options) -> Dumped
  (dump-file file opts check-and-dump))

;; `types-file` with the macro runner `rm` makes (`fibref types` runs the macros of a program).
(defun types-file-with (file: str opts: Options rm: RunnerMaker) -> Dumped
  (dump-file-with file opts (roots-default) rm check-and-dump))

;; ---- a batch: the library expanded once (expand.shared)

;; The modules of loaded expanded, the implicit ones from the shared state when it holds them (expanded and kept otherwise).
(defun expand-shared :private (lines: (Vec str) ctx: ExpandCtx loaded: (Vec Loaded) runner: Runner s: sh/Shared)
    -> (Result (Vec Expanded) Dumped)
  (let ((k (sh/implicit-count loaded)) (n (count loaded)) (key (sh/prefix-key loaded k)))
    (do (sh/hint-set (sh/content-key loaded k) k)
    (match (sh/shared-prefix s key)
      ((some p) (expand-range lines (. p fst) loaded runner k n (. p snd)))
      (nil (match (expand-range lines ctx loaded runner 0 k (vec-empty))
             ((Err d) (Err d))
             ((Ok done) (do (when (> k 0) (sh/shared-keep s key ctx done))
                            (expand-range lines ctx loaded runner k n done)))))))))

(defun dump-program-shared :private (lines: (Vec str) source: str file: str opts: Options roots: Roots rm: RunnerMaker
                                     check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow
                                     s: sh/Shared) -> Dumped
  (match (sh/shared-start s)
    ((Err m) (failed lines (record "Prelude" no-position m)))
    ((Ok st)
     (match (mods/try-load-with source file roots (implicit-of opts))
       ((Err e) (failed lines (load-record e file)))
       ((Ok loaded)
        (match (expand-shared lines (. st ctx) loaded (maker-runner rm (. st prelude) loaded) s)
          ((Err d) d)
          ((Ok modules) (check lines modules (. st prelude) (layout-of loaded opts) file opts))))))))

;; `dump-file-with` for a file of a batch: the same lines and status.
(defun dump-file-shared (file: str opts: Options roots: Roots rm: RunnerMaker
                         check: (fn ((Vec str) (Vec Expanded) (Vec Stx) (Vec Shown) str Options) Dumped) :borrow
                         s: sh/Shared) -> Dumped
  (if (. opts prelude)
      (dump-file-with file opts roots rm check)
      (let ((header [(str-concat "== " file)]))
        (match (read-file file)
          (nil (Dumped (conj header "unreadable") 2))
          ((some source) (dump-program-shared header source file opts roots rm check s))))))

;; `check-and-dump` where the typed program, past the lowering stage, is the one `infer` gives for the modules, the prelude and whether `main` is
;; required (the persistent checker keeps the library's, own.staged); lowering errors and inference errors are told the same way.
(defun check-and-dump-via :private (infer: (fn ((Vec Expanded) (Vec Stx) bool) (Result TypedProgram (Vec TypeError))) :borrow
                                    lines: (Vec str) modules: (Vec Expanded) prelude: (Vec Stx)
                                    layout: (Vec Shown) home: str opts: Options) -> Dumped
  (if (= (. opts stage) StLower)
      (check-and-dump lines modules prelude layout home opts)
      (let ((a (match (infer modules prelude (not (. opts library)))
                 ((Err errs) (error-dump lines errs home (wants opts SecError)))
                 ((Ok t) (Dumped (sections-text lines (View (. t globals) (some t)) layout opts) 0)))))
        (if (= (sys-getenv "FIB_CHECK_CACHE") (some "verify"))   ; the control: the whole check as well, the same bytes (own.staged)
            (let ((b (check-and-dump lines modules prelude layout home opts)))
              (if (and (= (. a lines) (. b lines)) (= (. a status) (. b status)))
                  a
                  (do (eprintln (str-join ["check-cache verify: the output differs for " home]))
                      (Dumped (conj (. a lines) "#### CHECK-CACHE MISMATCH") 97))))
            a))))

;; `types-file-with` for a file of a batch, typed by `infer`.
(defun types-file-shared (file: str opts: Options rm: RunnerMaker s: sh/Shared
                          infer: (fn ((Vec Expanded) (Vec Stx) bool) (Result TypedProgram (Vec TypeError))) :borrow) -> Dumped
  (dump-file-shared file opts (roots-default) rm
                    (fn (lines: (Vec str) modules: (Vec Expanded) prelude: (Vec Stx) layout: (Vec Shown) home: str o: Options)
                      (check-and-dump-via infer lines modules prelude layout home o))
                    s))

;; What the tool prints before its first file: the `builtins` table when the `tables` section is
;; asked for (`types_here`).
(defun header-lines (opts: Options) -> (Vec str)
  (if (wants opts SecTables) (builtins-lines) []))
