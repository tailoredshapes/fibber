;; compiler/types/names.fib: the lookup of names through a module's chain (package P2).
;; Replaces crates/fibref/src/types/names.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
;; Names, Space, is_private and make_private are in types.decls (decls.rs re-exports them).
(ns types.names
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust: names.rs:75 Globals::chain
(defun g-chain (g: Globals m: i64) -> (Vec i64)
  (trap "todo: g-chain"))

;; Rust: names.rs:205 Globals::value
(defun g-value (g: Globals m: i64 name: str) -> (Option GlobalRef)
  (trap "todo: g-value"))

;; Rust: names.rs:214 value_any
(defun g-value-any (g: Globals m: i64 name: str) -> (Option GlobalRef)
  (trap "todo: g-value-any"))

;; Rust: names.rs:223 type_name
(defun g-type-name (g: Globals m: i64 name: str) -> (Option i64)
  (trap "todo: g-type-name"))

;; Rust: names.rs:232 proto_name
(defun g-proto-name (g: Globals m: i64 name: str) -> (Option i64)
  (trap "todo: g-proto-name"))

;; Rust: names.rs:242 ambiguity
(defun g-ambiguity (g: Globals m: i64 space: Space name: str) -> (Option (Pair i64 i64))
  (trap "todo: g-ambiguity"))

;; Rust: names.rs:259 private_owner
(defun g-private-owner (g: Globals m: i64 space: Space name: str) -> (Option i64)
  (trap "todo: g-private-owner"))

;; Rust: names.rs:271 unknown
(defun g-unknown (g: Globals m: i64 space: Space name: str what: str) -> str
  (trap "todo: g-unknown"))
