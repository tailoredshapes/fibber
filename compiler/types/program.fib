;; compiler/types/program.fib: the typed program and the scheme printer (package P13).
;; Replaces crates/fibref/src/types/program.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.program
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.infer.cx types.infer.mod types.builtins types.display))

;; Rust `TypedProgram` (program.rs:84): the tables are finished Maps (the
;; Rust Vec<Option<_>> by id are Maps with the missing ids absent).
(defstruct TypedProgram
  (globals: Globals fun-schemes: (Map i64 Scheme) def-types: (Map i64 Ty)
   expr-types: (Map i64 Ty) binding-types: (Map i64 Ty)
   instantiations: (Map i64 Instantiation) resolutions: (Map i64 Resolution)
   fn-colours: (Map i64 Colour) builtins: (Vec BuiltinSig) units: (Vec UnitRef)))

;; Rust: program.rs:108 new
(defun program-new (globals: Globals env: Env t: Tables units: (Vec UnitRef)) -> TypedProgram
  (trap "todo: program-new"))

;; Rust: program.rs:129 fun
(defun program-fun (p: TypedProgram name: str) -> (Option i64)
  (trap "todo: program-fun"))

;; Rust: program.rs:137 scheme
(defun program-scheme (p: TypedProgram name: str) -> (Option Scheme)
  (trap "todo: program-scheme"))

;; Rust: program.rs:145 show_scheme
(defun program-show-scheme (p: TypedProgram s: Scheme) -> str
  (trap "todo: program-show-scheme"))

;; Rust: program.rs:191 show_fun
(defun program-show-fun (p: TypedProgram name: str) -> (Option str)
  (trap "todo: program-show-fun"))

;; Rust: program.rs:196 show_in
(defun program-show-in (p: TypedProgram f: i64 t: Ty) -> str
  (trap "todo: program-show-in"))

;; Rust: program.rs:208 def_type
(defun program-def-type (p: TypedProgram name: str) -> (Option Ty)
  (trap "todo: program-def-type"))
