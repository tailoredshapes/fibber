;; compiler/types/program.fib: the typed program and the scheme printer (package P13).
;; Replaces crates/fibref/src/types/program.rs.
;;
;; Shapes decided where Rust and fibber differ:
;; - the Rust tables `Vec<Option<_>>` by id are Maps with the missing ids absent, and
;;   `TypedProgram::new` reads them out of the Cells of `Env` and `Tables` (Rust moves the
;;   fields; here the Cells are read).
;; - `show_scheme` is `show-scheme-in` of types.dump.scheme over the program's globals (that
;;   module reads the global tables alone, so a scheme can be printed before inference).
(ns types.program
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast
        types.decls types.names types.infer.cx types.infer.mod types.builtins types.display
        types.dump.scheme))

;; Rust `TypedProgram` (program.rs:84): the tables are finished Maps (the
;; Rust Vec<Option<_>> by id are Maps with the missing ids absent).
(defstruct TypedProgram
  (globals: Globals fun-schemes: (Map i64 Scheme) def-types: (Map i64 Ty)
   expr-types: (Map i64 Ty) binding-types: (Map i64 Ty)
   instantiations: (Map i64 Instantiation) resolutions: (Map i64 Resolution)
   fn-colours: (Map i64 Colour) builtins: (Vec BuiltinSig) units: (Vec UnitRef)))

;; Rust: program.rs:108 new
(defun program-new (globals: Globals env: Env t: Tables units: (Vec UnitRef)) -> TypedProgram
  (TypedProgram globals @(. env funs) @(. env defs) @(. t expr-types) @(. t binding-types)
                @(. t instantiations) @(. t resolutions) @(. t fn-colours)
                (builtin-table) units))

;; The global value `name` of the user module (the main module, then the prelude).
(defun main-value :private (p: TypedProgram name: str) -> (Option GlobalRef)
  (g-value (. p globals) @(. (. p globals) main) name))

;; Rust: program.rs:129 fun
(defun program-fun (p: TypedProgram name: str) -> (Option i64)
  (match (main-value p name)
    ((some (GFun f)) (some f))
    (_ nil)))

;; Rust: program.rs:137 scheme
(defun program-scheme (p: TypedProgram name: str) -> (Option Scheme)
  (if-some [f (program-fun p name)]
    (get (. p fun-schemes) f)
    nil))

;; Rust: program.rs:145 show_scheme
(defun program-show-scheme (p: TypedProgram s: Scheme) -> str
  (show-scheme-in (. p globals) s))

;; Rust: program.rs:191 show_fun
(defun program-show-fun (p: TypedProgram name: str) -> (Option str)
  (if-some [s (program-scheme p name)]
    (some (program-show-scheme p s))
    nil))

;; Rust: program.rs:196 show_in: a type inside the body of `defun` f, printed with the
;; names of the quantified variables of its scheme.
(defun program-show-in (p: TypedProgram f: i64 t: Ty) -> str
  (let ((names (match (get (. p fun-schemes) f)
                 ((some s) (. s var-names))
                 (nil []))))
    (printer-ty (printer-with-names (. p globals) names []) t)))

;; Rust: program.rs:208 def_type
(defun program-def-type (p: TypedProgram name: str) -> (Option Ty)
  (match (main-value p name)
    ((some (GDef d)) (get (. p def-types) d))
    (_ nil)))
