;; compiler/types/table.fib: a table of rows by dense id, what the Rust
;; `Vec<T>` indexed by an id is in `Globals` (decls.rs) and in the unit
;; worklists. NEW (no Rust file).
;;
;; Ids are allocated consecutively, so rows are a growable array in a Cell.
;; Lookup and replacement index it directly; a unique array appends in
;; amortised constant time. The array primitives copy when a snapshot shares
;; the array. No Send constraint is needed on a row: rows may contain Cells.
;; Slots are Options so the generic empty array has a valid nil initializer;
;; every allocated id contains some row, including a row that is itself nil.
;; A table is passed explicitly like `ExpandCtx`.
;; `table-get` of an id that is not a row traps, as Rust's index panics.
(ns types.table)

(defstruct (Table a) (rows: (Cell (Array (Option a)))))

(defun table-new () -> (Table a)
  (Table (cell (array 0 nil))))

(defun table-count (t: (Table a)) -> i64
  (array-len @(. t rows)))

;; Adds a row; its id.
(defun table-add (t: (Table a) row: a) -> i64
  (let ((rows (. t rows)) (id (table-count t)))
    (do (array-push! &rows (some row))
        id)))

(defun table-find (t: (Table a) id: i64) -> (Option a)
  (if (and (>= id 0) (< id (table-count t)))
      (array-get @(. t rows) id) nil))

(defun table-get (t: (Table a) id: i64) -> a
  (match (table-find t id)
    ((some row) row)
    (nil (trap (str-join ["table-get: no row " (show id)])))))

;; Replaces the row id (which must exist).
(defun table-set (t: (Table a) id: i64 row: a) -> unit
  (if (and (>= id 0) (< id (table-count t)))
      (let ((rows (. t rows))) (array-set! &rows id (some row)))
      (trap (str-join ["table-set: no row " (show id)]))))

;; The rows in id order.
(defun table-rows (t: (Table a)) -> (Vec a)
  (let ((rows @(. t rows)))
    (mapv (fn (i: i64) (unwrap (array-get rows i))) (range (array-len rows)))))

;; The rows from id `i0` in id order.
(defun table-rows-from (t: (Table a) i0: i64) -> (Vec a)
  (let ((rows @(. t rows)))
    (mapv (fn (i: i64) (unwrap (array-get rows i))) (range i0 (array-len rows)))))

;; A table equal to `t` and independent of it: the array is shared and copied by the first write to either (types.persist).
(defun table-copy (t: (Table a)) -> (Table a)
  (Table (cell @(. t rows))))
