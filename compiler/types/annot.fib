;; compiler/types/annot.fib: type annotations to types (package P2).
;; Replaces crates/fibref/src/types/annot.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.annot
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust `trait AnnEnv`: what an annotation is resolved in. `ann-var` and
;; `ann-colour` are required; the Rust defaults are: `self_ty` an error
;; "Self is only allowed in a protocol" (resolve error at pos),
;; `named_colour` an error "colour variable NAME is not allowed here",
;; `colour_param_arg` none. P2 may give the methods defaults or turn the
;; protocol into a struct of closures (the shape of expand.ctx's `Runner`).
(defprotocol AnnEnv
  (ann-var (self name: str pos: Pos) -> (Result Ty TypeError))
  (ann-self-ty (self pos: Pos) -> (Result Ty TypeError))
  (ann-colour (self) -> Colour)
  (ann-named-colour (self name: str pos: Pos) -> (Result Colour TypeError))
  (ann-colour-param-arg (self name: str pos: Pos) -> (Option (Result Ty TypeError))))

;; Rust `GenEnv` (annot.rs:87): the variables of a scheme being written.
;; P2 defines `ParamEnv` (annot.rs:150) and `RigidEnv` (annot.rs:193) too.
(defstruct GenEnv
  (names: (Vec str) colours: (Cell i64) self-gen: bool local-colours: bool
   colour-names: (Cell (Vec (Pair str i64)))))

;; Rust: annot.rs:54 ann_to_ty
(defun ann-to-ty (ann: TypeAnn env: e pos: Pos) :where ((AnnEnv e)) -> (Result Ty TypeError)
  (trap "todo: ann-to-ty"))

;; Rust: annot.rs:102 GenEnv::with_names
(defun gen-env-with-names (names: (Vec str)) -> GenEnv
  (trap "todo: gen-env-with-names"))
