;; compiler/types/annot.fib: type annotations to types (package P2).
;; Replaces crates/fibref/src/types/annot.rs (280 lines of Rust).
;;
;; What a type variable and an omitted colour mean depends on where the annotation
;; is (§1.4, §3.1): the caller supplies that through an `AnnEnv`.
;;
;; PROTOCOL, not a struct of closures (the choice P1 left open). Three more
;; implementors exist in other packages (SuperEnv in lower/supers.rs, HeadEnv in
;; lower/impl_head.rs, ClosedEnv in lower/top.rs), each of which overrides some of
;; the five methods and takes the Rust defaults for the others: a protocol method
;; with a body is that default, and an implementor is its own struct with its own
;; state in Cells, as in Rust. A struct of closures would have each of them build
;; five closures and repeat the defaults, and a state shared by two closures (the
;; colour counter of a GenEnv) would be two captures of one Cell. `ann-to-ty` is
;; generic with `:where ((AnnEnv e))`; the Rust `&mut dyn AnnEnv` is a plain `e`.
;; The cost is one specialisation of ann-to-ty (and anns, colour-of) per implementor.
;;
;; Shapes decided where Rust and fibber differ:
;; - `&mut self` is `self` over Cells: every mutable field of GenEnv and RigidEnv is
;;   a Cell (`names` of GenEnv was a plain `(Vec str)` in the P1 stub: the caller
;;   reads it after the conversion, so it is `(Cell (Vec str))`, read `@(. env names)`),
;;   and the `&mut` collections a RigidEnv borrows are the Cells the caller shares.
;; - the flags `self_gen` and `local_colours` are set at construction (nothing sets
;;   them later): `gen-env-new`, `gen-env-with-names` (Rust `GenEnv::default()` and
;;   `GenEnv::with_names`), `gen-env-with-self` (with_names then self_gen = true),
;;   `gen-env-local` (omitted colours are `local`).
;; - `RigidEnv.colour` is an owned function `(fn () Colour)` (Rust `&mut dyn FnMut`):
;;   it makes a colour and keeps its own counter in a Cell it captured.
;; - `collect::<TResult<Vec<_>>>` is the loop of `anns`: the first error ends it. It takes
;;   the conversion as a function (`(fn (a) (ann-to-ty a env pos))`) instead of calling
;;   ann-to-ty itself: stage 1's lowering (crates/fibc lower/call.rs `fun_instance`)
;;   rejects two mutually recursive functions generic in a protocol-bound variable
;;   ("call of anns instantiates 1 of 2 variables": the members of an SCC share their
;;   quantified variables, the caller outside instantiates one); a self-recursive
;;   generic, with the closure inside it, is accepted. Every later package that writes
;;   mutually recursive functions over an `AnnEnv` (or another protocol-bound
;;   variable) meets this: break the cycle with a function parameter.
(ns types.annot
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; What variables, `Self` and omitted colours mean in one annotation.
(defprotocol AnnEnv
  ;; the type of the variable `name`
  (ann-var (self name: str pos: Pos) -> (Result Ty TypeError))
  ;; the type `Self` stands for
  (ann-self-ty (self pos: Pos) -> (Result Ty TypeError)
    (Err (type-error-resolve pos "Self is only allowed in a protocol")))
  ;; the colour of a function type whose colour is omitted
  (ann-colour (self) -> Colour)
  ;; the colour a named colour variable or parameter stands for (§1.3)
  (ann-named-colour (self name: str pos: Pos) -> (Result Colour TypeError)
    (Err (type-error-resolve pos (str-join ["colour variable " name " is not allowed here"]))))
  ;; the argument of a nominal type at a colour parameter written as the name
  ;; `name`, when this environment gives it as a type (an `impl` head's colour
  ;; variable is `TGen i` there, §1.3); nil for the colour of `ann-named-colour`
  (ann-colour-param-arg (self name: str pos: Pos) -> (Option (Result Ty TypeError))
    nil))

;; A written colour under `env`.
(defun colour-of :private (c: ColourAnn env: e pos: Pos) :where ((AnnEnv e)) -> (Result Colour TypeError)
  (match c
    ((CaFixed k) (Ok k))
    ((CaNamed n) (ann-named-colour env n pos))))

;; Converts `ann` under `env`.
(defun ann-to-ty (ann: TypeAnn env: e pos: Pos) :where ((AnnEnv e)) -> (Result Ty TypeError)
  (match ann
    ((AVar name) (ann-var env name pos))
    ((ASelf) (ann-self-ty env pos))
    ((AScalar s) (Ok (ty-scalar s)))
    ((AStr) (Ok (ty-str)))
    ((ABuiltin c arg) (try-let ((a (ann-to-ty arg env pos))) (Ok (TCon c [a]))))
    ((ANominal id args) (try-let ((ts (anns args (fn (a: TypeAnn) (ann-to-ty a env pos))))) (Ok (TCon (KNominal id) ts))))
    ((ADyn p args send) (try-let ((ts (anns args (fn (a: TypeAnn) (ann-to-ty a env pos))))) (Ok (TCon (KDyn p send) ts))))
    ((AColourArg (CaNamed n))
     (match (ann-colour-param-arg env n pos)
       ((some t) t)
       (nil (try-let ((k (ann-named-colour env n pos))) (Ok (ty-colour-arg k))))))
    ((AColourArg c) (try-let ((k (colour-of c env pos))) (Ok (ty-colour-arg k))))
    ((AFn k ps r)
     (try-let ((kk (match k
                     ((some c) (colour-of c env pos))
                     (nil (Ok (ann-colour env)))))
               (pts (anns ps (fn (a: TypeAnn) (ann-to-ty a env pos))))
               (rt (ann-to-ty r env pos)))
       (Ok (TFn kk pts rt))))))

(defun anns :private (args: (Vec TypeAnn) conv: (fn (TypeAnn) (Result Ty TypeError)) :borrow) -> (Result (Vec Ty) TypeError)
  (loop ((i 0) (acc (vec-empty)))
    (if (>= i (count args))
        (Ok acc)
        (match (conv (nth args i))
          ((Ok t) (recur (+ i 1) (conj acc t)))
          ((Err e) (Err e))))))

;; The position of name in names.
(defun name-position :private (names: (Vec str) name: str) -> (Option i64)
  (loop ((i 0))
    (cond ((>= i (count names)) nil)
          ((= (nth names i) name) (some i))
          (else (recur (+ i 1))))))

;; ---- GenEnv

;; Variables are quantified: each new name gets the next `TGen`, and each omitted
;; colour the next `CGen` (protocol signatures and builtin signatures). `Self` is
;; `TGen 0` when `self-gen` is set.
;; names: the variables named so far, in order of `TGen` index; colours: how many
;; colour variables were made; self-gen: whether `Self` is allowed (as `TGen 0`);
;; local-colours: whether omitted colours are `local` (else quantified variables);
;; colour-names: named colour variables and their `CGen` index.
(defstruct GenEnv
  (names: (Cell (Vec str)) colours: (Cell i64) self-gen: bool local-colours: bool
   colour-names: (Cell (Vec (Pair str i64)))))

;; Rust `GenEnv::default()`.
(defun gen-env-new () -> GenEnv
  (GenEnv (cell (vec-empty)) (cell 0) false false (cell (vec-empty))))

;; An environment whose first variables are `names`.
(defun gen-env-with-names (names: (Vec str)) -> GenEnv
  (GenEnv (cell names) (cell 0) false false (cell (vec-empty))))

;; `gen-env-with-names` with `Self` allowed as `TGen 0`.
(defun gen-env-with-self (names: (Vec str)) -> GenEnv
  (GenEnv (cell names) (cell 0) true false (cell (vec-empty))))

;; `gen-env-new` whose omitted colours are `local`.
(defun gen-env-local () -> GenEnv
  (GenEnv (cell (vec-empty)) (cell 0) false true (cell (vec-empty))))

;; The next quantified colour.
(defun gen-next-colour :private (env: GenEnv) -> Colour
  (let ((n @(. env colours)))
    (do (set! (. env colours) (+ n 1))
        (CGen n))))

(impl AnnEnv GenEnv
  (ann-var (self name pos)
    (let ((ns @(. self names)))
      (match (name-position ns name)
        ((some i) (Ok (TGen i)))
        (nil (do (set! (. self names) (conj ns name))
                 (Ok (TGen (count ns))))))))
  (ann-self-ty (self pos)
    (if (. self self-gen)
        (Ok (TGen 0))
        (Err (type-error-resolve pos "Self is only allowed in a protocol"))))
  (ann-colour (self)
    (if (. self local-colours) CLocal (gen-next-colour self)))
  (ann-named-colour (self name pos)
    (let ((known (first (filterv (fn (e: (Pair str i64)) (= (. e fst) name)) @(. self colour-names)))))
      (match known
        ((some e) (Ok (CGen (. e snd))))
        (nil (let ((n @(. self colours)))
               (do (set! (. self colours) (+ n 1))
                   (set! (. self colour-names) (conj @(. self colour-names) (Pair name n)))
                   (Ok (CGen n)))))))))

;; ---- ParamEnv

;; The parameters of a struct or enum: only they may occur, as `TGen i`; an omitted
;; colour is `local` (§1.4: on a field). params: the definition's parameters;
;; colours: which of them are colour parameters (§1.3), may be empty; owner: the
;; definition's name, for messages.
(defstruct ParamEnv (params: (Vec str) colours: (Vec bool) owner: str))

(defun param-is-colour :private (env: ParamEnv i: i64) -> bool
  (match (get (. env colours) i)
    ((some b) b)
    (nil false)))

(impl AnnEnv ParamEnv
  (ann-var (self name pos)
    (match (name-position (. self params) name)
      ((some i)
       (if (param-is-colour self i)
           (Err (type-error-resolve pos (str-join [name " is a colour parameter of " (. self owner) ", not a type"])))
           (Ok (TGen i))))
      (nil (Err (type-error-resolve pos (str-join ["type variable " name " is not a parameter of " (. self owner)]))))))
  (ann-colour (self) CLocal)
  (ann-named-colour (self name pos)
    (match (name-position (. self params) name)
      ((some i)
       (if (param-is-colour self i)
           (Ok (CGen i))
           (Err (type-error-resolve pos (str-join [name " is not a colour parameter of " (. self owner)])))))
      (nil (Err (type-error-resolve pos (str-join [name " is not a colour parameter of " (. self owner)])))))))

;; ---- RigidEnv

;; Named variables map to rigid variables (an annotated `defun`, an impl body):
;; `map` gives each name its rigid index, `names` the name of each index; new names
;; are added. Omitted colours come from `colour`. colour-names: named colour
;; variables: each name one colour variable of the definition (§1.3).
(defstruct RigidEnv
  (map: (Cell (Map str i64)) names: (Cell (Vec str)) colour: (fn () Colour)
   colour-names: (Cell (Map str Colour))))

(impl AnnEnv RigidEnv
  (ann-var (self name pos)
    (match (get @(. self map) name)
      ((some i) (Ok (TRigid i)))
      (nil (let ((i (count @(. self names))))
             (do (set! (. self names) (conj @(. self names) name))
                 (set! (. self map) (assoc @(. self map) name i))
                 (Ok (TRigid i)))))))
  (ann-colour (self)
    (let ((make (. self colour))) (make)))
  (ann-named-colour (self name pos)
    (match (get @(. self colour-names) name)
      ((some k) (Ok k))
      (nil (let ((make (. self colour))
                 (k (make)))
             (do (set! (. self colour-names) (assoc @(. self colour-names) name k))
                 (Ok k)))))))
