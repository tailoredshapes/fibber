;; compiler/types/lower/top.fib: top-level definitions to Globals rows (package P5).
;; Replaces crates/fibref/src/types/lower/top.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.lower.top
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust `RawParam` and `DefunParts` (lower/top.rs:26, :79): a defun's
;; parameters, bounds, return annotation and body forms, not yet lowered.
(defstruct RawParam (name: str amp: bool ann: (Option Stx) borrow: bool pos: Pos))
(defstruct DefunParts
  (params: (Vec RawParam) bounds: (Option Stx) ret: (Option Stx) body: (Vec Stx)))

;; Rust: lower/top.rs:17
(defun placeholder (g: Globals pos: Pos) -> Expr
  (trap "todo: placeholder"))

;; Rust: lower/top.rs:87
(defun defun-parts (form: Stx) -> (Result (Pair str DefunParts) TypeError)
  (trap "todo: defun-parts"))

;; Rust: lower/top.rs:118
(defun lower-defun (g: Globals m: i64 form: Stx) -> (Result FunDef TypeError)
  (trap "todo: lower-defun"))

;; Rust: lower/top.rs:196
(defun lower-macro (g: Globals m: i64 form: Stx) -> (Result FunDef TypeError)
  (trap "todo: lower-macro"))

;; Rust: lower/top.rs:256
(defun def-parts (form: Stx) -> (Result (Triple str (Option Stx) Stx) TypeError)
  (trap "todo: def-parts"))

;; Rust: lower/top.rs:288
(defun extern-type (g: Globals m: i64 form: Stx) -> (Result (Triple str Ty bool) TypeError)
  (trap "todo: extern-type"))

;; Rust: lower/top.rs:319
(defun lower-impl-method (g: Globals m: i64 inst: i64 mf: Stx owner: str) -> (Result ImplMethod TypeError)
  (trap "todo: lower-impl-method"))
