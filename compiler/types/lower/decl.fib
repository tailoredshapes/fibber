;; compiler/types/lower/decl.fib: struct and enum declarations (package P3).
;; Replaces crates/fibref/src/types/lower/decl.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.lower.decl
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust `RawField` and `RawType` (lower/decl.rs:17, :23): a declared field
;; or variant, its type form still unresolved.
(defstruct RawField (name: str ty: (Option Stx)))
(defstruct RawType
  (id: i64 variants: (Option (Vec (Pair str (Vec RawField)))) fields: (Vec RawField)))

;; Rust: lower/decl.rs:32
(defun define-value (g: Globals m: i64 name: str r: GlobalRef pos: Pos) -> (Result unit TypeError)
  (trap "todo: define-value"))

;; Rust: lower/decl.rs:51
(defun annotation-name (form: Stx) -> (Option str)
  (trap "todo: annotation-name"))

;; Rust: lower/decl.rs:130
(defun declare-struct (g: Globals m: i64 form: Stx) -> (Result RawType TypeError)
  (trap "todo: declare-struct"))

;; Rust: lower/decl.rs:198
(defun declare-enum (g: Globals m: i64 form: Stx) -> (Result RawType TypeError)
  (trap "todo: declare-enum"))

;; Rust: lower/decl.rs:262
(defun resolve-shape (g: Globals m: i64 raw: RawType) -> (Result unit TypeError)
  (trap "todo: resolve-shape"))
