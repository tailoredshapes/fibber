;; compiler/types/lower/defaults.fib: protocol default methods (package P3).
;; Replaces crates/fibref/src/types/lower/defaults.rs (56 lines of Rust).
;;
;; Default methods (types §4.1, owner's decision of 2026-09-28): the `impl` method a
;; protocol's default stands for in an `impl` that omits it.
(ns types.lower.defaults
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table
        types.ast types.decls types.lower.typeform))

;; `(m (self x..) body..)` from the default `(m (self q.. x: T q..) -> R body..)`: the
;; parameters by name, the body as written. The result annotation is dropped; the impl
;; body is checked against the signature anyway (§2.7).
(defun method-form (md: MethodDef default: Stx) -> Stx
  (let ((pos (. default pos))
        (sym (fn (s: str) (Stx (SSym s) pos))))
    (Stx (SList (into [(sym (. md name))
                       (Stx (SList (mapv (fn (p: MethodParam) (sym (. p name))) (. md params))) pos)]
                      (drop 4 (stx-items default))))
         pos)))
