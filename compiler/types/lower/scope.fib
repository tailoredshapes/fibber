;; compiler/types/lower/scope.fib: the lowerer and its scope of local names (package P7).
;; Replaces crates/fibref/src/types/lower/scope.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.lower.scope
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls))

;; Rust `Lowerer<'g>` (lower/scope.rs:19) and its private `Frame`: the
;; scope is a vector of (name, binding) with a mark to reset to, `depth` the
;; frame each binding was made in, `loops` the frame depth of each open
;; loop. Every field with state is a Cell. P7 may change the fields.
(defstruct ScopeEntry (name: str binding: i64))
(defstruct LowerFrame (is-async: bool captures: (Vec i64)))
(defstruct Lowerer
  (g: Globals m: i64 owner: str scope: (Cell (Vec ScopeEntry))
   depth: (Cell (Map i64 i64)) frames: (Cell (Vec LowerFrame))
   loops: (Cell (Vec i64)) unsafe-depth: (Cell i64)))

;; Rust: lower/scope.rs:36 Lowerer::new
(defun lowerer-new (g: Globals m: i64 owner: str) -> Lowerer
  (trap "todo: lowerer-new"))

;; Rust: lower/scope.rs:50 bind
(defun lw-bind (lw: Lowerer name: str kind: BindingKind pos: Pos) -> i64
  (trap "todo: lw-bind"))

;; Rust: lower/scope.rs:64 mark
(defun lw-mark (lw: Lowerer) -> i64
  (trap "todo: lw-mark"))

;; Rust: lower/scope.rs:69 reset
(defun lw-reset (lw: Lowerer mark: i64) -> unit
  (trap "todo: lw-reset"))

;; Rust: lower/scope.rs:75 lookup
(defun lw-lookup (lw: Lowerer name: str) -> (Option i64)
  (trap "todo: lw-lookup"))

;; Rust: lower/scope.rs:87 is_local
(defun lw-is-local (lw: Lowerer name: str) -> bool
  (trap "todo: lw-is-local"))

;; Rust: lower/scope.rs:92 kind
(defun lw-kind (lw: Lowerer id: i64) -> BindingKind
  (trap "todo: lw-kind"))

;; Rust: lower/scope.rs:98 enter_frame
(defun lw-enter-frame (lw: Lowerer is-async: bool) -> unit
  (trap "todo: lw-enter-frame"))

;; Rust: lower/scope.rs:106 leave_frame
(defun lw-leave-frame (lw: Lowerer) -> (Vec i64)
  (trap "todo: lw-leave-frame"))

;; Rust: lower/scope.rs:111 in_async
(defun lw-in-async (lw: Lowerer) -> bool
  (trap "todo: lw-in-async"))

;; Rust: lower/scope.rs:116 enter_loop
(defun lw-enter-loop (lw: Lowerer) -> unit
  (trap "todo: lw-enter-loop"))

;; Rust: lower/scope.rs:121 leave_loop
(defun lw-leave-loop (lw: Lowerer) -> unit
  (trap "todo: lw-leave-loop"))

;; Rust: lower/scope.rs:127 in_loop
(defun lw-in-loop (lw: Lowerer) -> bool
  (trap "todo: lw-in-loop"))

;; Rust: lower/scope.rs:132 mk
(defun lw-mk (lw: Lowerer pos: Pos kind: ExprKind) -> Expr
  (trap "todo: lw-mk"))
