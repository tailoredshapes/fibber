;; compiler/types/store.fib: the substitution (spec/types.md §3.1),
;; unification variables as union-find nodes carrying a Rémy level, and
;; colour variables, as crates/fibref/src/types/store.rs (181 lines of
;; Rust).
;;
;; A variable is either unbound, with the level (SCC depth) at which it
;; was created, or linked to a type. `store-resolve` follows links with
;; path compression; `store-zonk` substitutes every bound variable.
;;
;; Shapes: the Rust `Store` is a struct of Cells (the pattern of
;; `ExpandCtx`: every function takes it and changes it through `set!`).
;; The nodes are a `(Map i64 VarNode)` keyed by variable id, not a Vec: an
;; `assoc` at an index of a Vec is O(n) in the library today (plan G1:
;; 16,000 assocs took 12 s), a Map's is O(log n). The choice is private to
;; this module: the Map is reached only through the functions below, so a
;; later Vec with an O(log n) `assoc` changes this file alone. A variable
;; id is the number of nodes before it was made, as Rust's index, so the
;; ids are allocated in the same order. `leave` does not go below 0.
(ns types.store (:use types.ty))

;; One unification variable: not bound (created at this level), or bound
;; to this type (possibly another variable).
(defenum VarNode
  (Unbound level: i64)
  (Link ty: Ty))

;; Unification variables, colour variables (the count of those made) and
;; the current level. Treat the fields as private: use the functions.
(defstruct Store (nodes: (Cell (Map i64 VarNode)) colours: (Cell i64) level: (Cell i64)))

;; An empty store at level 0 (the top level, where only closed schemes
;; live).
(defun store-new () -> Store
  (Store (cell (map-empty)) (cell 0) (cell 0)))

(defun store-level (s: Store) -> i64 @(. s level))

;; Enters a unit (an SCC, an impl, a def): new variables get the next
;; level.
(defun store-enter (s: Store) -> unit
  (set! (. s level) (+ @(. s level) 1)))

;; Leaves the unit.
(defun store-leave (s: Store) -> unit
  (set! (. s level) (max 0 (- @(. s level) 1))))

;; A fresh unification variable at the current level.
(defun store-fresh (s: Store) -> Ty
  (let ((id (map-count @(. s nodes))))
    (do (set! (. s nodes) (assoc @(. s nodes) id (Unbound @(. s level))))
        (TVar id))))

;; A fresh colour variable.
(defun store-fresh-colour (s: Store) -> Colour
  (let ((id @(. s colours)))
    (do (set! (. s colours) (+ id 1))
        (CVar id))))

;; The level of an unbound variable, nil if it is bound.
(defun store-level-of (s: Store v: i64) -> (Option i64)
  (match (get @(. s nodes) v)
    ((some (Unbound l)) (some l))
    (_ nil)))

;; Follows the links from t to its representative: an unbound variable or
;; a non-variable type. Compresses the path.
(defun store-resolve (s: Store t: Ty) -> Ty
  (match t
    ((TVar v) (resolve-var s v))
    (_ t)))

(defun resolve-var :private (s: Store v: i64) -> Ty
  (let ((nodes @(. s nodes)))
    (loop ((cur v) (path (vec-empty)))
      (match (get nodes cur)
        ((some (Link (TVar next))) (recur next (conj path cur)))
        ((some (Link t)) (do (compress s path t) t))
        (_ (do (compress s path (TVar cur)) (TVar cur)))))))

;; Links every variable of path directly to rep.
(defun compress :private (s: Store path: (Vec i64) rep: Ty) -> unit
  (if (empty? path)
      ()
      (set! (. s nodes)
            (reduce (fn (m: (Map i64 VarNode) p: i64) (assoc m p (Link rep)))
                    @(. s nodes) path))))

;; Binds the unbound variable v to t, lowering the level of the unbound
;; variables of t to v's (Rémy). The caller has done the occurs check.
(defun store-bind (s: Store v: i64 t: Ty) -> unit
  (let ((level (unwrap-or (store-level-of s v) @(. s level))))
    (do (run! (fn (u: i64) (lower-level s u level)) (ty-vars t))
        (set! (. s nodes) (assoc @(. s nodes) v (Link t))))))

;; Lowers the level of the unbound representative of variable u to level
;; if it is higher.
(defun lower-level :private (s: Store u: i64 level: i64) -> unit
  (match (resolve-var s u)
    ((TVar r)
     (match (get @(. s nodes) r)
       ((some (Unbound l))
        (set! (. s nodes) (assoc @(. s nodes) r (Unbound (min l level)))))
       (_ ())))
    (_ ())))

;; t with every bound variable replaced by what it is bound to.
(defun store-zonk (s: Store t: Ty) -> Ty
  (match (store-resolve s t)
    ((TCon c args) (TCon c (mapv (fn (a: Ty) (store-zonk s a)) args)))
    ((TFn k ps r)
     (TFn k (mapv (fn (p: Ty) (store-zonk s p)) ps) (store-zonk s r)))
    (other other)))

;; Whether the unbound variable v occurs in t.
(defun store-occurs (s: Store v: i64 t: Ty) -> bool
  (includes? v (ty-vars (store-zonk s t))))
