;; compiler/types/driver.fib: the checker's entry points: lower the modules, then infer (package P6).
;; Replaces crates/fibref/src/types/mod.rs.
;; STUB of M6 step 3 package P1 (the signatures are the Rust ones: Form is Stx,
;; Result is the prelude's, `&mut Foo` is the Foo of Cells, an id an i64); the
;; package that owns this module writes the bodies and the data marked below.
(ns types.driver
  (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast types.decls types.lower.mod types.program expand.ctx expand.types))

;; Rust `Lowered` (mod.rs:147): the globals and the items of the prelude and
;; of each module.
(defstruct Lowered (globals: Globals prelude: ModuleItems modules: (Vec ModuleItems)))

;; Rust `SourceError` (mod.rs:264): where `check_source` failed.
(defenum SourceError
  (SePrelude message: str)
  (SeRead message: str)
  (SeExpand message: str)
  (SeType errors: (Vec TypeError)))

;; Rust: mod.rs:66 prelude_forms
(defun prelude-forms (ctx: ExpandCtx) -> (Result (Vec Stx) str)
  (trap "todo: prelude-forms"))

;; Rust: mod.rs:76
(defun check-program (forms: (Vec Stx) prelude: (Vec Stx)) -> (Result TypedProgram (Vec TypeError))
  (trap "todo: check-program"))

;; Rust: mod.rs:82 (Vec Expanded) is Vec<(ModuleSpec, Vec<Form>)>
(defun check-modules (modules: (Vec Expanded) prelude: (Vec Stx)) -> (Result TypedProgram (Vec TypeError))
  (trap "todo: check-modules"))

;; Rust: mod.rs:107
(defun check-library (forms: (Vec Stx) prelude: (Vec Stx)) -> (Result TypedProgram (Vec TypeError))
  (trap "todo: check-library"))

;; Rust: mod.rs:159
(defun lower-program (forms: (Vec Stx) prelude: (Vec Stx)) -> (Result Lowered (Vec TypeError))
  (trap "todo: lower-program"))

;; Rust: mod.rs:168
(defun lower-modules (modules: (Vec Expanded) prelude: (Vec Stx)) -> (Result Lowered (Vec TypeError))
  (trap "todo: lower-modules"))

;; Rust: mod.rs:243
(defun infer-lowered (l: Lowered main: bool) -> (Result TypedProgram (Vec TypeError))
  (trap "todo: infer-lowered"))

;; Rust: mod.rs:278
(defun check-source (source: str file: str) -> (Result TypedProgram SourceError)
  (trap "todo: check-source"))
