;; compiler/serve/livedefs.fib: the `def`s of a live session (docs/design/live-repl.md 3.5 and 9, package LT4 of docs/design/live-meshql.md).
;; A `def` of the program's own modules is read by every body through its slot `live.d.NAME` with an acquire load (emit.program
;; `live-def-slot`; live mode only: a plain emit reads a constant inline and a run-time def from `def.slot.N`, and a second `def` of a
;; name is the error it was). Here:
;;   - `make-slots`: the `def`s an input's program has and the running program lacks (a session `def`, a new `def` of a loaded file, a
;;     library `def` first reached) made resident, their initialisers run once on the attach thread, in the order of their ids;
;;   - a redefinition (the same name defined again at the REPL or in a loaded file): its type must be the running program's (resident
;;     code reads the slot as that type; else `live/Def`) and its value one word (`live/Def` otherwise: resident code holds the value
;;     inline). A run-time `def`'s new initialiser is lowered under a name of its own (emit.compile `request-def`), cut out, and run once
;;     on the attach thread by an entry that shares the value (`fib.share`: every thread reads it, so its counts are atomic) and stores
;;     it with `live.d.NAME.set` (a release store); the next read of any thread sees it. A constant is stored by `sync-constants`. A
;;     `defonce` keeps the value: its text is accepted and nothing runs. A slot nothing resident reads (a constant no body of the running
;;     program reads) has no setter: the text is enough.
;;   - the old value is not freed at the store: a thread may be reading it. It waits on the session's list until a retirement (the
;;     program quiescent, serve.liveretire), and is dropped then (`fib.release`, the destructor included) unless a family a parked
;;     thread can be in reads the slot (its frame may borrow the value count-free across the pause point): it waits for the next one. A
;;     copy the program stored anywhere holds a count of its own (a borrowed def stored is retained), so the drop frees only what no one
;;     holds. An immortal old value (made before `main`, or static data) is never freed and is counted as such.
(ns serve.livedefs
  (:use lir.ast lir.types)
  (:require [serve.livesess :as ls] [serve.livetable :as lt] [serve.replcore :as rc] [emit.compile :as ec] [emit.node :as n]
            [emit.function :as f] [live.jit :as lj] [live.extract :as ex] [types.decls :as td] [types.init :as ti] [own.driver :as od]
            [types.table :as tb] [emit.names :as en] [own.program :as op] [fib.string :as s]))

;; ---- new defs

;; Whether every slot an input's program shares with the base names the base's `def` (the ids are given in the order the modules are
;; loaded; a program whose modules came in another order would read another def's slot: refused before anything of it is added).
(defun slots-agree :private (sx: ls/Sess made: ls/Made) -> (Result unit str)
  (match (first (vec (keep (fn (it: LItem)
                             (match it
                               ((ItGlobal gl) (match (get @(. sx slot-names) (. gl name))
                                                (nil nil)
                                                ((some want) (let ((got (. (ls/slot-def (ls/made-g made) (. gl name)) fst)))
                                                               (if (= want got) nil (some (str "live: " (. gl name) " is " got " in the input's program but " want " in the running program; the input is refused")))))))
                               (_ nil)))
                           (. (. made m) items))))
    (nil (Ok ()))
    ((some m) (Err m))))

;; What an input's program needs of the running program's `def`s before anything of it runs: the slots agree, the new `def`s made, and
;; the constants whose text changed stored (`sync-constants`).
(defun make-slots (sx: ls/Sess made: ls/Made) -> (Result unit str)
  (try-let ((_ (slots-agree sx made)) (_ (make-new sx made))) (sync-constants sx made)))

;; The `def`s of a program the base lacks (an input's own, a loaded file's new one, or the library's that the program did not reach)
;; made resident: their slots exported and one init function of theirs, run once here in the order of their ids (syntax §3.19), kept
;; for good.
(defun make-new :private (sx: ls/Sess made: ls/Made) -> (Result unit str)
  (let ((slots (new-slots sx made)) (init-name (str "live.defs." @(. sx inputs))))
    (if (empty? slots)
        (Ok ())
        (try-let ((a (ls/add-cut sx (. made m) [] (into (conj (mapv (fn (p: (Pair str LItem)) (. p snd)) slots) (defs-init (ls/made-g made) init-name slots))
                                                      (setters (. made m) slots)) []))
                  (_ (ls/run-void (ls/jit-of sx) init-name)))
          (do (ls/keep-module sx a)
              (set! (. sx resident) (into @(. sx resident) (mapv (fn (p: (Pair str LItem)) (. p fst)) slots)))
              (Ok ()))))))

;; The setters of the new live slots (`live.d.NAME.set`), so that a later redefinition can store them.
(defun setters :private (m: LModule slots: (Vec (Pair str LItem))) -> (Vec LItem)
  (let ((pi (ex/index-of m))) (vec (keep (fn (p: (Pair str LItem)) (get pi (str (. p fst) ".set"))) slots))))

;; A slot of a `def` made at run time: `def.slot.N`, or a live slot `live.d.NAME` (not its setter) whose `def` is not a constant.
(defun init-slot? :private (constants: (Set str) name: str) -> bool
  (or (s/starts-with? name "def.slot.")
      (and (s/starts-with? name "live.d.") (not (s/ends-with? name ".set")) (not (contains? constants name)))))

;; The live slots of the constant `def`s of the program (a constant's slot holds its value from the start: nothing to run).
(defun constant-slots :private (g: td/Globals) -> (Set str)
  (reduce (fn (acc: (Set str) d: i64)
            (if (. (td/g-def g d) constant) (conj acc (str "live." (en/body-name g (op/BodyDef d) []))) acc))
          (set-empty) (range (tb/table-count (. g defs)))))

;; The slots of the program the base lacks: the new `def`s made at run time, each exported, by name.
(defun new-slots :private (sx: ls/Sess made: ls/Made) -> (Vec (Pair str LItem))
  (let ((constants (constant-slots (ls/made-g made))))
    (vec (keep (fn (it: LItem)
                 (match it
                   ((ItGlobal g) (if (and (init-slot? constants (. g name)) (nil? (get @(. sx base) (. g name))))
                                     (some (Pair (. g name) (ItGlobal (LGlobalDef (. g name) (. g ty) (. g init) (. g constant) (LModifiers LkExternal false) (. g pos) (. g shared)))))
                                     nil))
                   (_ nil)))
               (. (. made m) items)))))

;; The `def` of a slot: its name (for a trap's message) and its body's name. A live slot `live.d.NAME` is the body `d.NAME`.
(defun slot-body :private (g: td/Globals slot: str) -> (Pair str str)
  (if (s/starts-with? slot "live.")
      (let ((body (str-slice slot 5 (str-len slot)))) (Pair (str-slice body 2 (str-len body)) body))
      (ls/slot-def g slot)))

(defun object-slot? :private (it: LItem) -> bool
  (match it ((ItGlobal g) (= (. g ty) TPtr)) (_ false)))

;; The init function of the new slots, as emit.inits `init-body` writes one (`fib.initdef` named, stored). An object of a `def.slot.N` is
;; immortalised as the program's are; an object of a live slot is shared and keeps its count, so that a redefinition can drop it.
(defun defs-init :private (g: td/Globals name: str slots: (Vec (Pair str LItem))) -> LItem
  (let ((body (loop ((k (- (count slots) 1)) (tail [(n/ret nil)]))
                (if (< k 0)
                    tail
                    (let ((slot (. (nth slots k) fst)) (v (str "v" k)) (object (object-slot? (. (nth slots k) snd))))
                      (let ((dn (slot-body g slot)))
                        (recur (- k 1)
                               [(n/store (n/string (str "def " (. dn fst) ": ")) (n/global "fib.initdef") nil)
                                (f/bound [(f/binding v (n/call (. dn snd) []))]
                                         (into (if object [(n/call (if (s/starts-with? slot "live.") "fib.share" "fib.immortalise") [(n/local v)])] [])
                                               (into [(n/store (n/local v) (n/global slot) nil)] tail)))])))))))
    (ItDefine (f/external (f/make name nil [] cc-c [(f/block "entry" body)])))))

;; ---- constants whose text changed under the running program

;; A constant `def` is read by resident code from its live slot, whose initial value is the constant the program that made the slot
;; had. When the text changes (a redefinition at the REPL or in a loaded file, or a required module edited on disk and read anew by
;; the next input), the input's program has the slot with the new constant: every such slot whose value differs from the one the
;; running program holds (the base's, or the last stored here) is stored with the program's, by an entry of the input, before anything
;; else of it runs. The old constant is static data and is never freed; the new one is kept with the entry's module.
(defun changed-constants :private (sx: ls/Sess made: ls/Made) -> (Vec LGlobalDef)
  (let ((constants (constant-slots (ls/made-g made))) (stored (. @(. sx defs) stored)))
    (vec (keep (fn (it: LItem)
                 (match it
                   ((ItGlobal g)
                    (if (contains? constants (. g name))
                        (match (get @(. sx base) (. g name))
                          ((some (ItGlobal b)) (let ((now (unwrap-or (get stored (. g name)) (n/text (. b init)))))
                                                 (if (= now (n/text (. g init))) nil (some g))))
                          (_ nil))
                        nil))
                   (_ nil)))
               (. (. made m) items)))))

(defun sync-constants :private (sx: ls/Sess made: ls/Made) -> (Result unit str)
  (let ((gs (changed-constants sx made)) (name (str "live.sync." @(. sx inputs))))
    (if (empty? gs)
        (Ok ())
        (let ((entry (ItDefine (f/external (f/make name (some ty-i64) [] cc-c
                                                   [(f/block "entry" (conj (mapv (fn (g: LGlobalDef) (n/call (str (. g name) ".set") [(. g init)])) gs)
                                                                           (n/ret (some (n/integer ty-i64 0)))))])))))
          (try-let ((a (ls/add-cut sx (. made m) [] [entry] []))
                    (at (lj/c-entry (ls/jit-of sx) name))
                    (_ (lj/call at [])))
            (let ((d @(. sx defs)))
              (do (ls/keep-module sx a)
                  (set! (. sx defs) (lt/DefState (. d types) (. d retired) (. d drop) (+ (. d redefined) (count gs)) (. d dropped) (. d immortal)
                                                 (reduce (fn (acc: (Map str str) g: LGlobalDef) (assoc acc (. g name) (n/text (. g init)))) (. d stored) gs)))
                  (Ok ()))))))))

;; ---- redefinitions

;; A `def` an input defines again: its name, its module (nil: the main module's), its body's name (`d.NAME`, `d.MODULE.NAME`), and
;; whether it keeps the value (`defonce`).
(defstruct Redef (name: str module: (Option str) body: str keep: bool))

(defun def-text? (d: rc/Def) -> bool (or (s/starts-with? (. d text) "(def ") (s/starts-with? (. d text) "(defonce ")))

;; The `def`s among `defs` (each one the running program already has), of module `module`.
(defun redefs-of (defs: (Vec rc/Def) module: (Option str)) -> (Vec Redef)
  (mapv (fn (d: rc/Def) (Redef (. d name) module (str "d." (match module ((some m) (str m ".")) (nil "")) (. d name)) (s/starts-with? (. d text) "(defonce ")))
        (filterv def-text? defs)))

;; The initialisers to lower: each redefinition's that does not keep its value (emit.compile `request-def`).
(defun def-requests (rs: (Vec Redef)) -> (Vec ec/BodyRequest)
  (mapv (fn (r: Redef) (ec/BodyRequest (. r name) false [] (some "def:") [] (. r module))) (filterv (fn (r: Redef) (not (. r keep))) rs)))

;; A refusal of a redefinition: the definition and the message.
(defstruct DefRefusal (name: str message: str))

;; The first redefinition whose type is not the running program's: resident code reads the slot as the old type.
(defun type-refusal (sx: ls/Sess c: od/Checked rs: (Vec Redef)) -> (Option DefRefusal)
  (let ((now (lt/def-types-of c)) (was (. @(. sx defs) types)))
    (first (vec (keep (fn (r: Redef)
                        (match (get was (. r body))
                          (nil nil)
                          ((some old) (match (get now (. r body))
                                        ((some new) (if (= old new) nil
                                                        (some (DefRefusal (. r name) (str (. r name) " is a def of type " old " in the running program and " new " here; a def changes type at a restart")))))
                                        (nil nil)))))
                      rs)))))

;; The lowered result type of a redefinition's initialiser in the input's program.
(defun result-type :private (made: ls/Made r: Redef) -> (Option LType)
  (match (get (ex/index-of (. made m)) (. r body)) ((some (ItDefine fd)) (. (. fd ty) ret)) (_ nil)))

(defun word? :private (t: (Option LType)) -> bool
  (match t ((some (TInt b)) (>= b 8)) ((some (TFloat)) true) ((some (TDouble)) true) ((some (TPtr)) true) (_ false)))

;; The first redefinition whose value is not one word (an `Option`, a `dyn`, a `bool`): it has no slot, resident code holds it inline.
(defun shape-refusal (made: ls/Made rs: (Vec Redef)) -> (Option DefRefusal)
  (first (vec (keep (fn (r: Redef)
                      (if (or (. r keep) (word? (result-type made r))) nil
                          (some (DefRefusal (. r name) (str (. r name) " is a def whose value resident code holds inline (not one word); it changes at a restart")))))
                    rs))))

;; The entry of redefinition `r`: the new initialiser (cut out as `renamed`) run, an object shared, the old value read (only this
;; thread stores the slot) and the new one stored with the setter's release store; the old object's address is the result, else 0.
(defun entry-item :private (name: str r: Redef renamed: str ty: LType) -> LItem
  (let ((slot (str "live." (. r body))) (object (= ty TPtr)))
    (ItDefine (f/external (f/make name (some ty-i64) [] cc-c
      [(f/block "entry"
         [(n/store (n/string (str "def " (. r name) ": ")) (n/global "fib.initdef") nil)
          (f/bound [(f/binding "v" (n/call renamed []))]
                   (into (if object [(n/call "fib.share" [(n/local "v")])] [])
                         [(f/bound [(f/binding "old" (n/load ty (n/global slot) nil))]
                                   [(n/call (str slot ".set") [(n/local "v")])
                                    (n/ret (some (if object (n/cast CPtrToInt ty-i64 (n/local "old")) (n/integer ty-i64 0))))])]))])])))))

;; The redefinitions that store a slot: those that do not keep their value and whose slot the running program has (a setter resident).
;; A constant's slot is stored by `sync-constants` (the program's slot holds the new constant).
(defun storing :private (sx: ls/Sess made: ls/Made rs: (Vec Redef)) -> (Vec Redef)
  (let ((constants (constant-slots (ls/made-g made))))
    (filterv (fn (r: Redef) (let ((slot (str "live." (. r body))))
                              (and (not (. r keep)) (not (contains? constants slot)) (some? (get @(. sx base) (str slot ".set"))))))
             rs)))

;; The redefinitions applied, after the input's new slots are made: the new initialisers cut out under names of their own with their
;; entries, kept, each entry run once; the old objects put on the list for a retirement.
(defun apply-redefs (sx: ls/Sess made: ls/Made rs: (Vec Redef)) -> (Result unit str)
  (let ((todo (storing sx made rs)) (k @(. sx inputs)))
    (if (empty? todo)
        (Ok ())
        (let ((renamed (fn (r: Redef) -> str (str (. r body) ".r" k))) (entry (fn (i: i64) -> str (str "live.redef." k "." i))))
          (try-let ((items (ti/try-map (fn (i: i64) (match (result-type made (nth todo i))
                                                     ((some ty) (Ok (entry-item (entry i) (nth todo i) (renamed (nth todo i)) ty)))
                                                     (nil (Err (str "live: no initialiser of " (. (nth todo i) name) " in the input's program")))))
                                       (vec (range (count todo)))))
                    (a (ls/add-cut sx (. made m) (mapv (fn (r: Redef) (Pair (. r body) (renamed r))) todo) items []))
                    (olds (ti/try-map (fn (i: i64) (try-let ((at (lj/c-entry (ls/jit-of sx) (entry i)))) (lj/call at []))) (vec (range (count todo))))))
            (do (ls/keep-module sx a)
                (note-olds sx todo olds)
                (Ok ())))))))

(defun note-olds :private (sx: ls/Sess todo: (Vec Redef) olds: (Vec i64)) -> unit
  (let ((d @(. sx defs))
        (gone (vec (keep (fn (i: i64) (if (= (nth olds i) 0) nil (some (lt/RetiredDef (str "live." (. (nth todo i) body)) (nth olds i))))) (range (count todo))))))
    (set! (. sx defs) (lt/DefState (. d types) (into (. d retired) gone) (. d drop) (+ (. d redefined) (count todo)) (. d dropped) (. d immortal) (. d stored)))))

;; The defs' types as `c`'s program has them, after an accepted input.
(defun note-types (sx: ls/Sess c: od/Checked) -> unit
  (let ((d @(. sx defs)))
    (set! (. sx defs) (lt/DefState (merge (. d types) (lt/def-types-of c)) (. d retired) (. d drop) (. d redefined) (. d dropped) (. d immortal) (. d stored)))))

;; ---- the drop at a retirement

;; `live.def-drop P`: the object at P released unless it is immortal (1 when released, 0 when immortal), added once to the session.
(def drop-source: str
  "(declare fib.flags i32 (ptr))\n(declare fib.release void (ptr))\n(define (live.def-drop i64) ((i64 p)) (block entry (let ((q (inttoptr ptr p))) (br (icmp ne (and (call @fib.flags q) (i32 8)) (i32 0)) kept free))) (block kept (ret (i64 0))) (block free (call @fib.release q) (ret (i64 1))))\n")

(defun drop-address :private (sx: ls/Sess) -> (Result i64 str)
  (let ((d @(. sx defs)))
    (if (> (. d drop) 0)
        (Ok (. d drop))
        (try-let ((_ (lj/add-resident-source (ls/jit-of sx) "live.def-drop" drop-source)) (at (lj/c-entry (ls/jit-of sx) "live.def-drop")))
          (do (set! (. sx defs) (lt/DefState (. d types) (. d retired) at (. d redefined) (. d dropped) (. d immortal) (. d stored)))
              (Ok at))))))

;; The slots read by the code in `bearing` (the families and other code a parked thread can be in: serve.livereach `bearing`).
(defun slots-read-by :private (sx: ls/Sess bearing: (Set str)) -> (Set str)
  (let ((index (lt/family-index (ls/live-bodies sx))))
    (reduce (fn (acc: (Set str) p: (Pair str (Vec str)))
              (if (contains? bearing (unwrap-or (lt/family-of-name index (. p fst)) (. p fst)))
                  (reduce (fn (a: (Set str) r: str) (if (s/starts-with? r "live.d.") (conj a r) a)) acc (. p snd))
                  acc))
            (set-empty) (vec (. (ls/reach sx) calls)))))

;; At a retirement (the program quiescent): every old value on the list dropped, unless a family a parked thread can be in reads its
;; slot (that one waits for the next retirement).
(defun drop-retired (sx: ls/Sess bearing: (Set str)) -> (Result unit str)
  (let ((d @(. sx defs)) (held (slots-read-by sx bearing)))
    (let ((now (filterv (fn (r: lt/RetiredDef) (not (contains? held (. r slot)))) (. d retired)))
          (wait (filterv (fn (r: lt/RetiredDef) (contains? held (. r slot))) (. d retired))))
      (if (empty? now)
          (Ok ())
          (try-let ((at (drop-address sx))
                    (freed (ti/try-map (fn (r: lt/RetiredDef) (lj/call at [(. r value)])) now)))
            (let ((n (reduce + 0 freed)) (d2 @(. sx defs)))
              (do (set! (. sx defs) (lt/DefState (. d2 types) wait (. d2 drop) (. d2 redefined) (+ (. d2 dropped) n) (+ (. d2 immortal) (- (count now) n)) (. d2 stored)))
                  (Ok ()))))))))
