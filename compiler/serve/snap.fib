;; compiler/serve/snap.fib: a snapshot of the expander's context (docs/design/dev-loop.md section 8). Every part of an `ExpandCtx` is a `Cell` holding
;; persistent values (maps, vectors, numbers), so a copy of the cells is a context that continues exactly where the first one was, and the first one
;; is not changed by what the copy goes on to expand. The server keeps one snapshot after each module it has expanded: a request that changes one
;; module restores the snapshot before it and expands only from there on. The constructor is positional on purpose: a field added to `ExpandCtx`
;; makes this file fail to compile, which is better than a snapshot that forgets it.
(ns serve.snap
  (:use expand.ctx))

;; A context equal to `c` and independent of it.
(defun ctx-snapshot (c: ExpandCtx) -> ExpandCtx
  (ExpandCtx (cell @(. c limits))
             (cell @(. c gensyms))
             (cell @(. c macros))
             (cell @(. c exports))
             (cell @(. c defined))
             (cell @(. c scope))
             (cell @(. c hides))
             (cell @(. c own))
             (cell @(. c overloads))
             (cell @(. c structs))
             (cell @(. c enums))
             (cell @(. c private-types))
             (cell @(. c hidden-types))
             (cell @(. c call-pos))
             (cell @(. c steps))
             (cell @(. c forms))
             (cell @(. c macro-names))
             (cell @(. c macro-ns)) (cell @(. c gained)) (cell @(. c templating))))
