;; compiler/serve/liveclient.fib: `fibc repl --connect SOCK|PID [--json]` (docs/design/live-repl.md 2.4, package LV1): the client of a
;; program started with `fibc run --live` (serve.live). The terminal form reads inputs as the REPL does (serve.line: editing on a
;; terminal, plain lines from a pipe; an input continues while its brackets are open) and sends each as an `eval`, printing the value,
;; `; failed: ..` for a caught trap, `; defined ..`, or the refusal's lines; `:type EXPR`, `:inspect NAME` (a lookup, LE4), `:status`, `:pause [MS]`,
;; `:resume`, `:retire` (serve.liveretire, package LV3), `:test [SPEC] [words of fibc test]` and `:test` alone to rerun the last selection
;; (serve.livetest, package LT2 of docs/design/live-meshql.md 3.9: the answer's document rendered as `fibc test` prints a file, through
;; serve.livewords), `:load FILE` and `:reload` (serve.liveload, package LM1: a module of the program edited on disk, swapped as one
;; input; `:status` lists the loaded files), `:watch on [DIR..]` and `:watch off` (serve.livewatch, package LT5: the events a change
;; brings are printed as they come, between inputs), `:help`, `:quit`.
;; `--json` is the stdio form for an agent or an editor: one request per line in, forwarded as it is, one answer per line out. When
;; nothing listens at the socket (the program was not started with `--live`, or has ended) every request is answered `not-live`.
(ns serve.liveclient
  (:require [serve.livesock :as lsk] [serve.sock :as sk] [serve.line :as ln] [serve.replcore :as rc] [serve.livewords :as lw] [lsp.json :as j]
            [driver.native :as native] [fib.unix :as unix] [fib.string :as s]))

(def help-text: str
  "inputs: definitions (def defun defrecord ..) are made resident in the running program; a function defined again is swapped (its callers
        use the new body from their next call); an expression is evaluated there and its value printed
:type EXPR      the type of EXPR         :inspect NAME  a function's generation and scheme, a def's type   :status  the session's figures and threads
:pause [MS]     the program parks at its pause points (up to MS ms, 5000, waiting for quiescence)    :resume  lets it run again
:retire         at quiescence, frees the code of every old generation no thread can be in
:test [SPEC] [--only ID] [--tags EXPR] [--name RE] [--seed N] [-j N] [--isolate task|none] [--list] [--dry-run]
                runs the spec in the program (SPEC: a --with file, or an expression of the suites; none: the program's (specs), else the
                first --with file) and prints the rows as fibc test does; :test alone reruns the last selection
:load FILE      a module of the program edited on disk: its changed functions are swapped, all or nothing; the loaded text is what the
                session sees of the module until the next :load or :reload       :reload  loads again every loaded file that changed
:watch on [DIR..]  a changed module file is loaded and the last :test rerun (the files under DIR too: feature files rerun it
                without a load); a refused load reruns nothing       :watch off  stops it
:help           this                     :quit (ctrl-d) end the client; the program goes on")

;; `json`: the stdio form (an event line is printed as it is); `watching`: `:watch on` was answered (events may come between inputs).
(defstruct Client (fd: i64 conn: sk/Conn json: bool watching: (Cell bool)))

(defun connect (target: str json: bool) -> (Result Client str)
  (match (sk/connect-unix (lsk/resolve-target target))
    ((Err m) (Err m))
    ((Ok fd) (Ok (Client fd (sk/conn-new fd) json (cell false))))))

(defun event? :private (line: str) -> bool (s/starts-with? line "{\"event\":"))

;; One request and its answer line; the events (serve.livewatch) that come before it are shown. An answer that says `watching` sets
;; whether events come between inputs.
(defun exchange (c: Client line: str) -> (Result str str)
  (match (sk/write-line (. c fd) line)
    ((Err m) (Err m))
    ((Ok _) (loop ()
              (match (sk/conn-read-line (. c conn))
                ((Err m) (Err m))
                ((Ok nil) (Err "the program closed the connection"))
                ((Ok (some l)) (if (event? l) (do (show-event c l) (recur)) (do (note-watch c l) (Ok l)))))))))

(defun note-watch :private (c: Client line: str) -> unit
  (match (j/json-parse line)
    ((Ok v) (match (field v "watching") ((some (j/JBool b)) (do (set! (. c watching) b) ())) (_ ())))
    ((Err _) ())))

;; An event line: as it is in the stdio form; else a `load` as `:load` prints it, a `test` as `:test` does after the line that says why.
(defun show-event :private (c: Client line: str) -> unit
  (if (. c json)
      (println line)
      (match (j/json-parse line)
        ((Err _) (println line))
        ((Ok v) (do (when (= (str-of v "event") "test") (println "; watch: a file changed; the last :test again"))
                    (show-answer v))))))

;; The events that are there now, shown (on a terminal over the prompt, which is written again after each).
(defun drain-events :private (c: Client tty: bool prompt: str) -> unit
  (loop ()
    (when (sk/conn-line-ready? (. c conn) 0)
      (match (sk/conn-read-line (. c conn))
        ((Ok (some l)) (do (when tty (do (native/write-stdout "\r\x1b[K") ())) (show-event c l) (when tty (do (native/write-stdout prompt) ())) (recur)))
        (_ ())))))

;; While watching: the events that come are shown until input `in` can be read. On a terminal the prompt is written first, and the line
;; editor's own prompt then overwrites it (`\r`).
(defun await-input :private (c: Client in: sk/Conn tty: bool prompt: str) -> unit
  (when @(. c watching)
    (do (when tty (do (native/write-stdout prompt) ()))
        (loop ()
          (if (sk/conn-line-ready? in 250)
              (when tty (do (native/write-stdout "\r") ()))
              (do (drain-events c tty prompt) (recur)))))))

(defun req (op: str fields: (Vec (Pair str j/JVal))) -> str
  (j/json-text (j/json-obj (into [(Pair "op" (j/json-str op))] fields))))

(defun not-live-line (why: str) -> str
  (j/json-text (j/json-obj [(Pair "id" j/JNull) (Pair "ok" (j/JBool false))
                            (Pair "error" (j/json-obj [(Pair "code" (j/json-str "not-live")) (Pair "message" (j/json-str (str "no live program answers (" why "); start it with fibc run --live")))]))])))

;; ---- --json: lines through

(defun json-loop :private (c: (Option Client) why: str) -> i64
  (let ((in (sk/conn-new 0)))
    (loop ((bad 0))
      (match (do (match c ((some cl) (await-input cl in false "")) (nil ())) (sk/conn-read-line in))
        ((Ok nil) (if (> bad 0) 2 0))
        ((Err _) (if (> bad 0) 2 0))
        ((Ok (some line))
         (match c
           (nil (do (println (not-live-line why)) (recur (+ bad 1))))
           ((some cl) (match (exchange cl line)
                        ((Ok answer) (do (println answer) (recur bad)))
                        ((Err m) (do (println (not-live-line m)) 2))))))))))

;; ---- the terminal form

(defun field :private (v: j/JVal key: str) -> (Option j/JVal) (j/json-get v key))
(defun str-of :private (v: j/JVal key: str) -> str (match (field v key) ((some x) (unwrap-or (j/json-as-str x) "")) (nil "")))
(defun strs-of :private (v: j/JVal key: str) -> (Vec str)
  (match (field v key) ((some (j/JArr xs)) (mapv (fn (x: j/JVal) (unwrap-or (j/json-as-str x) "")) xs)) (_ [])))
(defun int-of :private (v: j/JVal key: str) -> i64 (match (field v key) ((some (j/JInt n)) n) (_ 0)))
(defun join-words :private (xs: (Vec str)) -> str (str-join (vec (interpose ", " xs))))

;; What the answer to an input says, as the REPL would print it.
(defun show-answer :private (v: j/JVal) -> unit
  (cond (some? (field v "generations")) (show-status v)
        (some? (field v "watching")) (println (if (bool-of v "watching") (str "; watching " (int-of v "files") " files") "; watch off"))
        (some? (field v "loaded")) (show-reload v)
        (some? (field v "file")) (show-load v)
        (some? (field v "error")) (println (str "; " (str-of (unwrap-or (field v "error") j/JNull) "message") " [" (str-of (unwrap-or (field v "error") j/JNull) "code") "]"))
        (some? (field v "kind")) (println (inspect-line v))
        (some? (field v "failed")) (println (str "; failed: " (str-of v "failed") " (caught; the program is unaffected)"))
        (some? (field v "shown")) (do (doseq [l (strs-of v "shown")] (println l))
                                      (println (str "; refused; the session and the program are unchanged" (if (some? (field v "generation")) (str " (generation " (int-of v "generation") ")") ""))))
        (some? (field v "value")) (println (str-of v "value"))
        (some? (field v "generation_start")) (show-test v)
        (not (empty? (strs-of v "swapped"))) (do (when (not (empty? (strs-of v "defined"))) (println (str "; defined " (join-words (strs-of v "defined")))))
                                                 (println (swapped-line v))
                                                 (when (running? v) (println (str "; note: " (threads-text v) " are running; generation " (- (int-of v "generation") 1)
                                                                                  " is kept until :retire at a quiescent point"))))
        (some? (field v "defined")) (println (str "; defined " (join-words (strs-of v "defined"))))
        (some? (field v "type")) (println (str-of v "type"))
        (some? (field v "paused")) (println (paused-line v))
        (some? (field v "resumed")) (println (str "; resumed; " (threads-text v)))
        (some? (field v "removed")) (println (str "; removed " (int-of v "removed") (if (= (int-of v "removed") 1) " generation" " generations")
                                                 "; " (int-of v "kept") " kept" (if (= (str-of v "pinned_text") "") "" (str ", pinned: " (str-of v "pinned_text")))
                                                 " (generation " (int-of v "generation") ")"))
        (not (= (int-of v "exit") 0)) (println (str "; the input ended with status " (int-of v "exit")))
        :else ()))

;; `:inspect NAME` (LE4): `; function, generation 2: (fn (i64) i64); bodies f.f.g2, f.f.owned.g2; parameters borrowed` or
;; `; def of type (Atom i64), slot live.d.counter`.
(defun inspect-line :private (v: j/JVal) -> str
  (if (= (str-of v "kind") "function")
      (str "; function, generation " (int-of v "generation") ": " (str-of v "scheme") "; bodies " (join-words (strs-of v "bodies"))
           (if (empty? (strs-of v "summary")) "" (str "; parameters " (join-words (strs-of v "summary")))))
      (str "; def of type " (str-of v "type") (if (= (str-of v "slot") "") "" (str ", slot " (str-of v "slot"))))))

;; `:status`: the generation, the generations and modules kept, the threads, the values, the inputs, the tests, the loaded files.
(defun show-status :private (v: j/JVal) -> unit
  (println (str "; generation " (int-of v "generation") "; generations kept " (int-of (unwrap-or (field v "generations") j/JNull) "count")
                "; modules kept " (int-of (unwrap-or (field v "generations") j/JNull) "kept")
                "; threads: " (threads-text v)
                "; values: " (int-of (unwrap-or (field v "values") j/JNull) "count") " resident; inputs " (int-of v "inputs")
                "; " (lw/tests-text (unwrap-or (field v "tests") j/JNull)) (loaded-text v))))

;; `; routes.fib: 3 definitions, 1 changed: swapped routes/route (generation 1): check 41 ms, emit 6 ms, jit 9 ms`, or the refusal's
;; lines and `; refused; nothing of routes.fib was applied (generation 1)`, or what an unchanged file says.
(defun show-load :private (v: j/JVal) -> unit
  (let ((head (str "; " (str-of v "file") ": " (int-of v "definitions") (if (= (int-of v "definitions") 1) " definition" " definitions"))))
    (cond (some? (field v "error")) (println (str head "; " (str-of (unwrap-or (field v "error") j/JNull) "message") " [" (str-of (unwrap-or (field v "error") j/JNull) "code") "]"))
          (some? (field v "shown")) (do (doseq [l (strs-of v "shown")] (println l))
                                        (println (str "; refused; nothing of " (str-of v "file") " was applied (generation " (int-of v "generation") ")")))
          (not (empty? (strs-of v "swapped")))
            (do (when (not (empty? (strs-of v "defined"))) (println (str "; defined " (join-words (strs-of v "defined")))))
                (println (str head ", " (count (strs-of v "changed")) " changed: " (str-slice (swapped-line v) 2 (str-len (swapped-line v))))))
          (not (empty? (strs-of v "defined"))) (println (str head ": defined " (join-words (strs-of v "defined")) " (generation " (int-of v "generation") ")"))
          :else (println (str head ", unchanged (generation " (int-of v "generation") ")")))))

;; `:reload`: each file loaded again as `:load` prints it, or that nothing changed.
(defun show-reload :private (v: j/JVal) -> unit
  (match (field v "loaded")
    ((some (j/JArr items)) (if (empty? items)
                               (println "; nothing to reload: no loaded file differs from its loaded text")
                               (doseq [x items] (show-load x))))
    (_ ())))

;; `; loaded: routes.fib, app.fib (stale: app.fib)` of `:status`, nothing when no file was loaded.
(defun loaded-text :private (v: j/JVal) -> str
  (match (field v "loaded")
    ((some (j/JArr items))
     (if (empty? items)
         ""
         (let ((stale (filterv (fn (x: j/JVal) (bool-of x "stale")) items)))
           (str "; loaded: " (join-words (mapv (fn (x: j/JVal) (str-of x "file")) items))
                (if (empty? stale) "" (str " (stale: " (join-words (mapv (fn (x: j/JVal) (str-of x "file")) stale)) ")"))))))
    (_ "")))

;; A finished test run: the document's rows and summary as `fibc test` prints them (the `replay:` lines as `:test` commands), the
;; listing of `--list`, or the trap's message; then the run's line and the stale note (serve.livewords).
(defun show-test :private (v: j/JVal) -> unit
  (do (match (field v "report")
        ((some (j/JObj ks vs)) (print (lw/report-text (j/JObj ks vs))))
        (_ (print (str-of v "text"))))
      (when (some? (field v "error")) (println (str "; " (str-of (unwrap-or (field v "error") j/JNull) "message") " [" (str-of (unwrap-or (field v "error") j/JNull) "code") "]")))
      (println (lw/test-line v))))

;; `:test` words to the request's fields: SPEC (a file, or an expression of the suites in brackets) first, then the words of `fibc test`
;; (3.9); `--format`, `--timeout` and `--isolate fork` are refused here with the reason, as the program would refuse them.
(defun test-request :private (words: (Vec str)) -> (Result str str)
  (loop ((i 0) (fields []))
    (if (>= i (count words))
        (Ok (req "test" (if (empty? fields) [(Pair "last" (j/JBool true))] fields)))
        (let ((w (nth words i)) (v (if (< (+ i 1) (count words)) (nth words (+ i 1)) "")))
          (cond (and (= i 0) (not (s/starts-with? w "-")))
                  (recur (+ i 1) (conj fields (if (s/starts-with? w "(") (Pair "suites" (j/json-str w)) (Pair "spec" (j/json-str w)))))
                (= w "--format") (Err "the report is rendered here as fibc test prints it; --json passes the document through")
                (= w "--timeout") (Err "a hung scenario cannot be killed in a live process: run it under fibc test --timeout in a process of its own")
                (and (= w "--isolate") (= v "fork")) (Err "fork isolation is refused in a live process (it has threads); task (the default) or none")
                (or (= w "--only") (or (= w "--tags") (or (= w "--name") (= w "--isolate"))))
                  (recur (+ i 2) (conj fields (Pair (str-slice w 2 (str-len w)) (j/json-str v))))
                (or (= w "--seed") (or (= w "-j") (= w "--jobs")))
                  (match (parse-long v)
                    (nil (Err (str w " wants a whole number")))
                    ((some n) (recur (+ i 2) (conj fields (Pair (if (= w "--seed") "seed" "jobs") (j/json-int n))))))
                (= w "--list") (recur (+ i 1) (conj fields (Pair "list" (j/JBool true))))
                (= w "--dry-run") (recur (+ i 1) (conj fields (Pair "dry" (j/JBool true))))
                :else (Err (str "unknown word " w "; :help lists :test's")))))))

;; `; swapped handle (generation 1): check 41 ms, emit 6 ms, jit 9 ms`
(defun swapped-line :private (v: j/JVal) -> str
  (let ((t (unwrap-or (field v "swap") j/JNull)))
    (str "; swapped " (join-words (strs-of v "swapped")) " (generation " (int-of v "generation") "): check " (int-of t "check_ms") " ms, emit " (int-of t "emit_ms")
         " ms, jit " (int-of t "jit_ms") " ms")))

(defun threads-of :private (v: j/JVal) -> j/JVal (unwrap-or (field v "threads") j/JNull))
(defun bool-of :private (v: j/JVal key: str) -> bool (match (field v key) ((some (j/JBool b)) b) (_ false)))

;; `1 spawned thread (1 parked) and 28 pool workers (27 active)`
(defun threads-text :private (v: j/JVal) -> str
  (let ((t (threads-of v)))
    (str (int-of t "spawned") (if (= (int-of t "spawned") 1) " spawned thread" " spawned threads") " (" (int-of t "paused") " parked) and "
         (int-of t "pool_workers") (if (= (int-of t "pool_workers") 1) " pool worker" " pool workers") " (" (int-of t "pool_active") " active)")))

;; The note after a swap is for a program whose pool has started (the design's transcript 7): its tasks may be inside the old body.
(defun running? :private (v: j/JVal) -> bool (> (int-of (threads-of v) "pool_workers") 0))

;; `; paused at 3 pause points; pool idle` or `; pause requested, not quiescent after the timeout: 1 thread not at a pause point`
(defun paused-line :private (v: j/JVal) -> str
  (let ((t (threads-of v)))
    (if (bool-of v "paused")
        (str "; paused at " (int-of t "paused") (if (= (int-of t "paused") 1) " pause point" " pause points") "; pool idle (" (int-of t "pool_workers") " workers)")
        (str "; pause requested, not quiescent after the timeout: " (str-of v "running") "; :resume lifts it"))))

(defun send :private (c: Client line: str) -> bool
  (match (exchange c line)
    ((Err m) (do (eprintln (str "fibc repl: " m)) false))
    ((Ok answer) (match (j/json-parse answer)
                   ((Err m) (do (eprintln (str "fibc repl: the answer is not JSON: " m)) false))
                   ((Ok v) (do (show-answer v) true))))))

(defun split-word :private (text: str) -> (Pair str str)
  (match (str-find text " " 0)
    (nil (Pair text ""))
    ((some i) (Pair (str-slice text 0 i) (s/trim (str-slice text (+ i 1) (str-len text)))))))

;; A command or an input; false to end the session.
(defun step :private (c: Client text: str) -> bool
  (let ((t (s/trim text)) (w (split-word (s/trim text))))
    (cond (= t "") true
          (or (= (. w fst) ":quit") (= (. w fst) ":q")) false
          (= (. w fst) ":help") (do (println help-text) true)
          (= (. w fst) ":type") (send c (req "type" [(Pair "expr" (j/json-str (. w snd)))]))
          (= (. w fst) ":inspect") (send c (req "inspect" [(Pair "name" (j/json-str (. w snd)))]))
          (= (. w fst) ":status") (send c (req "status" []))
          (= (. w fst) ":pause") (send c (req "pause" (match (parse-long (. w snd)) ((some ms) [(Pair "timeout_ms" (j/json-int ms))]) (nil []))))
          (= (. w fst) ":resume") (send c (req "resume" []))
          (= (. w fst) ":retire") (send c (req "retire" []))
          (= (. w fst) ":load") (if (= (. w snd) "") (do (println "; :load needs a file") true) (send c (req "load" [(Pair "file" (j/json-str (. w snd)))])))
          (= (. w fst) ":reload") (send c (req "reload" []))
          (= (. w fst) ":watch") (match (watch-request (words-of (. w snd)))
                                   ((Err m) (do (println (str "; " m)) true))
                                   ((Ok line) (send c line)))
          (= (. w fst) ":test") (match (test-request (words-of (. w snd)))
                                  ((Err m) (do (println (str "; " m)) true))
                                  ((Ok line) (send c line)))
          (s/starts-with? t ":") (do (println (str "; unknown command " (. w fst) "; :help lists them")) true)
          :else (send c (req "eval" [(Pair "text" (j/json-str t))])))))

;; The words of a `:test` line, apart at spaces; a quoted word (`--only 'a b'`) is one word.
(defun words-of :private (text: str) -> (Vec str)
  (loop ((i 0) (cur "") (quote "") (out []))
    (if (>= i (str-len text))
        (if (= cur "") out (conj out cur))
        (let ((ch (str-slice text i (+ i 1))))
          (cond (not (= quote "")) (if (= ch quote) (recur (+ i 1) cur "" out) (recur (+ i 1) (str cur ch) quote out))
                (or (= ch "'") (= ch "\"")) (recur (+ i 1) cur ch out)
                (= ch " ") (if (= cur "") (recur (+ i 1) "" "" out) (recur (+ i 1) "" "" (conj out cur)))
                :else (recur (+ i 1) (str cur ch) "" out))))))

;; `:watch on [DIR..]` and `:watch off`.
(defun watch-request :private (words: (Vec str)) -> (Result str str)
  (cond (and (> (count words) 0) (= (nth words 0) "on")) (Ok (req "watch" [(Pair "on" (j/JBool true)) (Pair "dirs" (j/JArr (mapv j/json-str (vec (drop 1 words)))))]))
        (and (= (count words) 1) (= (nth words 0) "off")) (Ok (req "watch" [(Pair "on" (j/JBool false))]))
        :else (Err ":watch on [DIR..] or :watch off")))

(defun continue-input :private (ed: ln/Editor text: str) -> (Result (Option str) str)
  (if (and (rc/incomplete? text) (not (s/starts-with? (s/trim text) ":")))
      (match (ln/read-line ed "...  " false)
        ((Err m) (Err m))
        ((Ok nil) (Ok (some text)))
        ((Ok (some l)) (continue-input ed (str text "\n" l))))
      (Ok (some text))))

(defun hello :private (c: Client) -> unit
  (match (exchange c (req "hello" []))
    ((Err _) ())
    ((Ok answer) (match (j/json-parse answer)
                   ((Ok v) (println (str "; attached to " (str-of v "program") " (pid " (int-of v "pid") ", generation " (int-of v "generation")
                                         (if (match (field v "catching") ((some (j/JBool true)) true) (_ false)) ", catching" "") "); "
                                         (int-of v "threads") (if (= (int-of v "threads") 1) " thread" " threads") ", pool " (int-of v "pool") " workers")))
                   ((Err _) ())))))

(defun terminal-loop :private (c: Client) -> i64
  (let ((ed (ln/editor-new 0)))
    (do (hello c)
        (loop ()
          (match (do (await-input c (. ed conn) (. ed tty) "fib> ") (ln/read-line ed "fib> " false))
            ((Err m) (do (eprintln (str "fibc repl: " m)) 2))
            ((Ok nil) 0)
            ((Ok (some l)) (match (continue-input ed l)
                             ((Err m) (do (eprintln (str "fibc repl: " m)) 2))
                             ((Ok nil) 0)
                             ((Ok (some text)) (if (step c text) (recur) 0)))))))))

;; `fibc repl --connect TARGET [--json]`: 0 at the end of the input; 2 when no program answered (every request answered `not-live`).
(defun connect-main (target: str json: bool) -> i64
  (do (native/ignore-sigpipe)
      (match (connect target json)
        ((Err m) (if json
                     (json-loop nil m)
                     (do (eprintln (str "fibc repl: not-live: " m "; start the program with fibc run --live")) 2)))
        ((Ok c) (let ((code (if json (json-loop (some c) "") (terminal-loop c))))
                  (do (unix/fd-close (. c fd)) code))))))
