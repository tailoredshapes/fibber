;; compiler/serve/live.fib: `fibc run --live FILE [-- arg..]` (docs/design/live-repl.md 2.1 to 2.3, package LV1): the program runs in
;; this process, as the base of a resident session (serve.livesess), and an attach socket (serve.livesock) answers requests about it
;; while it runs: one JSON object per line in and out (serve.proto, the shapes of `fibc serve`), a connection open for many requests,
;; one request at a time. Ops: `hello`, `eval` (`text`: what `fibc repl` takes; a redefinition of a function is a body swap, serve.liveswap,
;; answered `swapped` with the generation and the swap's figures, or refused with a `live/*` code and a `hint`), `type` (`expr`),
;; `inspect` (`name`: a lookup in the live table and the last catalogue, package LE4; `value: true` evaluates it), `status` (the
;; generation, the generations kept, the threads), and the
;; pause, resume and retirement of serve.liveretire (package LV3): `pause` (`timeout_ms`, default 5000: the program's threads park at
;; their pause points; answers whether it is quiescent and what still runs), `resume`, `retire` (at quiescence: the generations no slot
;; names and no parked thread can be in are freed; otherwise `not-quiescent`); `test` (serve.livetest, package LT2 of
;; docs/design/live-meshql.md): a spec run on a thread of its own, answered when it ends (`status.tests` meanwhile; `busy` for a second);
;; `load` (`file`: a module of the program edited on disk, swapped as one input, serve.liveload, package LM1 of
;; docs/design/live-incremental.md 3) and `reload` (every loaded file whose disk content changed), `status.loaded` and `status.live`;
;; `watch` (`on`, `dirs`: serve.livewatch, package LT5: a changed file loaded and the last test rerun, answered as events).
;; Threads: the attach server runs on the driver's thread, which already holds the session (its engine and emitter are single-threaded
;; state: a `Cell`-bearing struct cannot be given to `spawn`); the program's `main` runs on a thread of its own (`live.run`: the runtime's
;; own main stack, rt/thread.lir `fib.run-main`), which says when it has ended (`done`) and wakes the accept. The design's 2.1 has the
;; two the other way round; the mechanics are the same. The process ends as `fibc run` ends: the program's result printed, exit through
;; the C library (what the program buffered is written). The socket is made before `main` is called, its path printed on standard error
;; and set as FIB_LIVE_SOCKET for the program. Before the first connection is accepted the engine is warmed on the base's text (LE5).
(ns serve.live
  (:require [serve.livesess :as ls] [serve.liveswap :as lsw] [serve.livetable :as lt] [serve.liveretire :as lr] [serve.livetest :as ltt] [serve.liveload :as ll] [serve.livewatch :as lwt] [serve.livesock :as lsk] [serve.sock :as sk] [serve.proto :as p] [serve.incr :as inc] [serve.diag :as dg]
            [lsp.json :as j] [driver.native :as native] [driver.version :as v] [native.call :as call] [lair.ffi :as ffi]
            [expand.roots :as roots] [expand.maker :as mk] [fib.unix :as unix] [fib.string :as s]))

;; `conns` numbers the connections served: a `test` answers on the connection that asked, by number (a descriptor is reused by a later one).
(defstruct Live (sx: ls/Sess listener: i64 path: str done: (Atom (Option i64)) served: (Cell i64) conns: (Cell i64) tests: ltt/Tests loads: ll/Loads
                    ;; whether the engine was warmed on the base's text before the first connection (LE5, `warm-engine`)
                    warm: (Cell bool)
                    ;; `watch` (LT5, serve.livewatch): the files polled for the watching connection
                    watch: lwt/Watch))

(def poll-ms: i64 250)

;; ---- answers

(defun strs :private (xs: (Vec str)) -> j/JVal (j/JArr (mapv j/json-str xs)))

(defun times-json :private (t: ls/Times) -> j/JVal
  (j/json-obj [(Pair "check_ms" (j/json-int (. t check))) (Pair "emit_ms" (j/json-int (. t emit))) (Pair "jit_ms" (j/json-int (. t jit))) (Pair "patch_ms" (j/json-int (. t patch)))]))

;; The program's threads (serve.liveretire): the spawned threads alive and the ones parked at a pause point (main among them), whether
;; a pause is requested and whether the program is quiescent, the pool's live and active workers, the async pool's busy workers.
(defun threads-json :private (t: lr/Threads) -> j/JVal
  (j/json-obj [(Pair "spawned" (j/json-int (. t spawned))) (Pair "paused" (j/json-int (. t paused))) (Pair "pausing" (j/JBool (. t pausing)))
               (Pair "quiescent" (j/JBool (. t quiescent))) (Pair "pool_workers" (j/json-int (. t workers))) (Pair "pool_active" (j/json-int (. t active)))
               (Pair "async_busy" (j/json-int (. t busy)))]))

;; The fields of an input's answer, and whether it is `ok`.
(defun answer-fields :private (l: Live a: ls/Answer) -> (Pair bool (Vec (Pair str j/JVal)))
  (match a
    ((ls/Defined names st) (Pair true [(Pair "defined" (strs names)) (Pair "generation" (j/json-int (lsw/generation (. l sx)))) (Pair "stats" (p/stats-json st))]))
    ((ls/Swapped defined swapped gen t st)
     (Pair true [(Pair "defined" (strs defined)) (Pair "swapped" (strs swapped)) (Pair "generation" (j/json-int gen)) (Pair "swap" (times-json t))
                 (Pair "threads" (threads-json (lr/threads (. l sx)))) (Pair "stats" (p/stats-json st))]))
    ((ls/Value text st stats)
     (Pair (= st 0) (into (match text ((some t) [(Pair "value" (j/json-str t))]) (nil []))
                          [(Pair "exit" (j/json-int st)) (Pair "stats" (p/stats-json stats))])))
    ((ls/Failed m st) (Pair false [(Pair "failed" (j/json-str m)) (Pair "exit" (j/json-int 134)) (Pair "trapped" (j/JBool true)) (Pair "stats" (p/stats-json st))]))
    ((ls/Refused shown ds code hint) (Pair false [(Pair "shown" (strs shown)) (Pair "diagnostics" (p/diags-json ds (map-empty))) (Pair "code" (j/json-str code))
                                                  (Pair "hint" (j/json-str hint)) (Pair "generation" (j/json-int (lsw/generation (. l sx))))]))
    ((ls/Broken m) (Pair false [(Pair "error" (j/json-obj [(Pair "code" (j/json-str "internal")) (Pair "message" (j/json-str m))]))]))))

(defun answer-json :private (l: Live r: p/Req a: ls/Answer) -> str
  (let ((f (answer-fields l a))) (p/response r (. f fst) (. f snd))))

;; The fields of a load's answer: the file, its module, its definitions and the changed ones, then the input's.
(defun load-fields :private (l: Live x: ll/LoadResult) -> (Pair bool (Vec (Pair str j/JVal)))
  (let ((f (answer-fields l (. x answer))))
    (Pair (. f fst) (into [(Pair "file" (j/json-str (. x file))) (Pair "module" (j/json-str (. x module))) (Pair "definitions" (j/json-int (. x definitions)))
                           (Pair "changed" (strs (. x changed)))]
                          (. f snd)))))

(defun op-load :private (l: Live r: p/Req) -> str
  (match (p/field-str r "file")
    (nil (p/error-response r "bad-request" "load needs a string `file`"))
    ((some file) (let ((f (load-fields l (ll/load-file (. l loads) (. l sx) file)))) (p/response r (. f fst) (. f snd))))))

;; `reload`: `loaded` holds one answer per file loaded again (none when no loaded file changed on disk); `ok` when every one was.
;; `watch` (LT5): `on: true` polls the session's live module files and the files under `dirs` for this connection (until `on: false` or
;; the connection ends); a change is answered by events on it: `{"event":"load", ..}` per module file loaded, then `{"event":"test", ..}`
;; when the last test is rerun (none after a refusal, nor when no test has run). `files`: how many files are watched.
(defun op-watch :private (l: Live r: p/Req cid: i64) -> str
  (if (p/field-bool r "on")
      (let ((n (lwt/start (. l watch) (. l loads) cid (unwrap-or (p/field-strs r "dirs") []))))
        (p/response r true [(Pair "watching" (j/JBool true)) (Pair "files" (j/json-int n))]))
      (do (lwt/stop (. l watch)) (p/response r true [(Pair "watching" (j/JBool false))]))))

;; One poll of the watch (serve.livewatch) on the watching connection: the changed module files loaded, each answered as a `load` event;
;; when every load was accepted and a test ran before, the last one rerun (`last: true`), its answer a `test` event when it ends (a run
;; that cannot start answers now). Whether the connection is usable.
(defun watch-step :private (l: Live conn: i64 cid: i64) -> bool
  (match (lwt/poll (. l watch) (. l loads) cid (ltt/running? (. l tests)))
    (nil true)
    ((some ch)
     (let ((loads (mapv (fn (f: str) (load-fields l (ll/load-file (. l loads) (. l sx) f))) (. ch modules))))
       (and (every? (fn (f: (Pair bool (Vec (Pair str j/JVal)))) (write-ok conn (lwt/as-event "load" (p/response (p/Req j/JNull "load" j/JNull) (. f fst) (. f snd))))) loads)
            (if (and (every? (fn (f: (Pair bool (Vec (Pair str j/JVal)))) (. f fst)) loads) (some? @(. (. l tests) last-sel)))
                (match (ltt/op-test (. l sx) (. l tests) (p/Req (j/json-str "watch") "test" (j/json-obj [(Pair "last" (j/JBool true))])) cid)
                  (nil (do (lwt/note-ours (. l watch)) true))
                  ((some line) (write-ok conn (lwt/as-event "test" line))))
                true))))))

(defun write-ok :private (conn: i64 line: str) -> bool (match (sk/write-line conn line) ((Ok _) true) ((Err _) false)))

(defun op-reload :private (l: Live r: p/Req) -> str
  (let ((results (mapv (fn (x: ll/LoadResult) (load-fields l x)) (ll/reload-all (. l loads) (. l sx)))))
    (p/response r (every? (fn (f: (Pair bool (Vec (Pair str j/JVal)))) (. f fst)) results)
                [(Pair "loaded" (j/JArr (mapv (fn (f: (Pair bool (Vec (Pair str j/JVal)))) (j/json-obj (into [(Pair "ok" (j/JBool (. f fst)))] (. f snd)))) results)))
                 (Pair "generation" (j/json-int (lsw/generation (. l sx))))])))

(defun loaded-json :private (l: Live) -> j/JVal
  (j/JArr (mapv (fn (p: (Pair (Pair str str) bool)) (j/json-obj [(Pair "file" (j/json-str (. (. p fst) fst))) (Pair "module" (j/json-str (. (. p fst) snd))) (Pair "stale" (j/JBool (. p snd)))]))
                (ll/loaded-files (. l loads)))))

(defun op-hello :private (l: Live r: p/Req) -> str
  (let ((t (lr/threads (. l sx))))
    (p/response r true [(Pair "pid" (j/json-int (sk/process-id))) (Pair "program" (j/json-str (. (. l sx) file))) (Pair "generation" (j/json-int (lsw/generation (. l sx))))
                        (Pair "version" (j/json-str v/version)) (Pair "catching" (j/JBool true))
                        (Pair "threads" (j/json-int (. t spawned))) (Pair "pool" (j/json-int (. t workers)))
                        (Pair "with" (strs (. (. (. l sx) rts) with))) (Pair "warm" (j/JBool @(. l warm)))])))

;; `pause`: the program's threads asked to park at their pause points, and up to `timeout_ms` (5000) of waiting for quiescence.
(defun op-pause :private (l: Live r: p/Req) -> str
  (match (lr/pause (. l sx) (unwrap-or (p/field-int r "timeout_ms") 5000))
    ((Err m) (p/error-response r "internal" m))
    ((Ok t) (p/response r true [(Pair "paused" (j/JBool (. t quiescent))) (Pair "threads" (threads-json t))
                                (Pair "running" (j/json-str (if (. t quiescent) "" (lr/running-text t))))]))))

(defun op-resume :private (l: Live r: p/Req) -> str
  (match (lr/resume (. l sx))
    ((Err m) (p/error-response r "internal" m))
    ((Ok t) (p/response r true [(Pair "resumed" (j/JBool true)) (Pair "threads" (threads-json t))]))))

;; `retire`: at quiescence (a pause requested and every thread parked, the pools idle) the old generations freed; else refused with
;; what still runs. The result: `removed`, `kept`, `pinned` (the families kept beyond their current generation, with the reason).
(defun op-retire :private (l: Live r: p/Req) -> str
  (let ((t (lr/threads (. l sx))))
    (if (not (and (. t pausing) (. t quiescent)))
        (p/error-response r "not-quiescent" (str "not quiescent: " (if (. t pausing) (lr/running-text t) "no pause was requested") "; pause first"))
        (match (lr/retire (. l sx))
          ((Err m) (p/error-response r "internal" m))
          ((Ok rd) (p/response r true [(Pair "removed" (j/json-int (. rd removed))) (Pair "kept" (j/json-int (. rd kept)))
                                       (Pair "pinned" (j/JArr (mapv (fn (p: (Pair str str)) (j/json-obj [(Pair "function" (j/json-str (. p fst))) (Pair "reason" (j/json-str (. p snd)))])) (. rd pinned))))
                                       (Pair "pinned_text" (j/json-str (lr/pinned-text rd))) (Pair "defs" (defs-json (. l sx)))
                                       (Pair "generation" (j/json-int (lsw/generation (. l sx))))]))))))

(defun op-eval :private (l: Live r: p/Req) -> str
  (match (p/field-str r "text")
    (nil (p/error-response r "bad-request" "eval needs a string `text`"))
    ((some text) (answer-json l r (lsw/input (. l sx) text)))))

(defun op-type :private (l: Live r: p/Req) -> str
  (match (p/field-str r "expr")
    (nil (p/error-response r "bad-request" "type needs a string `expr`"))
    ((some expr) (match (ls/type-of (. l sx) expr)
                   ((Ok t) (p/response r true [(Pair "type" (j/json-str t))]))
                   ((Err lines) (p/response r false [(Pair "shown" (strs lines)) (Pair "code" (j/json-str "check"))]))))))

;; `inspect` (LE4, docs/design/live-incremental.md 3.8): a lookup, no front end and no input. A function of the running program
;; answers from the live table (its generation, the bodies its slots name, its scheme as the table keeps it, its parameters' modes);
;; a `def` from the last accepted program's catalogue (its type and its slot). With `value: true` the name is evaluated as an `eval` of
;; it (the cost of an expression input; the answer then has its `value` and `stats`).
(defun op-inspect :private (l: Live r: p/Req) -> str
  (match (p/field-str r "name")
    (nil (p/error-response r "bad-request" "inspect needs a string `name`"))
    ((some name) (if (p/field-bool r "value") (inspect-value l r name) (inspect-lookup l r name)))))

(defun mode-text :private (p: (Pair bool bool)) -> str (str (if (. p fst) "owned" "borrowed") (if (. p snd) " escapes" "")))

(defun inspect-lookup :private (l: Live r: p/Req name: str) -> str
  (let ((sx (. l sx)))
    (match (lsw/family-info sx name)
      ((some f) (p/response r true [(Pair "kind" (j/json-str "function")) (Pair "generation" (j/json-int (. f generation))) (Pair "bodies" (strs (lsw/family-bodies sx name f)))
                                    (Pair "scheme" (j/json-str (match (. f scheme) ((some s) (. s snd)) (nil "?"))))
                                    (Pair "summary" (strs (match (. f summary) ((some sm) (mapv mode-text (. sm params))) (nil []))))]))
      (nil (match (lsw/def-info sx name)
             ((some [ty slot]) (p/response r true (into [(Pair "kind" (j/json-str "def")) (Pair "type" (j/json-str ty)) (Pair "generation" (j/json-int (lsw/generation sx)))]
                                                        (match slot ((some sl) [(Pair "slot" (j/json-str sl))]) (nil [])))))
             (nil (p/error-response r "unknown-name" (str name " is neither a function of the running program nor a def; `value: true` evaluates it"))))))))

;; `inspect` with `value: true`: the name's value (as `eval` prints it) and its type, a function's generation and bodies too.
(defun inspect-value :private (l: Live r: p/Req name: str) -> str
  (match (lsw/input (. l sx) name)
    ((ls/Value text st stats)
     (p/response r true (into (match text ((some t) [(Pair "value" (j/json-str t))]) (nil []))
                              (into [(Pair "type" (j/json-str (match (ls/type-of (. l sx) name) ((Ok t) t) ((Err _) "?"))))]
                                    (into (match (lsw/function-info (. l sx) name)
                                            ((some [gen bodies]) [(Pair "generation" (j/json-int gen)) (Pair "bodies" (strs bodies))])
                                            (nil [(Pair "generation" (j/json-int (lsw/generation (. l sx))))]))
                                          [(Pair "stats" (p/stats-json stats))])))))
    (other (answer-json l r other))))

;; The `def`s redefined (LT4, serve.livedefs): how many redefinitions, the old values waiting for a retirement, the ones dropped (freed)
;; and the ones that were immortal (never freed).
(defun defs-json :private (sx: ls/Sess) -> j/JVal
  (let ((d @(. sx defs)))
    (j/json-obj [(Pair "redefined" (j/json-int (. d redefined))) (Pair "retiring" (j/json-int (count (. d retired))))
                 (Pair "dropped" (j/json-int (. d dropped))) (Pair "immortal" (j/json-int (. d immortal)))])))

(defun op-status :private (l: Live r: p/Req) -> str
  (let ((sx (. l sx)))
    (p/response r true [(Pair "generation" (j/json-int (lsw/generation sx)))
                        (Pair "generations" (j/json-obj [(Pair "count" (j/json-int (+ 1 (lt/generations-kept @(. sx table))))) (Pair "kept" (j/json-int (ls/modules-kept sx)))
                                                         (Pair "functions" (j/json-int (lt/family-count @(. sx table))))]))
                        (Pair "values" (j/json-obj [(Pair "resident" (strs (ls/resident-names sx))) (Pair "count" (j/json-int (count (ls/resident-names sx))))]))
                        (Pair "threads" (threads-json (lr/threads sx))) (Pair "defs" (defs-json sx))
                        (Pair "tests" (ltt/tests-json (. l tests))) (Pair "watch" (lwt/watch-json (. l watch)))
                        (Pair "loaded" (loaded-json l)) (Pair "live" (j/json-str (ll/rule-text (. l loads) sx)))
                        (Pair "inputs" (j/json-int (ls/inputs-made sx))) (Pair "requests" (j/json-int @(. l served)))
                        (Pair "pid" (j/json-int (sk/process-id))) (Pair "socket" (j/json-str (. l path)))])))

;; `test` (serve.livetest, package LT2) answers later, from `finish` in the connection loop: "" here is no answer yet.
(defun dispatch :private (l: Live r: p/Req conn: i64) -> str
  (let ((op (. r op)))
    (do (set! (. l served) (+ @(. l served) 1))
        (cond (= op "hello") (op-hello l r)
              (= op "test") (unwrap-or (ltt/op-test (. l sx) (. l tests) r conn) "")
              (= op "eval") (op-eval l r)
              (= op "load") (op-load l r)
              (= op "reload") (op-reload l r)
              (= op "watch") (op-watch l r conn)
              (= op "type") (op-type l r)
              (= op "inspect") (op-inspect l r)
              (= op "status") (op-status l r)
              (= op "pause") (op-pause l r)
              (= op "resume") (op-resume l r)
              (= op "retire") (op-retire l r)
              (= op "ping") (p/response r true [(Pair "pong" (j/JBool true))])
              :else (p/error-response r "unknown-op" (str "unknown op `" op "`"))))))

(defun handle-line :private (l: Live line: str conn: i64) -> str
  (match (p/parse-request line)
    ((Err m) (p/bad-request m))
    ((Ok r) (dispatch l r conn))))

;; ---- connections

(defun program-ended? :private (l: Live) -> bool (some? @(. l done)))

;; A read error that leaves the connection usable (a line that is not UTF-8, or too long: consumed) is answered; any other ends it.
(defun recoverable? :private (m: str) -> bool (or (s/starts-with? m "the line") (s/starts-with? m "the input")))

;; A finished test run (serve.livetest) answered on the connection that asked, when it is this one, number `cid` (the program serves
;; one at a time; a run whose connection is gone is recorded for `status` and its answer dropped); whether this connection is usable.
(defun answer-finished :private (l: Live conn: i64 cid: i64) -> bool
  (match (ltt/finish (. l sx) (. l tests))
    (nil true)
    ((some [asked line]) (let ((out (lwt/finished-line (. l watch) line))) (if (= asked cid) (write-ok conn out) true)))))

;; One connection: a request per line, answered on the same line (a `test` later, when its run ends), until the peer closes or the
;; program ends.
(defun serve-connection :private (l: Live conn: i64) -> unit
  (let ((c (sk/conn-new conn)) (cid (+ @(. l conns) 1)))
    (do (set! (. l conns) cid)
        (loop ()
          (cond (program-ended? l) ()
                (not (answer-finished l conn cid)) ()
                (not (watch-step l conn cid)) ()
                (not (sk/wait-readable conn poll-ms)) (recur)
                :else (match (sk/conn-read-line c)
                        ((Ok nil) ())
                        ((Err m) (if (recoverable? m)
                                     (match (sk/write-line conn (p/bad-request m)) ((Ok _) (recur)) ((Err _) ()))
                                     ()))
                        ((Ok (some line)) (let ((a (handle-line l line cid)))
                                            (if (= a "") (recur) (match (sk/write-line conn a) ((Ok _) (recur)) ((Err _) ()))))))))
        (when (= @(. (. l watch) conn) cid) (lwt/stop (. l watch)))
        (unix/fd-close conn)
        ())))

;; The program's `def`s made (`live.main-body` is at its entry) before the first request reads one: at most five seconds, then as it is.
(defun wait-ready :private (l: Live) -> unit
  (loop ((n 0))
    (when (and (not (ls/ready? (. l sx))) (not (program-ended? l)) (< n 500))
      (do (unix/sleep-ns 10000000) (recur (+ n 1))))))

;; The accept loop, until the program ends (its thread shuts the listener down: the accept fails) or the listener fails.
(defun accept-loop :private (l: Live) -> unit
  (loop ()
    (if (program-ended? l)
        ()
        (match (sk/accept-unix (. l listener))
          ((Err _) ())
          ((Ok conn) (do (when (lsk/admit conn) (do (wait-ready l) (serve-connection l conn))) (recur)))))))

;; ---- the program's thread

;; The program's `main` on a thread of its own; when it returns, `done` holds its status and the listener is shut down.
(defun start-program :private (addr: i64 done: (Atom (Option i64)) listener: i64) -> (Task i64)
  (spawn (fn () -> i64
           (let ((r (match (call/call-i64 addr []) ((Ok c) (bit-and c 255)) ((Err _) 5))))
             (do (reset! done (some r)) (lsk/shutdown-socket listener) r)))))

;; `argc` and `argv` for `fib.set-args`: NUL-terminated copies, kept for the life of the process (the program reads them as `(args)`).
(defun program-args :private (words: (Vec str)) -> (Pair i64 i64)
  (let ((copies (mapv (fn (w: str) (ffi/ptr->addr (ffi/bytes-new w))) words)))
    (Pair (count words) (ffi/ptr->addr (ffi/words-new copies)))))

;; ---- the command

(defun say-lines :private (lines: (Vec str)) -> unit (doseq [x lines] (eprintln x)))

;; The warm engine (LE5, docs/design/live-incremental.md 3.7): once the program's `main` runs on its thread and before the first
;; connection is accepted, the engine's front end runs on the base's text here, on the driver's thread (idle until a client comes; a
;; client that connects meanwhile waits in the listener's queue), so that the first input does not pay the cold front end. `hello`
;; answers whether it ran and checked. Not under `--trace` (the harness of `fibc cases` runs every child so, and the engine's macro
;; sessions would trace on standard error), nor for a program that ends within `grace-ms` of its `def`s being made (a run that nobody
;; attaches to would wait for the warm-up before it can exit).
(def grace-ms: i64 100)

(defun warm-engine :private (l: Live trace: bool) -> unit
  (when (not trace)
    (do (wait-ready l)
        (loop ((n 0)) (when (and (not (program-ended? l)) (< n grace-ms)) (do (unix/sleep-ns 1000000) (recur (+ n 1)))))
        (when (not (program-ended? l)) (set! (. l warm) (ls/warm (. l sx)))))))

;; The booted session on its socket (in a private directory): the path on standard error, `main` started on its thread, the requests
;; answered until it ends; its status. The socket is unlinked at the end.
(defun serve-program :private (sx: ls/Sess dir: str path: str pid: i64 loads: ll/Loads trace: bool) -> i64
  (match (ls/run-address sx)
    ((Err m) (do (eprintln (str "compile failed: " m)) 5))
    ((Ok addr)
     (match (lsk/listen-private dir path)
       ((Err m) (do (eprintln (str "fibc: live: " m)) 2))
       ((Ok listener)
        (let ((l (Live sx listener path (atom nil) (cell 0) (cell 0) (ltt/tests-new (lsk/test-path dir pid) (lsk/test-err-path dir pid)) loads (cell false) (lwt/watch-new))))
          (do (eprintln (str "fibc: live at " path))
              (let ((t (start-program addr (. l done) listener)))
                (do (warm-engine l trace)
                    (accept-loop l)
                    (unix/fd-close listener) (unix/fd-unlink path)
                    (join t))))))))))

;; `fibc run --live FILE [-- arg..]`: the program checked and made resident (a program that does not check makes no socket), its
;; runtime started (`--trace`: FIB_TRACE is set only now, after the compiler's own JIT sessions are up, as `fibc run` sets it after
;; lowering; a later input that runs a macro traces that macro's session too), then the socket before `main`, its path in
;; FIB_LIVE_SOCKET and on standard error, and an exit as `fibc run`'s. The session's copies of the live modules' text (serve.liveload)
;; are read once the base is made, before `main` runs.
(defun run-live (file: str args: (Vec str) opt: i64 trace: bool rts: roots/Roots rm: mk/RunnerMaker) -> i64
  (match (read-file file)
    (nil (do (eprintln (str "fibc: cannot read " file)) 2))
    ((some text)
     (let ((dir (lsk/live-dir)) (pid (sk/process-id)) (loads (ll/loads-new)))
       (let ((path (lsk/socket-path dir pid)) (sx (ls/sess-new rts file opt (lsk/output-path dir pid))) (argv (program-args (into [file] args))))
         (do (native/setenv-set "FIB_LIVE_SOCKET" path)
             (match (ls/load-program sx text)
               ((Err lines) (do (eprintln "rejected:") (say-lines lines) 3))
               ((Ok _)
                (match (ls/make-base sx rm)
                  ((Err code) code)
                  ((Ok _)
                   (do (when trace (native/setenv-set "FIB_TRACE" "1"))
                       (ll/snapshot-base loads sx text)
                       (match (ls/boot sx (. argv fst) (. argv snd))
                         ((Err m) (do (eprintln (str "compile failed: " m)) 5))
                         ((Ok _)
                          (let ((code (serve-program sx dir path pid loads trace)))
                            (do (unix/fd-unlink (lsk/output-path dir pid)) (unix/fd-unlink (lsk/test-path dir pid)) (unix/fd-unlink (lsk/test-err-path dir pid))
                                (sk/exit-flush code)
                                code)))))))))))))))
