;; compiler/serve/cmd.fib: the commands `fibc serve` and `fibc repl` as the driver calls them (docs/design/dev-loop.md section 8);
;; `fibc repl --connect SOCK|PID [--json]` is the client of a live program (serve.liveclient, docs/design/live-repl.md 2.4).
(ns serve.cmd
  (:require [serve.server :as sv] [serve.client :as cl] [serve.repl :as rp] [serve.liveclient :as lc] [expand.roots :as roots] [expand.maker :as mk]))

;; `serve [--socket PATH]`: listens until a `shutdown` request.
(defun cmd-serve (words: (Vec str) dirs: (Vec str)) -> i64
  (let ((o (cl/parse-opts words)))
    (if (empty? (. o words))
        (sv/serve-main (. o path) dirs)
        (do (eprintln "usage: fibc serve [--socket PATH] [-I dir]..") 2))))

(defun cmd-client (words: (Vec str) rts: roots/Roots rm: mk/RunnerMaker dirs: (Vec str)) -> i64 (cl/cmd-client words rts rm dirs))

(defun cmd-repl (words: (Vec str) dirs: (Vec str)) -> i64
  (cond (empty? words) (rp/repl-main false dirs)
        (and (= (count words) 1) (= (nth words 0) "--echo")) (rp/repl-main true dirs)
        (and (= (count words) 2) (= (nth words 0) "--connect")) (lc/connect-main (nth words 1) false)
        (and (= (count words) 3) (= (nth words 0) "--connect") (= (nth words 2) "--json")) (lc/connect-main (nth words 1) true)
        :else (do (eprintln "usage: fibc repl [--echo] [-I dir].. | fibc repl --connect SOCK|PID [--json]") 2)))
