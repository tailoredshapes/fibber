;; compiler/serve/liveswap.fib: the inputs of a live session and the body swap (docs/design/live-repl.md 3.1 to 3.4; package LV2).
;; A definition input is first refused by what its text redefines (`main`, a type, an `extern`: what the running program was
;; compiled against and a swap cannot change; a `def` is redefined by serve.livedefs, LT4), else the program of the merged session text is checked once (the engine's
;; persistent checker) and emitted with the families whose definition's expanded form changed (serve.livediff, LM2: a function's, an
;; `impl`'s methods; a body whose `require` alias or macro changed is one, a comment is not) under the session's next generation; the rules of serve.liverules compare every family's scheme and summary with the live table's (a caller's code depends
;; on nothing else of its callee: its name is the stub's, and in a catching program every body returns a failure next to its value).
;; The swap: the new bodies cut out of the program (live.extract: everything the base has is declared, the new literals and statics
;; copied), added under a tracker of their own and kept, their addresses looked up (ORC compiles them then), and only then each slot
;; stored with `live.patch` (a release store; the stubs load with acquire). A caller that loaded the old address runs the old body,
;; which stays mapped: no generation is retired here (LV3). A refusal, from the text, the checker, the rules or the cut, leaves the
;; session text, the table and the program as they were. A redefined macro is accepted: its users' expansions changed, so they swap.
(ns serve.liveswap
  (:use lir.ast)
  (:require [serve.livesess :as ls] [serve.livetable :as lt] [serve.livedefs :as ld] [serve.liveretype :as lrt] [serve.liveexpr :as le] [serve.liverules :as lr] [serve.replcore :as rc] [serve.diag :as dg] [serve.incr :as inc] [serve.livediff :as ldf]
            [emit.compile :as ec] [emit.program :as ep] [live.extract :as ex] [own.driver :as od] [types.init :as ti] [fib.string :as s]))

;; ---- what the text may not redefine

(defun replaced? :private (sx: ls/Sess d: rc/Def) -> bool
  (some? (first (filterv (fn (o: rc/Def) (= (. o key) (. d key))) @(. (. sx rc) defs)))))

(defun refusal-code :private (sx: ls/Sess d: rc/Def) -> (Option str)
  (cond (= (. d name) "main") (some "live/Main")
        (not (replaced? sx d)) nil
        (s/starts-with? (. d text) "(defprotocol ") (some "live/Protocol")
        (s/starts-with? (. d key) "type:") (some "live/Layout")
        (s/starts-with? (. d text) "(extern ") (some "live/Extern")
        :else nil))

(defun refusal-text :private (code: str name: str) -> str
  (cond (= code "live/Main") "`main` is the program's; it changes with a restart"
        (= code "live/Layout") (str name " changed; values of " name " exist in the running program")
        (= code "live/Protocol") (str name " is a protocol of the running program; its dispatch rows are in every caller")
        :else (str name " is an extern of the running program")))

(defun refused :private (code: str shown: str hint: str) -> ls/Answer
  (ls/Refused (into [(str "<input>:1:1: " shown " [" code "]")] (if (= hint "") [] [(str "  hint: " hint)]))
              [(dg/diag-nowhere code rc/repl-file shown)] code hint))

(defun refused-def :private (sx: ls/Sess defs: (Vec rc/Def)) -> (Option ls/Answer)
  (first (vec (keep (fn (d: rc/Def)
                      (match (refusal-code sx d)
                        (nil nil)
                        ((some code) (some (refused code (refusal-text code (. d name)) ":restart")))))
                    defs))))

;; The redefined macros of `news`: each keeps its place in the session's text (`merge-session`).
(defun kept-macros :private (olds: (Vec rc/Def) news: (Vec rc/Def)) -> (Vec rc/Def)
  (filterv (fn (d: rc/Def) (and (s/starts-with? (. d text) "(defmacro ") (some? (first (filterv (fn (o: rc/Def) (= (. o key) (. d key))) olds))))) news))

;; The session's definitions with `news` merged in (serve.replcore `merge-defs`: a redefinition last), except that a redefined macro
;; keeps its place: the definitions after it that use it are expanded with the new one (LM2).
(defun merge-session :private (olds: (Vec rc/Def) news: (Vec rc/Def)) -> (Vec rc/Def)
  (let ((macros (kept-macros olds news)))
    (rc/merge-defs (mapv (fn (o: rc/Def) (unwrap-or (first (filterv (fn (m: rc/Def) (= (. m key) (. o key))) macros)) o)) olds)
                   (filterv (fn (d: rc/Def) (nil? (first (filterv (fn (m: rc/Def) (= (. m key) (. d key))) macros)))) news))))

;; The line the input's definitions start on in the merged text: after the header, the definitions that are not the input's tail (the
;; tail is the input's definitions but its kept macros).
(defun input-start :private (olds: (Vec rc/Def) merged: (Vec rc/Def) news: (Vec rc/Def)) -> i64
  (let ((tail (- (count news) (count (kept-macros olds news)))))
    (+ 2 (rc/lines-in (rc/defs-text (vec (take (- (count merged) tail) merged)))))))

;; Where each definition of the input is: its first line in the merged text, its lines, and its first line as the input counts it (`at`
;; and then the input's definitions in their order, as serve.replcore `show-diag` reads a line at or after `at`).
(defun input-spans :private (merged: (Vec rc/Def) news: (Vec rc/Def) at: i64) -> (Vec (Pair (Pair i64 i64) i64))
  (let ((starts (fn (ds: (Vec rc/Def) from: i64) -> (Map str i64)
                  (. (reduce (fn (acc: (Pair (Map str i64) i64) d: rc/Def) (Pair (assoc (. acc fst) (. d key) (. acc snd)) (+ (. acc snd) (+ 1 (rc/lines-in (. d text))))))
                             (Pair {} from) ds) fst))))
    (let ((in-merged (starts merged 2)) (in-input (starts news at)))
      (vec (keep (fn (d: rc/Def) (match (Pair (get in-merged (. d key)) (get in-input (. d key)))
                                   ([(some m) (some i)] (some (Pair (Pair m (+ 1 (rc/lines-in (. d text)))) i)))
                                   (_ nil)))
                 news)))))

;; A diagnostic of the merged text moved to its line in the input: a redefined macro kept in place is not in the merged text's tail, so
;; without this the lines of the input's definitions are off by the macros' lines.
(defun input-diag :private (spans: (Vec (Pair (Pair i64 i64) i64)) d: dg/Diag) -> dg/Diag
  (if (not (= (. d file) rc/repl-file))
      d
      (match (first (filterv (fn (sp: (Pair (Pair i64 i64) i64)) (and (>= (. d line) (. (. sp fst) fst)) (< (. d line) (+ (. (. sp fst) fst) (. (. sp fst) snd))))) spans))
        (nil d)
        ((some sp) (dg/Diag (. d code) (. d file) (+ (. sp snd) (- (. d line) (. (. sp fst) fst))) (. d col) (. d start) (. d end) (. d message))))))

;; The shown lines of an input's diagnostics (serve.livesess `shown-of`) at the input's lines.
(defun shown-input :private (sx: ls/Sess ds: (Vec dg/Diag) at: i64 merged: (Vec rc/Def) news: (Vec rc/Def)) -> (Vec str)
  (let ((spans (input-spans merged news at)))
    (ls/shown-of sx (mapv (fn (d: dg/Diag) (input-diag spans d)) ds) at merged)))

;; ---- the families an input changed

;; What the checked program `fr` changed: the definitions whose expanded form differs from the last accepted program's (serve.livediff).
(defun changes-of (sx: ls/Sess olds: (Map str i64) fr: inc/Front) -> ldf/Changes
  (ldf/changes olds (ldf/hashes-of (. fr modules) @(. sx live-modules)) (ls/live-bodies sx)))

;; The bodies asked for whether or not `main` reaches them: the new functions', the registered bodies of the functions to swap that
;; are not specialisations (a specialisation is reached from `main`, or it was an input's: its types are that program's and cannot be
;; asked for again; it keeps its slot), and every method of the `impl`s redefined.
(defun requests-of (sx: ls/Sess new-fns: (Vec str) families: (Vec str) impls: (Vec str)) -> (Vec ec/BodyRequest)
  (into (into (conj (mapv (fn (nm: str) (ec/BodyRequest nm false [] nil [] nil)) new-fns) (ec/BodyRequest "main" false [] nil [] nil))
              (mapv (fn (key: str) (ec/BodyRequest "" false [] (some key) [] nil)) impls))
        (vec (mapcat (fn (family: str)
                       ;; every registered body of the family: a monomorphic one by name (with its module, LM1), a specialisation by its
                       ;; recorded type text (LE3), since the queue mode does not reach either from a resident caller.
                       (vec (keep (fn (b: ep/LiveBody) (match (. b fun) ((some f) (some (ec/BodyRequest f (. b owned) [] nil (. b tys-text) (. b module)))) (nil nil)))
                                  (unwrap-or (get (ls/live-bodies sx) family) []))))
                     families))))

;; ---- the program of an input

;; The program emitted with `families` under generation `gen`; the families among them the program made a body of (a generic function
;; nobody instantiates has none: it swaps into the text only).
(defun emit-swapping (sx: ls/Sess c: od/Checked stats: inc/Stats requests: (Vec ec/BodyRequest) families: (Vec str) gen: i64)
    -> (Result (Pair ls/Made (Vec str)) (Vec dg/Diag))
  (do (ls/set-generations sx (reduce (fn (acc: (Map str i64) f: str) (assoc acc f gen)) (lt/generations-of @(. sx table)) families))
      (match (ls/emit-checked sx c stats requests)
        ((Err ds) (Err ds))
        ((Ok made) (let ((pi (ex/index-of (. made m))))
                     (Ok (Pair made (filterv (fn (f: str) (some? (first (filterv (fn (nm: str) (some? (get pi (str nm ".g" gen)))) (lt/body-names (ls/live-bodies sx) f)))))
                                             families))))))))

;; ---- the swap

(defstruct Swap (made: ls/Made families: (Vec str) gen: i64 jit-ms: i64 patch-ms: i64))

;; One family's bodies of generation `gen` cut out of the program (its statics resident for good, its code under a tracker of its own:
;; serve.livesess `add-generation`) and kept, each slot patched once the code is resident; the generation recorded with what pins it.
(defun swap-family :private (sx: ls/Sess made: ls/Made family: str gen: i64) -> (Result (Pair i64 i64) str)
  (let ((pi (ex/index-of (. made m)))
        (names (filterv (fn (nm: str) (some? (get pi (str nm ".g" gen)))) (lt/body-names (ls/live-bodies sx) family))))
    (let ((coded (mapv (fn (nm: str) (str nm ".g" gen)) names)) (t0 (sys-clock-now)))
      (try-let ((ap (ls/add-generation sx (. made m) (mapv (fn (nm: str) (Pair nm nm)) coded) gen))
                (addrs (ti/try-map (fn (nm: str) (ls/address-of sx nm)) coded))
                (jit-ms (Ok (inc/ms-since t0)))
                (t1 (Ok (sys-clock-now)))
                (_ (publish sx names addrs)))
        (let ((a (. ap fst)) (noted (ls/keep-module sx (. ap fst))))
          (do (set! (. sx table) (lt/add-generation @(. sx table) family (lt/Generation gen (. a rt) (. a name) coded (. ap snd) noted)))
              (Ok (Pair jit-ms (inc/ms-since t1)))))))))

;; The slots of `names` stored with the addresses of their new bodies: a release store each, after every body is resident.
(defun publish :private (sx: ls/Sess names: (Vec str) addrs: (Vec i64)) -> (Result unit str)
  (loop ((i 0))
    (if (>= i (count names))
        (Ok ())
        (match (try-let ((slot (ls/slot-address sx (str "live." (nth names i))))) (ls/patch sx slot (nth addrs i)))
          ((Err m) (Err m))
          ((Ok _) (recur (+ i 1)))))))

(defun swap-all (sx: ls/Sess made: ls/Made families: (Vec str) gen: i64) -> (Result (Pair i64 i64) str)
  (loop ((fs families) (jit 0) (patch 0))
    (match (first fs)
      (nil (Ok (Pair jit patch)))
      ((some family) (match (swap-family sx made family gen)
                       ((Err m) (Err m))
                       ((Ok [j p]) (recur (vec (rest fs)) (+ jit j) (+ patch p))))))))

;; ---- a definition input

(defun session-defs :private (sx: ls/Sess) -> i64 @(. sx defined))

(defun new-functions :private (sx: ls/Sess defs: (Vec rc/Def)) -> (Vec str)
  (mapv (fn (d: rc/Def) (. d name)) (filterv (fn (d: rc/Def) (not (replaced? sx d))) (ls/function-defs defs))))

;; What is kept after a refusal: the generations the next program emits under are the table's.
(defun unchanged (sx: ls/Sess a: ls/Answer) -> ls/Answer
  (do (ls/set-generations sx (lt/generations-of @(. sx table))) a))

;; A definition input: refused by the text rules, else its program checked and settled (nothing of the session changes until the
;; program checks, the rules pass and the lIR is settled), then the text accepted, the new defs' slots and the new functions made
;; resident, the changed families swapped.
(defun define-input :private (sx: ls/Sess defs: (Vec rc/Def) clauses: (Vec str)) -> ls/Answer
  (match (refused-def sx defs)
    ((some r) r)
    (nil
     (let ((olds (ls/accepted-hashes sx)) (cs (rc/merge-clauses @(. (. sx rc) clauses) clauses)) (merged (merge-session @(. (. sx rc) defs) defs)))
       (let ((at (input-start @(. (. sx rc) defs) merged defs))
             (fr (rc/front-texts (. sx eng) (. sx rts) (rc/source-of cs merged "") "yes" true @(. sx texts))))
         (match (. fr checked)
           ((Err ds) (unchanged sx (match (retype-check sx ds at merged defs)
                                     ((some r) (def-refused r))
                                     (nil (ls/Refused (shown-input sx ds at merged defs) ds "check" "")))))
           ((Ok c) (checked-input sx defs clauses (Pair cs merged) at c fr (changes-of sx olds fr)))))))))

;; A program that does not check because an input's redefined `def` changed type under a reader of it (a diagnostic in a definition of
;; the session before the input that names the def): `live/Def` naming the reader (serve.liveretype `check-refusal`).
(defun retype-check :private (sx: ls/Sess ds: (Vec dg/Diag) at: i64 merged: (Vec rc/Def) defs: (Vec rc/Def)) -> (Option ld/DefRefusal)
  (let ((redefined (filterv (fn (d: rc/Def) (and (ld/def-text? d) (replaced? sx d))) defs)))
    (if (empty? redefined)
        nil
        (first (vec (keep (fn (d: dg/Diag) (if (and (= (. d file) rc/repl-file) (< (. d line) at))
                                              (lrt/check-refusal redefined (lrt/session-reader merged (. d line)) d (rc/show-diag d at merged))
                                              nil))
                          ds))))))

;; A definition input whose program checked: the rules, the emit of the changed families under the next generation, the shape of the
;; redefined `def`s, then applied.
(defun checked-input :private (sx: ls/Sess defs: (Vec rc/Def) clauses: (Vec str) text: (Pair (Vec str) (Vec rc/Def)) at: i64 c: od/Checked
                               fr: inc/Front ch: ldf/Changes) -> ls/Answer
  (let ((new-fns (new-functions sx defs)) (gen (+ 1 (. @(. sx table) generation))) (merged (. text snd))
        (redefs (ld/redefs-of (filterv (fn (d: rc/Def) (replaced? sx d)) defs) nil)))
    (match (rules-refusal sx c redefs gen)
      ((Err a) (unchanged sx a))
      ((Ok [ts readers])
       (let ((families (lrt/with-readers (. ch families) readers)))
         (match (emit-swapping sx c (. fr stats) (into (requests-of sx new-fns families (. ch impls)) (ld/def-requests redefs)) (lrt/emit-families families ts) gen)
           ((Err ds) (unchanged sx (ls/Refused (shown-input sx ds at merged defs) ds (match (first ds) ((some d) (. d code)) (nil "check")) "")))
           ((Ok [made changed]) (match (or-refusal (ld/shape-refusal sx made redefs ts) (lrt/unswapped readers changed))
                                  ((some r) (unchanged sx (def-refused r)))
                                  (nil (apply-input sx made text defs clauses new-fns changed gen (Pair redefs ts) (. ch hashes)))))))))))

;; The first of two refusals.
(defun or-refusal (a: (Option ld/DefRefusal) b: (Option ld/DefRefusal)) -> (Option ld/DefRefusal) (match a ((some r) (some r)) (nil b)))

;; The rules of the live table (serve.liverules), then the redefined `def`s whose type changes (serve.liveretype `plan`): their new slots
;; and the families of their readers, to swap with the input's.
(defun rules-refusal :private (sx: ls/Sess c: od/Checked redefs: (Vec ld/Redef) gen: i64) -> (Result (Pair (Vec ld/Retype) (Vec str)) ls/Answer)
  (match (lr/check-rules @(. sx table) c (session-defs sx))
    ((some r) (Err (refused (. r code) (. r message) (. r hint))))
    (nil (match (lrt/plan sx c redefs gen) ((Err r) (Err (def-refused r))) ((Ok p) (Ok p))))))

(defun def-refused (r: ld/DefRefusal) -> ls/Answer (refused "live/Def" (. r message) ":restart"))

;; The accepted input applied: the text, the slots, the new functions, the swap; the table after. A cut that fails is reported as
;; broken with the text restored (what was added stays resident but unreachable).
(defun apply-input :private (sx: ls/Sess made: ls/Made text: (Pair (Vec str) (Vec rc/Def)) defs: (Vec rc/Def) clauses: (Vec str) new-fns: (Vec str)
                             changed: (Vec str) gen: i64 redefs: (Pair (Vec ld/Redef) (Vec ld/Retype)) hashes: (Vec (Pair str i64))) -> ls/Answer
  (let ((snap (Pair @(. (. sx rc) clauses) @(. (. sx rc) defs))) (names (mapv (fn (d: rc/Def) (. d name)) defs)) (cs (. text fst)) (merged (. text snd))
        (dsnap @(. sx defs)))
    (do (set! (. (. sx rc) clauses) cs) (set! (. (. sx rc) defs) merged) (set! (. sx defined) (+ @(. sx defined) (count defs)))
        (match (try-let ((_ (apply-defs sx made redefs gen)) (_ (ls/make-functions sx made new-fns))) (swap-all sx made changed gen))
          ((Err m) (do (set! (. (. sx rc) clauses) (. snap fst)) (set! (. (. sx rc) defs) (. snap snd)) (set! (. sx defined) (- @(. sx defined) (count defs)))
                       (set! (. sx defs) dsnap)
                       (unchanged sx (ls/Broken m))))
          ((Ok [jit patch])
           (do (set! (. sx table) (lt/with-hashes (lt/table-after @(. sx table) (ls/live-bodies sx) (. made c) changed gen) (ldf/hash-map-of hashes)))
               (ls/set-generations sx (lt/generations-of @(. sx table)))
               (ld/note-types sx (. made c))
               (if (empty? changed)
                   (ls/Defined (into names clauses) (. made stats))
                   (ls/Swapped (filterv (fn (nm: str) (not (includes? (str "f." nm) changed))) (into names clauses))
                               (mapv shown-family changed) gen
                               (ls/Times (. (. made stats) total-ms) (. made emit-ms) jit patch) (. made stats)))))))))

;; The `def`s of an accepted input applied (serve.livedefs): the new slots of the type changes made the session's, the new defs made
;; (not those slots: their initialisers are the new ones), the constants stored, the redefinitions applied.
(defun apply-defs (sx: ls/Sess made: ls/Made redefs: (Pair (Vec ld/Redef) (Vec ld/Retype)) gen: i64) -> (Result unit str)
  (let ((ts (. redefs snd)))
    (do (ld/note-slots sx ts gen)
        (try-let ((_ (ld/make-slots-skipping sx made (reduce (fn (acc: (Set str) t: ld/Retype) (conj acc (. t new))) (set-empty) ts))))
          (ld/apply-redefs sx made (. redefs fst) ts)))))

;; A family as the answer names it: a function by its name, a method by its body's name.
(defun shown-family (family: str) -> str
  (if (s/starts-with? family "f.") (str-slice family 2 (str-len family)) family))

;; ---- inputs

;; One input: definitions, then one expression at most (the REPL's rule for a request).
(defun input (sx: ls/Sess text: str) -> ls/Answer
  (match (rc/classify text)
    ((rc/Blank) (ls/Defined [] (inc/Stats 0 0 0 true 0 0 0 0 0)))
    ((rc/Unreadable m) (ls/Refused [(str "<input>:" m)] [] "read" ""))
    ((rc/Parts defs clauses exprs)
     (cond (> (count exprs) 1) (ls/Refused ["<input>:1:1: one expression for each input [live/Input]"] [] "live/Input" "")
           (and (empty? defs) (empty? clauses)) (le/expression-input sx (nth exprs 0))
           :else (match (define-input sx defs clauses)
                   ((ls/Defined names st) (if (empty? exprs) (ls/Defined names st) (le/expression-input sx (nth exprs 0))))
                   ((ls/Swapped d sw g t st) (if (empty? exprs) (ls/Swapped d sw g t st) (le/expression-input sx (nth exprs 0))))
                   (other other))))))

;; The session's generation.
(defun generation (sx: ls/Sess) -> i64 (. @(. sx table) generation))

;; ---- `inspect` as a lookup (LE4, docs/design/live-incremental.md 3.8): the live table and the last accepted program's catalogue

;; A name as the user wrote it as a body name's tail: `tick-loop` (the main module's), `routes/route` (module `routes`: `routes.route`).
(defun body-tail :private (name: str) -> str (s/replace name "/" "."))

;; A function of the running program, by the name the user wrote: its family's entry in the live table.
(defun family-info (sx: ls/Sess name: str) -> (Option lt/Family) (get (. @(. sx table) families) (str "f." (body-tail name))))

;; The bodies a family's slots name now.
(defun family-bodies (sx: ls/Sess name: str f: lt/Family) -> (Vec str)
  (mapv (fn (nm: str) (str nm ".g" (. f generation))) (lt/body-names (ls/live-bodies sx) (str "f." (body-tail name)))))

;; A function's generation and the bodies its slots name.
(defun function-info (sx: ls/Sess name: str) -> (Option (Pair i64 (Vec str)))
  (match (family-info sx name) (nil nil) ((some f) (some (Pair (. f generation) (family-bodies sx name f))))))

;; A `def` of the session or the program, by the name the user wrote: its type as the last accepted program's checker printed it, and
;; the slot that holds it (`live.d.NAME` of a redefinable def, `def.slot.N` of one made at run time; nil for static data).
(defun def-info (sx: ls/Sess name: str) -> (Option (Pair str (Option str)))
  (let ((body (str "d." (body-tail name))))
    (match (get (. @(. sx defs) types) body)
      (nil nil)
      ((some ty) (some (Pair ty (cond (some? (get @(. sx base) (str "live." body))) (some (str "live." body))
                                      :else (first (vec (keep (fn (p: (Pair str str)) (if (= (. p snd) name) (some (. p fst)) nil)) (vec @(. sx slot-names))))))))))))
