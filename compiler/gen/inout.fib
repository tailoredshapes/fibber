;; compiler/gen/inout.fib: port of crates/fibgen/src/gen/inout.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Helpers with `&` parameters (syntax §3.13) and their calls: copy-in,
;; write-back, forwarding at tail calls, distinct `&` arguments, aliases.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.inout
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun inout-stmt-call (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.inout inout-stmt-call"))
(defun inout-inout-int (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.inout inout-inout-int"))
