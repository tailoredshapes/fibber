;; compiler/gen/scalar.fib: port of crates/fibgen/src/gen/scalar.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Productions for `i64`, `bool` and `str`.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.scalar
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun scalar-literal-text (g: FgGen) -> str (trap "todo: gen.scalar scalar-literal-text"))
(defun scalar-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.scalar scalar-int"))
(defun scalar-boolean (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.scalar scalar-boolean"))
(defun scalar-string (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.scalar scalar-string"))
