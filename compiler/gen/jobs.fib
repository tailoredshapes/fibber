;; compiler/gen/jobs.fib: port of crates/fibgen/src/gen/jobs.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; The colour-parameterised enum `(Job k :colour)` (types §1.3): its
;; `Ready` variant holds a `(fn k () i64)`, so a `(Job :send)` holds a
;; closure whose captures are all sendable and may cross a thread, and a
;; `(Job :local)` may hold one over a cell. `Idle` has no field and is
;; either colour.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.jobs
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun jobs-idle (send: bool) -> FgExpr (trap "todo: gen.jobs jobs-idle"))
(defun jobs-job (g: FgGen cx: FgCtx send: bool d: i64) -> FgExpr (trap "todo: gen.jobs jobs-job"))
(defun jobs-job-leaf (g: FgGen send: bool) -> FgExpr (trap "todo: gen.jobs jobs-job-leaf"))
(defun jobs-observe-job (g: FgGen e: FgExpr) -> FgExpr (trap "todo: gen.jobs jobs-observe-job"))
(defun jobs-cross (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.jobs jobs-cross"))
