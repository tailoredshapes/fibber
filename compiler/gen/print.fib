;; compiler/gen/print.fib: printing a program as fibber source, crates/fibgen/src/print/mod.rs, items.rs, pipelines.rs (seed-1). OWNER: package P.
;; The text is part of the golden corpus (compiler/tests/golden/gen): byte for byte, including the 80-column layout rule and the preamble.
;; The reader/printer of the compiler (syntax.print) is NOT used: it prints Stx, not this layout.
(ns gen.print
  (:use gen.ty gen.ast))

(defenum FgSexp (SxAtom s: str) (SxList items: (Vec FgSexp)) (SxVector items: (Vec FgSexp)) (SxPrefix p: str x: FgSexp))

;; print::program: library namespace line, preamble declarations and macros the body names, defs, impls, funs, main.
(defun print-program (p: FgProgram) -> str (trap "todo: gen.print print-program"))
;; The 13 preamble blocks (Pt Wrap Holder Shape Hook Job Score Rank Ver Lvl inc1 digest sum-vec) and the macros, selected by the tokens of `body`, in table order. Tokens split on whitespace and ()[]@&.
(defun print-preamble (body: str) -> str (trap "todo: gen.print print-preamble"))
;; print::expr and expr_more.
(defun print-expr (e: FgExpr) -> FgSexp (trap "todo: gen.print print-expr"))
;; items.rs fundef.
(defun print-fundef (f: FgFun) -> FgSexp (trap "todo: gen.print print-fundef"))
;; items.rs impl_def.
(defun print-impl (i: FgImpl) -> FgSexp (trap "todo: gen.print print-impl"))
;; items.rs pat.
(defun print-pat (p: FgPat) -> FgSexp (trap "todo: gen.print print-pat"))
;; print/pipelines.rs pipe: threaded, nested, bound, split shapes.
(defun print-pipe (p: FgPipe) -> FgSexp (trap "todo: gen.print print-pipe"))
;; print::flat: one line.
(defun print-flat (s: FgSexp) -> str (trap "todo: gen.print print-flat"))
;; print::layout: one line when indent + width <= 80, else the head kept (defun 5, impl 3, let/loop/plet/match/fn/if 2, else 1) and one item per line at indent + 2.
(defun print-layout (s: FgSexp indent: i64) -> str (trap "todo: gen.print print-layout"))
(defun print-expr-text (e: FgExpr) -> str (trap "todo: gen.print print-expr-text"))
(defun print-ty-text (t: FgTy) -> str (trap "todo: gen.print print-ty-text"))
