;; compiler/gen/pipelines.fib: port of crates/fibgen/src/gen/pipelines.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Library pipelines (stdlib 8.1 item 3, method rule 5): a small source, stages of the lazy adaptors with pure generated functions, and one or
;; two terminals, written one of several ways. The program embeds nothing but its own result: `main` returns a fold of the terminal's answer
;; and, when the program counts calls, the weighted number of times its functions ran. The programs `:use` the four facades of the library.
;; It does not use gen.state: the pipeline generator has its own state (`FgPGen`, gen.lambdas) and its own rng stream.
(ns gen.pipelines
  (:use gen.ty gen.ast gen.lambdas))

;; generate_pipeline: PGen from the seed; counted = chance 60; 0..2 captured ints `k1..`; a captured vector `cv` with chance 30; one pipe; main.
(defun pipelines-generate (seed: i64 size: i64) -> FgProgram (trap "todo: gen.pipelines pipelines-generate"))
(defun pipelines-vec-lit (items: (Vec FgExpr)) -> FgExpr (trap "todo: gen.pipelines pipelines-vec-lit"))
(defun pipelines-int-lits (g: FgPGen lo: i64 hi: i64) -> (Vec FgExpr) (trap "todo: gen.pipelines pipelines-int-lits"))
(defun pipelines-with-calls (g: FgPGen pipe: FgExpr) -> FgExpr (trap "todo: gen.pipelines pipelines-with-calls"))
(defun pipelines-pipe (g: FgPGen) -> FgPipe (trap "todo: gen.pipelines pipelines-pipe"))
(defun pipelines-chain (g: FgPGen max: i64 top: bool concat: bool) -> FgChain (trap "todo: gen.pipelines pipelines-chain"))
(defun pipelines-source (g: FgPGen top: bool) -> FgSrc (trap "todo: gen.pipelines pipelines-source"))
(defun pipelines-hoist (g: FgPGen v: FgExpr) -> FgExpr (trap "todo: gen.pipelines pipelines-hoist"))
(defun pipelines-count-arg (g: FgPGen) -> FgExpr (trap "todo: gen.pipelines pipelines-count-arg"))
(defun pipelines-stage (g: FgPGen concat: bool mapcat: bool) -> FgStage (trap "todo: gen.pipelines pipelines-stage"))
(defun pipelines-concat-stage (g: FgPGen) -> FgStage (trap "todo: gen.pipelines pipelines-concat-stage"))
(defun pipelines-term-of (g: FgPGen) -> FgTerm (trap "todo: gen.pipelines pipelines-term-of"))
