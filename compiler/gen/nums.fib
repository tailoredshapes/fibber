;; compiler/gen/nums.fib: port of crates/fibgen/src/gen/nums.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Integers of every width and floats (types §2.12), folded into an
;; `i64` by a conversion. Most arithmetic cannot trap by construction:
;; its operands are masked so the exact result fits (`(+ (bit-and a M)
;; (bit-and b M))`), its divisors are odd (`(bit-or b 1)`). Now and then
;; an operation is left unmasked; if the model then predicts a trap,
;; the interpreter must trap with the same message (run.rs). Float
;; arithmetic never traps, so floats are divided and `rem`-ed by any
;; value, and NaN and the infinities arise, from a computed zero divisor
;; or from the literal forms `(/ 0.0 0.0)` and `(/ ±1.0 0.0)`; the
;; built-in comparisons on them are IEEE's (types §2.12, Decided,
;; owner, 2026-09-28).
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.nums
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun nums-int-expr (g: FgGen cx: FgCtx t: (Option FgNum) d: i64) -> FgExpr (trap "todo: gen.nums nums-int-expr"))
(defun nums-float-expr (g: FgGen cx: FgCtx t: FgNum d: i64) -> FgExpr (trap "todo: gen.nums nums-float-expr"))
(defun nums-to-i64 (g: FgGen e: FgExpr) -> FgExpr (trap "todo: gen.nums nums-to-i64"))
(defun nums-num-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.nums nums-num-int"))
