;; compiler/gen/mcalls.fib: port of crates/fibgen/src/gen/mcalls.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Calls of the preamble's macros (syntax §3.16): arguments that the
;; macro takes apart by a vector pattern on their form, or that fall
;; through; a rest parameter spliced and recursed over; arguments run
;; twice, bound to a gensym, or never run at all.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.mcalls
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun mcalls-macro-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.mcalls mcalls-macro-int"))
(defun mcalls-seq (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.mcalls mcalls-seq"))
