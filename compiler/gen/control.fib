;; compiler/gen/control.fib: port of crates/fibgen/src/gen/control.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; `let`, `if`, `do`, `match` and `loop` at any type.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.control
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun control-is-send-fn (e: FgExpr cx: FgCtx) -> bool (trap "todo: gen.control control-is-send-fn"))
(defun control-irrefutable (g: FgGen ty: FgTy depth: i64) -> FgPatVars (trap "todo: gen.control control-irrefutable"))
(defun control-let-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.control control-let-form"))
(defun control-pat-names (p: FgPat) -> (Vec str) (trap "todo: gen.control control-pat-names"))
(defun control-if-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.control control-if-form"))
(defun control-do-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.control control-do-form"))
(defun control-match-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.control control-match-form"))
(defun control-clause-patterns (g: FgGen st: FgTy) -> (Vec FgPatVars) (trap "todo: gen.control control-clause-patterns"))
(defun control-loop-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.control control-loop-form"))
