;; compiler/gen/observe.fib: port of crates/fibgen/src/gen/observe.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Folding a value of any type into an `i64`, so that what a program
;; built is visible in its result (a wrong answer is detectable).
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.observe
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun observe-observe (g: FgGen cx: FgCtx e: FgExpr d: i64) -> FgExpr (trap "todo: gen.observe observe-observe"))
