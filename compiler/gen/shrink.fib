;; compiler/gen/shrink.fib: minimising a failing program, crates/fibgen/src/shrink.rs and pipe/shrink.rs (seed-1). OWNER: package S.
;; Greedy delta debugging over the typed tree: a node becomes the smallest value of its type, or a child of its type; a let binding, do step or
;; vector element is dropped; items are pruned to what is reachable; a pipeline loses a stage, a terminal or its shape.
;; The predicate takes a candidate and answers whether it still fails the same way (it runs the harness: a few seconds a call), so the budget
;; counts calls. A candidate is only generated by the rules; shrinking never needs the rng.
(ns gen.shrink
  (:use gen.ty gen.ast))

;; shrink::smallest and smallest_new: the smallest expression of each type of the universe.
(defun shrink-smallest (t: FgTy) -> FgExpr (trap "todo: gen.shrink shrink-smallest"))
;; candidates, removals, removals_new.
(defun shrink-candidates (e: FgExpr) -> (Vec FgExpr) (trap "todo: gen.shrink shrink-candidates"))
;; prune: drops functions and impls nothing reaches.
(defun shrink-prune (p: FgProgram) -> FgProgram (trap "todo: gen.shrink shrink-prune"))
;; pipe/shrink.rs variants.
(defun shrink-pipe-variants (p: FgPipe) -> (Vec FgPipe) (trap "todo: gen.shrink shrink-pipe-variants"))
;; The node numbering of node_mut/find: the order of program-bodies and expr-children.
(defun shrink-node-count (p: FgProgram) -> i64 (trap "todo: gen.shrink shrink-node-count"))
;; shrink::shrink: passes over nodes by size, largest first, until a pass changes nothing or the budget (calls of still-fails) is spent.
(defun shrink-program (p: FgProgram budget: i64 still-fails: (fn (FgProgram) bool)) -> FgProgram (trap "todo: gen.shrink shrink-program"))
