;; compiler/gen/helpers.fib: port of crates/fibgen/src/gen/helpers.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Top-level helper functions: plain ones (which may return their
;; parameters or parts of them), self and mutual tail recursion with
;; object accumulators, closure makers and async functions.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.helpers
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun helpers-helper-call (g: FgGen cx: FgCtx ret: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.helpers helpers-helper-call"))
(defun helpers-call (g: FgGen cx: FgCtx idx: i64 d: i64) -> FgExpr (trap "todo: gen.helpers helpers-call"))
