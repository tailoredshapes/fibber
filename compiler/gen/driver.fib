;; compiler/gen/driver.fib: a run (generate, check and classify many programs, minimise one exemplar per distinct finding), crates/fibgen/src/driver.rs and
;; crates/fibc/src/harness/gen.rs (seed-1). OWNER: package D.
;; Threads: the Rust used scoped threads. The port makes the case files, then runs the harness once over the directory (`driver.harness` runs N
;; cases at a time with -j), so the parallelism is the harness's; only generation and the model are sequential, one seed at a time under a
;; memory and time bound (the OOM of seed 1409: design section 3.4).
(ns gen.driver
  (:use gen.ty gen.ast gen.model.value gen.model.expected gen.pipelines gen.core gen.run gen.report gen.coverage))

(defstruct FgConfig
  (seed: i64 count: i64 size: (Option i64) jobs: i64 timeout-secs: i64 shrink: bool shrink-budget: i64 exemplars: i64
   kind: FgGenKind dir: str libs: (Vec str)))

(defstruct FgSample (seed: i64 size: i64 program: FgProgram verdict: FgVerdict expected: (Result i64 FgModelError) trace: (Vec str)))

(defstruct FgSummary (tallies: (Vec FgTally) groups: (Vec FgGroup) coverage: FgCoverage elapsed-ms: i64))
(defstruct FgTally (class: FgClass n: i64))
(defstruct FgGroup (class: FgClass key: str n: i64 samples: (Vec FgSample)))

;; size_of: cfg.size or 1 + i mod 6.
(defun driver-size-of (cfg: FgConfig i: i64) -> i64
  (match (. cfg size) ((some k) k) (nil (+ 1 (rem i 6)))))
;; GenKind::generate.
(defun driver-generate (kind: FgGenKind seed: i64 size: i64) -> FgProgram
  (match kind ((GkPipelines) (pipelines-generate seed size)) ((GkPrograms) (generate seed size))))
;; The model half of check_traced; the run half is the harness.
(defun driver-check (p: FgProgram) -> (Result i64 FgModelError) (model-expected p))
;; run_batch / harness::gen::run_kind.
(defun driver-run-batch (cfg: FgConfig) -> FgSummary (trap "todo: gen.driver driver-run-batch"))
;; minimise: shrink keeping (class, key) and a result the model can compute.
(defun driver-minimise (s: FgSample cfg: FgConfig) -> FgSample (trap "todo: gen.driver driver-minimise"))
(defun driver-summary-add (s: FgSummary x: FgSample keep: i64) -> FgSummary (trap "todo: gen.driver driver-summary-add"))
;; report::emit: writes each program of the range as a case; returns (written, gaps).
(defun driver-emit (cfg: FgConfig) -> (Result (Vec i64) str) (trap "todo: gen.driver driver-emit"))
