;; compiler/gen/objects.fib: port of crates/fibgen/src/gen/objects.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Productions for the object types: structs, the enum, boxes, options,
;; vectors, lists, cells and atoms, and extraction of parts of them.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.objects
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun objects-object (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.objects objects-object"))
(defun objects-cell-content-ctx (cx: FgCtx t: FgTy) -> FgCtx (trap "todo: gen.objects objects-cell-content-ctx"))
(defun objects-extract (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.objects objects-extract"))
(defun objects-deref (ty: FgTy e: FgExpr) -> FgExpr (trap "todo: gen.objects objects-deref"))
(defun objects-construct-leaf (g: FgGen cx: FgCtx ty: FgTy) -> FgExpr (trap "todo: gen.objects objects-construct-leaf"))
(defun objects-fresh-object (g: FgGen cx: FgCtx ty: FgTy) -> FgExpr (trap "todo: gen.objects objects-fresh-object"))
(defun objects-empty (g: FgGen cx: FgCtx ty: FgTy) -> FgExpr (trap "todo: gen.objects objects-empty"))
