;; compiler/gen/tasks.fib: port of crates/fibgen/src/gen/tasks.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Threads and tasks: `spawn`/`join`, `plet`, `pmap`, `async`/`await`,
;; `block-on` (syntax §3.12, §3.14). Code that runs elsewhere is
;; generated in a context holding only sendable captures (types §5).
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.tasks
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun tasks-await-yield () -> FgExpr (trap "todo: gen.tasks tasks-await-yield"))
(defun tasks-join (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.tasks tasks-join"))
(defun tasks-await-form (g: FgGen cx: FgCtx ty: FgTy d: i64) -> (Option FgExpr) (trap "todo: gen.tasks tasks-await-form"))
(defun tasks-task (g: FgGen cx: FgCtx t: FgTy d: i64) -> FgExpr (trap "todo: gen.tasks tasks-task"))
(defun tasks-async-body (g: FgGen cx: FgCtx t: FgTy d: i64) -> FgExpr (trap "todo: gen.tasks tasks-async-body"))
(defun tasks-spawn-discarded (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.tasks tasks-spawn-discarded"))
(defun tasks-plet (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.tasks tasks-plet"))
(defun tasks-pmap (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.tasks tasks-pmap"))
(defun tasks-pmap-sum (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.tasks tasks-pmap-sum"))
(defun tasks-spin-wait (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.tasks tasks-spin-wait"))
