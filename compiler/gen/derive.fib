;; compiler/gen/derive.fib: port of crates/fibgen/src/gen/derive.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Values of the preamble's `Ver` (a struct) and `Lvl` (an enum with a
;; field-less variant), whose `Eq` and `Ord` are made by `derive`
;; (syntax §3.16, types §2.12), compared.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.derive
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun derive-value (g: FgGen cx: FgCtx name: str d: i64) -> FgExpr (trap "todo: gen.derive derive-value"))
(defun derive-compare-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.derive derive-compare-int"))
(defun derive-observe (g: FgGen e: FgExpr) -> FgExpr (trap "todo: gen.derive derive-observe"))
