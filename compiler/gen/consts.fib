;; compiler/gen/consts.fib: port of crates/fibgen/src/gen/consts.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Top-level constants (`def`, syntax §3.19): immortal values that any
;; function, closure, thread or task may read without a count.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.consts
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun consts-constant (g: FgGen ty: FgTy d: i64) -> FgExpr (trap "todo: gen.consts consts-constant"))
(defun consts-defs (g: FgGen max: i64) -> FgDefs (trap "todo: gen.consts consts-defs"))
