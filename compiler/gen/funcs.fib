;; compiler/gen/funcs.fib: port of crates/fibgen/src/gen/funcs.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Closures: literals (escaping or not), named functions as values, and
;; calls through function values.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.funcs
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun funcs-literal (g: FgGen cx: FgCtx params: (Vec FgTy) ret: FgTy escaping: bool d: i64) -> FgExpr (trap "todo: gen.funcs funcs-literal"))
(defun funcs-function (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.funcs funcs-function"))
(defun funcs-const-fn (g: FgGen arity: i64) -> FgExpr (trap "todo: gen.funcs funcs-const-fn"))
(defun funcs-apply (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.funcs funcs-apply"))
(defun funcs-immediate (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.funcs funcs-immediate"))
(defun funcs-map-form (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.funcs funcs-map-form"))
(defun funcs-stmt-closure (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.funcs funcs-stmt-closure"))
(defun funcs-named (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.funcs funcs-named"))
