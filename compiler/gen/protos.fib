;; compiler/gen/protos.fib: port of crates/fibgen/src/gen/protos.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Protocols (syntax §3.10, types §4): the program's `impl`s of the
;; preamble's `Score` and `Rank` on its structs and enum, with defaults
;; sometimes taken and sometimes overridden; method calls on concrete
;; receivers, on `dyn` values and on the bounded variable of a generic
;; helper; `dyn` values, their upcasts and conversions.
;; 
;; No `impl` body calls a method: they are made before anything else,
;; with `methods_ok` off, so dispatch never recurses.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.protos
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun protos-impls (g: FgGen) -> (Vec FgImpl) (trap "todo: gen.protos protos-impls"))
(defun protos-self-as-value (body: FgExpr) -> bool (trap "todo: gen.protos protos-self-as-value"))
(defun protos-supports (g: FgGen t: FgTy) -> (Option FgProto) (trap "todo: gen.protos protos-supports"))
(defun protos-impl-types (g: FgGen p: FgProto send: bool) -> (Vec FgTy) (trap "todo: gen.protos protos-impl-types"))
(defun protos-dyn-value (g: FgGen cx: FgCtx p: FgProto send: bool d: i64) -> FgExpr (trap "todo: gen.protos protos-dyn-value"))
(defun protos-dyn-leaf (g: FgGen p: FgProto send: bool) -> FgExpr (trap "todo: gen.protos protos-dyn-leaf"))
(defun protos-call-method (g: FgGen cx: FgCtx recv: FgExpr p: FgProto d: i64) -> FgExpr (trap "todo: gen.protos protos-call-method"))
(defun protos-receiver (g: FgGen cx: FgCtx p: FgProto d: i64) -> (Option FgExpr) (trap "todo: gen.protos protos-receiver"))
(defun protos-make-generic (g: FgGen d: i64) -> i64 (trap "todo: gen.protos protos-make-generic"))

;; ---- merged from gen/protos2.rs: protos and protos2 call each other, and modules cannot be cyclic, so one module holds both.
(defun protos2-int-form (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.protos protos2-int-form"))
(defun protos2-generic-call (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.protos protos2-generic-call"))
