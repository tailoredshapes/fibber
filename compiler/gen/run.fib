;; compiler/gen/run.fib: the outcome classes and the classifier, crates/fibgen/src/run.rs (seed-1). OWNER: package R.
;; The Rust ran the program in the interpreter `fibref` on a thread with a time limit. The port has no interpreter (rule 6 is dropped,
;; docs/design/dev-loop.md): a program is run by writing it as a case file with the model's verdict in its header and running the harness
;; (`F cases DIR -j N`, driver.harness / driver.verdict), whose row is the observation. `Observed` is therefore built from a harness row.
(ns gen.run
  (:use gen.model.value))

(defenum FgClass ClOk ClExpectedTrap ClAuditFailure ClMismatch ClRunFailed ClPanic ClHang ClRejected ClUnsupported ClModelGap)
(derive Eq FgClass)

(defstruct FgVerdict (class: FgClass key: str detail: str))

;; What the harness saw: Done with the result or trap text and the audit summary, or a timeout.
(defenum FgObserved
  (ObCompiled result: i64 audit-clean: bool audit-key: str)
  (ObTrapped message: str audit-errors: (Vec str))
  (ObRejected message: str)
  (ObUnsupported reason: str)
  (ObFailed message: str)
  ObTimeout)

;; Class::is_finding: AuditFailure, Mismatch, RunFailed, Panic, Hang.
(defun class-finding? (c: FgClass) -> bool (trap "todo: gen.run class-finding?"))
;; The ten labels of Class::label, verbatim.
(defun class-label (c: FgClass) -> str (trap "todo: gen.run class-label"))
;; run::classify.
(defun run-classify (obs: FgObserved expected: (Result i64 FgModelError)) -> FgVerdict (trap "todo: gen.run run-classify"))
;; run::normalise: drop a leading line:col, digit runs become N, at most 100 chars. Finding keys depend on it.
(defun run-normalise (msg: str) -> str (trap "todo: gen.run run-normalise"))
;; Reads one row of `F cases` output (driver.harness) into an observation. The Rust read fibref::cases::Outcome.
(defun run-observe (row: str) -> FgObserved (trap "todo: gen.run run-observe"))
