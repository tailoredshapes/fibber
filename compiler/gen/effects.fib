;; compiler/gen/effects.fib: port of crates/fibgen/src/gen/effects.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Statements (`unit` expressions: `set!`, `push!`, `set-field!`, `&`
;; calls, atom updates, `for-each`, `await`), atom reads and weak
;; references.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.effects
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun effects-stmt (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.effects effects-stmt"))
(defun effects-atom-int (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.effects effects-atom-int"))
(defun effects-weak-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.effects effects-weak-int"))
(defun effects-for-each-sum (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.effects effects-for-each-sum"))
