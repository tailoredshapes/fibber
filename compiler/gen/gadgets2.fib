;; compiler/gen/gadgets2.fib: port of crates/fibgen/src/gen/gadgets2.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; More ownership templates: in-place updates while a snapshot or an
;; iteration holds the old value, closures that escape through a cell,
;; one task joined or awaited by several holders, `&` forwarding through
;; mutual tail calls.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.gadgets2
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun gadgets2-gadget (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.gadgets2 gadgets2-gadget"))
