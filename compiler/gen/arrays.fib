;; compiler/gen/arrays.fib: port of crates/fibgen/src/gen/arrays.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; `(Array a)` (types §2.13): made, read, copied with one slot changed,
;; sliced, and updated in place through a cell by `array-set!` (in
;; place when the cell's array is unique, a copy when a snapshot shares
;; it). Every index is a literal below the array's literal length, so
;; nothing traps.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.arrays
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun arrays-array-int (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.arrays arrays-array-int"))
