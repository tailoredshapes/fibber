;; compiler/gen/vpat.fib: port of crates/fibgen/src/gen/vpat.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Vector patterns and guarded clauses (syntax §3.6, types §2.6).
;; 
;; Clause lists are exhaustive and non-redundant by construction. The
;; unguarded clauses cover lengths `0 .. k-1` exactly and then `[p.. &
;; r]` of length `k` (or end in a catch-all); a refutable twin (with a
;; literal or a nested vector pattern) may precede the full clause of
;; its length. A guarded clause covers nothing (types §2.6), so it is
;; placed only where the full unguarded clauses above it do not already
;; cover every length it matches, which is exactly the redundancy rule.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.vpat
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun vpat-vector-match (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.vpat vpat-vector-match"))
(defun vpat-rest-match (g: FgGen cx: FgCtx elem: FgTy d: i64) -> FgExpr (trap "todo: gen.vpat vpat-rest-match"))
(defun vpat-wrap-in-wrap (g: FgGen p: FgPat) -> FgPatVars (trap "todo: gen.vpat vpat-wrap-in-wrap"))

;; ---- merged from gen/vpat2.rs: vpat and vpat2 call each other, and modules cannot be cyclic, so one module holds both.
(defun vpat2-counted-match (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.vpat vpat2-counted-match"))
(defun vpat2-guarded-match (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.vpat vpat2-guarded-match"))
