;; compiler/gen/coverage.fib: which constructs the programs exercised, crates/fibgen/src/coverage/{mod,more,pipelines,protos}.rs (seed-1).
;; OWNER: package V. Labels are strings; counts are (programs, occurrences) per label, in a sorted map so `render` is deterministic.
(ns gen.coverage
  (:use gen.ty gen.ast))

(defstruct FgCoverage (counts: (Cell (Vec FgLabelCount))))
(defstruct FgLabelCount (label: str programs: i64 occurrences: i64))

(defun coverage-new () -> FgCoverage (trap "todo: gen.coverage coverage-new"))
;; Coverage::add: labels of the program (programs counts distinct labels once).
(defun coverage-add (c: FgCoverage p: FgProgram) -> unit (trap "todo: gen.coverage coverage-add"))
(defun coverage-add-trace (c: FgCoverage trace: (Vec str)) -> unit (trap "todo: gen.coverage coverage-add-trace"))
(defun coverage-merge (c: FgCoverage other: FgCoverage) -> unit (trap "todo: gen.coverage coverage-merge"))
;; The table `fibgen run` prints.
(defun coverage-render (c: FgCoverage) -> str (trap "todo: gen.coverage coverage-render"))
;; coverage::labels, node_labels, let_labels, call_labels; more.rs macro and number labels; pipelines.rs; protos.rs item, pattern, guard, crossing, method labels. The label texts are the Rust ones: the corpus does not record them, the coverage test compares counts on a fixed seed range with the Rust table in compiler/tests/golden/gen/coverage-1-300.txt.
(defun coverage-labels (p: FgProgram) -> (Vec str) (trap "todo: gen.coverage coverage-labels"))
