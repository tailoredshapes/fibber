;; compiler/gen/ctx.fib: what is in scope where an expression is generated, as crates/fibgen/src/gen/ctx.rs (seed-1). OWNER: package T.
;; Variants: `Vk` for `VarKind`, `Rg` for `Region`. `Ctx` is an immutable value: `ctx-with` returns a new one (the Rust clones).
(ns gen.ctx
  (:use gen.ty))

(defenum FgVarKind VkLet VkParam VkPattern VkLoop VkInOut VkGlobal)
(derive Eq FgVarKind)

(defenum FgRegion RgMain RgPool RgTask)
(derive Eq FgRegion)

(defstruct FgVar (name: str ty: FgTy kind: FgVarKind send-fn: bool))

(defstruct FgCtx (vars: (Vec FgVar) in-async: bool region: FgRegion cell-free: bool))

(defun var-new (name: str ty: FgTy kind: FgVarKind) -> FgVar (trap "todo: gen.ctx var-new"))
(defun ctx-top (vars: (Vec FgVar) in-async: bool) -> FgCtx (trap "todo: gen.ctx ctx-top"))
;; Ctx::with: replaces an older binding of the same name (the shadowing rule: the test `shadowing_replaces_the_older_binding`).
(defun ctx-with (cx: FgCtx v: FgVar) -> FgCtx (trap "todo: gen.ctx ctx-with"))
(defun ctx-with-all (cx: FgCtx vs: (Vec FgVar)) -> FgCtx (trap "todo: gen.ctx ctx-with-all"))
;; vars_of: variables of exactly this type that are usable here (not `&` parameters; not cell-reaching ones in a cell-free context).
(defun ctx-vars-of (cx: FgCtx ty: FgTy) -> (Vec FgVar) (trap "todo: gen.ctx ctx-vars-of"))
(defun ctx-inouts-of (cx: FgCtx ty: FgTy) -> (Vec FgVar) (trap "todo: gen.ctx ctx-inouts-of"))
(defun ctx-cell-args (cx: FgCtx ty: FgTy) -> (Vec FgVar) (trap "todo: gen.ctx ctx-cell-args"))
(defun ctx-has-inout? (cx: FgCtx) -> bool (trap "todo: gen.ctx ctx-has-inout?"))
(defun ctx-for-closure (cx: FgCtx escaping: bool) -> FgCtx (trap "todo: gen.ctx ctx-for-closure"))
(defun ctx-for-region (cx: FgCtx region: FgRegion in-async: bool) -> FgCtx (trap "todo: gen.ctx ctx-for-region"))
(defun ctx-atoms-readable? (cx: FgCtx) -> bool (trap "todo: gen.ctx ctx-atoms-readable?"))
