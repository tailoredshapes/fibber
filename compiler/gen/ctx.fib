;; compiler/gen/ctx.fib: what is in scope where an expression is generated, as crates/fibgen/src/gen/ctx.rs (seed-1). OWNER: package T.
;; Variants: `Vk` for `VarKind`, `Rg` for `Region`. `Ctx` is an immutable value: `ctx-with` returns a new one (the Rust clones).
(ns gen.ctx
  (:use gen.ty))

(defenum FgVarKind VkLet VkParam VkPattern VkLoop VkInOut VkGlobal)
(derive Eq FgVarKind)

(defenum FgRegion RgMain RgPool RgTask)
(derive Eq FgRegion)

(defstruct FgVar (name: str ty: FgTy kind: FgVarKind send-fn: bool))

(defstruct FgCtx (vars: (Vec FgVar) in-async: bool region: FgRegion cell-free: bool))

(defun var-new (name: str ty: FgTy kind: FgVarKind) -> FgVar (FgVar name ty kind false))
(defun ctx-top (vars: (Vec FgVar) in-async: bool) -> FgCtx (FgCtx vars in-async RgMain false))

;; Ctx::with: replaces an older binding of the same name (the shadowing rule: the test `shadowing_replaces_the_older_binding`).
(defun ctx-with (cx: FgCtx v: FgVar) -> FgCtx
  (let ((kept (filterv (fn (x: FgVar) (not (= (. x name) (. v name)))) (. cx vars))))
    (FgCtx (conj kept v) (. cx in-async) (. cx region) (. cx cell-free))))

(defun ctx-with-all (cx: FgCtx vs: (Vec FgVar)) -> FgCtx
  (reduce (fn (c: FgCtx v: FgVar) (ctx-with c v)) cx vs))

(defun ctx-usable? :private (cx: FgCtx v: FgVar) -> bool
  (and (not (= (. v kind) VkInOut))
       (not (and (. cx cell-free) (ty-may-reach-cell? (. v ty))))))

;; vars_of: variables of exactly this type that are usable here (not `&` parameters; not cell-reaching ones in a cell-free context).
(defun ctx-vars-of (cx: FgCtx ty: FgTy) -> (Vec FgVar)
  (filterv (fn (v: FgVar) (and (= (. v ty) ty) (ctx-usable? cx v))) (. cx vars)))

(defun ctx-inouts-of (cx: FgCtx ty: FgTy) -> (Vec FgVar)
  (filterv (fn (v: FgVar) (and (= (. v kind) VkInOut) (= (. v ty) ty))) (. cx vars)))

(defun ctx-cell-args (cx: FgCtx ty: FgTy) -> (Vec FgVar)
  (let ((cell (YCell ty)))
    (filterv (fn (v: FgVar)
               (or (and (= (. v kind) VkLet) (= (. v ty) cell))
                   (and (= (. v kind) VkInOut) (= (. v ty) ty))))
             (. cx vars))))

(defun ctx-has-inout? (cx: FgCtx) -> bool
  (some? (find-first (fn (v: FgVar) (= (. v kind) VkInOut)) (. cx vars))))

(defun ctx-for-closure (cx: FgCtx escaping: bool) -> FgCtx
  (let ((vars (if escaping (filterv (fn (v: FgVar) (not (= (. v kind) VkInOut))) (. cx vars)) (. cx vars))))
    (FgCtx vars false (. cx region) (. cx cell-free))))

(defun ctx-for-region (cx: FgCtx region: FgRegion in-async: bool) -> FgCtx
  (let ((keep (fn (v: FgVar)
                (let ((sendable (or (ty-send? (. v ty)) (. v send-fn) (= (. v kind) VkGlobal)))
                      (atom-ok (or (= region RgPool) (not (ty-atom? (. v ty))))))
                  (and (not (= (. v kind) VkInOut)) sendable atom-ok)))))
    (FgCtx (filterv keep (. cx vars)) in-async region (. cx cell-free))))

(defun ctx-atoms-readable? (cx: FgCtx) -> bool (= (. cx region) RgMain))
