;; compiler/gen/ty.fib: the types of generated programs, as crates/fibgen/src/ty.rs (seed-1). OWNER: package T (docs/design/fibgen-port.md section 5).
;;
;; Shapes decided where Rust and fibber differ (design section 4.2):
;; - variants carry a prefix: `Y` for `Ty`, `Nm` for `NumTy`, `Pr` for `Proto`; the Rust name is beside each;
;; - `Box<Ty>` is a plain field; `Derived(&'static str)` is `YDerived` of a str;
;; - `Func(Vec<Ty>, Box<Ty>)` is `YFunc` of a vector of parameter types and a result.
;; The Rust associated functions are `ty-*`, `proto-*`, `num-*`; the functions here are stubs (trap).
(ns gen.ty)

(defenum FgNum NmI8 NmI16 NmI32 NmF32 NmF64)
(derive Eq FgNum)

(defenum FgProto PrScore PrRank)
(derive Eq FgProto)

(defenum FgTy
  YUnit YInt YBool YStr YPt YWrap YHolder YShape
  (YBoxed t: FgTy) (YOpt t: FgTy) (YVec t: FgTy) YList (YCell t: FgTy) (YAtom t: FgTy) (YWeak t: FgTy) (YTask t: FgTy)
  (YFunc params: (Vec FgTy) ret: FgTy)
  (YDyn proto: FgProto send: bool)
  (YHook send: bool)
  (YJob send: bool)
  (YNum n: FgNum)
  (YArray t: FgTy)
  (YDerived name: str)
  (YGen proto: FgProto send: bool))
(derive Eq FgTy)

;; NumTy::name, bits, is_float.
(defun num-name (n: FgNum) -> str (trap "todo: gen.ty num-name"))
(defun num-bits (n: FgNum) -> i64 (trap "todo: gen.ty num-bits"))
(defun num-float? (n: FgNum) -> bool (trap "todo: gen.ty num-float?"))

;; Proto::name, methods, entails.
(defun proto-name (p: FgProto) -> str (trap "todo: gen.ty proto-name"))
(defun proto-methods (p: FgProto) -> (Vec str) (trap "todo: gen.ty proto-methods"))
(defun proto-entails? (p: FgProto q: FgProto) -> bool (trap "todo: gen.ty proto-entails?"))

;; Ty::fn_i, fn_0, inner, is_send, may_reach_cell, is_atom, needs_protocols, is_object.
(defun ty-fn-i () -> FgTy (trap "todo: gen.ty ty-fn-i"))
(defun ty-fn-0 () -> FgTy (trap "todo: gen.ty ty-fn-0"))
(defun ty-inner (t: FgTy) -> (Option FgTy) (trap "todo: gen.ty ty-inner"))
(defun ty-send? (t: FgTy) -> bool (trap "todo: gen.ty ty-send?"))
(defun ty-may-reach-cell? (t: FgTy) -> bool (trap "todo: gen.ty ty-may-reach-cell?"))
(defun ty-atom? (t: FgTy) -> bool (trap "todo: gen.ty ty-atom?"))
(defun ty-needs-protocols? (t: FgTy) -> bool (trap "todo: gen.ty ty-needs-protocols?"))
(defun ty-object? (t: FgTy) -> bool (trap "todo: gen.ty ty-object?"))

;; `impl Display for Ty`: the type as the program writes it, e.g. `(Cell (Vec i64))`, `(dyn Score :send)`, `(Hook :local)`.
(defun ty-text (t: FgTy) -> str (trap "todo: gen.ty ty-text"))

;; `universe()` (42 types, in the Rust order: the order is part of the determinism contract) and `inout_contents()`.
(defun ty-universe () -> (Vec FgTy) (trap "todo: gen.ty ty-universe"))
(defun ty-inout-contents () -> (Vec FgTy) (trap "todo: gen.ty ty-inout-contents"))
