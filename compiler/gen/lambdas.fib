;; compiler/gen/lambdas.fib: port of crates/fibgen/src/gen/lambdas.rs (seed-1): the functions of a generated pipeline, and the pipeline generator's state
;; `PGen` (declared in gen/pipelines.rs in Rust; here, because lambdas needs it and pipelines needs lambdas). OWNER: see docs/design/fibgen-port.md section 5.
;; Pure `fn` literals over i64, small enough that no chain of them overflows (a term is at most six times the larger of its leaves, a chain has at
;; most six stages, a multiplying fold reduces its accumulator), with an optional statement that adds a weight to the call counter `calls`.
(ns gen.lambdas
  (:use gen.ty gen.ctx gen.ast gen.rng))

;; PGen: `counted` says whether the functions add to the call counter; `ints` the captured i64 names main binds; `cv` the captured vector, if any.
;; `defs` and `size` as the Rust.
(defstruct FgPGen (rng: FgRng counted: (Cell bool) ints: (Cell (Vec str)) cv: (Cell (Option str)) defs: (Cell (Vec FgDef)) size: i64))

(defun lambdas-calls () -> str "calls")

(defun lambdas-lit (g: FgPGen) -> FgExpr (trap "todo: gen.lambdas lambdas-lit"))
(defun lambdas-leaf (g: FgPGen params: (Vec str)) -> FgExpr (trap "todo: gen.lambdas lambdas-leaf"))
(defun lambdas-term (g: FgPGen d: i64 params: (Vec str)) -> FgExpr (trap "todo: gen.lambdas lambdas-term"))
(defun lambdas-pred (g: FgPGen d: i64 params: (Vec str)) -> FgExpr (trap "todo: gen.lambdas lambdas-pred"))
;; `(fn (x: i64) term)`; `count` says whether it may count its calls.
(defun lambdas-int-fn (g: FgPGen count: bool) -> FgExpr (trap "todo: gen.lambdas lambdas-int-fn"))
(defun lambdas-bool-fn (g: FgPGen) -> FgExpr (trap "todo: gen.lambdas lambdas-bool-fn"))
;; `(fn (x: i64) (Vec i64))`: one to three elements, or one or none.
(defun lambdas-vec-fn (g: FgPGen) -> FgExpr (trap "todo: gen.lambdas lambdas-vec-fn"))
;; `(fn (a: i64 x: i64) ..)`: a fold step whose accumulator stays small.
(defun lambdas-step-fn (g: FgPGen) -> FgExpr (trap "todo: gen.lambdas lambdas-step-fn"))
(defun lambdas-key-fn (g: FgPGen) -> FgExpr (trap "todo: gen.lambdas lambdas-key-fn"))
(defun lambdas-lets (binds: (Vec FgNameInit) body: FgExpr) -> FgExpr (trap "todo: gen.lambdas lambdas-lets"))
