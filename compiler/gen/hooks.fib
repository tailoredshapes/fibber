;; compiler/gen/hooks.fib: port of crates/fibgen/src/gen/hooks.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; The colour-parameterised struct `(Hook k :colour)` (types §1.3): a
;; `(Hook :send)` holds a closure whose captures are all sendable and
;; may cross a thread; a `(Hook :local)` may hold one over a cell.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.hooks
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun hooks-hook (g: FgGen cx: FgCtx send: bool d: i64) -> FgExpr (trap "todo: gen.hooks hooks-hook"))
(defun hooks-hook-leaf (g: FgGen send: bool) -> FgExpr (trap "todo: gen.hooks hooks-hook-leaf"))
(defun hooks-observe-hook (g: FgGen e: FgExpr) -> FgExpr (trap "todo: gen.hooks hooks-observe-hook"))
(defun hooks-cross (g: FgGen cx: FgCtx d: i64) -> FgExpr (trap "todo: gen.hooks hooks-cross"))
