;; compiler/gen/report.fib: findings and case files, crates/fibgen/src/report.rs and the header of crates/fibc/src/harness/gen.rs (seed-1). OWNER: package D.
;; A case file is `;; spec: ..`, the verdict (`;; expect: accept`, `;; result: N`, `;; audit:  clean`, or `;; expect: trap` / `;; trap:   MSG`) and the
;; program: the header format of spec/method.md rule 3 and driver.header. A program the model cannot evaluate is a model gap: counted, not run.
(ns gen.report
  (:use gen.ast gen.model.value gen.run))

(defenum FgGenKind GkPrograms GkPipelines)
(derive Eq FgGenKind)

;; harness/gen.rs header: nil for a gap (MeUnsupported, MeBudget).
(defun report-header (seed: i64 size: i64 kind: FgGenKind expected: (Result i64 FgModelError)) -> (Option str) (trap "todo: gen.report report-header"))
;; DIR/gen-%08d-SIZE.fib.
(defun report-case-path (dir: str seed: i64 size: i64) -> str (trap "todo: gen.report report-case-path"))
;; report::slug: file-safe.
(defun report-slug (v: FgVerdict) -> str (trap "todo: gen.report report-slug"))
;; report::case_text for a minimised finding (cases/found/generated).
(defun report-case-text (seed: i64 size: i64 kind: FgGenKind expected: i64 observed: FgVerdict source: str) -> str (trap "todo: gen.report report-case-text"))
;; report::write_case: the next free number in DIR.
(defun report-write-case (dir: str seed: i64 size: i64 kind: FgGenKind expected: i64 observed: FgVerdict source: str) -> (Result str str) (trap "todo: gen.report report-write-case"))
