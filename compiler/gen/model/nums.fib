;; compiler/gen/model/nums.fib: port of crates/fibgen/src/model/nums.rs: numbers of other widths and floats (types 2.12): checked integer arithmetic at i8/i16/i32, shifts mod width, IEEE floats at their width (f32 rounds after each op), `rem` is fmod, saturating float-to-int conversion, NaN to 0.
;;  OWNER: see design section 5.
(ns gen.model.nums
  (:use gen.ty gen.ast gen.model.value gen.model))

;; nums.rs op: nil when `h` is not a numeric builtin.
(defun nums-op (h: str a: (Vec FgV)) -> (Option (Result FgV FgStop)) (trap "todo: gen.model.nums nums-op"))
;; nums.rs convert.
(defun nums-convert (op: str to: (Option FgNum) v: FgV) -> (Result FgV FgStop) (trap "todo: gen.model.nums nums-convert"))
