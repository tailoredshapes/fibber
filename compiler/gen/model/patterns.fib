;; compiler/gen/model/patterns.fib: port of crates/fibgen/src/model/patterns.rs and protos.rs: vector patterns and guarded clauses, and protocol dispatch with the defaults written independently (`bonus` = score + k, `tier` = rank + score).
;;  OWNER: see design section 5.
(ns gen.model.patterns
  (:use gen.ty gen.ast gen.model.value gen.model))

;; patterns.rs bind_vector: nil when it does not match.
(defun patterns-bind-vector (ps: (Vec FgPat) rest: (Option FgRest) xs: (Vec FgV) env: (Option FgEnv)) -> (Option (Option FgEnv)) (trap "todo: gen.model.patterns patterns-bind-vector"))
;; ev_gmatch: a false guard falls through to the next clause on the same value.
(defun patterns-gmatch (m: FgMachine s: FgExpr cl: (Vec FgClause) env: (Option FgEnv)) -> (Result FgV FgStop) (trap "todo: gen.model.patterns patterns-gmatch"))
;; protos.rs method and default_method.
(defun protos-method (m: FgMachine h: str args: (Vec FgV)) -> (Result FgV FgStop) (trap "todo: gen.model.patterns protos-method"))
