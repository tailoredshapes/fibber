;; compiler/gen/model/builtins.fib: port of crates/fibgen/src/model/builtins.rs and arrays.rs: the builtins, constructors and prelude functions the generator calls, and arrays with derived Eq/Ord.
;;  OWNER: see design section 5.
(ns gen.model.builtins
  (:use gen.ty gen.ast gen.model.value gen.model))

;; Machine::builtin.
(defun builtins-call (m: FgMachine h: str a: (Vec FgV)) -> (Result FgV FgStop) (trap "todo: gen.model.builtins builtins-call"))
;; arrays.rs op.
(defun arrays-op (h: str a: (Vec FgV)) -> (Option (Result FgV FgStop)) (trap "todo: gen.model.builtins arrays-op"))
;; arrays.rs derived_cmp: -1, 0, 1 or nil.
(defun arrays-derived-cmp (x: FgV y: FgV) -> (Option i64) (trap "todo: gen.model.builtins arrays-derived-cmp"))
