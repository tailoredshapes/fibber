;; compiler/gen/model/value.fib: the model's values and its error type, as crates/fibgen/src/model/value.rs and mod.rs `ModelError` (seed-1).
;; OWNER: package M0. Variants: `Vl` for `V`, `Me` for `ModelError`, `Ts` for `TaskState`. Shapes (design section 4.6): `Rc<..>` is a plain field
;; (fibber objects are counted); `Rc<RefCell<V>>` is a `(Cell FgV)`; `Env` is a persistent linked list `FgEnv` (the Rust `Rc<Node>` chain).
;; A closure's environment holds values and a value holds closures: one module.
(ns gen.model.value
  (:use gen.ty gen.ast))

(defstruct FgEnv (name: str val: FgV parent: (Option FgEnv)))

(defstruct FgClosure (self-name: (Option str) params: (Vec str) body: FgExpr env: (Option FgEnv)))

(defenum FgTaskState (TsPending e: FgExpr env: (Option FgEnv)) (TsDone v: FgV))

(defenum FgV
  VlUnit
  (VlInt v: i64)
  (VlIntW v: i64 n: FgNum)
  (VlFlt v: f64 n: FgNum)
  (VlBool v: bool)
  (VlStr v: str)
  (VlData name: str fields: (Vec FgV))
  (VlOpt v: (Option FgV))
  (VlVector items: (Vec FgV))
  (VlList items: (Vec FgV))
  (VlCell c: (Cell FgV))
  (VlAtom c: (Cell FgV))
  (VlWeak target: (Option FgV))
  (VlTask t: (Cell FgTaskState))
  (VlClosure c: FgClosure)
  (VlNamed name: str))

;; ModelError: the result of the model is `(Result i64 FgModelError)`.
;; MeBudget is the step budget (Rust: counted as a gap, not a finding). The Rust model has NO memory bound: seed 1409 (size 5, kind programs)
;; asks for a 2.3 GB allocation; the port bounds the model's allocations too (design section 3.4).
(defenum FgModelError (MeTrap msg: str) (MeUnsupported msg: str) MeBudget)
(derive Eq FgModelError)

;; Env::bind.
(defun env-bind (env: (Option FgEnv) name: str val: FgV) -> FgEnv (FgEnv name val env))
;; Env::get: the innermost binding.
(defun env-get (env: (Option FgEnv) name: str) -> (Option FgV)
  (loop ((cur env))
    (match cur
      (nil nil)
      ((some n) (if (= (. n name) name) (some (. n val)) (recur (. n parent)))))))
