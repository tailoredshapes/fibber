;; compiler/gen/gadgets.fib: port of crates/fibgen/src/gen/gadgets.rs (seed-1). OWNER: see docs/design/fibgen-port.md section 5.
;; Templates for the situations where lexical scope alone does not
;; decide when memory is freed (cases 01–11 and the proposed cases),
;; each with random holes: the object type, the values, the nesting.
;; The random grammar reaches all of them too, but rarely combined.
;; Every function is named STEM-NAME (the Rust name in kebab case) so that no name meets a builtin. Bodies are stubs.
(ns gen.gadgets
  (:use gen.ty gen.ast gen.ctx gen.state))

(defun gadgets-gadget (g: FgGen cx: FgCtx d: i64) -> (Option FgExpr) (trap "todo: gen.gadgets gadgets-gadget"))
