;; compiler/gen/core.fib: crates/fibgen/src/gen/mod.rs (seed-1): `generate`, the dispatcher `expr`, `specific`, `leaf`, `leaf_value`, and the
;; pipeline generator's entry (pipelines.rs `generate_pipeline`). OWNER: package G (core). It requires every production module (it is the root
;; of the production graph), fills the `FgHooks` of gen.state, and is what `gen.driver` calls.
(ns gen.core
  (:use gen.ty gen.ctx gen.ast gen.rng gen.state))

;; Gen::expr: nodes += 1; leaf at depth 0 or over budget; the ten weights; falls back to `specific`.
(defun core-expr (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.core core-expr"))
;; Gen::specific: by type, then `leaf` when the production gives nothing.
(defun core-specific (g: FgGen cx: FgCtx ty: FgTy d: i64) -> FgExpr (trap "todo: gen.core core-specific"))
;; Gen::leaf: 60% a variable of the type when one is usable, else leaf_value.
(defun core-leaf (g: FgGen cx: FgCtx ty: FgTy) -> FgExpr (trap "todo: gen.core core-leaf"))
;; Gen::leaf_value.
(defun core-leaf-value (g: FgGen cx: FgCtx ty: FgTy) -> FgExpr (trap "todo: gen.core core-leaf-value"))
;; The three functions above as a record, for gen-new.
(defun core-hooks () -> FgHooks (trap "todo: gen.core core-hooks"))
;; gen::generate. `seed` is the u64 of the Rust as its i64 bits.
(defun generate (seed: i64 size: i64) -> FgProgram (trap "todo: gen.core generate"))
