;; spec: docs/design/test-harness.md section 1 (a spec file is a case: its verdict is the run's exit value)
;; expect: accept
;; result: 1
;; audit: clean
;; The scenario is wrong on purpose and the case says so: if the harness stopped reporting a broken expectation (exit 0), this case fails.
(ns main (:use fib.test.core fib.test.run))
(defspecs specs
  (feature "Vec"
    (scenario "a wrong claim"
      (given [v [1 2]])
      (then (expect = 5 (count v))))))
(defun main () -> i64 (run-main (specs)))
