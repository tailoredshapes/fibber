;; spec: docs/design/test-harness.md section 4 (a trap in a scenario is a row, not the end of the run) (task isolation: what the trapped task owned is abandoned, 10 objects)
;; expect: accept
;; result: 1
;; audit: abandoned
;; leaks: 10
(ns main (:use fib.test.core fib.test.run))
(defspecs specs
  (feature "Vec"
    (scenario "a trap"
      (given [v [1 2]])
      (then (expect = 9 (nth v 7))))
    (scenario "still runs after it"
      (then (expect = 1 1)))))
(defun main () -> i64 (run-main (specs)))
