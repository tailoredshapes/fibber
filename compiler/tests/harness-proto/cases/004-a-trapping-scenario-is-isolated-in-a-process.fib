;; spec: docs/design/test-harness.md section 5 (a trap in a scenario is a row, not the end of the run), fork isolation
;; expect: accept
;; result: 1
;; audit: clean
;; The same spec as 003 run with `--isolate fork`: the child process owns the trap, so the parent's audit is clean (no abandoned objects).
(ns main (:use fib.test.core fib.test.run))
(defspecs specs
  (feature "Vec"
    (scenario "a trap"
      (given [v [1 2]])
      (then (expect = 9 (nth v 7))))
    (scenario "still runs after it"
      (then (expect = 1 1)))))
(defun main () -> i64 (run-main-with (specs) ["--isolate" "fork"]))
