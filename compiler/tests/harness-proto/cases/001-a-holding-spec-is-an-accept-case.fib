;; spec: docs/design/test-harness.md section 1 (a spec file is a case: its verdict is the run's exit value)
;; expect: accept
;; result: 0
;; audit: clean
(ns main (:use fib.test.core fib.test.run))
(defspecs specs
  (feature "Vec"
    (scenario "conj appends"
      (given [v [1 2]])
      (upon [w (conj v 3)])
      (then (expect = [1 2 3] w)))))
(defun main () -> i64 (run-main (specs)))
