;; The Map contract: what any map from i64 to i64 must do, whoever implements it. It names no implementation: `make` builds an empty
;; one, and the protocols (Lookup, Assoc, Dissoc, Keyed) are the only things the scenarios call, so the types of the contract are
;; inferred as `(Lookup m i64 i64)` and the rest and each implementation gets its own monomorphised copy.
(ns map-contract (:use fib.test.core))

(defcontract MapContract [make]
  (scenario "an empty map holds no key"
    (covers "get" "contains?")
    (given [m (make)])
    (then (expect = nil (get m 1)) (expect = false (contains? m 1))))
  (scenario "assoc then get"
    (covers "assoc" "get")
    (given [m (assoc (make) 1 10)])
    (then (expect = (some 10) (get m 1)) (expect = true (contains? m 1))))
  (scenario "assoc on an existing key replaces its value"
    (covers "assoc")
    (given [m (assoc (assoc (make) 1 10) 1 11)])
    (then (expect = (some 11) (get m 1))))
  (scenario "assoc leaves the other keys alone"
    (covers "assoc")
    (given [m (assoc (assoc (make) 1 10) 2 20)])
    (then (expect = (some 10) (get m 1)) (expect = (some 20) (get m 2))))
  (scenario "dissoc removes the key and only that key"
    (covers "dissoc")
    (given [m (assoc (assoc (make) 1 10) 2 20)])
    (upon [d (dissoc m 1)])
    (then (expect = nil (get d 1)) (expect = (some 20) (get d 2))))
  (scenario "dissoc of an absent key changes nothing"
    (covers "dissoc")
    (given [m (assoc (make) 1 10)])
    (upon [d (dissoc m 7)])
    (then (expect = (some 10) (get d 1)))))
