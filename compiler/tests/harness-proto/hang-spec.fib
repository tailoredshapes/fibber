;; A scenario that never ends, between two that do: what `--timeout` (fork isolation) is for. Under task isolation nothing can stop it, so
;; run.sh only runs this spec with `--timeout`.
(ns main (:use fib.test.core fib.test.run))

(defspecs specs
  (feature "Hang"
    (scenario "before the hang"
      (then (expect = 1 1)))
    (scenario "a scenario that loops forever (planted)"
      (given [n 0])
      (then (expect = 1 (loop ((i 0)) (if (< i 0) 1 (recur (+ i 1)))))))
    (scenario "after the hang"
      (then (expect = 2 2)))))

(defun main () -> i64 (run-main (specs)))
