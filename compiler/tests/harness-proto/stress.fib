;; 1000 trivial scenarios built as data: the harness's per-scenario cost with nothing in the scenario. Not a spec of anything.
(ns main (:use fib.test.core fib.test.run))

(defun many () -> (Vec Suite)
  [(Suite "stress" ""
          (mapv (fn (i: i64) (Scenario (str "s" i) "trivial" [] ["Then holds"] (fn (seed: i64) [(StepRun "Then" "Then holds" Held)])))
                (range 1000)))])

(defun main () -> i64 (run-main (many)))
