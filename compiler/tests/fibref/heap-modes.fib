       (tc "immortals-never-leaks" t-immortals-are-never-leaks)
       (tc "immortal-holds-only-immortals" t-an-immortal-may-hold-only-immortals)
       (tc "immortal-is-immutable" t-an-immortal-is-immutable)
       (tc "weak-to-immortal" t-a-weak-to-an-immortal-always-upgrades-without-a-count)
       (tc "sharing-stops-at-immortal" t-sharing-stops-at-an-immortal)
       (tc "immortalise-whole-graph" t-immortalise-marks-the-whole-counted-graph-and-stops-at-immortals)
       (tc "immortalise-refuses-a-cell" t-immortalise-refuses-a-cell-and-marks-nothing)
       (tc "immortalise-refuses-weak-to-mortal" t-immortalise-refuses-a-weak-to-a-mortal-outside-the-graph)
       (tc "def-with-atom-is-pinned" t-a-def-value-that-holds-an-atom-is-pinned)
       (tc "unpinned-is-a-leak" t-a-value-that-was-not-pinned-is-still-a-leak)
       (tc "shared-propagates" t-mark-shared-propagates-through-refs)
       (tc "shared-not-twice" t-already-shared-objects-are-not-marked-twice)
       (tc "shared-cell-rejects" t-a-reachable-cell-rejects-the-crossing-and-marks-nothing)
       (tc "shared-atom-may-cross" t-a-reachable-atom-may-cross)
       (tc "shared-cycle-terminates" t-a-cycle-through-an-atom-terminates)
       (tc "write-into-shared-atom-shares" t-writing-into-a-shared-atom-shares-the-value)
       (tc "write-cell-into-shared-atom-rejected" t-writing-a-cell-into-a-shared-atom-is-rejected-unchanged)
       (tc "write-into-unshared-atom" t-writing-into-an-unshared-atom-shares-nothing)
       (tc "live-weak-target-reachable" t-a-live-weak-target-counts-as-reachable)
       (tc "weak-to-live-cell-into-shared-atom" t-writing-a-weak-to-a-live-cell-into-a-shared-atom-is-rejected)
       (tc "scope-ends-objects" t-a-scope-ends-its-objects-and-releases-what-they-hold)
       (tc "stack-count-ops-no-ops" t-retain-and-release-of-a-live-stack-object-are-untraced-no-ops)
       (tc "stack-use-after-scope" t-every-access-after-the-scope-ended-is-stack-use-after-scope)
       (tc "stack-ref-in-heap" t-a-stack-ref-stored-into-a-heap-object-is-an-error)
       (tc "stack-ref-into-outer-scope" t-a-stack-ref-into-an-outer-scope-object-is-an-error)
       (tc "weak-to-stack" t-a-weak-to-a-stack-object-is-an-error)
       (tc "shared-stack" t-sharing-a-stack-object-is-an-error)
       (tc "scopes-end-once" t-scopes-end-once)
       (tc "open-scope-at-finish" t-an-open-scope-at-finish-is-reported-and-its-objects-are-not-leaks)
