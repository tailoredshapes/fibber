;; compiler/tests/fibref/skeleton.fib: a program that requires every module of the fibref port contract (compiler/fibref/*, compiler/lsp/*) and some of the
;; compiler/ modules it links with (driver, own, native), by taking one function of each as a value, so that type and variant names are checked
;; against collisions and every stub is type-checked (a module nothing refers to is not loaded). skeleton.sh builds and runs it. A module added to
;; compiler/fibref or compiler/lsp must be added here (skeleton.sh fails otherwise).
(ns main
  (:require
    [fibref.builtins :as m0]
    [fibref.cmd :as m1]
    [fibref.error :as m2]
    [fibref.eval :as m3]
    [fibref.explain :as m4]
    [fibref.heap :as m5]
    [fibref.prepare :as m6]
    [fibref.task :as m7]
    [fibref.trace :as m8]
    [fibref.value :as m9]
    [lsp.analysis :as m10]
    [lsp.catalog :as m11]
    [lsp.features :as m12]
    [lsp.json :as m13]
    [lsp.scope :as m14]
    [lsp.server :as m15]
    [lsp.text :as m16]
    [lsp.types :as m17]
    [driver.front :as m18]
    [driver.header :as m19]
    [driver.verdict :as m20]
    [own.driver :as m21]
    [own.explain :as m22]
    [native.error :as m23]
    [lsp.definition :as m24]))

(defun main () -> i64
  (let [f0 m0/call-builtin
        f1 m1/cmd-run
        f2 m2/exit-trap
        f3 m3/run-program
        f4 m4/explain-plan
        f5 m5/heap-new
        f6 m6/prepare-program
        f7 m7/tasks-new
        f8 m8/trace-lines
        f9 m9/ival-obj
        f10 m10/analyse
        f11 m11/catalog-names
        f12 m12/complete
        f13 m13/json-parse
        f14 m14/scope-at
        f15 m15/server-new
        f16 m16/offset->pos
        f17 m17/lsp-protocol-version
        f18 m18/check-file
        f19 m19/known-keys
        f20 m20/status-label
        f21 m21/own-check-modules
        f22 m22/explain
        f23 m23/lair-error-str
        f24 m24/find-definition]
    (do (println "ok") 0)))
