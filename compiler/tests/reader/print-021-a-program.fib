;; a realistic program: comments, annotations, strings, floats, prefixes
(ns main (:require [util.text :as text]) (:use util))

;; the answer
(defun answer :private (x: i64 y: (Vec str) :borrow) -> i64
  #_ (dropped form)
  (let ((a 0x2A) (b 1_000))
    (if (> a b) a (+ a b))))   ; trailing comment

(defstruct Point (x: f64 y: f32))
(defenum (Result a b) (Ok v: a) (Err e: b))
(defmacro twice (x) `(do ,x ,x))
(defun main () -> i64
  (do (println "hello, \"world\"\n") (twice (show 1.5e-7)) (show @c) (f &x) (match o (nil 0) ((some v) v) ([a b] 1) (\a 2) ("s" 3))
      42))
