@.str.5 = private unnamed_addr constant [8 x i8] c"dyn %d\0A\00"
@.str.6 = private unnamed_addr constant [14 x i8] c"ptrvec %d %d\0A\00"

declare i32 @printf(ptr, ...)

define <4 x i32> @vadd(<4 x i32> %a, <4 x i32> %b) {
entry:
  %0 = add <4 x i32> %a, %b
  ret <4 x i32> %0
}

define void @pr(ptr %tag, <4 x i32> %v) {
entry:
  %0 = extractelement <4 x i32> %v, i32 0
  %1 = extractelement <4 x i32> %v, i32 1
  %2 = extractelement <4 x i32> %v, i32 2
