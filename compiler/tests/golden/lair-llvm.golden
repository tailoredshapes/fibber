declare i32 @printf(ptr, ...)

define void @scal(i1 %a, i8 %b, i16 %c, i32 %d, double %e, float %f, ptr %g) {
entry:
  %0 = zext i1 %a to i32
  %1 = sext i8 %b to i32
  %2 = sext i16 %c to i32
  %3 = fpext float %f to double
  %4 = icmp ne ptr %g, null
  %5 = zext i1 %4 to i32
  %6 = call i32 (ptr, ...) @printf(ptr @.str, i32 %0, i32 %1, i32 %2, i32 %d, double %e, double %3, i32 %5)
  ret void
}

define i64 @sum-pair({ ptr, ptr } %p) {
entry:
  %0 = extractvalue { ptr, ptr } %p, 0
  %1 = load i64, ptr %0, align 8
  %2 = extractvalue { ptr, ptr } %p, 1
  %3 = load i64, ptr %2, align 8
  %4 = add i64 %1, %3
  ret i64 %4
}

define i32 @vsum(<4 x i32> %v) {
entry:
  %0 = extractelement <4 x i32> %v, i32 0
  %1 = extractelement <4 x i32> %v, i32 1
  %2 = add i32 %0, %1
  %3 = extractelement <4 x i32> %v, i32 2
  %4 = extractelement <4 x i32> %v, i32 3
  %5 = add i32 %3, %4
  %6 = add i32 %2, %5
  ret i32 %6
}

define double @mixed(ptr %env, i8 %b, i64 %c, float %f, i1 %z) {
entry:
  %0 = sext i8 %b to i32
  %1 = fpext float %f to double
  %2 = zext i1 %z to i32
  %3 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %0, i64 %c, double %1, i32 %2)
  %4 = fpext float %f to double
  ret double %4
}

define { ptr, ptr } @swap({ ptr, ptr } %p) {
entry:
  %0 = extractvalue { ptr, ptr } %p, 1
  %1 = extractvalue { ptr, ptr } %p, 0
  %2 = insertvalue { ptr, ptr } poison, ptr %0, 0
  %3 = insertvalue { ptr, ptr } %2, ptr %1, 1
  ret { ptr, ptr } %3
}

define i32 @main() {
entry:
  %s = alloca i64, align 8
  call void @scal(i1 true, i8 -2, i16 3, i32 -4, double 5.500000e+00, float 2.500000e-01, ptr %s)
  %a = alloca i64, align 8
  %b = alloca i64, align 8
  store i64 10, ptr %a, align 8
  store i64 20, ptr %b, align 8
  %0 = insertvalue { ptr, ptr } poison, ptr %a, 0
  %1 = insertvalue { ptr, ptr } %0, ptr %b, 1
  %2 = call i64 @sum-pair({ ptr, ptr } %1)
  %3 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %2)
  %4 = call i32 @vsum(<4 x i32> <i32 1, i32 2, i32 3, i32 4>)
  %5 = call i32 (ptr, ...) @printf(ptr @.str.3, i32 %4)
  %r = call double @mixed(ptr %s, i8 -2, i64 100000, float 2.500000e+00, i1 true)
  %6 = insertvalue { ptr, ptr } poison, ptr %a, 0
  %7 = insertvalue { ptr, ptr } %6, ptr %b, 1
  %q = call { ptr, ptr } @swap({ ptr, ptr } %7)
  %8 = extractvalue { ptr, ptr } %q, 1
  store i64 7, ptr %8, align 8
  %9 = extractvalue { ptr, ptr } %q, 0
  store i64 8, ptr %9, align 8
  %10 = load i64, ptr %a, align 8
  %11 = load i64, ptr %b, align 8
  %12 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %10, i64 %11)
  %13 = call i32 (ptr, ...) @printf(ptr @.str.5, i32 7, double 2.500000e+00, i32 120)
