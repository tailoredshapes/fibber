#### cases/lir/instr/linkage.lir
; ModuleID = 'cases/lir/instr/linkage.lir'
source_filename = "cases/lir/instr/linkage.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@counter = internal global i64 1
@tag = private constant i64 40
@exported = hidden global i64 0
@fp = global ptr @helper
@.str = private unnamed_addr constant [6 x i8] c"%lld\0A\00"

declare i32 @printf(ptr, ...)

define private i64 @helper(i64 %x) {
entry:
  %0 = load i64, ptr @tag, align 8
  %1 = add i64 %x, %0
  ret i64 %1
}

define internal tailcc i64 @twice(i64 %x) {
entry:
  %0 = mul i64 %x, 2
  ret i64 %0
}

define hidden i64 @visible() {
entry:
  %0 = load i64, ptr @counter, align 8
  %1 = call tailcc i64 @twice(i64 %0)
  ret i64 %1
}

define i32 @main() {
entry:
  %0 = load ptr, ptr @fp, align 8
  %1 = call i64 @visible()
  %2 = call i64 %0(i64 %1)
  store i64 %2, ptr @exported, align 8
  %3 = load i64, ptr @exported, align 8
  %4 = call i32 (ptr, ...) @printf(ptr @.str, i64 %3)
  ret i32 0
}
status 0
