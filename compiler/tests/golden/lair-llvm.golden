@.str.7 = private unnamed_addr constant [20 x i8] c"fptoui %d %d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define void @pr8({ i8, i1 } %r) {
entry:
  %0 = extractvalue { i8, i1 } %r, 0
  %1 = sext i8 %0 to i32
  %2 = extractvalue { i8, i1 } %r, 1
  %3 = zext i1 %2 to i32
  %4 = call i32 (ptr, ...) @printf(ptr @.str, i32 %1, i32 %3)
  ret void
}

define i32 @main() {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str.1)
  %1 = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 100, i8 27)
  call void @pr8({ i8, i1 } %1)
  %2 = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 127, i8 1)
  call void @pr8({ i8, i1 } %2)
  %3 = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 -1, i8 2)
