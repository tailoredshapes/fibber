#### cases/lir/instr/fcmp.lir
; ModuleID = 'cases/lir/instr/fcmp.lir'
source_filename = "cases/lir/instr/fcmp.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [102 x i8] c"%s oeq %d one %d olt %d ole %d ogt %d oge %d ord %d ueq %d une %d ult %d ule %d ugt %d uge %d uno %d\0A\00"
@.str.1 = private unnamed_addr constant [21 x i8] c"float olt %d oeq %d\0A\00"
@.str.2 = private unnamed_addr constant [4 x i8] c"nan\00"
@.str.3 = private unnamed_addr constant [4 x i8] c"num\00"

declare i32 @printf(ptr, ...)

define i32 @b(i1 %x) {
entry:
  %0 = zext i1 %x to i32
  ret i32 %0
}

define void @all(ptr %tag, double %x, double %y) {
entry:
  %0 = fcmp oeq double %x, %y
  %1 = call i32 @b(i1 %0)
  %2 = fcmp one double %x, %y
  %3 = call i32 @b(i1 %2)
  %4 = fcmp olt double %x, %y
  %5 = call i32 @b(i1 %4)
  %6 = fcmp ole double %x, %y
  %7 = call i32 @b(i1 %6)
  %8 = fcmp ogt double %x, %y
  %9 = call i32 @b(i1 %8)
  %10 = fcmp oge double %x, %y
  %11 = call i32 @b(i1 %10)
  %12 = fcmp ord double %x, %y
  %13 = call i32 @b(i1 %12)
  %14 = fcmp ueq double %x, %y
  %15 = call i32 @b(i1 %14)
  %16 = fcmp une double %x, %y
  %17 = call i32 @b(i1 %16)
  %18 = fcmp ult double %x, %y
  %19 = call i32 @b(i1 %18)
  %20 = fcmp ule double %x, %y
  %21 = call i32 @b(i1 %20)
  %22 = fcmp ugt double %x, %y
  %23 = call i32 @b(i1 %22)
  %24 = fcmp uge double %x, %y
  %25 = call i32 @b(i1 %24)
  %26 = fcmp uno double %x, %y
  %27 = call i32 @b(i1 %26)
  %28 = call i32 (ptr, ...) @printf(ptr @.str, ptr %tag, i32 %1, i32 %3, i32 %5, i32 %7, i32 %9, i32 %11, i32 %13, i32 %15, i32 %17, i32 %19, i32 %21, i32 %23, i32 %25, i32 %27)
  ret void
}

define void @fl(float %x, float %y) {
entry:
  %0 = fcmp olt float %x, %y
  %1 = call i32 @b(i1 %0)
  %2 = fcmp oeq float %y, %y
  %3 = call i32 @b(i1 %2)
  %4 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %1, i32 %3)
  ret void
}

define i32 @main() {
entry:
  call void @all(ptr @.str.2, double 1.000000e+00, double 0x7FF8000000000000)
  call void @all(ptr @.str.3, double 1.000000e+00, double 2.000000e+00)
  call void @fl(float 5.000000e-01, float 7.500000e-01)
  ret i32 0
}
status 0
#### cases/lir/instr/float-arith.lir
; ModuleID = 'cases/lir/instr/float-arith.lir'
source_filename = "cases/lir/instr/float-arith.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [10 x i8] c"%s %.17g\0A\00"
@.str.1 = private unnamed_addr constant [5 x i8] c"fadd\00"
@.str.2 = private unnamed_addr constant [5 x i8] c"fsub\00"
@.str.3 = private unnamed_addr constant [5 x i8] c"fmul\00"
@.str.4 = private unnamed_addr constant [5 x i8] c"fdiv\00"
@.str.5 = private unnamed_addr constant [5 x i8] c"frem\00"
@.str.6 = private unnamed_addr constant [5 x i8] c"fneg\00"
@.str.7 = private unnamed_addr constant [7 x i8] c"fadd.f\00"
@.str.8 = private unnamed_addr constant [7 x i8] c"fsub.f\00"
@.str.9 = private unnamed_addr constant [7 x i8] c"fmul.f\00"
@.str.10 = private unnamed_addr constant [7 x i8] c"fdiv.f\00"
@.str.11 = private unnamed_addr constant [7 x i8] c"frem.f\00"
@.str.12 = private unnamed_addr constant [7 x i8] c"fneg.f\00"
@.str.13 = private unnamed_addr constant [4 x i8] c"inf\00"
@.str.14 = private unnamed_addr constant [6 x i8] c"fneg0\00"

declare i32 @printf(ptr, ...)

define void @show(ptr %tag, double %v) {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str, ptr %tag, double %v)
  ret void
}

define void @opsd(double %a, double %b) {
entry:
  %0 = fadd double %a, %b
  call void @show(ptr @.str.1, double %0)
  %1 = fsub double %a, %b
  call void @show(ptr @.str.2, double %1)
  %2 = fmul double %a, %b
  call void @show(ptr @.str.3, double %2)
  %3 = fdiv double %a, %b
  call void @show(ptr @.str.4, double %3)
  %4 = frem double %a, %b
  call void @show(ptr @.str.5, double %4)
  %5 = fneg double %a
  call void @show(ptr @.str.6, double %5)
  ret void
}

define void @opsf(float %a, float %b) {
entry:
  %0 = fadd float %a, %b
  %1 = fpext float %0 to double
  call void @show(ptr @.str.7, double %1)
  %2 = fsub float %a, %b
  %3 = fpext float %2 to double
  call void @show(ptr @.str.8, double %3)
  %4 = fmul float %a, %b
  %5 = fpext float %4 to double
  call void @show(ptr @.str.9, double %5)
  %6 = fdiv float %a, %b
  %7 = fpext float %6 to double
  call void @show(ptr @.str.10, double %7)
  %8 = frem float %a, %b
  %9 = fpext float %8 to double
  call void @show(ptr @.str.11, double %9)
  %10 = fneg float %a
  %11 = fpext float %10 to double
  call void @show(ptr @.str.12, double %11)
  ret void
}

define double @div(double %a, double %b) {
entry:
  %0 = fdiv double %a, %b
  ret double %0
}

define i32 @main() {
entry:
  call void @opsd(double 7.500000e+00, double -2.000000e+00)
  call void @opsf(float 1.500000e+00, float 2.500000e-01)
  %0 = call double @div(double 1.000000e+00, double 0.000000e+00)
  call void @show(ptr @.str.13, double %0)
  %1 = call double @div(double 0.000000e+00, double 1.000000e+00)
  %2 = fneg double %1
  call void @show(ptr @.str.14, double %2)
  ret i32 0
}
status 0
#### cases/lir/instr/globals.lir
; ModuleID = 'cases/lir/instr/globals.lir'
source_filename = "cases/lir/instr/globals.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.vt = type { ptr, ptr }

@counter = global i64 5
@pi = constant double 3.141590e+00
@greeting = global ptr @.str
@handler = global ptr @inc
@vt.K = constant %struct.vt { ptr @one, ptr @two }
@self = global ptr @self
@v = constant <4 x i32> <i32 0, i32 10, i32 20, i32 0>
@tuple = constant { i64, ptr } { i64 9, ptr @.str.1 }
@.str = private unnamed_addr constant [13 x i8] c"hello, world\00"
@.str.1 = private unnamed_addr constant [3 x i8] c"hi\00"
@.str.2 = private unnamed_addr constant [19 x i8] c"counter %lld %lld\0A\00"
@.str.3 = private unnamed_addr constant [9 x i8] c"pi %.5f\0A\00"
@.str.4 = private unnamed_addr constant [13 x i8] c"greeting %s\0A\00"
@.str.5 = private unnamed_addr constant [12 x i8] c"fnptr %lld\0A\00"
@.str.6 = private unnamed_addr constant [18 x i8] c"vtable %lld %lld\0A\00"
@.str.7 = private unnamed_addr constant [9 x i8] c"self %d\0A\00"
@.str.8 = private unnamed_addr constant [8 x i8] c"vec %d\0A\00"
@.str.9 = private unnamed_addr constant [15 x i8] c"tuple %lld %s\0A\00"

declare i32 @printf(ptr, ...)

define i64 @inc(i64 %x) {
entry:
  %0 = add i64 %x, 1
  ret i64 %0
}

define i64 @one(i64 %x) {
entry:
  %0 = add i64 %x, 2
  ret i64 %0
}

define i64 @two(i64 %x) {
entry:
  %0 = mul i64 %x, 12
  ret i64 %0
}

define i32 @main() {
entry:
  %before = load i64, ptr @counter, align 8
  %0 = add i64 %before, 1
  store i64 %0, ptr @counter, align 8
  %1 = load i64, ptr @counter, align 8
  %2 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %before, i64 %1)
  %3 = load double, ptr @pi, align 8
  %4 = call i32 (ptr, ...) @printf(ptr @.str.3, double %3)
  %5 = load ptr, ptr @greeting, align 8
  %6 = call i32 (ptr, ...) @printf(ptr @.str.4, ptr %5)
  %7 = load ptr, ptr @handler, align 8
  %8 = call i64 %7(i64 42)
  %9 = call i32 (ptr, ...) @printf(ptr @.str.5, i64 %8)
  %m1 = load ptr, ptr @vt.K, align 8
  %m2 = load ptr, ptr getelementptr (%struct.vt, ptr @vt.K, i32 0, i32 1), align 8
  %10 = call i64 %m1(i64 1)
  %11 = call i64 %m2(i64 1)
  %12 = call i32 (ptr, ...) @printf(ptr @.str.6, i64 %10, i64 %11)
  %13 = load ptr, ptr @self, align 8
  %14 = icmp eq ptr %13, @self
  %15 = zext i1 %14 to i32
  %16 = call i32 (ptr, ...) @printf(ptr @.str.7, i32 %15)
  %vv = load <4 x i32>, ptr @v, align 16
  %17 = extractelement <4 x i32> %vv, i32 1
  %18 = extractelement <4 x i32> %vv, i32 2
  %19 = add i32 %17, %18
  %20 = call i32 (ptr, ...) @printf(ptr @.str.8, i32 %19)
  %t = load { i64, ptr }, ptr @tuple, align 8
  %21 = extractvalue { i64, ptr } %t, 0
  %22 = extractvalue { i64, ptr } %t, 1
  %23 = call i32 (ptr, ...) @printf(ptr @.str.9, i64 %21, ptr %22)
  ret i32 0
}
status 0
#### cases/lir/instr/icmp.lir
; ModuleID = 'cases/lir/instr/icmp.lir'
source_filename = "cases/lir/instr/icmp.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [69 x i8] c"eq %d ne %d slt %d sle %d sgt %d sge %d ult %d ule %d ugt %d uge %d\0A\00"
@.str.1 = private unnamed_addr constant [15 x i8] c"null %d %d %d\0A\00"
@.str.2 = private unnamed_addr constant [14 x i8] c"ptrord %d %d\0A\00"
@.str.3 = private unnamed_addr constant [17 x i8] c"vec %d %d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @b(i1 %x) {
entry:
  %0 = zext i1 %x to i32
  ret i32 %0
}

define void @ints(i32 %x, i32 %y) {
entry:
  %0 = icmp eq i32 %x, %y
  %1 = call i32 @b(i1 %0)
  %2 = icmp ne i32 %x, %y
  %3 = call i32 @b(i1 %2)
  %4 = icmp slt i32 %x, %y
  %5 = call i32 @b(i1 %4)
  %6 = icmp sle i32 %x, %y
  %7 = call i32 @b(i1 %6)
  %8 = icmp sgt i32 %x, %y
  %9 = call i32 @b(i1 %8)
  %10 = icmp sge i32 %x, %y
  %11 = call i32 @b(i1 %10)
  %12 = icmp ult i32 %x, %y
  %13 = call i32 @b(i1 %12)
  %14 = icmp ule i32 %x, %y
  %15 = call i32 @b(i1 %14)
  %16 = icmp ugt i32 %x, %y
  %17 = call i32 @b(i1 %16)
  %18 = icmp uge i32 %x, %y
  %19 = call i32 @b(i1 %18)
  %20 = call i32 (ptr, ...) @printf(ptr @.str, i32 %1, i32 %3, i32 %5, i32 %7, i32 %9, i32 %11, i32 %13, i32 %15, i32 %17, i32 %19)
  ret void
}

define void @ptrs(ptr %p, ptr %n) {
entry:
  %0 = icmp eq ptr %p, %n
  %1 = call i32 @b(i1 %0)
  %2 = icmp ne ptr %p, %n
  %3 = call i32 @b(i1 %2)
  %4 = icmp eq ptr %n, null
  %5 = call i32 @b(i1 %4)
  %6 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %1, i32 %3, i32 %5)
  %q = getelementptr i8, ptr %p, i64 1
  %7 = icmp ult ptr %p, %q
  %8 = call i32 @b(i1 %7)
  %9 = icmp ugt ptr %p, %q
  %10 = call i32 @b(i1 %9)
  %11 = call i32 (ptr, ...) @printf(ptr @.str.2, i32 %8, i32 %10)
  ret void
}

define i32 @main() {
entry:
  call void @ints(i32 -1, i32 1)
  %s = alloca i64, align 8
  call void @ptrs(ptr %s, ptr null)
  %0 = call i32 @b(i1 true)
  %1 = call i32 @b(i1 false)
  %2 = call i32 @b(i1 false)
  %3 = call i32 @b(i1 true)
  %4 = call i32 (ptr, ...) @printf(ptr @.str.3, i32 %0, i32 %1, i32 %2, i32 %3)
  ret i32 0
}
status 0
#### cases/lir/instr/int-arith.lir
; ModuleID = 'cases/lir/instr/int-arith.lir'
source_filename = "cases/lir/instr/int-arith.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [9 x i8] c"%s %lld\0A\00"
@.str.1 = private unnamed_addr constant [5 x i8] c"add8\00"
@.str.2 = private unnamed_addr constant [5 x i8] c"sub8\00"
@.str.3 = private unnamed_addr constant [5 x i8] c"mul8\00"
@.str.4 = private unnamed_addr constant [6 x i8] c"sdiv8\00"
@.str.5 = private unnamed_addr constant [6 x i8] c"udiv8\00"
@.str.6 = private unnamed_addr constant [6 x i8] c"srem8\00"
@.str.7 = private unnamed_addr constant [6 x i8] c"urem8\00"
@.str.8 = private unnamed_addr constant [6 x i8] c"add16\00"
@.str.9 = private unnamed_addr constant [6 x i8] c"mul16\00"
@.str.10 = private unnamed_addr constant [6 x i8] c"add32\00"
@.str.11 = private unnamed_addr constant [6 x i8] c"sub32\00"
@.str.12 = private unnamed_addr constant [6 x i8] c"add64\00"
@.str.13 = private unnamed_addr constant [6 x i8] c"sub64\00"
@.str.14 = private unnamed_addr constant [6 x i8] c"mul64\00"
@.str.15 = private unnamed_addr constant [7 x i8] c"sdiv64\00"
@.str.16 = private unnamed_addr constant [7 x i8] c"udiv64\00"
@.str.17 = private unnamed_addr constant [7 x i8] c"srem64\00"
@.str.18 = private unnamed_addr constant [7 x i8] c"urem64\00"

declare i32 @printf(ptr, ...)

define void @show(ptr %tag, i64 %v) {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str, ptr %tag, i64 %v)
  ret void
}

define void @ops8(i8 %a, i8 %b) {
entry:
  %0 = add i8 %a, %b
  %1 = sext i8 %0 to i64
  call void @show(ptr @.str.1, i64 %1)
  %2 = sub i8 %a, %b
  %3 = sext i8 %2 to i64
  call void @show(ptr @.str.2, i64 %3)
  %4 = mul i8 %a, %b
  %5 = sext i8 %4 to i64
  call void @show(ptr @.str.3, i64 %5)
  %6 = sdiv i8 %a, %b
  %7 = sext i8 %6 to i64
  call void @show(ptr @.str.4, i64 %7)
  %8 = udiv i8 %a, %b
  %9 = zext i8 %8 to i64
  call void @show(ptr @.str.5, i64 %9)
  %10 = srem i8 %a, %b
  %11 = sext i8 %10 to i64
  call void @show(ptr @.str.6, i64 %11)
  %12 = urem i8 %a, %b
  %13 = zext i8 %12 to i64
  call void @show(ptr @.str.7, i64 %13)
  ret void
}

define void @ops16(i16 %a, i16 %b) {
entry:
  %0 = add i16 %a, %b
  %1 = sext i16 %0 to i64
  call void @show(ptr @.str.8, i64 %1)
  %2 = mul i16 %a, %b
  %3 = sext i16 %2 to i64
  call void @show(ptr @.str.9, i64 %3)
  ret void
}

define void @ops32(i32 %a, i32 %b) {
entry:
  %0 = add i32 %a, %b
  %1 = sext i32 %0 to i64
  call void @show(ptr @.str.10, i64 %1)
  %2 = sub i32 %a, %b
  %3 = sext i32 %2 to i64
  call void @show(ptr @.str.11, i64 %3)
  ret void
}

define void @ops64(i64 %a, i64 %b) {
entry:
  %0 = add i64 %a, %b
  call void @show(ptr @.str.12, i64 %0)
  %1 = sub i64 %a, %b
  call void @show(ptr @.str.13, i64 %1)
  %2 = mul i64 %a, %b
  call void @show(ptr @.str.14, i64 %2)
  %3 = sdiv i64 %a, %b
  call void @show(ptr @.str.15, i64 %3)
  %4 = udiv i64 %a, %b
  call void @show(ptr @.str.16, i64 %4)
  %5 = srem i64 %a, %b
  call void @show(ptr @.str.17, i64 %5)
  %6 = urem i64 %a, %b
  call void @show(ptr @.str.18, i64 %6)
  ret void
}

define i32 @main() {
entry:
  call void @ops8(i8 -100, i8 7)
  call void @ops16(i16 300, i16 300)
  call void @ops32(i32 2147483647, i32 1)
  call void @ops64(i64 1000000007, i64 -13)
  ret i32 0
}
status 0
