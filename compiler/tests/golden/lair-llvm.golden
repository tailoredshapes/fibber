#### cases/lir/mapping/trap.lir
; ModuleID = 'cases/lir/mapping/trap.lir'
source_filename = "cases/lir/mapping/trap.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [29 x i8] c"integer overflow in + at 64\0A\00"
@.str.1 = private unnamed_addr constant [10 x i8] c"sum %lld\0A\00"
@.str.2 = private unnamed_addr constant [12 x i8] c"never %lld\0A\00"

declare i64 @write(i32, ptr, i64)

declare i64 @strlen(ptr)

declare i32 @fflush(ptr)

declare void @abort()

declare i32 @printf(ptr, ...)

define void @fib.trap(ptr %msg) {
entry:
  %0 = call i32 @fflush(ptr null)
  %1 = call i64 @strlen(ptr %msg)
  %2 = call i64 @write(i32 2, ptr %msg, i64 %1)
  call void @abort()
  unreachable
}

define i64 @checked-add(i64 %a, i64 %b) {
entry:
  %r = add i64 %a, %b
  %0 = xor i64 %a, %r
  %1 = xor i64 %b, %r
  %2 = and i64 %0, %1
  %3 = icmp slt i64 %2, 0
  br i1 %3, label %bad, label %ok

bad:                                              ; preds = %entry
  call void @fib.trap(ptr @.str)
  unreachable

ok:                                               ; preds = %entry
  ret i64 %r
}

define i32 @main() {
entry:
  %0 = call i64 @checked-add(i64 1, i64 2)
  %1 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %0)
  %2 = call i64 @checked-add(i64 9223372036854775807, i64 1)
  %3 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %2)
  ret i32 0
}
status 0
#### cases/lir/mapping/weak-upgrade.lir
; ModuleID = 'cases/lir/mapping/weak-upgrade.lir'
source_filename = "cases/lir/mapping/weak-upgrade.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [20 x i8] c"upgrade %d %d %lld\0A\00"

declare i32 @printf(ptr, ...)

define i1 @retain-if-live(ptr %cp) {
entry:
  br label %top

top:                                              ; preds = %try, %entry
  %c = load atomic i64, ptr %cp monotonic, align 8
  %0 = icmp eq i64 %c, 0
  br i1 %0, label %dead, label %try

try:                                              ; preds = %top
  %1 = add i64 %c, 1
  %r = cmpxchg weak ptr %cp, i64 %c, i64 %1 acq_rel monotonic, align 8
  %2 = extractvalue { i64, i1 } %r, 1
  br i1 %2, label %live, label %top

dead:                                             ; preds = %top
  ret i1 false

live:                                             ; preds = %try
  ret i1 true
}

define i32 @main() {
entry:
  %a = alloca i64, align 8
  %b = alloca i64, align 8
  store i64 0, ptr %a, align 8
  store i64 3, ptr %b, align 8
  %0 = call i1 @retain-if-live(ptr %a)
  %1 = zext i1 %0 to i32
  %2 = call i1 @retain-if-live(ptr %b)
  %3 = zext i1 %2 to i32
  %4 = load i64, ptr %b, align 8
  %5 = call i32 (ptr, ...) @printf(ptr @.str, i32 %1, i32 %3, i64 %4)
  ret i32 0
}
status 0
