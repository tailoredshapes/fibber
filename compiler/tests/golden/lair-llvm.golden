  %21 = extractelement <4 x i32> %v, i32 0
  %22 = extractelement <4 x i32> %v, i32 1
  %23 = extractelement <4 x i32> %v, i32 2
  %24 = extractelement <4 x i32> %v, i32 3
  %25 = call i32 (ptr, ...) @printf(ptr @.str.12, i32 %21, i32 %22, i32 %23, i32 %24)
