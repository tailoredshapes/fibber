#### cases/lir/mapping/closure.lir
; ModuleID = 'cases/lir/mapping/closure.lir'
source_filename = "cases/lir/mapping/closure.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.fib.closure.adder = type { i64, i32, i32, ptr, i64 }
%struct.fib.closure.scale = type { i64, i32, i32, ptr, double }
%struct.fib.closure.loop = type { i64, i32, i32, ptr }

@.str = private unnamed_addr constant [12 x i8] c"adder %lld\0A\00"
@.str.1 = private unnamed_addr constant [19 x i8] c"scale %.17g %.17g\0A\00"
@.str.2 = private unnamed_addr constant [10 x i8] c"cps %lld\0A\00"

declare ptr @malloc(i64)

declare i32 @printf(ptr, ...)

define i64 @adder.code(ptr %env, i64 %x) {
entry:
  %0 = getelementptr %struct.fib.closure.adder, ptr %env, i32 0, i32 4
  %1 = load i64, ptr %0, align 8
  %2 = add i64 %x, %1
  ret i64 %2
}

define double @scale.code(ptr %env, double %x, i8 %sign) {
entry:
  %0 = getelementptr %struct.fib.closure.scale, ptr %env, i32 0, i32 4
  %k = load double, ptr %0, align 8
  %v = fmul double %x, %k
  %1 = icmp slt i8 %sign, 0
  %2 = fneg double %v
  %3 = select i1 %1, double %2, double %v
  ret double %3
}

define tailcc i64 @loop.code(ptr %env, i64 %n, i64 %acc) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %done, label %more

done:                                             ; preds = %entry
  ret i64 %acc

more:                                             ; preds = %entry
  %1 = getelementptr %struct.fib.closure.loop, ptr %env, i32 0, i32 3
  %code = load ptr, ptr %1, align 8
  %2 = sub i64 %n, 1
  %3 = add i64 %acc, 1
  %4 = musttail call tailcc i64 %code(ptr %env, i64 %2, i64 %3)
  ret i64 %4
}

define ptr @mk(i64 %size, ptr %code) {
entry:
  %c = call ptr @malloc(i64 %size)
  store i64 1, ptr %c, align 8
  %0 = getelementptr %struct.fib.closure.loop, ptr %c, i32 0, i32 3
  store ptr %code, ptr %0, align 8
  ret ptr %c
}

define tailcc i64 @run-loop(ptr %f, i64 %n) {
entry:
  %0 = getelementptr %struct.fib.closure.loop, ptr %f, i32 0, i32 3
  %1 = load ptr, ptr %0, align 8
  %2 = musttail call tailcc i64 %1(ptr %f, i64 %n, i64 0)
  ret i64 %2
}

define i32 @main() {
entry:
  %f = call ptr @mk(i64 40, ptr @adder.code)
  %g = call ptr @mk(i64 40, ptr @scale.code)
  %h = call ptr @mk(i64 32, ptr @loop.code)
  %0 = getelementptr %struct.fib.closure.adder, ptr %f, i32 0, i32 4
  store i64 7, ptr %0, align 8
  %1 = getelementptr %struct.fib.closure.scale, ptr %g, i32 0, i32 4
  store double 2.500000e+00, ptr %1, align 8
  %2 = getelementptr %struct.fib.closure.adder, ptr %f, i32 0, i32 3
  %3 = load ptr, ptr %2, align 8
  %4 = call i64 %3(ptr %f, i64 5)
  %5 = call i32 (ptr, ...) @printf(ptr @.str, i64 %4)
  %6 = getelementptr %struct.fib.closure.scale, ptr %g, i32 0, i32 3
  %gc = load ptr, ptr %6, align 8
  %7 = call double %gc(ptr %g, double 3.000000e+00, i8 1)
  %8 = call double %gc(ptr %g, double 1.200000e+00, i8 -1)
  %9 = call i32 (ptr, ...) @printf(ptr @.str.1, double %7, double %8)
  %10 = call tailcc i64 @run-loop(ptr %h, i64 1000000)
  %11 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %10)
  ret i32 0
}
