@.str = private unnamed_addr constant [50 x i8] c"pair %lld dyn %lld arr %lld vec %lld nested %lld\0A\00"

declare i32 @printf(ptr, ...)

define tailcc { i64, i64 } @pair() {
entry:
  ret { i64, i64 } { i64 1, i64 2 }
}

define tailcc { i64, i64 } @pair-tail() {
entry:
  %0 = musttail call tailcc { i64, i64 } @pair()
  ret { i64, i64 } %0
}

define tailcc %struct.dyn @dyn() {
entry:
  ret %struct.dyn { ptr null, ptr @printf }
}

define tailcc %struct.dyn @dyn-tail() {
entry:
  %0 = musttail call tailcc %struct.dyn @dyn()
  ret %struct.dyn %0
}

define tailcc [2 x i64] @arr() {
entry:
  ret [2 x i64] [i64 3, i64 4]
}

define tailcc [2 x i64] @arr-tail() {
entry:
  %0 = musttail call tailcc [2 x i64] @arr()
  ret [2 x i64] %0
}

define tailcc <8 x i64> @vec() {
entry:
  ret <8 x i64> <i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 8>
}

define tailcc <8 x i64> @vec-tail() {
entry:
  %0 = musttail call tailcc <8 x i64> @vec()
  ret <8 x i64> %0
}

define tailcc %struct.nested @nest() {
entry:
  ret %struct.nested { { i64 } { i64 3 }, [1 x i64] [i64 9] }
}

define tailcc %struct.nested @nest-tail() {
entry:
  %0 = musttail call tailcc %struct.nested @nest()
  ret %struct.nested %0
}

define i32 @main() {
entry:
  %0 = call tailcc { i64, i64 } @pair-tail()
  %1 = extractvalue { i64, i64 } %0, 1
  %2 = call tailcc %struct.dyn @dyn-tail()
  %3 = extractvalue %struct.dyn %2, 1
  %4 = icmp eq ptr %3, @printf
  %5 = zext i1 %4 to i64
  %6 = call tailcc [2 x i64] @arr-tail()
  %7 = extractvalue [2 x i64] %6, 1
  %8 = call tailcc <8 x i64> @vec-tail()
  %9 = extractelement <8 x i64> %8, i32 7
  %10 = call tailcc %struct.nested @nest-tail()
  %11 = extractvalue %struct.nested %10, 0
  %12 = extractvalue { i64 } %11, 0
  %13 = call i32 (ptr, ...) @printf(ptr @.str, i64 %1, i64 %5, i64 %7, i64 %9, i64 %12)
  ret i32 42
}
