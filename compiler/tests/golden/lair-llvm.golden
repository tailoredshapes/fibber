@.str = private unnamed_addr constant [114 x i8] c"xchg %lld add %lld sub %lld and %lld nand %lld or %lld xor %lld max %lld min %lld umax %lld umin %lld final %lld\0A\00"
@.str.1 = private unnamed_addr constant [57 x i8] c"fadd %.17g fsub %.17g fmax %.17g fmin %.17g final %.17g\0A\00"
@.str.2 = private unnamed_addr constant [30 x i8] c"pxchg %d fail %d %d ok %d %d\0A\00"
@.str.3 = private unnamed_addr constant [20 x i8] c"cx %lld %d %lld %d\0A\00"
@.str.4 = private unnamed_addr constant [11 x i8] c"weak %lld\0A\00"
@.str.5 = private unnamed_addr constant [39 x i8] c"loads %lld %lld %lld %lld stores %lld\0A\00"
@.str.6 = private unnamed_addr constant [9 x i8] c"st %lld\0A\00"

declare i32 @printf(ptr, ...)

define void @ints(ptr %p) {
entry:
  store i64 10, ptr %p, align 8
  %0 = atomicrmw xchg ptr %p, i64 20 seq_cst, align 8
  %1 = atomicrmw add ptr %p, i64 5 seq_cst, align 8
  %2 = atomicrmw sub ptr %p, i64 3 acq_rel, align 8
  %3 = atomicrmw and ptr %p, i64 15 release, align 8
  %4 = atomicrmw nand ptr %p, i64 3 acquire, align 8
  %5 = atomicrmw or ptr %p, i64 8 monotonic, align 8
  %6 = atomicrmw xor ptr %p, i64 1 seq_cst, align 8
  %7 = atomicrmw max ptr %p, i64 7 seq_cst, align 8
  %8 = atomicrmw min ptr %p, i64 -9 seq_cst, align 8
  %9 = atomicrmw umax ptr %p, i64 5 seq_cst, align 8
  %10 = atomicrmw umin ptr %p, i64 5 seq_cst, align 8
  %11 = load i64, ptr %p, align 8
  %12 = call i32 (ptr, ...) @printf(ptr @.str, i64 %0, i64 %1, i64 %2, i64 %3, i64 %4, i64 %5, i64 %6, i64 %7, i64 %8, i64 %9, i64 %10, i64 %11)
  ret void
}

define void @floats(ptr %q) {
entry:
  store double 1.500000e+00, ptr %q, align 8
  %0 = atomicrmw fadd ptr %q, double 2.000000e+00 seq_cst, align 8
  %1 = atomicrmw fsub ptr %q, double 5.000000e-01 seq_cst, align 8
  %2 = atomicrmw fmax ptr %q, double 1.000000e+01 seq_cst, align 8
  %3 = atomicrmw fmin ptr %q, double -1.000000e+00 seq_cst, align 8
  %4 = load double, ptr %q, align 8
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1, double %0, double %1, double %2, double %3, double %4)
  ret void
}

define void @ptrs(ptr %r, ptr %p) {
entry:
  store ptr null, ptr %r, align 8
  %old = atomicrmw xchg ptr %r, ptr %p seq_cst, align 8
  %f = cmpxchg ptr %r, ptr null, ptr %p seq_cst seq_cst, align 8
  %s = cmpxchg ptr %r, ptr %p, ptr null seq_cst seq_cst, align 8
  %0 = icmp eq ptr %old, null
  %1 = zext i1 %0 to i32
  %2 = extractvalue { ptr, i1 } %f, 0
  %3 = icmp eq ptr %2, %p
  %4 = zext i1 %3 to i32
  %5 = extractvalue { ptr, i1 } %f, 1
  %6 = zext i1 %5 to i32
  %7 = extractvalue { ptr, i1 } %s, 1
  %8 = zext i1 %7 to i32
  %9 = load ptr, ptr %r, align 8
  %10 = icmp eq ptr %9, null
  %11 = zext i1 %10 to i32
  %12 = call i32 (ptr, ...) @printf(ptr @.str.2, i32 %1, i32 %4, i32 %6, i32 %8, i32 %11)
  ret void
}

define void @cx(ptr %p) {
entry:
  %a = cmpxchg ptr %p, i64 5, i64 6 acq_rel acquire, align 8
  %b = cmpxchg ptr %p, i64 5, i64 9 monotonic monotonic, align 8
  %0 = extractvalue { i64, i1 } %a, 0
  %1 = extractvalue { i64, i1 } %a, 1
  %2 = zext i1 %1 to i32
  %3 = extractvalue { i64, i1 } %b, 0
  %4 = extractvalue { i64, i1 } %b, 1
  %5 = zext i1 %4 to i32
  %6 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %0, i32 %2, i64 %3, i32 %5)
  br label %retry

retry:                                            ; preds = %retry, %entry
  %w = cmpxchg weak ptr %p, i64 6, i64 7 seq_cst monotonic, align 8
  %7 = extractvalue { i64, i1 } %w, 1
  br i1 %7, label %done, label %retry

done:                                             ; preds = %retry
  %8 = load i64, ptr %p, align 8
  %9 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %8)
  ret void
}

define void @orders(ptr %p) {
entry:
  %a = load atomic i64, ptr %p unordered, align 8
  %b = load atomic i64, ptr %p monotonic, align 8
  %c = load atomic i64, ptr %p acquire, align 8
  %d = load atomic i64, ptr %p seq_cst, align 8
  store atomic i64 1, ptr %p unordered, align 8
  store atomic i64 2, ptr %p monotonic, align 8
  store atomic i64 3, ptr %p release, align 8
  store atomic i64 4, ptr %p seq_cst, align 8
  %0 = load i64, ptr %p, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @.str.5, i64 %a, i64 %b, i64 %c, i64 %d, i64 %0)
  store atomic i64 8, ptr %p syncscope("singlethread") seq_cst, align 8
  fence syncscope("singlethread") seq_cst
  %2 = load atomic i64, ptr %p syncscope("singlethread") acquire, align 8
  %3 = call i32 (ptr, ...) @printf(ptr @.str.6, i64 %2)
  ret void
}

define i32 @main() {
entry:
  %p = alloca i64, align 8
  %q = alloca double, align 8
  %r = alloca ptr, align 8
  call void @ints(ptr %p)
  call void @floats(ptr %q)
  call void @ptrs(ptr %r, ptr %p)
  call void @cx(ptr %p)
  call void @orders(ptr %p)
  ret i32 0
}
status 0
