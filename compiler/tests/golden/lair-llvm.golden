@.str = private unnamed_addr constant [16 x i8] c"show %lld %lld\0A\00"
@.str.1 = private unnamed_addr constant [16 x i8] c"size %lld %lld\0A\00"
@.str.2 = private unnamed_addr constant [10 x i8] c"phi %lld\0A\00"
@.str.3 = private unnamed_addr constant [13 x i8] c"select %lld\0A\00"
@.str.4 = private unnamed_addr constant [16 x i8] c"cell %lld %lld\0A\00"
@.str.5 = private unnamed_addr constant [11 x i8] c"swap %lld\0A\00"

declare i32 @printf(ptr, ...)

define i64 @Int.show(ptr %self) {
entry:
  %0 = getelementptr %struct.Int.obj, ptr %self, i32 0, i32 3
  %1 = load i64, ptr %0, align 8
  ret i64 %1
}

define i64 @Int.size(ptr %self) {
entry:
  ret i64 8
}

define i64 @Pair.show(ptr %self) {
entry:
  %0 = getelementptr %struct.Pair.obj, ptr %self, i32 0, i32 3
  %1 = load i64, ptr %0, align 8
  %2 = mul i64 %1, 100
  %3 = getelementptr %struct.Pair.obj, ptr %self, i32 0, i32 4
  %4 = load i64, ptr %3, align 8
  %5 = add i64 %2, %4
  ret i64 %5
}

define i64 @Pair.size(ptr %self) {
entry:
  ret i64 16
}

define ptr @method({ ptr, ptr } %d, i64 %slot) {
entry:
  %0 = extractvalue { ptr, ptr } %d, 1
  %1 = getelementptr ptr, ptr %0, i64 %slot
  %2 = load ptr, ptr %1, align 8
  ret ptr %2
}

define i64 @show({ ptr, ptr } %d) {
entry:
  %0 = call ptr @method({ ptr, ptr } %d, i64 0)
  %1 = extractvalue { ptr, ptr } %d, 0
  %2 = call i64 %0(ptr %1)
  ret i64 %2
}

define i64 @size({ ptr, ptr } %d) {
entry:
  %0 = call ptr @method({ ptr, ptr } %d, i64 1)
  %1 = extractvalue { ptr, ptr } %d, 0
  %2 = call i64 %0(ptr %1)
  ret i64 %2
}

define { ptr, ptr } @pick(i1 %c, { ptr, ptr } %a, { ptr, ptr } %b) {
entry:
  br i1 %c, label %l, label %r

l:                                                ; preds = %entry
  br label %j

r:                                                ; preds = %entry
  br label %j

j:                                                ; preds = %l, %r
  %0 = phi { ptr, ptr } [ %a, %l ], [ %b, %r ]
  ret { ptr, ptr } %0
}

define { ptr, ptr } @swap-obj({ ptr, ptr } %d, ptr %other) {
entry:
  %0 = extractvalue { ptr, ptr } %d, 0
  %1 = insertvalue { ptr, ptr } %d, ptr %other, 0
  ret { ptr, ptr } %1
}

define i32 @main() {
entry:
  %i = alloca %struct.Int.obj, align 8
  %p = alloca %struct.Pair.obj, align 8
  %cell = alloca %struct.fib.cell.dyn, align 8
  %0 = getelementptr %struct.Int.obj, ptr %i, i32 0, i32 3
  store i64 42, ptr %0, align 8
  %1 = getelementptr %struct.Pair.obj, ptr %p, i32 0, i32 3
  store i64 1, ptr %1, align 8
  %2 = getelementptr %struct.Pair.obj, ptr %p, i32 0, i32 4
  store i64 7, ptr %2, align 8
  %3 = insertvalue { ptr, ptr } poison, ptr %i, 0
  %di = insertvalue { ptr, ptr } %3, ptr @Show.vt.Int, 1
  %4 = insertvalue { ptr, ptr } poison, ptr %p, 0
  %dp = insertvalue { ptr, ptr } %4, ptr @Show.vt.Pair, 1
  %5 = call i64 @show({ ptr, ptr } %di)
  %6 = call i64 @show({ ptr, ptr } %dp)
  %7 = call i32 (ptr, ...) @printf(ptr @.str, i64 %5, i64 %6)
  %8 = call i64 @size({ ptr, ptr } %di)
  %9 = call i64 @size({ ptr, ptr } %dp)
  %10 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %8, i64 %9)
  %11 = call { ptr, ptr } @pick(i1 false, { ptr, ptr } %di, { ptr, ptr } %dp)
  %12 = call i64 @show({ ptr, ptr } %11)
  %13 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %12)
  %14 = select i1 true, { ptr, ptr } %di, { ptr, ptr } %dp
  %15 = call i64 @show({ ptr, ptr } %14)
  %16 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %15)
  %17 = extractvalue { ptr, ptr } %di, 0
  %18 = getelementptr %struct.fib.cell.dyn, ptr %cell, i32 0, i32 3
  store ptr %17, ptr %18, align 8
  %19 = extractvalue { ptr, ptr } %di, 1
  %20 = getelementptr %struct.fib.cell.dyn, ptr %cell, i32 0, i32 4
  store ptr %19, ptr %20, align 8
  %21 = getelementptr %struct.fib.cell.dyn, ptr %cell, i32 0, i32 3
  %back = load { ptr, ptr }, ptr %21, align 8
  %22 = call i64 @show({ ptr, ptr } %back)
  %23 = call i64 @size({ ptr, ptr } %back)
  %24 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %22, i64 %23)
  %25 = call { ptr, ptr } @swap-obj({ ptr, ptr } %dp, ptr %p)
  %26 = call i64 @show({ ptr, ptr } %25)
  %27 = call i32 (ptr, ...) @printf(ptr @.str.5, i64 %26)
  ret i32 0
}
status 0
#### cases/lir/mapping/header-counts.lir
; ModuleID = 'cases/lir/mapping/header-counts.lir'
source_filename = "cases/lir/mapping/header-counts.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.fib.hdr = type { i64, i32, i32 }
%struct.fib.typerec = type { ptr, ptr, ptr, i64 }
%struct.P.obj = type { i64, i32, i32, i64, ptr }

@fib.types = global ptr null
@freed = global i64 0
@.str = private unnamed_addr constant [12 x i8] c"count %lld\0A\00"
@.str.1 = private unnamed_addr constant [12 x i8] c"count %lld\0A\00"
@.str.2 = private unnamed_addr constant [19 x i8] c"shared count %lld\0A\00"
@.str.3 = private unnamed_addr constant [12 x i8] c"freed %lld\0A\00"
@.str.4 = private unnamed_addr constant [20 x i8] c"immortal %lld %lld\0A\00"

declare ptr @malloc(i64)

declare void @free(ptr)

declare i32 @printf(ptr, ...)

define ptr @fib.alloc(i64 %size, i32 %tid) {
entry:
  %p = call ptr @malloc(i64 %size)
  %0 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 0
  store i64 1, ptr %0, align 8
  %1 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 1
  store i32 %tid, ptr %1, align 4
  %2 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 2
  store i32 0, ptr %2, align 4
  ret ptr %p
}

define i32 @flags(ptr %p) {
entry:
  %0 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 2
  %1 = load atomic i32, ptr %0 monotonic, align 4
  ret i32 %1
}

define i64 @count(ptr %p) {
entry:
  %0 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 0
  %1 = load i64, ptr %0, align 8
  ret i64 %1
}

define void @fib.retain(ptr %p) {
entry:
  %0 = icmp eq ptr %p, null
  br i1 %0, label %done, label %check

check:                                            ; preds = %entry
  %f = call i32 @flags(ptr %p)
  %1 = and i32 %f, 12
  %2 = icmp ne i32 %1, 0
  br i1 %2, label %done, label %counted

counted:                                          ; preds = %check
  %cp = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 0
  %3 = and i32 %f, 1
  %4 = icmp ne i32 %3, 0
  br i1 %4, label %shared, label %local

shared:                                           ; preds = %counted
  %5 = atomicrmw add ptr %cp, i64 1 monotonic, align 8
  br label %done

local:                                            ; preds = %counted
  %6 = load i64, ptr %cp, align 8
  %7 = add i64 %6, 1
  store i64 %7, ptr %cp, align 8
  br label %done

done:                                             ; preds = %shared, %local, %check, %entry
  ret void
}

define void @fib.drop(ptr %p) {
entry:
  %0 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 1
  %tid = load i32, ptr %0, align 4
  %1 = load ptr, ptr @fib.types, align 8
  %rec = getelementptr %struct.fib.typerec, ptr %1, i32 %tid, i32 0
  %2 = load ptr, ptr %rec, align 8
  call void %2(ptr %p)
  call void @free(ptr %p)
  %3 = load i64, ptr @freed, align 8
  %4 = add i64 %3, 1
  store i64 %4, ptr @freed, align 8
  ret void
}

define void @fib.release(ptr %p) {
entry:
  %0 = icmp eq ptr %p, null
  br i1 %0, label %done, label %check

check:                                            ; preds = %entry
  %f = call i32 @flags(ptr %p)
  %1 = and i32 %f, 12
  %2 = icmp ne i32 %1, 0
  br i1 %2, label %done, label %counted

counted:                                          ; preds = %check
  %cp = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 0
  %3 = and i32 %f, 1
  %4 = icmp ne i32 %3, 0
  br i1 %4, label %shared, label %local

shared:                                           ; preds = %counted
  %old = atomicrmw sub ptr %cp, i64 1 acq_rel, align 8
  %5 = icmp eq i64 %old, 1
  br i1 %5, label %drop, label %done

local:                                            ; preds = %counted
  %c = load i64, ptr %cp, align 8
  %6 = icmp eq i64 %c, 1
  br i1 %6, label %drop, label %dec

dec:                                              ; preds = %local
  %7 = sub i64 %c, 1
  store i64 %7, ptr %cp, align 8
  br label %done

drop:                                             ; preds = %shared, %local
  call void @fib.drop(ptr %p)
  br label %done

done:                                             ; preds = %drop, %shared, %dec, %check, %entry
  ret void
}

define void @drop.leaf(ptr %p) {
entry:
  ret void
}

define void @drop.P(ptr %p) {
entry:
  %0 = getelementptr %struct.P.obj, ptr %p, i32 0, i32 4
  %1 = load ptr, ptr %0, align 8
  call void @fib.release(ptr %1)
  ret void
}

define void @fib.init() {
entry:
  %tbl = call ptr @malloc(i64 64)
  %0 = getelementptr %struct.fib.typerec, ptr %tbl, i32 0, i32 0
  store ptr @drop.leaf, ptr %0, align 8
  %1 = getelementptr %struct.fib.typerec, ptr %tbl, i32 1, i32 0
  store ptr @drop.P, ptr %1, align 8
  store ptr %tbl, ptr @fib.types, align 8
  ret void
}

define void @share(ptr %p) {
entry:
  %0 = getelementptr %struct.fib.hdr, ptr %p, i32 0, i32 2
  %1 = atomicrmw or ptr %0, i32 1 monotonic, align 4
  ret void
}

define i32 @main() {
entry:
  call void @fib.init()
  %leaf = call ptr @fib.alloc(i64 16, i32 0)
  %obj = call ptr @fib.alloc(i64 40, i32 1)
  %0 = getelementptr %struct.P.obj, ptr %obj, i32 0, i32 3
  store i64 7, ptr %0, align 8
  %1 = getelementptr %struct.P.obj, ptr %obj, i32 0, i32 4
  store ptr %leaf, ptr %1, align 8
  call void @fib.retain(ptr null)
  call void @fib.retain(ptr %obj)
  %2 = call i64 @count(ptr %obj)
  %3 = call i32 (ptr, ...) @printf(ptr @.str, i64 %2)
  call void @fib.release(ptr %obj)
  %4 = call i64 @count(ptr %obj)
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %4)
  call void @share(ptr %obj)
  call void @share(ptr %leaf)
  call void @fib.retain(ptr %obj)
  %6 = call i64 @count(ptr %obj)
  %7 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %6)
  call void @fib.release(ptr %obj)
  call void @fib.release(ptr %obj)
  call void @fib.release(ptr null)
  %8 = load i64, ptr @freed, align 8
  %9 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %8)
  %imm = call ptr @fib.alloc(i64 16, i32 0)
  %10 = getelementptr %struct.fib.hdr, ptr %imm, i32 0, i32 0
  store i64 0, ptr %10, align 8
  %11 = getelementptr %struct.fib.hdr, ptr %imm, i32 0, i32 2
  %12 = atomicrmw or ptr %11, i32 8 monotonic, align 4
  call void @fib.retain(ptr %imm)
  call void @fib.release(ptr %imm)
  call void @fib.release(ptr %imm)
  %13 = call i64 @count(ptr %imm)
  %14 = load i64, ptr @freed, align 8
  %15 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %13, i64 %14)
  ret i32 0
}
status 0
#### cases/lir/mapping/stack-object.lir
; ModuleID = 'cases/lir/mapping/stack-object.lir'
source_filename = "cases/lir/mapping/stack-object.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.fib.cell.i64 = type { i64, i32, i32, i64 }

@.str = private unnamed_addr constant [8 x i8] c"v %lld\0A\00"
@.str.1 = private unnamed_addr constant [16 x i8] c"header %lld %d\0A\00"

declare i32 @printf(ptr, ...)

define void @bump(ptr %cell) {
entry:
  %vp = getelementptr %struct.fib.cell.i64, ptr %cell, i32 0, i32 3
  %0 = load i64, ptr %vp, align 8
  %1 = add i64 %0, 2
  store i64 %1, ptr %vp, align 8
  ret void
}

define i32 @main() {
entry:
  %t = alloca i64, i32 4, align 8
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %v = phi i64 [ 0, %entry ], [ %v2, %loop ]
  %0 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 0
  store i64 0, ptr %0, align 8
  %1 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 1
  store i32 5, ptr %1, align 4
  %2 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 2
  store i32 4, ptr %2, align 4
  %3 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 3
  store i64 %v, ptr %3, align 8
  call void @bump(ptr %t)
  %4 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 3
  %v2 = load i64, ptr %4, align 8
  %i2 = add i64 %i, 1
  %5 = icmp slt i64 %i2, 1000000
  br i1 %5, label %loop, label %out

out:                                              ; preds = %loop
  %6 = call i32 (ptr, ...) @printf(ptr @.str, i64 %v2)
  %7 = load i64, ptr %t, align 8
  %8 = getelementptr %struct.fib.cell.i64, ptr %t, i32 0, i32 2
  %9 = load i32, ptr %8, align 4
  %10 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %7, i32 %9)
  ret i32 0
}
status 0
#### cases/lir/mapping/string-object.lir
; ModuleID = 'cases/lir/mapping/string-object.lir'
source_filename = "cases/lir/mapping/string-object.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.fib.str = type { i64, i32, i32, i64 }

@lit.0 = global ptr null
@.str = private unnamed_addr constant [6 x i8] c"hello\00"
@.str.1 = private unnamed_addr constant [30 x i8] c"len %lld count %lld flags %d\0A\00"

declare ptr @malloc(i64)

declare ptr @memcpy(ptr, ptr, i64)

declare i32 @puts(ptr)

declare i32 @printf(ptr, ...)

define void @fib.init() {
entry:
  %s = call ptr @malloc(i64 add (i64 ptrtoint (ptr getelementptr (%struct.fib.str, ptr null, i32 1) to i64), i64 6))
  %0 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 0
  store i64 0, ptr %0, align 8
  %1 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 1
  store i32 3, ptr %1, align 4
  %2 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 2
  store i32 8, ptr %2, align 4
  %3 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 3
  store i64 5, ptr %3, align 8
  %4 = getelementptr %struct.fib.str, ptr %s, i32 1
  %5 = call ptr @memcpy(ptr %4, ptr @.str, i64 6)
  store ptr %s, ptr @lit.0, align 8
  ret void
}

define i32 @main() {
entry:
  call void @fib.init()
  %s = load ptr, ptr @lit.0, align 8
  %0 = getelementptr %struct.fib.str, ptr %s, i32 1
  %1 = call i32 @puts(ptr %0)
  %2 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 3
  %3 = load i64, ptr %2, align 8
  %4 = load i64, ptr %s, align 8
  %5 = getelementptr %struct.fib.str, ptr %s, i32 0, i32 2
  %6 = load i32, ptr %5, align 4
  %7 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %3, i64 %4, i32 %6)
  ret i32 0
}
status 0
#### cases/lir/mapping/task-switch.lir
; ModuleID = 'cases/lir/mapping/task-switch.lir'
source_filename = "cases/lir/mapping/task-switch.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.task = type { i64, i32, i32, i32, i32, i32, ptr, i64, ptr, i64 }

@.str = private unnamed_addr constant [4 x i8] c" %d\00"
@.str.1 = private unnamed_addr constant [7 x i8] c"resume\00"
@.str.2 = private unnamed_addr constant [12 x i8] c" done %lld\0A\00"

declare i32 @printf(ptr, ...)

define i1 @resume(ptr %t) {
entry:
  %sp = getelementptr %struct.task, ptr %t, i32 0, i32 3
  %acc = getelementptr %struct.task, ptr %t, i32 0, i32 9
  %st = load atomic i32, ptr %sp acquire, align 4
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i32 %st)
  switch i32 %st, label %bad [
    i32 0, label %s0
    i32 1, label %s1
    i32 2, label %s2
  ]

s0:                                               ; preds = %entry
  store i64 10, ptr %acc, align 8
  store atomic i32 1, ptr %sp release, align 4
  ret i1 false

s1:                                               ; preds = %entry
  %1 = load i64, ptr %acc, align 8
  %2 = add i64 %1, 20
  store i64 %2, ptr %acc, align 8
  store atomic i32 2, ptr %sp release, align 4
  ret i1 false

s2:                                               ; preds = %entry
  %3 = load i64, ptr %acc, align 8
  %4 = getelementptr %struct.task, ptr %t, i32 0, i32 7
  store i64 %3, ptr %4, align 8
  store atomic i32 3, ptr %sp release, align 4
  ret i1 true

bad:                                              ; preds = %entry
  unreachable
}

define i32 @main() {
entry:
  %t = alloca %struct.task, align 8
  %0 = getelementptr %struct.task, ptr %t, i32 0, i32 3
  store i32 0, ptr %0, align 4
  %1 = call i32 (ptr, ...) @printf(ptr @.str.1)
  br label %run

run:                                              ; preds = %run, %entry
  %2 = call i1 @resume(ptr %t)
  br i1 %2, label %fin, label %run

fin:                                              ; preds = %run
  %3 = getelementptr %struct.task, ptr %t, i32 0, i32 7
  %4 = load i64, ptr %3, align 8
  %5 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %4)
  ret i32 0
}
status 0
#### cases/lir/mapping/threads.lir
; ModuleID = 'cases/lir/mapping/threads.lir'
source_filename = "cases/lir/mapping/threads.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@counter = global i64 0
@plain = global i64 0
@lock = global i32 0
@data = global i64 0
@flag = global i32 0
@.str = private unnamed_addr constant [13 x i8] c"atomic %lld\0A\00"
@.str.1 = private unnamed_addr constant [13 x i8] c"locked %lld\0A\00"
@.str.2 = private unnamed_addr constant [14 x i8] c"message %lld\0A\00"

declare i32 @pthread_create(ptr, ptr, ptr, ptr)

declare i32 @pthread_join(i64, ptr)

declare i32 @printf(ptr, ...)

define void @acquire-lock() {
entry:
  br label %spin

spin:                                             ; preds = %spin, %entry
  %r = cmpxchg weak ptr @lock, i32 0, i32 1 acquire monotonic, align 4
  %0 = extractvalue { i32, i1 } %r, 1
  br i1 %0, label %done, label %spin

done:                                             ; preds = %spin
  ret void
}

define ptr @worker(ptr %arg) {
entry:
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %0 = atomicrmw add ptr @counter, i64 1 seq_cst, align 8
  call void @acquire-lock()
  %1 = load i64, ptr @plain, align 8
  %2 = add i64 %1, 1
  store i64 %2, ptr @plain, align 8
  store atomic i32 0, ptr @lock release, align 4
  %i2 = add i64 %i, 1
  %3 = icmp slt i64 %i2, 100000
  br i1 %3, label %loop, label %done

done:                                             ; preds = %loop
  ret ptr null
}

define ptr @publisher(ptr %arg) {
entry:
  store i64 42, ptr @data, align 8
  store atomic i32 1, ptr @flag release, align 4
  ret ptr null
}

define i32 @main() {
entry:
  %ids = alloca i64, i32 5, align 8
  %0 = getelementptr i64, ptr %ids, i32 0
  %1 = call i32 @pthread_create(ptr %0, ptr null, ptr @worker, ptr null)
  %2 = getelementptr i64, ptr %ids, i32 1
  %3 = call i32 @pthread_create(ptr %2, ptr null, ptr @worker, ptr null)
  %4 = getelementptr i64, ptr %ids, i32 2
  %5 = call i32 @pthread_create(ptr %4, ptr null, ptr @worker, ptr null)
  %6 = getelementptr i64, ptr %ids, i32 3
  %7 = call i32 @pthread_create(ptr %6, ptr null, ptr @worker, ptr null)
  %8 = getelementptr i64, ptr %ids, i32 4
  %9 = call i32 @pthread_create(ptr %8, ptr null, ptr @publisher, ptr null)
  br label %wait

wait:                                             ; preds = %wait, %entry
  %10 = load atomic i32, ptr @flag acquire, align 4
  %11 = icmp eq i32 %10, 1
  br i1 %11, label %got, label %wait

got:                                              ; preds = %wait
  %msg = load i64, ptr @data, align 8
  %12 = getelementptr i64, ptr %ids, i32 0
  %13 = load i64, ptr %12, align 8
  %14 = call i32 @pthread_join(i64 %13, ptr null)
  %15 = getelementptr i64, ptr %ids, i32 1
  %16 = load i64, ptr %15, align 8
  %17 = call i32 @pthread_join(i64 %16, ptr null)
  %18 = getelementptr i64, ptr %ids, i32 2
  %19 = load i64, ptr %18, align 8
  %20 = call i32 @pthread_join(i64 %19, ptr null)
  %21 = getelementptr i64, ptr %ids, i32 3
  %22 = load i64, ptr %21, align 8
  %23 = call i32 @pthread_join(i64 %22, ptr null)
  %24 = getelementptr i64, ptr %ids, i32 4
  %25 = load i64, ptr %24, align 8
  %26 = call i32 @pthread_join(i64 %25, ptr null)
  %27 = load i64, ptr @counter, align 8
  %28 = call i32 (ptr, ...) @printf(ptr @.str, i64 %27)
  %29 = load i64, ptr @plain, align 8
  %30 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %29)
  %31 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %msg)
  ret i32 0
}
