  %2 = call i64 @strlen(ptr @.str.3)
  %3 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %1, i64 %2)
  %4 = load i8, ptr @.str.4, align 1
  %5 = zext i8 %4 to i32
  %6 = load i8, ptr getelementptr (i8, ptr @.str.4, i64 1), align 1
