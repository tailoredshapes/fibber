#### cases/lir/instr/tailcall.lir
; ModuleID = 'cases/lir/instr/tailcall.lir'
source_filename = "cases/lir/instr/tailcall.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@hits = global i64 0
@.str = private unnamed_addr constant [11 x i8] c"self %lld\0A\00"
@.str.1 = private unnamed_addr constant [11 x i8] c"mutual %d\0A\00"
@.str.2 = private unnamed_addr constant [11 x i8] c"void %lld\0A\00"
@.str.3 = private unnamed_addr constant [15 x i8] c"indirect %lld\0A\00"

declare i32 @printf(ptr, ...)

define i64 @count(i64 %n, i64 %acc) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %done, label %more

done:                                             ; preds = %entry
  ret i64 %acc

more:                                             ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = add i64 %acc, 1
  %3 = musttail call i64 @count(i64 %1, i64 %2)
  ret i64 %3
}

define tailcc i1 @even(i64 %n) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %yes, label %no

yes:                                              ; preds = %entry
  ret i1 true

no:                                               ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = musttail call tailcc i1 @odd(i64 %1, i64 0, i64 0)
  ret i1 %2
}

define tailcc i1 @odd(i64 %n, i64 %pad1, i64 %pad2) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %yes, label %no

yes:                                              ; preds = %entry
  ret i1 false

no:                                               ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = musttail call tailcc i1 @even(i64 %1)
  ret i1 %2
}

define void @tick(i64 %n) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %done, label %more

done:                                             ; preds = %entry
  ret void

more:                                             ; preds = %entry
  %1 = load i64, ptr @hits, align 8
  %2 = add i64 %1, 1
  store i64 %2, ptr @hits, align 8
  %3 = sub i64 %n, 1
  musttail call void @tick(i64 %3)
  ret void
}

define tailcc i64 @step(ptr %self, i64 %n, i64 %acc) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %done, label %more

done:                                             ; preds = %entry
  ret i64 %acc

more:                                             ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = add i64 %acc, 1
  %3 = musttail call tailcc i64 %self(ptr %self, i64 %1, i64 %2)
  ret i64 %3
}

define tailcc i64 @start(i64 %n) {
entry:
  %0 = musttail call tailcc i64 @step(ptr @step, i64 %n, i64 0)
  ret i64 %0
}

define i32 @main() {
entry:
  %0 = call i64 @count(i64 10000000, i64 0)
  %1 = call i32 (ptr, ...) @printf(ptr @.str, i64 %0)
  %2 = call tailcc i1 @even(i64 1000000)
  %3 = zext i1 %2 to i32
  %4 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %3)
  call void @tick(i64 1000000)
  %5 = load i64, ptr @hits, align 8
  %6 = sub i64 %5, 1000000
  %7 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %6)
  %8 = call tailcc i64 @start(i64 1000000)
  %9 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %8)
  ret i32 0
}
status 0
