  call void @pr8({ i8, i1 } %5)
  %6 = call { i8, i1 } @llvm.ssub.with.overflow.i8(i8 -100, i8 28)
  call void @pr8({ i8, i1 } %6)
  %7 = call i32 (ptr, ...) @printf(ptr @.str.3)
  %8 = call { i8, i1 } @llvm.smul.with.overflow.i8(i8 8, i8 8)
  call void @pr8({ i8, i1 } %8)
  %9 = call { i8, i1 } @llvm.smul.with.overflow.i8(i8 -8, i8 16)
  call void @pr8({ i8, i1 } %9)
  %10 = call { i8, i1 } @llvm.smul.with.overflow.i8(i8 16, i8 8)
  call void @pr8({ i8, i1 } %10)
  %r = call { i64, i1 } @llvm.sadd.with.overflow.i64(i64 9223372036854775807, i64 1)
  %11 = extractvalue { i64, i1 } %r, 0
  %12 = extractvalue { i64, i1 } %r, 1
  %13 = zext i1 %12 to i32
  %14 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %11, i32 %13)
  %v = call { <2 x i32>, <2 x i1> } @llvm.sadd.with.overflow.v2i32(<2 x i32> <i32 2147483647, i32 5>, <2 x i32> <i32 1, i32 -7>)
  %vals = extractvalue { <2 x i32>, <2 x i1> } %v, 0
  %ovf = extractvalue { <2 x i32>, <2 x i1> } %v, 1
  %15 = extractelement <2 x i32> %vals, i32 0
  %16 = extractelement <2 x i1> %ovf, i32 0
  %17 = zext i1 %16 to i32
  %18 = extractelement <2 x i32> %vals, i32 1
  %19 = extractelement <2 x i1> %ovf, i32 1
  %20 = zext i1 %19 to i32
  %21 = call i32 (ptr, ...) @printf(ptr @.str.5, i32 %15, i32 %17, i32 %18, i32 %20)
  %22 = call i64 @llvm.fptosi.sat.i64.f64(double 0x7FF8000000000000)
  %23 = call i64 @llvm.fptosi.sat.i64.f64(double 1.000000e+30)
  %24 = call i64 @llvm.fptosi.sat.i64.f64(double -1.000000e+30)
  %25 = call i64 @llvm.fptosi.sat.i64.f64(double -2.500000e+00)
  %26 = call i32 (ptr, ...) @printf(ptr @.str.6, i64 %22, i64 %23, i64 %24, i64 %25)
  %27 = call i8 @llvm.fptoui.sat.i8.f32(float 0x7FF8000000000000)
  %28 = zext i8 %27 to i32
  %29 = call i8 @llvm.fptoui.sat.i8.f32(float -1.000000e+00)
  %30 = zext i8 %29 to i32
  %31 = call i8 @llvm.fptoui.sat.i8.f32(float 3.000000e+02)
