; ModuleID = 'cases/lir/instr/memory.lir'
source_filename = "cases/lir/instr/memory.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.point = type { i32, double, i8 }
%struct.box = type { i64, %struct.point }

@.str = private unnamed_addr constant [13 x i8] c"scalar %lld\0A\00"
@.str.1 = private unnamed_addr constant [10 x i8] c"array %d\0A\00"
@.str.2 = private unnamed_addr constant [16 x i8] c"field %.17g %d\0A\00"
@.str.3 = private unnamed_addr constant [29 x i8] c"offsets %lld %lld %lld %lld\0A\00"
@.str.4 = private unnamed_addr constant [11 x i8] c"nested %d\0A\00"
@.str.5 = private unnamed_addr constant [17 x i8] c"byval %lld %lld\0A\00"
@.str.6 = private unnamed_addr constant [8 x i8] c"vec %d\0A\00"
@.str.7 = private unnamed_addr constant [14 x i8] c"ptrslot %lld\0A\00"
@.str.8 = private unnamed_addr constant [12 x i8] c"dynamic %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %p = alloca i64, align 8
  store i64 77, ptr %p, align 8
  %0 = load i64, ptr %p, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @.str, i64 %0)
  %arr = alloca i32, i32 10, align 4
  %2 = getelementptr i32, ptr %arr, i64 7
  store i32 9, ptr %2, align 4
  %3 = getelementptr inbounds i32, ptr %arr, i32 7
  %4 = load i32, ptr %3, align 4
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %4)
  %sp = alloca %struct.point, align 8
  %6 = getelementptr %struct.point, ptr %sp, i32 0, i32 1
  store double 2.500000e+00, ptr %6, align 8
  %7 = getelementptr inbounds %struct.point, ptr %sp, i32 0, i32 2
  store i8 -3, ptr %7, align 1
  %8 = getelementptr %struct.point, ptr %sp, i32 0, i32 1
  %9 = load double, ptr %8, align 8
  %10 = getelementptr %struct.point, ptr %sp, i32 0, i32 2
  %11 = load i8, ptr %10, align 1
  %12 = sext i8 %11 to i32
  %13 = call i32 (ptr, ...) @printf(ptr @.str.2, double %9, i32 %12)
  %14 = getelementptr %struct.point, ptr %sp, i32 0, i32 0
  %15 = ptrtoint ptr %14 to i64
  %16 = ptrtoint ptr %sp to i64
  %17 = sub i64 %15, %16
  %18 = getelementptr %struct.point, ptr %sp, i32 0, i32 1
  %19 = ptrtoint ptr %18 to i64
  %20 = ptrtoint ptr %sp to i64
  %21 = sub i64 %19, %20
  %22 = getelementptr %struct.point, ptr %sp, i32 0, i32 2
  %23 = ptrtoint ptr %22 to i64
  %24 = ptrtoint ptr %sp to i64
  %25 = sub i64 %23, %24
  %26 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %17, i64 %21, i64 %25, i64 ptrtoint (ptr getelementptr (%struct.point, ptr null, i32 1) to i64))
  %bx = alloca %struct.box, i32 2, align 8
  %27 = getelementptr %struct.box, ptr %bx, i64 1, i32 1, i32 0
  store i32 42, ptr %27, align 4
  %28 = getelementptr %struct.box, ptr %bx, i64 1, i32 1, i32 0
  %29 = load i32, ptr %28, align 4
  %30 = call i32 (ptr, ...) @printf(ptr @.str.4, i32 %29)
  %pp = alloca { i64, i64 }, align 8
  store { i64, i64 } { i64 5, i64 6 }, ptr %pp, align 8
  %v = load { i64, i64 }, ptr %pp, align 8
  %31 = extractvalue { i64, i64 } %v, 0
  %32 = extractvalue { i64, i64 } %v, 1
  %33 = call i32 (ptr, ...) @printf(ptr @.str.5, i64 %31, i64 %32)
  %vp = alloca <4 x i32>, align 16
  store <4 x i32> <i32 0, i32 1, i32 2, i32 3>, ptr %vp, align 16
  %34 = getelementptr i32, ptr %vp, i32 3
  %35 = load i32, ptr %34, align 4
  %36 = call i32 (ptr, ...) @printf(ptr @.str.6, i32 %35)
  %slot = alloca ptr, align 8
  store ptr %p, ptr %slot, align 8
  %37 = load ptr, ptr %slot, align 8
  %38 = load i64, ptr %37, align 8
  %39 = call i32 (ptr, ...) @printf(ptr @.str.7, i64 %38)
  %n = load i64, ptr %p, align 8
  %40 = sub i64 %n, 67
  %dyn = alloca i8, i64 %40, align 1
  %41 = getelementptr i8, ptr %dyn, i64 9
  store i8 10, ptr %41, align 1
  %42 = getelementptr i8, ptr %dyn, i64 9
  %43 = load i8, ptr %42, align 1
  %44 = sext i8 %43 to i32
  %45 = call i32 (ptr, ...) @printf(ptr @.str.8, i32 %44)
  ret i32 0
}
status 0
