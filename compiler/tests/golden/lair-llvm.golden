; ModuleID = 'cases/lir/instr/select.lir'
source_filename = "cases/lir/instr/select.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [18 x i8] c"scalar %lld %lld\0A\00"
@.str.1 = private unnamed_addr constant [11 x i8] c"ptr %d %d\0A\00"
@.str.2 = private unnamed_addr constant [12 x i8] c"pair %d %d\0A\00"
@.str.3 = private unnamed_addr constant [17 x i8] c"vec %d %d %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i64 @pick(i1 %c) {
entry:
  %0 = select i1 %c, i64 10, i64 20
  ret i64 %0
}

define i32 @main() {
entry:
  %0 = call i64 @pick(i1 true)
  %1 = call i64 @pick(i1 false)
  %2 = call i32 (ptr, ...) @printf(ptr @.str, i64 %0, i64 %1)
  %a = alloca i64, align 8
  %b = alloca i64, align 8
  %3 = ptrtoint ptr %a to i64
  %4 = ptrtoint ptr %a to i64
  %c = icmp eq i64 %3, %4
  %p = select i1 %c, ptr %a, ptr %b
  %5 = insertvalue { ptr, ptr } poison, ptr %a, 0
  %pr1 = insertvalue { ptr, ptr } %5, ptr %b, 1
  %6 = insertvalue { ptr, ptr } poison, ptr %b, 0
  %pr2 = insertvalue { ptr, ptr } %6, ptr %a, 1
  %pr = select i1 %c, { ptr, ptr } %pr2, { ptr, ptr } %pr1
  %7 = icmp eq ptr %p, %a
  %8 = zext i1 %7 to i32
  %9 = icmp eq ptr %p, %b
  %10 = zext i1 %9 to i32
  %11 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %8, i32 %10)
  %12 = extractvalue { ptr, ptr } %pr, 0
  %13 = icmp eq ptr %12, %b
  %14 = select i1 %13, i32 2, i32 0
  %15 = extractvalue { ptr, ptr } %pr, 1
  %16 = icmp eq ptr %15, %a
  %17 = select i1 %16, i32 1, i32 0
  %18 = call i32 (ptr, ...) @printf(ptr @.str.2, i32 %14, i32 %17)
  %19 = call i32 (ptr, ...) @printf(ptr @.str.3, i32 1, i32 20, i32 3, i32 40)
  ret i32 0
}
