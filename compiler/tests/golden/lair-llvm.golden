%struct.rec = type { ptr, i64 }
%struct.pair = type { { i32, i32 }, [2 x i64] }
%struct.str = type { i64, i32, i32, i64, [0 x i8] }

@hey = constant { i64, i32, i32, i64, [4 x i8] } { i64 0, i32 1, i32 8, i64 3, [4 x i8] c"hey\00" }
@table = constant [2 x %struct.rec] [%struct.rec { ptr @ten, i64 1 }, %struct.rec { ptr @eleven, i64 2 }]
@arr = constant [4 x i32] [i32 0, i32 10, i32 20, i32 30]
@zeros = global [3 x i64] zeroinitializer
@zpair = global %struct.pair zeroinitializer
@.str = private unnamed_addr constant [13 x i8] c"str %s %lld\0A\00"
@.str.1 = private unnamed_addr constant [17 x i8] c"table %lld %lld\0A\00"
@.str.2 = private unnamed_addr constant [14 x i8] c"global %d %d\0A\00"
@.str.3 = private unnamed_addr constant [22 x i8] c"local %lld %lld %lld\0A\00"
@.str.4 = private unnamed_addr constant [27 x i8] c"value %lld %lld %lld %lld\0A\00"
@.str.5 = private unnamed_addr constant [11 x i8] c"nested %d\0A\00"
@.str.6 = private unnamed_addr constant [19 x i8] c"zero %lld %d %lld\0A\00"
@.str.7 = private unnamed_addr constant [22 x i8] c"sizes %lld %lld %lld\0A\00"
@.str.8 = private unnamed_addr constant [11 x i8] c"dyn %d %d\0A\00"

declare i32 @printf(ptr, ...)

define i64 @ten() {
entry:
  ret i64 10
}

define i64 @eleven() {
entry:
  ret i64 11
}

define ptr @bytes(ptr %s) {
entry:
  %0 = getelementptr %struct.str, ptr %s, i32 0, i32 4, i64 0
  ret ptr %0
}

define [3 x i64] @mk(i64 %a, i64 %b) {
entry:
  %0 = insertvalue [3 x i64] poison, i64 %a, 0
  %1 = insertvalue [3 x i64] %0, i64 %b, 1
  %2 = insertvalue [3 x i64] %1, i64 42, 2
  ret [3 x i64] %2
}

define i64 @sum3([3 x i64] %v) {
entry:
  %0 = extractvalue [3 x i64] %v, 0
  %1 = extractvalue [3 x i64] %v, 1
  %2 = add i64 %0, %1
  %3 = extractvalue [3 x i64] %v, 2
  %4 = add i64 %2, %3
  ret i64 %4
}

define i64 @lookup(i64 %tid) {
entry:
  %0 = getelementptr [2 x %struct.rec], ptr @table, i32 0, i64 %tid, i32 0
  %f = load ptr, ptr %0, align 8
  %1 = call i64 %f()
  ret i64 %1
}

define i32 @nth(i64 %i) {
entry:
  %0 = getelementptr inbounds [4 x i32], ptr @arr, i32 0, i64 %i
  %1 = load i32, ptr %0, align 4
  ret i32 %1
}

define i32 @main() {
entry:
  %0 = call ptr @bytes(ptr @hey)
  %1 = load i64, ptr getelementptr (%struct.str, ptr @hey, i32 0, i32 3), align 8
  %2 = call i32 (ptr, ...) @printf(ptr @.str, ptr %0, i64 %1)
  %3 = call i64 @lookup(i64 0)
  %4 = call i64 @lookup(i64 1)
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %3, i64 %4)
  %6 = load i32, ptr getelementptr ([4 x i32], ptr @arr, i32 0, i32 2), align 4
  %7 = load [4 x i32], ptr @arr, align 4
  %8 = extractvalue [4 x i32] %7, 3
  %9 = call i32 (ptr, ...) @printf(ptr @.str.2, i32 %6, i32 %8)
  %a = alloca [4 x i64], align 8
  store [4 x i64] zeroinitializer, ptr %a, align 8
  %10 = getelementptr [4 x i64], ptr %a, i32 0, i32 0
  store i64 5, ptr %10, align 8
  %11 = getelementptr inbounds [4 x i64], ptr %a, i64 0, i64 1
  store i64 7, ptr %11, align 8
  %12 = load [4 x i64], ptr %a, align 8
  %13 = extractvalue [4 x i64] %12, 2
  %v = insertvalue [4 x i64] %12, i64 9, 2
  %14 = extractvalue [4 x i64] %v, 0
  %15 = extractvalue [4 x i64] %v, 1
  %16 = extractvalue [4 x i64] %v, 2
  %17 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 %14, i64 %15, i64 %16)
  %m = call [3 x i64] @mk(i64 1, i64 2)
  %18 = extractvalue [3 x i64] %m, 0
  %19 = extractvalue [3 x i64] %m, 1
  %20 = extractvalue [3 x i64] %m, 2
  %21 = call i64 @sum3([3 x i64] %m)
  %22 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %18, i64 %19, i64 %20, i64 %21)
  %n = alloca [2 x [3 x i32]], align 4
  store [2 x [3 x i32]] zeroinitializer, ptr %n, align 4
  %23 = getelementptr [2 x [3 x i32]], ptr %n, i32 0, i32 1, i32 2
  store i32 6, ptr %23, align 4
  %24 = load [2 x [3 x i32]], ptr %n, align 4
  %25 = extractvalue [2 x [3 x i32]] %24, 1
  %26 = extractvalue [3 x i32] %25, 2
  %27 = call i32 (ptr, ...) @printf(ptr @.str.5, i32 %26)
  %28 = load i64, ptr getelementptr ([3 x i64], ptr @zeros, i32 0, i32 1), align 8
  %29 = load %struct.pair, ptr @zpair, align 8
  %30 = extractvalue %struct.pair %29, 0
  %31 = extractvalue { i32, i32 } %30, 1
  %32 = load %struct.pair, ptr @zpair, align 8
  %33 = extractvalue %struct.pair %32, 1
  %34 = extractvalue [2 x i64] %33, 0
  %35 = call i32 (ptr, ...) @printf(ptr @.str.6, i64 %28, i32 %31, i64 %34)
  %36 = call i32 (ptr, ...) @printf(ptr @.str.7, i64 ptrtoint (ptr getelementptr ([2 x i64], ptr null, i32 1) to i64), i64 ptrtoint (ptr getelementptr (%struct.str, ptr null, i32 1) to i64), i64 ptrtoint (ptr getelementptr ([5 x i32], ptr null, i32 1) to i64))
  %37 = call i32 @nth(i64 1)
  %38 = call i32 @nth(i64 3)
  %39 = call i32 (ptr, ...) @printf(ptr @.str.8, i32 %37, i32 %38)
  ret i32 0
}
