  %11 = call i32 (ptr, ...) @printf(ptr @.str.4, i32 %10)
  %12 = fptoui double %d429 to i32
  %13 = call i32 (ptr, ...) @printf(ptr @.str.5, i32 %12)
  %14 = sitofp i32 %m7 to double
  %15 = call i32 (ptr, ...) @printf(ptr @.str.6, double %14)
  %16 = uitofp i8 %m1 to double
  %17 = call i32 (ptr, ...) @printf(ptr @.str.7, double %16)
  %18 = inttoptr i64 %addr to ptr
  %19 = ptrtoint ptr %18 to i64
  %20 = call i32 (ptr, ...) @printf(ptr @.str.8, i64 %19)
  %21 = call i32 (ptr, ...) @printf(ptr @.str.9, i64 4607182418800017408, double 2.000000e+00, i32 1065353216)
  %v = bitcast i64 %packed to <2 x i32>
  %22 = extractelement <2 x i32> %v, i32 0
  %23 = extractelement <2 x i32> %v, i32 1
  %24 = call i32 (ptr, ...) @printf(ptr @.str.10, i32 %22, i32 %23)
  ret void
}

define i32 @main() {
entry:
  call void @conv(i32 511, i8 -1, i16 -2, double 2.500000e+00, double 4.290000e+01, double -4.290000e+01, i32 -7, i64 4096, i64 21474836483)
