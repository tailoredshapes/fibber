@stderr = external global ptr
@environ = external global ptr
@.str = private unnamed_addr constant [12 x i8] c"environ %s\0A\00"
@.str.1 = private unnamed_addr constant [3 x i8] c"ok\00"
@.str.2 = private unnamed_addr constant [5 x i8] c"null\00"
@.str.3 = private unnamed_addr constant [5 x i8] c"err\0A\00"

declare i32 @fprintf(ptr, ptr, ...)

declare i32 @fflush(ptr)

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %0 = load ptr, ptr @environ, align 8
  %1 = icmp ne ptr %0, null
  %2 = select i1 %1, ptr @.str.1, ptr @.str.2
  %3 = call i32 (ptr, ...) @printf(ptr @.str, ptr %2)
  %4 = load ptr, ptr @stderr, align 8
  %n = call i32 (ptr, ptr, ...) @fprintf(ptr %4, ptr @.str.3)
  %5 = load ptr, ptr @stderr, align 8
  %6 = call i32 @fflush(ptr %5)
  ret i32 %n
}
status 0
