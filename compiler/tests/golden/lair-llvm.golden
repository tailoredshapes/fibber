; ModuleID = 'cases/lir/instr/control.lir'
source_filename = "cases/lir/instr/control.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

@.str = private unnamed_addr constant [11 x i8] c"void done\0A\00"
@.str.1 = private unnamed_addr constant [11 x i8] c"max %d %d\0A\00"
@.str.2 = private unnamed_addr constant [10 x i8] c"sum %lld\0A\00"
@.str.3 = private unnamed_addr constant [23 x i8] c"switch %d %d %d %d %d\0A\00"
@.str.4 = private unnamed_addr constant [16 x i8] c"same-target %d\0A\00"

declare i32 @printf(ptr, ...)

define i32 @max(i32 %a, i32 %b) {
entry:
  %0 = icmp sgt i32 %a, %b
  br i1 %0, label %a_wins, label %b_wins

a_wins:                                           ; preds = %entry
  br label %done

b_wins:                                           ; preds = %entry
  br label %done

done:                                             ; preds = %a_wins, %b_wins
  %1 = phi i32 [ %a, %a_wins ], [ %b, %b_wins ]
  ret i32 %1
}

define i64 @sum(i64 %n) {
entry:
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i64 [ 1, %entry ], [ %i2, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc2, %loop ]
  %acc2 = add i64 %acc, %i
  %i2 = add i64 %i, 1
  %0 = icmp sle i64 %i2, %n
  br i1 %0, label %loop, label %exit

exit:                                             ; preds = %loop
  ret i64 %acc2
}

define i32 @sw(i32 %k) {
entry:
  switch i32 %k, label %other [
    i32 0, label %zero
    i32 1, label %one
    i32 -5, label %neg
  ]

zero:                                             ; preds = %entry
  ret i32 100

one:                                              ; preds = %entry
  ret i32 200

neg:                                              ; preds = %entry
  ret i32 300

other:                                            ; preds = %entry
  ret i32 -1
}

define i32 @both(i1 %c) {
entry:
  br i1 %c, label %j, label %j

j:                                                ; preds = %entry, %entry
  %0 = phi i32 [ 3, %entry ], [ 3, %entry ]
  ret i32 %0
}

define void @v() {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str)
  ret void
}

define i32 @main() {
entry:
  %0 = call i32 @max(i32 7, i32 -3)
  %1 = call i32 @max(i32 2, i32 9)
  %2 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %0, i32 %1)
  %3 = call i64 @sum(i64 100)
  %4 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 %3)
  %5 = call i32 @sw(i32 0)
  %6 = call i32 @sw(i32 1)
  %7 = call i32 @sw(i32 -5)
  %8 = call i32 @sw(i32 7)
  %9 = call i32 @sw(i32 2)
  %10 = call i32 (ptr, ...) @printf(ptr @.str.3, i32 %5, i32 %6, i32 %7, i32 %8, i32 %9)
  %11 = call i32 @both(i1 true)
  %12 = call i32 (ptr, ...) @printf(ptr @.str.4, i32 %11)
  call void @v()
  br i1 false, label %never, label %fine

never:                                            ; preds = %entry
  unreachable

fine:                                             ; preds = %entry
  ret i32 0
}
status 0
