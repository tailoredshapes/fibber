; ModuleID = 'cases/lir/instr/aggregate.lir'
source_filename = "cases/lir/instr/aggregate.lir"
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-linux-gnu"

%struct.pair = type { i64, i32, i8 }

@.str = private unnamed_addr constant [16 x i8] c"anon %lld %lld\0A\00"
@.str.1 = private unnamed_addr constant [18 x i8] c"named %lld %d %d\0A\00"
@.str.2 = private unnamed_addr constant [19 x i8] c"nested %lld %d %d\0A\00"
@.str.3 = private unnamed_addr constant [19 x i8] c"insert %lld %d %d\0A\00"
@.str.4 = private unnamed_addr constant [20 x i8] c"fromvalues %lld %d\0A\00"

declare i32 @printf(ptr, ...)

define %struct.pair @mk(i64 %a) {
entry:
  %0 = insertvalue %struct.pair poison, i64 %a, 0
  %1 = insertvalue %struct.pair %0, i32 -2, 1
  %2 = insertvalue %struct.pair %1, i8 3, 2
  ret %struct.pair %2
}

define { i64, i1 } @mk2(i64 %a, i1 %b) {
entry:
  %0 = insertvalue { i64, i1 } poison, i64 %a, 0
  %1 = insertvalue { i64, i1 } %0, i1 %b, 1
  ret { i64, i1 } %1
}

define i32 @main() {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @.str, i64 7, i64 8)
  %p = call %struct.pair @mk(i64 1)
  %1 = extractvalue %struct.pair %p, 0
  %2 = extractvalue %struct.pair %p, 1
  %3 = extractvalue %struct.pair %p, 2
  %4 = sext i8 %3 to i32
  %5 = call i32 (ptr, ...) @printf(ptr @.str.1, i64 %1, i32 %2, i32 %4)
  %6 = call i32 (ptr, ...) @printf(ptr @.str.2, i64 5, i32 6, i32 7)
  %7 = call i32 (ptr, ...) @printf(ptr @.str.3, i64 9, i32 6, i32 70)
  %r = call { i64, i1 } @mk2(i64 41, i1 true)
  %8 = extractvalue { i64, i1 } %r, 0
  %9 = extractvalue { i64, i1 } %r, 1
  %10 = zext i1 %9 to i32
  %11 = call i32 (ptr, ...) @printf(ptr @.str.4, i64 %8, i32 %10)
  ret i32 0
}
