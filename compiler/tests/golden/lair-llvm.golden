define i64 @sum-to(i64 %n) {
entry:
  br label %loop

loop:                                             ; preds = %loop, %entry
  %i = phi i64 [ 0, %entry ], [ %i2, %loop ]
  %acc = phi i64 [ 0, %entry ], [ %acc2, %loop ]
  %i2 = add i64 %i, 1
  %acc2 = add i64 %acc, %i
  %0 = icmp slt i64 %i2, %n
  br i1 %0, label %loop, label %done

done:                                             ; preds = %loop
  %1 = add i64 %acc2, 0
  ret i64 %1
}

define i64 @count-down(i64 %n, i64 %acc) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %base, label %rec

base:                                             ; preds = %entry
  ret i64 %acc

rec:                                              ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = add i64 %acc, 1
  %3 = musttail call i64 @count-down(i64 %1, i64 %2)
  ret i64 %3
}

define i1 @even(i64 %n) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %yes, label %no

yes:                                              ; preds = %entry
  ret i1 true

no:                                               ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = musttail call i1 @odd(i64 %1)
  ret i1 %2
}

define i1 @odd(i64 %n) {
entry:
  %0 = icmp eq i64 %n, 0
  br i1 %0, label %yes, label %no

yes:                                              ; preds = %entry
  ret i1 false

no:                                               ; preds = %entry
  %1 = sub i64 %n, 1
  %2 = musttail call i1 @even(i64 %1)
  ret i1 %2
}

define i64 @ack(i64 %m, i64 %n) {
entry:
  %0 = icmp eq i64 %m, 0
  br i1 %0, label %m0, label %mpos

m0:                                               ; preds = %entry
  %1 = add i64 %n, 1
  ret i64 %1

mpos:                                             ; preds = %entry
  %2 = icmp eq i64 %n, 0
  br i1 %2, label %n0, label %npos

n0:                                               ; preds = %mpos
  %3 = sub i64 %m, 1
  %4 = call i64 @ack(i64 %3, i64 1)
  ret i64 %4

npos:                                             ; preds = %mpos
  %5 = sub i64 %m, 1
  %6 = sub i64 %n, 1
  %7 = call i64 @ack(i64 %m, i64 %6)
  %8 = call i64 @ack(i64 %5, i64 %7)
  ret i64 %8
}

define i32 @main() {
entry:
  %0 = call i64 @sum-to(i64 10)
  %1 = call i32 (ptr, ...) @printf(ptr @.str, i64 %0)
  %2 = call i64 @ack(i64 2, i64 3)
