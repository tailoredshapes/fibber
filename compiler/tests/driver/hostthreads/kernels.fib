;; A library for a C host (compiler/tests/driver/host-threads.sh): `fibc build --emit obj --export ..`, `cc -shared`.
;; The functions allocate (a Vec, a closure, a str), which is what made two host threads crash (docs/design/host-threads.md).
(ns main (:use fib.core fib.seq))
(defun add (a: i64 b: i64) -> i64 (+ a b))
(defun sum-squares (n: i64) -> i64 (reduce + 0 (map (fn (i: i64) (* i i)) (vec (range n)))))
(defun text-len (n: i64) -> i64 (str-len (str "n=" (show n) " " (show (sum-squares 10)))))
