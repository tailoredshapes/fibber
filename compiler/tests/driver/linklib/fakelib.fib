;; A driver for a native library that does not exist on any machine (compiler/tests/driver/linklib.sh): the module declares it with :lib.
(ns fakelib)
(extern fibtest_missing :private () -> i32 :lib "fibtest-missing")
(defun call-missing () -> i32 (unsafe (fibtest_missing)))
(defun harmless () -> i32 7i32)
