;; A driver for libfibver, which compiler/tests/driver/linklib.sh builds from C (int fibver_answer(void) { return 43; }) as libfibver.so.3 only: the
;; runtime file of a library whose development link libfibver.so is not installed.
(ns verso)
(extern fibver_answer :private () -> i32 :lib "fibver")
(defun answer () -> i32 (unsafe (fibver_answer)))
