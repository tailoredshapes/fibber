;; compiler/tests/driver/unit-args.fib: compiler/driver/args.fib: the command line of the compiler in fibber. SOURCE: every expected value is
;; read off the Rust tests of crates/fibc/src/command.rs (the parse of run, build, -O, -L, -l and emit) and of fibref's cmdline.rs
;; (`split_roots`); the whole program is judged by compare.sh, build-check.sh and cli.sh of this directory.
;; Build: fibc build compiler/tests/driver/unit-args.fib -I compiler -I lib -o OUT
(ns main
  (:use types.check emit.args driver.args))

;; A command as text (`Command` holds `EmitOptions`, which has no Eq): what the tests compare.
(defun desc (c: Command) -> str
  (match c
    ((CmdRun f t a o) (str-join ["run " (show f) " " (show t) " " (show a) " " (show o)]))
    ((CmdBuild f out d l o) (str-join ["build " (show f) " " (show out) " " (show d) " " (show l) " " (show o)]))
    ((CmdEmit f) (str-concat "emit " (show f)))
    ((CmdEmitDump o files) (str-join ["emit-dump " (show (. o layout)) " " (show files)]))
    ((CmdExplain f) (str-concat "explain " (show f)))
    ((CmdHarness w) (str-concat "harness " w))
    ((CmdCases d o j) (str-join ["cases " (show d) " " (show o) " " (show j)]))
    ((CmdHelp) "help")
    ((CmdVersion) "version")
    ((CmdInvalid) "invalid")))

(defun is? (words: (Vec str) c: Command) -> bool (= (desc (parse words)) (desc c)))

(defun run-at (file: str trace: bool args: (Vec str) opt: i64) -> Command (CmdRun file trace args opt))

(defun build-at (file: str out: str dirs: (Vec str) libs: (Vec str) opt: i64) -> Command (CmdBuild file out dirs libs opt))

(defun invalid? (words: (Vec str)) -> bool (is? words CmdInvalid))

(defun roots-split (words: (Vec str)) -> (Pair (Vec str) (Vec str))
  (let ((s (split-roots words))) (Pair (. s dirs) (. s rest))))

(defun main () -> i64
  (let ((cs (checks-new)))
    (do
      (check cs "each command parses"
             (and (is? ["emit" "a.fib"] (CmdEmit "a.fib"))
                  (is? ["explain" "a.fib"] (CmdExplain "a.fib"))
                  (is? ["run" "--trace" "a.fib"] (run-at "a.fib" true [] 0))
                  (is? ["run" "a.fib" "--" "x" "y"] (run-at "a.fib" false ["x" "y"] 0))
                  (is? ["build" "a.fib" "-o" "a"] (build-at "a.fib" "a" [] [] 2))
                  (is? ["-h"] CmdHelp) (is? ["help"] CmdHelp) (is? ["--help"] CmdHelp)))
      (check cs "--version and -V, alone, are the version"
             (and (is? ["--version"] CmdVersion) (is? ["-V"] CmdVersion) (invalid? ["--version" "x"]) (invalid? ["-V" "-V"])
                  (not (takes-roots? CmdVersion))))
      (check cs "no command, run without a file, emit with two files: invalid"
             (and (invalid? []) (invalid? ["run"]) (invalid? ["emit" "a" "b"]) (invalid? ["emit"]) (invalid? ["bogus"])
                  (invalid? ["explain"]) (invalid? ["help" "x"])))
      (check cs "emit-dump takes its options then its files, refuses a bad option"
             (and (match (parse ["emit-dump" "--layout" "a" "b"])
                    ((CmdEmitDump o files) (and (. o layout) (= files ["a" "b"])))
                    (_ false))
                  (invalid? ["emit-dump" "--bogus" "a"])))
      (check cs "the harness commands are not the driver's"
             (and (is? ["cases"] (CmdCases "cases/ownership" [] 1)) (is? ["cases" "d"] (CmdCases "d" [] 1))
                  (is? ["cases" "d" "--only" "1" "2"] (CmdCases "d" ["1" "2"] 1))
                  (is? ["cases" "d" "--only"] CmdInvalid) (is? ["cases" "--only" "1"] CmdInvalid)
                  (not (takes-roots? (CmdCases "d" [] 1)))
                  (is? ["gen" "--seed" "1"] (CmdHarness "gen")) (is? ["itrace" "a"] (CmdHarness "itrace"))
                  (not (takes-roots? (CmdHarness "cases"))) (takes-roots? (CmdHarness "itrace"))))
      (check cs "cases takes -j N, or -jN, anywhere; a count below 1 or not a number is invalid"
             (and (is? ["cases" "d" "-j" "12"] (CmdCases "d" [] 12)) (is? ["cases" "d" "-j4"] (CmdCases "d" [] 4))
                  (is? ["cases" "-j" "3"] (CmdCases "cases/ownership" [] 3))
                  (is? ["cases" "d" "--only" "1" "2" "-j" "5"] (CmdCases "d" ["1" "2"] 5))
                  (is? ["cases" "-j" "2" "d" "--only" "1"] (CmdCases "d" ["1"] 2))
                  (invalid? ["cases" "d" "-j" "0"]) (invalid? ["cases" "d" "-j" "x"]) (invalid? ["cases" "d" "-j"])
                  (invalid? ["cases" "d" "-j" "-1"]) (invalid? ["cases" "d" "-j"  "2" "--only"])))
      (check cs "build takes any number of dirs and libs in order"
             (is? ["build" "a.fib" "-o" "a" "-L" "d1" "-l" "lair" "-L" "d2" "-l" "m"] (build-at "a.fib" "a" ["d1" "d2"] ["lair" "m"] 2)))
      (check cs "build takes the flags before the output and glued to their value"
             (is? ["build" "a.fib" "-L" "d" "-lx" "-Ld2" "-o" "a"] (build-at "a.fib" "a" ["d" "d2"] ["x"] 2)))
      (check cs "build refuses what it cannot make sense of"
             (and (invalid? ["build" "a.fib"]) (invalid? ["build" "a.fib" "-L" "d"]) (invalid? ["build" "a.fib" "-o"])
                  (invalid? ["build" "a.fib" "-o" "a" "-L"]) (invalid? ["build" "a.fib" "-o" "a" "-l"])
                  (invalid? ["build" "a.fib" "-o" "a" "-o" "b"]) (invalid? ["build" "a.fib" "-o" "a" "-L" ""])
                  (invalid? ["build" "a.fib" "-o" "a" "-l" ""]) (invalid? ["build" "a.fib" "-o" "a" "-x"])
                  (invalid? ["build" "a.fib" "-o" "a" "extra"]) (invalid? ["build" "-o" "a"])))
      (check cs "a library directory or name may look like a flag"
             (is? ["build" "a.fib" "-o" "a" "-L" "-x" "-l" "-y"] (build-at "a.fib" "a" ["-x"] ["-y"] 2)))
      (check cs "build takes the level apart or glued in any place after the file"
             (and (is? ["build" "a.fib" "-o" "a" "-O" "0"] (build-at "a.fib" "a" [] [] 0))
                  (is? ["build" "a.fib" "-O" "1" "-o" "a"] (build-at "a.fib" "a" [] [] 1))
                  (is? ["build" "a.fib" "-O3" "-o" "a"] (build-at "a.fib" "a" [] [] 3))
                  (is? ["build" "a.fib" "-o" "a" "-L" "d" "-O2" "-l" "m"] (build-at "a.fib" "a" ["d"] ["m"] 2))))
      (check cs "run takes the level and trace in either order before the file"
             (and (is? ["run" "-O" "2" "a.fib"] (run-at "a.fib" false [] 2))
                  (is? ["run" "-O1" "a.fib"] (run-at "a.fib" false [] 1))
                  (is? ["run" "--trace" "-O" "3" "a.fib"] (run-at "a.fib" true [] 3))
                  (is? ["run" "-O0" "--trace" "a.fib"] (run-at "a.fib" true [] 0))
                  (is? ["run" "-O" "2" "a.fib" "--" "-O" "7"] (run-at "a.fib" false ["-O" "7"] 2))))
      (check cs "the level is a digit from 0 to 3 and given once"
             (and (invalid? ["build" "a.fib" "-o" "a" "-O"]) (invalid? ["build" "a.fib" "-o" "a" "-O" "4"])
                  (invalid? ["build" "a.fib" "-o" "a" "-O" "-1"]) (invalid? ["build" "a.fib" "-o" "a" "-O" "+2"])
                  (invalid? ["build" "a.fib" "-o" "a" "-O" "02"]) (invalid? ["build" "a.fib" "-o" "a" "-O" "s"])
                  (invalid? ["build" "a.fib" "-o" "a" "-O" ""]) (invalid? ["build" "a.fib" "-o" "a" "-O2" "-O" "1"])
                  (invalid? ["run" "-O" "a.fib"]) (invalid? ["run" "-O" "4" "a.fib"]) (invalid? ["run" "-O2" "-O" "1" "a.fib"])
                  (invalid? ["run" "-O" "2"]) (invalid? ["run" "--trace" "--trace" "a.fib"])))
      (check cs "a last word is the file, as `run --trace` always was"
             (and (is? ["run" "-O2"] (run-at "-O2" false [] 0)) (is? ["run" "--trace"] (run-at "--trace" false [] 0))))
      (check cs "the usage names the level and its defaults"
             (and (some? (str-find usage "run [--trace] [-O N] <file>" 0)) (some? (str-find usage "build <file> -o <out> [-O N]" 0))
                  (some? (str-find usage "build defaults to 2, run to 0" 0))))
      (check cs "-I is taken from anywhere before -- in order, -I DIR or -IDIR"
             (and (= (roots-split ["run" "-I" "a" "f.fib" "-Ib" "-I" "c" "--" "-I" "d" "x"])
                     (Pair ["a" "b" "c"] ["run" "f.fib" "--" "-I" "d" "x"]))
                  (= (roots-split ["emit" "f.fib"]) (Pair [] ["emit" "f.fib"]))))
      (check cs "a -I with no directory, an empty one or -- stays in the words"
             (and (= (roots-split ["emit" "f.fib" "-I"]) (Pair [] ["emit" "f.fib" "-I"]))
                  (= (roots-split ["emit" "-I" "" "f.fib"]) (Pair [] ["emit" "-I" "" "f.fib"]))
                  (= (roots-split ["emit" "-I" "--" "-I" "x"]) (Pair [] ["emit" "-I" "--" "-I" "x"]))
                  (= (roots-split ["emit" "-I"]) (Pair [] ["emit" "-I"]))))
      (check cs "-I belongs to the commands that read a program"
             (and (takes-roots? (CmdEmit "a")) (takes-roots? (CmdExplain "a")) (takes-roots? (run-at "a" false [] 0))
                  (takes-roots? (build-at "a" "o" [] [] 2)) (not (takes-roots? CmdHelp)) (not (takes-roots? CmdInvalid))))
      (finish cs))))
