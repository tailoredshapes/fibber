;; DARWIN-3: the threads of a program run by `fibc run` are the program's, not the compiler's. Prints the count alone, with one task sleeping, and after it is joined.
(ns main (:use fib.core fib.async) (:require [fib.os :as os]))
(defun main () -> i64
  (let [alone (unwrap-or (os/thread-count) -1)
        busy (spawn (fn () (do (os/sleep-ns 300000000) 8)))
        during (unwrap-or (os/thread-count) -1)
        done (join busy)]
    (do (println alone during done) (+ (* 100 alone) during))))
