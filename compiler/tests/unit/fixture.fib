;; Executable faults for fib.test.unit: the shell judge requires failures, traps and timeouts.
(ns main (:use fib.test.unit fib.test.run))

(deftest tiny [t]
  (is t true))

(deftest passing [t]
  (let ((hits (cell 0)) (logs (cell 0)) (test (tiny)))
    (do
      (is= (do (set! logs (+ @logs 1)) t)
           (do (set! hits (+ @hits 1)) [1 2])
           (do (set! hits (+ @hits 1)) [1 2]) "operands once")
      (is= t 2 @hits)
      (is= t 1 @logs)
      (is t (do (set! hits (+ @hits 1)) true))
      (is= t 3 @hits)
      (is= t 1 (count ((. test run) 1)))
      (is= t 1 (count ((. test run) 1))))))

(deftest failing [t]
  (is t false "planted boolean failure")
  (is= t 1 2 "planted equality failure")
  (is t true "continued after failure"))

(deftest empty [t]
  ())

(deftest trapping [t]
  (trap "unit planted trap"))

(deftest trap-survivor [t]
  (is t true))

(deftest hanging [t]
  (loop [] (recur)))

(deftest hang-survivor [t]
  (is t true))

(defun main () -> i64
  (if (= (unwrap-or (first (vec (args))) "") "--duplicate")
      (run-main-with [(unit-suite "unit" [(passing) (passing)])] [])
      (run-main [(unit-suite "unit" [(passing) (failing) (empty) (trapping)
                                     (trap-survivor) (hanging) (hang-survivor)])])))
