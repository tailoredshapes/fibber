;; error: AmpTwice in the body of an impl method, after the one in a defun (definition order: the
;; defuns first, then the methods), with the call's position, and no type error is looked for.
(defprotocol Score (score (self) -> i64))
(defstruct W (n: i64))
(defun bar (&a &b) -> i64 0)
(impl Score W (score (self) (let ((x (cell [3]))) (bar &x &x))))
(defun main () -> i64 (let ((x (cell [3]))) (+ (bar &x &x) (score (W 1)))))
