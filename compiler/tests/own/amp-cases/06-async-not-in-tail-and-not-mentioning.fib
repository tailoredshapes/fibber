;; ok: no error: an async that does not mention the parameter and is not in tail position, an async
;; inside a fn that is the tail, and a function with no & parameter.
(defun b1 (&v) (let ((n (block-on (async 1)))) (push! &v n)))
(defun b2 (&v) (fn () (async 1)))
(defun b3 (v) (async v))
(defun main () -> i64 0)
