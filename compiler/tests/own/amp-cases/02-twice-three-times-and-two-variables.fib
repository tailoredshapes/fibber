;; error: a variable passed three times is one error (at its second occurrence); two variables in
;; one call are reported in the order of their second occurrences; nested calls are reported in
;; pre-order.
(defun bar (&a &b &c &d) -> i64 0)
(defun main () -> i64
  (let ((x (cell [3])) (y (cell [4])))
    (+ (bar &x &y &y &x) (bar &x &x &x &y) (bar &x &y &x &y))))
