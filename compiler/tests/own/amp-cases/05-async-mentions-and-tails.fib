;; error: AmpInAsync: an async that mentions the parameter by @v, &v or set!, at any depth, in a
;; nested fn; and an async in tail position of a do, an if, a match, a let, a loop; the parameters of
;; a8 are reported in order, the first by the tail async, the second by the one that mentions it.
(defstruct S (n: i64))
(defun a1 (&v) (do (async @v) 0))
(defun a2 (&v) (do (async (set! v 1)) 0))
(defun a3 (&v) (do (async (push! &v 1)) 0))
(defun a3b (&v) (do (async (fn () @v)) 0))
(defun a4 (&v c) (do (c) (if true 0 (async 1))))
(defun a5 (&v c) (match c (true 0) (false (async 1))))
(defun a6 (&v) (let ((q 1)) (do q (async 2))))
(defun a7 (&v) (loop ((i 0)) (if (< i 1) (recur (+ i 1)) (async i))))
(defun a8 (&v &w) (do (async (set! w 2)) (async 1)))
(defun main () -> i64 0)
