(defstruct Pt (x: i64 y: i64))
(defstruct Pair2 (a: Pt b: Pt))
(def origin: Pt (Pt 0 0))
(defun keep (s: Pt) -> Pt s)
(defun fwd (t: Pt) -> Pt (keep t))
(defun left (b: Pair2) -> i64 (let ((p (. b a))) (. p x)))
(defun twin (v: (Vec i64)) -> i64 (let ((w v)) (vec-count w)))
(defun held (v: (Vec i64)) -> i64 (let ((f (fn () (vec-count v)))) (f)))
(defun later (n: i64) (async (+ n 1)))
(defun later2 (p: Pt) (async (keep p)))
(defun pick (a: Pt b: Pt c: bool) -> Pt (if c a b))
(defun stash (v: (Vec i64)) (cell v))
(defun drop-it () -> i64 (do (Pt 1 2) 3))
(defun ping (n: i64 p: Pt) -> Pt (if (> n 0) (pong (- n 1) p) p))
(defun pong (n: i64 p: Pt) -> Pt (ping n (keep p)))
(defun pusher (&v) (vec-count @v))
(defun main () -> i64 (+ (. origin x) (left (Pair2 (Pt 1 2) (Pt 3 4)))))
