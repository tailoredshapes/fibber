(defstruct Pt (x: i64 y: i64))
(defun mk (n: i64) (fn (x) (+ x n)))
(defun grow (v: (Vec i64)) -> (Vec i64)
  (loop ((x v))
    (if (> (vec-count x) 3) x (recur (vec-conj x 1)))))
(defun bar (&a) (append &a 2))
(defun f (v: (Vec (Vec i64))) -> i64
  (match v
    ([[x & p] & q] :when (> x 0) (vec-count q))
    ([_ & q] :when false 1)
    (_ 0)))
(defun g () -> i64 (. (Pt 1 2) x))
(defun keep (s: Pt) -> Pt s)
(defun main () -> i64
  (let ((x (cell [3 4])))
    (bar &x)
    (+ (. (keep (Pt 1 2)) y) (vec-count @x))))
