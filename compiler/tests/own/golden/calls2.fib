(defstruct Pt (x: i64 y: i64))
(defun keep (s: Pt) -> Pt s)
(defun see (s: Pt) -> i64 (. s x))
(defun sum-to (n: i64) -> i64 ((fn go (k: i64 acc: i64) -> i64 (if (<= k 0) acc (go (- k 1) (+ acc k)))) n 0))
(defun hold (p: Pt) -> i64 (loop ((i 0) (q p)) (if (> i 2) (. q x) (recur (+ i 1) p))))
(defun twice (f: (fn () i64)) -> i64 (+ (f) (f)))
(defun with-local (n: i64) -> i64 (twice (fn () -> i64 (+ n 1))))
(defun opt (n: i64) -> (Option i64) (some n))
(defun first-x (v: (Vec Pt)) -> i64 (see (vec-nth v 0)))
(defun temp-arg (a: i64) -> i64 (see (keep (Pt a a))))
(defun temp-tail (a: i64) -> Pt (keep (keep (Pt a a))))
(defun spawned (v: (Vec i64)) -> i64 (do (spawn (fn () -> i64 (vec-count v))) 0))
(defun two-amps (&a &b) (do (append &a 1) (append &b 2)))
(defun run1 (f: (fn () i64)) -> i64 (f))
(defun relay (f: (fn () i64)) -> i64 (run1 f))
(defun lit-tail (n: i64) -> i64 (relay (fn () -> i64 n)))
(defun lit-step (n: i64) -> i64 (do (relay (fn () -> i64 n)) 1))
(defun mix (p: Pt) -> i64 (do (cell p) (see p)))
(defun call-with (g: (fn ((fn () i64)) i64) n: i64) -> i64 (g (fn () -> i64 n)))
(defun two-loop (n: i64) -> i64
  (loop ((a (Pt 0 0)) (b (Pt 1 1)) (i 0)) (if (> i n) (. a x) (recur (Pt i i) (Pt i i) (+ i 1)))))
(defun main () -> i64 (+ (sum-to 3) (see (temp-tail 1))))
