;; The walk of bodies and literals (own.walk.lit, own.walk.expr): `fn` literals as stack and as
;; heap closures with their captures, a self-named `fn`, `async`, the exit of a body, cells and
;; `&` parameters. The golden text is `fibref own` on this file.
(defstruct Pt (x: i64 y: i64))
(defstruct Counter (n: i64))
(defun c1 (p: Pt) -> i64 (let [f (fn (a: i64) -> i64 (+ a (. p x)))] (f 1)))
(defun c2 (p: Pt) (fn (a: i64) -> i64 (+ a (. p x))))
(defun c3 (n: i64) (fn (a: i64) -> i64 (+ a n)))
(defun c4 (n: i64) -> i64 (let [f (fn fact (k: i64) -> i64 (if (= k 0) 1 (* k (fact (- k 1)))))] (f n)))
(defun c5 () (fn (q: Pt) -> Pt q))
(defun c6 (p: Pt) -> i64 (let [f (fn () (fn () (. p x)))] 0))
(defun c7 () (let [c (cell (Pt 0 0))] (fn () (set! c (Pt 1 1)))))
;; strings are immortal, the exit of a body consumes its value
(defun s1 () -> str "abc")
(defun s2 (b: bool) -> str (let [s "x"] (if b s "y")))
(defun s3 (p: Pt) -> Pt (let [q p] q))
(defun s4 (p: Pt) -> Pt (Pt (. p y) (. p x)))
;; `set!`, `deref` and the value that is stored
(defun m1 () -> i64 (let [c (cell (Pt 1 2))] (do (set! c (Pt 3 4)) (. @c x))))
(defun m2 (p: Pt) -> i64 (let [c (cell p)] (do (set! c p) (. @c y))))
(defun m3 (&c) (set! c 4))
(defun m4 (&c) (let [f (fn () (set! c 5))] (f)))
;; `async` and `await`
(defun a1 (p: Pt) (async (. p x)))
(defun a2 (n: i64) (async (+ n 1)))
(defun main () -> i64 0)
