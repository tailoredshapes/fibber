(defstruct Pt (x: i64 y: i64))
(defun keep (s: Pt) -> Pt s)
(defun see (s: Pt) -> i64 (. s x))
(defun count-down (n: i64 acc: i64) -> i64 (if (= n 0) acc (count-down (- n 1) (+ acc n))))
(defun fwd (t: Pt) -> Pt (keep t))
(defun peek-local (n: i64) -> i64 (let ((p (Pt n n))) (see p)))
(defun give-local (n: i64) -> Pt (let ((p (Pt n n))) (keep p)))
(defun twice (p: Pt) -> Pt (do (keep p) (keep p)))
(defun apply1 (f: (fn (i64) i64) x: i64) -> i64 (f x))
(defun adder (n: i64) -> i64 (let ((g (fn (x: i64) -> i64 (+ x n)))) (apply1 g 2)))
(defun lp (n: i64) -> i64 (loop ((i 0) (acc 0)) (if (> i n) acc (recur (+ i 1) (+ acc i)))))
(defun lv (n: i64) -> (Vec i64) (loop ((i 0) (v (vec-empty))) (if (> i n) v (recur (+ i 1) (vec-conj v i)))))
(defun lq (n: i64) -> i64 (loop ((i 0) (p (Pt 0 0))) (if (> i n) (. p x) (let ((q (Pt i i))) (recur (+ i 1) q)))))
(defun bar (&a) (append &a 2))
(defun tail-amp () (let ((x (cell [3 4]))) (bar &x)))
(defun use-amp (&v) (let ((f (fn (x) (append &v x)))) (f 1)))
(defun pusher (&v) (vec-count @v))
(defun ping (n: i64 p: Pt) -> Pt (if (> n 0) (pong (- n 1) p) p))
(defun pong (n: i64 p: Pt) -> Pt (ping n (keep p)))
(defun later (n: i64) (async (+ n 1)))
(defun cellular (v: (Vec i64)) (cell v))
(defun main () -> i64 (+ (count-down 3 0) (see (give-local 1))))
