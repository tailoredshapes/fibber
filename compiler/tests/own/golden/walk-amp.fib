;; The carriers of an `&` parameter (own.walk.lit `walk-body`, spec/types.md §6.6): `k` is a closure
;; that captures `&v`, so `(g &v k)` is not a forwarded `&` argument. The golden text is `fibref own`.
(defun g (&w: i64 k: (fn () unit) :borrow) -> i64 (do (set! w 1) (k) @w))
(defun f (&v: i64) -> i64 (let [k (fn () (set! v 7))] (g &v k)))
(defun main () -> i64 (let [c (cell 0)] (let [r (f &c)] (+ (* 10 r) @c))))
