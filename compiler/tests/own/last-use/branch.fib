;; One arm hands `b` over at its last use, the other does not use it: the `eat b` is `moved`, and the
;; arm that kept the count releases it at its own end (the `release [b]` of the true arm).
(defstruct Box (n: i64))
(defun pick (b: Box eat: (fn (Box) i64) flag: bool) -> Box
  (if flag
      b
      (let ((x (eat b))) (Box x))))
(defun main () -> i64
  (. (pick (Box 5) (fn (b: Box) (. b n)) false) n))
