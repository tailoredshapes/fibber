;; `&c` handed to a callee: `move in` when nothing else can read the cell during the call (no closure captures it, no
;; other operand mentions it), else `acquire` (copy-in with a retain).
(defun bump (&a: (Array i64)) -> unit (array-set! &a 0 9))
(defun poke (&a: (Array i64) f: (fn () i64)) -> i64
  (do (array-set! &a 0 9)
      (f)))

(defun moved () -> i64
  (let ((c (cell (array 4 1))))
    (do (bump &c)
        (array-get @c 0))))

(defun captured () -> i64
  (let ((c (cell (array 4 1))))
    (let ((peek (fn () (array-get @c 0))))
      (poke &c peek))))

(defun main () -> i64 0)
