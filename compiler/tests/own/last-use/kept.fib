;; Not a last use: `b` is read again after `eat b` (through an alias, after the `if`, by a closure that
;; captured it, by a part of it): every `eat b` below is `retain`.
(defstruct Box (n: i64))
(defstruct Pair2 (a: Box b: Box))
(defun alias (b: Box eat: (fn (Box) i64) flag: bool) -> Box
  (if flag b (let ((a b) (x (eat b))) (Box (+ x (. a n))))))
(defun after-if (b: Box eat: (fn (Box) i64) flag: bool) -> Box
  (if flag b (let ((x (if (> (. b n) 3) (eat b) 1))) (Box (+ x (. b n))))))
(defun captured (b: Box eat: (fn (Box) i64) flag: bool) -> Box
  (if flag b (let ((get (fn () (. b n)))) (let ((x (eat b))) (Box (+ x (get)))))))
(defun part (p: Pair2 eat: (fn (Pair2) i64) flag: bool) -> Pair2
  (if flag p (let ((a (. p a))) (let ((x (eat p))) (Pair2 (Box (+ x (. a n))) (Box 0))))))
(defun main () -> i64 0)
