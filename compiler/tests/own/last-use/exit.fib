;; `b` is bound outside the loop: consumed on the path that leaves it only (moved there), and consumed
;; in the loop each iteration (retained: the next iteration reads it).
(defstruct Box (n: i64))
(defun once (eat: (fn (Box) i64)) -> i64
  (let ((b (Box 9)))
    (loop ((i 0))
      (if (< i 3) (recur (+ i 1)) (let ((x (eat b))) x)))))
(defun every (eat: (fn (Box) i64)) -> i64
  (let ((b (Box 5)))
    (loop ((i 0) (acc 0))
      (if (< i 3) (recur (+ i 1) (+ acc (eat b))) acc))))
(defun main () -> i64 0)
