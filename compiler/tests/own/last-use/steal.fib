;; A field of a shell at its last use, the shell read no more as a whole: `main`'s `(cell a)` is `steal` (the emitter tests
;; the shell's uniqueness at run time). Never stolen: from a borrowed parameter's shell (`taken`, `twice`: the caller
;; owns it), or from a shell that is a part of another object (`part`). `taken` would also keep the field because the
;; shell is read again by `(. h b)`.
(defstruct Holder (a: (Array i64) b: (Array i64)))
(defstruct Outer (h: Holder))
(defun keep (h: Holder) -> Holder h)

(defun taken (h: Holder) -> i64
  (match h
    ((Holder a b)
     (let ((c (cell a)))
       (do (array-set! &c 0 9)
           (+ (array-get @c 0) (array-get (. h b) 0)))))))

(defun twice (h: Holder) -> i64
  (match h
    ((Holder a b)
     (+ (array-len a) (array-len a)))))

(defun part (o: Outer) -> i64
  (match (. o h)
    ((Holder a b)
     (let ((c (cell a)))
       (do (array-set! &c 0 9)
           (array-get @c 0))))))

(defun main () -> i64
  (let ((h (keep (Holder (array 4 1) (array 4 2)))))
    (match h
      ((Holder a b)
       (let ((c (cell a)))
         (do (array-set! &c 0 9)
             (array-get @c 0)))))))
