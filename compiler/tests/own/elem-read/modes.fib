(defstruct Box (n: i64))
(defstruct Holder (arr: (Array Box)))
(defun see (b: Box) -> i64 (. b n))
(defun keep (b: Box) -> Box b)
(defun mk () -> Holder (Holder (array 1 (Box 1))))
(defun of-param (a: (Array Box)) -> i64 (see (array-get a 0)))
(defun of-field (h: Holder) -> i64 (see (array-get (. h arr) 0)))
(defun of-local (a: (Array Box)) -> i64 (let ((e (array-get a 0))) (+ (see e) (see e))))
(defun returned (a: (Array Box)) -> Box (array-get a 0))
(defun passed-on (a: (Array Box)) -> Box (keep (array-get a 0)))
(defun of-cell (c: (Cell (Array Box))) -> i64 (see (array-get @c 0)))
(defun of-temp () -> i64 (see (array-get (array 1 (Box 2)) 0)))
(defun of-temp-field () -> i64 (see (array-get (. (mk) arr) 0)))
(defun main () -> i64 0)
