;; compiler/tests/own/peek-probe.fib: the program compiler/tests/own/peek.sh emits: `peeked` reads the content of its `&` cell at a borrowed
;; position and with a scalar read, and must take no count (spec/types.md §6.3, "Cell peeks"); `acquired` reads the same content into a
;; binding, which outlives the step, and must retain and release it; `named` reads the cell with a sibling operand that names it, which
;; must acquire.
(defun total (a: (Array i64)) -> i64 (array-get a 3))

(defun peeked (&c: (Array i64)) -> i64 (+ (total @c) (array-get @c 1)))

(defun acquired (&c: (Array i64)) -> i64 (let [x @c] (+ (total x) (array-get x 1))))

(defun named (&c: (Array i64)) -> i64 (array-get @c (do (array-set! &c 0 1) 1)))

(defun main () -> i64
  (let [c (cell (array 4 2))]
    (+ (peeked &c) (+ (acquired &c) (named &c)))))
