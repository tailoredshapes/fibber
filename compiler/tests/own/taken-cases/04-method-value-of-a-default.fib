;; taken: an instance that takes the protocol's default for a method has an implementation of it
;; (the `ImplMethod` the default made); an instance that overrides it has one too, and a second
;; method that no value names is never listed.
(defprotocol Step (step (self) -> i64 7) (other (self) -> i64 8))
(defstruct J (n: i64))
(defstruct K (n: i64))
(impl Step J)
(impl Step K (step (self) (. self n)))
(defun apply-it (f: (fn (a) i64) x: a) -> i64 (f x))
(defun main () -> i64 (+ (apply-it step (J 1)) (apply-it step (K 2))))
