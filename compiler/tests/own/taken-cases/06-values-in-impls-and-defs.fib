;; taken: the values are looked for in the bodies of impl methods and in the initialisers of defs,
;; as well as in `defun`s; a function taken only there is listed.
(defun inc (x: i64) -> i64 (+ x 1))
(defun dec (x: i64) -> i64 (- x 1))
(defun apply-it (f: (fn (i64) i64) x: i64) -> i64 (f x))
(def step: (fn (i64) i64) inc)
(defprotocol Score (score (self) -> i64))
(defstruct W (n: i64))
(impl Score W (score (self) (apply-it dec (. self n))))
(defun main () -> i64 (+ (apply-it step 1) (score (W 2))))
