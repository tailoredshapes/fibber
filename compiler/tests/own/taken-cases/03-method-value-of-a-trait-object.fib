;; taken: a method value on a `dyn` receiver (`Resolution::Dyn`) may run every instance.
(defprotocol Score (score (self) -> i64))
(defstruct A (n: i64))
(defstruct B (n: i64))
(impl Score A (score (self) (. self n)))
(impl Score B (score (self) 1))
(defun apply-it (f: (fn (a) i64) x: a) -> i64 (f x))
(defun main () -> i64 (let ((d (dyn Score (A 1)))) (apply-it score d)))
