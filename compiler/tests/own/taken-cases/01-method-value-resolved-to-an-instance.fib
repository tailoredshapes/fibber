;; taken: a method value that the checker resolved to an instance runs that instance's implementation
;; (taken.rs `implementations`, `Resolution::Instance`): one `taken method`, and the instance of bool
;; (never named at the value) is left out.
(defprotocol Score (score (self) -> i64))
(impl Score i64 (score (self) self))
(impl Score bool (score (self) (if self 1 0)))
(defun apply-it (f: (fn (a) i64) x: a) -> i64 (f x))
(defun main () -> i64 (apply-it score 2))
