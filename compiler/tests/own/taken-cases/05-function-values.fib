;; taken: a function named anywhere but the head of a call is taken: as an argument, in a let, inside
;; a closure, as the head of a call whose head is not itself a name (`((do inc2) 1)`), and a function
;; that is only called (`dec`, `twice`) is not.
(defun inc (x: i64) -> i64 (+ x 1))
(defun inc2 (x: i64) -> i64 (+ x 2))
(defun dec (x: i64) -> i64 (- x 1))
(defun twice (x: i64) -> i64 (* x 2))
(defun hop (x: i64) -> i64 (+ x 3))
(defun cons-up (x: i64) -> i64 (+ x 4))
(defun apply-it (f: (fn (i64) i64) x: i64) -> i64 (f x))
(defun main () -> i64
  (let ((f inc) (g (fn (y: i64) (apply-it hop y))))
    (+ (apply-it f 1) (g 2) ((do inc2) 1) (dec 3) (twice 4) (apply-it (fn (z: i64) (cons-up z)) 5))))
