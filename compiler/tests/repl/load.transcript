15
fib> :defs
(defun twice (x: i64) -> i64 (* 2 x))
(defun thrice (x: i64) -> i64 (* 3 x))
fib> :reload
; redefined twice, thrice
42
fib> :load compiler/tests/repl/no-such-file.fib
; cannot read compiler/tests/repl/no-such-file.fib
