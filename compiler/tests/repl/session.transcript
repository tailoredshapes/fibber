fib> (defun sq (x: i64) -> i64 (* x x))
; defined sq
fib> (sq 7)
49
fib> (+ 1 2)
3
fib> "hello"
"hello"
fib> [1 2 3]
[1 2 3]
fib> (defun cube (x: i64) -> i64
...    (* x (sq x)))
; defined cube
fib> (cube 3)
27
fib> (require [fib.math :as m])
; defined (:require [fib.math :as m])
fib> (m/sqrt 16.0)
4.0
fib> (defrecord Pt (x: i64 y: i64))
; defined Pt
fib> (Pt 1 2)
#main.Pt{:x 1, :y 2}
fib> (defun norm1 (p: Pt) -> i64 (+ (. p x) (. p y)))
; defined norm1
fib> (norm1 (Pt 3 4))
7
fib> (def answer: i64 42)
; defined answer
fib> (+ answer 1)
43
fib> (println "side effect")
side effect
fib> :time (+ answer 1)
43
; front end N ms (47 modules, 0 expanded, 47 reused), run N ms
fib> :type (norm1 (Pt 3 4))
(norm1 (Pt 3 4)) : i64
fib> :type (map inc [1 2 3])
(map inc [1 2 3]) : (LSeq i64)
fib> :type "abc"
"abc" : str
fib> :doc norm1
(defun norm1 (p: Pt) -> i64 (+ (. p x) (. p y)))
fib> :defs
(:require [fib.math :as m])
(defun sq (x: i64) -> i64 (* x x))
(defun cube (x: i64) -> i64
  (* x (sq x)))
(defrecord Pt (x: i64 y: i64))
(defun norm1 (p: Pt) -> i64 (+ (. p x) (. p y)))
(def answer: i64 42)
fib> :reset
; the session is empty
fib> :defs
fib> (+ 1 2)
3
fib> :quit
