(defun sq (x: i64) -> i64 (* x x))
(sq 7)
(+ 1 2)
"hello"
[1 2 3]
(defun cube (x: i64) -> i64
  (* x (sq x)))
(cube 3)
(require [fib.math :as m])
(m/sqrt 16.0)
(defrecord Pt (x: i64 y: i64))
(Pt 1 2)
(defun norm1 (p: Pt) -> i64 (+ (. p x) (. p y)))
(norm1 (Pt 3 4))
(def answer: i64 42)
(+ answer 1)
(println "side effect")
:time (+ answer 1)
:type (norm1 (Pt 3 4))
:type (map inc [1 2 3])
:type "abc"
:doc norm1
:defs
:reset
:defs
(+ 1 2)
:quit
(+ 100 200)
