fib> (defun first-of (v: (Vec i64)) -> i64 (nth v 0))
; defined first-of
fib> (first-of [9 8])
9
fib> (first-of [])
trap: nth: index out of range
; the program trapped (status 134); the session is unchanged
fib> (first-of [4])
4
fib> (nth [1 2] 5)
trap: nth: index out of range
; the program trapped (status 134); the session is unchanged
fib> (/ 1 0)
trap: ratio: divide by zero
; the program trapped (status 134); the session is unchanged
fib> (+ 1 2)
3
fib> (defun spin (n: i64) -> i64 (loop ((i 0)) (if (< i n) (recur (+ i 1)) i)))
; defined spin
fib> (spin 1000)
1000
fib> :defs
(defun first-of (v: (Vec i64)) -> i64 (nth v 0))
(defun spin (n: i64) -> i64 (loop ((i 0)) (if (< i n) (recur (+ i 1)) i)))
