;; compiler/tests/gen/rng-check.fib: prints, for the seeds of compiler/tests/golden/gen/rng.tsv, the same columns as that file, so that rng-check.sh can
;; diff them. The columns: seed; next x5; below 7 x8; below 1000003 x8; range -3 9 x8; chance 60 x8; weighted [3 0 5 1] x8.
(ns main
  (:require [gen.rng :as rng]))

(defun cols (seed: i64 n: i64 f: (fn (rng/FgRng) i64)) -> unit
  (let ((r (rng/rng-new seed)))
    (loop ((i 0))
      (if (< i n)
          (do (if (> i 0) (print " ") ())
              (print (f r))
              (recur (+ i 1)))
          ()))))

(defun weighted-index (r: rng/FgRng) -> i64
  (match (rng/rng-weighted r [3 0 5 1])
    ((some i) i)
    (nil -1)))

(defun line (seed: i64) -> unit
  (do (print seed)
      (print "\t") (cols seed 5 (fn (r: rng/FgRng) (rng/rng-next r)))
      (print "\t") (cols seed 8 (fn (r: rng/FgRng) (rng/rng-below r 7)))
      (print "\t") (cols seed 8 (fn (r: rng/FgRng) (rng/rng-below r 1000003)))
      (print "\t") (cols seed 8 (fn (r: rng/FgRng) (rng/rng-range r -3 9)))
      (print "\t") (cols seed 8 (fn (r: rng/FgRng) (if (rng/rng-chance r 60) 1 0)))
      (print "\t") (cols seed 8 weighted-index)
      (println "")))

(defun main () -> i64
  (do (line 0) (line 1) (line 42) (line 1409) (line 123456789) (line -1) (line -9223372036854775808)
      0))
