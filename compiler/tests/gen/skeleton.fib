;; compiler/tests/gen/skeleton.fib: requires every module of compiler/gen (the fibgen port) and refers to one function of each, so that the seed
;; loads and type-checks all of them (a module nothing refers to is not loaded). Run by skeleton.sh. When a module is added, add it here.
(ns main
  (:require
    [gen.arrays :as m0]
    [gen.ast :as m1]
    [gen.cli :as m2]
    [gen.consts :as m3]
    [gen.control :as m4]
    [gen.core :as m5]
    [gen.coverage :as m6]
    [gen.ctx :as m7]
    [gen.derive :as m8]
    [gen.driver :as m9]
    [gen.effects :as m10]
    [gen.funcs :as m11]
    [gen.gadgets :as m12]
    [gen.gadgets2 :as m13]
    [gen.helpers :as m14]
    [gen.hooks :as m15]
    [gen.inout :as m16]
    [gen.jobs :as m17]
    [gen.lambdas :as m18]
    [gen.mcalls :as m19]
    [gen.model :as m20]
    [gen.model.builtins :as m21]
    [gen.model.nums :as m22]
    [gen.model.patterns :as m23]
    [gen.model.pipelines :as m24]
    [gen.model.value :as m25]
    [gen.nums :as m26]
    [gen.objects :as m27]
    [gen.observe :as m28]
    [gen.pipelines :as m29]
    [gen.print :as m30]
    [gen.protos :as m31]
    [gen.report :as m32]
    [fib.rng :as m33]
    [gen.run :as m34]
    [gen.scalar :as m35]
    [gen.shrink :as m36]
    [gen.state :as m37]
    [gen.tasks :as m38]
    [gen.ty :as m39]
    [gen.vpat :as m40]
    [gen.print.pipelines :as m41]
    [gen.print.sexp :as m42]
    [gen.model.expected :as m43]))

(defun main () -> i64
  (let [f0 m0/arrays-array-int
        f1 m1/pipe-none
        f2 m2/cli-parse
        f3 m3/consts-constant
        f4 m4/control-is-send-fn
        f5 m5/core-expr
        f6 m6/coverage-new
        f7 m7/var-new
        f8 m8/derive-value
        f9 m9/driver-size-of
        f10 m10/effects-stmt
        f11 m11/funcs-literal
        f12 m12/gadgets-gadget
        f13 m13/gadgets2-gadget
        f14 m14/helpers-helper-call
        f15 m15/hooks-hook
        f16 m16/inout-stmt-call
        f17 m17/jobs-idle
        f18 m18/lambdas-calls
        f19 m19/mcalls-macro-int
        f20 m20/machine-new
        f21 m21/builtins-call
        f22 m22/nums-op
        f23 m23/patterns-bind-vector
        f24 m24/pipelines-ev
        f25 m25/env-bind
        f26 m26/nums-int-expr
        f27 m27/objects-object
        f28 m28/observe-observe
        f29 m29/pipelines-generate
        f30 m30/print-program
        f31 m31/protos-impls
        f32 m32/report-header
        f33 m33/rng-new
        f34 m34/class-finding?
        f35 m35/scalar-literal-text
        f36 m36/shrink-smallest
        f37 m37/gen-new
        f38 m38/tasks-await-yield
        f39 m39/num-name
        f40 m40/vpat-vector-match
        f41 m41/pipes-sexp
        f42 m42/print-flat
        f43 m43/model-expected]
    (do (println "ok") 0)))
