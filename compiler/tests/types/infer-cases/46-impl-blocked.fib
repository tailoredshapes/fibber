;; case: an impl method using a failed function is skipped (judged by compare.sh against `fibref types --stage infer --sections unit,error`)
(defprotocol Score (score (self) -> i64))
(defstruct Pt (x: i64))
(defun bad () -> i64 (+ 1 true))
(impl Score Pt (score (self) (bad)))
(defun main () -> i64 (score (Pt 3)))
