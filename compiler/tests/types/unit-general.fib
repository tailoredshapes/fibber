;; compiler/tests/types/unit-general.fib: crates/fibref/src/types/infer/general.rs,
;; which has no inline test, written from the code: the keys of a type, the
;; numbering and naming of the quantified variables (letters that skip the
;; unit's rigid names, rigid variables under their own names), the colour
;; solution under the map, `apply` (zonks, an unquantified variable is i64),
;; the colour bounds (flows followed through unquantified variables, symbolic
;; captures, sorted by the Debug text of the bound: Gen(10) before Gen(2)),
;; the pieces of `close` that need no solver (unresolved constraints,
;; ambiguity, determined variables in the order the constraints add them,
;; stuck `Send` reduced), `finalize` (tables, uses, sites, fn colours, the
;; worklists emptied) and `scheme` (the constraints whose variables the root
;; holds, once each). The pieces of `close` that call the solver are in
;; unit-general-close.fib.
;; Build: fibc build compiler/tests/types/unit-general.fib -I compiler -I lib -o OUT
(ns tests.types.unit-general (:use syntax.pos types.ty types.scheme types.error types.store types.table types.ast
               types.decls types.infer.cx types.infer.colour types.infer.general
               fib.test.unit)
  (:require [fib.test.run :as test-runner]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))
(defun pos-at (line: i64) -> Pos (Pos "t.fib" line 1 0 1))

(defun cx-new () -> Cx
  (Cx (globals-new) (env-new) (store-new) (tables-new) (unit-new)))

(defun colours-of (raised: (Map i64 Colour) must-send: (Set i64) symbolic: (Vec (Pair Colour Ty))
                   flows: (Vec (Pair Colour Colour))) -> Colours
  (Colours raised must-send symbolic flows))
(defun no-colours () -> Colours (colours-of (map-empty) (set-empty) [] []))

(defun fn-of (k: Colour params: (Vec Ty)) -> Ty (TFn k params (ty-i64)))
(defun v (i: i64) -> Ty (TVar i))
(defun cell-of (t: Ty) -> Ty (ty-cell t))

(defun keys-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)))
    (do
      (is cs (= (general-keys (. cx st) (TFn CSend [(v 1) (TRigid 0)] (cell-of (TCon KArray [(v 1) (v 2)]))))
                [(KeyVar 1) (KeyRigid 0) (KeyVar 2)]) "keys: each variable once, in order of first occurrence, rigid ones too")
      (is cs (empty? (general-keys (. cx st) (TFn (CVar 3) [(TGen 0)] (ty-i64)))) "keys: a quantified variable and a colour are not keys")
      (store-bind (. cx st) 1 (ty-i64))
      (is cs (= (general-keys (. cx st) (TCon KArray [(v 1) (v 4)])) [(KeyVar 4)]) "keys: the type is zonked first"))))

(defun naming-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)))
    (do
      (set! (. (. cx u) rigid-names) ["b" "T"])
      (is cs (= (. (genmap-new cx [(KeyVar 5) (KeyRigid 0) (KeyVar 6) (KeyRigid 1)] (no-colours) []) names)
                ["a" "b" "c" "T"]) "names: letters skip the unit's rigid names, a rigid variable keeps its own")
      (is cs (= (. (genmap-new cx [(KeyRigid 7)] (no-colours) []) names) [""]) "names: a rigid variable the unit does not name is called nothing")
      (let ((m (genmap-new cx [(KeyVar 5) (KeyRigid 0) (KeyVar 6)] (no-colours) [])))
        (is cs (and (= (get (. m vars) (KeyVar 5)) (some 0)) (= (get (. m vars) (KeyRigid 0)) (some 1))
                    (= (get (. m vars) (KeyVar 6)) (some 2)) (nil? (get (. m vars) (KeyVar 7)))) "vars: each key by its position in the order"))
      (set! (. (. cx u) rigid-names) [])
      (let ((order (mapv (fn (i: i64) (KeyVar i)) (range 28)))
            (names (. (genmap-new cx (mapv (fn (i: i64) (KeyVar i)) (range 28)) (no-colours) []) names)))
        (is cs (and (= (nth names 0) "a") (= (nth names 25) "z") (= (nth names 26) "a1") (= (nth names 27) "b1")) "names: past z the letters take a number (a1, b1)")))))

(defun colour-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (cols (colours-of (assoc (map-empty) 9 CLocal) (conj (set-empty) 11) [] []))
        (roots [(fn-of (CVar 7) []) (fn-of (CVar 3) [(fn-of (CVar 7) []) (fn-of (CVar 9) []) (fn-of (CVar 11) []) (fn-of CLocal [])])]))
    (let ((m (genmap-new cx [] cols roots)))
      (do
        (is cs (and (= (genmap-n-colours m) 2) (= (get (. m colour-gen) 7) (some 0)) (= (get (. m colour-gen) 3) (some 1))) "colours: the free colour variables of the roots are numbered in order of first occurrence")
        (is cs (and (nil? (get (. m colour-gen) 9)) (nil? (get (. m colour-gen) 11))) "colours: a variable the solution raised or fixed is not quantified")
        (is cs (and (= (genmap-colour m (CVar 7)) (CGen 0)) (= (genmap-colour m (CVar 3)) (CGen 1))) "colour: a quantified variable is its Gen")
        (is cs (and (= (genmap-colour m (CVar 9)) CLocal) (= (genmap-colour m (CVar 11)) CSend)) "colour: a raised variable is its value, a send one is send")
        (is cs (= (genmap-colour m (CVar 99)) CSend) "colour: a free variable that is not quantified is send (least)")
        (is cs (and (= (genmap-colour m CSend) CSend) (= (genmap-colour m CLocal) CLocal)
                    (= (genmap-colour m (CRigid 2)) (CRigid 2)) (= (genmap-colour m (CGen 5)) (CGen 5))) "colour: constants and Gens stay")))))

(defun apply-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)))
    (do
      (set! (. (. cx u) rigid-names) ["T"])
      (let ((m (genmap-new cx [(KeyVar 1) (KeyRigid 0)] (colours-of (map-empty) (set-empty) [] []) [(fn-of (CVar 7) [])]))
            (st (. cx st)))
        (do
          (is cs (= (genmap-apply m st (TFn (CVar 7) [(v 1) (TRigid 0) (v 99)] (v 1)))
                    (TFn (CGen 0) [(TGen 0) (TGen 1) (ty-i64)] (TGen 0))) "apply: variables and rigid ones become Gens, the colours too, an unquantified variable is i64")
          (is cs (= (genmap-apply m st (TRigid 3)) (TRigid 3)) "apply: a rigid variable the map lacks stays rigid")
          (store-bind st 1 (cell-of (v 99)))
          (is cs (= (genmap-apply m st (v 1)) (cell-of (ty-i64))) "apply: the type is zonked first (a bound variable is its type)")
          (is cs (and (= (genmap-pred m st (PProto 3 [(TRigid 0) (ty-str)])) (PProto 3 [(TGen 1) (ty-str)]))
                      (= (genmap-pred m st (PSend (TRigid 0))) (PSend (TGen 1)))
                      (= (genmap-pred m st (PObject (v 50))) (PObject (ty-i64)))
                      (= (genmap-pred m st (PWeakable (TRigid 0))) (PWeakable (TGen 1)))) "pred: the types of a predicate under the map"))))))

;; A map quantifying n colour variables 100.. as the colours of the parameters of one root.
(defun colour-root (n: i64) -> Ty
  (TFn (CVar 100) (mapv (fn (i: i64) (fn-of (CVar (+ 101 i)) [])) (range n)) (ty-i64)))

(defun bounds-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)) (st (store-new)))
    (do
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) [] [(Pair (CVar 100) (CVar 101))]) [(colour-root 1)])))
        (is cs (= (genmap-colour-bounds m st) [(BFlow (CGen 0) (CGen 1))]) "bounds: a flow between quantified colours"))
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) [] [(Pair (CVar 101) (CVar 100))]) [(colour-root 1)])))
        (is cs (= (genmap-colour-bounds m st) [(BFlow (CGen 1) (CGen 0))]) "bounds: the flow runs the other way"))
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) [] [(Pair (CVar 100) (CVar 900)) (Pair (CVar 900) (CVar 101))])
                           [(colour-root 1)])))
        (is cs (= (genmap-colour-bounds m st) [(BFlow (CGen 0) (CGen 1))]) "bounds: a flow through an unquantified variable is followed"))
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) [] [(Pair (CVar 100) (CVar 101)) (Pair (CVar 100) (CVar 101))])
                           [(colour-root 1)])))
        (is cs (= (count (genmap-colour-bounds m st)) 1) "bounds: a repeated flow is one bound"))
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) [] [(Pair (CVar 100) (CVar 100))]) [(colour-root 1)])))
        (is cs (empty? (genmap-colour-bounds m st)) "bounds: a colour does not bound itself"))
      (let ((m (genmap-new cx [(KeyVar 1)] (colours-of (map-empty) (set-empty) [(Pair (CVar 101) (v 1))] [(Pair (CVar 100) (CVar 101))])
                           [(colour-root 1)])))
        (is cs (= (genmap-colour-bounds m st)
                  [(BCaps (CGen 1) (TGen 0)) (BFlow (CGen 0) (CGen 1))]) "bounds: a symbolic capture bounds every quantified colour that reaches it, Caps before Flow"))
      (let ((m (genmap-new cx [(KeyVar 1)] (colours-of (map-empty) (set-empty) [(Pair (CVar 100) (v 1))] [(Pair (CVar 100) (CVar 101))])
                           [(colour-root 1)])))
        (is cs (= (genmap-colour-bounds m st)
                  [(BCaps (CGen 0) (TGen 0)) (BCaps (CGen 1) (TGen 0)) (BFlow (CGen 0) (CGen 1))]) "bounds: a symbolic capture also bounds the colours that follow it along flows"))
      (let ((m (genmap-new cx [] (colours-of (map-empty) (set-empty) []
                                             (mapv (fn (i: i64) (Pair (CVar 100) (CVar (+ 101 i)))) (range 11)))
                           [(colour-root 11)])))
        (is cs (= (mapv (fn (b: ColourBound) (match b ((BFlow _ (CGen i)) i) (_ -1))) (genmap-colour-bounds m st))
                  [1 10 11 2 3 4 5 6 7 8 9]) "bounds: sorted by Debug text, so Gen(1) Gen(10) Gen(11) Gen(2) .. Gen(9)")))))

(defun debug-tests (cs: StepLog) -> unit
  (do
    (is cs (= (debug-bound (BCaps (CGen 2) (TFn (CRigid 1) [(TCon (KScalar SI64) []) (TVar 3)
                                                              (TCon (KNominal 4) [(TGen 0) (TCon (KDyn 5 true) [])])]
                                             (TCon KStr []))))
              "Caps(Gen(2), Fn(Rigid(1), [Con(Scalar(I64), []), Var(TvId(3)), Con(Nominal(TypeId(4)), [Gen(0), Con(Dyn(ProtoId(5), true), [])])], Con(Str, [])))") "debug: a Caps bound as derive(Debug) writes it (checked against rustc)")
    (is cs (= (debug-bound (BFlow CSend (CVar 7))) "Flow(Send, Var(CvId(7)))") "debug: a Flow bound")
    (is cs (and (= (debug-colour CLocal) "Local")
                (= (debug-ty (TCon KArray [])) "Con(Array, [])")
                (= (debug-ty (TCon KCell [])) "Con(Cell, [])")
                (= (debug-ty (TCon KAtom [])) "Con(Atom, [])")
                (= (debug-ty (TCon KWeak [])) "Con(Weak, [])")
                (= (debug-ty (TCon KTask [])) "Con(Task, [])")
                (= (debug-ty (TCon (KDyn 1 false) [])) "Con(Dyn(ProtoId(1), false), [])")) "debug: the other constants")
    (is cs (= (mapv (fn (s: Scalar) (debug-ty (TCon (KScalar s) []))) (scalar-all))
              (mapv (fn (n: str) (str-join ["Con(Scalar(" n "), [])"]))
                    ["Bool" "I8" "I16" "I32" "I64" "F32" "F64" "Char" "Keyword" "Unit" "Ptr"])) "debug: the scalars")))

;; ---- pieces of close

(defun proto-cx () -> Cx
  (let ((cx (cx-new)))
    (do (table-add (. (. cx g) protos) (ProtoDef "Show" 2 [] [] [] p0))
        cx)))

(defun deferred (kind: DKind line: i64) -> Deferred (Deferred kind (pos-at line) nil "f"))
(defun set-deferred (cx: Cx ds: (Vec Deferred)) -> unit (set! (. (. cx u) deferred) ds))
(defun err-text (r: (Result unit TypeError)) -> str (match r ((Err e) (. e message)) (_ "")))
(defun err-kind (r: (Result unit TypeError)) -> ErrorKind (match r ((Err e) (. e kind)) (_ Resolve)))
(defun err-line (r: (Result unit TypeError)) -> i64 (match r ((Err e) (. (. e pos) line)) (_ 0)))
(defun ok? (r: (Result unit TypeError)) -> bool (match r ((Ok _) true) (_ false)))

(defun unresolved-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)))
    (do
      (set-deferred cx [])
      (is cs (ok? (check-unresolved cx)) "unresolved: nothing deferred, nothing wrong")
      (set-deferred cx [(deferred (DkSend (v 1) []) 2) (deferred (DkWeakable (v 1)) 3)])
      (is cs (ok? (check-unresolved cx)) "unresolved: stuck Send and Weakable are not reported here")
      (set-deferred cx [(deferred (DkSend (v 1) []) 2)
                        (deferred (DkField (v 1) "x" (v 2) "p") 3)
                        (deferred (DkDeref (v 3) (v 4) "q") 4)])
      (let ((r (check-unresolved cx)))
        (is cs (and (= (err-kind r) FieldUnresolved) (= (err-line r) 3)
                    (= (err-text r) "cannot infer the struct type of p for field x; annotate it")) "unresolved: a field of an unknown struct, the first one, at its position"))
      (set-deferred cx [(deferred (DkDeref (v 3) (v 4) "(deref p)") 4) (deferred (DkField (v 1) "x" (v 2) "p") 5)])
      (let ((r (check-unresolved cx)))
        (is cs (and (= (err-kind r) DerefUnresolved) (= (err-line r) 4)
                    (= (err-text r) "cannot infer whether (deref p) is a cell, an atom, a weak reference or a task")) "unresolved: a deref of an unknown type"))
      (set-deferred cx [(deferred (DkFloat (v 8)) 6)])
      (let ((r (check-unresolved cx)))
        (is cs (and (= (err-kind r) Ambiguous) (= (err-line r) 6)
                    (= (err-text r) "cannot infer which float type a is; annotate it")) "unresolved: a float whose type is unknown (shown with the unit's names)")))))

(defun ambiguous-tests (cs: StepLog) -> unit
  (let ((cx (proto-cx)))
    (do
      (set-deferred cx [(deferred (DkProto 0 [(v 3)] nil) 7)])
      (let ((r (check-ambiguous cx [(KeyVar 1)])))
        (is cs (and (= (err-kind r) Ambiguous) (= (err-line r) 7)
                    (= (err-text r) "ambiguous constraint Show a in f; add an annotation")) "ambiguous: a protocol constraint on a variable no root holds"))
      (is cs (ok? (check-ambiguous cx [(KeyVar 3)])) "ambiguous: the variable is in the union")
      (set-deferred cx [(deferred (DkProto 0 [(v 3) (v 9)] nil) 7)])
      (is cs (ok? (check-ambiguous cx [(KeyVar 3)])) "ambiguous: only the dispatch argument is looked at")
      (set-deferred cx [(deferred (DkSend (v 3) []) 7) (deferred (DkProto 0 [(TCon KArray [(v 3) (v 4)])] nil) 8)
                        (deferred (DkProto 0 [(v 5)] nil) 9)])
      (let ((r (check-ambiguous cx [(KeyVar 3)])))
        (is cs (and (= (err-line r) 8) (= (err-text r) "ambiguous constraint Show (Array a b) in f; add an annotation")) "ambiguous: the first offending constraint, any variable of the dispatch type, shown with its own letters")))))

(defun determined-tests (cs: StepLog) -> unit
  (let ((cx (cx-new)))
    (do
      (set-deferred cx [])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1)]) "determined: no constraints, the set stays")
      (set-deferred cx [(deferred (DkProto 0 [(v 1) (v 7)] nil) 1) (deferred (DkProto 0 [(v 6) (v 8)] nil) 2)])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1) (KeyVar 7)]) "determined: a constraint whose dispatch is in the set adds its variables, in order; one whose dispatch is not does not")
      (set-deferred cx [(deferred (DkProto 0 [(v 6) (v 8)] nil) 2) (deferred (DkProto 0 [(v 7) (v 6)] nil) 1)
                        (deferred (DkProto 0 [(v 1) (v 7)] nil) 3)])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1) (KeyVar 7) (KeyVar 6) (KeyVar 8)]) "determined: a later pass picks up what an earlier constraint reaches")
      (set-deferred cx [(deferred (DkProto 0 [(v 1) (v 6)] nil) 1) (deferred (DkProto 0 [(v 1) (v 7)] nil) 2)])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1) (KeyVar 6) (KeyVar 7)]) "determined: the additions follow the order of the constraints")
      (set-deferred cx [(deferred (DkProto 0 [(v 7) (v 1)] nil) 1) (deferred (DkProto 0 [(v 1) (v 7)] nil) 2)])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1) (KeyVar 7)]) "determined: it ends when nothing is added")
      (set-deferred cx [(deferred (DkSend (v 1) []) 1) (deferred (DkProto 0 [(TCon KArray [(v 1) (v 7)])] nil) 2)])
      (is cs (= (determined cx [(KeyVar 1)]) [(KeyVar 1) (KeyVar 7)]) "determined: a dispatch type holding any variable of the set determines the rest"))))

(defun sends-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (d-array (Deferred (DkSend (TCon KArray [(v 2)]) []) (pos-at 5) (some 4) "g")))
    (do
      (set-deferred cx [(deferred (DkWeakable (v 9)) 1)
                        (deferred (DkSend (fn-of (CVar 5) []) ["x"]) 2)
                        d-array
                        (deferred (DkSend (cell-of (ty-i64)) ["c"]) 6)])
      (reduce-sends cx)
      (let ((ds @(. (. cx u) deferred))
            (cons @(. (. cx u) colours)))
        (do
          (is cs (and (= (count ds) 3)
                      (match (. (nth ds 0) kind) ((DkWeakable _) true) (_ false))
                      (match (. (nth ds 1) kind) ((DkSend (TVar 2) _) true) (_ false))
                      (match (. (nth ds 2) kind) ((DkSend (TCon (KCell) _) _) true) (_ false))) "reduce-sends: what is not a Send, a Send that fails and a Send on a variable stay, a closure's Send goes")
          (is cs (and (= (. (. (nth ds 1) pos) line) 5) (= (. (nth ds 1) site) (some 4)) (= (. (nth ds 1) fun) "g")) "reduce-sends: the variable's Send keeps the position, site and function of the constraint")
          (is cs (and (= (count cons) 1) (= (. (nth cons 0) from) (CVar 5)) (= (. (nth cons 0) to) CSend)
                      (= (. (nth cons 0) label) (some "x")) (nil? (. (nth cons 0) origin))
                      (= (. (. (nth cons 0) pos) line) 2)) "reduce-sends: a closure's colour is bounded by send, with the path as the label"))))))

;; ---- finalize

(defun bound-is? (r: (Option Resolution) p: Pred) -> bool
  (match r ((some (ResBound q)) (= p q)) (_ false)))

(defun finalize-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (cols (colours-of (map-empty) (set-empty) [] []))
        (u (. cx u))
        (tb (. cx t)))
    (do
      (set! (. u rigid-names) ["T"])
      (set! (. tb expr-types) (assoc (assoc (map-empty) 1 (v 1)) 2 (TRigid 0)))
      (set! (. u exprs) [1 2 77 1])
      (set! (. tb binding-types) (assoc (map-empty) 5 (fn-of (CVar 7) [(v 1)])))
      (set! (. u bindings) [5])
      (set! (. tb instantiations) (assoc (map-empty) 3 (Instantiation [(v 1) (v 40)] [(CVar 7) CLocal (CVar 8)])))
      (set! (. u insts) [3 78])
      (set! (. tb resolutions)
            (assoc (assoc (assoc (map-empty) 10 (ResInstance 4 [(v 1)])) 11 (ResBound (PProto 0 [(v 1)]))) 12 ResDyn))
      (set! (. u sites) [10 11 12 13])
      (set! (. u fn-lits) [(Pair 30 (CVar 7)) (Pair 31 (CVar 8))])
      (let ((m (genmap-new cx [(KeyVar 1) (KeyRigid 0)] cols [(fn-of (CVar 7) [])]))
            (closed (Closed [] cols [(Pair (PProto 0 [(v 1)]) (some 20)) (Pair (PSend (v 1)) nil)])))
        (do
          (cx-finalize cx m closed)
          (is cs (and (bound-is? (get @(. tb resolutions) 20) (PProto 0 [(TGen 0)]))
                      (= (count @(. tb resolutions)) 4)) "finalize: a remaining constraint with a method site is resolved by its bound, one without is not")
          (is cs (and (= (get @(. tb expr-types) 1) (some (TGen 0))) (= (get @(. tb expr-types) 2) (some (TGen 1)))
                      (= (count @(. tb expr-types)) 2) (empty? @(. u exprs))) "finalize: the types of the expressions are under the map, once, and the list is emptied")
          (is cs (and (= (get @(. tb binding-types) 5) (some (TFn (CGen 0) [(TGen 0)] (ty-i64))))
                      (empty? @(. u bindings))) "finalize: so are the types of the bindings")
          (is cs (and (match (get @(. tb instantiations) 3)
                        ((some i) (and (= (. i tys) [(TGen 0) (ty-i64)]) (= (. i colours) [(CGen 0) CLocal CSend])))
                        (_ false))
                      (empty? @(. u insts)) (nil? (get @(. tb instantiations) 78))) "finalize: an instantiation's types and colours are under the map")
          (is cs (and (match (get @(. tb resolutions) 10)
                        ((some (ResInstance i args)) (and (= i 4) (= args [(TGen 0)])))
                        (_ false))
                      (bound-is? (get @(. tb resolutions) 11) (PProto 0 [(TGen 0)]))
                      (match (get @(. tb resolutions) 12) ((some (ResDyn)) true) (_ false))
                      (nil? (get @(. tb resolutions) 13)) (empty? @(. u sites))) "finalize: an instance resolution's arguments and a bound's predicate are under the map; a dyn stays")
          (is cs (and (= (get @(. tb fn-colours) 30) (some (CGen 0))) (= (get @(. tb fn-colours) 31) (some CSend))
                      (empty? @(. u fn-lits))) "finalize: a function literal's colour is under the map"))))))

;; S1: an occurrence of a fully annotated member of the unit is one of its scheme, at every
;; variable of the scheme (infer/general.rs:406 scheme_instantiation).
(defun finalize-poly-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (cols (colours-of (map-empty) (set-empty) [] []))
        (u (. cx u))
        (tb (. cx t)))
    (do
      (set! (. u rigid-names) ["T" "U"])
      (set! (. u poly-calls) [(PolyCall 1 7 3 p0)])
      (set! (. u poly-vars) (assoc (map-empty) 7 [1 5]))
      (set! (. tb instantiations)
            (assoc (assoc (map-empty) 3 (Instantiation [(ty-i64) (ty-str)] [])) 4 (Instantiation [(v 1)] [])))
      (set! (. u insts) [3 4])
      (let ((m (genmap-new cx [(KeyVar 1) (KeyRigid 0) (KeyRigid 1)] cols []))
            (closed (Closed [] cols [])))
        (do
          (cx-finalize cx m closed)
          (is cs (match (get @(. tb instantiations) 3)
                   ((some i) (= (. i tys) [(TGen 0) (TGen 1) (ty-i64)]))
                   (_ false)) "finalize: a polymorphic call is one of the member's scheme, its own variable at its place and the caller's by index elsewhere")
          (is cs (match (get @(. tb instantiations) 4)
                   ((some i) (= (. i tys) [(TGen 0)]))
                   (_ false)) "finalize: an occurrence that is not a polymorphic call is only under the map"))))))

;; ---- scheme

(defun scheme-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (cols (colours-of (map-empty) (set-empty) [] []))
        (root (fn-of CSend [(v 1) (v 2)])))
    (let ((m (genmap-new cx [(KeyVar 1) (KeyVar 2)] cols []))
          (closed (Closed [[(KeyVar 1)] [(KeyVar 2)]] cols
                          [(Pair (PProto 0 [(v 1)]) nil) (Pair (PProto 0 [(v 2)]) nil) (Pair (PProto 0 [(v 1)]) (some 3))
                           (Pair (PProto 1 [(v 1) (v 2)]) nil) (Pair (PSend (v 1)) nil) (Pair (PSend (v 1)) nil)])))
      (do
        (let ((s (cx-scheme cx m closed 0 root [false true] ["x" "y"])))
          (do
            (is cs (= (. s preds) [(PProto 0 [(TGen 0)]) (PSend (TGen 0))]) "scheme: the constraints whose variables the root holds, each once, in order")
            (is cs (and (= (. s n-vars) 2) (= (. s n-colours) 0) (= (. s var-names) ["a" "b"])
                        (= (. s ty) (TFn CSend [(TGen 0) (TGen 1)] (ty-i64)))
                        (= (. s amps) [false true]) (= (. s params) ["x" "y"])
                        (empty? (. s colour-bounds))) "scheme: the variables, names, type, amps and parameters")))
        (let ((s (cx-scheme cx m closed 1 root [] [])))
          (is cs (= (. s preds) [(PProto 0 [(TGen 1)])]) "scheme: the other root holds the other variable"))))))

(defun scheme-colour-tests (cs: StepLog) -> unit
  (let ((cx (cx-new))
        (cols (colours-of (map-empty) (set-empty) [] [(Pair (CVar 100) (CVar 101))]))
        (root (colour-root 1)))
    (let ((m (genmap-new cx [] cols [root]))
          (closed (Closed [[]] cols [])))
      (let ((s (cx-scheme cx m closed 0 root [] [])))
        (is cs (and (= (. s n-colours) 2) (= (. s colour-bounds) [(BFlow (CGen 0) (CGen 1))])
                    (= (. s ty) (TFn (CGen 0) [(TFn (CGen 1) [] (ty-i64))] (ty-i64)))) "scheme: colours are counted and their bounds kept")))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do (keys-tests cs)
        (naming-tests cs)
        (colour-tests cs)
        (apply-tests cs)
        (bounds-tests cs)
        (debug-tests cs)
        (unresolved-tests cs)
        (ambiguous-tests cs)
        (determined-tests cs)
        (sends-tests cs)
        (finalize-tests cs)
        (finalize-poly-tests cs)
        (scheme-tests cs)
        (scheme-colour-tests cs)
        (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-general" [(test-case "checks" unit-steps "compiler/tests/types/unit-general.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
