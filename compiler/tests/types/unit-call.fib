;; compiler/tests/types/unit-call.fib: crates/fibref/src/types/infer/call.rs
;; (no inline tests in Rust) written from its doc comments and spec/types.md
;; §2.1, §2.2, §2.14: `instantiate` (fresh variables, the context as deferred
;; constraints with the dispatch one first, colour bounds, the tables),
;; `global_value`, `call` through a global function, a constructor, a method,
;; an SCC member (monomorphic, polymorphic), and through an expression head
;; (`infer` is a stand-in that types a literal or a local), the `&` positions,
;; the arity error and the library's stand-in hint, constants that are called,
;; `ctor_is_fn` and `ctor_scheme`.
;; Build: fibc build compiler/tests/types/unit-call.fib -I compiler -I lib -o OUT
(ns main (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table
               types.ast types.decls types.init types.infer.cx types.infer.pattern
               types.infer.call types.infer.inst types.infer.unify types.check))

(def p0: Pos (Pos "t.fib" 1 1 0 1))
(def p-call: Pos (Pos "t.fib" 3 4 20 30))
(def p-arg: Pos (Pos "t.fib" 3 9 25 26))

(defun tdef (name: str module: i64 params: (Vec str) shape: TypeShape) -> TypeDef
  (TypeDef name module params [] shape p0))
(defun fld (name: str t: Ty) -> FieldDef (FieldDef name t))

;; The builtin module and the prelude's `fib.prelude`, plus `fib.str` (2) and
;; `app` (3); types 0 Option, 1 Form, 2 Vec, 3 `S a` (fields i64 and a), 4 `K k`
;; (a colour parameter), 5 `P` (a struct without fields).
(defun world () -> Globals
  (match (new-globals)
    ((Ok g)
     (do (g-add-module g "fib.str" (Links [] [] []) (map-empty))
         (g-add-module g "app" (Links [] [] []) (map-empty))
         (table-add (. g types) (tdef "Vec" module-prelude ["a"] (TsStruct [])))
         (table-add (. g types) (tdef "S" 3 ["a"] (TsStruct [(fld "f" (ty-i64)) (fld "g" (TGen 0))])))
         (table-add (. g types)
           (TypeDef "K" 3 ["k"] [true] (TsStruct [(fld "run" (TFn (CGen 0) [] (ty-i64)))]) p0))
         (table-add (. g types) (tdef "P" 3 [] (TsStruct [])))
         (set! (. g vec) (some 2))
         g))
    ((Err e) (trap (type-error-text e)))))

(defun cx-of (g: Globals) -> Cx (Cx g (env-new) (store-new) (tables-new) (unit-new)))
(defun fresh-cx () -> Cx (cx-of (world)))

(defun sch (nv: i64 names: (Vec str) preds: (Vec Pred) ty: Ty amps: (Vec bool) params: (Vec str)) -> Scheme
  (Scheme nv 0 names preds [] ty amps params))
(defun id-sch () -> Scheme
  (sch 1 ["a"] [] (TFn CSend [(TGen 0) (TGen 0)] (TGen 0)) [] ["x" "y"]))

;; A function `name` of module `m` with the scheme `s` known to the unit's env.
(defun add-fun (cx: Cx name: str m: i64 s: Scheme) -> i64
  (let ((f (table-add (. (. cx g) funs)
             (FunDef name m [] nil [] (Expr 0 p0 (ELit LitUnit)) false p0))))
    (do (set! (. (. cx env) funs) (assoc @(. (. cx env) funs) f s))
        f)))

(defun lit (id: i64 l: Lit) -> Expr (Expr id p-arg (ELit l)))
(defun global (id: i64 r: GlobalRef) -> Expr (Expr id p0 (EGlobal r)))
(defun e-call (head: Expr args: (Vec Arg)) -> Expr (Expr 50 p-call (ECall head args)))
(defun arg (x: Expr) -> Arg (ArgExpr x))

;; The stand-in for `infer`: a literal, or a local's binding type.
(defun stub-infer (cx: Cx x: Expr) -> (Result Ty TypeError)
  (match (. x kind)
    ((ELit l) (Ok (lit-type l)))
    ((ELocal b) (cx-binding cx b (. x pos)))
    (_ (Err (type-error-other (. x pos) "stub infer")))))

(defun call (cx: Cx head: Expr args: (Vec Arg)) -> (Result Ty TypeError)
  (cx-call cx (e-call head args) head args stub-infer))

(defun ok-is (r: (Result Ty TypeError) want: Ty) -> bool
  (match r ((Ok t) (= t want)) ((Err _) false)))
(defun failed-at (r: (Result Ty TypeError) kind: ErrorKind msg: str pos: Pos) -> bool
  (match r ((Err e) (and (= (. e kind) kind) (= (. e message) msg) (and (= (. (. e pos) line) (. pos line)) (= (. (. e pos) col) (. pos col))))) (_ false)))
(defun ndef (cx: Cx) -> i64 (count @(. (. cx u) deferred)))
(defun kind-at (cx: Cx i: i64) -> DKind (. (nth @(. (. cx u) deferred) i) kind))
(defun inst-of (cx: Cx site: i64) -> (Option Instantiation) (get @(. (. cx t) instantiations) site))
(defun inst-is (cx: Cx site: i64 tys: (Vec Ty) colours: (Vec Colour)) -> bool
  (match (inst-of cx site)
    ((some i) (and (= (. i tys) tys) (= (. i colours) colours)))
    (nil false)))

(defun instantiate-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)) (t (cx-instantiate cx (id-sch) 7 "f" p0 nil)))
      (check cs "instantiate: fresh variables for the quantified ones, the type substituted"
             (and (= t (TFn CSend [(TVar 0) (TVar 0)] (TVar 0))) (= (ndef cx) 0)
                  (inst-is cx 7 [(TVar 0)] [])
                  (= @(. (. cx u) insts) [7]))))
    (let ((cx (fresh-cx))
          (s (Scheme 2 2 ["a" "b"]
               [(PProto 0 [(TGen 0)]) (PSend (TGen 0)) (PSend (ty-i64)) (PSend (TGen 5)) (PObject (TGen 1)) (PWeakable (TGen 0))]
               [(BFlow (CGen 0) (CGen 1)) (BCaps (CGen 1) (TGen 0))]
               (TGen 1) [] [])))
      (do (cx-instantiate cx s 9 "f" p0 (some 3))
          (check cs "instantiate: variables first, then colours, each in order"
                 (and (= (cx-fresh cx) (TVar 2)) (= (store-fresh-colour (. cx st)) (CVar 2))))
          (check cs "instantiate: the context is deferred in order; the first carries the method and the site"
                 (and (= (ndef cx) 6)
                      (match (kind-at cx 0) ((DkProto q args m) (and (= q 0) (= args [(TVar 0)]) (= m (some 3)))) (_ false))
                      (= (. (nth @(. (. cx u) deferred) 0) site) (some 9))
                      (match (kind-at cx 1) ((DkSend t path) (and (= t (TVar 0)) (= path ["type argument a of f"]))) (_ false))
                      (nil? (. (nth @(. (. cx u) deferred) 1) site))
                      (match (kind-at cx 2) ((DkSend t path) (= path ["a type argument of f"])) (_ false))
                      (match (kind-at cx 3) ((DkSend t path) (= path ["type argument t5 of f"])) (_ false))
                      (match (kind-at cx 4) ((DkObject t who) (and (= t (TVar 1)) (= who "f"))) (_ false))
                      (match (kind-at cx 5) ((DkWeakable t) (= t (TVar 0))) (_ false))
                      (= (. (. (nth @(. (. cx u) deferred) 5) pos) line) 1))))
          (check cs "instantiate: a bound between colours and a capture bound become constraints"
                 (let ((cons @(. (. cx u) colours)) (caps @(. (. cx u) caps)))
                   (and (= (count cons) 1) (= (. (nth cons 0) from) (CVar 0)) (= (. (nth cons 0) to) (CVar 1))
                        (nil? (. (nth cons 0) label)) (nil? (. (nth cons 0) origin))
                        (= (count caps) 1) (= (. (nth caps 0) colour) (CVar 1)) (= (. (nth caps 0) ty) (TVar 0))
                        (= (. (nth caps 0) label) "a capture of a closure made by f"))))
          (check cs "instantiate: the instantiation is recorded at the site"
                 (inst-is cx 9 [(TVar 0) (TVar 1)] [(CVar 0) (CVar 1)])))))

(defun global-value-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)) (f (add-fun cx "f" 3 (sch 0 [] [] (TFn CSend [(ty-i64)] (ty-str)) [] ["n"]))))
      (check cs "global_value: a function is a send function value"
             (ok-is (cx-global-value cx 1 (GFun f) p0) (TFn CSend [(ty-i64)] (ty-str)))))
    (let ((cx (fresh-cx)) (f (add-fun cx "f" 3 (sch 0 [] [] (TFn CSend [(ty-i64)] (ty-str)) [true] ["n"]))))
      (check cs "global_value: a function with an & parameter is not a value"
             (failed-at (cx-global-value cx 1 (GFun f) p-arg) AmpFunctionValue
                        "function with & parameters is not a value" p-arg)))
    (let ((cx (fresh-cx)) (d (table-add (. (. cx g) defs) (DefDef "d" 3 nil (lit 0 LitUnit) true p0))))
      (do (check cs "global_value: a def not typed yet"
                 (failed-at (cx-global-value cx 1 (GDef d) p-arg) Other "def d is not typed yet" p-arg))
          (set! (. (. cx env) defs) (assoc @(. (. cx env) defs) d (ty-str)))
          (check cs "global_value: a typed def has its type" (ok-is (cx-global-value cx 1 (GDef d) p-arg) (ty-str)))))
    (let ((cx (fresh-cx)))
      (check cs "global_value: a field-less variant is an instance of its type (Option's nil)"
             (and (ok-is (cx-global-value cx 4 (GCtor 0 (some 0)) p0) (ty-nominal 0 [(TVar 0)]))
                  (inst-is cx 4 [(TVar 0)] []))))
    (let ((cx (fresh-cx)))
      (check cs "global_value: a constructor with fields is a function (Some)"
             (ok-is (cx-global-value cx 4 (GCtor 0 (some 1)) p0)
                    (TFn CSend [(TVar 0)] (ty-nominal 0 [(TVar 0)])))))
    (let ((cx (fresh-cx)) (x (table-add (. (. cx g) externs) (ExternDef "puts" (TFn CSend [(ty-str)] (ty-unit)) false p0))))
      (check cs "global_value: an extern has its declared type"
             (ok-is (cx-global-value cx 1 (GExtern x) p0) (TFn CSend [(ty-str)] (ty-unit)))))
    (let ((cx (fresh-cx)))
      (check cs "global_value: a function with no scheme in the unit"
             (let ((f (table-add (. (. cx g) funs) (FunDef "h" 3 [] nil [] (lit 0 LitUnit) false p0))))
               (failed-at (cx-global-value cx 1 (GFun f) p-arg) Other "internal: h has no scheme" p-arg))))
    (let ((cx (fresh-cx)))
      (check cs "global_value: a method instantiates its scheme with the dispatch constraint first"
             (let ((p (table-add (. (. cx g) protos)
                        (ProtoDef "Show" 1 [] [(MethodDef "show" [] (sch 1 ["a"] [(PProto 0 [(TGen 0)])] (TFn CSend [(TGen 0)] (ty-str)) [] ["self"]) false nil p0)] [] p0))))
               (and (ok-is (cx-global-value cx 6 (GMethod p 0) p0) (TFn CSend [(TVar 0)] (ty-str)))
                    (match (kind-at cx 0) ((DkProto q args m) (= m (some 0))) (_ false))
                    (= (. (nth @(. (. cx u) deferred) 0) site) (some 6))))))))

(defun call-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)) (f (add-fun cx "f" 3 (id-sch))))
      (check cs "call: arguments flow into the parameters, the result is the return type"
             (and (ok-is (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitInt 2 I64)))]) (TVar 0))
                  (= (cx-zonk cx (TVar 0)) (ty-i64))
                  (= (get @(. (. cx t) expr-types) 1) (some (TFn CSend [(TVar 0) (TVar 0)] (TVar 0)))))))
    (let ((cx (fresh-cx)) (f (add-fun cx "f" 3 (id-sch))))
      (check cs "call: an argument that does not fit is the unify error at the argument"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitBool true)))])
                        Unify "cannot unify bool with i64" p-arg)))
    (let ((cx (fresh-cx)) (f (add-fun cx "f" 3 (id-sch))))
      (check cs "call: the arity error is at the call, and names the function"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64)))])
                        Other "f takes 2 argument(s), got 1" p-call)))
    (let ((cx (fresh-cx)) (f (add-fun cx "get" module-prelude (id-sch))))
      (check cs "call: a prelude function's arity error is the plain one (the D1 stand-in hint is gone)"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 LitUnit)) (arg (lit 3 LitUnit)) (arg (lit 4 LitUnit))])
                        Other "get takes 2 argument(s), got 3" p-call)))
    (let ((cx (fresh-cx)) (f (add-fun cx "range" 2 (sch 0 [] [] (TFn CSend [(ty-i64) (ty-i64)] (ty-i64)) [] []))))
      (check cs "call: a module named fib.* is the library's too; with no names the parameters are numbered"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 LitUnit)) (arg (lit 3 LitUnit)) (arg (lit 4 LitUnit))])
                        Other "range takes 2 argument(s), got 3; use range-by" p-call)))
    (let ((cx (fresh-cx)) (f (add-fun cx "get" 3 (id-sch))))
      (check cs "call: a program's own get has no stand-in hint"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 LitUnit)) (arg (lit 3 LitUnit)) (arg (lit 4 LitUnit))])
                        Other "get takes 2 argument(s), got 3" p-call)))
    (let ((cx (fresh-cx)) (f (add-fun cx "get" module-prelude (id-sch))))
      (check cs "call: the library hint needs the stand-in's argument count"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 LitUnit))])
                        Other "get takes 2 argument(s), got 1" p-call)))))

(defun amp-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)) (f (add-fun cx "inc" 3 (sch 0 [] [] (TFn CSend [(ty-i64)] (ty-unit)) [true] ["c"]))))
      (do (cx-bind cx 5 (ty-cell (ty-i64)))
          (check cs "call: &x at an & parameter is a cell of the parameter's type"
                 (ok-is (call cx (global 1 (GFun f)) [(ArgAmp 5 p-arg)]) (ty-unit)))))
    (let ((cx (fresh-cx)) (f (add-fun cx "inc" 3 (sch 0 [] [] (TFn CSend [(ty-i64)] (ty-unit)) [true] ["c"]))))
      (do (cx-bind cx 5 (ty-i64))
          (check cs "call: &x of a variable that is not a cell"
                 (failed-at (call cx (global 1 (GFun f)) [(ArgAmp 5 p-arg)]) AmpArgument
                            "& argument must be a cell variable" p-arg))))
    (let ((cx (fresh-cx)) (f (add-fun cx "inc" 3 (sch 0 [] [] (TFn CSend [(ty-i64)] (ty-unit)) [true] ["c"]))))
      (check cs "call: an expression at an & parameter"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64)))]) AmpPosition
                        "parameter c of inc is &; pass &x" p-arg)))
    (let ((cx (fresh-cx)) (f (add-fun cx "id" 3 (sch 1 ["a"] [] (TFn CSend [(TGen 0)] (TGen 0)) [] ["x"]))))
      (check cs "call: &x at a parameter that is not &"
             (failed-at (call cx (global 1 (GFun f)) [(ArgAmp 5 p-arg)]) AmpPosition
                        "parameter x of id is not &; pass x" p-arg)))
    (let ((cx (fresh-cx)) (f (add-fun cx "id" 3 (sch 1 ["a"] [] (TFn CSend [(TGen 0) (TGen 0)] (TGen 0)) [false true] []))))
      (check cs "call: a parameter without a name is its number"
             (failed-at (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitInt 1 I64)))])
                        AmpPosition "parameter 2 of id is &; pass &x" p-arg)))))

(defun head-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)))
      (check cs "call: a constant is not called"
             (failed-at (call cx (global 1 (GCtor 0 (some 0))) [(arg (lit 2 (LitInt 1 I64)))]) ConstantCalled
                        "nil is a constant, not a function; write nil" p0)))
    (let ((cx (fresh-cx)))
      (check cs "call: a constructor applies like a function (S 1 true)"
             (and (ok-is (call cx (global 1 (GCtor 3 nil)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitBool true)))])
                         (ty-nominal 3 [(TVar 0)]))
                  (= (cx-zonk cx (TVar 0)) (ty-bool)))))
    (let ((cx (fresh-cx)))
      (check cs "call: a variant's constructor names the variant in the arity error"
             (failed-at (call cx (global 1 (GCtor 0 (some 1))) []) Other "some takes 1 argument(s), got 0" p-call)))
    (let ((cx (fresh-cx)))
      (do (cx-bind cx 5 (TFn CSend [(ty-i64)] (ty-str)))
          (check cs "call: a local head is unified with a function of fresh parameters"
                 (and (ok-is (call cx (Expr 8 p0 (ELocal 5)) [(arg (lit 2 (LitInt 1 I64)))]) (TVar 1))
                      (= (cx-zonk cx (TVar 1)) (ty-str))))))
    (let ((cx (fresh-cx)))
      (do (cx-bind cx 5 (ty-i64))
          (check cs "call: a head that is not a function: the unify error at the head"
                 (failed-at (call cx (Expr 8 p-arg (ELocal 5)) [(arg (lit 2 (LitInt 1 I64)))]) Unify
                            "cannot unify i64 with (fn (a) b)" p-arg))))
    (let ((cx (fresh-cx)))
      (do (cx-bind cx 5 (TFn CSend [(ty-i64)] (ty-str)))
          (check cs "call: an expression head's arity is by its arguments (2 for a 1-ary function)"
                 (match (call cx (Expr 8 p-arg (ELocal 5)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitInt 1 I64)))])
                   ((Err e) (= (. e kind) Unify))
                   (_ false)))))))

(defun scc-tests (cs: Checks) -> unit
  (do
    (let ((cx (fresh-cx)) (f (add-fun cx "m" 3 (id-sch))))
      (do (set! (. (. cx u) mono) (assoc @(. (. cx u) mono) f (MonoSig [(ty-i64)] [false] ["n"] (ty-str))))
          (check cs "call: an SCC member is called by its monomorphic signature: no instantiation"
                 (and (ok-is (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64)))]) (ty-str))
                      (nil? (inst-of cx 1)) (empty? @(. (. cx u) insts))
                      (= (get @(. (. cx t) expr-types) 1) (some (TFn CSend [(ty-i64)] (ty-str))))))
          (check cs "call: a monomorphic member's arity error is not the library's"
                 (failed-at (call cx (global 1 (GFun f)) []) Other "m takes 1 argument(s), got 0" p-call))))
    (let ((cx (fresh-cx)) (f (add-fun cx "p" 3 (sch 0 [] [] (ty-unit) [] []))))
      (do (set! (. (. cx u) poly) (assoc @(. (. cx u) poly) f (id-sch)))
          (set! (. (. cx u) cur) (some 77))
          (check cs "call: a polymorphically recursive callee is instantiated from its scheme, noted as used and as a call"
                 (and (ok-is (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitInt 1 I64)))]) (TVar 0))
                      (contains? @(. (. cx u) poly-used) f)
                      (= (count @(. (. cx u) poly-calls)) 1)
                      (let ((c (nth @(. (. cx u) poly-calls) 0)))
                        (and (= (. c caller) 77) (= (. c callee) f) (= (. c site) 1)))
                      (some? (inst-of cx 1))))))
    (let ((cx (fresh-cx)) (f (add-fun cx "p" 3 (id-sch))))
      (check cs "call: a function that is not polymorphically recursive is not noted as a call"
             (and (ok-is (call cx (global 1 (GFun f)) [(arg (lit 2 (LitInt 1 I64))) (arg (lit 3 (LitInt 1 I64)))]) (TVar 0))
                  (empty? @(. (. cx u) poly-calls)) (empty? @(. (. cx u) poly-used)))))))

(defun ctor-tests (cs: Checks) -> unit
  (let ((g (world)))
    (do
      (check cs "ctor_is_fn: a struct and a variant with fields are called; a field-less variant is not"
             (and (ctor-is-fn g 3 nil) (ctor-is-fn g 0 (some 1)) (not (ctor-is-fn g 0 (some 0)))
                  (not (ctor-is-fn g 3 (some 0))) (not (ctor-is-fn g 0 (some 9)))))
      (check cs "ctor_scheme: a struct's constructor is a send function over its fields"
             (= (ctor-scheme g 3 nil)
                (Scheme 1 0 ["a"] [] [] (TFn CSend [(ty-i64) (TGen 0)] (ty-nominal 3 [(TGen 0)])) [false false] ["f" "g"])))
      (check cs "ctor_scheme: a field-less variant is the value's type"
             (= (ctor-scheme g 0 (some 0)) (Scheme 1 0 ["a"] [] [] (ty-nominal 0 [(TGen 0)]) [] [])))
      (check cs "ctor_scheme: a colour parameter is a colour argument and a colour of the scheme"
             (= (ctor-scheme g 4 nil)
                (Scheme 1 1 ["k"] [] [] (TFn CSend [(TFn (CGen 0) [] (ty-i64))] (ty-nominal 4 [(ty-colour-arg (CGen 0))]))
                        [false] ["run"])))
      (check cs "ctor_scheme: a struct without fields is a call of no arguments"
             (= (ctor-scheme g 5 nil) (Scheme 0 0 [] [] [] (TFn CSend [] (ty-nominal 5 [])) [] []))))))

(defun main () -> i64
  (let ((cs (checks-new)))
    (do (instantiate-tests cs) (global-value-tests cs) (call-tests cs) (amp-tests cs)
        (head-tests cs) (scc-tests cs) (ctor-tests cs)
        (finish cs))))
