-- module main impl-where.fib
protocol Plain (Self) 9:1 279..320 supers
  method plain : ∀Self. (Plain Self) ⇒ (fn :send (Self) i64) params self
protocol Show2 (Self) 10:1 321..362 supers
  method show2 : ∀Self. (Show2 Self) ⇒ (fn :send (Self) str) params self
protocol Pr2 (self x) 11:1 363..414 supers
  method pr2 : ∀self x. (Pr2 self x) ⇒ (fn :send (self x) i64) params self y
protocol Seq (s e) 12:1 415..458 supers
  method first : ∀s e. (Seq s e) ⇒ (fn :send (s) e) params self
instance 0 (Show2 i64) vars 0 13:1 459..494
instance 1 (Show2 (Box a)) vars 1 where (Show2 a) 14:1 495..553
instance 2 (Show2 (Two2 a b)) vars 2 where (Show2 a) (Show2 b) 15:1 554..625
instance 3 (Plain (Cell a)) vars 1 where (Send a) 16:1 626..682
instance 4 (Plain (Array a)) vars 1 where (Object a) (Weakable a) 17:1 683..755
instance 5 (Show2 (Big a b c)) vars 3 where (Pr2 a b) (Show2 c) 18:1 756..828
instance 6 (Show2 (Opt2 a)) vars 1 19:1 829..879
