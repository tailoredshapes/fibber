(ns main)
(defstruct P (a: i64))
(defprotocol Plain (plain (self) -> i64))
(defprotocol Args (args (self x: i64 y: str) -> i64) (other (self f: (fn (i64) bool)) -> (Array i64)))
(defprotocol Quals (quals (self :borrow x: i64 :owned y: str :borrow :owned) -> i64))
(defprotocol Elsewhere (merge (self other: Self) -> Self) (peek (self) -> i64) (make (self) -> (Array Self)))
(defprotocol Gen (gen (self x: a y: (Array b) z: a) -> (Cell b)))
(defprotocol Dflt (dflt (self) -> i64 7) (nodflt (self x: i64) -> i64))
(defun main () -> i64 0)
