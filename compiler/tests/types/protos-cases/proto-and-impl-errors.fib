(ns main)
(defstruct P (a: i64))
(defstruct (Box a) (v: a))
(defstruct (Two2 a b) (x: a y: b))
(defstruct (Big a b c) (x: a y: b z: c))
(defenum (Opt2 a) None2 (Some2 a))
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defstruct (Cap k :colour a) (f: (fn k (a) a)))
(defprotocol Plain (plain (self) -> i64))
(defprotocol Show2 (show2 (self) -> str))
(defprotocol (Pr2 self x) (pr2 (self y: x) -> i64))
(defprotocol (Seq s e) (first (self) -> e))
(impl Plain P (plain (self) 1))
(defprotocol Pa (pa (self) -> i64))
(defprotocol Pb :requires (Pa) (pb (self) -> i64))
(defprotocol Pc :requires (Pa Pb) (pc (self) -> i64))
(defprotocol (Sq self e) (sq (self) -> e))
(defprotocol (Sq2 self e) :requires ((Sq self e)) (sq2 (self) -> e))
(defprotocol Bad (bad (self) -> 5))
(impl Pa a (pa (self) 1))
(impl Pb P (pb (self) 2))
(defun main () -> i64 0)
