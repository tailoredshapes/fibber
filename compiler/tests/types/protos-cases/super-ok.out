-- module main super-ok.fib
protocol Plain (Self) 9:1 279..320 supers
  method plain : ∀Self. (Plain Self) ⇒ (fn :send (Self) i64) params self
protocol Show2 (Self) 10:1 321..362 supers
  method show2 : ∀Self. (Show2 Self) ⇒ (fn :send (Self) str) params self
protocol Pr2 (self x) 11:1 363..414 supers
  method pr2 : ∀self x. (Pr2 self x) ⇒ (fn :send (self x) i64) params self y
protocol Seq (s e) 12:1 415..458 supers
  method first : ∀s e. (Seq s e) ⇒ (fn :send (s) e) params self
protocol Pa (Self) 14:1 491..526 supers
  method pa : ∀Self. (Pa Self) ⇒ (fn :send (Self) i64) params self
protocol Pb (Self) 15:1 527..577 supers (Pa Self)
  method pb : ∀Self. (Pb Self) ⇒ (fn :send (Self) i64) params self
protocol Pc (Self) 16:1 578..631 supers (Pa Self) (Pb Self)
  method pc : ∀Self. (Pc Self) ⇒ (fn :send (Self) i64) params self
protocol Sq (self e) 17:1 632..674 supers
  method sq : ∀self e. (Sq self e) ⇒ (fn :send (self) e) params self
protocol Sq2 (self e) 18:1 675..743 supers (Sq self e)
  method sq2 : ∀self e. (Sq2 self e) ⇒ (fn :send (self) e) params self
instance 0 (Plain P) vars 0 13:1 459..490
instance 1 (Pa P) vars 0 19:1 744..769
instance 2 (Pb P) vars 0 20:1 770..795
instance 3 (Pc P) vars 0 21:1 796..821
instance 4 (Sq P i64) vars 0 22:1 822..853
instance 5 (Sq2 P i64) vars 0 23:1 854..887
instance 6 (Pa (Box a)) vars 1 where (Pa a) 24:1 888..935
instance 7 (Pb (Box a)) vars 1 where (Pb a) 25:1 936..983
instance 8 (Pa (Opt2 a)) vars 1 26:1 984..1016
instance 9 (Pb (Opt2 a)) vars 1 27:1 1017..1049
