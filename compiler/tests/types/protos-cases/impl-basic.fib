(ns main)
(defstruct P (a: i64))
(defstruct (Box a) (v: a))
(defstruct (Two2 a b) (x: a y: b))
(defstruct (Big a b c) (x: a y: b z: c))
(defenum (Opt2 a) None2 (Some2 a))
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defstruct (Cap k :colour a) (f: (fn k (a) a)))
(defprotocol Plain (plain (self) -> i64))
(defprotocol Show2 (show2 (self) -> str))
(defprotocol (Pr2 self x) (pr2 (self y: x) -> i64))
(defprotocol (Seq s e) (first (self) -> e))
(impl Plain P (plain (self) 1))
(impl Plain (Box a) (plain (self) 2))
(impl Plain i64 (plain (self) 3))
(impl Plain str (plain (self) 4))
(impl Plain (Array a) (plain (self) 5))
(impl Plain (Cell a) (plain (self) 6))
(impl Plain (Opt2 a) (plain (self) 7))
(impl Plain (Two2 a b) (plain (self) 8))
(impl Plain bool (plain (self) 9))
(impl Show2 (Atom a) (show2 (self) "x"))
(impl Show2 (Task a) (show2 (self) "y"))
(impl Show2 (Weak a) (show2 (self) "z"))
(defun main () -> i64 0)
