-- module main proto-requires.fib
protocol A (Self) 2:1 10..43 supers
  method a : ∀Self. (A Self) ⇒ (fn :send (Self) i64) params self
protocol B (Self) 3:1 44..91 supers (A Self)
  method b : ∀Self. (B Self) ⇒ (fn :send (Self) i64) params self
protocol C (Self) 4:1 92..146 supers (A Self) (B Self) (Show Self)
  method c : ∀Self. (C Self) ⇒ (fn :send (Self) i64) params self
protocol Q (s e) 5:1 147..210 supers (A s) (Stack s e)
  method q : ∀s e. (Q s e) ⇒ (fn :send (s) e) params self
protocol R (self e) 6:1 211..280 supers (Stack self e)
  method r : ∀self e. (R self e) ⇒ (fn :send (self) i64) params self
