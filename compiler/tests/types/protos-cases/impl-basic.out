-- module main impl-basic.fib
protocol Plain (Self) 9:1 279..320 supers
  method plain : ∀Self. (Plain Self) ⇒ (fn :send (Self) i64) params self
protocol Show2 (Self) 10:1 321..362 supers
  method show2 : ∀Self. (Show2 Self) ⇒ (fn :send (Self) str) params self
protocol Pr2 (self x) 11:1 363..414 supers
  method pr2 : ∀self x. (Pr2 self x) ⇒ (fn :send (self x) i64) params self y
protocol Seq (s e) 12:1 415..458 supers
  method first : ∀s e. (Seq s e) ⇒ (fn :send (s) e) params self
instance 0 (Plain P) vars 0 13:1 459..490
