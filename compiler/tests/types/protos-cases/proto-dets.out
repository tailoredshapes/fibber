-- module main proto-dets.fib
protocol Seq (s e) 2:1 10..160 supers
  method first : ∀s e. (Seq s e) ⇒ (fn :send (s) e) params self
  method cons : ∀s e. (Seq s e) ⇒ (fn :send (s e) s) params self x
  method both : ∀s e. (Seq s e) ⇒ (fn :send (s s) (Array e)) params self other
  method nest : ∀s e ς0. (Seq s e) ⇒ (fn :send (s (fn ς0 (s) e)) (dyn (Seq i64))) params self f
protocol Two (self a b) 3:1 161..215 supers
  method two : ∀self a b. (Two self a b) ⇒ (fn :send (self) (Array a)) params self
protocol One (self) 4:1 216..260 supers
  method one : ∀self. (One self) ⇒ (fn :send (self) i64) params self
