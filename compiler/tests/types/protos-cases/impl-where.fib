(ns main)
(defstruct P (a: i64))
(defstruct (Box a) (v: a))
(defstruct (Two2 a b) (x: a y: b))
(defstruct (Big a b c) (x: a y: b z: c))
(defenum (Opt2 a) None2 (Some2 a))
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defstruct (Cap k :colour a) (f: (fn k (a) a)))
(defprotocol Plain (plain (self) -> i64))
(defprotocol Show2 (show2 (self) -> str))
(defprotocol (Pr2 self x) (pr2 (self y: x) -> i64))
(defprotocol (Seq s e) (first (self) -> e))
(impl Show2 i64 (show2 (self) "i"))
(impl Show2 (Box a) :where ((Show2 a)) (show2 (self) "b"))
(impl Show2 (Two2 a b) :where ((Show2 a) (Show2 b)) (show2 (self) "t"))
(impl Plain (Cell a) :where ((Send a)) (plain (self) 1))
(impl Plain (Array a) :where ((Object a) (Weakable a)) (plain (self) 2))
(impl Show2 (Big a b c) :where ((Pr2 a b) (Show2 c)) (show2 (self) "g"))
(impl Show2 (Opt2 a) :where () (show2 (self) "o"))
(defun main () -> i64 0)
