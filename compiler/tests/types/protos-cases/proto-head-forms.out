-- module main proto-head-forms.fib
protocol A (Self) 2:1 10..45 supers
  method a : ∀Self. (A Self) ⇒ (fn :send (Self) i64) params self
protocol B (self) 3:1 46..86 supers
  method b : ∀self. (B self) ⇒ (fn :send (self) i64) params self
protocol C (self e f) 4:1 87..134 supers
  method c : ∀self e f. (C self e f) ⇒ (fn :send (self e) f) params self x
