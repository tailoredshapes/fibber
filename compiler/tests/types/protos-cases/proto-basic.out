-- module main proto-basic.fib
protocol Plain (Self) 3:1 33..74 supers
  method plain : ∀Self. (Plain Self) ⇒ (fn :send (Self) i64) params self
protocol Args (Self) 4:1 75..177 supers
  method args : ∀Self. (Args Self) ⇒ (fn :send (Self i64 str) i64) params self x y
  method other : ∀Self ς0. (Args Self) ⇒ (fn :send (Self (fn ς0 (i64) bool)) (Array i64)) params self f
protocol Quals (Self) 5:1 178..263 supers
  method quals : ∀Self. (Quals Self) ⇒ (fn :send (Self i64 str) i64) params self:borrow x:owned y:borrow:owned
protocol Elsewhere (Self) 6:1 264..373 supers
  method merge : ∀Self. (Elsewhere Self) ⇒ (fn :send (Self Self) Self) params self other
  method peek : ∀Self. (Elsewhere Self) ⇒ (fn :send (Self) i64) params self
  method make : ∀Self. (Elsewhere Self) ⇒ (fn :send (Self) (Array Self)) params self
protocol Gen (Self) 7:1 374..439 supers
  method gen : ∀Self a b. (Gen Self) ⇒ (fn :send (Self a (Array b) a) (Cell b)) params self x y z
protocol Dflt (Self) 8:1 440..511 supers
  method dflt : ∀Self. (Dflt Self) ⇒ (fn :send (Self) i64) params self
  method nodflt : ∀Self. (Dflt Self) ⇒ (fn :send (Self i64) i64) params self x
