(ns main)
(defprotocol A (a (self) -> i64))
(defprotocol B :requires (A) (b (self) -> i64))
(defprotocol C :requires (A B Show) (c (self) -> i64))
(defprotocol (Q s e) :requires (A (Stack s e)) (q (self) -> e))
(defprotocol (R self e) :requires ((Stack self e)) (r (self) -> i64))
(defun main () -> i64 0)
