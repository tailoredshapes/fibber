;; compiler/tests/types/unit-args.fib: the inline tests of crates/fibref/src/
;; types_dump/args.rs (options come before one or more files; no file, an
;; unknown option, stage or section are refused; a file named like an option
;; follows `--` or a file; `wants`) and of normal.rs (normalise), over
;; types.args and types.dump.normal.
;; Build: fibc build compiler/tests/types/unit-args.fib -I compiler -I lib -o OUT
(ns tests.types.unit-args (:require [types.args :as a] [types.dump.normal :as n]) (:use fib.test.unit)
  (:require [fib.test.run :as test-runner]))

(defun parsed (words: (Vec str)) -> (Option a/ParsedArgs) (a/parse-args words))

(defun refused (cs: StepLog words: (Vec str)) -> unit
  (is cs (nil? (parsed words)) (str-join ["refused " (str-join words)])))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do
      (let ((all (parsed ["--stage" "lower" "--sections" "type,error" "--library" "--implicit"
                          "--implicit-lib" "fib.a,fib.b" "--prelude" "--ast" "--tables" "a.fib" "b.fib"])))
        (do (is cs (some? all) "all options")
            (if-some [p all]
              (let ((o (. p opts)))
                (do (is cs (= (. p files) ["a.fib" "b.fib"]) "files")
                    (is cs (= (. o stage) a/StLower) "stage")
                    (is cs (= (. o sections) (some [a/SecType a/SecError])) "sections")
                    (is cs (and (. o library) (. o implicit) (. o prelude) (. o ast) (. o tables)) "flags")
                    (is cs (= (. o implicit-lib) (some ["fib.a" "fib.b"])) "implicit-lib")))
              ())))
      (let ((d (parsed ["a.fib"])))
        (is cs (and (some? d) (= (. (unwrap d) files) ["a.fib"])
                                                   (= (. (. (unwrap d) opts) stage) a/StInfer)
                                                   (nil? (. (. (unwrap d) opts) sections))) "no options is the default"))
      (refused cs (vec-empty))
      (refused cs ["--stage" "lower"])
      (refused cs ["--bogus" "a.fib"])
      (refused cs ["--stage" "middle" "a.fib"])
      (refused cs ["--stage"])
      (refused cs ["--sections" "type,nope" "a.fib"])
      (refused cs ["--sections" "type,,fun" "a.fib"])
      (refused cs ["--sections" "type," "a.fib"])
      (refused cs ["--sections" "" "a.fib"])
      (refused cs ["--implicit-lib" "fib.a,,fib.b" "a.fib"])
      (refused cs ["--implicit-lib"])
      (refused cs ["--"])
      (is cs (= (. (unwrap (parsed ["--" "--ast"])) files) ["--ast"]) "-- ends the options")
      (is cs (= (. (unwrap (parsed ["a.fib" "--ast"])) files) ["a.fib" "--ast"]) "a file ends the options")
      (is cs (= (. (. (unwrap (parsed ["--implicit-lib" "" "f"])) opts) implicit-lib) (some (vec-empty))) "an empty implicit-lib is no library")
      (is cs (= (. (. (unwrap (parsed ["--stage" "lower" "--stage" "infer" "f"])) opts) stage) a/StInfer) "a later --stage wins")
      (let ((plain (a/options-default))
            (only (. (unwrap (parsed ["--sections" "fun,tables" "f"])) opts))
            (ast (. (unwrap (parsed ["--sections" "type" "--ast" "f"])) opts)))
        (do (is cs (and (every? (fn (s: a/Section) (a/wants plain s)) (take 8 (a/section-all)))
                        (not (a/wants plain a/SecAst)) (not (a/wants plain a/SecTables))) "by default every section but ast and tables")
            (is cs (and (a/wants only a/SecFun) (a/wants only a/SecTables)
                                                         (not (a/wants only a/SecType)) (not (a/wants only a/SecAst))) "--sections lists only those")
            (is cs (and (a/wants ast a/SecAst) (a/wants ast a/SecType)
                                                      (not (a/wants ast a/SecFun))) "--ast adds to --sections")))
      (is cs (every? (fn (s: a/Section) (= (a/section-from-name (a/section-name s)) (some s))) (a/section-all)) "section names round-trip")
      ;; normal.rs: the variables are renumbered by first occurrence, the two kinds apart
      (is cs (= (n/normalise "(fn (a) a)") "(fn (a) a)") "text without a variable is as it is")
      (is cs (= (n/normalise "(Vec ?40) and ?7 ?40") "(Vec ?1) and ?2 ?1") "type variables renumbered")
      (is cs (= (n/normalise "(fn ?ς40 (?5) ?ς9) ?ς40") "(fn ?ς1 (?1) ?ς2) ?ς1") "colour variables renumbered apart")
      (is cs (= (n/normalise "a?7 ?7x ?ς ? ?ς7a (?7) \"?7\" x,?3") "a?7 ?7x ?ς ? ?ς7a (?1) \"?1\" x,?2") "only whole tokens are variables")
      (is cs (= (n/normalise "?ς7 ⊑ ?ς12 and ?ς7, ?9 then ?4 ?9") "?ς1 ⊑ ?ς2 and ?ς1, ?1 then ?2 ?1") "the Rust example: both kinds, a break after a comma")
      (is cs (every? (fn (s: str) (= (n/normalise s) s)) ["a?7" "?7x" "?ς" "?" "x ?ςa" "??7" "ς7" "?-7"]) "more tokens that are not variables")
      (is cs (= (n/normalise "a ?3\n?5 ?3") "a ?1\n?2 ?1") "a line break breaks a token")
      (is cs (= (n/normalise "x ?12") "x ?1") "a variable ends the text")
      (is cs (= (n/normalise "?12 ?3") "?1 ?2") "a variable starts the text")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-args" [(test-case "checks" unit-steps "compiler/tests/types/unit-args.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
