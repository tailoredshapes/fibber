;; impl bodies and defaults, as `lower_impl` fills them
(defprotocol Shape (area (self) -> i64) (name (self) -> str (str-join ["shape"])))
(defstruct Sq (s: i64))
(impl Shape Sq (area (self) (. self s)))
(impl Shape i64 (area (self) -> i64 self) (name (self) "int"))
(defun main () -> i64 (area (Sq 2)))
