;; the forms of top.rs and mod.rs that declare cleanly: every parameter spelling, bounds, ret
;; annotations, defs of every constant shape, externs and a varargs one
(defstruct Pt (x: i64 y: i64))
(defenum Colour Red Green)
(extern c-abs (i64) -> i64)
(extern c-printf (ptr i64) -> i32 :varargs)
(extern c-unit () -> unit)
(def one 1)
(def two: i64 2)
(def pt (Pt 1 2))
(def red Red)
(def v (vec-conj (vec-empty) 3))
(def next one)
(defun plain (a b) a)
(defun typed (a: i64 b: str) -> i64 a)
(defun borrowed (a :borrow b: (Vec i64) :borrow) -> i64 (count b))
(defun amps (&a &b: i64) 1)
(defun bounded (a: x) :where ((Eq x) (Send x)) -> bool (= a a))
(defun bounded-2 (a: x b: y) :where ((Ord x)) -> y b)
(defun colon-last (a:) a)
(defun main () -> i64 0)
