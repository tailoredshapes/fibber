;; compiler/tests/types/unit-send.fib: crates/fibref/src/types/infer/send.rs has
;; no inline tests, so these are written from its doc comment and its code
;; (spec/types.md §5.1, §5.3): what is and is not Send, the witness path
;; steps, the needs of variables and colours, zonking, recursive types
;; (the greatest fixpoint, and that `seen` is a visited set that is never
;; popped), and the text of `send-error` (the texts of tests/cases.rs:132 and
;; tests/dyn_send.rs:42); and the walk of a `def`'s type (`def-holds-cell`, `def-cell-error`:
;; L15, the tests `def_initialiser_is_any_expression_but_its_type_holds_no_cell_or_weak` of
;; types/tests/errors2.rs and `DefHoldsCell` of types_dump/tests/errors.rs).
;; Build: fibc build compiler/tests/types/unit-send.fib -I compiler -I lib -o OUT
(ns tests.types.unit-send (:use syntax.pos types.ty types.error types.store types.table types.decls
               types.infer.cx types.infer.send fib.test.unit)
  (:require [fib.test.run :as test-runner]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))

(defun fd (name: str ty: Ty) -> FieldDef (FieldDef name ty))
(defun vr (name: str tys: (Vec Ty)) -> VariantDef
  (VariantDef name (mapv (fn (t: Ty) (FieldDef "_" t)) tys)))
(defun add-type (g: Globals name: str params: (Vec str) colours: (Vec bool) shape: TypeShape) -> i64
  (table-add (. g types) (TypeDef name 2 params colours shape p0)))

;; 0 Plain, 1 Holder, 2 Shape, 3 List, 4 Box a, 5 Two a, 6 Thunk k, 7 Wrap,
;; 8 Odd (a field that is a unification variable, as a hand-made type may have).
(defun globals-for-send () -> Globals
  (let ((g (globals-new)))
    (do (add-type g "Plain" [] [] (TsStruct [(fd "a" (ty-i64)) (fd "s" (ty-str))]))
        (add-type g "Holder" [] [] (TsStruct [(fd "a" (ty-i64)) (fd "c" (ty-cell (ty-i64)))]))
        (add-type g "Shape" [] []
          (TsEnum [(vr "Dot" [(ty-i64)]) (vr "Both" [(ty-i64) (ty-cell (ty-i64))]) (vr "Empty" [])]))
        (add-type g "List" [] []
          (TsEnum [(vr "Nil" []) (vr "Cons" [(ty-i64) (ty-nominal 3 [])])]))
        (add-type g "Box" ["a"] [false] (TsStruct [(fd "v" (TGen 0))]))
        (add-type g "Two" ["a"] [false]
          (TsStruct [(fd "l" (ty-nominal 4 [(TGen 0)])) (fd "r" (ty-nominal 4 [(TGen 0)]))]))
        (add-type g "Thunk" ["k"] [true] (TsStruct [(fd "f" (TFn (CGen 0) [] (ty-unit)))]))
        (add-type g "Wrap" [] [] (TsEnum [(vr "Wrap" [(ty-cell (ty-i64))])]))
        (add-type g "Odd" [] [] (TsStruct [(fd "f" (TVar 0))]))
        g)))

(defun eval (g: Globals st: Store t: Ty) -> (Result Needs Witness)
  (send-eval g st t []))

(defun passes? (r: (Result Needs Witness)) -> bool (match r ((Ok _) true) (_ false)))
(defun needs-of (r: (Result Needs Witness)) -> Needs (match r ((Ok n) n) (_ (Needs [] []))))
(defun var-needs (r: (Result Needs Witness)) -> (Vec (Pair Ty (Vec str))) (. (needs-of r) vars))
(defun colour-needs (r: (Result Needs Witness)) -> (Vec (Pair Colour (Vec str))) (. (needs-of r) colours))
(defun fails-at? (r: (Result Needs Witness) path: (Vec str) t: Ty) -> bool
  (match r ((Err w) (and (= (. w path) path) (= (. w offending) t))) (_ false)))
(defun nothing-needed? (r: (Result Needs Witness)) -> bool
  (and (passes? r) (empty? (var-needs r)) (empty? (colour-needs r))))

(defun ptr () -> Ty (ty-scalar SPtr))
(defun fn0 (k: Colour) -> Ty (TFn k [] (ty-i64)))

(defun leaf-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (st (store-new)))
    (do
      (is cs (and (nothing-needed? (eval g st (ty-i64))) (nothing-needed? (eval g st (ty-bool)))
                  (nothing-needed? (eval g st (ty-str))) (nothing-needed? (eval g st (TCon KAtom [])))) "scalars, str and atom are Send, with no needs")
      (is cs (fails-at? (eval g st (ptr)) [] (ptr)) "ptr is not Send")
      (is cs (fails-at? (eval g st (ty-cell (ty-i64))) [] (ty-cell (ty-i64))) "a cell is not Send")
      (is cs (fails-at? (eval g st (TCon (KDyn 0 false) [])) [] (TCon (KDyn 0 false) [])) "a dyn is not Send")
      (is cs (nothing-needed? (eval g st (TCon (KDyn 0 true) []))) "a send dyn is Send")
      (is cs (nothing-needed? (eval g st (fn0 CSend))) "a send function is Send")
      (is cs (fails-at? (eval g st (fn0 CLocal)) [] (fn0 CLocal)) "a local function is not Send")
      (is cs (nothing-needed? (eval g st (TFn CSend [(ty-cell (ty-i64))] (ty-cell (ty-i64))))) "a function's parameters are not looked at")
      (is cs (fails-at? (send-eval g st (ty-cell (ty-i64)) ["closure capture n"])
                        ["closure capture n"] (ty-cell (ty-i64))) "a path given is the path of the witness"))))

(defun variable-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (st (store-new)) (v (store-fresh st)) (w (store-fresh st)))
    (do
      (is cs (= (var-needs (send-eval g st v ["closure capture x"])) [(Pair v ["closure capture x"])]) "a variable is a need, with its path")
      (is cs (nothing-needed? (eval g st (TFn CSend [] (TRigid 0)))) "a function's result is not looked at")
      (is cs (= (var-needs (eval g st (TRigid 0))) [(Pair (TRigid 0) [])]) "a rigid variable is a need")
      (is cs (= (var-needs (eval g st (TGen 1))) [(Pair (TGen 1) [])]) "a gen variable is a need")
      (is cs (and (= (colour-needs (eval g st (fn0 (CVar 3)))) [(Pair (CVar 3) [])])
                  (= (colour-needs (eval g st (fn0 (CRigid 0)))) [(Pair (CRigid 0) [])])
                  (= (colour-needs (eval g st (fn0 (CGen 1)))) [(Pair (CGen 1) [])])) "a colour variable is a colour need, a rigid and a gen one too")
      (is cs (do (store-bind st (match v ((TVar i) i) (_ 0)) (ty-cell (ty-i64)))
                 (fails-at? (eval g st v) [] (ty-cell (ty-i64)))) "a variable bound to a cell is zonked and fails")
      (is cs (do (store-bind st (match w ((TVar i) i) (_ 0)) (ty-i64))
                 (nothing-needed? (eval g st w))) "a variable bound to i64 is zonked and passes, with no needs"))))

(defun container-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (st (store-new)) (v (store-fresh st))
        (arr (TCon KArray [(ty-cell (ty-i64))])))
    (do
      (is cs (nothing-needed? (eval g st (TCon KArray [(ty-i64)]))) "an array of i64 is Send")
      (is cs (fails-at? (eval g st arr) ["element of (Array (Cell i64))"] (ty-cell (ty-i64))) "an array of cells: the step is element of the array type")
      (is cs (fails-at? (eval g st (TCon KWeak [(ty-cell (ty-i64))])) ["target of (Weak (Cell i64))"] (ty-cell (ty-i64))) "weak: the step is target of")
      (is cs (fails-at? (eval g st (TCon KTask [(ty-cell (ty-i64))])) ["result of (Task (Cell i64))"] (ty-cell (ty-i64))) "task: the step is result of")
      (is cs (fails-at? (eval g st (TCon KArray [arr]))
                        ["element of (Array (Array (Cell i64)))" "element of (Array (Cell i64))"]
                        (ty-cell (ty-i64))) "steps nest, outermost first")
      (is cs (let ((ns (var-needs (eval g st (TCon KArray [v])))))
               (and (= (count ns) 1) (= (. (nth ns 0) fst) v) (= (count (. (nth ns 0) snd)) 1))) "a variable in an array has the step in its path"))))

(defun nominal-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (st (store-new)) (v (store-fresh st)))
    (do
      (is cs (nothing-needed? (eval g st (ty-nominal 0 []))) "a struct of Send fields is Send")
      (is cs (fails-at? (eval g st (ty-nominal 1 [])) ["field c of Holder"] (ty-cell (ty-i64))) "a struct with a cell: field f of S")
      (is cs (fails-at? (eval g st (ty-nominal 7 [])) ["payload of Wrap"] (ty-cell (ty-i64))) "an enum variant with one field: payload of V")
      (is cs (fails-at? (eval g st (ty-nominal 2 [])) ["payload 1 of Both"] (ty-cell (ty-i64))) "an enum variant with several fields: payload i of V")
      (is cs (nothing-needed? (eval g st (ty-nominal 3 []))) "a recursive type is Send (the greatest fixpoint)")
      (is cs (fails-at? (eval g st (ty-nominal 4 [(ty-cell (ty-i64))])) ["field v of Box"] (ty-cell (ty-i64))) "a field of the quantified type is instantiated: Box of a cell")
      (is cs (= (var-needs (eval g st (ty-nominal 4 [v]))) [(Pair v ["field v of Box"])]) "Box of a variable needs the variable, with the field step")
      (is cs (= (var-needs (eval g st (ty-nominal 5 [v])))
                [(Pair v ["field l of Two" "field v of Box"])]) "a (type, args) already examined is skipped, not examined again")
      (is cs (= (count (var-needs (eval g st (TCon KArray [(ty-nominal 4 [v]) (ty-nominal 4 [(TRigid 0)])])))) 2) "the same type at other arguments is examined")
      (is cs (let ((st2 (store-new)) (x (store-fresh st2)))
               (do (store-bind st2 0 (ty-cell (ty-i64)))
                   (fails-at? (eval g st2 (ty-nominal 8 [])) ["field f of Odd"] (ty-cell (ty-i64))))) "the types of the fields are zonked too")
      (is cs (nothing-needed? (eval g st (ty-nominal 6 [(ty-colour-arg CSend)]))) "a colour argument is passed to the field: (Thunk send) is Send")
      (is cs (fails-at? (eval g st (ty-nominal 6 [(ty-colour-arg CLocal)]))
                        ["field f of Thunk"] (TFn CLocal [] (ty-unit))) "(Thunk local) fails at the field")
      (is cs (= (colour-needs (eval g st (ty-nominal 6 [(ty-colour-arg (CVar 5))])))
                [(Pair (CVar 5) ["field f of Thunk"])]) "(Thunk k) needs the colour k, with the field step"))))

(defun error-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (cell-i64 (ty-cell (ty-i64))) (pos (Pos "t.fib" 3 4 10 12)))
    (do
      (is cs (let ((e (send-error g (Witness ["closure capture n"] cell-i64) pos [])))
               (and (= (. e kind) CellNotSend)
                    (= (. e message) "cell cannot be shared between threads: closure capture n has type (Cell i64)")
                    (= (. (. e pos) line) 3))) "send-error of a cell: CellNotSend, the path and the type")
      (is cs (let ((e (send-error g (Witness ["field p of Holder"] (ptr)) pos [])))
               (and (= (. e kind) ValueNotSend)
                    (= (. e message) "value of type ptr cannot be shared between threads: field p of Holder"))) "send-error of another type: ValueNotSend")
      (is cs (= (. (send-error g (Witness [] cell-i64) pos []) message)
                "cell cannot be shared between threads: the value has type (Cell i64)") "an empty path is the value")
      (is cs (= (. (send-error g (Witness ["closure capture self" "field f of Hook"] (fn0 CLocal)) pos []) message)
                "value of type (fn :local () i64) cannot be shared between threads: closure capture self, field f of Hook") "the steps of the path are joined by a comma")
      (is cs (= (. (send-error g (Witness [] (ty-cell (TRigid 0))) pos ["T"]) message)
                "cell cannot be shared between threads: the value has type (Cell T)") "rigid names are the printer's"))))

(defun holds-at? (r: (Option Witness) path: (Vec str) t: Ty) -> bool
  (match r ((some w) (and (= (. w path) path) (= (. w offending) t))) (nil false)))

(defun hold-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (c (ty-cell (ty-i64))))
    (do
      (is cs (holds-at? (def-holds-cell g c) [] c) "a cell is held, at the value")
      (is cs (holds-at? (def-holds-cell g (TCon KWeak [(ty-i64)])) [] (TCon KWeak [(ty-i64)])) "a weak is held, the weak itself the offender")
      (is cs (and (nil? (def-holds-cell g (ty-i64))) (nil? (def-holds-cell g (ty-str)))
                  (nil? (def-holds-cell g (fn0 CLocal))) (nil? (def-holds-cell g (TVar 0)))) "scalars, str, a function and a variable hold none")
      (is cs (nil? (def-holds-cell g (TCon KAtom [(ty-i64)]))) "an Atom of i64 is allowed")
      (is cs (holds-at? (def-holds-cell g (TCon KAtom [c])) ["content of (Atom (Cell i64))"] c) "an Atom of a cell: the step is content of")
      (is cs (holds-at? (def-holds-cell g (TCon KArray [c])) ["element of (Array (Cell i64))"] c) "an array of cells: the step is element of")
      (is cs (holds-at? (def-holds-cell g (TCon KTask [c])) ["result of (Task (Cell i64))"] c) "a task of a cell: the step is result of")
      (is cs (nil? (def-holds-cell g (TCon KArray [(ty-i64)]))) "an array of i64 holds none")
      (is cs (holds-at? (def-holds-cell g (ty-nominal 1 [])) ["field c of Holder"] c) "a struct with a cell: field f of S")
      (is cs (nil? (def-holds-cell g (ty-nominal 0 []))) "a struct of Send fields holds none")
      (is cs (holds-at? (def-holds-cell g (ty-nominal 7 [])) ["payload of Wrap"] c) "an enum variant with one field: payload of V")
      (is cs (holds-at? (def-holds-cell g (ty-nominal 2 [])) ["payload 1 of Both"] c) "an enum variant with several fields: payload i of V")
      (is cs (nil? (def-holds-cell g (ty-nominal 3 []))) "a recursive type holds none (a type seen twice is assumed fine)")
      (is cs (holds-at? (def-holds-cell g (ty-nominal 4 [c])) ["field v of Box"] c) "the quantified field is instantiated: Box of a cell")
      (is cs (holds-at? (def-holds-cell g (ty-nominal 5 [c])) ["field l of Two" "field v of Box"] c) "steps nest, outermost first")
      (is cs (nil? (def-holds-cell g (ty-nominal 5 [(ty-i64)]))) "Box of i64 twice holds none")
      (is cs (match (def-holds-cell g (TCon KArray [(ty-nominal 4 [(ty-i64)]) (ty-nominal 4 [c])]))
               ((some w) (= (. w offending) c))
               (nil false)) "the same type at other arguments is examined")
      (is cs (nil? (def-holds-cell g (ty-nominal 6 [(ty-colour-arg CSend)]))) "a (Thunk send) holds none, its closure is not walked"))))

(defun def-error-tests (cs: StepLog) -> unit
  (let ((g (globals-for-send)) (c (ty-cell (ty-i64))) (pos (Pos "t.fib" 3 4 10 12)))
    (do
      (is cs (let ((e (def-cell-error g "h" (Witness ["field c of Holder"] c) pos)))
               (and (= (. e kind) DefHoldsCell)
                    (= (. e message) "def h: a def may not hold a Cell or a Weak: field c of Holder has type (Cell i64); use an Atom")
                    (= (. (. e pos) line) 3))) "def-cell-error: DefHoldsCell, the name, the path and the type")
      (is cs (= (. (def-cell-error g "c" (Witness [] c) pos) message)
                "def c: a def may not hold a Cell or a Weak: the value has type (Cell i64); use an Atom") "an empty path is the value")
      (is cs (= (. (def-cell-error g "a" (Witness ["element of (Array (Cell i64))" "field c of Holder"] c) pos) message)
                "def a: a def may not hold a Cell or a Weak: element of (Array (Cell i64)), field c of Holder has type (Cell i64); use an Atom") "the steps of the path are joined by a comma"))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do (leaf-tests cs)
        (variable-tests cs)
        (container-tests cs)
        (nominal-tests cs)
        (error-tests cs)
        (hold-tests cs)
        (def-error-tests cs)
        (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-send" [(test-case "checks" unit-steps "compiler/tests/types/unit-send.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
