;; compiler/tests/types/unit-store.fib: the inline tests of crates/fibref/
;; src/types/store.rs (resolve_follows_links_and_zonk_substitutes,
;; binding_lowers_levels, occurs_sees_through_links), and what the Rust
;; ones leave to the types: ids and levels, colour variables, `leave` at
;; level 0, and a store at scale (50,000 variables bound in a chain and
;; resolved: the guard of plan G1, a Vec indexed by id would take minutes).
;; Build: fibc build compiler/tests/types/unit-store.fib -I compiler -I lib -o OUT
(ns tests.types.unit-store (:use types.ty types.store fib.test.unit)
  (:require [fib.test.run :as test-runner]))

(defun var-id (t: Ty) -> i64
  (match t ((TVar v) v) (_ -1)))

;; n variables, each bound to the previous one, the first to i64.
(defun chain (s: Store n: i64) -> Ty
  (loop ((i 0) (prev (ty-i64)))
    (if (< i n)
        (let ((v (store-fresh s)))
          (do (store-bind s (var-id v) prev) (recur (+ i 1) v)))
        prev)))

(defun snapshots (cs: StepLog) -> unit
  (let ((s (store-new)) (v (store-fresh-lit s 3)) (id (var-id v)))
    (let ((nodes @(. s nodes)) (lits @(. s lits)))
      (do (store-widen-lit s id 90)
          (store-bind s id (ty-i64))
          (store-fresh s)
          (is cs (= (map-count nodes) 1) "a held node snapshot excludes fresh variables")
          (is cs (match (get nodes id) ((some (Unbound level)) (= level 0)) (_ false))
              "binding preserves the old node snapshot")
          (is cs (= (get lits id) (some 3)) "widening preserves the old literal snapshot")
          (is cs (= (store-lit-of s id) (some 90)) "the live store widens the literal")
          (is cs (= (store-resolve s v) (ty-i64)) "the live store resolves the binding")))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do
      (let ((s (store-new))
            (a (store-fresh s))
            (b (store-fresh s)))
        (do (store-bind s (var-id a) b)
            (store-bind s (var-id b) (ty-i64))
            (is cs (= (store-resolve s a) (ty-i64)) "resolve follows links")
            (is cs (= (store-zonk s (ty-cell a)) (ty-cell (ty-i64))) "zonk substitutes")))
      (let ((s (store-new)))
        (do (store-enter s)
            (let ((outer (store-fresh s)))
              (do (store-enter s)
                  (let ((inner (store-fresh s)))
                    (do (is cs (= (store-level-of s (var-id inner)) (some 2)) "inner variable is at level 2")
                        (store-bind s (var-id outer) (ty-cell inner))
                        (is cs (= (store-level-of s (var-id inner)) (some 1)) "binding lowers levels")
                        (is cs (nil? (store-level-of s (var-id outer))) "a bound variable has no level")))))))
      (let ((s (store-new))
            (a (store-fresh s))
            (b (store-fresh s)))
        (do (store-bind s (var-id b) (ty-cell a))
            (is cs (store-occurs s (var-id a) b) "occurs sees through links")
            (is cs (not (store-occurs s (var-id b) a)) "occurs is false for an unrelated variable")))
      (let ((s (store-new)))
        (is cs (= [(store-fresh s) (store-fresh s) (store-fresh s)] [(TVar 0) (TVar 1) (TVar 2)]) "variables are numbered from 0 in order"))
      (let ((s (store-new)))
        (is cs (= [(store-fresh-colour s) (store-fresh-colour s)] [(CVar 0) (CVar 1)]) "colour variables are numbered from 0"))
      (let ((s (store-new)))
        (do (store-leave s)
            (is cs (= (store-level s) 0) "leave stops at level 0")
            (store-enter s) (store-enter s) (store-leave s)
            (is cs (= (store-level s) 1) "enter and leave")))
      (let ((s (store-new))
            (end (chain s 50000)))
        (do (is cs (= (store-resolve s end) (ty-i64)) "a chain of 50000 resolves to its end")
            (is cs (= (store-zonk s (ty-cell end)) (ty-cell (ty-i64))) "and zonks to it")))
      (snapshots cs)
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-store" [(test-case "checks" unit-steps "compiler/tests/types/unit-store.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
