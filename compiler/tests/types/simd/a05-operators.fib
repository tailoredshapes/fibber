(ns main)
(impl (Div (Simd a n)) (Simd a n) :where ((Float a)) (/ (self y) (fdiv self y)))
(defun f (v: f64x4 w: f64x4) -> f64x4 (/ (- (* v w) w) (neg v)))
(defun g (a: i32x4 b: i32x4) -> i32x4 (bit-xor (bit-and a b) (bit-not (bit-or a b))))
(defun h (a: i32x4) -> i32x4 (shl a 3))
(defun k (a: f64x2) -> f64x2 (/ a 2.0))
(defun d (a: f64x2) -> f64x2 (/ 2.0 a))
(defun main () -> i64 0)
