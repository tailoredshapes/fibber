(ns main)
(defstruct P (v: f64x4 n: i64))
(defun f (v: f64x4) -> (Atom f64x4) (atom v))
(defun g (p: P) -> f64x4 (. p v))
(defun h (v: f64x4) -> (Task f64x4) (spawn (fn () v)))
(defun k (v: f64x4) -> (Vec f64x4) [v v])
(defun m (v: f64x4 w: f64x4) -> f64x4 (+ (* v 2.0) (splat f64x4 (lane w 0))))
(defun main () -> i64 0)
