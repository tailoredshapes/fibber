(ns main)
(defun f (v: f64x4) -> f64 (lane v 3))
(defun g (v: f64x4 x: f64) -> f64x4 (with-lane v 0 x))
(defun h (v: i32x4) -> i32 (hsum v))
(defun k (v: f32x8) -> f32 (+ (hmin v) (hmax v)))
(defun d (v: f64x4 i: i64) -> f64 (lane v i))
(defun m (v: (Mask 4)) -> bool (lane v 0))
(defun main () -> i64 0)
