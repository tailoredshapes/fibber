;; compiler/tests/types/unit-impl-head.fib: instance heads (types.lower.impl-head). Three kinds
;; of check:
;; - the cases of protos-cases/ whose point is a head (a variable, repeated variables, a
;;   constructor argument that is no variable, colour variables and written colours): the lines
;;   or errors the tool prints (see protos-support.fib);
;; - the inline test of impl_head.rs, `HeadEnv` reads a colour variable only at a colour
;;   parameter, over the five methods of `AnnEnv`;
;; - `colour-vars`, `body-args` and `fixed-colours` on the instances lowering makes, with the
;;   values the code of impl_head.rs gives (the tool prints none of them).
;; Run from the repository root.
;; Build: fibc build compiler/tests/types/unit-impl-head.fib -I compiler -I lib -o OUT
(ns tests.types.unit-impl-head (:use fib.string syntax.pos syntax.form types.ty types.scheme types.error types.ast
               types.table types.decls fib.test.unit types.annot types.lower.typeform
               types.lower.impl-head tests.types.lower-support tests.types.protos-support)
  (:require [fib.test.run :as test-runner]))

(def case-names: (Vec str)
  ["impl-head-var" "impl-head-dup" "impl-head-nonvar" "impl-head-fn" "impl-head-dyn"
   "impl-head-notype" "impl-head-unknown" "impl-head-colour-dup" "impl-head-colour-var-as-ty"
   "impl-head-colour-in-where" "impl-head-ty-as-colour" "impl-head-colour-at-type"
   "impl-colour" "impl-colour-var" "impl-basic"])

;; the inline test of impl_head.rs
;; the lenient environment: an unknown name takes the next index and is remembered; check-determined
(defun lenient-env (cs: StepLog) -> unit
  (let ((env (head-env-new ["c"] [false]))
        (mk (fn (s: i64 d: i64) (PProto 0 [(TGen s) (TGen d)])))
        (vars ["c" "k" "j"])
        (k [(Pair 1 p0)])
        (kj [(Pair 1 p0) (Pair 2 p0)]))
    (do (is cs (match (ann-var env "k" p0) ((Ok t) (= t (TGen 1))) (_ false)) "lenient: k is the next index")
        (is cs (= (count @(. env extras)) 1) "lenient: k is kept as an extra")
        (is cs (match (ann-var env "k" p0) ((Ok t) (= t (TGen 1))) (_ false)) "lenient: the second use is the same index")
        (is cs (= (count @(. env extras)) 1) "lenient: the extra is not repeated")
        (is cs (match (check-determined vars 1 k [(mk 0 1)]) ((Ok _) true) (_ false)) "determined by a head variable")
        (is cs (match (check-determined vars 1 k [])
                 ((Err e) (= (. e message) "type variable k is not a parameter of the impl head"))
                 (_ false)) "no constraint: the old error")
        (is cs (match (check-determined vars 1 kj [(mk 1 2) (mk 2 1)]) ((Err _) true) (_ false)) "k and j determine each other only: error")
        (is cs (match (check-determined vars 1 kj [(mk 1 2) (mk 0 1)]) ((Ok _) true) (_ false)) "j determined through k"))))

(defun head-env (cs: StepLog) -> unit
  (let ((env (HeadEnv (cell ["a" "k"]) (cell [false true]) false (cell []))))
    (do (is cs (match (ann-var env "a" p0) ((Ok t) (= t (TGen 0))) (_ false)) "var a is TGen 0")
        (is cs (match (ann-var env "k" p0) ((Err _) true) (_ false)) "var k (a colour variable) is an error")
        (is cs (match (ann-colour-param-arg env "k" p0) ((some (Ok t)) (= t (TGen 1))) (_ false)) "colour-param-arg k is TGen 1")
        (is cs (match (ann-colour-param-arg env "a" p0) ((some (Err _)) true) (_ false)) "colour-param-arg a is an error")
        (is cs (match (ann-named-colour env "k" p0) ((Err _) true) (_ false)) "named-colour k is an error")
        ;; beyond the test: the messages, the unknown name, the colour of an omitted fn colour
        (is cs (match (ann-var env "k" p0)
                 ((Err e) (and (= (. e message) "k is a colour parameter of the impl head, not a type") (= (. e kind) Resolve)))
                 (_ false)) "var k: message")
        (is cs (match (ann-var env "z" p0)
                 ((Err e) (= (. e message) "type variable z is not a parameter of the impl head"))
                 (_ false)) "var z: message")
        (is cs (match (ann-colour-param-arg env "a" p0)
                 ((some (Err e)) (= (. e message) "a is not a colour variable of the impl head"))
                 (_ false)) "colour-param-arg a: message")
        (is cs (match (ann-colour-param-arg env "z" p0)
                 ((some (Err e)) (= (. e message) "z is not a colour variable of the impl head"))
                 (_ false)) "colour-param-arg z: message")
        (is cs (match (ann-named-colour env "k" p0)
                 ((Err e) (= (. e message) "k may be used here only as the argument of a colour parameter"))
                 (_ false)) "named-colour: message")
        (is cs (= (ann-colour env) CLocal) "an omitted colour is local")
        (is cs (match (ann-self-ty env p0) ((Err _) true) (_ false)) "no Self"))))

(def head-src: str "(defstruct (Cap k :colour a) (f: (fn k (a) a)))
(defstruct (Hook k :colour) (f: (fn k (i64) i64) tag: i64))
(defstruct (Two2 a b) (x: a y: b))
(defprotocol Plain (plain (self) -> i64))
")

;; the instance `i` of the source's lowering
(defun inst-of (src: str i: i64) -> InstanceDef
  (table-get (. (. (lower-src (str-join [head-src src])) g) instances) i))

(defun derived (cs: StepLog) -> unit
  (let ((l (lower-src (str-join [head-src "(impl Plain (Cap k a) (plain (self) 1))"])))
        (g (. l g))
        (i0 (table-get (. g instances) 0)))
    (do (is cs (empty? (. l errors)) "no errors")
        (is cs (= (colour-vars g i0) [true false]) "colour-vars (Cap k a) = [k a]")
        (is cs (= (body-args g i0) [(ty-colour-arg (CRigid 0)) (TRigid 1)]) "body-args (Cap k a): the rigid colour, the rigid variable")
        (is cs (= (fixed-colours g (. i0 head)) [nil nil]) "fixed-colours (Cap k a) = none, none")
        (is cs (= (. i0 head) (TCon (KNominal 0) [(TGen 0) (TGen 1)])) "head: TGen 0, TGen 1")
        (is cs (= (. i0 var-names) ["k" "a"]) "variables"))))

(defun written (cs: StepLog) -> unit
  (let ((l (lower-src (str-join [head-src "(impl Plain (Cap :local a) (plain (self) 1))\n(impl Plain (Hook :send) (plain (self) 2))\n(impl Plain i64 (plain (self) 3))\n(impl Plain (Two2 a b) (plain (self) 4))"])))
        (g (. l g)))
    (if (not (empty? (. l errors)))
        (is cs false "written colours lower")
        (let ((i (fn (n: i64) (table-get (. g instances) n))))
          (do (is cs (= (. (i 0) head) (TCon (KNominal 0) [(ty-colour-arg CLocal) (TGen 0)])) "(Cap :local a): the head holds the colour argument")
              (is cs (= (colour-vars g (i 0)) [false]) "(Cap :local a): colour-vars = [a is no colour]")
              (is cs (= (body-args g (i 0)) [(TRigid 0)]) "(Cap :local a): body-args = [rigid a]")
              (is cs (= (fixed-colours g (. (i 0) head)) [(some CLocal) nil]) "(Cap :local a): fixed-colours = [local, none]")
              (is cs (and (= (colour-vars g (i 1)) []) (= (body-args g (i 1)) [])
                          (= (fixed-colours g (. (i 1) head)) [(some CSend)])) "(Hook :send): no variables, fixed send")
              (is cs (and (= (colour-vars g (i 2)) []) (= (fixed-colours g (. (i 2) head)) [])) "i64: nothing")
              (is cs (and (= (colour-vars g (i 3)) [false false]) (= (body-args g (i 3)) [(TRigid 0) (TRigid 1)])
                          (= (fixed-colours g (. (i 3) head)) [nil nil])) "(Two2 a b): two type variables")
              (is cs (and (= (var-index ["a" "b" "c"] "c") (some 2)) (not (some? (var-index ["a"] "z")))) "var-index"))))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do (run-cases cs case-names)
        (head-env cs)
        (lenient-env cs)
        (derived cs)
        (written cs)
        (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-impl-head" [(test-case "checks" unit-steps "compiler/tests/types/unit-impl-head.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
