;; compiler/tests/types/unit-expr.fib: crates/fibref/src/types/infer/expr.rs has no
;; inline tests, so these programs are written from its code and doc comments, over
;; hand-built ASTs: each expression kind of `cx-infer` (the types it gives and records,
;; the constraints it defers, the errors and their texts, and when the worklist is
;; retried), with the builtin world of types.init (`Option`, `Form`, `Bits`, ..) plus a
;; prelude `Vec` (type 2) and a main-module struct `S { f: i64 }` (type 3).
;; Calls, annotations and patterns are P11a's; `let`, `match` and `loop` use its
;; `cx-check-pattern` and `cx-binding-ann` for a wildcard and a bound name.
;; Build: fibc build compiler/tests/types/unit-expr.fib -I compiler -I lib -o OUT
(ns tests.types.unit-expr (:use syntax.pos syntax.form types.ty types.scheme types.error types.store types.table types.ast
               types.decls types.names types.init types.infer.cx types.infer.unify types.infer.solve
               types.infer.expr fib.test.unit)
  (:require [fib.test.run :as test-runner]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))

;; Bindings 0..5 are `a`..`f`, `S` is type 3, `Vec` type 2.
(defun world () -> Globals
  (match (new-globals)
    ((Ok g)
     (do (table-add (. g types) (TypeDef "Vec" module-prelude ["a"] [] (TsStruct []) p0))
         (table-add (. g types) (TypeDef "S" module-main [] [] (TsStruct [(FieldDef "f" (ty-i64))]) p0))
         (set! (. g vec) (some 2))
         (doseq [n ["a" "b" "c" "d" "e" "f"]] (table-add (. g bindings) (BindingInfo n BkLet p0 nil)))
         g))
    ((Err e) (trap (type-error-text e)))))

;; The builtin module with nothing in it: `Bits` is not declared.
(defun bare-world () -> Globals
  (let ((g (globals-new)))
    (do (table-add (. g modules) (ModuleInfo "the builtins" (names-new) [0] [] [] [] (map-empty)))
        g)))

(defun cx-of (g: Globals) -> Cx (Cx g (env-new) (store-new) (tables-new) (unit-new)))
(defun fresh-cx () -> Cx (cx-of (world)))
(defun s-ty () -> Ty (ty-nominal 3 []))
(defun vec-of (a: Ty) -> Ty (ty-nominal 2 [a]))

;; ---- builders: every expression has an id of its own

(defun ex (id: i64 k: ExprKind) -> Expr (Expr id p0 k))
(defun int (id: i64) -> Expr (ex id (ELit (LitInt 1 I64))))
(defun bool-lit (id: i64 v: bool) -> Expr (ex id (ELit (LitBool v))))
(defun str-lit (id: i64) -> Expr (ex id (ELit (LitStr "s"))))
(defun unit-lit (id: i64) -> Expr (ex id (ELit LitUnit)))
(defun local (id: i64 b: i64) -> Expr (ex id (ELocal b)))

(defun left (cx: Cx) -> i64 (count @(. (. cx u) deferred)))
(defun bind! (cx: Cx b: i64 t: Ty) -> unit (cx-bind cx b t))

(defun ty-is? (cx: Cx r: (Result Ty TypeError) t: Ty) -> bool
  (match r ((Ok x) (= (cx-zonk cx x) t)) (_ false)))
(defun fails? (r: (Result Ty TypeError) kind: ErrorKind msg: str) -> bool
  (match r ((Err e) (and (= (. e kind) kind) (= (. e message) msg))) (_ false)))
(defun fails-kind? (r: (Result Ty TypeError) kind: ErrorKind) -> bool
  (match r ((Err e) (= (. e kind) kind)) (_ false)))
(defun solved? (cx: Cx) -> bool
  (match (cx-solve-all cx) ((Ok _) (= (left cx) 0)) (_ false)))
(defun recorded? (cx: Cx id: i64 t: Ty) -> bool
  (match (get @(. (. cx t) expr-types) id)
    ((some x) (and (= (cx-zonk cx x) t) (includes? id @(. (. cx u) exprs))))
    (nil false)))
(defun loops-depth (cx: Cx) -> i64 (count @(. (. cx u) loops)))

;; ---- literals and the record of types

(defun literal-tests (cs: StepLog) -> unit
  (let ((cx (fresh-cx)))
    (do (is cs (ty-is? cx (cx-infer cx (ex 1 (ELit (LitInt 1 I8)))) (ty-scalar SI8)) "an i8 literal is i8")
        (is cs (ty-is? cx (cx-infer cx (ex 2 (ELit (LitInt 1 I32)))) (ty-scalar SI32)) "an i32 literal is i32")
        (is cs (ty-is? cx (cx-infer cx (ex 3 (ELit (LitFloat 1.5 F32)))) (ty-scalar SF32)) "an f32 literal is f32")
        (is cs (ty-is? cx (cx-infer cx (str-lit 4)) (ty-str)) "a string literal is str")
        (is cs (ty-is? cx (cx-infer cx (ex 5 (ELit (LitKeyword "k")))) (ty-scalar SKeyword)) "a keyword literal is a keyword")
        (is cs (ty-is? cx (cx-infer cx (unit-lit 6)) (ty-unit)) "the unit literal is unit")
        (is cs (and (recorded? cx 1 (ty-scalar SI8)) (recorded? cx 4 (ty-str)) (recorded? cx 6 (ty-unit))
                    (= (count @(. (. cx u) exprs)) 6)) "the type of each expression is recorded, with its id in the unit's list")
        (is cs (do (bind! cx 0 (ty-str))
                   (ty-is? cx (cx-infer cx (local 7 0)) (ty-str))) "a bound name has the type of its binding")
        (is cs (fails? (cx-infer cx (local 8 1)) Other "internal: b has no type") "a name with no type is an internal error")
        (is cs (ty-is? cx (cx-infer cx (ex 9 (EUnsafe (int 10)))) (ty-i64)) "`unsafe` has the type of its body"))))

;; ---- if and the test of an if

(defun if-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EIf (bool-lit 2 true) (int 3) (int 4)))) (ty-i64)) "an `if` with a bool test has the type of its branches"))
    (let ((cx (fresh-cx)))
      (do (cx-infer cx (ex 1 (EIf (bool-lit 2 true) (int 3) (int 4))))
          (is cs (and (recorded? cx 2 (ty-bool)) (recorded? cx 3 (ty-i64)) (recorded? cx 4 (ty-i64))) "the test and both branches are recorded")))
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (EIf (int 2) (int 3) (int 4)))) Unify
                     "a value of type i64 is always true; write the test") "a test of type i64 can never be false"))
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (EIf (str-lit 2) (int 3) (int 4)))) Unify
                     "a value of type str is always true; write the test") "a test of type str can never be false"))
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (EIf (unit-lit 2) (int 3) (int 4)))) Unify
                     "cannot unify unit with bool") "a unit test is the usual mismatch"))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-nominal 0 [(ty-i64)]))
          (is cs (ty-is? cx (cx-infer cx (ex 1 (EIf (local 2 0) (int 3) (int 4)))) (ty-i64)) "an Option test is a test (L20)")))
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (EIf (bool-lit 2 true) (int 3) (str-lit 4)))) Unify
                     "cannot unify str with i64") "the branches flow into one result: a second type is a mismatch"))
    (let ((cx (fresh-cx)))
      (is cs (and (fails-kind? (cx-infer cx (ex 1 (EIf (int 2) (int 3) (int 4)))) Unify)
                  (nil? (get @(. (. cx t) expr-types) 3))) "the else branch is not inferred after a failing test"))))

;; ---- do

(defun do-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EDo []))) (ty-unit)) "an empty `do` is unit"))
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EDo [(int 2) (str-lit 3)]))) (ty-str)) "a `do` has the type of its last step"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EDo [(int 2) (bool-lit 3 true) (str-lit 4)]))) (ty-str))
                  (= @(. (. cx u) exprs) [2 3 4 1])) "every step is inferred, in order"))
    (let ((cx (fresh-cx)))
      (is cs (and (fails-kind? (cx-infer cx (ex 1 (EDo [(ex 2 (EIf (int 3) (int 4) (int 5))) (int 6)]))) Unify)
                  (nil? (get @(. (. cx t) expr-types) 6))) "a failing step stops the `do`"))))

;; ---- fields, cells, tasks, concatenation, quote

(defun field-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (s-ty))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EField (local 2 0) "f" "a"))) (ty-i64))
                      (= (left cx) 0)) "a field of a struct is the type of the field, solved at its form")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (s-ty))
          (is cs (fails? (cx-infer cx (ex 1 (EField (local 2 0) "g" "a"))) NoField "S has no field g") "a missing field is a NoField error at the access")))
    (let ((cx (fresh-cx)) (v (cx-fresh cx)))
      (do (bind! cx 0 v)
          (is cs (and (ok-ty? (cx-infer cx (ex 1 (EField (local 2 0) "f" "a")))) (= (left cx) 1)) "a field of an unknown type waits on the worklist")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (s-ty)))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (ESetField 0 "f" (int 2)))) (ty-unit))
                      (= (left cx) 1)
                      (solved? cx)) "set-field! on a cell variable is unit, the field waiting for the access")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (s-ty)))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (ESetField 0 "f" (str-lit 2)))) (ty-unit))
                      (match (cx-solve-all cx) ((Err e) (= (. e kind) Unify)) (_ false))) "set-field! of the wrong type is a mismatch once the field is known")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-i64))
          (is cs (fails? (cx-infer cx (ex 1 (ESetField 0 "f" (int 2)))) AmpArgument
                         "& argument must be a cell variable") "set-field! of a variable that is not a cell is an AmpArgument error")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (s-ty)))
          (is cs (do (cx-infer cx (ex 1 (ESetField 0 "f" (int 2))))
                     (match (. (nth @(. (. cx u) deferred) 0) kind)
                       ((DkField _ _ _ text) (= text "@a"))
                       (_ false))) "set-field! defers its field with the printed cell variable")))))

(defun ok-ty? (r: (Result Ty TypeError)) -> bool (match r ((Ok _) true) (_ false)))

(defun cell-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (ty-i64)))
          (is cs (ty-is? cx (cx-infer cx (ex 1 (EDeref (PlAmp 0) "a"))) (ty-i64)) "`@` of a cell variable is its content")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-i64))
          (is cs (fails-kind? (cx-infer cx (ex 1 (EDeref (PlAmp 0) "a"))) Unify) "`@` of a variable that is not a cell is a mismatch")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (ty-i64)))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EDeref (PlExpr (local 2 0)) "a"))) (ty-i64))
                      (= (left cx) 0)) "`@` of an expression defers a dereference, solved at its form")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-i64))
          (is cs (fails-kind? (cx-infer cx (ex 1 (EDeref (PlExpr (local 2 0)) "a"))) NoInstance) "`@` of an i64 is a NoInstance error for Deref at the form")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (ty-i64)))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (ESet (PlAmp 0) (int 2)))) (ty-unit))
                      (recorded? cx 2 (ty-i64))) "set! of a cell variable is unit")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (ty-i64)))
          (is cs (fails? (cx-infer cx (ex 1 (ESet (PlAmp 0) (str-lit 2)))) Unify "cannot unify str with i64") "set! of a value of another type is a mismatch")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-cell (ty-i64)))
          (is cs (ty-is? cx (cx-infer cx (ex 1 (ESet (PlExpr (local 2 0)) (int 3)))) (ty-unit)) "set! of an expression place is a cell too")))))

(defun task-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-task (ty-str)))
          (is cs (ty-is? cx (cx-infer cx (ex 1 (EAwait (local 2 0)))) (ty-str)) "await of a task is its result")))
    (let ((cx (fresh-cx)))
      (is cs (fails-kind? (cx-infer cx (ex 1 (EAwait (int 2)))) Unify) "await of a value that is not a task is a mismatch"))
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EAsync (int 2) []))) (ty-task (ty-i64))) "an async block is a task of its body"))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (ty-str))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EAsync (int 2) [0]))) (ty-task (ty-i64)))
                      (= (left cx) 1)
                      (match (. (nth @(. (. cx u) deferred) 0) kind)
                        ((DkSend t path) (and (= t (ty-str)) (= path ["async capture a"])))
                        (_ false))) "an async capture defers Send of its type, by the capture's name")))
    (let ((cx (fresh-cx)))
      (is cs (do (set! (. (. cx u) loops) [[(ty-i64)]])
                 (and (fails? (cx-infer cx (ex 1 (EAsync (ex 2 (ERecur [(int 3)])) []))) Other
                              "recur outside loop")
                      (= (loops-depth cx) 1))) "a recur in an async block cannot see the loop outside"))
    (let ((cx (fresh-cx)))
      (is cs (do (set! (. (. cx u) loops) [[(ty-i64)]])
                 (and (ty-is? cx (cx-infer cx (ex 1 (EAsync (int 2) []))) (ty-task (ty-i64)))
                      (= (loops-depth cx) 1))) "the loops are back after an async block"))))

(defun misc-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EQuote (Stx SNil p0)))) (ty-nominal 1 [])) "a quoted form is a Form"))
    (let ((cx (cx-of (globals-new))))
      (is cs (fails? (cx-infer cx (ex 1 (EQuote (Stx SNil p0)))) Other "Form is not declared") "a quoted form without a Form type is an error"))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (vec-of (ty-i64)))
          (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConcat [(local 2 0) (local 3 0)]))) (vec-of (ty-i64)))
                      (recorded? cx 3 (vec-of (ty-i64)))) "a concatenation of vectors is a vector")))
    (let ((cx (fresh-cx)))
      (do (bind! cx 0 (vec-of (ty-i64)))
          (is cs (fails-kind? (cx-infer cx (ex 1 (EConcat [(local 2 0) (int 3)]))) Unify) "the parts of a concatenation must agree")))
    (let ((cx (fresh-cx)))
      (is cs (match (cx-infer cx (ex 1 (EConcat [])))
               ((Ok t) (match (cx-zonk cx t) ((TCon (KNominal 2) [(TVar _)]) true) (_ false)))
               (_ false)) "an empty concatenation is a vector of an unknown element"))
    (let ((cx (cx-of (globals-new))))
      (is cs (fails? (cx-infer cx (ex 1 (EConcat []))) Other "concat needs the prelude's Vec") "a concatenation without the prelude's Vec is an error"))))

;; ---- trait objects and conversions

(defun dyn-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EDyn 0 [] false (int 2)))) (TCon (KDyn 0 false) []))
                  (= (left cx) 2)) "a trait object has the dyn type of its protocol, with Object and the protocol deferred"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EDyn 0 [] true (int 2)))) (TCon (KDyn 0 true) []))
                  (= (left cx) 3)
                  (match (. (nth @(. (. cx u) deferred) 1) kind)
                    ((DkSend t path) (and (= t (ty-i64)) (empty? path)))
                    (_ false))) "a sendable trait object also defers Send, with an empty path"))
    (let ((cx (fresh-cx)))
      (is cs (do (cx-infer cx (ex 1 (EDyn 0 [] false (int 2))))
                 (match (. (nth @(. (. cx u) deferred) 0) kind)
                   ((DkObject t what) (and (= t (ty-i64)) (= what "dyn")))
                   (_ false))) "the constraints of a trait object are not solved at its form"))))

(defun convert-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConvert (CvIntToInt Trunc) SI32 (int 2)))) (ty-scalar SI32))
                  (= (left cx) 1)
                  (match (. (nth @(. (. cx u) deferred) 0) kind) ((DkProto _ args _) (= args [(ty-i64)])) (_ false))
                  (solved? cx)) "an integer conversion has the target type and defers Bits of the operand"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConvert (CvIntToFloat true) SF64 (int 2)))) (ty-scalar SF64))
                  (match (. (nth @(. (. cx u) deferred) 0) kind) ((DkProto _ _ _) true) (_ false))) "an integer to float conversion needs Bits too"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConvert CvFloatToFloat SF32 (ex 2 (ELit (LitFloat 1.5 F64)))))) (ty-scalar SF32))
                  (match (. (nth @(. (. cx u) deferred) 0) kind) ((DkFloat t) (= t (ty-scalar SF64))) (_ false))
                  (solved? cx)) "a float conversion defers a float constraint"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConvert (CvFloatToInt true) SI64 (ex 2 (ELit (LitFloat 1.5 F64)))))) (ty-i64))
                  (match (. (nth @(. (. cx u) deferred) 0) kind) ((DkFloat _) true) (_ false))) "a float to integer conversion defers a float constraint"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (EConvert CvFloatToFloat SF32 (int 2)))) (ty-scalar SF32))
                  (fails-kind? (match (cx-solve-all cx) ((Err e) (Err e)) (_ (Ok (ty-unit)))) Unify)) "an integer operand of a float conversion is not a float"))
    (let ((cx (cx-of (bare-world))))
      (is cs (fails? (cx-infer cx (ex 1 (EConvert (CvIntToInt Zext) SI32 (int 2)))) Other "no Bits protocol") "an integer conversion without the Bits protocol is an error at the operand"))))

;; ---- functions

(defun fn-lit (name: (Option i64) params: (Vec FnParam) body: Expr captures: (Vec i64)) -> FnLit
  (FnLit name params nil body captures))

(defun fn-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (match (cx-infer cx (ex 1 (EFn (fn-lit nil [(FnParam 0 nil) (FnParam 1 nil)] (local 2 0) []))))
               ((Ok t) (match (cx-zonk cx t)
                         ((TFn (CVar _) [pa pb] r) (and (= pa r) (not= pa pb)))
                         (_ false)))
               (_ false)) "a function literal has a function type of fresh parameters and result"))
    (let ((cx (fresh-cx)))
      (is cs (match (cx-infer cx (ex 1 (EFn (fn-lit nil [(FnParam 0 nil)] (int 2) []))))
               ((Ok t) (match (cx-zonk cx t) ((TFn _ [_] r) (= r (ty-i64))) (_ false)))
               (_ false)) "the body flows into the result: the result is the body's type"))
    (let ((cx (fresh-cx)))
      (do (cx-infer cx (ex 1 (EFn (fn-lit nil [(FnParam 0 nil)] (int 2) []))))
          (is cs (and (some? (get @(. (. cx t) binding-types) 0))
                      (= (count @(. (. cx u) fn-lits)) 1)
                      (= (. (nth @(. (. cx u) fn-lits) 0) fst) 1)) "the parameter is bound, and the literal's colour is recorded for the unit")))
    (let ((cx (fresh-cx)))
      (is cs (match (cx-infer cx (ex 1 (EDo [(ex 2 (EFn (fn-lit nil [] (int 3) []))) (ex 4 (EFn (fn-lit nil [] (int 5) [])))])))
               ((Ok _) (= (mapv (fn (p: (Pair i64 Colour)) (. p snd)) @(. (. cx u) fn-lits))
                          [(CVar 0) (CVar 1)]))
               (_ false)) "the colour of a literal is a fresh colour variable, the next one for each literal"))
    (let ((cx (fresh-cx)))
      (do (bind! cx 2 (ty-str))
          (is cs (and (ok-ty? (cx-infer cx (ex 1 (EFn (fn-lit nil [] (int 2) [2])))))
                      (= (count @(. (. cx u) caps)) 1)
                      (let ((c (nth @(. (. cx u) caps) 0)))
                        (and (= (. c colour) (CVar 0)) (= (. c ty) (ty-str))
                             (= (. c label) "closure capture c")))) "a capture constrains the colour of the function by the captured type")))
    (let ((cx (fresh-cx)))
      (is cs (match (cx-infer cx (ex 1 (EFn (fn-lit (some 3) [] (int 2) []))))
               ((Ok t) (match (get @(. (. cx t) binding-types) 3) ((some b) (= b t)) (nil false)))
               (_ false)) "a named function literal binds its name to its own type"))
    (let ((cx (fresh-cx)))
      (is cs (fails-kind? (cx-infer cx (ex 1 (EFn (fn-lit nil [] (ex 2 (EIf (int 3) (int 4) (int 5))) [])))) Unify) "the error of a body is the error of the literal"))))

;; ---- recur, and the forms that use patterns (P11a)

(defun recur-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (ERecur []))) Other "recur outside loop") "recur outside a loop is an error"))
    (let ((cx (fresh-cx)))
      (is cs (do (set! (. (. cx u) loops) [[(ty-i64) (ty-str)]])
                 (fails? (cx-infer cx (ex 1 (ERecur [(int 2)]))) Other "recur takes 2 argument(s), got 1")) "recur takes as many arguments as the loop has variables"))
    (let ((cx (fresh-cx)))
      (is cs (do (set! (. (. cx u) loops) [[(ty-i64) (ty-str)]])
                 (and (ok-ty? (cx-infer cx (ex 1 (ERecur [(int 2) (str-lit 3)]))))
                      (fails-kind? (cx-infer cx (ex 4 (ERecur [(int 5) (int 6)]))) Unify))) "an argument of recur flows into its variable, the result is fresh"))
    (let ((cx (fresh-cx)))
      (is cs (do (set! (. (. cx u) loops) [[(ty-str)] [(ty-i64)]])
                 (ok-ty? (cx-infer cx (ex 1 (ERecur [(int 2)]))))) "the innermost loop is the one recur sees"))))

(defun wild () -> Pattern (Pattern p0 PWild))
(defun pbind (b: i64) -> Pattern (Pattern p0 (PBind b)))

(defun pattern-tests (cs: StepLog) -> unit
  (do
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (ELet [(LetBind (pbind 0) (str-lit 2))] (local 3 0)))) (ty-str))
                  (some? (get @(. (. cx t) binding-types) 0))) "a `let` has the type of its body, a bound name its initialiser's"))
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (ELet [(LetBind (pbind 0) (int 2)) (LetBind (pbind 1) (local 3 0))] (local 4 1)))) (ty-i64)) "the bindings of a `let` are in scope for the next ones, in order"))
    (let ((cx (fresh-cx)))
      (is cs (and (fails-kind? (cx-infer cx (ex 1 (ELet [(LetBind (wild) (ex 2 (EIf (int 3) (int 4) (int 5)))) (LetBind (pbind 0) (int 6))] (int 7)))) Unify)
                  (nil? (get @(. (. cx t) expr-types) 6))) "a failing initialiser stops the `let`"))
    (let ((cx (fresh-cx)))
      (is cs (ty-is? cx (cx-infer cx (ex 1 (EMatch (int 2) [(Clause (wild) nil (str-lit 3) false) (Clause (pbind 0) nil (str-lit 4) false)]))) (ty-str)) "a match has the type of its clauses, flowing into one result"))
    (let ((cx (fresh-cx)))
      (is cs (fails? (cx-infer cx (ex 1 (EMatch (int 2) [(Clause (wild) nil (str-lit 3) false) (Clause (wild) nil (int 4) false)]))) Unify
                     "cannot unify i64 with str") "a second clause of another type is a mismatch"))
    (let ((cx (fresh-cx)))
      (is cs (and (ok-ty? (cx-infer cx (ex 1 (EMatch (int 2) [(Clause (wild) (some (bool-lit 3 true)) (int 4) false)]))))
                  (fails? (cx-infer cx (ex 5 (EMatch (int 6) [(Clause (wild) (some (int 7)) (int 8) false)]))) Unify
                          "cannot unify i64 with bool")) "a guard is a bool"))
    (let ((cx (fresh-cx)))
      (is cs (and (ty-is? cx (cx-infer cx (ex 1 (ELoop [(LoopBind 0 (int 2))] (local 3 0)))) (ty-i64))
                  (= (loops-depth cx) 0)) "a loop has the type of its body, its variables the type of their initialisers"))
    (let ((cx (fresh-cx)))
      (is cs (and (ok-ty? (cx-infer cx (ex 1 (ELoop [(LoopBind 0 (int 2))] (ex 3 (ERecur [(int 4)]))))))
                  (fails-kind? (cx-infer cx (ex 5 (ELoop [(LoopBind 1 (int 6))] (ex 7 (ERecur [(str-lit 8)]))))) Unify)
                  (= (loops-depth cx) 0)) "recur in a loop flows into the variable"))
    (let ((cx (fresh-cx)))
      (is cs (and (fails-kind? (cx-infer cx (ex 1 (ELoop [(LoopBind 0 (int 2))] (ex 3 (EIf (int 4) (int 5) (int 6)))))) Unify)
                  (= (loops-depth cx) 0)) "the loop stack is popped when the body fails"))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do (literal-tests cs)
        (if-tests cs)
        (do-tests cs)
        (field-tests cs)
        (cell-tests cs)
        (task-tests cs)
        (misc-tests cs)
        (dyn-tests cs)
        (convert-tests cs)
        (fn-tests cs)
        (recur-tests cs)
        (pattern-tests cs)
        (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "types/unit-expr" [(test-case "checks" unit-steps "compiler/tests/types/unit-expr.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
