(defun main (c) -> i64
  (do (reduce f 0 c)
      (reduce (fn go (a x) (reduced a)) 0 c)
      (reduce (fn (a x) -> i64 (reduced a)) 0 c)
      (reduce (fn (a x) :where ((Eq a)) (reduced a)) 0 c)
      (reduce (fn (a x y) (reduced a)) 0 c)
      (reduce (fn (a) (reduced a)) 0 c)
      (reduce)
      (reduce f)
      (reduce f 0 c d)
      (reduce f (when a b) (and c d))))
