;; X2 re-sync (E3): x2 014 reduce reads a bracket fn and a flat cond
(defun main () -> i64
  (reduce (fn [acc x] (if (> acc 9) (reduced acc) (+ acc x))) 0 xs)
  (reduce (fn [acc x]
            (cond (> acc 10) (reduced acc)
                  (> x 0) (+ acc x)
                  :else acc))
          0 xs)
  (reduce (fn (acc x) (cond (> acc 10) (reduced acc) :else (+ acc x))) 0 xs)
  (reduce (fn [acc x] (cond (reduced acc) 1 (> x 0) 2)) 0 xs)
  (reduce (fn [acc x] (cond (> x 0) (reduced acc))) 0 xs)
  (reduce (fn [acc x] (cond)) 0 xs)
  (reduce (fn [acc x] (cond (> x 1) (reduced acc) (> x 2) (cond (> x 3) (reduced x) :else (recur acc x)) :else 0)) 0 xs)
  (reduce (fn [acc x] (let [y x] (cond (> y 0) (reduced y) :else y))) 0 xs)
  (reduce (fn [acc x y] (reduced acc)) 0 xs)
  (reduce (fn [acc] (reduced acc)) 0 xs)
  (reduce (fn [acc x] -> i64 (reduced acc)) 0 xs)
  (reduce (fn [acc x] (cond (> x 1) (+ acc 1))) 0 xs)
  0)
