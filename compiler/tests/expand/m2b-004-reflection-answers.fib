(defstruct Point (x: i64 y: i64))
(defenum (Shape a) (Dot) (Line from: a to: a))
(defmacro names (s) `(quote ,(Vec (struct-fields s))))
(defmacro field-types (s) `(quote ,(Vec (struct-field-types s))))
(defmacro variants (e) `(quote ,(Vec (enum-variants e))))
(defmacro shape-params (e) `(quote ,(Vec (enum-params e))))
(defmacro is (s) (Bool (struct? s)))
(defmacro is-enum (s) (Bool (enum? s)))
(defun main () -> i64 (do (names Point) (field-types Point) (variants Shape) (shape-params Shape) (is Point) (is Shape) (is-enum Shape) (is-enum Nope) 0))
