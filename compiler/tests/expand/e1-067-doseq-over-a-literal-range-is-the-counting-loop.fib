;; E1 (M6 step 3 re-sync): e1 067 doseq over a literal range is the counting loop
(defun main () -> i64
  (doseq [i (range 3)] (f i))
  (doseq [i (range 1 4)] (f i) (g i))
  (doseq [i (range n) j (range m)] (f i j))
  (doseq [i (range 3) :when (odd? i)] (f i))
  (doseq [i (range 3) :let [j (* i i)] :when (odd? j)] (f j))
  0)
