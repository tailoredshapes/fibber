(defun main () -> i64
  (fn ([a b]) (fn ([c d]) (+ a c)))
  (fn (x) (fn ([c d]) (fn ([e f]) c)))
  (map (fn ([k v]) (f k v)) m)
  (reduce (fn (acc [k v]) (+ acc v)) 0 m)
