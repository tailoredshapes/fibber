;; X2 re-sync (E3, X4): x2 015 pattern parameters in a bracket fn
(defun main () -> i64
  (fn [[a b]] (+ a b))
  (fn [acc [k v]] (+ acc v))
  (fn [([a b] :as p) ([c d] :as q)] (+ a c))
  (fn [x [a b] y [c d]] (+ a c))
  (fn [[a b]] (fn [[c d]] (+ a c)))
  (reduce (fn [acc [k v]] (+ acc v)) 0 m)
  (for-each xs (fn [[a b]] (f a b)))
  0)
