(defun main (c) -> i64
  (do (reduce (fn (a x) (let ((y (f x))) (do (g) (match y (0 (reduced a)) (_ (cond (p 1) (q (reduced 2)) (else 3))))))) 0 c)
      (reduce (fn (a x) (when-let (v (f x)) (if-let (w v) (reduced w) a))) 0 c)
      (reduce (fn (a x) (g) (unless p (reduced a))) 0 c)
      (reduce (fn (a x) (loop ((i 0)) (if (< i x) (recur (+ i 1)) (reduced i)))) 0 c)))
