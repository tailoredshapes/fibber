(defstruct (Pair a b) (fst: a snd: b))
(derive Eq Pair)
(derive Ord Pair)
(derive Hash Pair)
(derive Show Pair)
(derive Debug Pair)
(derive ToStr Pair)
(defenum (Tree t) Leaf (Node l: (Tree t) v: t r: (Tree t)))
(derive Eq Tree)
(derive Ord Tree)
(derive Hash Tree)
(derive Show Tree)
(derive Debug Tree)
(derive ToStr Tree)
