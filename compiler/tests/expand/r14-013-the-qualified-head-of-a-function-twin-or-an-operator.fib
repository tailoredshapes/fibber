(defun + (a b) a)
(defun max (a b) a)
(defun conj (a b) a)
(defun f () (do (fib.prelude/println x) (fib.prelude/+ x y) (fib.prelude/+ x y z) (fib.prelude/max x y z)
                (fib.prelude/conj x y z) (fib.prelude/< x y) (fib.prelude/< x y z) (fib.prelude/swap! a f)
                (fib.prelude/swap! a f 1) (fib.prelude/range x) (fib.prelude/range x y)
                (fib.prelude/for-each x f) (fib.prelude/trap x) (fib.prelude/nonesuch x)))
