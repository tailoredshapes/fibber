(defstruct (Pair t) (a: (Vec t) b))
(defstruct Mono (x: i64))
(defenum (E a) (Nothing) (One v: a) (Two a (Vec a)))
(defmacro fields (n) `(quote ,(List (struct-fields n))))
(defmacro variants (n) `(quote ,(List (enum-variants n))))
(defmacro params (n) `(quote ,(List (struct-params n))))
(defmacro types (n) `(quote ,(List (struct-field-types n))))
(defmacro eparams (n) `(quote ,(List (enum-params n))))
(defmacro isstruct (n) (Bool (struct? n)))
(defmacro isenum (n) (Bool (enum? n)))
(defstruct Mono (y: f64 z: str))
(defun f () (fields Mono) (types Mono))
