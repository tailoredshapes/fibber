(defun f () (do (str x y) (update m k g 1) (reduce + c) (print x y) (println x y) (prn x y) (pr x y) (when a b) (unless a b) (cond a b :else (trap "cond: no clause matched")) (and a b) (or a b) (list a b) (assert a b) (dbg a) (max a b c) (+ a b c) (< a b c) (conj a b c) (assoc a b c d e) (merge a b c) (swap! a f 1) (range a b)))
(defun str (a b) a)
(defun update (m k f x) m)
(defun reduce (f c) c)
(defun print (a b) a)
(defun println (a b) a)
(defun prn (a b) a)
(defun pr (a b) a)
(defun when (a b) a)
(defun unless (a b) a)
(defun cond (a b) a)
(defun and (a b) a)
(defun or (a b) a)
(defun list (a b) a)
(defun assert (a b) a)
(defun dbg (a) a)
(defun max (a b c) a)
(defun + (a b c) a)
(defun < (a b c) a)
(defun conj (a b c) a)
(defun assoc (a b c d e) a)
(defun merge (a b c) a)
(defun swap! (a b c) a)
(defun range (a b) a)
