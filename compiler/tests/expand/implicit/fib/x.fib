;; The implicit module `fib.x` of the programs `main-*.fib` of this
;; directory, which crates/fibc/tests/bootstrap_expand runs with
;; `--implicit-lib fib.x,fib.y` (modules.rs `try_load_with`): a facade of one
;; part. Run as a main file of its own it is a module that cannot find its
;; part, an edge of the loader.
(ns fib.x (:export-from fib.x.part))
