;; X2 re-sync (E3): x2 016 bracket forms in the output of a prelude macro
(defun main () -> i64
  (when c (let [a 1] (fn [x] (+ a x))))
  (unless c (loop [i 0] i))
  (and (let [a 1] a) (fn [x] x))
  (or (let [a 1] a) (loop [b 2] b))
  (cond c (let [a 1] a) :else (fn [x] x))
  (when-let [y e] (let [a y] (fn [z] (+ a z))))
  (-> (let [a 1] a) (f 2))
  (->> (fn [x] x) (g 2))
  (doto (let [a 1] a) (f 2))
  (assert (let [a 1] a))
  (while (let [a 1] a) (loop [i 0] i))
  (dotimes [i 3] (let [a i] (fn [x] (+ a x))))
  (for-each xs (fn [x] (let [a x] a)))
  0)
