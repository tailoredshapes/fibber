;; E1 (M6 step 3 re-sync): e1 066 doseq levels and modifiers
(defun main () -> i64
  (doseq [x xs] a)
  (doseq [x xs] a b)
  (doseq [x xs :when p] a)
  (doseq [x xs :while p] a)
  (doseq [x xs :let [y e]] a)
  (doseq [x xs :let [y e] :when p] a)
  (doseq [x xs y ys] a b)
  (doseq [x xs :let [a 1] :when p y ys :when q] b)
  (doseq [[k v] m] (f k v))
  (doseq [x xs])
  0)
