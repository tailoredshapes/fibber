;; X2 re-sync (E3): x2 001 let and loop take flat bracket pairs
(defun main () -> i64
  (let [a 1 b 2] (+ a b))
  (let [a: i64 1 b 2 c: str "x"] a)
  (let [[p q] v [r s] m] p)
  (let [] 0)
  (let [a 1] (let [b a] (loop [i 0 acc: i64 b] (if (< i a) (recur (+ i 1) acc) acc))))
  (loop [] 0)
  (let ((a 1) (b 2)) (+ a b))
  0)
