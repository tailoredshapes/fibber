;; Three arities, a clause that calls another, a :private clause beside a public one, defn-.
(defn f
  ([a: i64] -> i64 a)
  ([a: i64 b: i64] :private -> i64 (+ (f a) (f b)))
  ([a: i64 b: i64 c: i64] -> i64 (+ (f a b) (f c))))
(defn- g
  ([a: i64] -> i64 a)
  ([a: i64 b: i64] -> i64 (+ a b)))
(defun main () -> i64 (+ (f 1 2 3) (g 1) (g 1 2)))
