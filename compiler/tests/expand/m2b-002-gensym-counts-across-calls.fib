(defmacro swap-let (a b) (let ((t (gensym "t"))) `(let ((~t ~a)) (do ~b ~t))))
(defmacro twice (x) (let ((v (gensym "v")) (w (gensym "w"))) `(let ((~v ~x) (~w ~x)) (+ ~v ~w))))
(defun f (n: i64) -> i64 (swap-let n (twice n)))
(defun g (n: i64) -> i64 (twice (swap-let n 1)))
(defun main () -> i64 (+ (f 1) (g 2)))
