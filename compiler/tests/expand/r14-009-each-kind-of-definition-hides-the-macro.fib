(defun a () (when x y))
(defun b () (unless x y))
(defun c () (str x y))
(defun d () (list x y))
(defun e () (cond (x y)))
(defun f () (print x y))
(defun g () (dbg x))
(defun h () (assert x y))
(defn when [p q] p)
(defn- unless [p q] p)
(def str: i64 1)
(extern list (i64) -> i64)
(defenum E (cond v: i64) print)
(defprotocol P (dbg (self) -> i64))
(do (do (defun assert (p q) p)))
