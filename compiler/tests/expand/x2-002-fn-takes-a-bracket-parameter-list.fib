;; X2 re-sync (E3): x2 002 fn takes a bracket parameter list
(defun main () -> i64
  (fn [x y] (+ x y))
  (fn [x: i64 y: i64] -> i64 (+ x y))
  (fn [] 1)
  (fn go [n] (if (< n 1) 0 (go (- n 1))))
  (fn [[k v]] k)
  (fn [acc ([k v] :as e)] (assoc acc k v))
  (fn [a [b c] d] (list a b c d))
  (fn (x y) (+ x y))
  (map (fn [x] (+ x 1)) xs)
  0)
