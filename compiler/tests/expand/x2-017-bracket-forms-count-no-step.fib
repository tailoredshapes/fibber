;; X2 re-sync (E3): x2 017 bracket forms count no step. Compare with
;;   -o "--no-runner --implicit-lib '' --max-steps 1"
;; (no library module, whose own macros would use the steps): the one `when` is the only step, the
;; brackets, nested or inside the `when`, are none.
(defun main () -> i64
  (when true
    (let [a 1 b: i64 2]
      (loop [i 0] (let [f (fn [x] (fn go [y] x))] i)))))
