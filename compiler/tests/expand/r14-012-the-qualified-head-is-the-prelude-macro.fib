(defun when (a b) a)
(defun str (a) a)
(defun update (m k f x) m)
(defun f () (do (fib.prelude/when x y) (fib.prelude/str x "s")
                (fib.prelude/update m k g 1) (fib.prelude/reduce + c) (fib.prelude/list a b)
                (fib.prelude/unless x y) (fib.prelude/cond a b) (fib.prelude/assert a b)))
