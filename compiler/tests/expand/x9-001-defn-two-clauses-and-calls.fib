;; Two clauses are two defuns area$1 and area$2; each call takes the clause of its count,
;; also a call that comes before the definition and one in a nested expression.
(defun early () -> i64 (+ (area 3) (area 3 4)))
(defn area
  "the area"
  ([s: i64] -> i64 (* s s))
  ([w: i64 h: i64] -> i64 (* w h)))
(defun main () -> i64 (+ (early) (area (area 2) 1)))
