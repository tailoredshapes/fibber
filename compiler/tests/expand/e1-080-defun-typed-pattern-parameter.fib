;; E1 (M6 step 3 re-sync): e1 080 defun typed pattern parameter
(defun f (a ([k v] :as p: (Pair i64 i64))) -> i64
  (+ a k))
(defun g (([a b] :as p: T) x: i64 ([c d] :as q: U)) -> i64
  (f a c)
  (f b d))
(defun h :private (([a b] :as p: T)) -> i64 a)
(defun w (([a b] :as p: T)) :where ((Eq T)) -> i64 a)
