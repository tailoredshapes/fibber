;; X2 re-sync (E3): x2 018 bracket forms in every position
(defun main () -> i64
  (f (let [a 1] a) (fn [x] x) (loop [i 0] i))
  (if (let [a 1] a) (let [b 2] b) (loop [c 3] c))
  [(let [a 1] a) (fn [x] x)]
  {:k (let [a 1] a)}
  (match (let [a 1] a) (1 (let [b 2] b)) (_ 0))
  (do (let [a 1] a) (let [b 2] b))
  (quote (let [a 1 b] a))
  0)
