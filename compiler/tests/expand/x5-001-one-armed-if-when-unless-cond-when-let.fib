(defun a (c x) (if c x))
(defun b (c x) (when c x (+ x 1)))
(defun c (c x) (unless c x))
(defun d (c x) (when-not c x))
(defun e (p q x) (cond p 1 q 2))
(defun f (p q x) (cond p 1 q 2 :else 3))
(defun g (p x) (cond p 1 true 2))
(defun h (x) (cond))
(defun i (o) (when-let (v o) (+ v 1)))
(defun j (a b c) (and a (or b c) (and)))
(defun k (xs) (reduce + (when xs 1)))
