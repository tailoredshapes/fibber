;; compiler/tests/lsp/ck.fib: the check helpers of the language-server unit programs. Each returns 0 when it holds and 1 (after printing FAIL and
;; both sides) when not. A program collects them in a Vec and ends with `finish`, which prints how many checks were made and how many failed and
;; returns the failures: run.sh compares the count made with the count it expects, so a program that stops checking is a failure too.
(ns ck)

(defun eq-str (name: str got: str want: str) -> i64
  (if (= got want) 0 (do (println (str "FAIL " name ": got [" got "] want [" want "]")) 1)))

(defun eq-int (name: str got: i64 want: i64) -> i64
  (if (= got want) 0 (do (println (str "FAIL " name ": got " got " want " want)) 1)))

(defun holds (name: str ok: bool) -> i64
  (if ok 0 (do (println (str "FAIL " name)) 1)))

(defun finish (fails: (Vec i64)) -> i64
  (let ((n (reduce + 0 fails)))
    (do (println (str "checks " (count fails) " failed " n)) n)))
