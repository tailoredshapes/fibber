    [lir.check.fcx :as m9]
    [lir.check.func :as m10]
    [lir.check.globals :as m11]
    [lir.check.memory :as m12]
    [lir.check.phi :as m13]
    [lir.check.walk :as m14]
    [lir.diag :as m15]
    [lir.dump :as m16]
    [lir.lit :as m17]
    [lir.parse :as m18]
    [lir.parse.atomics :as m19]
    [lir.parse.control :as m20]
    [lir.parse.expr :as m21]
    [lir.parse.instr :as m22]
    [lir.parse.items :as m23]
    [lir.parse.literal :as m24]
    [lir.parse.memory :as m25]
    [lir.parse.names :as m26]
    [lir.parse.ty :as m27]
    [lir.print :as m28]
    [lir.sexp :as m29]
    [lir.sexp.lexer :as m30]
    [lir.types :as m31]
    [native.aot :as m32]
    [native.api :as m33]
    [native.call :as m34]
    [native.cases :as m35]
    [native.cases.exec :as m36]
    [native.cases.header :as m37]
    [native.cases.verdict :as m38]
    [native.cli :as m39]
    [native.error :as m40]
    [native.jit :as m41]
    [native.jit.names :as m42]
    [native.jit.prune :as m43]
    [native.jit.trampoline :as m44]
    [native.link :as m45]
    [native.lower :as m46]
    [native.lower.arith :as m47]
    [native.lower.calls :as m48]
    [native.lower.consts :as m49]
    [native.lower.expr :as m50]
    [native.lower.func :as m51]
    [native.lower.lx :as m52]
    [native.lower.memory :as m53]
    [native.lower.types :as m54]
    [native.owned :as m55]
    [native.passes :as m56]
    [native.pipeline :as m57]
    [native.support :as m58]
    [native.target :as m59]
    [native.lower.build :as m60]
    [lir.intrin :as m61]
    [lir.check.intrin :as m62]
    [lir.parse.intrin :as m63]
    [native.lower.intrin :as m64]))

(defun main () -> i64
  (let [f0 m0/parse-and-check
        f1 m1/ordering-rank
        f2 m2/check
        f3 m3/check-struct-literal
        f4 m4/check-bin
        f5 m5/check-call
        f6 m6/cfg-new
        f7 m7/env-build
        f8 m8/check-ty
        f9 m9/fcx-new
        f10 m10/check-function
        f11 m11/check-global
        f12 m12/check-memory
        f13 m13/check-phi
        f14 m14/children
        f15 m15/pos-new
        f16 m16/dump-module
        f17 m17/lit-of
        f18 m18/parse-source
        f19 m19/parse-atomic
        f20 m20/parse-control
        f21 m21/parse-expr
        f22 m22/parse-instr
        f23 m23/parse-module
        f24 m24/int-token
        f25 m25/parse-memory
        f26 m26/reserved?
        f27 m27/parse-type
        f28 m28/print-module
        f29 m29/sexp-pos
        f30 m30/tokens
        f31 m31/scalar-keyword
        f32 m32/aot-emit
        f33 m33/jit-new
        f34 m34/call-i64
        f35 m35/cases-collect
        f36 m36/run-program
        f37 m37/parse-header
        f38 m38/run-case
        f39 m39/dispatch
        f40 m40/lair-error-render
        f41 m41/session-new
        f42 m42/names-new
        f43 m43/dead-internals
        f44 m44/tramp-name
        f45 m45/library-dir
        f46 m46/lower
