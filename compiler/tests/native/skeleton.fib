;; compiler/tests/native/skeleton.fib: a program that requires every module of the lair-in-fibber skeleton (compiler/lir/*, compiler/native/*), by taking one
;; function of each as a value, so that the seed loads and type-checks every one of them (a module nothing refers to is not loaded).
;; Generated for the module list below; skeleton.sh builds and runs it. When a module is added, add it here.
;; Build: skeleton.sh
(ns main
  (:require
    [lir :as m0]
    [lir.ast :as m1]
    [lir.check :as m2]
    [lir.check.aggr :as m3]
    [lir.check.arith :as m4]
    [lir.check.calls :as m5]
