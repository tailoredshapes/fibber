        f56 m56/error-message
        f57 m57/check-source
        f58 m58/shim-source
        f59 m59/target-init
        f60 m60/noname
        f61 m61/intrin-info
        f62 m62/check-intrin
        f63 m63/parse-intrin
        f64 m64/lower-intrin]
    (do (println "ok") 0)))
