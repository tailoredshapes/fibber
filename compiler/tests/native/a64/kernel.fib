;; The kernel of compiler/tests/native/a64-emit.sh: fma and lanewise arithmetic on f64x2 and f32x4 (the NEON register widths), with `<<..>>` literals.
;; The assembly of the AArch64 targets must hold fmla (fused multiply-add on vectors) and fadd on .2d and .4s arrangements. The vectors depend on the
;; argument count, so that the optimiser cannot fold the arithmetic away.
(ns main (:use fib.core))

(defun axpy (a: f64x2 x: f64x2 y: f64x2) -> f64x2 (simd/fma a x y))
(defun axpy32 (a: f32x4 x: f32x4 y: f32x4) -> f32x4 (simd/fma a x y))

(defun main () -> i64
  (let ((n (count (args)))
        (d (double n))
        (f (float n))
        (a (+ <<1.0 2.0>>f64 (splat f64x2 d)))
        (s (+ <<1.0 2.0 3.0 4.0>>f32 (splat f32x4 f)))
        (r (axpy a <<3.5 4.5>>f64 (+ a a)))
        (q (axpy32 s <<1.5 2.5 3.5 4.5>>f32 (+ s s))))
    (do (println (lane r 0) (lane r 1) (lane q 0) (lane q 3))
        0)))
