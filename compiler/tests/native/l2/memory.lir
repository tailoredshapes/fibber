(define (g i64) ((ptr p) (i64 n))
  (block entry
    (let ((a (alloca (align 16) i64))
          (q (getelementptr inbounds i64 p n)))
      (store (i64 7) a)
      (store volatile n q)
      (atomic-store seq_cst n p)
      (let ((l (atomic-load acquire i64 p))
            (r (atomicrmw add seq_cst p l))
            (c (cmpxchg weak seq_cst monotonic p r n)))
        (fence seq_cst)
        (ret (add (load i64 a) (extractvalue c 0)))))))
