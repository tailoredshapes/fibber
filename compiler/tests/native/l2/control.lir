(define (sum i64) ((i64 n))
  (block entry (br loop))
  (block loop
    (let ((i (phi i64 (entry (i64 1)) (loop i2)))
          (acc (phi i64 (entry (i64 0)) (loop acc2)))
          (acc2 (add acc i))
          (i2 (add i (i64 1))))
      (br (icmp sle i2 n) loop exit)))
  (block exit
    (ret acc2)))
(define (sw i32) ((i32 k))
  (block entry
    (switch k other ((i32 0) zero) ((i32 1) one) ((i32 -5) neg)))
  (block zero (ret (i32 100)))
  (block one (ret (i32 200)))
  (block neg (ret (i32 300)))
  (block other (ret (i32 -1))))
(define (both i32) ((i1 c))
  (block entry (br c j j))
  (block j (ret (phi i32 (entry (i32 4))))))
(define (count i64) ((i64 n) (i64 acc))
  (block entry (br (icmp eq n (i64 0)) done more))
  (block done (ret acc))
  (block more (tailcall @count (sub n (i64 1)) (add acc (i64 1)))))
(define tailcc (step i64) ((ptr self) (i64 n))
  (block entry (indirect-tailcall self (fn tailcc i64 (ptr i64)) self n)))
(define (nothing void) ()
  (block entry (trap) (call @nothing) (unreachable)))
