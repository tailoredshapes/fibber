(declare puts i32 (ptr))
(define (m i64) ((double d) (<4 x i32> v) (i64 w))
  (block entry
    (let ((n (fneg d))
          (c (fcmp olt d n))
          (p (ctpop w))
          (o (sadd-overflow w w))
          (s (fptosi-sat i64 d))
          (u (fptoui-sat i8 d))
          (e (extractelement v (i32 0)))
          (iv (insertelement v e (i32 1)))
          (sh (shufflevector v iv (<4 x i32> 3 7 0 4)))
          (z (zext i64 e))
          (st { w (i8 1) })
          (ar ([2 x i64] w z))
          (iv2 (insertvalue st (i8 5) 1))
          (ar2 (insertvalue ar w 1))
          (k (select c (extractvalue o 0) (extractvalue ar2 1)))
          (zz (zeroinitializer { i64, i8 }))
          (t (call @puts (string "hi")))
          (b (bitcast i64 d))
          (tr (trunc i8 w))
          (f (sitofp double w))
          (pp (inttoptr ptr w))
          (q (ptrtoint i64 pp)))
      (ret (add k (add (extractvalue iv2 0) (add (extractvalue zz 0) (add z (add b (add (zext i64 u) q))))))))))
