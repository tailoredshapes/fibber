;; K2 rule tests: calls, returns, switch and the musttail rules. One defect per function.
(declare printf i32 (ptr ...))
(declare-global gv i32)
(defstruct wide (i64 i64 i64))
(define (take2 i64) ((i64 a) (ptr p)) (block entry (ret a)))
(define (nothing void) () (block entry (ret)))
(define tailcc (tc i64) ((i64 a)) (block entry (ret a)))
(define tailcc (tcv void) () (block entry (ret)))
(define tailcc (tcw %struct.wide) () (block entry (ret (%struct.wide (i64 1) (i64 2) (i64 3)))))
(define (main i32) () (block entry (ret (i32 0))))
(define (call-undefined void) () (block entry (call @nope) (ret)))
(define (call-global void) () (block entry (call @gv) (ret)))
(define (call-few void) ((i64 a)) (block entry (call @take2 a) (ret)))
(define (call-many void) ((i64 a) (ptr p)) (block entry (call @take2 a p a) (ret)))
(define (call-one-param-plural void) ((i64 a)) (block entry (call @nothing a) (ret)))
(define (call-arg-type void) ((i32 a) (ptr p)) (block entry (call @take2 a p) (ret)))
(define (call-second-arg-type void) ((i64 a) (i64 b)) (block entry (call @take2 a b) (ret)))
(define (call-void-operand void) ((i64 a) (ptr p)) (block entry (add (call @nothing) (i32 1)) (ret)))
(define (varargs-few void) () (block entry (call @printf) (ret)))
(define (varargs-i8 void) ((ptr p) (i8 c)) (block entry (call @printf p c) (ret)))
(define (varargs-i1 void) ((ptr p) (i1 c)) (block entry (call @printf p c) (ret)))
(define (varargs-float void) ((ptr p) (float f)) (block entry (call @printf p f) (ret)))
(define (varargs-i16-indirect void) ((ptr p) (i16 c)) (block entry (indirect-call p (fn i32 (ptr ...)) p c) (ret)))
(define (icall-nonptr void) ((i64 b)) (block entry (indirect-call b (fn void ())) (ret)))
(define (icall-arity void) ((ptr p) (i64 b)) (block entry (indirect-call p (fn void (i64 i64)) b) (ret)))
(define (icall-arg void) ((ptr p) (i32 a)) (block entry (indirect-call p (fn void (i64)) a) (ret)))
(define (icall-unknown-struct void) ((ptr p)) (block entry (indirect-call p (fn void (%struct.nope))) (ret)))
(define (ret-missing i64) () (block entry (ret)))
(define (ret-type i64) ((i32 a)) (block entry (ret a)))
(define (ret-void-value void) ((i32 a)) (block entry (ret a)))
(define (ret-named-vs-anon { i32 }) () (block entry (ret { (i64 1) })))
(define (br-condition void) ((i32 a)) (block entry (br a x y)) (block x (ret)) (block y (ret)))
(define (switch-array void) ((<2 x i32> v)) (block entry (switch v d)) (block d (ret)))
(define (switch-double void) ((double v)) (block entry (switch v d)) (block d (ret)))
(define (switch-case-type void) ((i32 v)) (block entry (switch v d ((i64 1) d))) (block d (ret)))
(define (switch-dup-case void) ((i32 v)) (block entry (switch v d ((i32 1) d) ((i32 1) d))) (block d (ret)))
(define (switch-dup-masked void) ((i8 v)) (block entry (switch v d ((i8 -1) d) ((i8 255) d))) (block d (ret)))
(define (tail-cc void) () (block entry (tailcall @tcv)))
(define tailcc (tail-ret-differs i64) () (block entry (tailcall @tcv)))
(define tailcc (tail-void-for-int void) () (block entry (tailcall @tc (i64 1))))
(define (tail-varargs void) ((ptr p)) (block entry (tailcall @printf p)))
(define (tail-ccc-params i64) ((i32 a)) (block entry (tailcall @take2 (i64 1) (ptr null))))
(define tailcc (tail-arg i64) () (block entry (tailcall @tc)))
(define tailcc (tail-result-memory %struct.wide) () (block entry (tailcall @tcw)))
(define tailcc (itail-ret void) ((ptr p)) (block entry (indirect-tailcall p (fn tailcc i64 ()))))
(define tailcc (itail-cc void) ((ptr p)) (block entry (indirect-tailcall p (fn void ()))))
(define tailcc (itail-var void) ((ptr p)) (block entry (indirect-tailcall p (fn tailcc void (ptr ...)) p)))
