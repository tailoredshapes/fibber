;; K2 rule tests: struct and array literals, vector operations, extractvalue and insertvalue. One defect per function.
(defstruct pair (i32 ptr))
(define (main i32) () (block entry (ret (i32 0))))
(define (struct-count void) ((i32 a)) (block entry (%struct.pair a) (ret)))
(define (struct-field-type void) ((i32 a) (i64 b)) (block entry (%struct.pair a b) (ret)))
(define (struct-second-field-type void) ((i32 a) (ptr p)) (block entry (%struct.pair p p) (ret)))
(define (array-elem-type void) ((i32 a) (i64 b)) (block entry ([2 x i32] a b) (ret)))
(define (extractelement-scalar void) ((i32 a)) (block entry (extractelement a (i32 0)) (ret)))
(define (extractelement-oob void) ((<4 x i32> v)) (block entry (extractelement v (i32 4)) (ret)))
(define (extractelement-index-float void) ((<4 x i32> v) (double d)) (block entry (extractelement v d) (ret)))
(define (extractelement-negative void) ((<4 x i32> v)) (block entry (extractelement v (i32 -1)) (ret)))
(define (insertelement-type void) ((<4 x i32> v) (i64 x)) (block entry (insertelement v x (i32 0)) (ret)))
(define (insertelement-oob void) ((<4 x i32> v) (i32 x)) (block entry (insertelement v x (i32 9)) (ret)))
(define (insertelement-scalar void) ((i32 a)) (block entry (insertelement a a (i32 0)) (ret)))
(define (shuffle-scalar void) ((i32 a)) (block entry (shufflevector a a (<2 x i32> 0 1)) (ret)))
(define (shuffle-mismatch void) ((<4 x i32> a) (<2 x i32> b)) (block entry (shufflevector a b (<2 x i32> 0 1)) (ret)))
(define (shuffle-mask-name void) ((<2 x i32> a) (<2 x i32> m)) (block entry (shufflevector a a m) (ret)))
(define (shuffle-mask-range void) ((<2 x i32> a)) (block entry (shufflevector a a (<2 x i32> 0 4)) (ret)))
(define (shuffle-mask-negative void) ((<2 x i32> a)) (block entry (shufflevector a a (<2 x i32> -1 0)) (ret)))
(define (extractvalue-scalar void) ((i32 a)) (block entry (extractvalue a 0) (ret)))
(define (extractvalue-oob void) () (block entry (extractvalue { (i32 1) (i32 2) } 2) (ret)))
(define (extractvalue-negative void) () (block entry (extractvalue { (i32 1) (i32 2) } -1) (ret)))
(define (extractvalue-array-oob void) ((i32 a)) (block entry (extractvalue ([2 x i32] a a) 5) (ret)))
(define (extractvalue-into-scalar void) () (block entry (extractvalue { (i32 1) } 0 0) (ret)))
(define (extractvalue-huge void) () (block entry (extractvalue { (i32 1) } 170141183460469231731687303715884105727) (ret)))
(define (insertvalue-scalar void) ((i32 a)) (block entry (insertvalue a a 0) (ret)))
(define (insertvalue-type void) ((i64 b)) (block entry (insertvalue { (i32 1) } b 0) (ret)))
(define (insertvalue-oob void) ((i32 a)) (block entry (insertvalue { (i32 1) } a 1) (ret)))
(define (insertvalue-array-type void) ((i32 a) (i64 b)) (block entry (insertvalue ([2 x i32] a a) b 1) (ret)))
