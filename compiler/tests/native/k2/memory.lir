;; K2 rule tests: alloca, load, store, getelementptr, atomics and fences. One defect per function.
(defstruct pair (i32 i64))
(constant cg i32 (i32 7))
(global vg i64 (i64 0))
(define (main i32) () (block entry (ret (i32 0))))
(define (alloca-count void) ((double d)) (block entry (alloca i64 d) (ret)))
(define (alloca-unknown-struct void) () (block entry (alloca %struct.nope) (ret)))
(define (load-nonptr i32) ((i64 a)) (block entry (ret (load i32 a))))
(define (load-global-type i32) () (block entry (ret (load i32 @vg))))
(define (load-alloca-type i32) () (block entry (let ((p (alloca i64))) (ret (load i32 p)))))
(define (store-nonptr void) ((i64 a)) (block entry (store (i32 1) a) (ret)))
(define (store-constant void) () (block entry (store (i32 1) @cg) (ret)))
(define (store-alloca-type void) () (block entry (let ((p (alloca i64))) (store (i32 1) p) (ret))))
(define (store-global-type void) () (block entry (store (i32 1) @vg) (ret)))
(define (gep-nonptr void) ((i64 a)) (block entry (getelementptr i32 a (i64 1)) (ret)))
(define (gep-index-float void) ((ptr p) (double d)) (block entry (getelementptr i32 p d) (ret)))
(define (gep-into-scalar void) ((ptr p)) (block entry (getelementptr i32 p (i64 0) (i64 0)) (ret)))
(define (gep-field-oob void) ((ptr p)) (block entry (getelementptr %struct.pair p (i64 0) (i32 2)) (ret)))
(define (gep-field-i64 void) ((ptr p)) (block entry (getelementptr %struct.pair p (i64 0) (i64 1)) (ret)))
(define (gep-field-nonconst void) ((ptr p) (i32 k)) (block entry (getelementptr %struct.pair p (i64 0) k) (ret)))
(define (gep-array-oob void) ((ptr p)) (block entry (getelementptr [4 x i32] p (i64 0) (i64 4)) (ret)))
(define (gep-array-negative void) ((ptr p)) (block entry (getelementptr [4 x i32] p (i64 0) (i64 -1)) (ret)))
(define (gep-into-vector void) ((ptr p)) (block entry (getelementptr <4 x i32> p (i64 0) (i64 1)) (ret)))
(define (atomic-load-release void) ((ptr p)) (block entry (atomic-load release i32 p) (ret)))
(define (atomic-load-acqrel void) ((ptr p)) (block entry (atomic-load acq_rel i32 p) (ret)))
(define (atomic-load-i1 void) ((ptr p)) (block entry (atomic-load seq_cst i1 p) (ret)))
(define (atomic-load-struct void) ((ptr p)) (block entry (atomic-load seq_cst %struct.pair p) (ret)))
(define (atomic-load-global void) () (block entry (atomic-load seq_cst i32 @vg) (ret)))
(define (atomic-store-acquire void) ((ptr p)) (block entry (atomic-store acquire (i32 1) p) (ret)))
(define (atomic-store-acqrel void) ((ptr p)) (block entry (atomic-store acq_rel (i32 1) p) (ret)))
(define (atomic-store-vector void) ((ptr p) (<2 x i32> v)) (block entry (atomic-store seq_cst v p) (ret)))
(define (atomic-store-nonptr void) ((i64 a)) (block entry (atomic-store seq_cst (i32 1) a) (ret)))
(define (rmw-unordered void) ((ptr p)) (block entry (atomicrmw add unordered p (i32 1)) (ret)))
(define (rmw-nonptr void) ((i64 a)) (block entry (atomicrmw add seq_cst a (i32 1)) (ret)))
(define (rmw-add-float void) ((ptr p)) (block entry (atomicrmw add seq_cst p (double 1.0)) (ret)))
(define (rmw-fadd-int void) ((ptr p)) (block entry (atomicrmw fadd seq_cst p (i32 1)) (ret)))
(define (rmw-umax-i1 void) ((ptr p) (i1 c)) (block entry (atomicrmw umax seq_cst p c) (ret)))
(define (rmw-xchg-struct void) ((ptr p)) (block entry (atomicrmw xchg seq_cst p { (i32 1) }) (ret)))
(define (rmw-direct void) () (block entry (atomicrmw add seq_cst @vg (i32 1)) (ret)))
(define (cx-unordered void) ((ptr p)) (block entry (cmpxchg seq_cst unordered p (i32 1) (i32 2)) (ret)))
(define (cx-success-unordered void) ((ptr p)) (block entry (cmpxchg unordered seq_cst p (i32 1) (i32 2)) (ret)))
(define (cx-fail-release void) ((ptr p)) (block entry (cmpxchg seq_cst release p (i32 1) (i32 2)) (ret)))
(define (cx-fail-acqrel void) ((ptr p)) (block entry (cmpxchg seq_cst acq_rel p (i32 1) (i32 2)) (ret)))
(define (cx-nonptr void) ((i64 a)) (block entry (cmpxchg seq_cst seq_cst a (i32 1) (i32 2)) (ret)))
(define (cx-float void) ((ptr p)) (block entry (cmpxchg seq_cst seq_cst p (double 1.0) (double 2.0)) (ret)))
(define (cx-i1 void) ((ptr p)) (block entry (cmpxchg seq_cst seq_cst p (i1 1) (i1 0)) (ret)))
(define (cx-mixed void) ((ptr p)) (block entry (cmpxchg seq_cst seq_cst p (i32 1) (i64 2)) (ret)))
(define (cx-direct void) () (block entry (cmpxchg seq_cst seq_cst @vg (i32 1) (i32 2)) (ret)))
(define (fence-unordered void) () (block entry (fence unordered) (ret)))
(define (fence-monotonic void) () (block entry (fence monotonic) (ret)))
