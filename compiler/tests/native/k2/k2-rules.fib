;; compiler/tests/native/k2/k2-rules.fib: the instruction rules of lir.check.{expr,arith,aggr,calls,memory} on hand-built operands. SOURCE of every
;; expected text: `lair check` on the equivalent lIR of compiler/tests/native/k2/*.lir (the Rust's own messages); a position is 1:1 for the form
;; under test. The context is built by hand: parameters a:i32 b:i64 d:double fl:float p:ptr c:i1 v4:<4 x i32> v2:<2 x i32> a8:i8; one alloca `al`
;; of i64; env: struct pair {i32, i64}, @take2 (i64 ptr)->i64, @nothing ()->void, @printf (ptr ...)->i32, @gv i32 (variable), @vg i64, @cg i32 constant.
;; Build: fibc build compiler/tests/native/k2/k2-rules.fib -I compiler -I lib -o OUT     (needs K1's lir.check.{fcx,env,cfg,walk})
(ns main (:use types.check lir.diag lir.types lir.lit lir.ast lir.check.env lir.check.cfg lir.check.walk lir.check.fcx lir.check.expr lir.check.calls))

(defun at (k: LKind) -> LExpr (expr-new k (pos-new 1 1)))
(defun loc (n: str) -> LExpr (at (KLocal n)))
(defun glob (n: str) -> LExpr (at (KGlobal n)))
(defun int (bits: i64 v: i64) -> LExpr (at (KInt (TInt bits) (lit-of v))))
(defun v32 (a: i64 b: i64) -> LExpr (at (KVector (TVector 2 ty-i32) [(int 32 a) (int 32 b)])))
(defun bin (op: LBinOp a: LExpr b: LExpr) -> LExpr (at (KBin op a b)))
(defun cast (op: LCastOp t: LType v: LExpr) -> LExpr (at (KCast op t v)))
(defun call (f: str args: (Vec LExpr)) -> LExpr (at (KCall (CalDirect f) args false)))
(defun tcall (f: str args: (Vec LExpr)) -> LExpr (at (KCall (CalDirect f) args true)))
(defun load (t: LType p: LExpr) -> LExpr (at (KLoad t p false nil)))
(defun store (v: LExpr p: LExpr) -> LExpr (at (KStore v p false nil)))

(defun params () -> (Vec LParam)
  (vec (map (fn (n: str) (LParam n (pos-new 1 1))) ["a" "b" "d" "fl" "p" "c" "v4" "v2" "a8"])))

(defun the-fn (cc: LCc ret: (Option LType)) -> LFunction
  (LFunction "t" (LFnType cc ret [ty-i32 ty-i64 ty-double ty-float ty-ptr ty-i1 (TVector 4 ty-i32) (TVector 2 ty-i32) ty-i8] false)
             (params) [(LBlock "entry" [] (pos-new 1 1))] (LModifiers lk-external false) (pos-new 1 1)))

(defun the-env () -> LEnv
  (LEnv {"pair" [ty-i32 ty-i64] "wide" [ty-i64 ty-i64 ty-i64]}
        {"take2" (SymFunc (LFnType CcC (some ty-i64) [ty-i64 ty-ptr] false))
         "nothing" (SymFunc (LFnType CcC nil [] false))
         "printf" (SymFunc (LFnType CcC (some ty-i32) [ty-ptr] true))
         "tc" (SymFunc (LFnType CcTail (some ty-i64) [ty-i64] false))
         "tcv" (SymFunc (LFnType CcTail nil [] false))
         "tcw" (SymFunc (LFnType CcTail (some (TNamed "wide")) [] false))
         "gv" (SymVar ty-i32 false)
         "vg" (SymVar ty-i64 false)
         "cg" (SymVar ty-i32 true)}))

(defun the-fcx (f: LFunction) -> Fcx
  (let ((defs (vec (map (fn (p: LParam) (. p name)) (. f params))))
        (dm (loop ((i 0) (m {"al" 0})) (if (>= i (count defs)) m (recur (+ i 1) (assoc m (nth defs i) -1)))))
        (b (Bindings dm {"al" ty-i64}))
        (fcx (fcx-new (the-env) f (cfg-new [[]]) {"entry" 0} b check-ty check-terminator))
        (types (. fcx types)))
    (do (set! types (assoc @types "al" ty-ptr))
        fcx)))

(defun shown (r: (Result (Option LType) Diagnostic)) -> str
  (match r
    ((Ok t) (ret-str t))
    ((Err d) (diag-str d))))

(defun same-text (got: str want: str) -> bool
  (if (= got want) true (do (println (str "  got:  " got)) (println (str "  want: " want)) false)))

(defun ty-is (e: LExpr want: str) -> bool
  (same-text (shown (check-ty (the-fcx (the-fn CcC nil)) e)) want))

(defun term-is (f: LFunction e: LExpr want: str) -> bool
  (same-text (match (check-terminator (the-fcx f) e) ((Ok _) "ok") ((Err d) (diag-str d))) want))

(defun main () -> i64
  (let ((cs (checks-new)))
    (do
      (check cs "bin: operand classes and the type of the result"
             (and (ty-is (bin BAdd (loc "a") (loc "a")) "i32")
                  (ty-is (bin BAdd (loc "d") (loc "d")) "1:1: error: add needs integer operands, found double")
                  (ty-is (bin BFAdd (loc "a") (loc "a")) "1:1: error: fadd needs float operands, found i32")
                  (ty-is (bin BAdd (loc "a") (loc "b")) "1:1: error: add: operand 2 has type i64, expected i32")
                  (ty-is (bin BAdd (loc "v4") (loc "v2")) "1:1: error: add: operand 2 has type <2 x i32>, expected <4 x i32>")))
      (check cs "bin: division by a constant zero (any lane) and shift widths (as unsigned lanes)"
             (and (ty-is (bin BSDiv (loc "a") (int 32 0)) "1:1: error: division by constant zero")
                  (ty-is (bin BUDiv (loc "v2") (v32 1 0)) "1:1: error: division by constant zero")
                  (ty-is (bin BSDiv (loc "a") (int 32 5)) "i32")
                  (ty-is (bin BShl (loc "a") (int 32 32)) "1:1: error: shift amount 32 is not less than the width 32")
                  (ty-is (bin BAShr (loc "a8") (int 8 -1)) "1:1: error: shift amount 255 is not less than the width 8")
                  (ty-is (bin BLShr (loc "v2") (v32 3 32)) "1:1: error: shift amount 32 is not less than the width 32")
                  (ty-is (bin BShl (loc "a") (int 32 31)) "i32")))
      (check cs "overflow, unary, compare and select"
             (and (ty-is (at (KOverflow OvSAdd (loc "a") (loc "a"))) "{ i32, i1 }")
                  (ty-is (at (KOverflow OvSAdd (loc "d") (loc "d"))) "1:1: error: sadd-overflow needs integer operands, found double")
                  (ty-is (at (KOverflow OvSMul (loc "a") (loc "b"))) "1:1: error: smul-overflow: operand 2 has type i64, expected i32")
                  (ty-is (at (KUn UFNeg (loc "a"))) "1:1: error: fneg needs float operands, found i32")
                  (ty-is (at (KUn UCtpop (loc "d"))) "1:1: error: ctpop needs integer operands, found double")
                  (ty-is (at (KICmp IEq (loc "p") (loc "p"))) "i1")
                  (ty-is (at (KICmp IEq (loc "v4") (loc "v4"))) "<4 x i1>")
                  (ty-is (at (KICmp IEq (loc "d") (loc "d"))) "1:1: error: icmp needs integer or ptr operands, found double")
                  (ty-is (at (KFCmp FOeq (loc "a") (loc "a"))) "1:1: error: fcmp needs float operands, found i32")
                  (ty-is (at (KICmp ISlt (loc "a") (loc "b"))) "1:1: error: icmp: operand 2 has type i64, expected i32")
                  (ty-is (at (KSelect (loc "a") (loc "a") (loc "a"))) "1:1: error: select condition must be i1, found i32")
                  (ty-is (at (KSelect (loc "c") (loc "a") (loc "b"))) "1:1: error: select: operand 3 has type i64, expected i32")
                  (ty-is (at (KSelect (loc "c") (loc "a") (loc "a"))) "i32")))
      (check cs "casts: every conversion's two-type rule"
             (and (ty-is (cast CTrunc ty-i64 (loc "a")) "1:1: error: trunc: i64 is not narrower than i32")
                  (ty-is (cast CTrunc ty-i32 (loc "d")) "1:1: error: trunc needs integer types, found double")
                  (ty-is (cast CZExt ty-i16 (loc "a")) "1:1: error: zext: i16 is not wider than i32")
                  (ty-is (cast CZExt ty-i64 (loc "a")) "i64")
                  (ty-is (cast CFpTrunc ty-double (loc "fl")) "1:1: error: fptrunc: double is not narrower than float")
                  (ty-is (cast CFpExt ty-double (loc "a")) "1:1: error: fpext needs float types, found i32")
                  (ty-is (cast CFpToSi ty-double (loc "d")) "1:1: error: fptosi needs an integer result type, found double")
                  (ty-is (cast CFpToUi ty-i64 (loc "a")) "1:1: error: fptoui needs a float operand, found i32")
                  (ty-is (cast CFpToSiSat (TVector 2 ty-i32) (loc "d")) "1:1: error: fptosi-sat: double and <2 x i32> must both be scalars or both be vectors of the same length")
                  (ty-is (cast CSiToFp ty-i64 (loc "a")) "1:1: error: sitofp needs a float result type, found i64")
                  (ty-is (cast CUiToFp ty-float (loc "d")) "1:1: error: uitofp needs an integer operand, found double")
                  (ty-is (cast CPtrToInt ty-double (loc "p")) "1:1: error: ptrtoint needs an integer result type, found double")
                  (ty-is (cast CPtrToInt ty-i64 (loc "b")) "1:1: error: ptrtoint needs a ptr operand, found i64")
                  (ty-is (cast CIntToPtr ty-i64 (loc "b")) "1:1: error: inttoptr needs a ptr result type, found i64")
                  (ty-is (cast CIntToPtr ty-ptr (loc "p")) "1:1: error: inttoptr needs an integer operand, found ptr")
                  (ty-is (cast CBitcast ty-i64 (loc "p")) "1:1: error: bitcast cannot convert ptr")
                  (ty-is (cast CBitcast ty-i64 (loc "a")) "1:1: error: bitcast: i32 and i64 differ in size")
                  (ty-is (cast CBitcast ty-float (loc "a")) "float")
                  (ty-is (cast CBitcast ty-i64 (at (KStruct nil [(int 32 1) (int 32 2)]))) "1:1: error: bitcast cannot convert { i32, i32 }")
                  (ty-is (cast CBitcast (TNamed "nope") (loc "b")) "1:1: error: undefined struct %struct.nope")))
      (check cs "struct and array literals, extractvalue and insertvalue"
             (and (ty-is (at (KStruct (some "pair") [(loc "a")])) "1:1: error: %struct.pair literal: 2 fields expected, found 1")
                  (ty-is (at (KStruct (some "pair") [(loc "a") (loc "a")])) "1:1: error: %struct.pair literal: field 2 has type i32, expected i64")
                  (ty-is (at (KStruct (some "pair") [(loc "a") (loc "b")])) "%struct.pair")
                  (ty-is (at (KArray (TArray 2 ty-i32) [(loc "a") (loc "b")])) "1:1: error: [2 x i32] literal: element 2 has type i64, expected i32")
                  (ty-is (at (KExtractValue (loc "a") [(lit-of 0)])) "1:1: error: extractvalue needs a struct or array, found i32")
                  (ty-is (at (KExtractValue (at (KStruct nil [(int 32 1) (int 32 2)])) [(lit-of 2)])) "1:1: error: extractvalue: field index 2 out of range for { i32, i32 }")
                  (ty-is (at (KExtractValue (at (KStruct nil [(int 32 1) (int 32 2)])) [(lit-of -1)])) "1:1: error: extractvalue: field index -1 out of range for { i32, i32 }")
                  (ty-is (at (KExtractValue (at (KStruct nil [(int 32 1)])) [(lit-of 0) (lit-of 0)])) "1:1: error: extractvalue: cannot index into i32")
                  (ty-is (at (KExtractValue (at (KArray (TArray 2 ty-i32) [(loc "a") (loc "a")])) [(lit-of 5)])) "1:1: error: extractvalue: index 5 out of range for [2 x i32]")
                  (ty-is (at (KExtractValue (at (KStruct nil [(int 32 1)])) [(LLit 9223372036854775807 -1)])) "1:1: error: extractvalue: field index 170141183460469231731687303715884105727 out of range for { i32 }")
                  (ty-is (at (KInsertValue (at (KStruct nil [(int 32 1)])) (loc "b") [(lit-of 0)])) "1:1: error: insertvalue: operand 2 has type i64, expected i32")
                  (ty-is (at (KInsertValue (at (KStruct nil [(int 32 1)])) (loc "a") [(lit-of 0)])) "{ i32 }")))
      (check cs "vector operations: lanes, indices, masks"
             (and (ty-is (at (KExtractElement (loc "a") (int 32 0))) "1:1: error: extractelement needs a vector, found i32")
                  (ty-is (at (KExtractElement (loc "v4") (int 32 4))) "1:1: error: vector index 4 out of range for <4 x i32>")
                  (ty-is (at (KExtractElement (loc "v4") (int 32 -1))) "1:1: error: vector index 4294967295 out of range for <4 x i32>")
                  (ty-is (at (KExtractElement (loc "v4") (loc "d"))) "1:1: error: extractelement index must be an integer, found double")
                  (ty-is (at (KExtractElement (loc "v4") (int 32 3))) "i32")
                  (ty-is (at (KInsertElement (loc "v4") (loc "b") (int 32 0))) "1:1: error: insertelement: operand 2 has type i64, expected i32")
                  (ty-is (at (KInsertElement (loc "v4") (loc "a") (int 32 0))) "<4 x i32>")
                  (ty-is (at (KShuffle (loc "v4") (loc "v2") (v32 0 1))) "1:1: error: shufflevector: operand 2 has type <2 x i32>, expected <4 x i32>")
                  (ty-is (at (KShuffle (loc "v2") (loc "v2") (loc "v2"))) "1:1: error: shufflevector mask must be a literal <M x i32>")
                  (ty-is (at (KShuffle (loc "v2") (loc "v2") (v32 0 4))) "1:1: error: shufflevector mask element 4 out of range")
                  (ty-is (at (KShuffle (loc "v2") (loc "v2") (v32 -1 0))) "1:1: error: shufflevector mask element -1 out of range")
                  (ty-is (at (KShuffle (loc "v2") (loc "v2") (v32 3 0))) "<2 x i32>")))
      (check cs "calls: callee, argument count, types, variadic promotion, void"
             (and (ty-is (call "nope" []) "1:1: error: undefined function @nope")
                  (ty-is (call "gv" []) "1:1: error: @gv is not a function")
                  (ty-is (call "take2" [(loc "b")]) "1:1: error: call to @take2: expected 2 arguments, found 1")
                  (ty-is (call "nothing" [(loc "a")]) "1:1: error: call to @nothing: expected 0 arguments, found 1")
                  (ty-is (call "take2" [(loc "a") (loc "p")]) "1:1: error: call to @take2: argument 1 has type i32, expected i64")
                  (ty-is (call "take2" [(loc "b") (loc "p")]) "i64")
                  (ty-is (call "nothing" []) "void")
                  (ty-is (call "printf" []) "1:1: error: call to @printf: expected at least 1 argument, found 0")
                  (ty-is (call "printf" [(loc "p") (loc "a8")]) "1:1: error: variadic argument 2 of @printf has type i8, which C promotes; pass i32")
                  (ty-is (call "printf" [(loc "p") (loc "fl")]) "1:1: error: variadic argument 2 of @printf has type float, which C promotes; pass double")
                  (ty-is (call "printf" [(loc "p") (loc "d") (loc "a")]) "i32")
                  (ty-is (bin BAdd (call "nothing" []) (int 32 1)) "1:1: error: void value used as an operand")
                  (ty-is (at (KCall (CalIndirect (loc "b") (LFnType CcC nil [] false)) [] false)) "1:1: error: indirect-call needs a ptr callee, found i64")
                  (ty-is (at (KCall (CalIndirect (loc "p") (LFnType CcC nil [ty-i64] false)) [(loc "a")] false)) "1:1: error: indirect-call: argument 1 has type i32, expected i64")
                  (ty-is (tcall "tcv" []) "1:1: error: terminator used as a value")))
      (check cs "terminators: ret, br, switch and the musttail rules"
             (and (term-is (the-fn CcC (some ty-i64)) (at (KRet nil)) "1:1: error: ret without a value in @t, which returns i64")
                  (term-is (the-fn CcC (some ty-i64)) (at (KRet (some (loc "a")))) "1:1: error: ret type i32 does not match @t's result i64")
                  (term-is (the-fn CcC nil) (at (KRet (some (loc "a")))) "1:1: error: ret type i32 does not match @t's result void")
                  (term-is (the-fn CcC nil) (at (KRet nil)) "ok")
                  (term-is (the-fn CcC nil) (at (KCondBr (loc "a") "x" "y")) "1:1: error: br condition must be i1, found i32")
                  (term-is (the-fn CcC nil) (at (KCondBr (loc "c") "x" "y")) "ok")
                  (term-is (the-fn CcC nil) (at (KSwitch (loc "v2") "d" [])) "1:1: error: switch needs an integer scalar, found <2 x i32>")
                  (term-is (the-fn CcC nil) (at (KSwitch (loc "a") "d" [(LCase (int 64 1) "d")])) "1:1: error: switch: case has type i64, expected i32")
                  (term-is (the-fn CcC nil) (at (KSwitch (loc "a") "d" [(LCase (int 32 1) "d") (LCase (int 32 1) "d")])) "1:1: error: switch: duplicate case 1")
                  (term-is (the-fn CcC nil) (at (KSwitch (loc "a8") "d" [(LCase (int 8 -1) "d") (LCase (int 8 255) "d")])) "1:1: error: switch: duplicate case 255")
                  (term-is (the-fn CcC nil) (tcall "tcv" []) "1:1: error: tailcall: @t is ccc and @tcv is tailcc")
                  (term-is (the-fn CcTail (some ty-i64)) (tcall "tcv" []) "1:1: error: tailcall: @tcv returns void, @t returns i64")
                  (term-is (the-fn CcTail nil) (tcall "tc" [(int 64 1)]) "1:1: error: tailcall: @tc returns i64, @t returns void")
                  (term-is (the-fn CcTail (some ty-i64)) (tcall "tc" [(int 64 1)]) "ok")
                  (term-is (the-fn CcC (some ty-i32)) (tcall "printf" [(loc "p")]) "1:1: error: tailcall to a variadic function")
                  (term-is (the-fn CcC (some ty-i64)) (tcall "take2" [(int 64 1) (at kind-null)])
                           "1:1: error: tailcall under ccc needs identical parameter types (@t has (i32 i64 double float ptr i1 <4 x i32> <2 x i32> i8), @take2 has (i64 ptr)); use tailcc")
                  (term-is (the-fn CcTail (some (TNamed "wide"))) (tcall "tcw" [])
                           "1:1: error: tailcall: a result of type %struct.wide may be returned in memory, which no tail call can: at most 2 scalar or vector leaves of at most 512 bits (found 3 leaves, the widest 64 bits)")))
      (check cs "memory: alloca, load, store, getelementptr"
             (and (ty-is (at (KAlloca ty-i64 (some (loc "d")) nil)) "1:1: error: alloca count must be an integer, found double")
                  (ty-is (at (KAlloca (TNamed "nope") nil nil)) "1:1: error: undefined struct %struct.nope")
                  (ty-is (at (KAlloca ty-i64 nil nil)) "ptr")
                  (ty-is (load ty-i32 (loc "b")) "1:1: error: load needs a ptr operand, found i64")
                  (ty-is (load ty-i32 (glob "vg")) "1:1: error: load of i32 through @vg, a global of type i64")
                  (ty-is (load ty-i32 (loc "al")) "1:1: error: load of i32 through al, which is (alloca i64)")
                  (ty-is (load ty-i64 (loc "al")) "i64")
                  (ty-is (load ty-i32 (loc "p")) "i32")
                  (ty-is (store (int 32 1) (loc "b")) "1:1: error: store needs a ptr operand, found i64")
                  (ty-is (store (int 32 1) (glob "cg")) "1:1: error: store to constant @cg")
                  (ty-is (store (int 32 1) (loc "al")) "1:1: error: store of i32 through al, which is (alloca i64)")
                  (ty-is (store (int 32 1) (loc "p")) "void")
                  (ty-is (at (KGep false ty-i32 (loc "b") [(int 64 1)])) "1:1: error: getelementptr needs a ptr operand, found i64")
                  (ty-is (at (KGep false ty-i32 (loc "p") [(loc "d")])) "1:1: error: getelementptr index must be an integer, found double")
                  (ty-is (at (KGep false ty-i32 (loc "p") [(int 64 0) (int 64 0)])) "1:1: error: getelementptr cannot index into i32")
                  (ty-is (at (KGep false (TNamed "pair") (loc "p") [(int 64 0) (int 32 2)])) "1:1: error: getelementptr: field index 2 out of range for %struct.pair")
                  (ty-is (at (KGep false (TNamed "pair") (loc "p") [(int 64 0) (int 64 1)])) "1:1: error: getelementptr: struct field index must be a constant i32")
                  (ty-is (at (KGep false (TNamed "pair") (loc "p") [(int 64 0) (int 32 1)])) "ptr")
                  (ty-is (at (KGep false (TArray 4 ty-i32) (loc "p") [(int 64 0) (int 64 4)])) "1:1: error: getelementptr: index 4 out of range for [4 x i32]")
                  (ty-is (at (KGep false (TArray 4 ty-i32) (loc "p") [(int 64 0) (loc "b")])) "ptr")
                  (ty-is (at (KGep false (TArray 0 ty-i32) (loc "p") [(int 64 0) (int 64 99)])) "ptr")))
      (check cs "atomics and fences"
             (and (ty-is (at (KAtomicLoad sc-system ORelease ty-i32 (loc "p"))) "1:1: error: atomic-load cannot have ordering release")
                  (ty-is (at (KAtomicLoad sc-system OSeqCst ty-i1 (loc "p"))) "1:1: error: atomic operation on i1")
                  (ty-is (at (KAtomicLoad sc-system OSeqCst ty-i32 (glob "vg"))) "1:1: error: atomic-load of i32 through @vg, a global of type i64")
                  (ty-is (at (KAtomicLoad sc-system OSeqCst ty-i32 (loc "p"))) "i32")
                  (ty-is (at (KAtomicStore sc-system OAcquire (loc "a") (loc "p"))) "1:1: error: atomic-store cannot have ordering acquire")
                  (ty-is (at (KAtomicStore sc-system OSeqCst (loc "v2") (loc "p"))) "1:1: error: atomic operation on <2 x i32>")
                  (ty-is (at (KAtomicStore sc-system OSeqCst (loc "a") (loc "p"))) "void")
                  (ty-is (at (KAtomicRmw RAdd sc-system OUnordered (loc "p") (loc "a"))) "1:1: error: atomicrmw cannot have ordering unordered")
                  (ty-is (at (KAtomicRmw RAdd sc-system OSeqCst (loc "p") (loc "d"))) "1:1: error: atomicrmw add needs an integer operand, found double")
                  (ty-is (at (KAtomicRmw RFAdd sc-system OSeqCst (loc "p") (loc "a"))) "1:1: error: atomicrmw fadd needs a float operand, found i32")
                  (ty-is (at (KAtomicRmw RUMax sc-system OSeqCst (loc "p") (loc "c"))) "1:1: error: atomic operation on i1")
                  (ty-is (at (KAtomicRmw RXchg sc-system OSeqCst (loc "p") (loc "d"))) "double")
                  (ty-is (at (KAtomicRmw RNand sc-system OSeqCst (loc "p") (loc "b"))) "i64")
                  (ty-is (at (KCmpXchg false sc-system OSeqCst ORelease (loc "p") (loc "a") (loc "a"))) "1:1: error: cmpxchg failure ordering cannot be release")
                  (ty-is (at (KCmpXchg false sc-system OUnordered OSeqCst (loc "p") (loc "a") (loc "a"))) "1:1: error: cmpxchg cannot have ordering unordered")
                  (ty-is (at (KCmpXchg false sc-system OSeqCst OSeqCst (loc "p") (loc "d") (loc "d"))) "1:1: error: cmpxchg needs an integer or ptr operand, found double")
                  (ty-is (at (KCmpXchg false sc-system OSeqCst OSeqCst (loc "p") (loc "a") (loc "b"))) "1:1: error: cmpxchg: operand 3 has type i64, expected i32")
                  (ty-is (at (KCmpXchg false sc-system OSeqCst OSeqCst (loc "p") (loc "a") (loc "a"))) "{ i32, i1 }")
                  (ty-is (at (KFence sc-system OUnordered)) "1:1: error: fence ordering must be acquire, release, acq_rel or seq_cst, found unordered")
                  (ty-is (at (KFence sc-system OSeqCst)) "void")))
      (check cs "the dispatcher: constants, names, globals, trap, terminators used as values"
             (and (ty-is (int 32 1) "i32") (ty-is (at (KFloat ty-double 1.5)) "double") (ty-is (at kind-null) "ptr")
                  (ty-is (at (KStr (array 1 0i8))) "ptr") (ty-is (at (KZero (TNamed "nope"))) "1:1: error: undefined struct %struct.nope")
                  (ty-is (glob "gv") "ptr") (ty-is (glob "zz") "1:1: error: undefined global @zz")
                  (ty-is (at kind-trap) "void") (ty-is (at (KRet nil)) "1:1: error: terminator used as a value")
                  (ty-is (at (KBr "x")) "1:1: error: terminator used as a value")))
      (finish cs))))
