;; K2 rule tests: arithmetic, comparison, select, cast. Each function has one defect; `lair check` prints one diagnostic per function.
(define (main i32) () (block entry (ret (i32 0))))
(define (bin-int-needs void) ((double d)) (block entry (add d d) (ret)))
(define (bin-float-needs void) ((i32 a)) (block entry (fadd a a) (ret)))
(define (bin-mismatch void) ((i32 a) (i64 b)) (block entry (add a b) (ret)))
(define (bin-vec-mismatch void) () (block entry (add (<4 x i32> 1 2 3 4) (<2 x i32> 1 2)) (ret)))
(define (div-zero void) ((i32 a)) (block entry (sdiv a (i32 0)) (ret)))
(define (div-zero-lane void) ((<2 x i32> v)) (block entry (udiv v (<2 x i32> 1 0)) (ret)))
(define (rem-zero void) ((i64 a)) (block entry (urem a (i64 0)) (ret)))
(define (shl-wide void) ((i32 a)) (block entry (shl a (i32 32)) (ret)))
(define (ashr-wide void) ((i8 a)) (block entry (ashr a (i8 -1)) (ret)))
(define (shl-lane void) ((<2 x i16> v)) (block entry (lshr v (<2 x i16> 3 16)) (ret)))
(define (ovf-float void) ((double d)) (block entry (sadd-overflow d d) (ret)))
(define (ovf-mismatch void) ((i32 a) (i64 b)) (block entry (smul-overflow a b) (ret)))
(define (fneg-int void) ((i32 a)) (block entry (fneg a) (ret)))
(define (ctpop-float void) ((double a)) (block entry (ctpop a) (ret)))
(define (icmp-float void) ((double a)) (block entry (icmp eq a a) (ret)))
(define (fcmp-int void) ((i32 a)) (block entry (fcmp oeq a a) (ret)))
(define (icmp-mismatch void) ((i32 a) (i64 b)) (block entry (icmp slt a b) (ret)))
(define (select-cond void) ((i32 a)) (block entry (select a a a) (ret)))
(define (select-vec-cond void) ((<2 x i1> c) (<4 x i32> v)) (block entry (select c v v) (ret)))
(define (select-arms void) ((i1 c) (i32 a) (i64 b)) (block entry (select c a b) (ret)))
(define (trunc-wider void) ((i32 a)) (block entry (trunc i64 a) (ret)))
(define (trunc-float void) ((double a)) (block entry (trunc i32 a) (ret)))
(define (zext-narrower void) ((i32 a)) (block entry (zext i16 a) (ret)))
(define (sext-same void) ((i32 a)) (block entry (sext i32 a) (ret)))
(define (fptrunc-wider void) ((float a)) (block entry (fptrunc double a) (ret)))
(define (fpext-int void) ((i32 a)) (block entry (fpext double a) (ret)))
(define (fptosi-result void) ((double a)) (block entry (fptosi double a) (ret)))
(define (fptosi-operand void) ((i32 a)) (block entry (fptosi i64 a) (ret)))
(define (fptosi-sat-result void) ((double a)) (block entry (fptosi-sat <2 x i32> a) (ret)))
(define (sitofp-result void) ((i32 a)) (block entry (sitofp i64 a) (ret)))
(define (uitofp-operand void) ((double a)) (block entry (uitofp float a) (ret)))
(define (ptrtoint-result void) ((ptr p)) (block entry (ptrtoint double p) (ret)))
(define (ptrtoint-operand void) ((i64 a)) (block entry (ptrtoint i64 a) (ret)))
(define (inttoptr-result void) ((i64 a)) (block entry (inttoptr i64 a) (ret)))
(define (inttoptr-operand void) ((ptr a)) (block entry (inttoptr ptr a) (ret)))
(define (bitcast-ptr void) ((ptr a)) (block entry (bitcast i64 a) (ret)))
(define (bitcast-agg void) () (block entry (bitcast i64 { (i32 1) (i32 2) }) (ret)))
(define (bitcast-size void) ((i32 a)) (block entry (bitcast i64 a) (ret)))
