;; compiler/tests/native/drivers/k1-check.fib: package K1's driver, `check FILE` as `lair check FILE`: parse and check the file; print every
;; diagnostic as `FILE:LINE:COL: error: MESSAGE` on standard error and exit 1, or print nothing and exit 0.
;; Run as `k1-check check FILE` (or `k1-check FILE`). Build: fibc build compiler/tests/native/drivers/k1-check.fib -I compiler -I lib -L DIR -l lair -o OUT
(ns main (:use lir.diag lir.types) (:require [lir :as lir]))

(defun report (file: str ds: (Vec Diagnostic)) -> i64
  (do (eprintln (str-join-with "\n" (vec (map (fn (d) (diag-in-file d file)) ds))))
      1))

(defun check-file (file: str) -> i64
  (match (read-file file)
    (nil (do (eprintln (str file ": cannot read")) 1))
    ((some src)
     (match (lir/parse-and-check src)
       ((Ok _) 0)
       ((Err ds) (report file ds))))))

(defun main () -> i64
  (let ((a (args)))
    (cond (and (= (count a) 2) (= (nth a 0) "check")) (check-file (nth a 1))
          (= (count a) 1) (check-file (nth a 0))
          :else (do (eprintln "usage: k1-check check FILE") 2))))
