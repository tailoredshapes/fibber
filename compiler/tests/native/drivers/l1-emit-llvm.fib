;; compiler/tests/native/drivers/l1-emit-llvm.fib: the driver of package L1 (lowering core). It runs the subcommands compare-llvm.sh and compare-obj.sh use:
;;   emit-llvm FILE                          the verified, unoptimised LLVM IR of the module, on standard output
;;   build FILE -o OUT --emit obj|llvm [-O n]  the object file (or the optimised IR) in OUT (cli.rs `build`, aot.rs `emit`)
;; Errors go to standard error as `lair` renders them, exit status 1. (The full CLI is package H's; this is what L1 needs to be judged.)
(ns main
  (:require [lir.ast :as lir.ast] [native.pipeline :as pipe] [native.lower :as nl] [native.owned :as owned] [native.target :as target]
            [native.passes :as passes] [native.error :as err] [llvm.target :as lt] [llvm.core :as core]))

(defun fail (msg: str) -> i64
  (do (eprintln msg) 1))

(defun emit-llvm-cmd (file: str) -> i64
  (match (read-file file)
    (nil (fail (str file ": cannot read")))
    ((some src) (match (pipe/emit-llvm src file)
                  ((Err e) (fail (err/lair-error-render e file)))
                  ((Ok text) (do (print text) 0))))))

;; The value after `flag` in `words`, nil when it is absent.
(defun option-of (words: (Vec str) flag: str) -> (Option str)
  (loop ((i 0))
    (cond (>= (+ i 1) (count words)) nil
          (= (nth words i) flag) (some (nth words (+ i 1)))
          :else (recur (+ i 1)))))

;; The object of the module at level `opt`; the bytes are written to `out` by llvm.target.
(defun emit-object-of (m: owned/Owned host: target/Machine opt: i64 out: str) -> i64
  (match (passes/optimize (. m module) (. host tm) opt)
    ((Err e) (fail (err/lair-error-str e)))
    ((Ok _) (match (lt/emit-object (. host tm) (. m module))
              ((Err msg) (fail (str "error: code generation failed: " msg)))
              ((Ok buf) (let ((w (lt/write-buffer buf out)))
                          (do (unsafe (core/LLVMDisposeMemoryBuffer buf))
                              (match w ((Err msg) (fail msg)) ((Ok _) 0)))))))))

(defun write-text (out: str text: str) -> i64
  (if (spit out text) 0 (fail (str out ": cannot write"))))

(defun emit-cmd (m: owned/Owned host: target/Machine kind: str opt: i64 out: str file: str) -> i64
  (cond (= kind "obj") (emit-object-of m host opt out)
        (= kind "llvm") (match (passes/optimize (. m module) (. host tm) opt)
                          ((Err e) (fail (err/lair-error-render e file)))
                          ((Ok _) (write-text out (owned/owned-ir m))))
        :else (fail (str "unknown --emit " kind))))

(defun build-lowered (file: str m: lir.ast/LModule host: target/Machine kind: str opt: i64 out: str) -> i64
  (match (nl/lower m file (. host triple) (. host data-layout))
    ((Err e) (fail (err/lair-error-render e file)))
    ((Ok o) (let ((rc (emit-cmd o host kind opt out file)))
              (do (owned/owned-dispose o) rc)))))

(defun build-checked (file: str m: lir.ast/LModule kind: str opt: i64 out: str) -> i64
  (match (target/machine-host opt)
    ((Err e) (fail (err/lair-error-render e file)))
    ((Ok host) (let ((rc (build-lowered file m host kind opt out)))
                 (do (target/machine-dispose host) rc)))))

(defun build-source (file: str src: str kind: str opt: i64 out: str) -> i64
  (match (pipe/check-source src)
    ((Err e) (fail (err/lair-error-render e file)))
    ((Ok m) (build-checked file m kind opt out))))

(defun build-cmd (file: str words: (Vec str)) -> i64
  (let ((opt (match (option-of words "-O") ((some s) (unwrap-or (parse-long s) 0)) (nil 0)))
        (out (option-of words "-o"))
        (kind (option-of words "--emit")))
    (match out
      (nil (fail "build needs -o OUT"))
      ((some o) (match kind
                  (nil (fail "build: only --emit is implemented by this driver"))
                  ((some k) (match (read-file file)
                              (nil (fail (str file ": cannot read")))
                              ((some src) (build-source file src k opt o))))))))) 

(defun main () -> i64
  (let ((words (vec (args))))
    (cond (and (= (count words) 2) (= (nth words 0) "emit-llvm")) (emit-llvm-cmd (nth words 1))
          (and (>= (count words) 2) (= (nth words 0) "build")) (build-cmd (nth words 1) (vec (drop 2 words)))
          :else (fail "usage: l1-emit-llvm emit-llvm FILE | build FILE -o OUT --emit obj|llvm [-O n]"))))
