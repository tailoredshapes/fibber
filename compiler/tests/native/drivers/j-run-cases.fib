;; compiler/tests/native/drivers/j-run-cases.fib: package J's driver, the JIT path of `lair cases` over native.jit.
;;
;;   j-run-cases run [-O n] FILE [ARG..]    `lair run`: check FILE as a program, add it to a JIT session, call main, exit with its status
;;   j-run-cases cases DIR..                `lair cases` for the JIT path alone: each case run as a child (`run`), judged by its header
;;
;; `cases` prints the rows and counts of `lair cases` (cli.rs `summarise`), so the two outputs can be compared with diff. The header reader is the minimal
;; one this package needs (crates/lair/src/cases/header.rs); package H ports it for real. A child that was killed by a signal is told from one that
;; exited with 128 + n by the range alone (129 to 159 is a signal): no case of cases/lir exits with a status in it.
(ns main
  (:require [lir.ast :as ast] [lir.types :as types] [native.jit :as jit] [native.error :as err] [native.pipeline :as pipe] [native.call :as call]
            [llvm.ffi :as ffi] [driver.proc :as proc] [fib.string :as s]))

(defun fail (msg: str) -> i64
  (do (eprintln msg) 1))

;; ------------------------------------------------------------------------------------------------------ run

(defun opt-level :private (n: str) -> (Result i64 str)
  (match (parse-long n)
    ((some v) (if (and (>= v 0) (<= v 3)) (Ok v) (Err (str "-O is 0 to 3, not " n))))
    (nil (Err (str "bad -O level: " n)))))

;; The C strings of `words` and an argv array of them (null-terminated): the address of the array.
(defun argv-of :private (words: (Vec str)) -> i64
  (ffi/ptr->addr (ffi/words-new (conj (vec (map (fn (w: str) -> i64 (ffi/ptr->addr (ffi/bytes-new w))) words)) 0))))

;; Calls main(argc, argv) or main(); the status.
(defun call-main :private (addr: i64 takes-args: bool file: str prog-args: (Vec str)) -> (Result i64 str)
  (if takes-args
      (call/call-i64 addr [(+ (count prog-args) 1) (argv-of (vec (concat [file] prog-args)))])
      (call/call-i64 addr [])))

(defun execute :private (file: str opt: i64 prog-args: (Vec str)) -> i64
  (match (read-file file)
    (nil (fail (str file ": cannot read")))
    ((some src) (match (pipe/for-executable src)
                  ((Err e) (fail (err/lair-error-render e file)))
                  ((Ok m) (match (jit/session-new opt)
                            ((Err e) (fail (err/lair-error-render e file)))
                            ((Ok sess) (run-in sess file m prog-args))))))))

(defun run-in :private (sess: jit/JitSession file: str m: ast/LModule prog-args: (Vec str)) -> i64
  (match (jit/session-add-module sess file m)
    ((Err e) (fail (err/lair-error-render e file)))
    ((Ok _) (match (jit/session-signature sess "main")
              ((Err e) (fail (err/lair-error-render e file)))
              ((Ok ty) (match (jit/session-address sess "main")
                         ((Err e) (fail (err/lair-error-render e file)))
                         ((Ok addr) (match (call-main addr (not (empty? (. ty params))) file prog-args)
                                      ((Err msg) (fail msg))
                                      ((Ok code) (bit-and code 255))))))))))

(defun run-cmd :private (rest: (Vec str)) -> i64
  (if (and (>= (count rest) 2) (= (nth rest 0) "-O"))
      (match (opt-level (nth rest 1))
        ((Err m) (fail m))
        ((Ok o) (run-file o (vec (drop 2 rest)))))
      (run-file 0 rest)))

(defun run-file :private (opt: i64 rest: (Vec str)) -> i64
  (if (empty? rest)
      (fail "usage: j-run-cases run [-O n] FILE | cases DIR..")
      (execute (nth rest 0) opt (vec (drop 1 rest)))))

;; ------------------------------------------------------------------------------------------------------ headers

(defenum Expect
  (Accept exit: i64 signals: (Vec i64) out: (Vec str))
  (Reject text: str))

(defenum Paths PBoth PJit PAot)
(derive Eq Paths)

(defstruct Header (expect: Expect ir: (Vec str) ir-not: (Vec str) paths: Paths))

(def signal-names: (Vec (Vec str)) [["SIGILL" "4"] ["SIGTRAP" "5"] ["SIGABRT" "6"] ["SIGFPE" "8"] ["SIGSEGV" "11"] ["SIGTERM" "15"]])

(defun signal-number :private (name: str) -> (Option i64)
  (loop ((i 0))
    (cond (>= i (count signal-names)) nil
          (= (nth (nth signal-names i) 0) name) (parse-long (nth (nth signal-names i) 1))
          :else (recur (+ i 1)))))

;; `SIGILL (4)` or `signal 42`. (header.rs `signal_name`)
(defun signal-name :private (sig: i64) -> str
  (loop ((i 0))
    (cond (>= i (count signal-names)) (str "signal " sig)
          (= (parse-long (nth (nth signal-names i) 1)) (some sig)) (str (nth (nth signal-names i) 0) " (" sig ")")
          :else (recur (+ i 1)))))

;; A list of names separated by commas or spaces. (header.rs `Signal::parse_list`)
(defun parse-signals :private (text: str) -> (Result (Vec i64) str)
  (let ((names (filter (fn (n: str) -> bool (not (= n ""))) (mapcat (fn (w: str) -> (Vec str) (s/split w ",")) (s/split text " ")))))
    (loop ((ns (vec names)) (acc []))
      (if (empty? ns)
          (Ok acc)
          (match (signal-number (nth ns 0))
            (nil (Err (str "unknown signal: " (nth ns 0))))
            ((some n) (recur (vec (drop 1 ns)) (conj acc n))))))))

;; The `;;` lines at the top of a case, each as (key, value) when it has a colon. (header.rs `parse`)
(defstruct Kv (key: str value: str))

(defun header-pairs :private (src: str) -> (Vec Kv)
  (loop ((ls (s/split-lines src)) (i 0) (acc []))
    (if (or (>= i (count ls)) (not (s/starts-with? (nth ls i) ";;")))
        acc
        (let ((body (s/triml (trim-colons (nth ls i)))))
          (match (str-find body ":" 0)
            (nil (recur ls (+ i 1) acc))
            ((some c) (let ((v (str-slice body (+ c 1) (str-len body))))
                        (recur ls (+ i 1) (conj acc (Kv (str-slice body 0 c) (if (s/starts-with? v " ") (str-slice v 1 (str-len v)) v)))))))))))

;; `trim_start_matches(";;")`: every leading `;;`.
(defun trim-colons :private (line: str) -> str
  (if (s/starts-with? line ";;") (trim-colons (str-slice line 2 (str-len line))) line))

(defstruct Acc (expect: (Cell (Option str)) exit: (Cell i64) signals: (Cell (Vec i64)) out: (Cell (Vec str)) error: (Cell (Option str))
                ir: (Cell (Vec str)) ir-not: (Cell (Vec str)) paths: (Cell Paths)))

(defun acc-new :private () -> Acc
  (Acc (cell nil) (cell 0) (cell []) (cell []) (cell nil) (cell []) (cell []) (cell PBoth)))

;; Records one line of the header in `a`; the message of a bad value.
(defun step :private (a: Acc kv: Kv) -> (Option str)
  (let ((k (. kv key)) (v (. kv value)))
    (cond (= k "expect") (do (set! (. a expect) (some (s/trim v))) nil)
          (= k "exit") (match (parse-long (s/trim v))
                         ((some n) (do (set! (. a exit) n) nil))
                         (nil (some (str "bad exit: " v))))
          (= k "signal") (match (parse-signals v)
                           ((Err m) (some m))
                           ((Ok ss) (do (set! (. a signals) (vec (concat @(. a signals) ss))) nil)))
          (= k "out") (do (set! (. a out) (conj @(. a out) v)) nil)
          (= k "error") (do (set! (. a error) (some v)) nil)
          (= k "ir") (do (set! (. a ir) (conj @(. a ir) v)) nil)
          (= k "ir-not") (do (set! (. a ir-not) (conj @(. a ir-not) v)) nil)
          (= k "paths") (cond (= (s/trim v) "jit") (do (set! (. a paths) PJit) nil)
                              (= (s/trim v) "aot") (do (set! (. a paths) PAot) nil)
                              :else (some (str "bad paths: " (s/trim v))))
          :else nil)))

(defun header-parse (src: str) -> (Result Header str)
  (let ((pairs (header-pairs src))
        (a (acc-new)))
    (loop ((i 0))
      (if (< i (count pairs))
          (match (step a (nth pairs i))
            ((some m) (Err m))
            (nil (recur (+ i 1))))
          (header-of a)))))

(defun header-of :private (a: Acc) -> (Result Header str)
  (let ((e @(. a expect)) (err @(. a error)) (exit @(. a exit)) (signals @(. a signals)) (out @(. a out))
        (ir @(. a ir)) (ir-not @(. a ir-not)) (paths @(. a paths)))
    (cond (and (= e (some "accept")) (nil? err) (not (empty? signals)) (!= exit 0)) (Err "accept case with both exit and signal")
          (and (= e (some "accept")) (nil? err)) (Ok (Header (Accept exit signals out) ir ir-not paths))
          (and (= e (some "reject")) (some? err) (not (= (s/trim (unwrap-or err "")) ""))) (Ok (Header (Reject (unwrap-or err "")) ir ir-not paths))
          (= e (some "reject")) (Err "reject case without an error text")
          (and (= e (some "accept")) (some? err)) (Err "accept case with an error text")
          :else (Err (str "bad or missing expect: " (if-some [x e] (str "Some(\"" x "\")") "None"))))))

;; ------------------------------------------------------------------------------------------------------ judging

(defstruct Outcome (status: i64 signal: (Option i64) stdout: str stderr: str))

;; The lines of an output as `lines()` makes them. (a trailing newline ends the last line, it does not start another)
(defun lines-of :private (text: str) -> (Vec str)
  (let ((ls (vec (s/split-lines text))))
    (if (and (not (empty? ls)) (= (nth ls (- (count ls) 1)) "")) (vec-pop ls) ls)))

(defun debug-list :private (xs: (Vec str)) -> str
  (str "[" (types/str-join-with ", " (vec (map (fn (x: str) -> str (str "\"" x "\"")) xs))) "]"))

(defun ending :private (exit: i64 signals: (Vec i64) o: Outcome) -> (Result unit str)
  (let ((expected (if (empty? signals)
                      (str "expected exit " exit)
                      (str "expected " (types/str-join-with " or " (vec (map signal-name signals)))))))
    (match (. o signal)
      ((some got) (if (some? (first (filter (fn (x: i64) -> bool (= x got)) signals)))
                      (Ok ())
                      (Err (str "jit: trapped by " (signal-name got) " (" expected "); stderr: " (s/trim (. o stderr))))))
      (nil (if (and (empty? signals) (= (. o status) exit))
               (Ok ())
               (Err (str "jit: exit " (. o status) " (" expected "); stderr: " (s/trim (. o stderr)))))))))

(defun judge :private (h: Header o: Outcome) -> (Result unit str)
  (match (. h expect)
    ((Accept exit signals out)
     (match (ending exit signals o)
       ((Err m) (Err m))
       ((Ok _) (let ((got (lines-of (. o stdout))))
                 (if (= got out) (Ok ()) (Err (str "jit: output " (debug-list got) ", expected " (debug-list out))))))))
    ((Reject text)
     (cond (= (. o status) 0) (Err (str "jit: accepted, expected an error containing \"" text "\""))
           (or (!= (. o status) 1) (s/includes? (. o stderr) "internal error") (s/includes? (. o stderr) "panicked"))
             (Err (str "jit: failed badly (status " (. o status) "): " (s/trim (. o stderr))))
           (not (s/includes? (. o stderr) text)) (Err (str "jit: error \"" (s/trim (. o stderr)) "\" does not contain \"" text "\""))
           :else (Ok ())))))

(defun ir-checks :private (h: Header src: str file: str) -> (Result unit str)
  (if (and (empty? (. h ir)) (empty? (. h ir-not)))
      (Ok ())
      (match (pipe/emit-llvm src file)
        ((Err e) (Err (str "ir: " (err/lair-error-render e file))))
        ((Ok ir) (match (first (filter (fn (t: str) -> bool (not (s/includes? ir t))) (. h ir)))
                   ((some t) (Err (str "ir: does not contain \"" t "\"")))
                   (nil (match (first (filter (fn (t: str) -> bool (s/includes? ir t)) (. h ir-not)))
                          ((some t) (Err (str "ir: contains \"" t "\"")))
                          (nil (Ok ())))))))))

;; Runs this executable as `run FILE` in a child, standard output and error in files of `scratch`.
(defun child-run :private (file: str scratch: str n: i64) -> (Result Outcome str)
  (let ((out (str scratch "/out" n)) (er (str scratch "/err" n))
        (st (proc/spawn-wait ["j-run-cases" "run" file] out er 120)))
    (cond (< st 0) (Err "cannot run child")
          (= st 142) (Err "timed out after 120s")
          :else (let ((o (Outcome st (if (and (> st 128) (< st 160)) (some (- st 128)) nil)
                                  (unwrap-or (read-file out) "") (unwrap-or (read-file er) ""))))
                  (do (proc/remove-file out) (proc/remove-file er) (Ok o))))))

(defun run-case :private (path: str scratch: str n: i64) -> (Result unit str)
  (match (read-file path)
    (nil (Err "cannot read"))
    ((some src) (match (header-parse src)
                  ((Err m) (Err m))
                  ((Ok h) (match (if (= (. h paths) PAot) (Ok ()) (jit-part h path scratch n))
                            ((Err m) (Err m))
                            ((Ok _) (ir-checks h src path))))))))

(defun jit-part :private (h: Header path: str scratch: str n: i64) -> (Result unit str)
  (match (child-run path scratch n)
    ((Err m) (Err m))
    ((Ok o) (judge h o))))

;; ------------------------------------------------------------------------------------------------------ collecting and reporting

(defun lir-file? :private (p: str) -> bool (s/ends-with? p ".lir"))

;; Every `.lir` file under `p`.
(defun walk :private (p: str) -> (Vec str)
  (match (proc/list-dir p)
    (nil (if (lir-file? p) [p] []))
    ((some es) (loop ((i 0) (acc []))
                 (if (>= i (count es))
                     acc
                     (recur (+ i 1) (vec (concat acc (walk (str p "/" (. (nth es i) name)))))))))))

(defun category :private (p: str) -> str
  (let ((parts (s/split p "/")))
    (if (>= (count parts) 2) (nth parts (- (count parts) 2)) "")))

(defstruct Row (path: str failure: (Option str)))

(defun print-rows :private (rows: (Vec Row)) -> unit
  (dotimes (i (count rows))
    (let ((r (nth rows i)))
      (match (. r failure)
        (nil (println (str "ok    " (. r path))))
        ((some f) (println (str "FAIL  " (. r path) ": " f)))))))

(defstruct Cat (name: str n: i64 ok: i64))

(defun categories :private (rows: (Vec Row)) -> (Vec Cat)
  (loop ((i 0) (acc []))
    (if (>= i (count rows))
        acc
        (let ((r (nth rows i)) (c (category (. (nth rows i) path))) (pass (if (nil? (. (nth rows i) failure)) 1 0)))
          (recur (+ i 1)
                 (if (and (not (empty? acc)) (= (. (nth acc (- (count acc) 1)) name) c))
                     (let ((l (nth acc (- (count acc) 1))))
                       (assoc acc (- (count acc) 1) (Cat c (+ (. l n) 1) (+ (. l ok) pass))))
                     (conj acc (Cat c 1 pass))))))))

(defun summarise :private (rows: (Vec Row)) -> i64
  (let ((cats (categories rows))
        (failed (count (filter (fn (r: Row) -> bool (some? (. r failure))) rows))))
    (do (print-rows rows)
        (dotimes (i (count cats))
          (let ((c (nth cats i)))
            (println (str (. c name) ": " (. c n) " cases, " (. c ok) " pass, " (- (. c n) (. c ok)) " fail"))))
        (println (str "total: " (count rows) " cases, " (- (count rows) failed) " pass, " failed " fail"))
        (if (= failed 0) 0 1))))

(defun cases-cmd :private (dirs: (Vec str)) -> i64
  (let ((found (vec (sort-by (fn (p: str) -> str p) (vec (mapcat walk dirs))))))
    (if (empty? found)
        (fail "no cases found")
        (match (proc/make-temp-dir (unwrap-or (getenv-of "TMPDIR") "/tmp"))
          (nil (fail "cannot make a scratch directory"))
          ((some scratch)
           (let ((rows (vec (map (fn (i: i64) -> Row
                                   (Row (nth found i) (match (run-case (nth found i) scratch i) ((Err m) (some m)) ((Ok _) nil))))
                                 (range (count found))))))
             (do (proc/remove-dir scratch) (summarise rows))))))))

(extern getenv :private (ptr) -> ptr)

(defun getenv-of :private (name: str) -> (Option str)
  (let ((n (ffi/bytes-new name))
        (r (unsafe (ffi/ptr->addr (getenv n)))))
    (do (ffi/free-addr (ffi/ptr->addr n)) (if (= r 0) nil (some (ffi/c-string-at r))))))

(defun main () -> i64
  (let ((a (vec (args))))
    (cond (and (>= (count a) 1) (= (nth a 0) "run")) (run-cmd (vec (drop 1 a)))
          (and (>= (count a) 2) (= (nth a 0) "cases")) (cases-cmd (vec (drop 1 a)))
          :else (fail "usage: j-run-cases run [-O n] FILE | cases DIR.."))))
