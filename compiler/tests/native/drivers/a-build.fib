;; compiler/tests/native/drivers/a-build.fib: the driver of package A (AOT and link). It runs the subcommand the A compare scripts use:
;;   build FILE -o OUT [-O n] [--emit obj|asm|llvm] [-L DIR].. [-l LIB]..   (cli.rs `build`: an executable unless --emit is given)
;; Errors go to standard error as `lair` renders them, exit status 1. (The full CLI is package H's.)
(ns main
  (:require [native.pipeline :as pipe] [native.aot :as aot] [native.error :as err] [native.link :as link]))

(defun fail (msg: str) -> i64
  (do (eprintln msg) 1))

;; What the arguments say: the output, the level, the kind (nil: an executable), the directories and libraries.
(defstruct Args (out: (Option str) opt: i64 kind: (Option str) dirs: (Vec str) libs: (Vec str) bad: (Option str)))

(defun parse-args (words: (Vec str)) -> Args
  (loop ((i 0) (a (Args nil 0 nil [] [] nil)))
    (cond (>= i (count words)) a
          (>= (+ i 1) (count words)) (Args (. a out) (. a opt) (. a kind) (. a dirs) (. a libs) (some (str (nth words i) " needs a value")))
          :else (let ((f (nth words i))
                      (v (nth words (+ i 1))))
                  (cond (= f "-o") (recur (+ i 2) (Args (some v) (. a opt) (. a kind) (. a dirs) (. a libs) (. a bad)))
                        (= f "-O") (recur (+ i 2) (Args (. a out) (unwrap-or (parse-long v) 0) (. a kind) (. a dirs) (. a libs) (. a bad)))
                        (= f "--emit") (recur (+ i 2) (Args (. a out) (. a opt) (some v) (. a dirs) (. a libs) (. a bad)))
                        (= f "-L") (recur (+ i 2) (Args (. a out) (. a opt) (. a kind) (conj (. a dirs) v) (. a libs) (. a bad)))
                        (= f "-l") (recur (+ i 2) (Args (. a out) (. a opt) (. a kind) (. a dirs) (conj (. a libs) v) (. a bad)))
                        :else (Args (. a out) (. a opt) (. a kind) (. a dirs) (. a libs) (some (str "unknown option " f))))))))

(defun output-of (kind: str) -> (Option aot/AotOutput)
  (cond (= kind "obj") (some aot/OutObject)
        (= kind "asm") (some aot/OutAssembly)
        (= kind "llvm") (some aot/OutLlvmIr)
        :else nil))

(defun emit-file (file: str src: str out: str kind: str opts: aot/AotOptions) -> i64
  (match (output-of kind)
    (nil (fail (str "unknown --emit " kind)))
    ((some o) (match (pipe/check-source src)
                ((Err e) (fail (err/lair-error-render e file)))
                ((Ok m) (match (aot/aot-emit m file o opts)
                          ((Err e) (fail (err/lair-error-render e file)))
                          ((Ok bytes) (match (link/write-bytes out bytes)
                                        ((Err msg) (fail msg))
                                        ((Ok _) 0)))))))))

(defun exe-file (file: str src: str out: str opts: aot/AotOptions) -> i64
  (match (pipe/for-executable src)
    ((Err e) (fail (err/lair-error-render e file)))
    ((Ok m) (match (aot/aot-build-executable m file out opts)
              ((Err e) (fail (err/lair-error-render e file)))
              ((Ok _) 0)))))

(defun build-cmd (file: str words: (Vec str)) -> i64
  (let ((a (parse-args words)))
    (match (. a bad)
      ((some b) (fail b))
      (nil (match (. a out)
             (nil (fail "build needs -o OUT"))
             ((some out) (match (read-file file)
                           (nil (fail (str file ": cannot read")))
                           ((some src) (let ((opts (aot/AotOptions (. a opt) (. a libs) (. a dirs))))
                                         (match (. a kind)
                                           (nil (exe-file file src out opts))
                                           ((some k) (emit-file file src out k opts))))))))))))

(defun main () -> i64
  (let ((words (vec (args))))
    (if (and (>= (count words) 2) (= (nth words 0) "build"))
        (build-cmd (nth words 1) (vec (drop 2 words)))
        (fail "usage: a-build build FILE -o OUT [--emit obj|asm|llvm] [-O n] [-L DIR].. [-l LIB].."))))
