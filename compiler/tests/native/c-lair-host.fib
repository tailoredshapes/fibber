;; compiler/tests/native/c-lair-host.fib: the host of native.call over a lair.jit session (the Rust lair through liblair.so): the interim, until
;; native.api (package J) is real, of what `native.call` makes for itself from `api/jit-new`. `install` makes the session, adds the shim and the
;; mailbox of native.support to it, and gives its addresses to native.call. The session is never freed (the host lives as long as the process).
(ns c-lair-host
  (:require [lair.jit :as jit] [native.call :as call] [native.support :as support]))

(defun install () -> (Result unit str)
  (try-let ((j (jit/jit-new 0))
            (s1 (jit/jit-add-source j "lair.shim" (support/shim-source)))
            (s2 (jit/jit-add-source j "lair.mailbox" (support/mailbox-source))))
    (call/host-install (fn (name: str) -> (Result i64 str) (jit/jit-address j name)))))
