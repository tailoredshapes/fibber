;; compiler/tests/native/gpu/f32-atomics.fib: the f32 atomics on a device (GPU-5), for compiler/tests/native/gpu-device.sh to build to PTX (native `atom.global.add.f32`) and to WGSL
;; (a compare-and-exchange loop over the u32 bits) and run: `f32-sum (data out n)` adds every element into out[0]; `f32-minmax (data out n)` takes the maximum into out[0] and the
;; minimum into out[1] (`out` starts at -3.4028235e38 and 3.4028235e38). Nothing runs on the host.
(ns main (:require [fib.gpu :as gpu] [fib.gpu.reduce :as r]))

(defkernel f32-sum (data: ptr out: ptr n: i32)
  (let ((i (r/global-id)))
    (when (< i n) (gpu/f32-add! out 0i32 (r/f32-at data i)))))

(defkernel f32-minmax (data: ptr out: ptr n: i32)
  (let ((i (r/global-id)))
    (when (< i n)
      (do (gpu/f32-fetch-max out 0i32 (r/f32-at data i))
          (gpu/f32-min! out 1i32 (r/f32-at data i))))))

(defun main () -> i64 0)
