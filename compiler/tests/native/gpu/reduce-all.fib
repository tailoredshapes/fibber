;; compiler/tests/native/gpu/reduce-all.fib: every kernel of the grid reductions in one program, for compiler/tests/native/gpu-device.sh to build to PTX (the f32 atomic
;; sum is PTX only; the WGSL build takes fib.gpu.reduce-kernels without it). Nothing runs: the kernels are the module's.
(ns main (:require [fib.gpu.reduce-kernels :as k] [fib.gpu.reduce-atomic-f32 :as a]))
(defun main () -> i64 0)
