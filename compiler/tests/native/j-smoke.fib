(ns main (:require [native.api :as api]))
(defun main () -> i64
  (match (api/jit-new 2)
    ((Err e) (do (eprintln e) 1))
    ((Ok j) (match (api/jit-add-source j "m" "(define (f i64) ((i64 x)) (block entry (ret (add x (i64 1)))))")
              ((Err e) (do (eprintln e) 2))
              ((Ok _) (match (api/jit-address j "f")
                        ((Err e) (do (eprintln e) 3))
                        ((Ok a) (do (println (str "addr nonzero " (!= a 0))) 0))))))))
