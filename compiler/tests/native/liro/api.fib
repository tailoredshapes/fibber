(ns liro-test (:require [native.api :as api]))

(defun source (file: str) -> (Result str str)
  (match (read-file file) ((some s) (Ok s)) (nil (Err "missing input"))))

(defun execute (argv: (Vec str)) -> (Result unit str)
  (let ((mode (nth argv 0)) (opt (unwrap-or (parse-long (nth argv 1)) 2)))
    (cond (= mode "link") (api/link-objects (vec (drop 3 argv)) (nth argv 2) opt [] [])
          :else (try-let [src (source (nth argv 2))]
                  (if (= mode "emit") (api/emit-file src (nth argv 3) opt "liro" false)
                      (api/build-executable src (nth argv 3) opt [] [] false))))))

(defun main () -> i64
  (match (execute (vec (args))) ((Ok _) 0) ((Err e) (do (eprintln e) 1))))
