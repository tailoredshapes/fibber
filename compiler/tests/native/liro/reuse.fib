(ns reuse)
(defstruct Box (n: i64))
(defprotocol Weight (weight (self) -> i64))
(impl Weight Box (weight (self) (. self n)))
(defun key () -> keyword :shared)
(defun dispatch (k: keyword) -> i64 (match k (:shared 11) (:different 7) (_ 0)))
(defun make (n: i64) -> (fn () i64)
  (let ((b (Box n))) (fn () -> i64 (. b n))))
(defun bound (b: a) :where ((Weight a)) -> i64 (weight b))
(defun identity (x: a) -> a x)
(defun pure (n: i64) -> i64 (+ n 100))
