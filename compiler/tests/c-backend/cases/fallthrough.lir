;; expect: accept
;; out: path a-c-e-d 4
;; out: loop 3 6
;; Blocks whose textual successor is not their branch target: a block that jumps over the next one, one that jumps backwards, and a
;; terminator whose target is the block written right after it (which a printer that forgot the goto would still get right). A copy of
;; each path's name is built along the way, so a missed or extra edge changes the text.
(declare printf i32 (ptr ...))
(declare malloc ptr (i64))
(define (path ptr) ((ptr buf))
  (block a (store (i8 97) buf) (br c))
  (block b (store (i8 98) (getelementptr i8 buf (i64 1))) (br d))
  (block c (store (i8 99) (getelementptr i8 buf (i64 1))) (br e))
  (block d (store (i8 100) (getelementptr i8 buf (i64 3))) (store (i8 0) (getelementptr i8 buf (i64 4))) (ret buf))
  (block e (store (i8 101) (getelementptr i8 buf (i64 2))) (br d)))
(define (main i32) ()
  (block entry
    (let ((buf (call @path (call @malloc (i64 8)))))
      (call @printf (string "path %c-%c-%c-%c %d\n") (sext i32 (load i8 buf)) (sext i32 (load i8 (getelementptr i8 buf (i64 1))))
            (sext i32 (load i8 (getelementptr i8 buf (i64 2)))) (sext i32 (load i8 (getelementptr i8 buf (i64 3)))) (i32 4))
      (br loop)))
  (block loop
    (let ((i (phi i64 (entry (i64 0)) (body i2)))
          (s (phi i64 (entry (i64 0)) (body s2)))
          (i2 (add i (i64 1)))
          (s2 (add s i2)))
      (br (icmp slt i2 (i64 3)) body done)))
  (block done
    (call @printf (string "loop 3 %lld\n") s2)
    (ret (i32 0)))
  (block body (br loop)))
