;; expect: accept
;; out: 21
;; A vector of six lanes: lIR allows any lane count from 1 to 1024, GNU C only powers of two, so the C printer holds it in a vector of
;; eight whose last two lanes are never read (c.cx `phys-lanes`): the reduction runs over six lanes, 1+2+3+4+5+6, and a lane-by-lane
;; store would touch no byte past the six.
(declare printf i32 (ptr ...))
(define (main i32) ()
  (block entry
    (let ((v (add (<6 x i32> 1 2 3 4 5 6) (<6 x i32> 0 0 0 0 0 0))))
      (call @printf (string "%d\n") (reduce-add v))
      (ret (i32 0)))))
