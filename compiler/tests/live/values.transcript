fib> (def names: (Atom (Vec str)) (atom []))
; defined names
; N ms
fib> (def fs: (Atom (Option (fn (i64) i64))) (atom nil))
; defined fs
; N ms
fib> (defun handler (x: i64) -> i64 (* x 2))
; defined handler
; N ms
fib> (prn [1 2 3])
; session started
[1 2 3]
; N ms
fib> (prn {:a 1 :b 2})
{:a 1, :b 2}
; N ms
fib> (get {:a 1 :b 2} :b)
2
; N ms
fib> (swap! names conj "first")
["first"]
; N ms
fib> (swap! names conj "second")
["first" "second"]
; N ms
fib> @names
["first" "second"]
; N ms
fib> (prn (mapv handler [1 2 3]))
[2 4 6]
; N ms
fib> (reset! fs (some (fn (y: i64) -> i64 (+ y 100))))
; N ms
fib> (match @fs ((some f) (f 1)) (nil -1))
101
; N ms
fib> (defrecord Pt (x: i64 y: i64))
; defined Pt
; N ms
fib> (defun norm (p: Pt) -> i64 (+ (. p x) (. p y)))
; defined norm
; N ms
fib> (norm (Pt 3 4))
7
; N ms
fib> (prn (Pt 3 4))
#main.Pt{:x 3, :y 4}
; N ms
fib> (defun handler (x: i64) -> i64 (* x 3))
; defined handler
; N ms
fib> (prn (mapv handler [1 2 3]))
[3 6 9]
; N ms
fib> (match @fs ((some f) (f 2)) (nil -1))
102
; N ms
fib> @names
["first" "second"]
; N ms
fib> (str "a" "b" (count @names))
"ab2"
; N ms
