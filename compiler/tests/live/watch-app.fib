(ns main (:use fib.core fib.seq fib.coll fib.print fib.test.core fib.test.run) (:require [handler :as h] [fib.unix :as u]))
;; compiler/tests/live/watch-app.fib: the program of compiler/tests/live/watch.sh (package LT5 of docs/design/live-meshql.md 3.8): a live
;; app that is its own spec, whose handler lives in a module of its own (watch-handler.fib, copied by watch.py to src/handler.fib and
;; edited there while the session watches). The one scenario expects `(h/handle 1)` to be "v2"; the handler as copied answers "v1", so
;; the row fails until an edit of the file is loaded by the watch. `main` waits to be told to stop through the socket.
(def stop: (Atom bool) (atom false))

(defspecs specs
  (feature "Watch"
    (scenario "the handler" (given [v (h/handle 1)]) (then (expect = "v2" v)))))

(defun main () -> i64
  (do (println "app: ready")
      (loop () (if @stop () (do (u/sleep-ns 20000000) (recur))))
      (println "app: stopped")
      0))
