; the shared numbering: new types, keywords, a record defined after boot, a closure kept in a resident atom, strings; a def after boot refused;
; resident callers whose fused map has handler in line (a named stage, a literal that calls it) see its redefinition
(def names: (Atom (Vec str)) (atom []))
(def fs: (Atom (Option (fn (i64) i64))) (atom nil))
(defun handler (x: i64) -> i64 (* x 2))
(defun g (v: (Vec i64)) -> (Vec i64) (mapv handler v))
(defun h (v: (Vec i64)) -> (Vec i64) (mapv (fn (x) (+ 1 (handler x))) v))
(prn [1 2 3])
(prn {:a 1 :b 2})
(get {:a 1 :b 2} :b)
(swap! names conj "first")
(swap! names conj "second")
@names
(prn (mapv handler [1 2 3]))
(prn [(g [1 2 3]) (h [1 2 3])])
(reset! fs (some (fn (y: i64) -> i64 (+ y 100))))
(match @fs ((some f) (f 1)) (nil -1))
(defrecord Pt (x: i64 y: i64))
(defun norm (p: Pt) -> i64 (+ (. p x) (. p y)))
(norm (Pt 3 4))
(prn (Pt 3 4))
(defun handler (x: i64) -> i64 (* x 3))
(prn (mapv handler [1 2 3]))
(prn [(g [1 2 3]) (h [1 2 3])])
(match @fs ((some f) (f 2)) (nil -1))
@names
(str "a" "b" (count @names))
(def late: i64 5)
(nth [1 2] 7)
(prn (Pt 1 2))
