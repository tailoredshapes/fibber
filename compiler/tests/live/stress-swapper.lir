;; compiler/tests/live/stress-swapper.lir: the swapper of compiler/tests/live/stress-tsan.fib, appended to the program's emitted lIR by
;; compiler/tests/live/stress.sh (scripts/tsan.sh TSAN_APPEND; the program's `extern` of it is dropped). `fib_live_stress_swap N`
;; stores the address of `f.work-alt.g0` into `work`'s slot `live.f.work` and `f.work.g0`'s back, N times, with the runtime's
;; `fib.live-patch` (rt/live.lir, the release store a session's `live.patch` makes), a yield after each store so that the callers see
;; both, and a pause point each round (this thread is a spawned one: the program's pause round waits for it).
(DEFINE (fib_live_stress_swap I64) ((I64 n))
  (BLOCK entry (BR loop))
  (BLOCK loop
    (LET ((i (PHI I64 (entry (I64 0)) (next i2))))
      (BR (ICMP SLT i n) one done)))
  (BLOCK one
    (CALL (GLOBAL fib.live-patch) (GLOBAL live.f.work) (PTRTOINT I64 (GLOBAL f.work-alt.g0)))
    (CALL (GLOBAL sched_yield))
    (CALL (GLOBAL fib.live-patch) (GLOBAL live.f.work) (PTRTOINT I64 (GLOBAL f.work.g0)))
    (CALL (GLOBAL fib.live-pause-point))
    (CALL (GLOBAL sched_yield))
    (BR next))
  (BLOCK next (LET ((i2 (ADD i (I64 1)))) (BR loop)))
  (BLOCK done (RET n)))
