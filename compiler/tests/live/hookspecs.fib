;; compiler/tests/live/hookspecs.fib: the three scenarios hooks.fib (the sink and the override) and hooks-spec.fib (a plain spec file) share, so
;; that the two reports name the same positions and can be compared byte for byte (hooks.sh).
(ns hookspecs (:use fib.core fib.seq fib.coll fib.print fib.test.core))

(defspecs specs
  (feature "Hooks"
    (scenario "one holds" (given [a 1]) (then (expect = 1 a)))
    (scenario "two holds" (given [b 2]) (then (expect = 2 b)))
    (scenario "a wrong claim" (given [c 3]) (then (expect = 4 c)))))
