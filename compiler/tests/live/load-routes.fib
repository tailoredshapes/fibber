(ns routes)
;; The module compiler/tests/live/load.py edits on disk and loads into the running load-app.fib (package LM1): `route` is what the app
;; calls, `greet` a function only the session calls, `helper` one nothing calls until the session does, `prefix` a def (a change of its
;; type that `route` does not check against is refused: LT4).
(def prefix: str "route")

(defun greet (name: str) -> str (str "hello " name))

(defun route (path: str) -> str (str prefix " " path))

(defun helper (n: i64) -> i64 (* n 2))
