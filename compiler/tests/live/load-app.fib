(ns main (:require [routes :as r] [fib.unix :as u]))
;; The program of compiler/tests/live/load.sh (package LM1, docs/design/live-incremental.md 3): a two-module app whose second module,
;; `routes` (load-routes.fib, copied by load.py to src/routes.fib beside this file as app.fib and given with -I src), is edited on disk and
;; loaded through the attach socket. `main` calls `r/route` in a loop and keeps the last answer in `last`, so a swap of `route` is seen
;; by a resident caller, not only by the session's own inputs; `stop` ends it through the socket.
(def stop: (Atom bool) (atom false))
(def last: (Atom str) (atom ""))

(defun main () -> i64
  (do (println "app: ready")
      (loop () (if @stop () (do (reset! last (r/route "tick")) (u/sleep-ns 20000000) (recur))))
      (println (str "app: stopped at " @last))
      0))
