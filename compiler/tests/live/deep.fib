(ns main)
;; A recursion a hundred million deep through a program function: the stub must add no frame (compiler/tests/live/stubs.sh check 2).
;; A million (cases/ownership 53 and 164) is not enough to tell: `main` runs on the stack the runtime makes (rt/thread.lir fib.run-main),
;; which holds a million frames of a stub that calls and returns; at 1e8 that stub traps `stack overflow` and the tail-jumping one answers.
(defun down (n: i64 acc: i64) -> i64 (if (= n 0) acc (down (- n 1) (+ acc 1))))
(defun main () -> i64 (do (println (down 100000000 0)) 0))
