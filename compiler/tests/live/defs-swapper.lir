;; compiler/tests/live/defs-swapper.lir: the redefiner of compiler/tests/live/defs-tsan.fib, appended to the program's emitted lIR by
;; compiler/tests/live/defs.sh (scripts/tsan.sh TSAN_APPEND; the program's `extern` of it is dropped). `fib_live_defs_swap N` stores 5
;; and then 3 into the slot of `limit` through its setter `live.d.limit.set` (the release store a session's redefinition makes), and
;; `nil` and then `(some 5)` into `pair` through `live.d.pair.set` (a new box each time), N times, a yield after each store so that the
;; readers see both.
(DEFINE (fib_live_defs_swap I64) ((I64 n))
  (BLOCK entry (BR loop))
  (BLOCK loop
    (LET ((i (PHI I64 (entry (I64 0)) (next i2))))
      (BR (ICMP SLT i n) one done)))
  (BLOCK one
    (CALL (GLOBAL live.d.limit.set) (I64 5))
    (CALL (GLOBAL live.d.pair.set) (ZEROINITIALIZER (LITERAL-STRUCT I1 I64)))
    (CALL (GLOBAL sched_yield))
    (CALL (GLOBAL live.d.limit.set) (I64 3))
    (CALL (GLOBAL live.d.pair.set) (INSERTVALUE (INSERTVALUE (ZEROINITIALIZER (LITERAL-STRUCT I1 I64)) (I1 1) 0) (I64 5) 1))
    (CALL (GLOBAL sched_yield))
    (BR next))
  (BLOCK next (LET ((i2 (ADD i (I64 1)))) (BR loop)))
  (BLOCK done (RET n)))
