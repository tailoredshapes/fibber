(ns main (:use fib.core fib.test.core fib.test.run))
;; compiler/tests/live/test-spec.fib: a spec file loaded beside test-app.fib with `--with` (docs/design/live-meshql.md 2.3 (b), package
;; LT2): the module `spec.test-spec`, whose `specs` the session's `test` op runs when asked for this file, and whose `main` (defspecs-main's)
;; is `spec.test-spec/main`, never called. Under `fibc test` it is an ordinary spec file.
(defspecs-main specs
  (feature "With"
    (scenario "loaded beside the app" (given [x 1]) (then (expect = 1 x)))
    (scenario "a wrong claim" (given [y 2]) (then (expect = 3 y)))))
