; a resident session: the def's value persists, a redefinition is swapped, a signature change is refused, a trap is caught
(def counter: (Atom i64) (atom 0))
(defun handler (x: i64) -> i64 (+ x (swap! counter inc)))
(handler 10)
(handler 10)
@counter
(defun handler (x: i64) -> i64 (- x (swap! counter inc)))
(handler 10)
@counter
(defun handler (x: i64) -> str "no")
(handler 10)
(nth [1 2] 5)
(handler 10)
(defun twice (x: i64) -> i64 (+ (handler x) (handler x)))
(twice 1)
(defun handler (x: i64) -> str "no")
(twice 1)
(def late: i64 5)
(+ late 1)
(+ 1 2)
