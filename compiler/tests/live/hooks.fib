;; compiler/tests/live/hooks.fib: hookspecs' scenarios run as a live session's `test` op would run them (docs/design/live-meshql.md 3.2, package
;; LT1): the words after `--` are the file the collected report is written to and then the words `fibc test` passes a child, which go to
;; `run-main-into` with a sink that collects what the runner would have printed. Nothing is printed: standard output holds only the result line
;; `fibc run` adds, and that result is the runner's status (1 here: one scenario fails).
(ns main (:use fib.core fib.seq fib.coll fib.print fib.test.run) (:require [hookspecs :as h]))

(defun main () -> i64
  (let ((argv (vec (args))))
    (if (empty? argv)
        (do (eprintln "hooks: usage: hooks.fib -- OUT [words of fibc test..]") 2)
        (let ((buf (atom ""))
              (status (run-main-into (h/specs) (vec (drop 1 argv)) (fn (text: str) (do (swap! buf (fn (s: str) (str s text))) ())))))
          (if (write-file (nth argv 0) @buf) status 3)))))
