(ns cfg)
;; The module compiler/tests/live/defs.py edits on disk and loads into the running defs-app.fib (package LT4): `base` a def whose value
;; a load changes, `inits` the count of the side effects of the initialisers defs.py adds (a new def's initialiser runs once).
(def base: i64 10)
(def inits: (Atom i64) (atom 0))

(defun base-value () -> i64 base)
