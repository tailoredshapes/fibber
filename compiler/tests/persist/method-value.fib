;; a method value of a library protocol (to-str) taken against the program's own instance: the instance needs its all-owned body
(defstruct Box (v: i64))
(impl ToStr Box (to-str (self) (str "box" (. self v))))
(defun main () -> i64
  (do (println (str-join (mapv to-str [(Box 1) (Box 2)])))
      (println (str-join (mapv to-str [1 2 3])))
      0))
