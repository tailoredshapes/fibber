;; closures and truthiness, whose names carry expression ids (the ids must not depend on the library having been elaborated first)
(defun adder (n: i64) -> (fn (i64) i64) (fn (x: i64) (+ x n)))
(defun main () -> i64
  (let ((m (assoc (map-empty) "a" 1)) (f (adder 3)))
    (do (println (str (if (get m "a") 1 2)))
        (println (str (map (fn (x: i64) (* x 2)) [1 2 3])))
        (f (or (get m "b") 4)))))
