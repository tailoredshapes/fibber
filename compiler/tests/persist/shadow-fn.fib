;; the program defines names the library has (inc, str-join) and uses them: its own win, as without the persistent checker
(defun inc (x: i64) -> i64 (+ x 100))
(defun str-join (a: str b: str) -> str (str-concat a (str-concat "+" b)))
(defun main () -> i64
  (do (println (str-join "a" "b"))
      (println (str (map inc [1 2 3])))
      (inc 1)))
