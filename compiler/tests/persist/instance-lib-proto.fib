;; an instance of a library protocol (ToStr, Debug) for the program's type, used by the library's printing
(defstruct Tag (name: str))
(impl ToStr Tag (to-str (self) (str-concat "tag:" (. self name))))
(impl Debug Tag (debug (self) (str-concat "#" (. self name))))
(defun main () -> i64
  (do (println (to-str (Tag "a")))
      (println (str (vec (map to-str [(Tag "b") (Tag "c")]))))
      0))
