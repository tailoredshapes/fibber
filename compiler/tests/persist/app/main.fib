;; compiler/tests/persist/app/main.fib: the last module of the program of persist/run.sh part 4 (the program-prefix memo, own.chain): the
;; compiler's reader and printer (compiler/syntax, about 2,000 lines, copied beside this file) as the app, and this module as the one a
;; swap edits. `answer` is the function the test swaps.
(ns main (:require [syntax.reader :as reader] [syntax.print :as printer]))

(defun answer (n: i64) -> i64 (* n 2))

(defun main () -> i64
  (match (reader/read-all "(a (b c) [1 2] {:k \"v\"})" "<main>")
    ((Err _) 1)
    ((Ok forms) (do (doseq [f forms] (println (printer/stx-show f)))
                    (answer (count forms))))))
