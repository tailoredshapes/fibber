;; a program protocol with an instance for a library type, and a method value taken of it
(defprotocol Twice (twice (self) -> i64))
(impl Twice i64 (twice (self) (* self 2)))
(impl Twice str (twice (self) (* 2 (str-len self))))
(defun main () -> i64
  (do (println (str (twice "ab")))
      (println (str (mapv twice [1 2 3])))
      (twice 21)))
