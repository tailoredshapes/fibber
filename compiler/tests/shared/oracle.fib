
;; appended to kernels.fib by shared.sh: prints, line for line, what host.c prints
(defun main () -> i64
  (do (println (str "add=" (show (add 40 2))))
      (println (str "widths=" (show (widths 100000 -5i8 300i16))))
      (println (str "narrow=" (show (narrow 7))))
      (println (str "scale=" (show (scale 2.5 3.0))))
      (println (str "half32=" (show (half32 5.0f32))))
      (println (str "both=" (show (both true true)) "," (show (both true false))))
      (println (str "sum_squares=" (show (sum-squares 1000))))
      (println (str "greet=" (greet "world")))
      (println (str "join2=" (join2 "left" "right")))
      (println (str "count_bytes=" (show (count-bytes "héllo"))))
      (println (str "banner=" (banner)))
      (println (str "echo=" (echo "same")))
      (println (str "mixed=" (mixed 7 "seven" 1.5)))
      (println (str "empty_str=[" (empty-str) "]"))
      0))
