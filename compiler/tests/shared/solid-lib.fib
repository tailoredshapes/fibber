;; compiler/tests/shared/solid-lib.fib: the fib-solid renderer as a shared library with the str ABI: render(text) -> the JSON of solid.render for a CSG text.
;; shared.sh builds it against fib-solid's src (docs/design/shared-libraries.md) and compares the JSON a C host gets with `fibc run` of fib-solid's demo/render-main.fib.
(ns main (:use fib.core solid.lang) (:require [solid.cli :as cli]))

(defun render (text: str) -> str (cli/answer [text] (default-limits)))
