(ns main (:use fib.core fib.seq))
;; The library of compiler/tests/shared/stackcheck.sh (docs/design/stack-check.md 6): recursions a host can drive past its stack.
;; `depth` adds one per frame; `grow` also allocates a Vec and a str in every frame (the frames unwound hold objects that must be released once);
;; `keep-and-dive` takes a str the wrapper made for it and recurses; `label` returns a str built from a recursion; `idx` is another trap (an index out of range).
(defun depth (n: i64) -> i64 (if (= n 0) 0 (+ 1 (depth (- n 1)))))

(defun grow (n: i64) -> i64
  (if (= n 0)
      0
      (let ((v (vec (range 3))) (s (str "n=" (show n))))
        (+ (+ (count v) (str-len s)) (grow (- n 1))))))

(defun keep-and-dive (s: str n: i64) -> i64 (+ (str-len s) (depth n)))
(defun label (n: i64) -> str (str "depth=" (show (depth n))))
(defun idx (i: i64) -> i64 (nth [1 2 3] i))
(defun quiet (n: i64) -> unit (if (= n 0) () (quiet (- n 1))))
(defun deep-unit (n: i64) -> unit (if (= n 0) () (do (deep-unit (- n 1)) ())))
