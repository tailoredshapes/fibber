(ns main (:use fib.core fib.seq fib.ex))
;; compiler/tests/shared/stackcheck.sh, part depth: `depthprobe N` recurses N frames (one add per frame) under a try and prints the depth, or the failure's message.
;; With FIB_STACK_CHECK=0 an overflow ends the process (status 134), so the script finds the deepest N that completes by bisection, with and without the check.
(defun down (n: i64) -> i64 (if (= n 0) 0 (+ 1 (down (- n 1)))))
(defun main () -> i64
  (let ((n (sext i64 (unwrap-or (try-parse-int (nth (args) 0)) 0i32))))
    (do (println (try (show (down n)) (catch e (ex-message e)))) 0)))
