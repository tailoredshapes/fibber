;; E10: constant `def`s that are an array (the elements of a vector are an `(Array E)` object): scalar elements at each width, `str`
;; elements, elements that are objects, an empty vector, a vector of vectors (nested constants are made first), floats and bools.
(defstruct Pt (x: i64 y: i64))
(def ints: (Vec i64) [1 2 3 -4])
(def bytes: (Vec i8) [1i8 -2i8 3i8])
(def flags: (Vec bool) [true false true])
(def reals: (Vec f64) [0.5 -1.25 1e16])
(def words: (Vec str) ["a" "bc" "a"])
(def pts: (Vec Pt) [(Pt 1 2) (Pt 3 4)])
(def none: (Vec i64) [])
(def rows: (Vec (Vec i64)) [ints none [9]])
(defun main () -> i64 (+ (count ints) (+ (count bytes) (+ (count flags) (+ (count reals) (+ (count words) (+ (count pts) (+ (count none) (count rows)))))))))
