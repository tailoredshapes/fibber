;; compiler/tests/emit/macro-trap.fib: a macro whose body traps: the builtin `trap` of a macro module is `fib.trap-at` with the position of the call (emit.lower.builtins).
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defmacro pick (x)
  (match x
    ((Sym s) (Sym s))
    (_ (trap "pick: the argument is not a symbol"))))

(defun main () -> i64 0)
