;; E5: direct calls: a generic function at three instantiations (its specialisations are requested in the order of the calls), a
;; function with a `unit` argument and result (no value on the call line), mutual recursion inside one SCC (no instantiation: the
;; callee's variables are the caller's) and a call as an argument of a call.
(defun id (x: a) -> a x)

(defun pick (n: i64 u: unit s: str) -> i64 n)

(defun nothing (u: unit) -> unit u)

(defun even (n: i64) -> bool (if (= n 0) true (odd (- n 1))))
(defun odd (n: i64) -> bool (if (= n 0) false (even (- n 1))))

(defun poly (x: a n: i64) -> a (if (= n 0) x (poly2 x (- n 1))))
(defun poly2 (x: a n: i64) -> a (if (= n 0) x (poly x (- n 1))))

(defun main () -> i64
  (do (nothing ())
      (+ (id (pick (id 3) (id ()) (id "s"))) (+ (if (even 10) 1 0) (+ (if (id true) 1 0) (poly 5 3))))))
