;; E10: constant `def`s of `Option`: a nullable one (an `Option` of an object: `nil` is null), a boxed one (an `Option` of a scalar is
;; a heap enum, `nil` a nil object), an `Option` of an `Option`, and a vector of them.
(defstruct Box (v: i64))
(def none-obj: (Option Box) nil)
(def some-obj: (Option Box) (some (Box 4)))
(def none-int: (Option i64) nil)
(def some-int: (Option i64) (some 9))
(def some-str: (Option str) (some "s"))
(def deep: (Option (Option i64)) (some nil))
(def deeper: (Option (Option i64)) (some some-int))
(def many: (Vec (Option i64)) [(some 1) nil some-int])
(defun opt (o: (Option i64)) -> i64 (match o (nil -1) ((some x) x)))
(defun main () -> i64
  (+ (opt none-int) (+ (opt some-int) (+ (count many) (if (nil? none-obj) 1 0)))))
