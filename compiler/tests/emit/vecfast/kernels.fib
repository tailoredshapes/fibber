;; compiler/tests/emit/vecfast/kernels.fib: loops over Vecs whose element reads, writes and appends check.sh asks LLVM to have put in line
;; (the fast paths of vec-nth, vec-assoc and vec-conj in lib/prelude.fib); the answers are fixed in check.sh.
(defun row-sum (v: (Vec i64)) -> i64
  (loop ((i 0) (s 0)) (if (< i (count v)) (recur (+ i 1) (+ s (nth v i))) s)))

(defun bump (v: (Vec i64) n: i64) -> (Vec i64)
  (loop ((k 0) (v v)) (if (< k n) (recur (+ k 1) (assoc v (rem (* k 7) (count v)) (+ (nth v (rem (* k 7) (count v))) 1))) v)))

(defun bytes (n: i64) -> (Vec i8)
  (loop ((i 0) (out [])) (if (< i n) (recur (+ i 1) (conj out (trunc i8 i))) out)))

(defun prefix (v: (Vec i64)) -> (Vec i64)
  (loop ((i 1) (out [(nth v 0)])) (if (< i (count v)) (recur (+ i 1) (conj out (+ (nth out (- i 1)) (nth v i)))) out)))

(defun main () -> i64
  (let ((v (mapv (fn (i: i64) i) (range 1000))))
    (do (println (row-sum (bump v 5000)))
        (println (count (bytes 3000)))
        (println (nth (prefix v) 999))
        0)))
