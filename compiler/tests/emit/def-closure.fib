;; E10: constant `def`s that are a named function (its immortal closure, `@clo.N`, is shared, not copied) and a struct that holds one.
(defstruct Op (name: str run: (fn (i64) i64)))
(defun twice (n: i64) -> i64 (* n 2))
(defun inc (n: i64) -> i64 (+ n 1))
(def f: (fn (i64) i64) twice)
(def g: (fn (i64) i64) f)
(def ops: (Vec Op) [(Op "twice" twice) (Op "inc" inc) (Op "again" f)])
(defun main () -> i64 (+ (f 4) (+ (g 5) ((. (nth ops 1) run) 6))))
