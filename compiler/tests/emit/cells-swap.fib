;; E6: `swap!`: snapshot under the lock, retain, call `f` through a value, compare, store or retry (the loop of four blocks).
(defstruct P (x: i64 y: i64))
(defun main () -> i64
  (let ((a (atom 1)) (b (atom (P 1 2))))
    (do (swap! a (fn (x: i64) -> i64 x))
        (swap! b (fn (p: P) -> P p))
        (. @b x))))
