;; E6: cells: `(cell e)`, `@c` (retained content), `(set! c v)` (the old content released), `set-field!` (the unique write, in place or by copy).
(defstruct P (x: i64 y: i64))
(defstruct R (name: str n: i64))
(defun main () -> i64
  (let ((c (cell 1)) (d (cell (P 1 2))) (e (cell (R "a" 1))))
    (do (set! c 2)
        (set! d (P 3 4))
        (set-field! &e n 7)
        (set-field! &e name "b")
        (do (. @d x) @c))))
