;; E10: constant `def`s of an enum: a variant with fields (the tag is read from the object), a unit variant that is a heap enum, a
;; variant that holds another enum, and a vector of variants.
(defenum Shape (Dot) (Circle r: f64) (Rect w: i64 h: i64) (Labelled name: str inner: Shape))
(def dot: Shape Dot)
(def circle: Shape (Circle 1.5))
(def rect: Shape (Rect 3 4))
(def tagged: Shape (Labelled "boxed" (Rect 5 6)))
(def shapes: (Vec Shape) [dot circle rect tagged])
(defun area (s: Shape) -> i64
  (match s ((Dot) 0) ((Circle r) (fptosi i64 r)) ((Rect w h) (* w h)) ((Labelled _ i) (area i))))
(defun main () -> i64 (+ (area rect) (+ (area tagged) (count shapes))))
