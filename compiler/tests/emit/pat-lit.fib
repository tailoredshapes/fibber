;; E7: literal patterns of every scalar kind and `str` (the test of each, the failure edge), in functions and a join with a value.
(defun kw (k: keyword) -> i64 (match k (:a 1) (:b 2) (_ 3)))
(defun st (s: str) -> i64 (match s ("x" 1) ("y" 2) (_ 3)))
(defun fl (f: f64) -> i64 (match f (1.5 1) (-0.0 2) (_ 3)))
(defun ch (c: char) -> i64 (match c (\a 1) (\newline 2) (_ 3)))
(defun bo (b: bool) -> i64 (match b (true 1) (false 2)))
(defun un (u: unit) -> i64 (match u (() 1)))
(defun i8 (n: i8) -> i64 (match n (-1i8 1) (7i8 2) (_ 3)))
(defun main () -> i64
  (do (kw :a) (st "x") (fl 2.0) (ch \a) (bo true) (un ()) (i8 7i8) 0))
