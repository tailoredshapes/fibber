;; E5: a call whose head is a closure value (`indirect-call` through the closure's code pointer, the closure as the first argument), in
;; tail position (`indirect-tailcall`), with a captured variable and a `unit` argument and result.
(defun apply (f: (fn (i64) i64) x: i64) -> i64 (f x))

(defun apply-twice (f: (fn (i64) i64) x: i64) -> i64 (+ (f x) (f (f x))))

(defun run (f: (fn (unit) unit)) -> unit (f ()))

(defun main () -> i64
  (let ((k 3))
    (do (run (fn (u: unit) u))
        (+ (apply (fn (x: i64) (+ x k)) 4) (apply-twice (fn (y: i64) (* y 2)) 2)))))
