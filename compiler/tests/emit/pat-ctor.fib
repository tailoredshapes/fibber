;; E7: constructor patterns: an enum by its tag through the variant struct, a struct by its fields, a field-less enum by its value,
;; `Option` by its representation (null for a pointer payload, boxed otherwise), `_` fields that still load, `as`, nesting.
(defenum Shape (Dot) (Two a: i64 b: i64) (Named s: str))
(defstruct P (x: i64 y: str))
(defenum Colour (Red) (Green) (Blue))
(defun f (s: Shape) -> i64 (match s ((Dot) 0) ((Two 1 _) 5) ((Two a _) a) ((Named n) 7)))
(defun g (p: P) -> str (match p ((P _ y) y)))
(defun c (k: Colour) -> i64 (match k ((Green) 1) ((Blue) 2) (_ 0)))
(defun o (x: (Option i64)) -> i64 (match x ((some n) n) (nil 0)))
(defun os (x: (Option str)) -> str (match x ((some s) s) (nil "none")))
(defun oo (x: (Option (Option i64))) -> i64 (match x ((some (some n)) n) ((some nil) 1) (nil 0)))
(defun a (s: Shape) -> Shape (match s (((Two 1 _) :as t) t) (t t)))
(defun main () -> i64
  (do (f Dot) (g (P 1 "a")) (c Green) (o nil) (os nil) (oo nil) (a (Two 1 2)) 0))
