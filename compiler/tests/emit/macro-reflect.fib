;; compiler/tests/emit/macro-reflect.fib: a macro that asks the expander about a type, the hooks gensym and struct-fields (the entry points set by `fibm.set-hooks`).
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defstruct Pair2 (a: i64 b: str))

(defmacro fields-of (name) (List [(Sym "quote") (Vec (struct-fields name))]))

(defmacro fresh () (gensym "t"))

(defun main () -> i64 0)
