;; E5: calls of protocol methods: the instance of a user protocol on a scalar (a direct call of its body), a method reached through a
;; bound of the caller (specialised: `instance_of_pred`), a method of a native instance (no body: the native operation inline) and
;; a method whose instance is chosen by the type of the argument.
(defprotocol Area (area (self) -> i64))
(impl Area i64 (area (self) (* self self)))
(impl Area bool (area (self) (if self 1 0)))

(defprotocol Plus (plus (self o: Self) -> i64))
(impl Plus i64 (plus (self o) (+ self o)))

(defun twice (x: a) :where ((Area a)) -> i64 (+ (area x) (area x)))
(defun both (x: a y: a) :where ((Area a) (Plus a)) -> i64 (+ (area x) (plus x y)))

(defun main () -> i64
  (+ (area 5) (+ (area true) (+ (twice 3) (+ (twice true) (both 4 5))))))
