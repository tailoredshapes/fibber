;; compiler/tests/emit/macro-literals.fib: a macro whose body has strings with a quote and a backslash, a float, a char and a bool: the static data (@str.N) and the literals of a body.
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defmacro noisy ()
  (List [(Sym "str") (Str "a \"quoted\" word and a back\\slash") (Flt 0.1 :f64) (Flt 1e21 :f64) (Int -7 :i64)
         (Chr \x) (Bool true)]))

(defun main () -> i64 0)
