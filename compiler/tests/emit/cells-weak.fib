;; E6: `@w` on a weak reference: `fib.upgrade` of the box; for a weak reference to a `dyn` (two words) the upgrade builds a heap `Option`
;; object from the box's target and the vtable, in the two arms of a join (`wnil`, `wsome`).
(defstruct A (n: i64))
(impl Show A (show (self) "A"))
(defun main () -> i64
  (let ((b (A 3)) (w (weak b)) (v (weak (dyn Show b))))
    (match @v ((some d) 1) (nil (match @w ((some x) 2) (nil 0))))))
