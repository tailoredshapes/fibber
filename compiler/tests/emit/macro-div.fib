;; compiler/tests/emit/macro-div.fib: a macro whose body divides: the zero trap of a macro module is `fib.trap-at-c` with the position of the expression (emit.lower.cx lcx-trap-c).
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defmacro divide (x)
  (match x
    ((Int n w) (Int (quot n (- n n)) w))
    (_ x)))

(defmacro modulo (x)
  (match x
    ((Int n w) (Int (rem n (- n n)) w))
    (_ x)))

(defun main () -> i64 0)
