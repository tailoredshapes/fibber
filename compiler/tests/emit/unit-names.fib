;; compiler/tests/emit/unit-names.fib: compiler/emit/names.fib. The two Rust tests of
;; names.rs (mangling_is_injective_on_nested_types, a_type_is_mangled_behind_its_module,
;; on a hand-built Globals: modules fib.builtin, fib.prelude, main, fib.seq.protocols and
;; `a`) and the symbols `fibc emit` printed for a probe program with `Box`, `Pt`, a
;; protocol `Sz`, its instances for `Pt` and `(Box a)`, `tw`, the prelude's `vec-count`,
;; the library's `Reducible` and a closure (marked ORACLE below); the `.owned` and `d.`
;; names have no emitted example and are read from `body_name` (marked SOURCE).
;; Build: fibc build compiler/tests/emit/unit-names.fib -I compiler -I lib -o OUT
(ns main (:use syntax.pos types.ty types.scheme types.table types.ast types.decls
               types.check own.program emit.names))

(def p0: Pos (Pos "t.fib" 1 1 0 1))
(def unit-expr: Expr (Expr 0 p0 (ELit LitUnit)))

(defun add-module (g: Globals ns: str) -> unit
  (do (g-add-module g ns (Links [] [] []) (map-empty)) ()))

(defun nom (id: i64 args: (Vec Ty)) -> Ty (TCon (KNominal id) args))

(defun method (name: str) -> MethodDef
  (MethodDef name [(MethodParam "self" false false)] (scheme-mono (ty-i64)) false nil p0))

(defun inst (proto: i64 head: Ty module: i64) -> InstanceDef
  (InstanceDef proto (KNominal 0) module [] head [] [] [(ImplMethod 0 [] nil unit-expr p0)] p0))

;; modules 0 fib.builtin, 1 fib.prelude, 2 main, 3 fib.seq.protocols, 4 a
;; types 0 Vec (prelude), 1 Box (main), 2 Pt (main), 3 Pt (a), 4 Box (prelude)
;; protos 0 Sz (main: sz), 1 Reducible (module 3: pad, size)
;; instances 0 (Sz Pt), 1 (Sz (Box a)), 2 (Reducible (Vec a)), 3 (Sz Pt) in module a
;; funs 0 tw (main), 1 vec-count (prelude); defs 0 K (main)
(defun globals () -> Globals
  (let ((g (globals-new)))
    (do (doseq [ns ["fib.builtin" "fib.prelude" "main" "fib.seq.protocols" "a"]] (add-module g ns))
        (table-add (. g types) (TypeDef "Vec" 1 ["a"] [] (TsStruct []) p0))
        (table-add (. g types) (TypeDef "Box" 2 ["a"] [] (TsStruct []) p0))
        (table-add (. g types) (TypeDef "Pt" 2 [] [] (TsStruct []) p0))
        (table-add (. g types) (TypeDef "Pt" 4 [] [] (TsStruct []) p0))
        (table-add (. g types) (TypeDef "Box" 1 ["a"] [] (TsStruct []) p0))
        (table-add (. g protos) (ProtoDef "Sz" 2 [] [(method "sz")] [] p0))
        (table-add (. g protos) (ProtoDef "Reducible" 3 [] [(method "pad") (method "size")] [] p0))
        (table-add (. g instances) (inst 0 (nom 2 []) 2))
        (table-add (. g instances) (inst 0 (nom 1 [(TGen 0)]) 2))
        (table-add (. g instances) (InstanceDef 1 (KNominal 0) 3 [] (nom 0 [(TGen 0)]) [] []
                                                [(ImplMethod 1 [] nil unit-expr p0)] p0))
        (table-add (. g instances) (inst 0 (nom 3 []) 4))
        (table-add (. g funs) (FunDef "tw" 2 [] nil [] unit-expr false p0))
        (table-add (. g funs) (FunDef "vec-count" 1 [] nil [] unit-expr false p0))
        (table-add (. g defs) (DefDef "K" 2 nil unit-expr false p0))
        g)))

(defun expect (cs: Checks name: str got: str want: str) -> unit
  (do (if (= got want) () (println (str-join ["  got:  " got "\n  want: " want])))
      (check cs name (= got want))))

(defun main () -> i64
  (let ((cs (checks-new)) (g (globals)))
    (do
      (expect cs "Vec i64 of the prelude" (mangle g (nom 0 [(ty-i64)])) "$fib.prelude/Vec.i64_")
      (expect cs "nested" (mangle g (nom 0 [(nom 0 [(ty-i64)])])) "$fib.prelude/Vec.$fib.prelude/Vec.i64__")
      (check cs "nested differs from flat" (not (= (mangle g (nom 0 [(nom 0 [(ty-i64)])])) (mangle g (nom 0 [(ty-i64)])))))
      (expect cs "str" (mangle g (ty-str)) "str")
      (expect cs "the main module's Box" (mangle g (nom 1 [(ty-i64)])) "$Box.i64_")
      (expect cs "the prelude's Box" (mangle g (nom 4 [(ty-i64)])) "$fib.prelude/Box.i64_")
      (expect cs "the main module's Pt is bare" (mangle g (nom 2 [])) "Pt")
      (expect cs "a module's Pt is behind a slash" (mangle g (nom 3 [])) "a/Pt")
      (expect cs "a gen prints as tN" (mangle g (nom 1 [(TGen 0)])) "$Box.t0_")
      (check cs "colours are erased"
             (= (mangle g (TFn CSend [(ty-i64)] (ty-i64))) (mangle g (TFn CLocal [(ty-i64)] (ty-i64)))))
      (expect cs "module prefix of the main module" (module-prefix g 2) "")
      (expect cs "module prefix of the builtins" (module-prefix g 0) "fib.builtin.")
      (expect cs "module prefix of another" (module-prefix g 1) "fib.prelude.")
      (expect cs "a protocol of the main module" (proto-qualified g 0) "Sz")
      (expect cs "a protocol of another module" (proto-qualified g 1) "fib.seq.protocols.Reducible")
      (expect cs "ORACLE f.tw.$Box.$Box.Pt__"
              (body-name g (BodyFun 0) [(nom 1 [(nom 1 [(nom 2 [])])])]) "f.tw.$Box.$Box.Pt__")
      (expect cs "ORACLE a prelude function" (body-name g (BodyFun 1) [(ty-str)]) "f.fib.prelude.vec-count.str")
      (expect cs "ORACLE a function with no types" (body-name g (BodyFun 0) []) "f.tw")
      (expect cs "SOURCE the all-owned body" (body-name g (BodyAllOwned 0) [(ty-i64)]) "f.tw.owned.i64")
      (expect cs "ORACLE a method" (body-name g (BodyMethod 0 0) []) "m.Sz.sz.Pt")
      (expect cs "ORACLE a method of a generic head"
              (body-name g (BodyMethod 1 0) [(nom 2 [])]) "m.Sz.sz.$Box.t0_.Pt")
      (expect cs "ORACLE a method of another module's protocol"
              (body-name g (BodyMethod 2 0) [(nom 1 [(ty-i64)])])
              "m.fib.seq.protocols.Reducible.size.$fib.prelude/Vec.t0_.$Box.i64_")
      (expect cs "SOURCE the all-owned method" (body-name g (BodyMethodOwned 0 0) []) "m.Sz.sz.Pt.owned")
      (expect cs "SOURCE a def" (body-name g (BodyDef 0) []) "d.K")
      (expect cs "ORACLE a closure" (closure-name "f.main" 12851) "l.f.main.12851")
      (finish cs))))
