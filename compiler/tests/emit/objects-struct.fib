;; E6: objects: a struct constructor and its field loads (a unit field takes no slot), enum variants with and without fields, a
;; field-less enum (an index), Option of a scalar (boxed: tag and payload), Option of an object (null or the object), `nil`.
(defstruct P (x: i64 y: i64))
(defstruct Q (a: i64 u: unit b: bool))
(defenum Shape (Circle r: i64) (Rect w: i64 h: i64) Empty)
(defenum Colour Red Green Blue)
(defun main () -> i64
  (let ((p (P 1 2)) (q (Q 3 () true)) (s (Rect 3 4)) (c Green) (e Empty) (o (some 5)) (n (some p)) (z (if true (some p) nil)))
    (. p y)))
