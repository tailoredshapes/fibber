;; E6: atoms: `(atom e)`, `@a` (lock, load, retain, unlock), `reset!` (share-marked, stored under the lock, the old value released).
(defstruct P (x: i64 y: i64))
(defun main () -> i64
  (let ((a (atom 1)) (b (atom (P 1 2))))
    (do (reset! a 2)
        (reset! b (P 3 4))
        (do (. @b x) @a))))
