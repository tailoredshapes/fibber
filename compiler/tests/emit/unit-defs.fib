;; compiler/tests/emit/unit-defs.fib: compiler/emit/defs/data.fib, the constants of the `def`s. SOURCE: every expected text is read off
;; the Rust it replaces (defs/mod.rs:62 emit_array, :85 emit_object, :118 field_types, :140 fresh, :58 def_ids). The JIT half (the entry,
;; the address getters, the reader of memory) is judged by compiler/tests/emit/defs.sh and `fibc emit-dump --sections defs` over the
;; corpus (compare.sh): it needs liblair.
;; Build: fibc build compiler/tests/emit/unit-defs.fib -I compiler -I lib -o OUT
(ns main
  (:require [fib.string :as s])
  (:use syntax.pos syntax.form types.ty types.ast types.table types.decls types.program types.check types.infer.mod own.program
        emit.value emit.program emit.inits emit.defs.data))

(def p0: Pos (Pos "t.fib" 1 1 0 1))

(defun nom (id: i64 args: (Vec Ty)) -> Ty (TCon (KNominal id) args))

;; types 0 Color (fieldless enum), 1 Pt (struct x: i64 y: str), 2 Shape (enum Circle r: a, Dot); defs 0 and 2 constant, 1 not
(defun typed () -> TypedProgram
  (let ((g (globals-new)))
    (do (table-add (. g types) (TypeDef "Color" 2 [] [] (TsEnum [(VariantDef "Red" []) (VariantDef "Green" [])]) p0))
        (table-add (. g types) (TypeDef "Pt" 2 [] [] (TsStruct [(FieldDef "x" (ty-i64)) (FieldDef "y" (ty-str))]) p0))
        (table-add (. g types) (TypeDef "Shape" 2 ["a"] [] (TsEnum [(VariantDef "Circle" [(FieldDef "r" (TGen 0))]) (VariantDef "Dot" [])]) p0))
        (doseq [kv [(Pair "A" true) (Pair "B" false) (Pair "C" true)]]
          (table-add (. g defs) (DefDef (. kv fst) 2 nil (Expr 0 p0 (ELit LitUnit)) (. kv snd) p0)))
        (TypedProgram g (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) []
                      [(UDef 0) (UScc [0]) (UDef 1) (UDef 2)]))))

(defun prog () -> Program (emit.program/program-new (typed) (owned-program-new)))

(defun array-i64 () -> Ty (TCon KArray [(ty-i64)]))

(defun ok-str (r: (Result str str)) -> str (match r ((Ok s) s) ((Err m) (str-join ["error: " m]))))

(defun main () -> i64
  (let ((cs (checks-new))
        (p (prog))
        (d (defs-new)))
    (do
      (check cs "every def in the order of the units; the constant ones are def_ids"
             (and (= (all-def-ids p) [0 1 2]) (= (def-ids p) [0 2])))
      (check cs "no constant yet" (and (= @(. d text) "") (= @(. d constants) []) (= @(. d counter) 0)))
      ;; type ids: str 0, (Array i8) 1, weak 2, task 3, so the first object made here is 4
      (check cs "an array: the header, the length, the elements; the name is @def.1, not yet in the text before"
             (and (= (ok-str (defs-emit-array d p (array-i64) LirI64 ["(i64 1)" "(i64 -2)"])) "@def.1")
                  (= @(. d text)
                     "(constant internal def.1 { i64 i32 i32 i64 [2 x i64] } { (i64 0) (i32 4) (i32 8) (i64 2) ([2 x i64] (i64 1) (i64 -2)) })\n")
                  (= @(. d constants) ["@def.1"])))
      (check cs "an empty array keeps the space before the closing paren, as the Rust's join of nothing"
             (and (= (ok-str (defs-emit-array d p (array-i64) LirI64 [])) "@def.2")
                  (s/ends-with? @(. d text)
                     "(constant internal def.2 { i64 i32 i32 i64 [0 x i64] } { (i64 0) (i32 4) (i32 8) (i64 0) ([0 x i64] ) })\n")))
      (check cs "an array of something that is not an array type has no layout"
             (match (defs-emit-array d p (ty-i64) LirI64 [])
               ((Err _) true) ((Ok _) false)))
      (check cs "a struct: the header then the fields, a unit field (empty text) left out"
             (and (= (ok-str (defs-emit-object d p (nom 1 []) nil ["(i64 3)" "" "@str.0"])) "@def.3")
                  (s/ends-with? @(. d text)
                                  "(constant internal def.3 %struct.o.Pt (%struct.o.Pt (i64 0) (i32 5) (i32 8) (i64 3) @str.0))\n")))
      (check cs "a variant: the struct is named .vN and the tag follows the header"
             (and (= (ok-str (defs-emit-object d p (nom 2 [(ty-i64)]) (some 1) [])) "@def.4")
                  (s/includes? @(. d text) " (i32 8) (i32 1)))\n")
                  (s/includes? @(. d text) "(constant internal def.4 %struct.o.$Shape.i64_.v1 (%struct.o.$Shape.i64_.v1 (i64 0)")))
      (check cs "the constants are named in the order they were made"
             (= @(. d constants) ["@def.1" "@def.2" "@def.3" "@def.4"]))
      (check cs "field types of a struct (no tag: the first row)"
             (match (field-types p (nom 1 []) nil) ((Ok tys) (= tys [(ty-i64) (ty-str)])) (_ false)))
      (check cs "field types of a variant, at the arguments of the type"
             (and (match (field-types p (nom 2 [(ty-i64)]) (some 0)) ((Ok tys) (= tys [(ty-i64)])) (_ false))
                  (match (field-types p (nom 2 [(ty-i64)]) (some 1)) ((Ok tys) (= tys [])) (_ false))))
      (check cs "field types of a type that is not nominal"
             (match (field-types p (ty-i64) nil) ((Err m) (= m "an object at a non-nominal type")) (_ false)))
      (finish cs))))
