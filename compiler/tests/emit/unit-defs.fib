;; compiler/tests/emit/unit-defs.fib: compiler/emit/defs/data.fib, the constants of the `def`s. SOURCE: every expected text is read off
;; the Rust it replaces (defs/mod.rs:62 emit_array, :85 emit_object, :118 field_types, :140 fresh, :58 def_ids). The JIT half (the entry,
;; the address getters, the reader of memory) is judged by compiler/tests/emit/defs.sh and `fibc emit-dump --sections defs` over the
;; corpus (compare.sh): it needs liblair.
;; Build: fibc build compiler/tests/emit/unit-defs.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-defs
  (:require [fib.string :as s] [emit.node :as n] [lir.ast :as la] [lir.types :as lt] [lir.print :as print] [tests.emit.normalized :as normal])
  (:use syntax.pos syntax.form types.ty types.ast types.table types.decls types.program fib.test.unit types.infer.mod own.program
        emit.value emit.program emit.inits emit.defs.data)
  (:require [fib.test.run :as test-runner]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))

(defun nom (id: i64 args: (Vec Ty)) -> Ty (TCon (KNominal id) args))

;; types 0 Color (fieldless enum), 1 Pt (struct x: i64 y: str), 2 Shape (enum Circle r: a, Dot); defs 0 and 2 constant, 1 not
(defun typed () -> TypedProgram
  (let ((g (globals-new)))
    (do (table-add (. g types) (TypeDef "Color" 2 [] [] (TsEnum [(VariantDef "Red" []) (VariantDef "Green" [])]) p0))
        (table-add (. g types) (TypeDef "Pt" 2 [] [] (TsStruct [(FieldDef "x" (ty-i64)) (FieldDef "y" (ty-str))]) p0))
        (table-add (. g types) (TypeDef "Shape" 2 ["a"] [] (TsEnum [(VariantDef "Circle" [(FieldDef "r" (TGen 0))]) (VariantDef "Dot" [])]) p0))
        (doseq [kv [(Pair "A" true) (Pair "B" false) (Pair "C" true)]]
          (table-add (. g defs) (DefDef (. kv fst) 2 nil (Expr 0 p0 (ELit LitUnit)) (. kv snd) p0)))
        (TypedProgram g (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) []
                      [(UDef 0) (UScc [0]) (UDef 1) (UDef 2)]))))

(defun prog () -> Program (emit.program/program-new (typed) (owned-program-new)))

(defun array-i64 () -> Ty (TCon KArray [(ty-i64)]))

(defun ok-str (r: (Result la/LExpr str)) -> str
  (match r ((Ok expr) (n/text expr)) ((Err message) (str "error: " message))))
(defun defs-text (d: Defs) -> str (print/print-module (la/LModule @(. d items))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec))
        (p (prog))
        (d (defs-new)))
    (do
      (is cs (and (= (all-def-ids p) [0 1 2]) (= (def-ids p) [0 2])) "every def in the order of the units; the constant ones are def_ids")
      (is cs (and (= (defs-text d) "") (= @(. d constants) []) (= @(. d counter) 0)) "no constant yet")
      ;; type ids: str 0, (Array i8) 1, weak 2, task 3, so the first object made here is 4
      (is cs (and (= (ok-str (defs-emit-array d p (array-i64) LirI64 [(some (n/integer lt/ty-i64 1)) (some (n/integer lt/ty-i64 -2))])) "(GLOBAL def.1)")
                  (= (defs-text d)
                     (normal/text "(CONSTANT INTERNAL def.1 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 2 I64)) (LITERAL-STRUCT (I64 0) (I32 4) (I32 8) (I64 2) ((ARRAY 2 I64) (I64 1) (I64 -2))))\n"))
                  (= @(. d constants) ["@def.1"])) "an array: the header, the length, the elements; the name is @def.1, not yet in the text before")
      (is cs (and (= (ok-str (defs-emit-array d p (array-i64) LirI64 [])) "(GLOBAL def.2)")
                  (s/ends-with? (defs-text d)
                     (normal/text "(CONSTANT INTERNAL def.2 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 0 I64)) (LITERAL-STRUCT (I64 0) (I32 4) (I32 8) (I64 0) ((ARRAY 0 I64) )))\n"))) "an empty array keeps the space before the closing paren, as the Rust's join of nothing")
      (is cs (match (defs-emit-array d p (ty-i64) LirI64 [])
               ((Err _) true) ((Ok _) false)) "an array of something that is not an array type has no layout")
      (is cs (and (= (ok-str (defs-emit-object d p (nom 1 []) nil [(some (n/integer lt/ty-i64 3)) nil (some (n/global "str.0"))])) "(GLOBAL def.3)")
                  (s/ends-with? (defs-text d)
                                  (normal/text "(CONSTANT INTERNAL def.3 (STRUCT o.Pt) ((STRUCT o.Pt) (I64 0) (I32 5) (I32 8) (I64 3) (GLOBAL str.0)))\n"))) "a struct: the header then the fields, a unit field (empty text) left out")
      (is cs (and (= (ok-str (defs-emit-object d p (nom 2 [(ty-i64)]) (some 1) [])) "(GLOBAL def.4)")
                  (s/includes? (defs-text d) " (I32 8) (I32 1)))\n")
                  (s/includes? (defs-text d) "(CONSTANT INTERNAL def.4 (STRUCT o.$Shape.i64_.v1) ((STRUCT o.$Shape.i64_.v1) (I64 0)")) "a variant: the struct is named .vN and the tag follows the header")
      (is cs (= @(. d constants) ["@def.1" "@def.2" "@def.3" "@def.4"]) "the constants are named in the order they were made")
      (is cs (match (field-types p (nom 1 []) nil) ((Ok tys) (= tys [(ty-i64) (ty-str)])) (_ false)) "field types of a struct (no tag: the first row)")
      (is cs (and (match (field-types p (nom 2 [(ty-i64)]) (some 0)) ((Ok tys) (= tys [(ty-i64)])) (_ false))
                  (match (field-types p (nom 2 [(ty-i64)]) (some 1)) ((Ok tys) (= tys [])) (_ false))) "field types of a variant, at the arguments of the type")
      (is cs (match (field-types p (ty-i64) nil) ((Err m) (= m "an object at a non-nominal type")) (_ false)) "field types of a type that is not nominal")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-defs" [(test-case "checks" unit-steps "compiler/tests/emit/unit-defs.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
