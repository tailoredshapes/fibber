;; E5: comparisons that are not integer ones: strings (`fib.str-cmp` against zero), keywords (by name, `kw.rank`, which makes the
;; keyword helpers part of the module), `unit` (equal to itself, neither below nor above) and `bool` (`ult`, false below true).
(defun strings (a: str b: str) -> i64
  (+ (if (< a b) 1 0) (+ (if (<= a b) 2 0) (+ (if (> a b) 4 0) (+ (if (>= a b) 8 0) (+ (if (= a b) 16 0) (if (!= a b) 32 0)))))))

(defun keywords () -> i64
  (+ (if (< :aa :zz) 1 0) (+ (if (>= :zz :aa) 2 0) (+ (if (= :aa :zz) 4 0) (if (!= :aa :zz) 8 0)))))

(defun units (u: unit v: unit) -> i64
  (+ (if (= u v) 1 0) (+ (if (< u v) 2 0) (+ (if (<= u v) 4 0) (+ (if (> u v) 8 0) (if (>= u v) 16 0))))))

(defun bools (a: bool b: bool) -> i64
  (+ (if (< a b) 1 0) (+ (if (<= a b) 2 0) (+ (if (> a b) 4 0) (+ (if (>= a b) 8 0) (if (= a b) 16 0))))))

(defun main () -> i64
  (+ (strings "a" "b") (+ (keywords) (+ (units () ()) (bools false true)))))
