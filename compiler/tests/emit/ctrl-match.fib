;; E4: `match` on scalars: literal clauses, a guarded clause (its false edge), a binding clause, a clause that jumps (`recur`) and one
;; that falls through, the join with and without a value, and a loop around it. The patterns are E7's: judged with its shim until it lands.
(defun main () -> i64
  (do (match true (true ()) (false ()))
      (match 3 (1 ()) (_ (match \a (\a ()) (_ ()))))
      (loop ((n 5) (s "a"))
        (match n
          (1 10)
          (2 (recur 3 "b"))
          (k :when true (match s ("a" 20) ("b" (recur 1 s)) (_ k)))
          (_ 0)))))
