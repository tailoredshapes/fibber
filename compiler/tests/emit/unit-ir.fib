;; compiler/tests/emit/unit-ir.fib: the inline tests of crates/fibc/src/ir.rs
;; (renders_lets_around_void_instructions, terminators_name_their_targets,
;; a_block_no_live_branch_names_is_discarded, phis_and_allocas_come_first), with
;; the `lir::parse` calls replaced by the text they accept, plus two GOLDEN
;; functions: `f.f` and `f.g` below are the text `fibc emit` printed for
;; `(defun f (x: i64) -> i64 (if (> x 0) (+ x 1) (- x 1)))` and
;; `(defun g (x: i64) -> i64 (let ((p (P x 2))) (+ (. p a) (f (. p b)))))` (P a
;; struct of two i64), and the builder calls that made them are replayed, so the
;; expected side is the Rust FnBuilder's own render. The unterminated-block text
;; has no Rust test: it is read from `render_items`. Also a block of 100,000
;; statements (appends must not copy the block).
;; Build: fibc build compiler/tests/emit/unit-ir.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-ir (:require [fib.string :as s]) (:use fib.test.unit emit.value emit.ir)
  (:require [fib.test.run :as test-runner])
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt]))

(defun has (text: str sub: str) -> bool (s/includes? text sub))

(defun renders-lets-around-void (cs: StepLog) -> unit
  (let ((f (fb-new "f" (some LirI64) [(LirParam LirI64 "x")] true))
        (a (fb-val f (nx/binary la/BAdd (nx/local "x") (nx/integer lt/ty-i64 1)) LirI64)))
    (do (fb-stmt f (nx/call "g" []))
        (let ((b (fb-val f (nx/binary la/BMul (v-expr a) (nx/integer lt/ty-i64 2)) LirI64)))
          (fb-term f (nx/ret (some (v-expr b)))))
        (let ((text (fb-render f)))
          (do (is cs (s/starts-with? text "(define internal tailcc (f i64) ((i64 x))\n  (block entry\n") "define line and entry block")
              (is cs (has text "(let ((t1 (add x (i64 1))))\n      (call @g))") "a let around the first void instruction")
              (is cs (has text "(let ((t2 (mul t1 (i64 2))))\n      (ret t2))") "a let around the terminator")
              (is cs (s/ends-with? text "  ))\n") "the define closes with two parens")
              (is cs (= text "(define internal tailcc (f i64) ((i64 x))\n  (block entry\n    (let ((t1 (add x (i64 1))))\n      (call @g))\n    (let ((t2 (mul t1 (i64 2))))\n      (ret t2))\n  ))\n") "the whole text"))))))

(defun terminators-name-targets (cs: StepLog) -> unit
  (do (is cs (= (ir-targets (nx/branch "next")) ["next"]) "br l")
      (is cs (= (ir-targets (nx/conditional (nx/local "t1") "yes" "no")) ["yes" "no"]) "br c l1 l2")
      (is cs (= (ir-targets (nx/conditional (nx/integer lt/ty-i1 1) "yes" "no")) ["yes" "no"]) "br with a literal condition")
      (is cs (= (ir-targets (nx/switch (nx/local "t2") "done" [(la/LCase (nx/integer lt/ty-i32 0) "v0") (la/LCase (nx/integer lt/ty-i32 1) "v1")])) ["done" "v0" "v1"]) "switch")
      (is cs (empty? (ir-targets (nx/ret (some (nx/local "t3"))))) "ret")
      (is cs (empty? (ir-targets (nx/unreachable))) "unreachable")))

(defun dead-block-discarded (cs: StepLog) -> unit
  (let ((f (fb-new "h" (some LirI64) [] false)))
    (do (fb-stmt f (nx/call "fib.trap-c" [(nx/string "boom")]))
        (fb-term f (nx/unreachable))
        (let ((c (fb-val f (nx/compare-int la/IEq (nx/integer lt/ty-i64 1) (nx/integer lt/ty-i64 1)) LirI1)))
          (fb-term f (nx/conditional (v-expr c) "yes" "no")))
        (fb-open f "yes") (fb-term f (nx/branch "join"))
        (fb-open f "no") (fb-term f (nx/branch "join"))
        (fb-open f "join")
        (let ((p (fb-phi f LirI64 [(PhiEdge "yes" (nx/integer lt/ty-i64 6)) (PhiEdge "no" (nx/integer lt/ty-i64 8))])))
          (fb-term f (nx/ret (some (v-expr p)))))
        (let ((text (fb-render f)))
          (do (is cs (not (has text "(block yes")) "no block yes")
              (is cs (not (has text "phi")) "no phi")
              (is cs (s/ends-with? text "(unreachable)\n  ))\n") "ends at the unreachable")
              (is cs (= text "(define internal (h i64) ()\n  (block entry\n    (call @fib.trap-c (string \"boom\"))\n    (unreachable)\n  ))\n") "the whole text")))))
  (let ((g (fb-new "k" (some LirI64) [(LirParam LirI1 "c")] false)))
    (do (fb-term g (nx/conditional (nx/local "c") "yes" "done"))
        (fb-open g "yes") (fb-term g (nx/branch "done"))
        (fb-open g "dead") (fb-term g (nx/branch "done"))
        (fb-open g "done")
        (let ((p (fb-phi g LirI64 [(PhiEdge "entry" (nx/integer lt/ty-i64 1)) (PhiEdge "yes" (nx/integer lt/ty-i64 2)) (PhiEdge "dead" (nx/integer lt/ty-i64 3))])))
          (fb-term g (nx/ret (some (v-expr p)))))
        (let ((text (fb-render g)))
          (do (is cs (has text "(phi i64 (entry (i64 1)) (yes (i64 2)))") "a live join keeps only its live edges")
              (is cs (not (has text "(block dead")) "the dead block is not printed")
              (is cs (and (fb-is-dead g "dead") (not (fb-is-dead g "yes")) (not (fb-is-dead g "nowhere"))) "a block is dead only if no live branch named it")))))
  (let ((h (fb-new "m" nil [] false)))
    (do (fb-term h (nx/branch "x"))
        (fb-term h (nx/ret nil))
        (is cs (not (has (fb-render h) "(ret)")) "a closed block takes no more"))))

(defun phis-and-allocas-first (cs: StepLog) -> unit
  (let ((f (fb-new "g" nil [] false))
        (slot (fb-entry-alloca f lt/ty-i64 8)))
    (do (fb-stmt f (nx/store (nx/integer lt/ty-i64 0) slot nil))
        (fb-term f (nx/branch "next"))
        (fb-open f "next")
        (let ((p (fb-phi f LirI64 [(PhiEdge "entry" (nx/integer lt/ty-i64 1))])))
          (fb-term f (nx/store (v-expr p) slot nil)))
        (let ((text (fb-render f)))
          (do (is cs (has text "(let ((t1 (alloca i64)))\n      (store (i64 0) t1))") "the alloca is bound first in the entry block")
              (is cs (has text "(block next\n    (let ((t2 (phi i64 (entry (i64 1)))))") "the phi is bound first in its block")
              (is cs (do (fb-open f "late")
                         (fb-patch-phi f "next" "t2" "entry" (nx/integer lt/ty-i64 5))
                         (fb-patch-phi f "next" "t2" "late" (nx/integer lt/ty-i64 6))
                         (has (fb-render f) "(phi i64 (entry (i64 1)) (entry (i64 5)))")) "patch_phi adds an edge and not from a dead block"))))))

(defun overflow-arm (f: FnBuilder op: str) -> unit
  (let ((t5 (fb-val f (nx/overflow (if (= op "sadd") la/OvSAdd la/OvSSub) (nx/local "p0") (nx/integer lt/ty-i64 1)) LirI64))
        (t6 (fb-val f (nx/extract (v-expr t5) 1) LirI1))
        (trap (fb-label f "trap")) (ok (fb-label f "ok")))
    (do (fb-term f (nx/conditional (v-expr t6) trap ok))
        (fb-open f trap)
        (fb-stmt f (nx/call "fib.trap-c" [(nx/string (str "integer overflow in " (if (= op "sadd") "+" "-") " at i64"))]))
        (fb-term f (nx/unreachable))
        (fb-open f ok)
        (let ((r (fb-val f (nx/extract (v-expr t5) 0) LirI64)))
          (fb-term f (nx/ret (some (v-expr r))))))))

(defun golden-f (cs: StepLog) -> unit
  (let ((f (fb-new "f.f" (some LirI64) [(LirParam LirI64 "p0")] true))
        (c (fb-val f (nx/compare-int la/ISgt (nx/local "p0") (nx/integer lt/ty-i64 0)) LirI1))
        (th (fb-label f "then")) (el (fb-label f "else")) (jn (fb-label f "join")))
    (do (fb-term f (nx/conditional (v-expr c) th el))
        (fb-open f th) (overflow-arm f "sadd")
        (fb-open f el) (overflow-arm f "ssub")
        (is cs (= [th el jn] ["then2" "else3" "join4"]) "labels share the counter with names")
        (is cs (= (fb-render f) "(define internal tailcc (f.f i64) ((i64 p0))\n  (block entry\n    (let ((t1 (icmp sgt p0 (i64 0))))\n      (br t1 then2 else3))\n  )\n  (block then2\n    (let ((t5 (sadd-overflow p0 (i64 1)))\n          (t6 (extractvalue t5 1)))\n      (br t6 trap7 ok8))\n  )\n  (block trap7\n    (call @fib.trap-c (string \"integer overflow in + at i64\"))\n    (unreachable)\n  )\n  (block ok8\n    (let ((t9 (extractvalue t5 0)))\n      (ret t9))\n  )\n  (block else3\n    (let ((t10 (ssub-overflow p0 (i64 1)))\n          (t11 (extractvalue t10 1)))\n      (br t11 trap12 ok13))\n  )\n  (block trap12\n    (call @fib.trap-c (string \"integer overflow in - at i64\"))\n    (unreachable)\n  )\n  (block ok13\n    (let ((t14 (extractvalue t10 0)))\n      (ret t14))\n  ))\n") "f.f as the Rust FnBuilder printed it"))))

(defun golden-g (cs: StepLog) -> unit
  (let ((g (fb-new "f.g" (some LirI64) [(LirParam LirI64 "p0")] true))
        (t1 (fb-entry-alloca g (lt/TNamed "o.P") 16)))
    (do (fb-stmt g (nx/call "fib.stack-init" [(nx/local "t1") (nx/integer lt/ty-i32 4)]))
        (let ((t2 (fb-val g (nx/gep (lt/TNamed "o.P") (nx/local "t1") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 3)]) LirPtr)))
          (fb-stmt g (nx/store (nx/local "p0") (v-expr t2) nil)))
        (let ((t3 (fb-val g (nx/gep (lt/TNamed "o.P") (nx/local "t1") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 4)]) LirPtr)))
          (fb-stmt g (nx/store (nx/integer lt/ty-i64 2) (v-expr t3) nil)))
        (fb-label g "join")
        (let ((bound (fb-label g "bound")))
          (do (fb-term g (nx/branch bound))
              (fb-open g bound)))
        (let ((t6 (fb-val g (nx/gep (lt/TNamed "o.P") (nx/local "t1") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 3)]) LirPtr))
              (t7 (fb-val g (nx/load lt/ty-i64 (nx/local "t6") nil) LirI64))
              (t8 (fb-val g (nx/gep (lt/TNamed "o.P") (nx/local "t1") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 4)]) LirPtr))
              (t9 (fb-val g (nx/load lt/ty-i64 (nx/local "t8") nil) LirI64))
              (t10 (fb-val g (nx/call "f.f" [(nx/local "t9")]) LirI64)))
          (fb-stmt g (nx/call "fib.stack-end" [(nx/local "t1")])))
        (fb-stmt g (nx/call "fib.drop-fields" [(nx/local "t1")]))
        (let ((t11 (fb-val g (nx/overflow la/OvSAdd (nx/local "t7") (nx/local "t10")) LirI64))
              (t12 (fb-val g (nx/extract (nx/local "t11") 1) LirI1))
              (trap (fb-label g "trap")) (ok (fb-label g "ok")))
          (do (fb-term g (nx/conditional (nx/local "t12") trap ok))
              (fb-open g trap)
              (fb-stmt g (nx/call "fib.trap-c" [(nx/string "integer overflow in + at i64")]))
              (fb-term g (nx/unreachable))
              (fb-open g ok)
              (let ((t15 (fb-val g (nx/extract (nx/local "t11") 0) LirI64)))
                (fb-term g (nx/ret (some (v-expr t15)))))))
        (is cs (= (fb-render g) "(define internal tailcc (f.g i64) ((i64 p0))\n  (block entry\n    (let ((t1 (alloca %struct.o.P)))\n      (call @fib.stack-init t1 (i32 4)))\n    (let ((t2 (getelementptr %struct.o.P t1 (i32 0) (i32 3))))\n      (store p0 t2))\n    (let ((t3 (getelementptr %struct.o.P t1 (i32 0) (i32 4))))\n      (store (i64 2) t3))\n    (br bound5)\n  )\n  (block bound5\n    (let ((t6 (getelementptr %struct.o.P t1 (i32 0) (i32 3)))\n          (t7 (load i64 t6))\n          (t8 (getelementptr %struct.o.P t1 (i32 0) (i32 4)))\n          (t9 (load i64 t8))\n          (t10 (call @f.f t9)))\n      (call @fib.stack-end t1))\n    (call @fib.drop-fields t1)\n    (let ((t11 (sadd-overflow t7 t10))\n          (t12 (extractvalue t11 1)))\n      (br t12 trap13 ok14))\n  )\n  (block trap13\n    (call @fib.trap-c (string \"integer overflow in + at i64\"))\n    (unreachable)\n  )\n  (block ok14\n    (let ((t15 (extractvalue t11 0)))\n      (ret t15))\n  ))\n") "f.g as the Rust FnBuilder printed it"))))

(defun unterminated-and-big (cs: StepLog) -> unit
  (do (let ((f (fb-new "u" nil [] false)))
        (do (fb-val f (nx/binary la/BAdd (nx/local "x") (nx/integer lt/ty-i64 1)) LirI64)
            (is cs (has (fb-render f) "  (block entry\n    (let ((t1 (add x (i64 1))) ) (unreachable))\n  )") "bindings with no statement after them are printed as unreachable")))
      (let ((f (fb-new "big" nil [] false)))
        (do (doseq [i (range 100000)] (fb-stmt f (nx/call "fib.retain" [(nx/local "%t__H0__")])))
            (fb-term f (nx/ret nil))
            (is cs (= (count (s/split-lines (fb-render f))) 100004) "100000 statements render")))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do (renders-lets-around-void cs)
        (terminators-name-targets cs)
        (dead-block-discarded cs)
        (phis-and-allocas-first cs)
        (golden-f cs)
        (golden-g cs)
        (unterminated-and-big cs)
        (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-ir" [(test-case "checks" unit-steps "compiler/tests/emit/unit-ir.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
