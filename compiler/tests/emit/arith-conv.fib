;; E5: the conversion primitives: each integer conversion at the widths that change and at the one that does not (no instruction),
;; the float conversions (saturating to an integer, NaN to 0), integer to float, and `char`.
(defun ints (a: i64 b: i8 c: i32) -> i64
  (+ (sext i64 (trunc i8 a))
     (+ (zext i64 b)
        (+ (zext i64 (trunc i16 c)) (+ (sext i64 c) (+ (zext i64 a) (sext i64 (sext i64 b))))))))

(defun floats (x: f64 y: f32 n: i64) -> i64
  (+ (fptosi i64 x)
     (+ (sext i64 (fptoui i8 x))
        (+ (fptosi i64 (fpext f64 y))
           (+ (fptosi i64 (fptrunc f32 x)) (+ (fptosi i64 (sitofp f64 n)) (fptoui i64 (uitofp f32 n))))))))

(defun chars (c: char) -> i64
  (sext i64 (char->i32 (i32->char (char->i32 c)))))

(defun main () -> i64
  (+ (ints 300 5i8 70000i32) (+ (floats 300.7 2.5f32 41) (chars (i32->char 97i32)))))
