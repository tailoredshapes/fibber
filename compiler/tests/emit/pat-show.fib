;; E7: the native `show` and `hash` of scalars, a field-less enum (the helper function, made once) and `str`.
(defenum Colour (Red) (Green))
(defun main () -> i64
  (do (show 1) (show 2.5) (show true) (show \a) (show :k) (show "s") (show ()) (show Green) (show Red)
      (hash 1) (hash 2.5) (hash true) (hash \a) (hash :k) (hash "s") (hash Green)
      0))
