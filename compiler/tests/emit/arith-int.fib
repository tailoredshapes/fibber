;; E5: the native methods of the integer widths: the overflow traps of `+ - *`, the division checks (`quot`, `rem`, a literal
;; zero divisor that is the trap alone), the masked shifts, `neg`, `bit-not`, `popcount` and every comparison, at i64, i32, i16, i8.
(defun arith64 (a: i64 b: i64) -> i64
  (+ (+ (+ a b) (- a b)) (+ (* a b) (+ (rem a b) (quot a b)))))

(defun arith8 (a: i8 b: i8) -> i8
  (+ (+ a b) (- (* a b) (quot a b))))

(defun arith16 (a: i16 b: i16) -> i16
  (+ (rem a b) (quot a b)))

(defun bits32 (a: i32 b: i32) -> i32
  (bit-or (bit-and a b) (bit-xor (shl a b) (bit-xor (shr a b) (sar a b)))))

(defun unary (a: i64) -> i64
  (+ (neg a) (+ (bit-not a) (popcount a))))

(defun unary8 (a: i8) -> i8
  (+ (neg a) (+ (bit-not a) (popcount a))))

(defun zero-divisor (a: i64) -> i64
  (+ (quot a 0) (rem a 0)))

(defun compare (a: i64 b: i64) -> bool
  (and (< a b) (and (<= a b) (and (> a b) (and (>= a b) (and (= a b) (!= a b)))))))

(defun main () -> i64
  (+ (arith64 7 3)
     (+ (sext i64 (arith8 5i8 2i8))
        (+ (sext i64 (arith16 9i16 4i16))
           (+ (sext i64 (bits32 12i32 3i32))
              (+ (unary 5) (+ (sext i64 (unary8 3i8)) (if (compare 1 2) 1 0))))))))
