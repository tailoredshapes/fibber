;; compiler/tests/emit/unit-text.fib: the text rules of compiler/emit/text.fib.
;; The float checks (after "the special values") are GENERATED: each literal is a
;; double a probe program wrote (python's shortest repr, 119 of them: hand
;; picked edges of the thresholds 1e-4 and 1e16, the digit counts, random
;; values over six decades and random bit patterns) and each expected text is
;; what `fibc emit` printed for the `(double ..)` of that literal, so the
;; expected side is the Rust's `float_text`, not a spelling of ours.
;; Build: fibc build compiler/tests/emit/unit-text.fib -I compiler -I lib -o OUT
(ns main (:use types.check emit.text))

(defun main () -> i64
  (let ((cs (checks-new)))
    (do
      (check cs "nan" (= (float-lir-text (/ 0.0 0.0)) "nan"))
      (check cs "inf" (= (float-lir-text (/ 1.0 0.0)) "inf"))
      (check cs "-inf" (= (float-lir-text (/ -1.0 0.0)) "-inf"))
      (check cs "the largest i64" (= (int-lir-text 9223372036854775807) "9223372036854775807"))
      (check cs "the smallest i64" (= (int-lir-text (- (- 0 9223372036854775807) 1)) "-9223372036854775808"))
      (check cs "zero and a negative" (= [(int-lir-text 0) (int-lir-text -42)] ["0" "-42"]))
      (check cs "a quote and a backslash are escaped" (= (lir-escape "a\"b\\c") "a\\\"b\\\\c"))
      (check cs "other bytes are not" (= (lir-escape "$Vec.i64_ é\n") "$Vec.i64_ é\n"))
      (check cs "a quoted name" (= (lir-quote "x\"y") "\"x\\\"y\""))
        (check cs "float 0.0" (= (float-lir-text 0.0) "0.0"))
        (check cs "float -0.0" (= (float-lir-text -0.0) "-0.0"))
        (check cs "float 1.0" (= (float-lir-text 1.0) "1.0"))
        (check cs "float -1.0" (= (float-lir-text -1.0) "-1.0"))
        (check cs "float 0.5" (= (float-lir-text 0.5) "0.5"))
        (check cs "float 0.1" (= (float-lir-text 0.1) "0.1"))
        (check cs "float 0.2" (= (float-lir-text 0.2) "0.2"))
        (check cs "float 0.3" (= (float-lir-text 0.3) "0.3"))
        (check cs "float 100.0" (= (float-lir-text 100.0) "100.0"))
        (check cs "float 0.0001" (= (float-lir-text 0.0001) "0.0001"))
        (check cs "float 9.999e-5" (= (float-lir-text 9.999e-5) "9.999e-5"))
        (check cs "float 1.0e-5" (= (float-lir-text 1.0e-5) "1e-5"))
        (check cs "float 1.5e-7" (= (float-lir-text 1.5e-7) "1.5e-7"))
        (check cs "float 12.5" (= (float-lir-text 12.5) "12.5"))
        (check cs "float 123456.789" (= (float-lir-text 123456.789) "123456.789"))
        (check cs "float 1000000.0" (= (float-lir-text 1000000.0) "1000000.0"))
        (check cs "float 10000000.0" (= (float-lir-text 10000000.0) "10000000.0"))
        (check cs "float 12345678.9" (= (float-lir-text 12345678.9) "12345678.9"))
        (check cs "float 123456789.0" (= (float-lir-text 123456789.0) "123456789.0"))
        (check cs "float 1000000000000000.0" (= (float-lir-text 1000000000000000.0) "1000000000000000.0"))
        (check cs "float 9999999999999998.0" (= (float-lir-text 9999999999999998.0) "9999999999999998.0"))
        (check cs "float 1.0e16" (= (float-lir-text 1.0e16) "1e16"))
        (check cs "float 1.5e16" (= (float-lir-text 1.5e16) "1.5e16"))
        (check cs "float 1.2345678901234568e17" (= (float-lir-text 1.2345678901234568e17) "1.2345678901234568e17"))
        (check cs "float 1.0e21" (= (float-lir-text 1.0e21) "1e21"))
        (check cs "float 1.0e22" (= (float-lir-text 1.0e22) "1e22"))
        (check cs "float 1.0e23" (= (float-lir-text 1.0e23) "1e23"))
        (check cs "float 1.0e100" (= (float-lir-text 1.0e100) "1e100"))
        (check cs "float 1.5e300" (= (float-lir-text 1.5e300) "1.5e300"))
        (check cs "float 1.7976931348623157e308" (= (float-lir-text 1.7976931348623157e308) "1.7976931348623157e308"))
        (check cs "float 2.2250738585072014e-308" (= (float-lir-text 2.2250738585072014e-308) "2.2250738585072014e-308"))
        (check cs "float 1.0e-300" (= (float-lir-text 1.0e-300) "1e-300"))
        (check cs "float 0.30000000000000004" (= (float-lir-text 0.30000000000000004) "0.30000000000000004"))
        (check cs "float 4.9e-5" (= (float-lir-text 4.9e-5) "4.9e-5"))
