        (is cs (= (float-lir-text 653.7042493440761) "653.7042493440761") "float 653.7042493440761")
        (is cs (= (float-lir-text -752.3960777007088) "-752.3960777007088") "float -752.3960777007088")
        (is cs (= (float-lir-text -553.522070785971) "-553.522070785971") "float -553.522070785971")
        (is cs (= (float-lir-text 254.86644481117855) "254.86644481117855") "float 254.86644481117855")
        (is cs (= (float-lir-text 895.4178849140112) "895.4178849140112") "float 895.4178849140112")
        (is cs (= (float-lir-text 154.20589723499734) "154.20589723499734") "float 154.20589723499734")
