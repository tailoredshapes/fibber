(defun tests () -> Suite
  (unit-suite "emit/unit-text" [(test-case "checks" unit-steps "compiler/tests/emit/unit-text.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
