;; compiler/tests/emit/unit-text.fib: the text rules of compiler/emit/text.fib.
;; The float checks (after "the special values") are GENERATED: each literal is a
;; double a probe program wrote (python's shortest repr, 119 of them: hand
;; picked edges of the thresholds 1e-4 and 1e16, the digit counts, random
;; values over six decades and random bit patterns) and each expected text is
;; what `fibc emit` printed for the `(double ..)` of that literal, so the
;; expected side is the Rust's `float_text`, not a spelling of ours.
;; Build: fibc build compiler/tests/emit/unit-text.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-text (:use fib.test.unit emit.text)
  (:require [fib.test.run :as test-runner]))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)))
    (do
      (is cs (= (float-lir-text (/ 0.0 0.0)) "nan") "nan")
      (is cs (= (float-lir-text (/ 1.0 0.0)) "inf") "inf")
      (is cs (= (float-lir-text (/ -1.0 0.0)) "-inf") "-inf")
      (is cs (= (int-lir-text 9223372036854775807) "9223372036854775807") "the largest i64")
      (is cs (= (int-lir-text (- (- 0 9223372036854775807) 1)) "-9223372036854775808") "the smallest i64")
      (is cs (= [(int-lir-text 0) (int-lir-text -42)] ["0" "-42"]) "zero and a negative")
      (is cs (= (lir-escape "a\"b\\c") "a\\\"b\\\\c") "a quote and a backslash are escaped")
      (is cs (= (lir-escape "$Vec.i64_ é\n") "$Vec.i64_ é\n") "other bytes are not")
      (is cs (= (lir-quote "x\"y") "\"x\\\"y\"") "a quoted name")
        (is cs (= (float-lir-text 0.0) "0.0") "float 0.0")
        (is cs (= (float-lir-text -0.0) "-0.0") "float -0.0")
        (is cs (= (float-lir-text 1.0) "1.0") "float 1.0")
        (is cs (= (float-lir-text -1.0) "-1.0") "float -1.0")
        (is cs (= (float-lir-text 0.5) "0.5") "float 0.5")
        (is cs (= (float-lir-text 0.1) "0.1") "float 0.1")
        (is cs (= (float-lir-text 0.2) "0.2") "float 0.2")
        (is cs (= (float-lir-text 0.3) "0.3") "float 0.3")
        (is cs (= (float-lir-text 100.0) "100.0") "float 100.0")
        (is cs (= (float-lir-text 0.0001) "0.0001") "float 0.0001")
        (is cs (= (float-lir-text 9.999e-5) "9.999e-5") "float 9.999e-5")
        (is cs (= (float-lir-text 1.0e-5) "1e-5") "float 1.0e-5")
        (is cs (= (float-lir-text 1.5e-7) "1.5e-7") "float 1.5e-7")
        (is cs (= (float-lir-text 12.5) "12.5") "float 12.5")
        (is cs (= (float-lir-text 123456.789) "123456.789") "float 123456.789")
        (is cs (= (float-lir-text 1000000.0) "1000000.0") "float 1000000.0")
        (is cs (= (float-lir-text 10000000.0) "10000000.0") "float 10000000.0")
        (is cs (= (float-lir-text 12345678.9) "12345678.9") "float 12345678.9")
        (is cs (= (float-lir-text 123456789.0) "123456789.0") "float 123456789.0")
        (is cs (= (float-lir-text 1000000000000000.0) "1000000000000000.0") "float 1000000000000000.0")
        (is cs (= (float-lir-text 9999999999999998.0) "9999999999999998.0") "float 9999999999999998.0")
        (is cs (= (float-lir-text 1.0e16) "1e16") "float 1.0e16")
        (is cs (= (float-lir-text 1.5e16) "1.5e16") "float 1.5e16")
        (is cs (= (float-lir-text 1.2345678901234568e17) "1.2345678901234568e17") "float 1.2345678901234568e17")
        (is cs (= (float-lir-text 1.0e21) "1e21") "float 1.0e21")
        (is cs (= (float-lir-text 1.0e22) "1e22") "float 1.0e22")
        (is cs (= (float-lir-text 1.0e23) "1e23") "float 1.0e23")
        (is cs (= (float-lir-text 1.0e100) "1e100") "float 1.0e100")
        (is cs (= (float-lir-text 1.5e300) "1.5e300") "float 1.5e300")
        (is cs (= (float-lir-text 1.7976931348623157e308) "1.7976931348623157e308") "float 1.7976931348623157e308")
        (is cs (= (float-lir-text 2.2250738585072014e-308) "2.2250738585072014e-308") "float 2.2250738585072014e-308")
        (is cs (= (float-lir-text 1.0e-300) "1e-300") "float 1.0e-300")
        (is cs (= (float-lir-text 0.30000000000000004) "0.30000000000000004") "float 0.30000000000000004")
        (is cs (= (float-lir-text 4.9e-5) "4.9e-5") "float 4.9e-5")
        (is cs (= (float-lir-text 4.9e-324) "5e-324") "float 5e-324, Rust writes the shortest digits")
        (is cs (= (float-lir-text 9.9e-324) "1e-323") "float 1e-323")
        (is cs (= (float-lir-text 1.5e-323) "1.5e-323") "float 1.5e-323 keeps its two digits")
        (is cs (= (float-lir-text 2.5e-5) "2.5e-5") "float 2.5e-5")
        (is cs (= (float-lir-text 3.141592653589793) "3.141592653589793") "float 3.141592653589793")
        (is cs (= (float-lir-text 2.718281828459045) "2.718281828459045") "float 2.718281828459045")
        (is cs (= (float-lir-text -2.5) "-2.5") "float -2.5")
        (is cs (= (float-lir-text -1.0e-5) "-1e-5") "float -1.0e-5")
        (is cs (= (float-lir-text -1.0e16) "-1e16") "float -1.0e16")
        (is cs (= (float-lir-text -123.456) "-123.456") "float -123.456")
        (is cs (= (float-lir-text 0.001) "0.001") "float 0.001")
        (is cs (= (float-lir-text 0.0012) "0.0012") "float 0.0012")
        (is cs (= (float-lir-text 0.000123) "0.000123") "float 0.000123")
        (is cs (= (float-lir-text 1234.0) "1234.0") "float 1234.0")
        (is cs (= (float-lir-text 100000.0) "100000.0") "float 100000.0")
        (is cs (= (float-lir-text 10.0) "10.0") "float 10.0")
        (is cs (= (float-lir-text 5.0e-5) "5e-5") "float 5.0e-5")
        (is cs (= (float-lir-text 65536.0) "65536.0") "float 65536.0")
        (is cs (= (float-lir-text 4294967296.0) "4294967296.0") "float 4294967296.0")
        (is cs (= (float-lir-text 9007199254740992.0) "9007199254740992.0") "float 9007199254740992.0")
        (is cs (= (float-lir-text 0.3333333333333333) "0.3333333333333333") "float 0.3333333333333333")
        (is cs (= (float-lir-text 0.6666666666666666) "0.6666666666666666") "float 0.6666666666666666")
        (is cs (= (float-lir-text 1000000000000000.5) "1000000000000000.5") "float 1000000000000000.5")
        (is cs (= (float-lir-text -352.3344703336753) "-352.3344703336753") "float -352.3344703336753")
        (is cs (= (float-lir-text -698.3016521509962) "-698.3016521509962") "float -698.3016521509962")
