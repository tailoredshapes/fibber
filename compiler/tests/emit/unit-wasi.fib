;; compiler/tests/emit/unit-wasi.fib: the 32-bit target of docs/design/wasm.md 4: the layouts take the pointer width of the target, the libc functions whose `size_t` is 32 bits are named, and the
;; WASI adaptation of the runtime (emit.wasi) applies to the runtime as it is: every text it rewrites is in rt/*.lir (a change of the runtime that moves one fails here, not on a machine with a wasm
;; toolchain), what it rewrites is gone, and what it adds is there. Every check names a value a wrong table or a stale rewrite would change.
;; Build: fibc build compiler/tests/emit/unit-wasi.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-wasi (:use fib.test.unit lir.targets emit.value emit.layout emit.runtime) (:require [emit.wasi :as w] [emit.os :as os] [lir.ast :as la] [lir.types :as lt] [emit.node :as n] [emit.function :as f] [lir.print :as print])
  (:require [fib.test.run :as test-runner]))

(defun runtime () -> str
  (str-join [RT-CORE RT-STR RT-ARRAY RT-VEC RT-VECBUILD RT-ATOM RT-THREAD RT-TASK RT-DEQUE RT-SCHED RT-PARK RT-WEAK RT-IO RT-SYS RT-ALLOC]))

(defun has (s: str t: str) -> bool (some? (str-find s t 0)))

(defun adapted () -> str (str-join (mapv w/adapt [RT-CORE RT-STR RT-ARRAY RT-VEC RT-VECBUILD RT-ATOM RT-THREAD RT-TASK RT-DEQUE RT-SCHED RT-PARK RT-WEAK RT-IO RT-SYS RT-ALLOC])))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)) (rt (runtime)) (out (adapted)))
    (do
      (is cs (and (= (. (size-align LirPtr) fst) 8) (= (. (size-align-pb 4 LirPtr) fst) 4) (= (. (size-align-pb 4 LirPtr) snd) 4)
                  (= (. (size-align-pb 4 LirRaw) fst) 4)
                  (= (. (size-align-pb 4 LirDyn) fst) 8) (= (. (size-align-pb 8 LirDyn) fst) 16)
                  (= (. (size-align-pb 4 (LirOpt LirPtr)) fst) 8) (= (. (size-align-pb 8 (LirOpt LirPtr)) fst) 16)) "a pointer is 8 bytes on the host and 4 on a 32-bit target; a dyn is two of them; an Option of one is a tag and a pointer")
      (is cs (and (= (size-align-pb 4 LirI64) (Pair 8 8)) (= (size-align-pb 4 LirDouble) (Pair 8 8)) (= (size-align-pb 4 LirI32) (Pair 4 4))
                  (= (size-align-pb 4 (LirOpt LirI64)) (Pair 16 8))) "scalars do not depend on the pointer: i64 and double are 8 and 8-aligned even where a pointer is 4")
      (is cs (and (= (quot (. (target-row-of-triple "wasm32-wasi") pointer-bits) 8) 4) (= (quot (. (target-row-of-triple "aarch64-apple-darwin") pointer-bits) 8) 8)) "the pointer width of the target is the row's: 4 for wasm32, 8 otherwise (the host's when no target is named)")
      (is cs (and (libc-narrow? "malloc") (libc-narrow? "write") (libc-narrow? "snprintf") (libc-narrow? "calloc") (libc-narrow? "memcpy")
                  (not (libc-narrow? "lseek")) (not (libc-narrow? "fib_alloc_ctl")) (not (libc-narrow? "clock_gettime")) (not (libc-narrow? "no-such"))) "the libc functions of a 32-bit size_t are narrowed; lseek (off_t is 64 bits), the runtime's own functions and a made-up name are not")
      (is cs (every? (fn (n: str) (libc-narrow? n)) ["malloc" "calloc" "realloc" "memcpy" "memcmp" "memset" "write" "read" "strlen" "snprintf" "sysconf" "pthread_detach" "malloc_usable_size"]) "every list of narrowed names is a name of the runtime's C functions or the library's externs: the runtime's size_t users are all in it")
      (is cs (every? (fn (p: str) (has rt p)) (w/rewrite-patterns)) "every text the WASI adaptation rewrites is in the runtime (a stale rewrite after a change of rt/*.lir fails here)")
      (is cs (and (not (or (has out "(GLOBAL madvise)") (has out "(GLOBAL mallopt)") (has out "(GLOBAL pipe) ") (has out "(GLOBAL dup) ")))
                  (not (or (has out "(DECLARE madvise") (has out "(DECLARE mallopt") (has out "(DECLARE pipe ") (has out "(DECLARE dup ")
                           (has out "(DECLARE pthread_create") (has out "(DECLARE pthread_detach") (has out "(DECLARE pthread_exit")))) "the adapted runtime calls no madvise, mallopt, pipe or dup, and declares none of them nor pthread_create, pthread_detach or pthread_exit (the shim defines the last three)")
      (is cs (and (has rt "(CALL (GLOBAL fib.array-alloc) m tnarr (I64 8))") (not (has out "(CALL (GLOBAL fib.array-alloc) m tnarr (I64 8))"))
                  (not (has out "(CALL (GLOBAL fib.array-elem) karr ki (I64 8))")) (has out "(CALL (GLOBAL fib.array-elem) karr ki (I64 4))")
                  (not (has out "(MUL cap2 (I64 8))")) (has out "(MUL cap2 (I64 4))")) "no runtime text says a pointer is 8 bytes in the places that the target's 4 must reach (the trie's child arrays, the worklist)")
      (is cs (and (has out "(n (I64 0))") (has out "(CALL (GLOBAL fib.w.run-inline) entry task)") (not (has out "(CALL (GLOBAL pthread_cond_wait)"))
                  (has out "(DEFINE INTERNAL (fib.pool-quiesce VOID) ()\n  (BLOCK entry (BR test))")) "the pool starts no worker, a spawn runs the task where it is asked, and the exit drains the queue instead of waiting for a worker")
      (is cs (and (has out "(CALL (GLOBAL openat) (I32 -2)") (has out "(CALL (GLOBAL fib.w.oflags) flags)") (has out "(CALL (GLOBAL fib.w.errno-linux) (LOAD I32 (CALL (GLOBAL __errno_location))))")
                  (has out "(CALL (GLOBAL strerror) (CALL (GLOBAL fib.w.errno-wasi)")) "the runtime's open uses WASI's AT_FDCWD (-2) and flags, and its errno is Linux's number of the WASI one")
      (is cs (let ((shim (w/shim)))
               (every? (fn (n: str) (has shim (str-join ["(DEFINE INTERNAL (" n " "])))
                       ["fib.w.oflags" "fib.w.nosys" "fib.w.run-inline" "fib.w.deadlock" "fib.w.errno-linux" "fib.w.errno-wasi" "pthread_create" "pthread_exit" "pthread_detach"])) "the shim defines what the adapted text calls: oflags, nosys, run-inline, the deadlock trap, both errno maps, pthread_create and pthread_exit")
      (is cs (let ((shim (w/shim)))
               (and (has shim "((I32 44) m44)") (has shim "(BLOCK m44 (RET (I32 2)))") (has shim "((I32 2) m2)") (has shim "(BLOCK m2 (RET (I32 44)))")
                    (has shim "(BLOCK m17 (RET (I32 20)))") (has shim "(BLOCK m22 (RET (I32 28)))"))) "the errno maps are switches over the table: ENOENT 44 <-> 2, EEXIST 20 <-> 17, EINVAL 28 <-> 22")
      (is cs (let ((t (print/print-module (w/finish-module (la/LModule
        [(la/ItDeclare (la/LDeclare "clock_gettime" (lt/LFnType lt/cc-c (some lt/ty-i32) [lt/ty-i32 lt/ty-ptr] false) false 0))
         (la/ItDefine (f/make "f" nil [(Pair "id" lt/ty-i32) (Pair "t" lt/ty-ptr) (Pair "u" lt/ty-ptr)] lt/cc-c
           [(f/block "entry" [(n/call "clock_gettime" [(n/integer lt/ty-i32 1) (n/local "t")])
                              (n/call "clock_gettime" [(n/local "id") (n/local "u")]) (n/ret nil)])]))])))))
               (and (not (has t "(DECLARE clock_gettime I32 (I32 PTR))")) (has t "(CALL (GLOBAL fib.w.clock-gettime) (I32 1) t)") (has t "(CALL (GLOBAL fib.w.clock-gettime) id u)")
                    (has t "(DEFINE INTERNAL (fib.w.clock-gettime I32)") (has t "(STORE (SEXT I64 (LOAD I32 at)) at)"))) "the finishing pass renames clock_gettime everywhere and defines the wrapper that widens tv_nsec")
      (is cs (= (w/adapt "(DEFINE INTERNAL (f VOID) () (BLOCK entry (RET)))") "(DEFINE INTERNAL (f VOID) () (BLOCK entry (RET)))") "a text with none of the patterns is left as it is by the part rewrite")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-wasi" [(test-case "checks" unit-steps "compiler/tests/emit/unit-wasi.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
