;; E7: vector patterns: the length test (`eq` without a rest, `sge` with one), elements read through `fib.vec-elem-ptr`, a rest bound
;; by `fib.vec-drop` left to right, `_` elements skipped, a `Pair` matched field by field, `let` with a vector pattern.
(defun head (v: (Vec i64)) -> (Vec i64) (match v ([_ x & r] r) ([] v) ([x] v)))
(defun two (v: (Vec str)) -> str (match v ([a b] b) ([a & _] a) (_ "")))
(defun unit-elems (v: (Vec unit)) -> i64 (match v ([_ _] 2) (_ 0)))
(defun tup (p: (Pair i64 str)) -> str (match p ([_ s] s)))
(defun main () -> i64
  (let (([a b & r] [1 2 3 4]) ([c d] (Pair 1 "x")))
    (do (head [1 2 3]) (two ["a" "b"]) (unit-elems [() ()]) (tup (Pair 1 "t")) a)))
