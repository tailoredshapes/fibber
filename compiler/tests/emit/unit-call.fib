;; compiler/tests/emit/unit-call.fib: calls and arithmetic (package E5) on hand-built contexts: the text of each native method of the
;; scalars (the Rust arith.rs has no unit tests; its judge is the text of whole functions, call.sh), the checks and traps of the integer
;; operations, the conversions, `emit-call` for every target, `cell-load`, `instance-of-pred` over a hand-built instance table, and the
;; errors of the call site that no accepted program reaches.
;; Build: fibc build compiler/tests/emit/unit-call.fib -I compiler -I lib -o OUT       Run: OUT (exit 0 when every check holds)
(ns main
  (:require [fib.string :as s])
  (:use syntax.pos types.ty types.decls types.table types.program types.check types.ast own.program emit.value emit.ir emit.mono emit.program
        emit.lower.cx emit.lower.mod emit.lower.arith emit.lower.call)
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt]))

(defun cx-over (g: Globals own: BodyOwn) -> LowerCx
  (let ((typed (TypedProgram g (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) [] [])))
    (lcx-build (emit.program/program-new typed (owned-program-new)) (Inst (BodyFun 0) [] []) own "f.t" [] true (hub-default) (map-empty))))

(defun plain () -> LowerCx (cx-over (globals-new) (body-own-new)))
(defun text-of (cx: LowerCx) -> str (fb-render (. cx b)))
(defun has (cx: LowerCx word: str) -> bool (s/includes? (text-of cx) word))
;; Whether the function names the program's C string of `text` (emit.statics `statics-cstring`: a trap's message is one constant per text).
(defun has-cstr (cx: LowerCx text: str) -> bool
  (match (get @(. (. (. cx p) statics) cstr-index) text) ((some name) (has cx (str "(GLOBAL " (str-slice name 1 (str-len name)) ")"))) (nil false)))
(defun lit (id: i64) -> Expr (Expr id (Pos "t" 0 0 0 0) (ELit LitUnit)))
(defun starts-err (r: (Result a str) word: str) -> bool (match r ((Err m) (s/starts-with? m word)) (_ false)))

(def t64: Ty (ty-scalar SI64))
(def a64: V (VVal (nx/local "a") LirI64))
(def b64: V (VVal (nx/local "b") LirI64))

;; One method of a native instance on a fresh context: the context, the result.
(defstruct Ran (cx: LowerCx r: (Result (Option V) str)))
(defun ran (method: str x: V y: V t: Ty) -> Ran
  (let ((cx (plain))) (Ran cx (lcx-native-method cx "Num" method [x y] [t t] t))))
(defun ty-of (r: Ran) -> (Option LirTy)
  (match (. r r) ((Ok (some v)) (v-ty v)) (_ nil)))

;; Each row: the method, the text it must emit, the type of its result.
(defun table-checks (cs: Checks what: str x: V y: V t: Ty rows: (Vec (Pair str (Pair str LirTy)))) -> unit
  (doseq [row rows]
    (let ((r (ran (. row fst) x y t)))
      (check cs (str-join [what " " (. row fst)])
             (and (has (. r cx) (. (. row snd) fst)) (= (ty-of r) (some (. (. row snd) snd))))))))

(defun int-checks (cs: Checks) -> unit
  (do (table-checks cs "i64" a64 b64 t64
                    [(Pair "bit-and" (Pair "(AND a b)" LirI64)) (Pair "bit-or" (Pair "(OR a b)" LirI64)) (Pair "bit-xor" (Pair "(XOR a b)" LirI64))
                     (Pair "=" (Pair "(ICMP EQ a b)" LirI1)) (Pair "!=" (Pair "(ICMP NE a b)" LirI1)) (Pair "<" (Pair "(ICMP SLT a b)" LirI1))
                     (Pair "<=" (Pair "(ICMP SLE a b)" LirI1)) (Pair ">" (Pair "(ICMP SGT a b)" LirI1)) (Pair ">=" (Pair "(ICMP SGE a b)" LirI1))
                     (Pair "+" (Pair "(SADD-OVERFLOW a b)" LirI64)) (Pair "-" (Pair "(SSUB-OVERFLOW a b)" LirI64))
                     (Pair "*" (Pair "(SMUL-OVERFLOW a b)" LirI64)) (Pair "rem" (Pair "(SREM a b)" LirI64))
                     (Pair "quot" (Pair "(SDIV a b)" LirI64)) (Pair "shl" (Pair "(SHL a " LirI64)) (Pair "shr" (Pair "(LSHR a " LirI64))
                     (Pair "sar" (Pair "(ASHR a " LirI64))])
      (table-checks cs "i1" (VVal (nx/local "p") LirI1) (VVal (nx/local "q") LirI1) (ty-scalar SBool)
                    [(Pair "<" (Pair "(ICMP ULT p q)" LirI1)) (Pair ">=" (Pair "(ICMP UGE p q)" LirI1)) (Pair "=" (Pair "(ICMP EQ p q)" LirI1))])
      (check cs "an overflow check traps on the flag with the width in the message"
             (let ((r (ran "+" a64 b64 t64)))
               (and (has (. r cx) "(EXTRACTVALUE ") (has-cstr (. r cx) "integer overflow in + at i64") (has (. r cx) "(UNREACHABLE)"))))
      (check cs "a shift masks its count to the width: i32 by 31"
             (let ((cx (plain)) (r (lcx-native-method cx "Bits" "shl" [(VVal (nx/local "a") LirI32) (VVal (nx/local "b") LirI32)] [(ty-scalar SI32) (ty-scalar SI32)] (ty-scalar SI32))))
               (and (has cx "(AND b (I32 31))") (has cx "(SHL a "))))
      (check cs "a native method without a receiver is an error naming the method" (starts-err (lcx-native-method (plain) "Num" "+" [] [] t64) "+ without"))
      (check cs "an unknown comparison method is an error" (starts-err (. (ran "nope" a64 b64 t64) r) "native method nope"))))

(defun division-checks (cs: Checks) -> unit
  (do (check cs "quot is the division `/`: the zero check, the minimum check, sdiv, the messages name `/`"
             (let ((r (ran "quot" a64 b64 t64)))
               (and (has (. r cx) "(ICMP EQ b (I64 0))") (has (. r cx) "(ICMP EQ a (I64 -9223372036854775808))") (has (. r cx) "(ICMP EQ b (I64 -1))")
                    (has-cstr (. r cx) "integer / by zero") (has-cstr (. r cx) "integer overflow in / at i64") (has (. r cx) "(SDIV a b)"))))
      (check cs "rem names rem and uses srem"
             (let ((r (ran "rem" a64 b64 t64))) (and (has-cstr (. r cx) "integer rem by zero") (has (. r cx) "(SREM a b)"))))
      (check cs "at i8 the minimum is -128"
             (let ((r (ran "quot" (VVal (nx/local "a") LirI8) (VVal (nx/local "b") LirI8) (ty-scalar SI8)))) (and (has (. r cx) "(ICMP EQ a (I8 -128))") (has-cstr (. r cx) "integer overflow in / at i8"))))
      (check cs "a literal zero divisor is the trap alone: no value, no division"
             (let ((r (ran "quot" a64 (v-int LirI64 0) t64)))
               (and (= (. r r) (Ok nil)) (has-cstr (. r cx) "integer / by zero") (not (has (. r cx) "sdiv")) (not (has (. r cx) "icmp eq")))))
      (check cs "and for rem" (let ((r (ran "rem" a64 (v-int LirI64 0) t64))) (and (= (. r r) (Ok nil)) (has-cstr (. r cx) "integer rem by zero"))))))

(defun unary-checks (cs: Checks) -> unit
  (let ((one (fn (method: str x: V t: Ty) (let ((cx (plain))) (Pair cx (lcx-native-method cx "Num" method [x] [t] t))))))
    (do (check cs "neg traps on the minimum and subtracts from zero"
               (let ((r (one "neg" a64 t64)))
                 (and (has (. r fst) "(ICMP EQ a (I64 -9223372036854775808))") (has-cstr (. r fst) "integer overflow in neg at i64") (has (. r fst) "(SUB (I64 0) a)"))))
        (check cs "bit-not xors with -1, popcount is ctpop"
               (and (has (. (one "bit-not" a64 t64) fst) "(XOR a (I64 -1))") (has (. (one "popcount" a64 t64) fst) "(CTPOP a)")))
        (check cs "an unknown unary method is an error" (starts-err (. (one "nope" a64 t64) snd) "unary nope"))
        (check cs "a float negates with fneg, at its own width"
               (let ((r (one "neg" (VVal (nx/local "x") LirFloat) (ty-scalar SF32))))
                 (and (has (. r fst) "(FNEG x)") (match (. r snd) ((Ok (some (VVal _ (LirFloat)))) true) (_ false))))))))

(defun float-checks (cs: Checks) -> unit
  (let ((x (VVal (nx/local "x") LirDouble)) (y (VVal (nx/local "y") LirDouble)) (t (ty-scalar SF64)))
    (do (table-checks cs "f64" x y t
                      [(Pair "+" (Pair "(FADD x y)" LirDouble)) (Pair "-" (Pair "(FSUB x y)" LirDouble)) (Pair "*" (Pair "(FMUL x y)" LirDouble))
                       (Pair "fdiv" (Pair "(FDIV x y)" LirDouble)) (Pair "rem" (Pair "(FREM x y)" LirDouble))
                       (Pair "quot" (Pair "(CALL (GLOBAL trunc) " LirDouble)) (Pair "=" (Pair "(FCMP OEQ x y)" LirI1)) (Pair "!=" (Pair "(FCMP UNE x y)" LirI1))
                       (Pair "<" (Pair "(FCMP OLT x y)" LirI1)) (Pair "<=" (Pair "(FCMP OLE x y)" LirI1)) (Pair ">" (Pair "(FCMP OGT x y)" LirI1))
                       (Pair ">=" (Pair "(FCMP OGE x y)" LirI1))])
        (check cs "f32 quot truncates with truncf, after the division"
               (let ((r (ran "quot" (VVal (nx/local "x") LirFloat) (VVal (nx/local "y") LirFloat) (ty-scalar SF32))))
                 (and (has (. r cx) "(FDIV x y)") (has (. r cx) "(CALL (GLOBAL truncf) ") (not (has (. r cx) "(CALL (GLOBAL trunc) ")) (= (ty-of r) (some LirFloat))))))))

(defun other-checks (cs: Checks) -> unit
  (do (check cs "strings compare by fib.str-cmp against zero"
             (let ((cx (plain)) (r (lcx-native-method cx "Ord" "<" [(VVal (nx/local "a") LirPtr) (VVal (nx/local "b") LirPtr)] [(TCon KStr []) (TCon KStr [])] (ty-scalar SBool))))
               (and (has cx "(CALL (GLOBAL fib.str-cmp) a b)") (has cx "(ICMP SLT ") (has cx "(I32 0))") (= (ty-of (Ran cx r)) (some LirI1)))))
      (check cs "a string comparison needs its second operand"
             (starts-err (lcx-native-method (plain) "Ord" "<" [(VVal (nx/local "a") LirPtr)] [(TCon KStr [])] (ty-scalar SBool)) "a string comparison"))
      (check cs "keywords order by name through kw.rank, and the module then has the keyword helpers"
             (let ((cx (plain)) (kw (ty-scalar SKeyword)))
               (do (lcx-native-method cx "Ord" "<" [a64 b64] [kw kw] (ty-scalar SBool))
                   (and (has cx "(CALL (GLOBAL kw.rank) a)") (has cx "(CALL (GLOBAL kw.rank) b)") @(. (. cx p) keyword-helpers)))))
      (check cs "and equality of keywords is the integer one, with no helpers"
             (let ((cx (plain)) (kw (ty-scalar SKeyword)))
               (do (lcx-native-method cx "Eq" "=" [a64 b64] [kw kw] (ty-scalar SBool))
                   (and (has cx "(ICMP EQ a b)") (not @(. (. cx p) keyword-helpers))))))
      (check cs "unit equals itself and is neither below nor above"
             (let ((u (fn (m: str) (lcx-native-method (plain) "Ord" m [VUnit VUnit] [(ty-unit) (ty-unit)] (ty-scalar SBool)))))
               (and (= (u "=") (Ok (some (v-int LirI1 1)))) (= (u ">=") (Ok (some (v-int LirI1 1)))) (= (u "<") (Ok (some (v-int LirI1 0))))
                    (= (u "!=") (Ok (some (v-int LirI1 0)))) (starts-err (u "+") "+ on unit"))))))

(defun convert-checks (cs: Checks) -> unit
  (let ((conv (fn (op: ConvOp to: Scalar v: V) (let ((cx (plain))) (Pair cx (lcx-convert cx op to v)))))
        (x (VVal (nx/local "x") LirDouble)) (n (VVal (nx/local "n") LirI64)))
    (do (check cs "trunc, zext, sext" (and (has (. (conv (CvIntToInt Trunc) SI8 n) fst) "(TRUNC I8 n)") (has (. (conv (CvIntToInt Zext) SI64 (VVal (nx/local "n") LirI32)) fst) "(ZEXT I64 n)")
                                           (has (. (conv (CvIntToInt Sext) SI64 (VVal (nx/local "n") LirI8)) fst) "(SEXT I64 n)")))
        (check cs "an integer conversion to the same width is no instruction"
               (let ((r (conv (CvIntToInt Sext) SI64 n))) (and (= (. r snd) (Ok n)) (not (has (. r fst) "sext")))))
        (check cs "fptrunc and fpext, and a float to its own type is no instruction"
               (and (has (. (conv CvFloatToFloat SF32 x) fst) "(FPTRUNC FLOAT x)") (has (. (conv CvFloatToFloat SF64 (VVal (nx/local "x") LirFloat)) fst) "(FPEXT DOUBLE x)")
                    (= (. (conv CvFloatToFloat SF64 x) snd) (Ok x))))
        (check cs "float to integer saturates, signed or not"
               (and (has (. (conv (CvFloatToInt true) SI8 x) fst) "(FPTOSI-SAT I8 x)") (has (. (conv (CvFloatToInt false) SI32 x) fst) "(FPTOUI-SAT I32 x)")))
        (check cs "integer to float, signed or not"
               (and (has (. (conv (CvIntToFloat true) SF64 n) fst) "(SITOFP DOUBLE n)") (has (. (conv (CvIntToFloat false) SF32 n) fst) "(UITOFP FLOAT n)")))
        (check cs "a conversion to unit or of unit is an error"
               (and (starts-err (. (conv (CvIntToInt Zext) SUnit n) snd) "conversion to unit") (starts-err (. (conv (CvIntToInt Zext) SI64 VUnit) snd) "conversion of unit"))))))

(defun bits-checks (cs: Checks) -> unit
  (let ((one (fn (name: str v: V) (let ((cx (plain))) (Pair cx (lcx-float-bits cx name v))))))
    (do (check cs "the four bit casts are bitcasts to the width's other type"
               (and (has (. (one "f64->bits" (VVal (nx/local "x") LirDouble)) fst) "(BITCAST I64 x)") (has (. (one "bits->f64" a64) fst) "(BITCAST DOUBLE a)")
                    (has (. (one "f32->bits" (VVal (nx/local "x") LirFloat)) fst) "(BITCAST I32 x)") (has (. (one "bits->f32" (VVal (nx/local "n") LirI32)) fst) "(BITCAST FLOAT n)")))
        (check cs "another name is an error" (starts-err (. (one "f16->bits" a64) snd) "builtin f16->bits")))))

(defun trap-checks (cs: Checks) -> unit
  (let ((cx (plain)))
    (do (lcx-trap-if cx (VVal (nx/local "c") LirI1) "boom")
        (check cs "trap-if branches on the flag to a trap block and continues in a fresh ok block"
               (and (has cx "(BR c ") (has-cstr cx "boom") (has cx "(UNREACHABLE)") (s/starts-with? (fb-current (. cx b)) "ok"))))))

;; ---- calls

(defun emitted (target: Target vals: (Vec V) rt: Ty tail: bool) -> Ran
  (let ((cx (plain))) (Ran cx (match (lcx-emit-call cx target vals rt tail) ((Ok v) (Ok (some v))) ((Err e) (Err e))))))

(defun emit-call-checks (cs: Checks) -> unit
  (do (check cs "a direct call: the unit argument is not passed, the result is a value of the return type"
               (let ((r (emitted (TgDirect "f.g" false) [a64 VUnit b64] t64 false))) (and (has (. r cx) "(CALL (GLOBAL f.g) a b)") (= (ty-of r) (some LirI64)))))
        (check cs "an all-owned callee takes a null environment first"
               (has (. (emitted (TgDirect "f.g" true) [a64] t64 false) cx) "(CALL (GLOBAL f.g) (PTR NULL) a)"))
        (check cs "a tail call ends the block and yields unit"
               (let ((r (emitted (TgDirect "f.g" false) [a64] t64 true))) (and (= (. r r) (Ok (some VUnit))) (fb-closed (. (. r cx) b)) (has (. r cx) "(TAILCALL (GLOBAL f.g) a)"))))
        (check cs "a unit result is a statement"
               (let ((r (emitted (TgDirect "f.g" false) [a64] (ty-unit) false))) (and (= (. r r) (Ok (some VUnit))) (has (. r cx) "(CALL (GLOBAL f.g) a)"))))
        (check cs "an extern is called by its own name"
               (has (. (emitted (TgExtern "abs") [a64] t64 false) cx) "(CALL (GLOBAL abs) a)"))
        (check cs "a vtable's code is called indirectly with this first and the types of the rest"
               (let ((r (emitted (TgCode (nx/local "c1") (nx/local "this")) [(VVal (nx/local "this") LirPtr) a64 b64] t64 false)))
                 (has (. r cx) "(INDIRECT-CALL c1 (FUNCTION TAILCC I64 (PTR I64 I64)) this a b)")))
        (check cs "a closure's code is loaded from the closure object and called with it first, in tail position too"
               (let ((r (emitted (TgValue (VVal (nx/local "clo") LirPtr)) [a64] t64 true)))
                 (and (has (. r cx) "(GETELEMENTPTR (STRUCT fib.closure) clo (I32 0) (I32 3))") (has (. r cx) "(LOAD PTR ")
                      (has (. r cx) "(INDIRECT-TAILCALL ") (has (. r cx) "(FUNCTION TAILCC I64 (PTR I64)) clo a)"))))
        (check cs "a unit-returning closure call has void in its type"
               (has (. (emitted (TgValue (VVal (nx/local "clo") LirPtr)) [] (ty-unit) false) cx) "(FUNCTION TAILCC VOID (PTR)) clo )"))
        (check cs "a builtin is not a callable target" (starts-err (. (emitted (TgBuiltin "x") [] t64 false) r) "not a callable target"))))

(defun cell-checks (cs: Checks) -> unit
  (let ((cx (plain)) (cy (plain)))
    (do (check cs "a cell's content: the field's address, then the load"
               (and (match (lcx-cell-load cx "o.cell" (nx/local "c") t64) ((Ok (VVal _ (LirI64))) true) (_ false))
                    (has cx "(GETELEMENTPTR (STRUCT o.cell) c (I32 0) (I32 3))") (has cx "(LOAD I64 ")))
        (check cs "a unit content has no load, but the address is taken as in the Rust"
               (and (= (lcx-cell-load cy "o.cell" (nx/local "c") (ty-unit)) (Ok VUnit)) (has cy "(GETELEMENTPTR") (not (has cy "(LOAD")))))))

;; ---- instance-of-pred

(defun inst (proto: i64 con: Con vars: (Vec str) head: Ty) -> InstanceDef
  (InstanceDef proto con 2 vars head [] [] [] (Pos "t" 0 0 0 0)))

(defun with-instances () -> LowerCx
  (let ((g (globals-new)))
    (do (table-add (. g protos) (ProtoDef "Top" 2 [] [] [] (Pos "t" 0 0 0 0)))
        (doseq [i [(inst 0 (KNominal 5) ["a" "b"] (TCon (KNominal 5) [(TGen 1) (TGen 0)]))
                   (inst 0 (KNominal 7) ["a" "b"] (TCon (KNominal 7) [(TGen 0)]))
                   (inst 0 (KNominal 8) ["a" "b"] (TCon (KNominal 8) [(TFn CLocal [(TGen 0)] (TGen 1))]))]]
          (let ((id (table-add (. g instances) i)))
            (set! (. g instance-index) (assoc @(. g instance-index) (InstKey 0 (. i con)) id))))
        (cx-over g (body-own-new)))))

(defun pred-checks (cs: Checks) -> unit
  (let ((cx (with-instances)) (bool (ty-scalar SBool)))
    (do (check cs "the head's variables take the actual's arguments, by their own index"
               (= (lcx-instance-of-pred cx (PProto 0 [(TCon (KNominal 5) [t64 bool])])) (Ok (Pair 0 [bool t64]))))
        (check cs "a function type in the head is matched too"
               (= (lcx-instance-of-pred cx (PProto 0 [(TCon (KNominal 8) [(TFn CLocal [t64] bool)])])) (Ok (Pair 2 [t64 bool]))))
        (check cs "a variable the head does not fix is an error"
               (starts-err (lcx-instance-of-pred cx (PProto 0 [(TCon (KNominal 7) [t64])])) "an instance variable the head does not fix"))
        (check cs "no instance for the constructor"
               (starts-err (lcx-instance-of-pred cx (PProto 0 [(TCon (KNominal 6) [])])) "no instance of Top"))
        (check cs "a function type, a variable, a predicate that is no protocol and a protocol without arguments are errors"
               (and (starts-err (lcx-instance-of-pred cx (PProto 0 [(TFn CLocal [] t64)])) "a protocol instance on a function type")
                    (starts-err (lcx-instance-of-pred cx (PProto 0 [(TVar 3)])) "a type variable at a method call")
                    (starts-err (lcx-instance-of-pred cx (PSend t64)) "a non-protocol bound at a method call")
                    (starts-err (lcx-instance-of-pred cx (PProto 0 [])) "a protocol without a head"))))))

;; ---- the site

(defun call-own (callee: Callee) -> BodyOwn
  (BodyOwn [] (map-empty) (map-empty) (assoc (map-empty) 1 (CallOwn callee TlNotInTail PsScalar [] [] [])) (map-empty) (map-empty) (map-empty) (set-empty) (map-empty) (map-empty) (set-empty)))

(defun site-checks (cs: Checks) -> unit
  (let ((at (fn (callee: Callee) (lcx-call (cx-over (globals-new) (call-own callee)) (lit 1) (lit 2) []))))
    (do (check cs "no plan for the call is an error" (starts-err (lcx-call (plain) (lit 1) (lit 2) []) "no plan for a call"))
        (check cs "a plan with fewer passes than arguments stops at the first argument without one"
               (starts-err (lcx-call (cx-over (globals-new) (call-own (CalFun 0))) (lit 1) (lit 2) [(ArgExpr (lit 3))]) "no pass for an argument"))
        (check cs "a method call with no resolution, a function with no scheme, a constructor or extern callee on another head"
               (and (starts-err (at (CalMethod 0 0)) "a method call without a resolution") (starts-err (at (CalFun 0)) "a function without a scheme")
                    (starts-err (at (CalAllOwned 0)) "a function without a scheme") (starts-err (at CalCtor) "callee Ctor")
                    (starts-err (at CalExtern) "callee Extern"))))))

(defun main () -> i64
  (let ((cs (checks-new)))
    (do (int-checks cs) (division-checks cs) (unary-checks cs) (float-checks cs) (other-checks cs) (convert-checks cs) (bits-checks cs)
        (trap-checks cs) (emit-call-checks cs) (cell-checks cs) (pred-checks cs) (site-checks cs) (finish cs))))
