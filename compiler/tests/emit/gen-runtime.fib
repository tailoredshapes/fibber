;; compiler/tests/emit/gen-runtime.fib: the generator of compiler/emit/runtime.fib (plan G4): the lIR text of the runtime,
;; rt/*.lir, in the order compile.rs:20 `include_str!`s them, as fifteen `def` strings (the eleven of the Rust, deque, sched and park after task, then alloc), since fibber has no
;; `include-str` and the compiler must stay one binary that does not read a directory beside it.
;; Usage: gen-runtime RT-DIR > compiler/emit/runtime.fib          (compiler/tests/emit/runtime.sh builds and runs it)
;; The drift test is runtime.sh: it regenerates the file and `cmp`s it with the committed one, and unit-runtime.fib
;; compares each def with its .lir file.
;; Build: fibc build compiler/tests/emit/gen-runtime.fib -I compiler -I lib -o OUT
(ns main)

;; The parts in the order of the Rust `RUNTIME`: the file stem, then the name of its def.
(def parts: (Vec (Pair str str))
  [(Pair "core" "RT-CORE") (Pair "str" "RT-STR") (Pair "array" "RT-ARRAY") (Pair "vec" "RT-VEC")
   (Pair "vecbuild" "RT-VECBUILD") (Pair "atom" "RT-ATOM") (Pair "thread" "RT-THREAD") (Pair "task" "RT-TASK")
   (Pair "deque" "RT-DEQUE") (Pair "sched" "RT-SCHED") (Pair "park" "RT-PARK") (Pair "weak" "RT-WEAK") (Pair "io" "RT-IO")
   (Pair "sys" "RT-SYS") (Pair "alloc" "RT-ALLOC")])

;; The escape of a byte a string literal cannot hold as it is, or nil.
(defun escape-of (b: i32) -> (Option str)
  (cond (= b 92i32) (some "\\\\")
        (= b 34i32) (some "\\\"")
        (= b 9i32) (some "\\t")
        (= b 13i32) (some "\\r")
        (= b 0i32) (some "\\0")
        :else nil))

;; The text of a fibber string literal for `s`: a backslash, a quote, a tab, a carriage return and a nul are escaped, line
;; breaks and the rest (UTF-8 included) are kept as they are.
(defun literal-text (s: str) -> str
  (let ((pieces (cell [])) (from (cell 0)))
    (do (doseq [i (range (str-len s))]
          (if-some [e (escape-of (zext i32 (str-byte-at s i)))]
            (do (set! pieces (conj @pieces (str-slice s @from i)))
                (set! pieces (conj @pieces e))
                (set! from (+ i 1)))
            ()))
        (str-join (conj @pieces (str-slice s @from (str-len s)))))))

(defun main () -> i64
  (let ((words (args)))
    (if (not (= (count words) 1))
        (do (eprintln "usage: gen-runtime RT-DIR > compiler/emit/runtime.fib") 2)
        (do (println ";; compiler/emit/runtime.fib: GENERATED by compiler/tests/emit/gen-runtime.fib from rt/*.lir; do not edit.")
            (println ";; The runtime module `fib.rt` (spec/compiler.md §3) as lIR text, one def per file, in the order of compile.rs:20.")
            (println ";; compiler/tests/emit/runtime.sh regenerates this file and compares it with the committed one.")
            (println "(ns emit.runtime)")
            (println "")
            (reduce (fn (status: i64 part: (Pair str str))
                      (match (read-file (str-join [(nth words 0) "/" (. part fst) ".lir"]))
                        (nil (do (eprintln (str-join ["cannot read " (. part fst) ".lir"])) 1))
                        ((some text)
                         (do (println (str-join [";; " (. part fst) ".lir"]))
                             (println (str-join ["(def " (. part snd) ": str"]))
                             (println (str-join ["\"" (literal-text text) "\")"]))
                             (println "")
                             status))))
                    0 parts)))))
