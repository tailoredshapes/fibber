;; compiler/tests/emit/macro-rest.fib: macros of no parameter, one, and fixed ones with a rest vector: the entry takes `n` arguments (the rest vector counts as one).
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defmacro nothing () Nil)

(defmacro ident (x) x)

(defmacro wrap (head ... forms) (List [head (Vec forms)]))

(defmacro many (a b c ... more) (List [a b c (Vec more)]))

(defun main () -> i64 0)
