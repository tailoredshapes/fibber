;; compiler/tests/emit/unit-value.fib: compiler/emit/value.fib (crates/fibc/src/value.rs has no
;; unit tests; each method is checked on every variant) and the integer text rule of
;; compiler/emit/text.fib: the extremes of i64 print as Rust's `{n}` does.
;; Build: fibc build compiler/tests/emit/unit-value.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-value (:use fib.test.unit emit.value)
  (:require [fib.test.run :as test-runner])
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt]))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec))
        (all [LirI1 LirI8 LirI16 LirI32 LirI64 LirFloat LirDouble LirPtr LirRaw LirDyn]))
    (do
      (is cs (= (mapv lir-ty-text all) ["i1" "i8" "i16" "i32" "i64" "float" "double" "ptr" "ptr" "{ ptr ptr }"]) "text of each type")
      (is cs (and (= (lir-ty-text LirRaw) (lir-ty-text LirPtr)) (not (= LirRaw LirPtr))) "raw and object pointers print alike and differ")
      (is cs (= (mapv lir-ty-is-int all) [true true true true true false false false false false]) "is-int")
      (is cs (= (mapv lir-ty-bits all) [1 8 16 32 64 32 64 64 64 128]) "bits")
      (is cs (and (= (v-text VUnit) "") (nil? (v-ty VUnit))) "unit has no text and no type")
      (is cs (let ((v (VVal (nx/local "t1") LirI32))) (and (= (v-text v) "t1") (= (v-ty v) (some LirI32)))) "a value has both")
      (is cs (and (= (v-text (v-null)) "(PTR NULL)") (= (v-ty (v-null)) (some LirPtr))) "NULL")
      (is cs (= (v-int LirI64 5) (VVal (nx/integer lt/ty-i64 5) LirI64)) "an int literal")
      (is cs (= (v-text (v-int LirI8 -3)) "(I8 -3)") "a negative int literal")
      (is cs (= [(v-text (v-int LirI64 9223372036854775807)) (v-text (v-int LirI64 (- (- 0 9223372036854775807) 1)))]
                ["(I64 9223372036854775807)" "(I64 -9223372036854775808)"]) "the extremes of i64")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-value" [(test-case "checks" unit-steps "compiler/tests/emit/unit-value.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
