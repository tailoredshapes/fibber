;; E4: `loop`/`recur`: variables of a scalar, an object and `unit` type, a nested loop, a recur to the outer loop from the inner.
(defun main () -> i64
  (loop ((s "a") (u ()) (n 1))
    (do (loop ((m 2) (t "x"))
          (if false (recur 3 "y") (if true 1 (recur 4 "z"))))
        (if true n (recur "b" () 2)))))
