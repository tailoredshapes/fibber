;; compiler/tests/emit/unit-program.fib: compiler/emit/{program,inits,args}.fib: the Program methods that are not layout's (the queue
;; of closures, quote names, helpers, `extern` declarations against the runtime's, the keyword helpers), the init functions of the
;; `def`s made at run time, and the words of the tool. SOURCE: every expected text is read off the Rust it replaces (program.rs:221,
;; :258, :285; inits.rs:92, :118, :146; emit_dump/args.rs tests); the whole-module judge is `fibc emit-dump` on the corpus (compare.sh).
;; Build: fibc build compiler/tests/emit/unit-program.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-program
  (:use syntax.pos syntax.form types.ty types.ast types.table types.decls types.program fib.test.unit own.program
        emit.value emit.mono emit.statics emit.program emit.inits emit.args)
  (:require [fib.test.run :as test-runner])
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt] [emit.function :as f] [lir.print :as print])
  (:require [tests.emit.normalized :as normal]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))

(defun empty-typed () -> TypedProgram
  (TypedProgram (globals-new) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) (map-empty) [] []))

(defun extern-def (name: str ty: Ty varargs: bool) -> ExternDef (ExternDef name ty varargs p0 -1 "" "" "" []))

(defun fn-ty (params: (Vec Ty) ret: Ty) -> Ty (TFn CLocal params ret))

(defun ok? (r: (Result unit str)) -> bool (match r ((Ok _) true) (_ false)))

(defun inst0 () -> Inst (Inst (BodyFun 0) [] []))

(defun parsed (words: (Vec str)) -> (Option EmitParsed) (emit-parse-args words))

(defun init-p (inits: (Vec Init)) -> Program
  (let ((typed (empty-typed)))
    (do (doseq [n ["A" "B" "C" "D" "E"]]
          (table-add (. (. typed globals) defs) (DefDef n 2 nil (Expr 0 p0 (ELit LitUnit)) false p0)))
        (let ((p (emit.program/program-new typed (owned-program-new))))
          (do (set! (. p inits) inits)
              (set! (. p def-slots)
                    (reduce (fn (m: (Map i64 DefValue) kv: (Pair i64 DefValue)) (assoc m (. kv fst) (. kv snd))) (map-empty)
                            [(Pair 0 (DefValue (some (nx/global "def.slot.0")) (some LirPtr))) (Pair 1 (DefValue (some (nx/global "def.slot.1")) (some LirI64)))
                             (Pair 2 (DefValue (some (nx/global "def.slot.2")) nil)) (Pair 3 (DefValue (some (nx/global "def.slot.3")) (some LirDouble)))
                             (Pair 4 (DefValue (some (nx/global "def.slot.4")) (some LirRaw)))]))
              p)))))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec))
        (p (emit.program/program-new (empty-typed) (owned-program-new))))
    (do
      ;; ---- quotes and helpers
      (is cs (and (= (program-fresh-quote p) "@q.1") (= (program-fresh-quote p) "@q.2")) "quote names count from 1")
      (is cs (not (program-has-helper p "str-eq")) "a helper is new once")
      (program-add-helper p "str-eq" (f/make "h" (some lt/ty-ptr) [] lt/cc-c []))
      (is cs (and (program-has-helper p "str-eq") (and (= (count @(. p funcs)) 1) (= (. (nth @(. p funcs) 0) name) "h"))) "a helper is known, and its text is a function")
      ;; ---- closures come out in the order they were asked, then the queue
      (is cs (= (program-request-closure p (inst0) "f.main" 7) "l.f.main.7") "a closure's code name")
      (program-request-closure p (inst0) "f.main" 9)
      (is cs (match (program-next-work p)
               ((some (WorkClosure _ lit name)) (and (= lit 7) (= name "l.f.main.7")
                                                     (match (program-next-work p) ((some (WorkClosure _ l2 _)) (and (= l2 9) (nil? (program-next-work p)))) (_ false))))
               (_ false)) "no body is queued: the closures come out first in order, then nothing")
      ;; ---- externs
      (is cs (ok? (program-declare-extern p (extern-def "foo" (fn-ty [(ty-i64)] (ty-unit)) false))) "a unit extern with an i64: void result")
      (is cs (do (program-declare-extern p (extern-def "foo" (fn-ty [(ty-i64)] (ty-unit)) false))
                 (program-declare-extern p (extern-def "bar" (fn-ty [(ty-i64) (ty-i64)] (ty-i64)) true))
                 (= (program-render-externs p) "(declare foo void (i64))\n(declare bar i64 (i64 i64 ...))\n")) "declared once, a vararg one with the dots")
      (is cs (do (program-declare-extern p (extern-def "malloc" (fn-ty [(ty-i64)] (TCon KStr [])) false))
                 (= (program-render-externs p) "(declare foo void (i64))\n(declare bar i64 (i64 i64 ...))\n")) "an extern the runtime declares the same way is not declared again")
      (is cs (match (program-declare-extern p (extern-def "malloc" (fn-ty [(ty-i64)] (ty-i64)) false))
               ((Err m) (= m "extern malloc conflicts with the runtime's (declare malloc ptr (i64))"))
               (_ false)) "one that disagrees is an error that names both")
      (is cs (do (program-declare-extern p (ExternDef "fc" (fn-ty [(ty-i64) (ty-i64) (ty-i64)] (ty-i64)) true p0 2 "" "" "" []))
                 (and (some? (str-find (program-render-externs p) "(declare fc i64 (i64 i64 ...))" 0))
                      (nil? (str-find (program-render-externs p) "(declare fc i64 (i64 i64 i64 ...))" 0)))) ":fixed N declares only N parameters before the dots, so the calls' further arguments are variadic ones (Apple arm64 puts them on the stack)")
      (is cs (match (program-declare-extern p (extern-def "x" (ty-i64) false)) ((Err m) (= m "an extern without a function type")) (_ false)) "an extern without a function type is an error")
      (is cs (match (program-declare-extern p (extern-def "y" (fn-ty [(ty-unit)] (ty-i64)) false)) ((Err m) (= m "a unit extern parameter")) (_ false)) "a unit parameter is an error")
      ;; ---- keyword helpers
      (is cs (= (program-render-keyword-helpers p) "") "no helpers asked for, no text")
      (let ((q (emit.program/program-new (empty-typed) (owned-program-new))))
        (do (statics-keyword (. q statics) "b")
            (statics-keyword (. q statics) "a")
            (set! (. q keyword-helpers) true)
            (let ((text (program-render-keyword-helpers q)))
              (do (is cs (= text (normal/text (str-join ["(define internal (kw.show ptr) ((i64 k))\n  (block entry (switch k bad ((i64 0) k0) ((i64 1) k1)))\n"
                                            "  (block k0 (ret (call @fib.str-copy @str.0)))\n  (block k1 (ret (call @fib.str-copy @str.2)))\n"
                                            "  (block bad (unreachable)))\n"
                                            "(define internal (kw.hash i64) ((i64 k))\n  (block entry (switch k bad ((i64 0) k0) ((i64 1) k1)))\n"
                                            "  (block k0 (ret (call @fib.str-hash @str.1)))\n  (block k1 (ret (call @fib.str-hash @str.3)))\n"
                                            "  (block bad (unreachable)))\n"
                                            "(define internal (kw.rank i64) ((i64 k))\n  (block entry (switch k bad ((i64 0) k0) ((i64 1) k1)))\n"
                                            "  (block k1 (ret (i64 0)))\n  (block k0 (ret (i64 1)))\n"
                                            "  (block bad (unreachable)))\n"]))) "kw.show, kw.hash, kw.rank over the keywords by id; ranks by name; the strings interned :k then k per keyword")
                  (is cs (= (statics-string (. q statics) ":b" 0) "@str.0") "the strings are numbered in the order of first use: :b was the first")))))
      ;; ---- the def made at run time
      (let ((ps (init-p [(Init 0 2 "d.A" true "def.slot.0") (Init 1 2 "d.B" false "def.slot.1") (Init 2 3 "d.C" false "def.slot.2") (Init 3 2 "d.D" false "def.slot.3") (Init 4 2 "d.E" false "def.slot.4")])))
        (do (is cs (= (inits-slot-text ps)
                      (normal/text (str-join ["(global internal def.slot.0 ptr (ptr null))\n" "(global internal def.slot.1 i64 (i64 0))\n"
                                 "(global internal def.slot.3 double (double 0.0))\n" "(global internal def.slot.4 ptr (ptr null))\n"]))) "slots: one global per def with a type, zero by type (a pointer null, a double 0.0, an i64 0)")
            (is cs (= (inits-render ps)
                      (normal/text (str-join ["(define internal (fib.init.m2.0 void) ()\n  (block entry (store (string \"def A: \") @fib.initdef) (let ((v0 (call @d.A))) "
                                 "(call @fib.immortalise v0) (store v0 @def.slot.0) (store (string \"def B: \") @fib.initdef) (let ((v1 (call @d.B))) "
                                 "(store v1 @def.slot.1) (ret)))))\n"
                                 "(define internal (fib.init.m3.1 void) ()\n  (block entry (store (string \"def C: \") @fib.initdef) (call @d.C) (ret)))\n"
                                 "(define internal (fib.init.m2.2 void) ()\n  (block entry (store (string \"def D: \") @fib.initdef) (let ((v0 (call @d.D))) "
                                 "(store v0 @def.slot.3) (store (string \"def E: \") @fib.initdef) (let ((v1 (call @d.E))) (store v1 @def.slot.4) (ret)))))\n"
                                 "(define internal (fib.defs-init void) ()\n  (block entry (call @fib.init.m2.0) (call @fib.init.m3.1) (call @fib.init.m2.2) "
                                 "(call @fib.init-done) (ret)))\n"]))) "init functions by maximal runs of a module, then fib.defs-init calls them in order")))
      (is cs (and (= (inits-render p) "") (= (inits-slot-text p) "")) "no inits, no text")
      ;; ---- the words of the tool
      (is cs (match (parsed ["--sections" "fns,runtime" "--fn" "f.main" "a.fib" "b.fib"])
                                       ((some r) (and (= (. r files) ["a.fib" "b.fib"]) (= (. (. r opts) sections) (some ["fns" "runtime"]))
                                                      (= (. (. r opts) fn-prefix) (some "f.main"))))
                                       (nil false)) "options then files")
      (is cs (and (some? (parsed ["--layout" "a"])) (some? (parsed ["--macro" "m" "a"]))
                  (nil? (parsed ["--layout" "--macro" "m" "a"])) (nil? (parsed ["--layout" "--sections" "main" "a"]))
                  (nil? (parsed ["--macro" "m" "--fn" "f" "a"]))) "--layout and --macro stand alone")
      (is cs (match (parsed ["--" "--layout"]) ((some r) (and (= (. r files) ["--layout"]) (not (. (. r opts) layout)))) (nil false)) "a lone -- ends the options, so a file may be named like one")
      (is cs (and (nil? (parsed [])) (nil? (parsed ["--sections" "main"])) (nil? (parsed ["--bogus" "a"])) (nil? (parsed ["--sections" "main,nope" "a"]))
                  (nil? (parsed ["--sections"])) (nil? (parsed ["--fn" "" "a"])) (nil? (parsed ["--macro"]))) "refused: no file, an unknown option, an unknown section, a missing or empty value")
      (is cs (let ((all (emit-options-default)))
               (and (emit-wants all "types") (emit-wants all "fns")
                    (match (parsed ["--fn" "f.m" "a"]) ((some r) (and (emit-wants (. r opts) "fns") (not (emit-wants (. r opts) "main")))) (nil false))
                    (match (parsed ["--sections" "main,types" "a"]) ((some r) (and (emit-wants (. r opts) "types") (not (emit-wants (. r opts) "fns")))) (nil false)))) "what is printed: all by default, the functions with --fn, the sections listed")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-program" [(test-case "checks" unit-steps "compiler/tests/emit/unit-program.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
