;; The access loop that compiler/tests/emit/windows.sh reads the lIR of: a read-modify-write of a window and its length in a loop condition.
(ns main (:use fib.view))

(defun sweep (&a: (Array f64) n: i64) -> f64
  (do (with-view [v (array-window! &a 0 n)]
        (loop ((i 0))
          (when (< i (vlen v)) (do (vset! v i (+ (vget v i) 1.5)) (recur (+ i 1))))))
      (array-get @a 0)))

(defun main () -> i64
  (let ((a (cell (array 4 0.0))))
    (if (= (sweep &a 4) 1.5) 0 1)))
