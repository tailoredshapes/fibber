;; E6: a `fn` literal's closure object (heap or stack as the plan says), its captures (a scalar, an object that is retained), and a
;; named function as a value (an immortal static closure).
(defstruct P (x: i64 y: i64))
(defun id (x: i64) -> i64 x)
(defun main () -> i64
  (let ((k 5) (p (P 1 2)) (f (fn (x: i64) -> i64 k)) (g (fn (x: i64) -> i64 (. p x))) (h id))
    (. p y)))
