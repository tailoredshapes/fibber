;; Golden source remains independent of the emitter; canonical printing ignores
;; spacing changes while retaining every operand, binding, label, and ABI type.
(ns tests.emit.normalized
  (:require [lir.parse :as parse] [lir.print :as print] [lir.diag :as diag])
  (:use lir.ast))
(defun text (source: str) -> str
  (match (parse/parse-source source)
    ((Ok ast) (print/print-module ast))
    ((Err error) (trap (str "invalid golden lIR: " (diag/diag-str error))))))
