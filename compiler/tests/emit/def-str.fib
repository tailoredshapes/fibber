;; E10: constant `def`s of type `str`: one static `@str.N` per distinct text (the same text is one constant), including the empty
;; string, a quote and a backslash, and non-ASCII text (its bytes are read from the JIT's memory).
(def plain: str "abc")
(def again: str plain)
(def empty: str "")
(def quoted: str "say \"hi\" \\ done")
(def accents: str "café ü")
(defun main () -> i64 (+ (str-len plain) (+ (str-len again) (+ (str-len empty) (+ (str-len quoted) (str-len accents))))))
