;; E6: `dyn`: the two-word value with a vtable (one slot per method, the vtable global named for protocol and type), for a struct and a
;; scalar, and an upcast of a `dyn` value through its supertrait slot.
(defprotocol Named
  (name (self) -> str))
(defprotocol Aged :requires (Named)
  (age (self) -> i64))
(defstruct Dog (n: str))
(impl Named Dog (name (self) (. self n)))
(impl Aged Dog (age (self) 3))
(defstruct Cat (lives: i64))
(impl Named Cat (name (self) "cat"))
(defun main () -> i64
  (let ((d (dyn Aged (Dog "rex"))) (e (dyn Named (Cat 9))) (f (dyn Named d)))
    0))
