;; compiler/tests/emit/macro-keywords.fib: a macro that names widths: the keyword table is the six widths then the keywords of the bodies, in the order interned (`fibm.kw.K`), and sealed.
;; Judge: compiler/tests/emit/macros.sh (fibc emit-dump --macro against the tool, byte for byte). The macro is defined and never called, so the
;; Rust expands the file and prints the module of the macro.
(defmacro half () (List [(Sym "x") (Flt 2.5 :f16) (Int 1 :i8) (Flt 0.5 :f32)]))

(defmacro third () (Int 3 :u12))

(defun main () -> i64 0)
