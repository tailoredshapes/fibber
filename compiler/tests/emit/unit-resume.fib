;; compiler/tests/emit/unit-resume.fib: the judge of compiler/emit/resume.fib (package E9r).
;; The two tests of crates/fibc/src/resume.rs (atoms_and_substitution_respect_strings_and_parens,
;; a_value_live_across_a_park_lives_in_the_frame) and five more hand-built builders, each a function a
;; lowering could have made (a park with one live value; allocas and a bare `ret`; a join `phi` fed by a
;; demoted value with a dead block; ten live names to show the order; a loop whose header `phi` names
;; `entry` and whose back edge comes from the continuation), and the two errors.
;;
;; Two modes (no word on the command line is the checks):
;;   unit-resume cases   prints `== NAME`, `frame: ..` and the text of each function (or `error: MSG`):
;;                       compiler/tests/emit/resume.sh compares it byte for byte with the same builders
;;                       through the Rust resume.rs (compiler/tests/emit/resume-oracle.rs);
;;   unit-resume         the checks: the text helpers, the errors, the frame of each case, and that lair's
;;                       whole-module checker accepts each result inside a module with its task struct, as
;;                       the Rust test does with `lir::parse_and_check`.
;; Build: fibc build compiler/tests/emit/unit-resume.fib -I compiler -I lib -L /usr/lib/llvm-21/lib -l LLVM-21 -o OUT
(ns tests.emit.unit-resume (:require [native.api :as jit] [fib.string :as s])
  (:use fib.test.unit emit.value emit.ir emit.objects emit.resume)
  (:require [fib.test.run :as test-runner])
  (:require [emit.node :as nx] [lir.ast :as la] [lir.types :as lt] [lir.rewrite :as rewrite]))

(defstruct Case (name: str f: FnBuilder prologue: i64 points: (Vec str) value: bool))

(defun cap-text () -> la/LExpr (nx/load lt/ty-i64 (nx/gep (lt/TNamed "task.t") (nx/local "env") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 10)]) nil))
(defun store-point () -> la/LExpr (nx/store (nx/integer lt/ty-i32 1) (nx/gep (lt/TNamed "task.t") (nx/local "env") [(nx/integer lt/ty-i32 0) (nx/integer lt/ty-i32 11)]) nil))
(defun park-text () -> la/LExpr (nx/call "fib.await-or-park" [(nx/local "env") (nx/null)]))
(defun env-params () -> (Vec LirParam) [(LirParam LirPtr "env")])

(defun add-text (a: la/LExpr b: la/LExpr) -> la/LExpr (nx/binary la/BAdd a b))

(defun park-1 (name: str label: str operand: str) -> Case
  (let ((f (fb-new "l.f.1" (some LirI64) (env-params) false))
        (cap (fb-val f (cap-text) LirI64))
        (x (fb-val f (add-text (v-expr cap) (nx/integer lt/ty-i64 1)) LirI64)))
    (do (fb-stmt f (store-point))
        (let ((parked (fb-val f (park-text) LirI1)))
          (do (fb-term f (nx/conditional (v-expr parked) "park2" "resume3"))
              (fb-open f "park2")
              (fb-term f (nx/ret nil))
              (fb-open f "resume3")
              (fb-term f (nx/ret (some (if (= operand "") (v-expr x) (nx/local operand)))))
              (Case name f 1 [label] true))))))

(defun allocas () -> Case
  (let ((f (fb-new "l.f.2" nil (env-params) false))
        (a (fb-entry-alloca f lt/ty-i64 24))
        (b (fb-entry-alloca f lt/ty-i64 0))
        (cap (fb-val f (cap-text) LirI64))
        (x (fb-val f (add-text (v-expr cap) (nx/integer lt/ty-i64 1)) LirI64)))
    (do (fb-stmt f (nx/store (v-expr x) a nil))
        (fb-stmt f (store-point))
        (let ((parked (fb-val f (park-text) LirI1)))
          (do (fb-term f (nx/conditional (v-expr parked) "park6" "resume7"))
              (fb-open f "park6")
              (fb-term f (nx/ret nil))
              (fb-open f "resume7")
              (fb-stmt f (nx/store (v-expr x) b nil))
              (fb-term f (nx/ret nil))
              (Case "allocas" f 1 ["resume7"] false))))))

(defun join () -> Case
  (let ((f (fb-new "l.f.3" (some LirI64) (env-params) false))
        (cap (fb-val f (cap-text) LirI64))
        (x (fb-val f (add-text (v-expr cap) (nx/integer lt/ty-i64 1)) LirI64))
        (c (fb-val f (nx/compare-int la/ISgt (v-expr x) (nx/integer lt/ty-i64 0)) LirI1)))
    (do (fb-term f (nx/conditional (v-expr c) "a" "b"))
        (fb-open f "a") (fb-term f (nx/branch "join"))
        (fb-open f "b") (fb-term f (nx/branch "join"))
        (fb-open f "join")
        (let ((p (fb-phi f LirI64 [(PhiEdge "a" (v-expr x)) (PhiEdge "b" (nx/integer lt/ty-i64 7))])))
          (do (fb-stmt f (store-point))
              (let ((parked (fb-val f (park-text) LirI1)))
                (do (fb-term f (nx/conditional (v-expr parked) "park" "resume"))
                    (fb-open f "park") (fb-term f (nx/ret nil))
                    (fb-open f "resume")
                    (let ((r (fb-val f (add-text (v-expr p) (v-expr x)) LirI64)))
                      (fb-term f (nx/ret (some (v-expr r)))))
                    (fb-open f "unreached")
                    (fb-stmt f (nx/call "fib.trap-c" []))
                    (fb-term f (nx/unreachable))
                    (Case "join" f 1 ["resume"] true))))))))

;; t1 is the capture; t2 to t11 chain on it; the continuation uses t9, t10 and t11.
(defun order () -> Case
  (let ((f (fb-new "l.f.4" (some LirI64) (env-params) false))
        (cap (fb-val f (cap-text) LirI64))
        (made (reduce (fn (acc: (Vec la/LExpr) i: i64)
                        (conj acc (v-expr (fb-val f (add-text (nth acc (- (count acc) 1)) (nx/integer lt/ty-i64 i)) LirI64))))
                      [(v-expr cap)] (range 1 11))))
    (do (fb-stmt f (store-point))
        (let ((parked (fb-val f (park-text) LirI1)))
          (do (fb-term f (nx/conditional (v-expr parked) "park" "resume"))
              (fb-open f "park") (fb-term f (nx/ret nil))
              (fb-open f "resume")
              (let ((r (fb-val f (add-text (nth made 8) (nth made 9)) LirI64))
                    (r2 (fb-val f (add-text (v-expr r) (nth made 10)) LirI64)))
                (fb-term f (nx/ret (some (v-expr r2)))))
              (Case "order" f 1 ["resume"] true))))))

;; A loop: the header `phi` comes from `entry` (it becomes `start`) and, once patched, from the
;; continuation, where the demoted counter is loaded before the branch back.
(defun looping () -> Case
  (let ((f (fb-new "l.f.5" (some LirI64) (env-params) false))
        (cap (fb-val f (cap-text) LirI64))
        (t2 (fb-val f (add-text (v-expr cap) (nx/integer lt/ty-i64 1)) LirI64)))
    (do (fb-term f (nx/branch "loop"))
        (fb-open f "loop")
        (let ((t3 (fb-phi f LirI64 [(PhiEdge "entry" (v-expr t2))]))
              (t4 (fb-val f (nx/binary la/BAdd (nx/local "t3") (nx/integer lt/ty-i64 1)) LirI64)))
          (do (fb-stmt f (store-point))
              (let ((parked (fb-val f (park-text) LirI1)))
                (do (fb-term f (nx/conditional (v-expr parked) "park" "resume"))
                    (fb-open f "park") (fb-term f (nx/ret nil))
                    (fb-open f "resume")
                    (fb-patch-phi f "loop" (nx/operand-name (v-expr t3)) "resume" (v-expr t4))
                    (let ((t6 (fb-val f (nx/compare-int la/ISlt (v-expr t4) (nx/integer lt/ty-i64 10)) LirI1)))
                      (fb-term f (nx/conditional (v-expr t6) "loop" "done")))
                    (fb-open f "done")
                    (fb-term f (nx/ret (some (v-expr t4))))
                    (Case "loop" f 1 ["resume"] true))))))))

;; Two phis of one join take demoted values (t10, then t9) from the same block: their loads go before its
;; terminator in the order the phis met them (t10 before t9), not by value.
(defun edges () -> Case
  (let ((f (fb-new "l.f.6" (some LirI64) (env-params) false))
        (cap (fb-val f (cap-text) LirI64))
        (made (reduce (fn (acc: (Vec la/LExpr) i: i64)
                        (conj acc (v-expr (fb-val f (add-text (nth acc (- (count acc) 1)) (nx/integer lt/ty-i64 i)) LirI64))))
                      [(v-expr cap)] (range 1 10)))
        (c (fb-val f (nx/compare-int la/ISgt (nth made 9) (nx/integer lt/ty-i64 0)) LirI1)))
    (do (fb-term f (nx/conditional (v-expr c) "a" "b"))
        (fb-open f "a") (fb-term f (nx/branch "join"))
        (fb-open f "b") (fb-term f (nx/branch "join"))
        (fb-open f "join")
        (let ((p1 (fb-phi f LirI64 [(PhiEdge "a" (nth made 9)) (PhiEdge "b" (nx/integer lt/ty-i64 1))]))
              (p2 (fb-phi f LirI64 [(PhiEdge "a" (nth made 8)) (PhiEdge "b" (nx/integer lt/ty-i64 2))])))
          (do (fb-stmt f (store-point))
              (let ((parked (fb-val f (park-text) LirI1)))
                (do (fb-term f (nx/conditional (v-expr parked) "park" "resume"))
                    (fb-open f "park") (fb-term f (nx/ret nil))
                    (fb-open f "resume")
                    (let ((s1 (fb-val f (add-text (v-expr p1) (v-expr p2)) LirI64))
                          (s2 (fb-val f (add-text (nth made 8) (nth made 9)) LirI64))
                          (s3 (fb-val f (add-text (v-expr s1) (v-expr s2)) LirI64)))
                      (fb-term f (nx/ret (some (v-expr s3)))))
                    (Case "edges" f 1 ["resume"] true))))))))

(defun all-cases () -> (Vec Case)
  [(park-1 "park1" "resume3" "") (allocas) (join) (order) (looping)
   (park-1 "no-continuation" "nope" "") (park-1 "unknown-type" "resume3" "t99") (edges)])

;; ---- what a case prints: the same words as resume-oracle.rs

(defun frame-word (x: FrameSlot) -> str
  (match x
    ((FrVal t) (str-join ["val:" (lir-ty-text t)]))
    ((FrBytes n) (str-join ["bytes:" (str n)]))))

(defstruct Ran (name: str frame: (Result (Vec FrameSlot) str) text: str value: bool))

(defun run-case (c: Case) -> Ran
  (let ((shape (ResumeShape "task.t" (. c prologue) (. c points) "fib.complete.t" 11))
        (frame (make-resumable (. c f) shape)))
    (Ran (. c name) frame (fb-render (. c f)) (. c value))))

(defun ran-output (r: Ran) -> str
  (match (. r frame)
    ((Ok frame) (str-join ["== " (. r name) "\nframe: " (s/join " " (mapv frame-word frame)) "\n" (. r text)]))
    ((Err e) (str-join ["== " (. r name) "\nerror: " e "\n"]))))

;; The module lair checks: the task struct (the header's ten fields, the capture, then the frame), the
;; two functions the body calls, and the function.
(defun check-module (r: Ran) -> str
  (match (. r frame)
    ((Ok frame)
     (str-join ["(defstruct task.t (i64 i32 i32 i32 i32 i32 ptr ptr ptr ptr i64 "
                (s/join " " (mapv (fn (x: FrameSlot)
                                      (match x ((FrVal t) (lir-ty-text t)) ((FrBytes n) (str-join ["[" (str n) " x i8]"]))))
                                    frame))
                "))\n(declare fib.await-or-park i1 (ptr ptr))\n(declare fib.complete.t void ("
                (if (. r value) "ptr i64" "ptr") "))\n" (. r text)]))
    ((Err _) "")))

;; ---- the checks

(defun check-text-helpers (cs: StepLog) -> unit
  (let ((expr (nx/call "t1" [(nx/string "t1 \"quoted\" (t12)\n") (nx/global "t1")
                              (nx/local "t1") (nx/local "t12") (nx/local "t1")]))
        (renamed (rewrite/substitute-locals expr {"t1" "t9"})))
    (do (is cs (= (expr-names-in expr) ["t1" "t12"]) "liveness visits local operands once in evaluation order")
        (is cs (= (expr-names-in renamed) ["t9" "t12"]) "substitution changes only the matching local operand")
        (is cs (match (. renamed kind)
                 ((la/KCall (la/CalDirect callee) arguments _)
                  (and (= callee "t1")
                       (match (. (nth arguments 0) kind) ((la/KStr bytes) (= (str-from-bytes bytes) "t1 \"quoted\" (t12)\n")) (_ false))
                       (match (. (nth arguments 1) kind) ((la/KGlobal name) (= name "t1")) (_ false))))
                 (_ false)) "escaped strings, globals and the direct callee retain their contents")
        (is cs (= (expr-names-in (nx/aggregate (mapv nx/local ["t" "t1x" "T1" "t01" "tt1" "t7"]))) ["t01" "t7"]) "only a tN local is a builder name")
        (let ((phi (nx/node (la/KPhi lt/ty-i64 [(la/LBinding "t1" (nx/local "t1") 0) (la/LBinding "loop3" (nx/integer lt/ty-i64 2) 0)]))))
          (is cs (= (nx/text (rewrite/substitute-locals phi {"t1" "t9"})) "(PHI I64 (t1 t9) (loop3 (I64 2)))") "rewriting phi values preserves predecessor labels")))))

(defun frame-of (r: Ran) -> (Vec str)
  (match (. r frame) ((Ok frame) (mapv frame-word frame)) ((Err _) [])))

(defun error-of (r: Ran) -> str
  (match (. r frame) ((Err e) e) ((Ok _) "")))

(defun check-case (cs: StepLog r: Ran) -> unit
  (let ((module (check-module r)))
    (if (= module "")
        ()
        (match (jit/check-source module)
          ((Ok _) (is cs true (str-join ["lair accepts " (. r name)])))
          ((Err e) (do (println e) (is cs false (str-join ["lair accepts " (. r name)]))))))))

(defun unit-steps () -> (Vec StepRun)
  (let ((rs (mapv run-case (all-cases))))
    (let ((cs (new-rec)))
          (do (check-text-helpers cs)
              (is cs (= (frame-of (nth rs 0)) ["val:i32" "val:i64"]) "park1 frame: the resume point and the slot of t2")
              (is cs (= (frame-of (nth rs 1)) ["val:i32" "bytes:24" "bytes:1" "val:i64"]) "allocas frame: two byte slots (a size of 0 is 1) then the value")
              (is cs (= (frame-of (nth rs 2)) ["val:i32" "val:i64" "val:i64"]) "join frame: t2 then t4")
              (is cs (= (frame-of (nth rs 3)) ["val:i32" "val:i64" "val:i64" "val:i64"]) "order frame: three values")
              (is cs (and (s/includes? (. (nth rs 3) text) "(STORE t9 s12)")
                          (s/includes? (. (nth rs 3) text) "(STORE t10 s13)")
                          (s/includes? (. (nth rs 3) text) "(STORE t11 s14)")) "order: the names a point adds go in creation order (t9 t10 t11: slots s12 s13 s14, not the text order)")
              (is cs (= (frame-of (nth rs 7)) ["val:i32" "val:i64" "val:i64" "val:i64" "val:i64"]) "edges frame: four values")
              (is cs (let ((a-block (nth (s/split (nth (s/split (. (nth rs 7) text) "  (block a\n" -1) 1) "  (block b\n" -1) 0)))
                       (< (unwrap (s/index-of a-block "(LOAD I64 s13)")) (unwrap (s/index-of a-block "(LOAD I64 s12)")))) "edges: the loads before the terminator of a go in the order the phis met them (t10 = s13 first, then t9 = s12)")
              (is cs (= (error-of (nth rs 5)) "no continuation block nope") "a missing continuation block")
              (is cs (= (error-of (nth rs 6)) "live value t99 of unknown type") "a live value that nothing binds")
              (doseq [r rs] (check-case cs r))
              (rec-steps cs)))))

(defun tests () -> Suite
  (unit-suite "emit/unit-resume" [(test-case "checks" unit-steps "compiler/tests/emit/unit-resume.fib")]))

(defun print-cases () -> i64
  (do (doseq [r (mapv run-case (all-cases))] (print-raw (ran-output r))) 0))

(defun main () -> i64
  (if (= (args) ["cases"])
      (print-cases)
      (test-runner/run-main-with [(tests)]
        (into ["--isolate" "fork" "--timeout" "300"] (vec (args))))))
