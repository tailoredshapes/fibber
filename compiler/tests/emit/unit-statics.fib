;; compiler/tests/emit/unit-statics.fib: compiler/emit/statics.fib. The two Rust tests of statics.rs
;; (a_sealed_keyword_table_answers_its_keywords_and_refuses_a_new_one, strings_are_shared_and_render_as_constants), minus the
;; re-read of the text by the lIR checker (the module is not linked to the lIR reader). Where Rust catches the panic of a
;; keyword interned after the seal, this program traps: run it with the word `late` and it must end with status 134 and the
;; message `trap: the keyword :late was interned after the keyword table was sealed` on standard error (the shell check
;; is in E2's report). The lines marked ORACLE are lines `fibc emit-dump --sections statics` printed for programs of cases/ownership
;; (106: a string, a vtable; the first 0N case with a closure of `even?`); the others are read from `Statics::render`.
;; Build: fibc build compiler/tests/emit/unit-statics.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-statics (:use fib.test.unit emit.statics)
  (:require [fib.test.run :as test-runner])
  (:require [tests.emit.normalized :as normal]))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)) (st (statics-new)))
    (do
      (is cs (= [(statics-keyword st "i8") (statics-keyword st "f16") (statics-keyword st "i8")] [0 1 0]) "keywords are numbered in first-use order, again by their id")
      (statics-seal-keywords st)
      (is cs (= [(statics-keyword st "f16") (statics-keyword st "i8")] [1 0]) "a sealed table still answers its keywords")
      (is cs (= (statics-keywords st) ["i8" "f16"]) "keywords lists them by id")
      (when (= (args) ["late"])
        (do (statics-keyword st "late") ()))
      (let ((s (statics-new)))
        (do (is cs (= [(statics-string s "hi" 0) (statics-string s "hi" 0) (statics-string s "" 0) (statics-string s "ab" 3)]
                      ["@str.0" "@str.0" "@str.1" "@str.2"]) "a string is named @str.N by first use and shared")
            (is cs (= [(statics-keyword s "a") (statics-keyword s "b") (statics-keyword s "a")] [0 1 0]) "keywords of another table are numbered from 0")
            (is cs (= [(statics-closure s "f.g.owned" 3 false) (statics-closure s "f.h" 4 false) (statics-closure s "f.g.owned" 3 false)]
                      ["@clo.0" "@clo.1" "@clo.0"]) "closures are named @clo.N by their code, shared, in order")
            (is cs (= (statics-closure-names s) ["@clo.0" "@clo.1"]) "closure-names")
            (is cs (and (= (statics-vtable s "Show.str" ["@m.Show.show.str"] false) "@vt.0")
                        (= (statics-vtable s "Show.str" ["@other"] false) "@vt.0")
                        (= (statics-vtable s "Eq.str" ["@a" "@b"] false) "@vt.1")
                        (statics-has-vtable s "Eq.str") (not (statics-has-vtable s "Show.i64"))) "vtables are named @vt.N by their name; has-vtable")
            (is cs (= (statics-render s)
                      (normal/text (str-join
                        ["(CONSTANT INTERNAL str.0 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 3 I8)) (LITERAL-STRUCT (I64 0) (I32 0) (I32 8) (I64 2) ((ARRAY 3 I8) (I8 104) (I8 105) (I8 0))))\n"
                         "(CONSTANT INTERNAL str.1 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 1 I8)) (LITERAL-STRUCT (I64 0) (I32 0) (I32 8) (I64 0) ((ARRAY 1 I8) (I8 0))))\n"
                         "(CONSTANT INTERNAL str.2 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 3 I8)) (LITERAL-STRUCT (I64 0) (I32 3) (I32 8) (I64 2) ((ARRAY 3 I8) (I8 97) (I8 98) (I8 0))))\n"
                         "(CONSTANT INTERNAL clo.0 (LITERAL-STRUCT I64 I32 I32 PTR) (LITERAL-STRUCT (I64 0) (I32 3) (I32 8) (GLOBAL f.g.owned)))\n"
                         "(CONSTANT INTERNAL clo.1 (LITERAL-STRUCT I64 I32 I32 PTR) (LITERAL-STRUCT (I64 0) (I32 4) (I32 8) (GLOBAL f.h)))\n"
                         "(CONSTANT INTERNAL vt.0 (ARRAY 1 PTR) ((ARRAY 1 PTR) (GLOBAL m.Show.show.str)))\n"
                         "(CONSTANT INTERNAL vt.1 (ARRAY 2 PTR) ((ARRAY 2 PTR) (GLOBAL a) (GLOBAL b)))\n"]))) "the constants: strings, closures, vtables")))
      (let ((s (statics-new)))
        (do (statics-string s "ab" 0)
            (is cs (= (statics-render s)
                      (normal/text "(CONSTANT INTERNAL str.0 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 3 I8)) (LITERAL-STRUCT (I64 0) (I32 0) (I32 8) (I64 2) ((ARRAY 3 I8) (I8 97) (I8 98) (I8 0))))\n")) "ORACLE: the string \"ab\" of case 106")))
      (let ((s (statics-new)))
        (do (statics-closure s "f.fib.core.num.even?.owned.i64" 6 false)
            (is cs (= (statics-render s)
                      (normal/text "(CONSTANT INTERNAL clo.0 (LITERAL-STRUCT I64 I32 I32 PTR) (LITERAL-STRUCT (I64 0) (I32 6) (I32 8) (GLOBAL f.fib.core.num.even?.owned.i64)))\n")) "ORACLE: the immortal closure of a named function")))
      (let ((s (statics-new)))
        (do (statics-vtable s "Show.Named" ["@m.fib.builtin.Show.show.Named"] false)
            (is cs (= (statics-render s) (normal/text "(CONSTANT INTERNAL vt.0 (ARRAY 1 PTR) ((ARRAY 1 PTR) (GLOBAL m.fib.builtin.Show.show.Named)))\n")) "ORACLE: a vtable of one slot")))
      (let ((s (statics-new)))
        (do (statics-string s "a\"b\\c\né" 0)
            (is cs (= (statics-render s)
                      (normal/text (str-join ["(CONSTANT INTERNAL str.0 (LITERAL-STRUCT I64 I32 I32 I64 (ARRAY 9 I8)) (LITERAL-STRUCT (I64 0) (I32 0) (I32 8) (I64 8) ((ARRAY 9 I8) "
                                 "(I8 97) (I8 34) (I8 98) (I8 92) (I8 99) (I8 10) (I8 195) (I8 169) (I8 0))))\n"]))) "the bytes of a string: a quote, a backslash, a line break, a two-byte character")))
      (let ((s (statics-new)))
        (is cs (= [(statics-closure s "f.g.owned" 3 true) (statics-closure s "l.f.h.g2.0" 4 true) (statics-closure s "f.g.owned" 3 true)
                   (statics-vtable s "Show.vt.str" ["@m.Show.show.str"] true) (statics-vtable s "Show.vt.str" [] true)]
                  ["@clo.f.g.owned" "@clo.l.f.h.g2.0" "@clo.f.g.owned" "@vt.Show.vt.str" "@vt.Show.vt.str"])
            "live mode (LE2): a closure is named @clo.CODE and a vtable @vt.NAME, the same in every program of a session"))
      (is cs (and (shared-static? "clo.f.g.owned") (shared-static? "vt.Show.vt.str") (not (shared-static? "q.3")) (not (shared-static? "str.0"))
                  (program-static? "q.3") (not (program-static? "clo.f.g.owned")))
          "closures and vtables are shared by name; a quoted form is the program's own")
      (is cs (= (statics-render (statics-new)) "") "nothing to render is empty")
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-statics" [(test-case "checks" unit-steps "compiler/tests/emit/unit-statics.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
