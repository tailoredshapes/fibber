;; E10: constant `def`s of scalar type: the value is a literal in the text of the functions that read it (no constant is made).
;; Every width and sign, a float of each width (the f32 is widened: `float_text(f64::from(x))`), a negative, the extremes.
(def n: i64 -7)
(def yes: bool true)
(def no: bool false)
(def tiny: i8 -3i8)
(def mid: i16 300i16)
(def wide: i32 -70000i32)
(def top: i64 9223372036854775807)
(def half: f64 2.5)
(def tenth: f32 0.1f32)
(def tiny-f: f64 1.5e-7)
(def letter: char \a)
(defun main () -> i64
  (+ n (if yes 1 0) (if no 1 0) (zext i64 tiny) (zext i64 mid) (zext i64 wide) top (fptosi i64 half)
     (fptosi i64 (fpext f64 tenth)) (fptosi i64 tiny-f) (zext i64 (char->i32 letter))))
