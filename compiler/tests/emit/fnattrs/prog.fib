;; compiler/tests/emit/fnattrs/prog.fib: the function attributes a defun asks for (spec/syntax.md 3.1), checked by check.sh in the lIR and
;; the LLVM IR. `plain-slow` asks for nothing: a name carries no attribute.
(defun cold-path (n: i64) :noinline :cold -> i64 (* n 3))
(defun keep-out :private (n: i64) :noinline -> i64 (+ n 1))
(defun plain-slow (n: i64) -> i64 (+ n 2))
(defun main () -> i64
  (let ((n (count (args))))
    (do (println (+ (cold-path n) (+ (keep-out n) (plain-slow n)))) 0)))
