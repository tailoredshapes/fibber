;; E5: the native methods of the float widths: the arithmetic, `fdiv`, `quot` (the quotient truncated by `trunc` or `truncf`),
;; `rem`, `neg` (an `fneg`) and the ordered comparisons, at f64 and f32.
(defun f64ops (a: f64 b: f64) -> f64
  (+ (+ (+ a b) (- a b)) (+ (* a b) (+ (fdiv a b) (+ (quot a b) (+ (rem a b) (neg a)))))))

(defun f32ops (a: f32 b: f32) -> f32
  (+ (+ (+ a b) (- a b)) (+ (* a b) (+ (fdiv a b) (+ (quot a b) (+ (rem a b) (neg a)))))))

(defun fcompare (a: f64 b: f64) -> bool
  (and (< a b) (and (<= a b) (and (> a b) (and (>= a b) (and (= a b) (!= a b)))))))

(defun main () -> i64
  (+ (fptosi i64 (f64ops 9.6 2.8))
     (+ (fptosi i64 (fpext f64 (f32ops 1.5f32 0.5f32))) (if (fcompare 1.0 2.0) 1 0))))
