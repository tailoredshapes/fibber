;; E10: a constant `def` that is a quoted form (a `Form` is an enum of strings, numbers, vectors and nested forms: the largest
;; constant graph a def makes), and a def that is a map literal (a table of buckets).
(def form: Form '(defun f (x) (+ x 1.5 "s" \c [1 2] :k)))
(def table: (Map i64 str) {1 "one" 2 "two" 3 "three"})
(defun main () -> i64 (+ (count table) 1))
