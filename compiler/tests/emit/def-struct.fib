;; E10: constant `def`s of a struct: scalar, str and nested struct fields, a unit field (it has no slot), a float field, and a second
;; def that names the first (the same constant, shared, not copied).
(defstruct Inner (a: i8 b: f32))
(defstruct Rec (id: i64 name: str inner: Inner flag: bool nothing: unit ratio: f64))
(def rec: Rec (Rec 7 "seven" (Inner 3i8 0.5f32) true () 2.25))
(def same: Rec rec)
(def lone: Inner (Inner -1i8 1.0f32))
(defun main () -> i64 (+ (. rec id) (+ (zext i64 (. (. same inner) a)) (+ (str-len (. rec name)) (zext i64 (. lone a))))))
