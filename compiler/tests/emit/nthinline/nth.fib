;; compiler/tests/emit/nthinline/nth.fib: reads a Vec through vec-nth and through the protocol's nth (check.sh). Answers 0.
(ns main (:use fib.core fib.seq fib.coll))

(defun sum-nth (v: (Vec i64)) -> i64
  (loop ((i 0) (s 0)) (if (< i (count v)) (recur (+ i 1) (+ s (nth v i))) s)))

(defun main () -> i64
  (let ((v (mapv (fn (i: i64) (* i 2)) (range 100))))
    (- (+ (sum-nth v) (vec-nth v 99)) (+ 9900 198))))
