;; E5: `&` arguments (types §8.6): the copy-in at the call (a private STACK cell per site holding the variable's retained content,
;; `fib.stack-init`), and the write-back after an ordinary call (the content into the variable, the old content released,
;; `fib.stack-end`); two `&` arguments at one site, and a plain argument beside one.
(defun bump (&v) (set! v (+ @v 1)))
(defun add (&v n: i64) (set! v (+ @v n)))
(defun swap-in (&a &b) (do (set! a (+ @a @b)) (set! b 0)))

(defun main () -> i64
  (let ((c (cell 0)) (d (cell 7)))
    (do (bump &c) (add &c 5) (swap-in &c &d)
        (+ @c @d))))
