;; E6: a global as a value: a generic function at the instantiation recorded for the expression (its immortal closure, one static for
;; each instantiation) and a named function used twice (the same static).
(defun idg (x) x)
(defun app (f: (fn (i64) i64) x: i64) -> i64 (f x))
(defun main () -> i64
  (+ (app idg 3) (app idg 4)))
