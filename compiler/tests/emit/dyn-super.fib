;; E6: the supertrait closure of a `dyn` vtable: depth first, each protocol once (a diamond: A requires B and C, both require D), the
;; vtable of each after A's own slots, and upcasts through the slot of a middle protocol and of the far one (n + position).
(defprotocol D (d (self) -> i64))
(defprotocol B :requires (D) (b (self) -> i64))
(defprotocol C :requires (D) (c (self) -> i64))
(defprotocol A :requires (B C) (a (self) -> i64))
(defstruct S (n: i64))
(impl D S (d (self) 1))
(impl B S (b (self) 2))
(impl C S (c (self) 3))
(impl A S (a (self) 4))
(defun main () -> i64
  (let ((x (dyn A (S 1))) (y (dyn C x)) (z (dyn D x)) (w (dyn D y)))
    0))
