;; compiler/tests/emit/unit-mono.fib: compiler/emit/mono.fib. The two Rust tests of mono.rs (classes_and_representatives,
;; a_raw_ptr_is_a_scalar_class_of_its_own) on a hand-built Globals, and what the Rust has no test for (marked SOURCE: read
;; from mono.rs): `bounded` and `fun_key` over bounds, the queue (a name once, first in first out, nothing queued twice) and
;; the overflow rule, MAX_TYPE_DEPTH 64 and MAX_TYPE_SIZE 1000, at and one past each limit, with what a message calls a
;; function, a def and a method. The classes and representatives of every ground type of 1,100 programs are judged by the
;; tool's `--layout` (columns `class` and `repr`, compare.sh, E2's report).
;; Build: fibc build compiler/tests/emit/unit-mono.fib -I compiler -I lib -o OUT
(ns tests.emit.unit-mono (:use syntax.pos types.ty types.scheme types.table types.ast types.decls fib.test.unit own.program
               emit.value emit.names emit.layout emit.mono)
  (:require [fib.test.run :as test-runner]))

(def p0: Pos (Pos "t.fib" 1 1 0 1))
(def unit-expr: Expr (Expr 0 p0 (ELit LitUnit)))

(defun nom (id: i64 args: (Vec Ty)) -> Ty (TCon (KNominal id) args))

;; modules 0 fib.builtin, 1 fib.prelude, 2 main; types 0 Option (none, some), 1 Pt (struct x y), 2 Box (struct v), 3 Color
;; (fieldless enum); protos 0 Sz (main: sz); instances 0 (Sz Pt); funs 0 tw, 1 pr (main); defs 0 K (main)
(defun globals () -> Globals
  (let ((g (globals-new)))
    (do (doseq [ns ["fib.builtin" "fib.prelude" "main"]] (g-add-module g ns (Links [] [] []) (map-empty)))
        (table-add (. g types)
          (TypeDef "Option" 1 ["a"] []
            (TsEnum [(VariantDef "none" []) (VariantDef "some" [(FieldDef "v" (TGen 0))])]) p0))
        (table-add (. g types) (TypeDef "Pt" 2 [] [] (TsStruct [(FieldDef "x" (ty-i64)) (FieldDef "y" (ty-str))]) p0))
        (table-add (. g types) (TypeDef "Box" 2 ["a"] [] (TsStruct [(FieldDef "v" (TGen 0))]) p0))
        (table-add (. g types) (TypeDef "Color" 2 [] [] (TsEnum [(VariantDef "Red" []) (VariantDef "Green" [])]) p0))
        (table-add (. g protos)
          (ProtoDef "Sz" 2 [] [(MethodDef "sz" [(MethodParam "self" false false)] (scheme-mono (ty-i64)) false nil p0)] [] p0))
        (table-add (. g instances)
          (InstanceDef 0 (KNominal 1) 2 [] (nom 1 []) [] [] [(ImplMethod 0 [] nil unit-expr p0)] p0))
        (table-add (. g funs) (FunDef "tw" 2 [] nil [] unit-expr false p0))
        (table-add (. g funs) (FunDef "pr" 2 [] nil [] unit-expr false p0))
        (table-add (. g defs) (DefDef "K" 2 nil unit-expr false p0))
        (set! (. g option) 0)
        g)))

(defun opt (t: Ty) -> Ty (nom 0 [t]))

;; The scheme of `twin (x: a y: b) -> a`: two variables and the given predicates.
(defun twin (preds: (Vec Pred)) -> Scheme
  (Scheme 2 0 ["a" "b"] preds [] (TFn CLocal [(TGen 0) (TGen 1)] (TGen 0)) [false false] ["x" "y"]))

(defun word (c: RepClass) -> str
  (match c ((ClsScalar t) (match t ((LirRaw) "raw") (_ (lir-ty-text t)))) ((ClsPtr) "ptr") ((ClsOpt) "opt") ((ClsBoxed) "boxed") ((ClsDyn) "dyn") ((ClsUnit) "unit")))

(defun class-word (g: Globals t: Ty) -> str
  (match (class-of g t) ((Ok c) (word c)) ((Err _) "err")))

(defun key-text (g: Globals s: Scheme tys: (Vec Ty)) -> (Vec str)
  (match (fun-key g s tys) ((Ok k) (mapv (fn (t: Ty) (mangle g t)) k)) ((Err e) [e])))

;; (Box (Box .. i64)) with k boxes: depth k + 1.
(defun chain (k: i64) -> Ty
  (loop ((i 0) (t (ty-i64)))
    (if (< i k) (recur (+ i 1) (nom 2 [t])) t)))

;; A type of n arguments (n + 1 nodes, depth 2).
(defun wide (n: i64) -> Ty
  (nom 2 (mapv (fn (i: i64) (ty-i64)) (range n))))

;; Every instance still queued, in order.
(defun drain (q: Queue) -> (Vec Inst)
  (loop ((out []))
    (match (queue-pop q) ((some i) (recur (conj out i))) (nil out))))

(defun request (q: Queue g: Globals key: BodyKey tys: (Vec Ty)) -> str
  (queue-request q g (Inst key tys [])))

(defun unit-steps () -> (Vec StepRun)
  (let ((cs (new-rec)) (g (globals)))
    (do
      (is cs (= (mapv (fn (t: Ty) (class-word g t))
                      [(ty-str) (opt (ty-str)) (opt (opt (ty-str))) (opt (ty-i64)) (ty-i64) (ty-unit)
                       (TFn CLocal [] (ty-unit)) (ty-scalar SPtr) (TCon (KDyn 0 false) []) (nom 3 []) (nom 1 [])])
                ["ptr" "opt" "boxed" "{ i1 i64 }" "i64" "unit" "ptr" "raw" "dyn" "i32" "ptr"]) "classes: str, Option str, Option (Option str), Option i64 (a pair held by value, lever A), i64, unit, fn, raw ptr, dyn, a fieldless enum, a struct")
      (is cs (= (class-word g (TVar 0)) "err") "a type variable has no class")
      (is cs (and (= (representative g ClsBoxed) (opt (opt (ty-i64)))) (= (representative g ClsOpt) (opt (ty-str)))) "the representative of Boxed is Option (Option i64) (an Option i64 is a value now), of Opt Option str")
      (is cs (= (mapv (fn (c: RepClass) (mangle g (representative g c)))
                       [(ClsScalar LirI1) (ClsScalar LirI8) (ClsScalar LirI16) (ClsScalar LirI32) (ClsScalar LirI64)
                        (ClsScalar LirFloat) (ClsScalar LirDouble) (ClsScalar LirRaw) ClsUnit ClsPtr ClsDyn])
                ["bool" "i8" "i16" "i32" "i64" "f32" "f64" "ptr" "unit" "str" "$dyn.Sz_"]) "representatives of every class")
      (is cs (every? (fn (t: Ty)
                       (match (class-of g t)
                         ((Err _) false)
                         ((Ok c)
                          (and (= (class-of g (representative g c)) (Ok c))
                               (= (class-of g (opt t)) (class-of g (opt (representative g c))))))))
                     [(ty-str) (opt (ty-str)) (opt (opt (ty-str))) (opt (ty-i64)) (ty-i64) (ty-bool) (ty-unit)]) "the representative of a class is in that class, and an Option of it is in the class of an Option of the member")
      (is cs (and (= (class-of g (ty-scalar SPtr)) (Ok (ClsScalar LirRaw)))
                  (= (representative g (ClsScalar LirRaw)) (ty-scalar SPtr))
                  (not (= (class-of g (ty-scalar SPtr)) (class-of g (ty-str))))) "a raw ptr is a scalar class of its own: not str's")
      (is cs (= (inst-subst (Inst (BodyFun 0) [(ty-bool) (ty-str)] []) (TFn CLocal [(TGen 1)] (opt (TGen 0))))
                (TFn CLocal [(ty-str)] (opt (ty-bool)))) "inst-subst replaces the quantified variables")
      ;; SOURCE: bounded and fun_key
      (let ((plain (twin [])) (proto (twin [(PProto 0 [(TGen 0)])])) (deep (twin [(PProto 0 [(nom 2 [(TFn CLocal [(TGen 1)] (ty-unit))])])]))
            (send (twin [(PSend (TGen 1))])))
        (do (is cs (= [(bounded plain 0) (bounded plain 1) (bounded send 1)] [false false false]) "no bound: nothing is bounded")
            (is cs (= [(bounded proto 0) (bounded proto 1) (bounded deep 0) (bounded deep 1)] [true false false true]) "a protocol bound on a variable bounds it, and a variable inside a constraint's type")
            (is cs (= (key-text g plain [(nom 1 []) (ty-bool)]) ["str" "bool"]) "fun-key: the representative of each class without bounds")
            (is cs (= (key-text g plain [(nom 2 [(ty-i64)]) (opt (ty-i64))]) ["str" "$fib.prelude/Option.i64_"]) "fun-key: an object is str, a boxed Option is Option i64")
            (is cs (= (key-text g proto [(nom 1 []) (nom 1 [])]) ["Pt" "str"]) "fun-key: a bounded variable keeps its full type")
            (is cs (and (= (key-text g plain [(ty-scalar SPtr) (ty-bool)]) ["ptr" "bool"])
                        (not (= (key-text g plain [(ty-scalar SPtr) (ty-bool)]) (key-text g plain [(ty-str) (ty-bool)])))) "fun-key: a raw ptr keeps its class, and is not str")
            (is cs (= (mapv (fn (s: str) (str-slice s 0 6)) (key-text g plain [(ty-bool) (TVar 0)])) ["a type"]) "fun-key: a type variable is refused, with the layout's message")))
      ;; SOURCE: the queue
      (let ((q (queue-new)) (key (BodyFun 0)))
        (do (is cs (and (nil? (queue-pop q)) (nil? (queue-overflow q))) "an empty queue pops nothing and has no overflow")
            (let ((a (request q g key [(ty-str) (ty-bool)])) (b (request q g key [(ty-str) (ty-bool)]))
                  (c (request q g (BodyFun 1) [(ty-i64)])) (d (request q g (BodyDef 0) [])))
              (do (is cs (and (= a "f.tw.str.bool") (= a b)) "a specialisation is named once")
                  (is cs (= [c d] ["f.pr.i64" "d.K"]) "the names of a function, another function, a def")
                  (is cs (= (mapv (fn (i: Inst) (body-name g (. i key) (. i tys))) (drain q))
                            ["f.tw.str.bool" "f.pr.i64" "d.K"]) "first in first out, each once")))
            (is cs (= (request q g key [(ty-i64) (ty-bool)]) "f.tw.i64.bool") "a body at the same key and other types is another specialisation")))
      ;; SOURCE: the overflow rule
      (let ((q (queue-new)))
        (do (is cs (and (not (= (request q g (BodyFun 0) [(chain 63)]) "@overflow")) (nil? (queue-overflow q))) "depth 64 (63 boxes over an i64) is queued, not an overflow")
            (is cs (and (not (= (request q g (BodyFun 0) [(wide 999)]) "@overflow")) (nil? (queue-overflow q))) "size 1000 (999 arguments) is queued too")
            (is cs (not (= (request q g (BodyFun 0) [(TFn CLocal [(ty-i64)] (ty-i64))]) "@overflow")) "a function type counts its parameters and result")
            (is cs (and (= (request q g (BodyFun 1) [(chain 64)]) "@overflow") (= (queue-overflow q) (some "pr"))) "depth 65 overflows: not queued, @overflow, and what it was is kept")
            (is cs (and (= (request q g (BodyDef 0) [(ty-i64)]) "@overflow") (= (queue-overflow q) (some "pr"))) "after an overflow every request is @overflow, the first message stays")
            (is cs (not (nil? (queue-pop q))) "what was queued before is still to pop")))
      (let ((q (queue-new)))
        (do (is cs (and (= (request q g (BodyDef 0) [(wide 1000)]) "@overflow") (= (queue-overflow q) (some "K"))) "size 1001 overflows")
            (is cs (nil? (queue-pop q)) "nothing was queued")))
      (let ((q (queue-new)))
        (do (is cs (= (request q g (BodyMethod 0 0) [(ty-i64) (chain 64)]) "@overflow") "an overflow in the second type of a key counts")
            (is cs (= (queue-overflow q) (some "the method sz of Sz")) "a method is described by its name and its protocol's")))
      (let ((q (queue-new)))
        (do (request q g (BodyMethodOwned 0 0) [(chain 64)])
            (is cs (= (queue-overflow q) (some "the method sz of Sz")) "an owned method too")))
      (let ((q (queue-new)))
        (do (request q g (BodyAllOwned 1) [(chain 64)])
            (is cs (= (queue-overflow q) (some "pr")) "an all-owned body is described by its function")))
      (rec-steps cs))))

(defun tests () -> Suite
  (unit-suite "emit/unit-mono" [(test-case "checks" unit-steps "compiler/tests/emit/unit-mono.fib")]))

(defun main () -> i64
  (test-runner/run-main-with [(tests)]
    (into ["--isolate" "fork" "--timeout" "300"] (vec (args)))))
