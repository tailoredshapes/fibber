;; E5: tail calls: a self call and a mutual call in tail position (`tailcall`, the releases before the jump), a tail call to an
;; extern and to a native method (an ordinary call, then `ret`), a tail call with a `unit` result, and a non-tail call whose
;; result is used.
(extern abs (i32) -> i32)

(defun sum (n: i64 acc: i64) -> i64 (if (= n 0) acc (sum (- n 1) (+ acc n))))

(defun ping (n: i64) -> i64 (if (= n 0) 0 (pong (- n 1))))
(defun pong (n: i64) -> i64 (if (= n 0) 1 (ping (- n 1))))

(defun tail-extern (n: i32) -> i32 (unsafe (abs n)))
(defun tail-native (a: i64 b: i64) -> i64 (+ a b))
(defun tail-unit (u: unit) -> unit (tail-unit2 u))
(defun tail-unit2 (u: unit) -> unit u)

(defun main () -> i64
  (do (tail-unit ())
      (+ (sum 10 0) (+ (ping 7) (+ (sext i64 (tail-extern -4i32)) (tail-native 1 2))))))
