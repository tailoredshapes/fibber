;; E4: `if` with branches that fall through, jump (`recur`) or both, nested; the join block's phi, and none when no branch falls through.
(defun main () -> i64
  (loop ((i 0) (acc 1))
    (if true
        (if false (recur 2 3) (do 4 acc))
        (if true 5 (recur 1 acc)))))

(defun both (b: bool) -> str
  (if b "yes" "no"))

(defun unit-if (b: bool) -> unit
  (if b () ()))
