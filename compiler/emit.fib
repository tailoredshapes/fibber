;; compiler/emit.fib: the lIR emitter's tool, as `fibc emit-dump` will be (plan E0, E3; the plan is scratchpad
;; m6/emit-plan.md section 1.2). THIS IS THE SKELETON of package E1, not the tool: it links every module of
;; compiler/emit/ (so `fibc build compiler/emit.fib` proves they all compile, the stubs of E2..E12 included)
;; and, run on any words, says it is pending and exits 70, which a harness counts as pending, never as a
;; pass (CLAUDE.md). E3 replaces `main` with the options of emit-dump (`--sections`, `--layout`, `--fn`,
;; `--macro`) and a stub reached prints `todo: PACKAGE NAME` and exits 70 the same way.
;; The modules are in dependency order.
(ns main
  (:use emit.value emit.text emit.ir emit.names emit.layout emit.mono emit.objects emit.statics
        emit.program emit.compile emit.lower.cx emit.lower.mod emit.lower.ops emit.lower.ctrl
        emit.lower.values emit.lower.call emit.lower.arith emit.lower.objects emit.lower.cells
        emit.lower.dynamic emit.lower.pattern emit.lower.show emit.lower.strfind emit.lower.quote
        emit.lower.builtins emit.lower.threads emit.resume emit.defs.mod emit.macros.abi))

(defun main () -> i64
  (do (eprintln "emit: pending: the skeleton of package E1 only (compiler/emit.fib); the tool is E3")
      70))
