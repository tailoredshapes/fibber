;; compiler/own/objects.fib: which types are objects (spec/types.md §1) and how an `Option` is
;; represented (§8.1), as crates/fibref/src/own/objects.rs (83 lines of Rust). A scalar or a
;; field-less enum is not an object; a quantified variable is treated as one, which is safe.
;;
;; Shapes: `OptionRep` carries the prefix `Or`; `Option<OptionRep>` is `(Option OptionRep)`; the
;; global `option` is a Cell in the fibber tables (types.decls), so it is read with `@`.
(ns own.objects
  (:use types.ty types.decls))

;; How values of an `(Option T)` type are represented, which decides whether its `some` and
;; `nil` allocate: a nullable pointer (T an object that is not itself an `Option`), a heap enum
;; object (T a scalar, a `dyn` or an `Option`), or decided at run time by the payload (T a
;; quantified variable of a generic body).
(defenum OptionRep OrPointer OrHeapEnum OrGeneric)
(derive Eq OptionRep)

;; Whether values of t are objects (counted, §1.2).
(defun is-object (g: Globals t: Ty) -> bool
  (match t
    ((TCon (KScalar _) _) false)
    ((TCon (KNominal id) _) (not (typedef-is-fieldless-enum (g-ty g id))))
    (_ true)))

;; The representation of t if it is an `(Option T)` type.
(defun option-rep (g: Globals t: Ty) -> (Option OptionRep)
  (match t
    ((TCon (KNominal id) args)
     (if (and (= id @(. g option)) (> (count args) 0))
         (some (match (nth args 0)
                 ((TGen _) OrGeneric)
                 ((TVar _) OrGeneric)
                 ((TRigid _) OrGeneric)
                 ((TCon (KDyn _ _) _) OrHeapEnum)
                 ((TCon (KNominal p) _) (if (or (= p @(. g option)) (not (is-object g (nth args 0))))
                                          OrHeapEnum
                                          OrPointer))
                 (payload (if (is-object g payload) OrPointer OrHeapEnum))))
         nil))
    (_ nil)))
