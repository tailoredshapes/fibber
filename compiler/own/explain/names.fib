;; compiler/own/explain/names.fib: the text of expressions, sites, operations, passes and tails
;; in the §9 explanation, as crates/fibref/src/own/explain/names.rs (145 lines of Rust). Package
;; O8. The names carry the prefix `names-` (a function's name is global): `index` is
;; `names-index`, and so on.
;;
;; Shapes decided where Rust and fibber differ:
;; - a string literal prints as Rust's `{:?}`: the quote, `\\`, `\n`, `\r`, `\t`, `\0` and the
;;   control characters (C0 and C1) as `\u{hex}` in lower case; every other character as it is
;;   (Rust also escapes the unassigned and the format characters; no case has one).
;; - `why` is `names-why` and `because` is `names-because`: both are public here, as the unit
;;   tests of the printer name them.
(ns own.explain.names
  (:use types.ast types.decls types.table types.program own.program own.syntactic))

;; Rust: explain/names.rs:12 `index`: every expression of a body by id, nested literals included.
(defun names-index (body: Expr) -> (Map i64 Expr)
  (index-from (map-empty) body))

;; The expressions of e (e, then those inside it, pre-order) added to acc by id.
(defun index-from :private (acc: (Map i64 Expr) e: Expr) -> (Map i64 Expr)
  (reduce (fn (a: (Map i64 Expr) c: Expr) (index-from a c)) (assoc acc (. e id) e) (children-of e)))

;; Rust: explain/names.rs:25 `at`: `@line:col`.
(defun names-at (e: Expr) -> str
  (str-join ["@" (show (. (. e pos) line)) ":" (show (. (. e pos) col))]))

;; `\u{hex}`, in lower case, as Rust's `{:?}` writes a control character.
(defun unicode-escape :private (n: i64) -> str
  (let ((digits "0123456789abcdef"))
    (loop ((rest n) (acc ""))
      (let ((acc2 (str-concat (str-slice digits (bit-and rest 15) (+ (bit-and rest 15) 1)) acc)))
        (if (< rest 16)
            (str-join ["\\u{" acc2 "}"])
            (recur (shr rest 4) acc2))))))

;; One character of a string as `{:?}` writes it.
(defun debug-char :private (c: char) -> str
  (let ((n (zext i64 (char->i32 c))))
    (match c
      (\" "\\\"")
      (\\ "\\\\")
      (\newline "\\n")
      (\return "\\r")
      (\tab "\\t")
      (_ (cond (= n 0) "\\0"
               (or (< n 32) (and (>= n 127) (< n 160))) (unicode-escape n)
               :else (char->str c))))))

;; A string as Rust's `{:?}` writes it.
(defun debug-str :private (s: str) -> str
  (str-join ["\"" (str-join (mapv debug-char (str-chars s))) "\""]))

;; Rust: explain/names.rs:30 `show`: `@line:col`, and a short rendering of an expression.
(defun names-show (p: TypedProgram e: Expr) -> str
  (let ((g (. p globals)))
    (match (. e kind)
      ((ELocal b) (. (g-binding g b) name))
      ((EGlobal (GDef d)) (. (g-def g d) name))
      ((EGlobal (GFun f)) (. (g-fun g f) name))
      ((ELit (LitStr s)) (debug-str s))
      ((ELit (LitInt n _)) (show n))
      ((ELit (LitBool b)) (show b))
      ((EGlobal _) (head-name g e))
      ((EDeref (PlAmp b) _) (str-concat "@" (. (g-binding g b) name)))
      ((EDeref (PlExpr x) _) (str-concat "@" (names-show p x)))
      ((EField x f _) (str-join ["(. " (names-show p x) " " f ")"]))
      ((ECall h args)
       (let ((head (match (. h kind)
                     ((EGlobal _) (head-name g h))
                     ((ELocal _) (head-name g h))
                     (_ (names-show p h)))))
         (str-join ["(" head (if (empty? args) "" " ..") ")"])))
      ((EFn _) (str-join ["<closure " (names-at e) ">"]))
      ((EAsync _ _) (str-join ["<async " (names-at e) ">"]))
      (_ (str-join ["<expr " (names-at e) ">"])))))

;; Rust: explain/names.rs:65 `site`: a site's name, given the index of the body.
(defun names-site (p: TypedProgram ix: (Map i64 Expr) s: Site) -> str
  (let ((g (. p globals)))
    (match s
      ((SiteBind b) (. (g-binding g b) name))
      ((SiteValue e) (if-some [x (get ix e)] (names-show p x) (str-join ["<value " (show e) ">"])))
      ((SiteCapture _ b) (. (g-binding g b) name))
      ((SiteEnv l) (if-some [x (get ix l)] (str-concat "env of " (names-show p x)) "env"))
      ((SiteGlobal d) (. (g-def g d) name)))))

;; Rust: explain/names.rs:81 `op`: `retain [x] (join)`.
(defun names-op (p: TypedProgram ix: (Map i64 Expr) o: Op) -> str
  (str-join [(match (. o kind) ((OpRetain) "retain") ((OpRelease) "release") ((OpEndStack) "end-stack"))
             " [" (names-site p ix (. o site)) "] (" (names-why (. o why)) ")"]))

;; Rust: explain/names.rs:93 `why`: the words of an operation's reason.
(defun names-why (w: Why) -> str
  (match w
    ((WhyReturn) "return") ((WhyStore) "store") ((WhyJoin) "join") ((WhyScopeExit) "exit")
    ((WhyStepEnd) "step end") ((WhyDerivedExit) "derived exit") ((WhyDiscard) "discard")
    ((WhyParamExit) "exit") ((WhyLoopInit) "loop init") ((WhyJump) "jump")
    ((WhyRecurOld) "old loop value")))

;; Rust: explain/names.rs:107 `pass`: how an argument is handed over.
(defun names-pass (x: Pass) -> str
  (match x
    ((PsScalar) "scalar") ((PsBorrow) "borrow") ((PsMove) "moved") ((PsRetain) "retain")
    ((PsAcquire) "acquire") ((PsForward) "forward") ((PsOwnCell) "own cell") ((PsAlias) "alias")
    ((PsKeepEnv) "env kept") ((PsSteal) "stolen") ((PsMoveIn) "move in")))

;; Rust: explain/names.rs:122 `tail`: `tail-call`, or `call` with the rule that made it ordinary.
(defun names-tail (p: TypedProgram t: Tail callee: Callee) -> str
  (match t
    ((TlTailCall) "tail-call")
    ((TlNotInTail) (match callee ((CalCtor) "construct") (_ "call")))
    ((TlOrdinary b) (str-join ["call (" (names-because p b) ")"]))))

;; Rust: explain/names.rs:131 `because`: the rule of §6.10 that made a call in tail position ordinary.
(defun names-because (p: TypedProgram b: Because) -> str
  (match b
    ((BcAmpArgument) "b: & argument")
    ((BcAmpCaptured param)
     (str-join ["b: &" (. (g-binding (. p globals) param) name) " captured by an argument"]))
    ((BcFrameOwned arg)
     (str-join ["e: frame-owned argument " (show (+ arg 1)) " at a borrowed position"]))
    ((BcAsyncBody) "f: async body")
    ((BcExtern) "extern")
    ((BcStore) "a store, not a call")))
