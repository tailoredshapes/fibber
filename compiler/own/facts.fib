;; compiler/own/facts.fib: the functions on a unit's facts (spec/types.md §6.4, §6.5), as
;; crates/fibref/src/own/facts.rs (214 lines of Rust). The data, `Facts`, is in own.program.
;; Package O6. Facts is a value, not a Cell: every step takes the facts and returns the facts
;; with what it found added (`with`), `facts-absorb` is pure, and the fixpoint compares the new
;; facts with the old (Rust: `let before = self.clone(); ..; *self != before`). Facts only grow,
;; so "the facts are not equal" is "something changed" and `propagate` needs no flag either.
;;
;; Ordered iteration: Rust's `edges` is a BTreeSet; `propagate` walks it sorted, once per pass,
;; and an escape or a loop fact found by one edge is seen by the next edge of the same pass.
(ns own.facts
  (:use types.ast types.decls types.program own.program own.objects own.classify own.walk.state))

;; The description of a rule-1 or escape position.
(defun describe :private (at: At) -> (Option str)
  (match at
    ((AtReturn) (some "returned"))
    ((AtStore) (some "stored"))
    ((AtThread) (some "spawned"))
    ((AtJoin) (some "join retain"))
    ((AtRawRetained) (some "raw-retained"))
    ((AtCapture _ heap) :when heap (some "captured by a heap closure"))
    (_ nil)))

;; Rust: facts.rs:55 `Facts::new`: the facts of a unit whose members' inferred parameters are
;; `inferred`; `preset` are owned from the start (`OwDeclared`).
(defun facts-new (members: (Map i64 (Vec i64)) inferred: (Set i64) preset: (Vec i64)) -> Facts
  (with (facts-empty)
    (members members)
    (inferred inferred)
    (owned (reduce (fn (m: (Map i64 (Set OwnedWhy)) b: i64)
                     (assoc m b (conj (get m b (set-empty)) OwDeclared)))
                   (map-empty) preset))))

;; Rust: facts.rs:72 `Facts::summary`: the summary of the `defun` f under these facts: per
;; parameter (owned, escapes); an `&` parameter and one that is not an object are (false, false),
;; and a declared `:borrow` takes the escape away.
(defun facts-summary (f: Facts p: TypedProgram fun: i64) -> Summary
  (Summary
    (mapv (fn (d: ParamDecl)
            (let ((b (. d binding))
                  (obj (and (not (. d amp))
                            (match (get (. p binding-types) b)
                              ((some t) (is-object (. p globals) t))
                              (_ true)))))
              (if obj
                  (Pair (contains? (. f owned) b) (and (contains? (. f escapes) b) (not (. d borrow))))
                  (Pair false false))))
          (. (g-fun (. p globals) fun) params))))

;; `b` is owned for `why`, if this fixpoint infers its kind.
(defun own-why :private (f: Facts b: i64 why: OwnedWhy) -> Facts
  (if (contains? (. f inferred) b)
      (with f (owned (assoc (. f owned) b (conj (get (. f owned) b (set-empty)) why))))
      f))

;; Rule 4 (not in the Rust): `b`, a borrowed parameter of a `defun` that this fixpoint infers and that is not declared `:borrow`,
;; is owned because a field of the shell it names is consumed at its last use and nothing reads the shell afterwards: the
;; consume can then steal (own.unit `decide`, own.lastuse). Owning costs the callers that use their argument again one
;; retain; it saves the count the field would have (a unique shell hands its field over).
(defun facts-want-owned (f: Facts b: i64) -> Facts
  (own-why f b (OwSteal "rule 4: a field of its shell is consumed at its last use")))

;; `b` escapes; the first reason stays.
(defun escape :private (f: Facts b: i64 why: str) -> Facts
  (if (contains? (. f escapes) b) f (with f (escapes (assoc (. f escapes) b why)))))

(defun add-loop-rule1 :private (f: Facts b: i64) -> Facts
  (with f (loop-rule1 (conj (. f loop-rule1) b))))

(defun add-edge :private (f: Facts from: i64 var: i64) -> Facts
  (with f (edges (conj (. f edges) (Pair from var)))))

;; What a use of the parameter or loop variable `b` at `at` says (rules 1 and 2, the escapes,
;; the edges to the loop variables it is consumed into).
(defun at-facts :private (f: Facts b: i64 is-loop: bool at: At) -> Facts
  (if-some [what (describe at)]
    (let ((f2 (escape f b what)))
      (if is-loop (add-loop-rule1 f2 b) (own-why f2 b (OwRule1 what))))
    (match at
      ((AtMoveOut) :when is-loop (add-loop-rule1 (escape f b "the loop's value") b))
      ((AtWeak) (escape f b "operand of weak"))
      ((AtArg a)
       (let ((f2 (if (or (. a escapes) (. a closure-value))
                     (escape f b "passed to an escaping parameter")
                     f)))
         (if (and (. a tail-site) (not (= (. a class) ClBorrow)))
             (own-why f2 b (OwRule2 (str-join ["argument " (show (+ (. a index) 1)) " of a tail site"])))
             f2)))
      ((AtHead h) :when (and (. h tail-site) (not (. h self-tail)))
       (own-why f b (OwRule2 "called at a tail site")))
      ((AtLoopInit var) (add-edge f b var))
      ((AtRecur var) (add-edge f b var))
      (_ f))))

;; Rust: facts.rs:129 `binding_event`: only a parameter or a loop variable has facts.
(defun binding-event :private (f: Facts p: TypedProgram b: i64 at: At) -> Facts
  (let ((kind (. (g-binding (. p globals) b) kind)))
    (if (or (= kind BkParam) (= kind BkLoop))
        (at-facts f b (= kind BkLoop) at)
        f)))

;; Rule 3: a tail call from a member of the SCC passes a frame-owned argument at a parameter of a
;; member.
(defun rule3 :private (f: Facts ev: Event) -> Facts
  (match (. ev at)
    ((AtArg a)
     (match (. a scc-callee)
       ((some g) :when (and (. a tail-site) (. a frame-owned))
        (match (get (get (. f members) g []) (. a index))
          ((some b) (own-why f b (OwRule3 "a tail call in the SCC passes a frame-owned argument")))
          (_ f)))
       (_ f)))
    (_ f)))

(defun event-facts :private (f: Facts p: TypedProgram ev: Event) -> Facts
  (rule3 (match (. ev val)
           ((VB (SiteBind b)) (binding-event f p b (. ev at)))
           (_ f))
         ev))

(defun binding-name :private (p: TypedProgram b: i64) -> str
  (. (g-binding (. p globals) b) name))

;; What the edge (b, v), "b was consumed into loop variable v", implies: v's escape and its
;; rule-1 fact flow back to b.
(defun propagate-edge :private (f: Facts p: TypedProgram e: (Pair i64 i64)) -> Facts
  (let ((b (. e fst))
        (v (. e snd))
        (f1 (match (get (. f escapes) v)
              ((some why) (escape f b (str-join ["through loop variable " (binding-name p v) ": " why])))
              (_ f))))
    (if (not (contains? (. f1 loop-rule1) v))
        f1
        (if (= (. (g-binding (. p globals) b) kind) BkLoop)
            (add-loop-rule1 f1 b)
            (own-why f1 b (OwLoop (str-join ["through loop variable " (binding-name p v)])))))))

;; Follows values through the loop variables they were consumed into, to a fixpoint.
(defun propagate :private (f: Facts p: TypedProgram) -> Facts
  (let ((edges (vec (sort (vec (. f edges))))))
    (loop ((cur f))
      (let ((next (reduce (fn (g: Facts e: (Pair i64 i64)) (propagate-edge g p e)) cur edges)))
        (if (= next cur) cur (recur next))))))

;; Rust: facts.rs:95 `Facts::absorb`: the facts with what one walk's events imply added (Rust
;; returns whether anything changed: compare the two values). The first escaping reason of a
;; closure literal stays; a heap reason is replaced.
(defun facts-absorb (f: Facts p: TypedProgram events: (Vec Event) literals: (Set i64)) -> Facts
  (let ((f2 (propagate (reduce (fn (g: Facts ev: Event) (event-facts g p ev)) f events) p))
        (cl (classify events literals)))
    (with f2
      (escaping (merge (. cl fst) (. f2 escaping)))
      (heap (merge (. f2 heap) (. cl snd))))))
