;; compiler/own/facts.fib: the functions on a unit's facts (spec/types.md §6.4, §6.5), as
;; crates/fibref/src/own/facts.rs (214 lines of Rust). The data, `Facts`, is in own.program.
;; Package O6; every public function is a stub of its final signature. Facts is a value, not a
;; Cell: `facts-absorb` is pure, and the fixpoint compares the new facts with the old (Rust:
;; `let before = self.clone(); ..; *self != before`).
(ns own.facts
  (:use types.program own.program own.walk.state))

;; Rust: facts.rs:55 `Facts::new`: the facts of a unit whose members' inferred parameters are
;; `inferred`; `preset` are owned from the start (`OwDeclared`).
(defun facts-new (members: (Map i64 (Vec i64)) inferred: (Set i64) preset: (Vec i64)) -> Facts
  (trap "todo: facts-new"))

;; Rust: facts.rs:72 `Facts::summary`: the summary of the `defun` f under these facts.
(defun facts-summary (f: Facts p: TypedProgram fun: i64) -> Summary
  (trap "todo: facts-summary"))

;; Rust: facts.rs:95 `Facts::absorb`: the facts with what one walk's events imply added (Rust
;; returns whether anything changed: compare the two values).
(defun facts-absorb (f: Facts p: TypedProgram events: (Vec Event) literals: (Set i64)) -> Facts
  (trap "todo: facts-absorb"))
