;; compiler/own/walk/lit.fib: the walk of a body and of the literals (`fn`, `async`, strings and
;; the like) (spec/types.md §6.4, §6.5, §6.9, §6.11), as crates/fibref/src/own/walk/lit.rs (287
;; lines of Rust). Package O4. `BodySpec` and `ParamIn` are data (package O1, they are read by
;; own.unit and own.top); the functions are stubs.
;;
;; Shapes: `ParamIn` carries the prefix `Pi`.
(ns own.walk.lit
  (:use types.ast own.program own.walk.state))

;; What a parameter is when a body is walked: a scalar, an `&` parameter, an object parameter
;; (owned or borrowed).
(defenum ParamIn PiScalar PiAmp (PiObj owned: bool))
(derive Eq ParamIn)

;; One body to walk: its frame kind, its parameters with what each is, per parameter whether
;; `:borrow` is declared, its body.
(defstruct BodySpec
  (kind: FrameKind params: (Vec (Pair i64 ParamIn)) declared-borrow: (Vec bool) body: Expr))

;; Rust: walk/lit.rs:73 `Walker::walk_body`: walks a `defun`, method or `def` body.
(defun walk-body (w: Walker spec: BodySpec) -> unit
  (trap "todo: walk-body"))

;; Rust: walk/lit.rs:128 `Walker::val`: the value e with mode m is, for the events: a literal, or
;; `Borrowed`/`Derived` of its site; `nil` for `Owned` and scalars.
(defun walk-val (w: Walker e: Expr m: Mode) -> (Option Val)
  (trap "todo: walk-val"))

;; Rust: walk/lit.rs:203 `Walker::fn_lit`: a `fn` literal (§6.5): Owned; its body walked as a frame of
;; its own.
(defun walk-fn-lit (w: Walker e: Expr lit: FnLit) -> Mode
  (trap "todo: walk-fn-lit"))

;; Rust: walk/lit.rs:248 `Walker::async_lit`: an `async` literal (§6.9): an escaping heap closure with
;; no parameters whose body has no tail calls; caps is its capture set.
(defun walk-async-lit (w: Walker e: Expr body: Expr caps: (Vec i64)) -> Mode
  (trap "todo: walk-async-lit"))
