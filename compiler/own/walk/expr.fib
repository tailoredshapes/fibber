;; compiler/own/walk/expr.fib: the walk of an expression: `let`, `do`, `if`, the joins of
;; branches, `loop` (spec/types.md §6.1 to §6.3, §6.11), as crates/fibref/src/own/walk/expr.rs
;; (317 lines of Rust). Package O4; this is the module that builds a Walker with its own
;; `walk-expr` as the function field (own.walk.state); every public function is a stub.
(ns own.walk.expr
  (:use types.ast own.program own.walk.state))

;; Rust: walk/expr.rs:17 `Walker::expr`: walks e (`tail`: tail position of the frame's body), records
;; and returns its mode.
(defun walk-expr (w: Walker e: Expr tail: bool) -> Mode
  (trap "todo: walk-expr"))

;; Rust: walk/expr.rs:109 `Walker::temp`: registers the `Owned` value of x as a temporary of the
;; innermost scope, a §6.11 candidate if x allocates (an immortal value is none).
(defun walk-temp (w: Walker x: Expr) -> unit
  (trap "todo: walk-temp"))

;; Rust: walk/expr.rs:127 `Walker::step`: a step (syntax §2): its temporaries die at its end, by the
;; scope-exit rule.
(defun walk-step (w: Walker e: Expr tail: bool) -> Mode
  (trap "todo: walk-step"))

;; Rust: walk/expr.rs:202 `Walker::join`: the join of §6.3; retains go on the branches that are not
;; `Owned`; a branch with no value (a `recur`) takes no part.
(defun walk-join (w: Walker e: Expr branches: (Vec (Pair Expr Mode))) -> Mode
  (trap "todo: walk-join"))

;; Rust: walk/expr.rs:274 `Walker::scrutinee`: the scrutinee s of mode m (an `Owned` one is an implicit
;; owning binding of the scope): the two modes `pattern-modes` gives.
(defun walk-scrutinee (w: Walker s: Expr m: Mode) -> (Pair Mode Mode)
  (trap "todo: walk-scrutinee"))
