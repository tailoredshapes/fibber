;; compiler/own/walk/state.fib: the data of one walk over the bodies of a unit (spec/types.md
;; §6), as the top of crates/fibref/src/own/walk/mod.rs (lines 1-215): the positions a value
;; reaches (`Val`, `Class`, `At`, `ArgAt`, `HeadAt`, `Event`: what the fixpoint of §6.4 and
;; the stack rule of §6.11 read), what a walk needs and does not change (`Ctx`), and the
;; walker itself. The data is written by package O1 so that own.facts, own.classify and
;; own.stack (O6) and own.walk.* (O3 to O5) can be written side by side; the functions at the end are package O3's.
;;
;; Shapes decided where Rust and fibber differ (O3 may reshape the walker, not the events):
;; - variants carry a prefix: `Val` `V`, `Class` `Cl`, `At` `At`, `FrameKind` `Fk`.
;; - the `Walker` of Rust has `&mut self` methods; this one holds Cells (plan 2.2, PROBE 2) and
;;   is passed to every function, so the frame found by `peek` is mutated in place. `frames`,
;;   `scopes`, `loops` and the rest are the Rust fields, their private types `Frame`, `Scope`
;;   and `LoopCtx` too; `ScopeKind` of Rust only documents and is not here.
;; - the cycle expr -> call, match_form, fn_lit -> expr is cut by the function field `expr`
;;   (plan 2.2, PROBE 5): own.walk.expr is the only module that builds a Walker with its own
;;   `walk-expr`, the others call `((. w expr) w e tail)`.
;; - `ArgAt` and `HeadAt` are records (`defrecord`: nine and four fields, built by name with
;;   `with`); `Class` has the six derives that a record's fields need.
(ns own.walk.state
  (:use fib.coll.record syntax.pos types.ast types.decls types.program own.program own.objects))

;; A value as the events see it: `Borrowed(site)` (an `Owned` temporary is `Borrowed(Value(e))`),
;; `Derived(site)`, or a `fn` literal itself.
(defenum Val (VB site: Site) (VD site: Site) (VLit lit: i64))
(derive Eq Val) (derive Hash Val)

;; The class of a parameter position (§6.3): borrowed (or `weak`, `raw`: no count), an owned
;; position of a call (consumed, not an escape by itself), stored (E2), `spawn` (E4).
(defenum Class ClBorrow ClOwned ClStore ClThread)
(derive Eq Class) (derive Ord Class) (derive Hash Class)
(derive Show Class) (derive Debug Class) (derive ToStr Class)

;; An argument position: `escapes` the parameter escapes (or the callee is a closure value),
;; `scc-callee` the `FunId` of a callee in the current SCC, `frame-owned` the argument is
;; frame-owned (§6.4) in the current facts.
(defrecord ArgAt
  [call: i64 index: i64 class: Class escapes: bool closure-value: bool scc-callee: (Option i64)
   tail-site: bool admitted: bool frame-owned: bool])

;; A head position: `self-tail` the self-name at its own self tail call.
(defrecord HeadAt [call: i64 tail-site: bool admitted: bool self-tail: bool])

;; A position a value reaches: E1 of the current frame's body, E2, E4, a join retain, the operand of
;; `raw-retained` or `weak`, moved out by a scope exit, captured by literal `lit` (heap or not),
;; consumed into loop variable `var` by its initialiser or by a `recur`, an argument of a call,
;; the head of a call through a closure value, the direct initialiser of a `let` binding, anything else.
(defenum At
  AtReturn AtStore AtThread AtJoin AtRawRetained AtWeak AtMoveOut
  (AtCapture lit: i64 heap: bool)
  (AtLoopInit var: i64)
  (AtRecur var: i64)
  (AtArg at: ArgAt)
  (AtHead at: HeadAt)
  (AtLetInit binding: i64)
  AtOther)
(derive Eq At) (derive Hash At)

;; One recorded position.
(defstruct Event (val: Val at: At))
(derive Eq Event) (derive Hash Event)

;; What a walk needs and does not change: the typed program; the summaries of the `defun`s of
;; earlier units; the unit's facts so far; the unit's `defun`s (none for a method or a `def`);
;; whether the bodies walked are all-owned (§8.4); the tail sites once known (`nil` while
;; finding them); whether tail sites are admitted by rule (e) with these facts; the
;; scope-local sites once known; the expressions that are the last use of the binding they read
;; (own.lastuse; none until the last walk), and the reads of field variables that are the last use of a field
;; whose shell nothing else reads afterwards; `unwinds`: the walk whose plan is kept records the releases of an unwinding (`w-put-unwind`).
(defstruct Ctx
  (p: TypedProgram summaries: (Map i64 Summary) facts: Facts scc: (Vec i64) all-owned: bool
   tail-sites: (Option (Map i64 Tail)) admit: bool scope-local: (Set Site) dead: (Set i64) steal: (Set i64) amp: (Set i64) reuse: (Map i64 i64)
   bodies: (Map BodyKey BodyOwn) unwinds: bool))

(defenum FrameKind FkDefun FkMethod FkFn FkAsync FkDef)
(derive Eq FrameKind)

;; The owning sites of a step or of a binding form (`let`, `match`, `loop`), in creation order,
;; each with whether it is a temporary; both release them at their exit.
(defstruct Scope (sites: (Cell (Vec (Pair Site bool)))))

;; A loop: the index of its scope (its variables) in the frame, and its variables.
(defstruct LoopCtx (scope: i64 vars: (Vec i64)))

;; A body: a `defun`'s, a method's, a `fn` or `async` literal's, a `def`'s: the modes its bindings
;; read as, its scopes and loops, the owned parameters (and `env`) released at the exits in
;; order, the `&` parameters (a `defun` frame only) with their carriers in the body (§6.6), a
;; named `fn`'s self-name.
(defstruct Frame
  (kind: FrameKind env: (Cell (Map i64 Mode)) scopes: (Cell (Vec Scope)) loops: (Cell (Vec LoopCtx))
   owned-params: (Cell (Vec Site)) amp-params: (Cell (Vec i64))
   amp-carriers: (Cell (Map i64 (Set i64))) self-name: (Cell (Option i64))))

;; A walk in progress (`peekable`: the cells of the body whose `@` may be a peek, own.peek; `strict`: the view cells and the `&` parameters of
;; scoped type among them, whose `@` is a peek only at a position that does not escape, own.views): `site-frame` is the frame depth that owns each owning site; `out` the
;; tables being filled; `events` every position reached; `tails` the decision at every call in
;; tail position; `candidates` the allocation sites that initialise an owning site (the §6.11
;; candidates); `expr` the walk of an expression (see the header).
(defstruct Walker
  (cx: Ctx frames: (Cell (Vec Frame)) site-frame: (Cell (Map Site i64)) out: (Cell BodyOwn)
   events: (Cell (Vec Event)) tails: (Cell (Map i64 Tail)) candidates: (Cell (Map Site i64))
   expr: (fn (Walker Expr bool) Mode)
   moved: (Cell (Set Site)) diverged: (Cell bool) stealable: (Cell (Map i64 Site)) wants: (Cell (Set i64))
   peekable: (Cell (Set i64)) strict: (Cell (Set i64))))

;; ---------------------------------------------------------------------------------------------
;; The methods of Rust's `Walker` (walk/mod.rs:207-458) are functions `w-NAME` of the walker, which
;; holds Cells: a mutator changes the walk in place and returns `unit`. The frames found by
;; `w-frame` share their Cells with the stack, so a change through one is a change of the walk.
;; Added to what O1 wrote, for the direct pokes of Rust (`self.frames.push`, `self.out.calls.insert`,
;; `self.tails.insert`): `frame-new`, `w-open-frame`, `w-close-frame`, `w-out!`, `w-put-*`, `w-site-frame!`,
;; `w-candidate!`, `w-tail!`, `w-env-put`.

;; Rust: walk/mod.rs:209 `Walker::new`: a walker with nothing walked; `expr` is the walk of an
;; expression (the cycle's function field).
(defun walker-new (cx: Ctx expr: (fn (Walker Expr bool) Mode)) -> Walker
  (Walker cx (cell []) (cell (map-empty)) (cell (body-own-new)) (cell []) (cell (map-empty))
          (cell (map-empty)) expr (cell (set-empty)) (cell false) (cell (map-empty)) (cell (set-empty)) (cell (set-empty)) (cell (set-empty))))

;; Rust: walk/mod.rs:452 `kind_of_param`: an owned parameter is `BnOwnedParam`, else `BnBorrowedParam`.
(defun kind-of-param (owned: bool) -> BindKind
  (if owned BnOwnedParam BnBorrowedParam))

;; The typed program of the walk, and its tables of declarations.
(defun w-p (w: Walker) -> TypedProgram (. (. w cx) p))
(defun w-g :private (w: Walker) -> Globals (. (w-p w) globals))

;; A frame with nothing in it (walk/lit.rs:34 `open_frame`).
(defun frame-new (kind: FrameKind) -> Frame
  (Frame kind (cell (map-empty)) (cell []) (cell []) (cell []) (cell []) (cell (map-empty)) (cell nil)))

;; Rust: walk/lit.rs:34 `open_frame` and the `frames.pop()` after a body.
(defun w-open-frame (w: Walker kind: FrameKind) -> unit
  (set! (. w frames) (conj @(. w frames) (frame-new kind))))
(defun w-close-frame (w: Walker) -> unit
  (set! (. w frames) (pop @(. w frames))))

;; Rust: walk/mod.rs:221 `frame` (the innermost frame; the walk opens one before any expression).
(defun w-frame (w: Walker) -> Frame (unwrap (peek @(. w frames))))

;; Rust: walk/mod.rs:233 `depth`: the number of frames open.
(defun w-depth (w: Walker) -> i64 (count @(. w frames)))

;; Rust: walk/mod.rs:238 `is_object`: whether e has an object type (no type: it has).
(defun w-is-object (w: Walker e: Expr) -> bool
  (if-some [t (get (. (w-p w) expr-types) (. e id))] (is-object (w-g w) t) true))

;; Rust: walk/mod.rs:249 `option_alloc`: the allocation of an `Option` constructor e of e's type
;; (§8.1): a heap enum is a heap object, a nullable pointer is nothing, and in a generic body
;; (`nil`) the evaluator decides by the payload.
(defun w-option-alloc (w: Walker e: Expr) -> (Option Alloc)
  (if-some [t (get (. (w-p w) expr-types) (. e id))]
    (match (option-rep (w-g w) t)
      ((some (OrHeapEnum)) (some AlHeap))
      ((some (OrPointer)) (some AlNothing))
      (_ nil))
    nil))

;; Rust: walk/mod.rs:261 `binding_is_object`: whether the binding b has an object type.
(defun w-binding-is-object (w: Walker b: i64) -> bool
  (if-some [t (get (. (w-p w) binding-types) b)] (is-object (w-g w) t) true))

;; Rust: walk/mod.rs:268 `note`: records a position reached (nothing for no value).
(defun w-note (w: Walker val: (Option Val) at: At) -> unit
  (when-some [v val] (set! (. w events) (conj @(. w events) (Event v at)))))

;; The tables being filled, changed by f; and the five that Rust inserts into.
(defun w-out! (w: Walker f: (fn (BodyOwn) BodyOwn)) -> unit
  (set! (. w out) (f @(. w out))))
(defun w-put-call (w: Walker e: i64 c: CallOwn) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (calls (assoc (. o calls) e c))))))
(defun w-put-recur (w: Walker e: i64 r: RecurOwn) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (recurs (assoc (. o recurs) e r))))))
(defun w-put-closure (w: Walker e: i64 c: ClosureOwn) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (closures (assoc (. o closures) e c))))))
(defun w-put-alloc (w: Walker e: i64 a: Alloc) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (allocs (assoc (. o allocs) e a))))))
(defun w-put-guard-fail (w: Walker e: i64 ops: (Vec Op)) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (guard-fail (assoc (. o guard-fail) e ops))))))

;; The releases of an unwinding at expression e (docs/design/exceptions.md 4.2, ADR 0009): when a call fails at e (or a `match` finds no
;; clause), the frame releases what it holds there: every owning site of its scopes and every owned parameter that the path has not
;; handed over, as a jump would (`moved`: what the call itself takes). Kept in `guard-fail` under the key `-1 - e` (no guard has a negative
;; id), so the plan's shape and its dump do not change; emit.lower.call reads it.
(defun w-put-unwind (w: Walker e: i64 moved: (Set Site)) -> unit
  (when (. (. w cx) unwinds)
    (w-put-guard-fail w (- -1 e) (into (w-release-scopes w 0 moved WhyJump) (w-release-params w moved false WhyJump)))))

;; The frame depth that owns a site, the §6.11 candidate it initialises, the decision at a call in
;; tail position.
(defun w-site-frame! (w: Walker site: Site depth: i64) -> unit
  (set! (. w site-frame) (assoc @(. w site-frame) site depth)))
(defun w-candidate! (w: Walker site: Site e: i64) -> unit
  (set! (. w candidates) (assoc @(. w candidates) site e)))
(defun w-tail! (w: Walker e: i64 tail: Tail) -> unit
  (set! (. w tails) (assoc @(. w tails) e tail)))

;; Rust: walk/mod.rs:278 `expr_own`: what is recorded for e, or the default (`Scalar`, no
;; operations); `w-put-expr-own` records it.
(defun w-expr-own (w: Walker e: i64) -> ExprOwn
  (get (. @(. w out) exprs) e (ExprOwn MScalar [])))
(defun w-put-expr-own :private (w: Walker e: i64 x: ExprOwn) -> unit
  (let [o @(. w out)] (set! (. w out) (with o (exprs (assoc (. o exprs) e x))))))

;; Rust: walk/mod.rs:274 `set_mode`.
(defun w-set-mode (w: Walker e: i64 mode: Mode) -> unit
  (w-put-expr-own w e (with (w-expr-own w e) (mode mode))))

;; Rust: walk/mod.rs:285 `push_op`: appends the operation to e's `after`.
(defun w-push-op (w: Walker e: i64 kind: OpKind site: Site why: Why) -> unit
  (w-add-after w e (Op kind site why)))

;; Rust: walk/mod.rs:291 `add_after`: appends to e's `after`, unless e jumps (an admitted tail call
;; or a `recur`), after which nothing of the frame runs.
(defun w-add-after (w: Walker e: i64 op: Op) -> unit
  (let [o @(. w out)
        jumps (or (contains? (. o recurs) e)
                  (match (get (. o calls) e) ((some c) (= (. c tail) TlTailCall)) (_ false)))]
    (when (not jumps)
      (let [x (w-expr-own w e)]
        (w-put-expr-own w e (with x (after (conj (. x after) op))))))))

;; Rust: walk/mod.rs:304 `end_op`: the operation that ends site at a scope exit or a jump.
(defun w-end-op (w: Walker site: Site why: Why) -> Op
  (Op (if (contains? (. (. w cx) scope-local) site) OpEndStack OpRelease) site why))

;; What a frame's `env` takes (walk/lit.fib reads captures into it without a binding record).
(defun w-env-put (w: Walker b: i64 mode: Mode) -> unit
  (let [f (w-frame w)] (set! (. f env) (assoc @(. f env) b mode))))

;; Rust: walk/mod.rs:313 `bind`: b reads as `mode` in the frame, a binding of kind `kind`.
(defun w-bind (w: Walker b: i64 mode: Mode kind: BindKind) -> unit
  (let [o @(. w out)]
    (do (w-env-put w b mode)
        (set! (. w out)
              (with o (bindings (assoc (. o bindings) b
                                       (BindingOwn kind (contains? (. (. w cx) scope-local) (SiteBind b))))))))))

;; Rust: walk/mod.rs:325 `read`: the mode a read of b has in the current frame.
(defun w-read (w: Walker b: i64) -> Mode
  (get @(. (w-frame w) env) b (MBorrowed (SiteBind b))))

;; Rust: walk/mod.rs:333 `push_scope` and :337 `pop_scope` (every push is paired with a pop).
(defun w-push-scope (w: Walker) -> unit
  (let [f (w-frame w)] (set! (. f scopes) (conj @(. f scopes) (Scope (cell []))))))
(defun w-pop-scope (w: Walker) -> Scope
  (let [f (w-frame w)
        scopes @(. f scopes)]
    (do (set! (. f scopes) (pop scopes))
        (unwrap (peek scopes)))))

;; Rust: walk/mod.rs:343 `own_site`: adds an owning site to the innermost scope of the frame.
(defun w-own-site (w: Walker site: Site temp: bool) -> unit
  (do (w-site-frame! w site (w-depth w))
      (when-some [s (peek @(. (w-frame w) scopes))]
        (set! (. s sites) (conj @(. s sites) (Pair site temp))))))

;; Whether a frame depth is the one that owns the site.
(defun in-this-frame :private (w: Walker s: Site) -> bool
  (= (get @(. w site-frame) s) (some (w-depth w))))

;; Rust: walk/mod.rs:352 `frame_owned`: whether m is frame-owned in the current frame (§6.4).
(defun w-frame-owned (w: Walker m: Mode) -> bool
  (match m
    ((MOwned immortal) (not immortal))
    ((MBorrowed s) (in-this-frame w s))
    ((MDerived s) (in-this-frame w s))
    ((MScalar) false)))

(defun scope-owns :private (sites: (Vec (Pair Site bool)) s: Site) -> bool
  (some? (find-first (fn (x: (Pair Site bool)) (= (. x fst) s)) sites)))

;; Rust: walk/mod.rs:362 `movable`: whether s is an owning binding of the frame that a tail call may
;; move (a scope's site or an owned parameter; not a capture).
(defun w-movable (w: Walker s: Site) -> bool
  (let [f (w-frame w)]
    (and (match s ((SiteCapture _ _) false) ((SiteGlobal _) false) (_ true))
         (in-this-frame w s)
         (or (some? (find-first (fn (x: Site) (= x s)) @(. f owned-params)))
             (some? (find-first (fn (sc: Scope) (scope-owns @(. sc sites) s)) @(. f scopes)))))))

;; Rust: walk/mod.rs:378 `exit_scope_copy`: the scope exit of scope for a value m produced by e
;; (§6.3), for one of several paths out of the same scope (the clauses of a `match`; `note` on the
;; first only): operations appended to e's `after`, and the adjusted mode. A value of a site the
;; scope owns is moved out (`Borrowed`: the site's release is dropped) or retained (`Derived`).
(defun w-exit-scope-copy (w: Walker scope: Scope e: i64 m: Mode note: bool) -> Mode
  (let [sites @(. scope sites)
        moved (match m ((MBorrowed s) :when (scope-owns sites s) (some s)) (_ nil))
        retained (match m ((MDerived s) (scope-owns sites s)) (_ false))]
    (do (when-some [s moved] (when note (w-note w (some (VB s)) AtMoveOut)))
        (when retained (w-push-op w e OpRetain (SiteValue e) WhyDerivedExit))
        (doseq [p (reverse sites)]
          (when (not (or (= (some (. p fst)) moved) (w-env-moved? w (. p fst))))
            (w-add-after w e (w-end-op w (. p fst) (if (. p snd) WhyStepEnd WhyScopeExit)))))
        (if (or retained (some? moved)) (MOwned false) m))))

;; Rust: walk/mod.rs:372 `exit_scope`.
(defun w-exit-scope (w: Walker scope: Scope e: i64 m: Mode) -> Mode
  (w-exit-scope-copy w scope e m true))

;; Rust: walk/mod.rs:408 `release_scopes`: the releases of the scopes `from..` of the frame, bindings
;; first (innermost scope first, reverse order), then temporaries, skipping `moved` (§6.10 step 3).
(defun w-release-scopes (w: Walker from: i64 moved: (Set Site) why: Why) -> (Vec Op)
  (let [scopes (reverse (drop from @(. (w-frame w) scopes)))]
    (vec (for [temps [false true]
               sc scopes
               p (reverse @(. sc sites))
               :when (and (= (. p snd) temps) (not (contains? moved (. p fst))) (not (w-env-moved? w (. p fst))))]
           (w-end-op w (. p fst) why)))))

;; Rust: walk/mod.rs:424 `release_params`: the owned parameters of the frame not in `moved` (the
;; `env` site is kept with `keep-env`).
(defun w-release-params (w: Walker moved: (Set Site) keep-env: bool why: Why) -> (Vec Op)
  (vec (for [s @(. (w-frame w) owned-params)
             :when (not (or (contains? moved s)
                            (w-env-moved? w s)
                            (and keep-env (match s ((SiteEnv _) true) (_ false)))))]
         (Op OpRelease s why))))

;; Rust: walk/mod.rs:438 `owning`: the mode of a new owning binding.
(defun w-owning (b: i64) -> Mode (MBorrowed (SiteBind b)))
;; ---------------------------------------------------------------------------------------------
;; Moves at last use (docs/design/in-place-update.md, lever L1). `moved` is the bindings whose count
;; the path being walked has handed over (a call's owned parameter, a store, a loop variable) at their
;; last use: no scope exit, jump or return releases them again on this path. At a branching form each
;; branch is walked from the same state; a binding that one branch that falls through moved and another
;; did not is released at the end of the other (the exit that follows then skips it), and a branch
;; that does not fall through (a `recur`, an admitted tail call) takes no part. `diverged` says that
;; the path just walked ended in a jump.

;; Whether the path has handed `s` over.
(defun w-env-moved? (w: Walker s: Site) -> bool
  (contains? @(. w moved) s))

;; The path hands `s` over.
(defun w-mark-moved (w: Walker s: Site) -> unit
  (set! (. w moved) (conj @(. w moved) s)))

;; Whether `x`, which reads site `s`, is the last use of a binding of this frame that the path may
;; hand over: an owning binding or owned parameter, not a stack object, not already handed over.
(defun w-last-use? (w: Walker x: Expr s: Site) -> bool
  (and (contains? (. (. w cx) dead) (. x id))
       (match s ((SiteBind _) true) (_ false))
       (w-movable w s)
       (not (contains? (. (. w cx) scope-local) s))
       (not (w-env-moved? w s))))

;; Whether `x`, a read of the variable bound to a field of a shell, is the field's last use and the shell may be
;; stolen from: it is this frame's own (an owner of a count that is not on the stack), nothing else reads it after.
(defun w-steal? (w: Walker x: Expr) -> bool
  (and (contains? (. (. w cx) steal) (. x id))
       (match (. x kind)
         ((ELocal b)
          (match (get @(. w stealable) b)
            ((some s) (and (w-movable w s)
                           (not (contains? (. (. w cx) scope-local) s))
                           (not (w-env-moved? w s))))
            (_ false)))
         (_ false))))

;; Whether `x`, a field read `(. b f)` of mode `Derived(s)`, is the field's last use (own.lastuse `record-field`) and the shell may be stolen
;; from: the site is this frame's own (an owner of a count that is not on the stack), nothing else reads it after.
(defun w-steal-field? (w: Walker x: Expr m: Mode) -> bool
  (and (contains? (. (. w cx) steal) (. x id))
       (match (Pair (. x kind) m)
         ((Pair (EField _ _ _) (MDerived s))
          (and (w-movable w s)
               (not (contains? (. (. w cx) scope-local) s))
               (not (w-env-moved? w s))))
         (_ false))))

;; Whether `x` is the last use of a field variable (and nothing reads the shell afterwards) of the match on a *borrowed parameter* of
;; a `defun`: the steal would fire if the parameter were owned. The parameter is then recorded in `wants` (own.unit `decide` makes it
;; owned and walks again), and `x` is retained as before in this walk.
(defun w-want-own (w: Walker x: Expr) -> bool
  (match (. x kind)
    ((ELocal b)
     (if (contains? (. (. w cx) steal) (. x id))
       (match (get @(. w stealable) b)
         ((some (SiteBind p))
          (let [bound (get (. @(. w out) bindings) p)]
            (if (and (= (. (w-frame w) kind) FkDefun)
                     (match bound ((some k) (= (. k kind) BnBorrowedParam)) (_ false)))
              (do (set! (. w wants) (conj @(. w wants) p)) true)
              false)))
         (_ false))
       false))
    (_ false)))

;; Rule 4 for a field read: `x` is `(. b f)` of mode `Derived(Bind p)`, the field's last use (`w-steal-field?` would hold if `p` were owned), and `p` is a
;; borrowed parameter of a `defun` (not declared `:borrow`): `p` is recorded in `wants`, as `w-want-own` does for a pattern variable.
(defun w-want-own-field (w: Walker x: Expr m: Mode) -> bool
  (match (Pair (. x kind) m)
    ((Pair (EField _ _ _) (MDerived (SiteBind p)))
     (if (contains? (. (. w cx) steal) (. x id))
       (let [bound (get (. @(. w out) bindings) p)]
         (if (and (= (. (w-frame w) kind) FkDefun)
                  (match bound ((some k) (= (. k kind) BnBorrowedParam)) (_ false)))
           (do (set! (. w wants) (conj @(. w wants) p)) true)
           false))
       false))
    (_ false)))

;; The state to branch from, and what a branch ended in.
(defstruct Branch (moved: (Set Site) jumped: bool))

;; The state at the head of a branching form.
(defun w-branch-start (w: Walker) -> Branch
  (Branch @(. w moved) @(. w diverged)))

;; Starts one branch from `st`.
(defun w-branch-enter (w: Walker st: Branch) -> unit
  (do (set! (. w moved) (. st moved))
      (set! (. w diverged) false)))

;; What the branch just walked ended in.
(defun w-branch-leave (w: Walker) -> Branch
  (Branch @(. w moved) @(. w diverged)))

;; The state after a branching form with branches `ends` (each its expression and what it ended
;; in): the bindings any branch that falls through handed over, each released at the end of the
;; falling-through branches that did not.
(defun w-branch-merge (w: Walker st: Branch ends: (Vec (Pair Expr Branch))) -> unit
  (let [live (filterv (fn (b: (Pair Expr Branch)) (not (. (. b snd) jumped))) ends)]
    (if (empty? live)
      (do (set! (. w moved) (reduce (fn (acc: (Set Site) b: (Pair Expr Branch)) (into acc (vec (. (. b snd) moved))))
                                     (. st moved) ends))
          (set! (. w diverged) true))
      (let [all (reduce (fn (acc: (Set Site) b: (Pair Expr Branch))
                          (reduce (fn (a: (Set Site) s: Site) (if (w-movable w s) (conj a s) a))
                                  acc (vec (. (. b snd) moved))))
                        (. st moved) live)]
        (do (doseq [b live]
              (doseq [s (vec (sort (vec all)))]
                (when (not (contains? (. (. b snd) moved) s))
                  (w-add-after w (. (. b fst) id) (Op OpRelease s WhyScopeExit)))))
            (set! (. w moved) all)
            (set! (. w diverged) (. st jumped)))))))

;; The state to restore after the body of a literal (a frame of its own).
(defun w-frame-save (w: Walker) -> Branch (w-branch-start w))
(defun w-frame-restore (w: Walker st: Branch) -> unit
  (do (set! (. w moved) (. st moved))
      (set! (. w diverged) (. st jumped))))
