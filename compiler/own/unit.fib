;; compiler/own/unit.fib: the driver of one unit: the tail sites of §6.10, the fixpoint of §6.4,
;; the admission of tail calls, the scope-local bindings of §6.11 and the emitting walk, as
;; crates/fibref/src/own/unit.rs (181 lines of Rust). Package O7. `Unit` and `Decided` are data
;; (package O1). A unit is walked four times over (five with every round of the fixpoint):
;;
;; 1. the tail sites: a walk with every inferred kind borrowed and every closure on the stack
;;    decides which calls in tail position §6.10 admits; they are fixed from here on;
;; 2. the fixpoint of §6.4: kinds, escape summaries and heap closures, walked until the facts
;;    stop growing (Rust's `absorb` returns whether they grew, here the facts are compared);
;; 3. admission: a walk that applies rule (e) to the tail sites with the finished facts; its
;;    events decide the scope-local bindings (§6.11, E6 is the admitted tail calls);
;; 4. emission: a last walk with the scope-local bindings known and the last uses of the admitting
;;    walk's modes (own.lastuse): a binding's count is handed over at its last use.
(ns own.unit
  (:use types.ast types.program own.program own.facts own.stack own.lastuse own.walk.state own.walk.lit
        own.walk.expr))

;; The bodies of a unit, each with its key and spec; the `defun`s of the SCC (none for a method
;; or a `def`); whether the bodies are all-owned bodies.
(defstruct Unit (bodies: (Vec (Pair BodyKey BodySpec)) scc: (Vec i64) all-owned: bool))

;; The decisions for a unit: its bodies' tables, and the facts it ended with.
(defstruct Decided (bodies: (Vec (Pair BodyKey BodyOwn)) facts: Facts))

;; What one walk over every body of a unit found: the tables of each body, every event, the
;; tail decisions, the allocation candidates and the `fn` literals that are not `async`.
(defstruct Walked
  (outs: (Vec BodyOwn) events: (Vec Event) tails: (Map i64 Tail) candidates: (Map Site i64)
   literals: (Set i64) wants: (Set i64)))

;; What every walk of a unit shares.
(defstruct Run (p: TypedProgram summaries: (Map i64 Summary) bodies: (Map BodyKey BodyOwn) unit: Unit))

;; Walks one body with a new walker and adds what it found to `w`.
(defun walk-one :private (w: Walked cx: Ctx spec: BodySpec) -> Walked
  (let [walker (walker-new cx walk-expr)]
    (do (walk-body walker spec)
        (let [out @(. walker out)]
          (with w
            (outs (conj (. w outs) out))
            (events (into (. w events) @(. walker events)))
            (tails (merge (. w tails) @(. walker tails)))
            (candidates (merge (. w candidates) @(. walker candidates)))
            (wants (into (. w wants) (vec @(. walker wants))))
            (literals (reduce-kv (fn (s: (Set i64) lit: i64 c: ClosureOwn)
                                   (if (. c is-async) s (conj s lit)))
                                 (. w literals) (. out closures))))))))

;; Rust `Run::walk`: a walk over every body of the unit; `sites` are the tail sites once known,
;; `admit` whether rule (e) is applied to them with `facts`, `local` the scope-local sites.
(defun run-walk :private (r: Run facts: Facts sites: (Option (Map i64 Tail)) admit: bool
                          local: (Set Site) dead: (Set i64) steal: (Set i64) amp: (Set i64) reuse: (Map i64 i64) final: bool) -> Walked
  (let [unit (. r unit)]
    (reduce (fn (w: Walked pair: (Pair BodyKey BodySpec))
              (walk-one w (Ctx (. r p) (. r summaries) facts (. unit scc) (. unit all-owned)
                               sites admit local dead steal amp reuse (. r bodies) final)
                        (. pair snd)))
            (Walked [] [] (map-empty) (map-empty) (set-empty) (set-empty))
            (. unit bodies))))

;; The facts of the fixpoint: walks until a walk's events add nothing.
(defun settle :private (r: Run sites: (Map i64 Tail) facts: Facts) -> Facts
  (loop [f facts]
    (let [w (run-walk r f (some sites) false (set-empty) (set-empty) (set-empty) (set-empty) (map-empty) false)
          g (facts-absorb f (. r p) (. w events) (. w literals))]
      (if (= g f) f (recur g)))))

;; Rust: unit.rs:150 `finish_allocs`: the allocation sites of a body that are scope-local are on the
;; stack, and the temporaries among them are stack temporaries; a `fn` literal is decided by §6.5.
(defun finish-allocs (out: BodyOwn cands: (Map Site i64) lits: (Set i64) local: (Set Site))
  -> BodyOwn
  (reduce-kv (fn (o: BodyOwn site: Site init: i64)
               (if (or (not (contains? local site)) (contains? lits init)
                       (not (contains? (. o allocs) init)))
                 o
                 (let [o2 (with o (allocs (assoc (. o allocs) init AlStack)))]
                   (match site
                     ((SiteValue e) (with o2 (stack-temps (conj (. o2 stack-temps) e))))
                     (_ o2)))))
             out cands))

;; Rust: unit.rs:166 `params`: the parameters of a body as the facts decided them.
(defun body-params (facts: Facts spec: BodySpec) -> (Vec ParamOwn)
  (mapv (fn (i: i64)
          (let [pr (nth (. spec params) i)
                b (. pr fst)
                declared (get (. spec declared-borrow) i false)]
            (ParamOwn b
                      (match (. pr snd)
                        ((PiScalar) PkScalar)
                        ((PiAmp) PkAmp)
                        ((PiObj _) (match (get (. facts owned) b)
                                     ((some ws) (PkOwned (vec (sort (vec ws)))))
                                     (_ PkBorrowed))))
                      (and (contains? (. facts escapes) b) (not declared))
                      declared)))
        (range (count (. spec params)))))

;; The parameters among `wants` (borrowed parameters whose field would be stolen, own.walk.state `w-want-own`) that rule 4 may make
;; owned: parameters of a `defun` body of the unit, inferred, not declared `:borrow`, not owned yet.
(defun wanted-params :private (unit: Unit wants: (Set i64) facts: Facts) -> (Vec i64)
  (vec (sort (vec (reduce (fn (acc: (Set i64) pair: (Pair BodyKey BodySpec))
                            (let [spec (. pair snd)]
                              (if (= (. spec kind) FkDefun)
                                (reduce (fn (a: (Set i64) i: i64)
                                          (let [b (. (nth (. spec params) i) fst)]
                                            (if (and (contains? wants b) (contains? (. facts inferred) b)
                                                     (not (contains? (. facts owned) b))
                                                     (not (get (. spec declared-borrow) i false)))
                                              (conj a b) a)))
                                        acc (range (count (. spec params))))
                                acc)))
                          (set-empty) (. unit bodies))))))

;; Rust: unit.rs:101 `decide`: decides a unit, starting from `facts`.
(defun decide (p: TypedProgram summaries: (Map i64 Summary) bodies: (Map BodyKey BodyOwn) unit: Unit facts: Facts) -> Decided
  (let [r (Run p summaries bodies unit)
        sites (. (run-walk r facts nil false (set-empty) (set-empty) (set-empty) (set-empty) (map-empty) false) tails)
        settled (settle r sites facts)
        admitted (run-walk r settled (some sites) true (set-empty) (set-empty) (set-empty) (set-empty) (map-empty) false)
        done (facts-absorb settled p (. admitted events) (. admitted literals))
        local (scope-local (. admitted events) (. admitted candidates) (. admitted literals)
                           (. done heap))
        lasts (mapv (fn (pair: (Pair (Pair BodyKey BodySpec) BodyOwn))
                      (last-uses (. (. (. pair fst) snd) body) (. pair snd) @(. (. p globals) option)))
                    (zip (. unit bodies) (. admitted outs)))
        dead (reduce (fn (acc: (Set i64) l: LastUses) (into acc (vec (. l dead)))) (set-empty) lasts)
        steal (reduce (fn (acc: (Set i64) l: LastUses) (into acc (vec (. l steal)))) (set-empty) lasts)
        amp (reduce (fn (acc: (Set i64) l: LastUses) (into acc (vec (. l amp)))) (set-empty) lasts)
        reuse (reduce (fn (acc: (Map i64 i64) l: LastUses) (merge acc (. l reuse))) (map-empty) lasts)
        emitted (run-walk r done (some sites) true local dead steal amp reuse true)
        wanted (wanted-params unit (. emitted wants) done)]
    (if (not (empty? wanted))
      (decide p summaries bodies unit (reduce (fn (g: Facts b: i64) (facts-want-owned g b)) done wanted))
      (Decided (mapv (fn (pair: (Pair (Pair BodyKey BodySpec) BodyOwn))
                     (let [key (. (. pair fst) fst)
                           spec (. (. pair fst) snd)
                           out (finish-allocs (. pair snd) (. emitted candidates) (. emitted literals) local)]
                       (Pair key (with out (params (body-params done spec))))))
                   (zip (. unit bodies) (. emitted outs)))
             done))))
