;; compiler/own/dump/bodies.fib: the `body` section of the ownership dump (spec/bootstrap.md §7.3,
;; crates/fibref/src/own_dump/sections.rs): for each body of a module, in the order they were
;; decided, the header and the records of its tables, each kind sorted by id (nothing is printed in
;; hash order). The words are those of own.dump.text.
;;
;;   body KEY                                       KEY is `fun NAME`, `method I NAME`, `def NAME` ..
;;     param B NAME KIND escapes=0|1 declared-borrow=0|1
;;     expr E MODE[ after OP; OP..]
;;     binding B NAME BKIND scope-local=0|1
;;     call E CALLEE tail=TAIL head=PASS args=PASS,.. write-backs=I:B,.. jump=OP; OP..
;;     recur E args=PASS,.. jump=OP; OP..
;;     closure E async=0|1 captures=B:PASS,.. escaping=no|yes(REASON) heap=no|yes(REASON)
;;       closure-param E B NAME KIND escapes=0|1 declared-borrow=0|1     one for each parameter
;;     alloc E heap|stack|nothing
;;     stack-temp E
;;     guard-fail E[ OP; OP..]
(ns own.dump.bodies
  (:use fib.string types.table types.ast types.decls types.program own.program own.dump.text))

(defun param-line (g: Globals pa: ParamOwn) -> str
  (str-concat "  param " (param-text g pa)))

(defun expr-line (e: i64 x: ExprOwn) -> str
  (str-join ["  expr " (eid e) " " (mode-text (. x mode))
             (if (empty? (. x after)) "" (str-concat " after " (ops-text (. x after))))]))

(defun binding-line (g: Globals b: i64 x: BindingOwn) -> str
  (str-join ["  binding " (bid b) " " (. (g-binding g b) name) " " (bind-kind-text (. x kind))
             " scope-local=" (flag-text (. x scope-local))]))

;; `I:B,..`: the write-backs, argument index and variable.
(defun write-backs-text (ws: (Vec (Pair i64 i64))) -> str
  (join "," (mapv (fn ([i b]) (str-join [(show i) ":" (show b)])) ws)))

(defun call-line (p: TypedProgram e: i64 c: CallOwn) -> str
  (str-join ["  call " (eid e) " " (callee-text p (. c callee)) " tail=" (tail-text (. c tail))
             " head=" (pass-text (. c head)) " args=" (passes-text (. c args))
             " write-backs=" (write-backs-text (. c write-backs)) " jump=" (ops-text (. c jump))]))

(defun recur-line (e: i64 r: RecurOwn) -> str
  (str-join ["  recur " (eid e) " args=" (passes-text (. r args)) " jump=" (ops-text (. r jump))]))

;; `B:PASS,..`: the captures of a closure.
(defun captures-text (cs: (Vec CaptureOwn)) -> str
  (join "," (mapv (fn (x: CaptureOwn) (str-join [(show (. x binding)) ":" (pass-text (. x pass))])) cs)))

;; The `closure` line of literal e, then one `closure-param` line for each of its parameters.
(defun closure-lines (g: Globals e: i64 c: ClosureOwn) -> (Vec str)
  (into [(str-join ["  closure " (eid e) " async=" (flag-text (. c is-async)) " captures=" (captures-text (. c captures))
                    " escaping=" (reason-text (. c escaping)) " heap=" (reason-text (. c heap))])]
        (mapv (fn (x: ParamOwn) (str-join ["    closure-param " (eid e) " " (param-text g x)])) (. c params))))

;; The lines of a table `m`, those of `line` for each key, the keys in order of id.
(defun table-lines (acc: (Vec str) m: (Map i64 v) line: (fn (i64 v) (Vec str)) :borrow) -> (Vec str)
  (reduce (fn (a: (Vec str) k: i64) (into a (line k (unwrap (get m k)))))
          acc (sort (vec (keys m)))))

;; `guard-fail E[ OP; OP..]`: the operations of a guard's false edge after one space, or none.
(defun guard-fail-line (e: i64 ops: (Vec Op)) -> str
  (str-concat (str-concat "  guard-fail " (eid e)) (if (empty? ops) "" (str-concat " " (ops-text ops)))))

;; The header and the records of one body.
(defun body-lines (acc: (Vec str) p: TypedProgram k: BodyKey b: BodyOwn) -> (Vec str)
  (let ((g (. p globals))
        (a0 (conj acc (str-concat "body " (body-key-text g k))))
        (a1 (reduce (fn (a: (Vec str) x: ParamOwn) (conj a (param-line g x))) a0 (. b params)))
        (a2 (table-lines a1 (. b exprs) (fn (e: i64 x: ExprOwn) [(expr-line e x)])))
        (a3 (table-lines a2 (. b bindings) (fn (e: i64 x: BindingOwn) [(binding-line g e x)])))
        (a4 (table-lines a3 (. b calls) (fn (e: i64 c: CallOwn) [(call-line p e c)])))
        (a5 (table-lines a4 (. b recurs) (fn (e: i64 r: RecurOwn) [(recur-line e r)])))
        (a6 (table-lines a5 (. b closures) (fn (e: i64 c: ClosureOwn) (closure-lines g e c))))
        (a7 (table-lines a6 (. b allocs) (fn (e: i64 x: Alloc) [(str-join ["  alloc " (eid e) " " (alloc-text x)])])))
        (a8 (reduce (fn (a: (Vec str) e: i64) (conj a (str-concat "  stack-temp " (eid e))))
                    a7 (sort (vec (. b stack-temps))))))
    ;; a negative key holds the releases of an unwinding (own.walk.state `w-put-unwind`), not a guard's: not part of the dump
    (table-lines a8 (. b guard-fail) (fn (e: i64 ops: (Vec Op)) (if (< e 0) [] [(guard-fail-line e ops)])))))

;; The bodies of module m that the pass decided, in the order it decided them.
(defun bodies-section (acc: (Vec str) p: TypedProgram o: OwnedProgram m: i64) -> (Vec str)
  (reduce (fn (a: (Vec str) k: BodyKey)
            (if (= (body-module (. p globals) k) m) (body-lines a p k (unwrap (get (. o bodies) k))) a))
          acc (. o order)))
