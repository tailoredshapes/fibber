;; compiler/own/dump/text.fib: the words and short phrases of the ownership dump, as
;; spec/bootstrap.md §7.3 defines them and crates/fibref/src/own_dump/texts.rs prints them: an id,
;; a site, a mode, an operation, a pass, a tail decision, a callee, a binding kind, a parameter
;; kind, an allocation, a body key. Each is a pure function of one value; the lines that use
;; them are in own.dump.bodies and own.dump.units. This is the one module that holds the words.
;;
;; The words: a binding id is `B428` and an expression id `E3087` after a record word, bare
;; inside a phrase; a site is `b:B` (a binding), `v:E` (the value of an expression), `cap:E:B` (a
;; capture), `env:E`, `def:D`; a mode `scalar`, `owned`, `owned!` (immortal), `borrowed SITE`,
;; `derived SITE`; an operation `retain|release|end-stack SITE WHY`, a list of them joined by `; `;
;; a list of passes, captures and write-backs by `,`.
(ns own.dump.text
  (:use fib.string types.table types.decls types.program types.builtins types.infer.mod own.program))

;; `B428`: a binding after a record word.
(defun bid (b: i64) -> str (str-concat "B" (show b)))

;; `E3087`: an expression after a record word.
(defun eid (e: i64) -> str (str-concat "E" (show e)))

;; `b:B | v:E | cap:E:B | env:E | def:D`.
(defun site-text (s: Site) -> str
  (match s
    ((SiteBind b) (str-join ["b:" (show b)]))
    ((SiteValue e) (str-join ["v:" (show e)]))
    ((SiteCapture l b) (str-join ["cap:" (show l) ":" (show b)]))
    ((SiteEnv l) (str-join ["env:" (show l)]))
    ((SiteGlobal d) (str-join ["def:" (show d)]))))

(defun mode-text (m: Mode) -> str
  (match m
    ((MScalar) "scalar")
    ((MOwned imm) (if imm "owned!" "owned"))
    ((MBorrowed s) (str-concat "borrowed " (site-text s)))
    ((MDerived s) (str-concat "derived " (site-text s)))))

(defun why-text (w: Why) -> str
  (match w
    ((WhyReturn) "return") ((WhyStore) "store") ((WhyJoin) "join") ((WhyScopeExit) "scope-exit")
    ((WhyStepEnd) "step-end") ((WhyDerivedExit) "derived-exit") ((WhyDiscard) "discard")
    ((WhyParamExit) "param-exit") ((WhyLoopInit) "loop-init") ((WhyJump) "jump")
    ((WhyRecurOld) "recur-old")))

(defun op-kind-text (k: OpKind) -> str
  (match k
    ((OpRetain) "retain") ((OpRelease) "release") ((OpEndStack) "end-stack")))

;; `retain|release|end-stack SITE WHY`.
(defun op-text (o: Op) -> str
  (str-join [(op-kind-text (. o kind)) " " (site-text (. o site)) " " (why-text (. o why))]))

;; The operations joined by `; ` (nothing for none).
(defun ops-text (ops: (Vec Op)) -> str
  (join "; " (mapv op-text ops)))

(defun pass-text (x: Pass) -> str
  (match x
    ((PsScalar) "scalar") ((PsBorrow) "borrow") ((PsMove) "move") ((PsRetain) "retain")
    ((PsAcquire) "acquire") ((PsForward) "forward") ((PsOwnCell) "own-cell") ((PsAlias) "alias")
    ((PsKeepEnv) "keep-env")))

;; The passes joined by `,` (nothing for none).
(defun passes-text (xs: (Vec Pass)) -> str
  (join "," (mapv pass-text xs)))

(defun because-text (b: Because) -> str
  (match b
    ((BcAmpArgument) "amp-argument")
    ((BcAmpCaptured p) (str-concat "amp-captured:" (show p)))
    ((BcFrameOwned a) (str-concat "frame-owned:" (show a)))
    ((BcAsyncBody) "async-body") ((BcExtern) "extern") ((BcStore) "store")))

;; `none` (not in tail position), `tail`, `ordinary:BECAUSE`.
(defun tail-text (t: Tail) -> str
  (match t
    ((TlNotInTail) "none")
    ((TlTailCall) "tail")
    ((TlOrdinary b) (str-concat "ordinary:" (because-text b)))))

;; `fun NAME | allowned NAME | method PROTOCOL.NAME | builtin NAME | ctor | extern | value`: a
;; builtin by its name, not its index, so that a change of the table that renumbers it does not show.
(defun callee-text (p: TypedProgram c: Callee) -> str
  (let ((g (. p globals)))
    (match c
      ((CalFun f) (str-concat "fun " (. (g-fun g f) name)))
      ((CalAllOwned f) (str-concat "allowned " (. (g-fun g f) name)))
      ((CalMethod proto i)
       (let ((d (g-proto g proto))) (str-join ["method " (. d name) "." (. (nth (. d methods) i) name)])))
      ((CalBuiltin id) (str-concat "builtin " (. (nth (. p builtins) id) name)))
      ((CalCtor) "ctor") ((CalExtern) "extern") ((CalValue) "value"))))

(defun owned-why-text (w: OwnedWhy) -> str
  (match w
    ((OwRule1 x) (str-join ["rule1(" x ")"]))
    ((OwRule2 x) (str-join ["rule2(" x ")"]))
    ((OwRule3 x) (str-join ["rule3(" x ")"]))
    ((OwLoop x) (str-join ["loop(" x ")"]))
    ((OwDeclared) "declared")))

;; The reasons joined by `,`, in the order given.
(defun whys-text (ws) -> str
  (join "," (mapv owned-why-text ws)))

;; `scalar | amp | borrowed | owned | owned:WHY,WHY..`: the reasons in the order the pass holds
;; them (that of their derived `Ord`); `owned` alone when none is left.
(defun param-kind-text (k: ParamKind) -> str
  (match k
    ((PkScalar) "scalar") ((PkAmp) "amp") ((PkBorrowed) "borrowed")
    ((PkOwned whys) (if (empty? whys) "owned" (str-concat "owned:" (whys-text whys))))))

;; `B NAME KIND escapes=0|1 declared-borrow=0|1`: a parameter of a body or a closure.
(defun param-text (g: Globals pa: ParamOwn) -> str
  (str-join [(bid (. pa binding)) " " (. (g-binding g (. pa binding)) name) " " (param-kind-text (. pa kind))
             " escapes=" (flag-text (. pa escapes)) " declared-borrow=" (flag-text (. pa declared-borrow))]))

;; `scalar | owns | alias-of SITE | derived-of SITE | borrowed-param | owned-param | amp-param`.
(defun bind-kind-text (k: BindKind) -> str
  (match k
    ((BnScalar) "scalar") ((BnOwns) "owns")
    ((BnAliasOf s) (str-concat "alias-of " (site-text s)))
    ((BnDerivedOf s) (str-concat "derived-of " (site-text s)))
    ((BnBorrowedParam) "borrowed-param") ((BnOwnedParam) "owned-param") ((BnAmpParam) "amp-param")))

(defun alloc-text (a: Alloc) -> str
  (match a
    ((AlHeap) "heap") ((AlStack) "stack") ((AlNothing) "nothing")))

;; `1` or `0`.
(defun flag-text (b: bool) -> str (if b "1" "0"))

;; The reason of an `Option`al `escaping`/`heap`: `yes(REASON)`, or `no`.
(defun reason-text (r: (Option str)) -> str
  (match r
    ((some why) (str-join ["yes(" why ")"]))
    (nil "no")))

;; The name of method `k` of instance `i`, as the `unit impl` lines of the types dump write it.
(defun impl-method-name (g: Globals i: i64 k: i64) -> str
  (let ((inst (table-get (. g instances) i)))
    (. (nth (. (g-proto g (. inst proto)) methods) (. (nth (. inst methods) k) index)) name)))

;; `fun NAME | allowned NAME | method I NAME | methodowned I NAME | def NAME`.
(defun body-key-text (g: Globals k: BodyKey) -> str
  (match k
    ((BodyFun f) (str-concat "fun " (. (g-fun g f) name)))
    ((BodyAllOwned f) (str-concat "allowned " (. (g-fun g f) name)))
    ((BodyMethod i m) (str-join ["method " (show i) " " (impl-method-name g i m)]))
    ((BodyMethodOwned i m) (str-join ["methodowned " (show i) " " (impl-method-name g i m)]))
    ((BodyDef d) (str-concat "def " (. (g-def g d) name)))))

;; The module that defines the body `k`.
(defun body-module (g: Globals k: BodyKey) -> i64
  (match k
    ((BodyFun f) (. (g-fun g f) module))
    ((BodyAllOwned f) (. (g-fun g f) module))
    ((BodyMethod i _) (. (table-get (. g instances) i) module))
    ((BodyMethodOwned i _) (. (table-get (. g instances) i) module))
    ((BodyDef d) (. (g-def g d) module))))
