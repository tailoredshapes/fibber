;; compiler/llvm/ffi.fib: what every binding of the LLVM-C API (llvm.core, llvm.target, llvm.orc, llvm.passes, llvm.support,
;; llvm.analysis) shares: moving bytes and words between fibber values and the raw memory C reads. It is the part of
;; compiler/lair/ffi.fib that does not talk to liblair (that file declares `lair_error_text`, which needs liblair.so at link time);
;; the conventions are the same, so a module of the port reads like a module of lair.*:
;;
;; - A handle LLVM gives out (a `LLVMValueRef`, a module, a builder, a target machine, a `char *` LLVM owns, an `LLVMErrorRef`, an
;;   address in the JIT) is an `i64` (a pointer is 64 bits wide and the C ABI passes both in one integer register). `ptr` is only
;;   for memory fibber itself allocates and reads or writes: a string copy, an out-parameter slot, an argument array.
;; - Every `ptr` a function here returns was made by `(alloc)` and is the caller's to `(free)`.
;; - A `str` is copied into a NUL-terminated buffer (`bytes-new`) for as long as one call needs it, then freed. LLVM-C takes C
;;   strings (`const char *`) as often as a pointer and a length; both are served by the one copy.
;; - Out-parameters are 8-byte slots (`slot-new`), zeroed before the call, read with `load-i64` after it. A slot for an `LLVMBool`
;;   or an enum is read with `load-i32`.
;; - C `int`, `unsigned`, `LLVMBool` and every enum are `i32` in the extern, and an `i64` wrapper truncates (`trunc i32`) on the
;;   way in and extends (`sext i64`) on the way out; `size_t` and `uint64_t` are `i64`.
(ns llvm.ffi)

;; The pointer whose address is a: eight bytes holding a, read back as a pointer (fibber has no cast; the idiom of case 189).
(defun addr->ptr (a: i64) -> ptr
  (unsafe
    (let ((c (alloc 8)))
      (do (store-i64 c a)
          (let ((p (load-ptr c)))
            (do (free c) p))))))

;; The address of the pointer p, as a word.
(defun ptr->addr (p: ptr) -> i64
  (unsafe
    (let ((c (alloc 8)))
      (do (store-ptr c p)
          (let ((a (load-i64 c)))
            (do (free c) a))))))

;; Frees the block at address a (made by `(alloc)`), for a block held as an address.
(defun free-addr (a: i64) -> unit
  (let ((p (addr->ptr a)))
    (unsafe (free p))))

;; A copy of the bytes of s, and a NUL after them: `(+ (str-len s) 1)` bytes, for the caller to `(free)`. Never null, even for "".
(defun bytes-new (s: str) -> ptr
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc (+ n 1))))
        (do (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
            (store-i8 (ptr+ p n) 0i8)
            p)))))

;; An out-parameter slot: eight bytes, zero, for the caller to `(free)`.
(defun slot-new () -> ptr
  (unsafe
    (let ((p (alloc 8)))
      (do (store-i64 p 0) p))))

;; The words of v, one `int64_t` each, in an array of `(+ (* 8 n) 8)` bytes (never null) for the caller to `(free)`: the
;; argument arrays of `LLVMBuildCall2`, `LLVMFunctionType`, `LLVMStructTypeInContext` and the like, whose elements are handles.
(defun words-new (v: (Vec i64)) -> ptr
  (let ((n (count v)))
    (unsafe
      (let ((p (alloc (+ (* n 8) 8))))
        (do (dotimes (i n) (store-i64 (ptr+ p (* i 8)) (nth v i)))
            p)))))

;; The n bytes at address a as a string. They must be UTF-8 (`str-from-bytes` traps `invalid UTF-8` otherwise). Nothing is freed.
(defun text-at (a: i64 n: i64) -> str
  (let ((p (addr->ptr a))
        (c (cell (array n 0i8))))
    (unsafe
      (do (dotimes (i n) (array-set! &c i (load-i8 (ptr+ p i))))
          (str-from-bytes @c)))))

;; The length of the NUL-terminated string at address a.
(defun c-string-len (a: i64) -> i64
  (let ((p (addr->ptr a)))
    (unsafe
      (loop ((i 0))
        (if (= (load-i8 (ptr+ p i)) 0i8) i (recur (+ i 1)))))))

;; The NUL-terminated string at address a, copied.
(defun c-string-at (a: i64) -> str
  (text-at a (c-string-len a)))
