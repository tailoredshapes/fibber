;; compiler/llvm/metadata.fib: the part of LLVM-C's llvm-c/Core.h that lowers the facts of lIR (spec/lir.md 6.13): the no-wrap flags, `!range`
;; metadata, and the insertion point of a builder (for a check mode's message). Kept apart from llvm.core so that the facts touch one new file;
;; the types follow llvm.core's conventions.
(ns llvm.metadata)

(extern LLVMSetNSW (i64 i32) -> unit)
(extern LLVMSetNUW (i64 i32) -> unit)
(extern LLVMGetMDKindIDInContext (i64 ptr i32) -> i32)
(extern LLVMValueAsMetadata (i64) -> i64)
(extern LLVMMDNodeInContext2 (i64 ptr i64) -> i64)
(extern LLVMMDStringInContext2 (i64 ptr i64) -> i64)
(extern LLVMMetadataAsValue (i64 i64) -> i64)
(extern LLVMAddNamedMetadataOperand (i64 ptr i64) -> unit)
(extern LLVMSetMetadata (i64 i32 i64) -> unit)
(extern LLVMGetInsertBlock (i64) -> i64)
(extern LLVMGetBasicBlockParent (i64) -> i64)
(extern LLVMGetBasicBlockName (i64) -> i64)
