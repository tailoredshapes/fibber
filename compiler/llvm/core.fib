;; ---------------------------------------------------------------------------------------------------------------------------------
;; Wrappers: strings and arrays in, strings out.

;; The `char *` LLVM returned (an address), copied, and disposed with LLVMDisposeMessage.
(defun take-message (a: i64) -> str
  (let ((s (ffi/c-string-at a)))
    (do (unsafe (LLVMDisposeMessage a)) s)))

;; A module named `name` in the context `ctx`.
(defun module-new (ctx: i64 name: str) -> i64
  (let ((n (ffi/bytes-new name)))
    (unsafe (let ((m (LLVMModuleCreateWithNameInContext n ctx))) (do (free n) m)))))

;; The module as text (LLVMPrintModuleToString), the string copied and LLVM's copy disposed.
(defun module-text (m: i64) -> str
  (take-message (unsafe (LLVMPrintModuleToString m))))

;; The triple and the data layout of the module.
(defun set-target (m: i64 triple: str) -> unit
  (let ((t (ffi/bytes-new triple)))
    (unsafe (do (LLVMSetTarget m t) (free t)))))

(defun set-data-layout (m: i64 layout: str) -> unit
  (let ((t (ffi/bytes-new layout)))
    (unsafe (do (LLVMSetDataLayout m t) (free t)))))

;; The type of a function from `params` (handles) to `ret`; vararg or not.
(defun function-type (ret: i64 params: (Vec i64) vararg: bool) -> i64
  (let ((ps (ffi/words-new params)))
    (unsafe
      (let ((t (LLVMFunctionType ret ps (trunc i32 (count params)) (if vararg 1i32 0i32))))
        (do (free ps) t)))))

;; A function `name` of type `ty` in the module.
(defun add-function (m: i64 name: str ty: i64) -> i64
  (let ((n (ffi/bytes-new name)))
    (unsafe (let ((f (LLVMAddFunction m n ty))) (do (free n) f)))))

;; A basic block `name` at the end of the function `fn`, in the context `ctx`.
(defun append-block (ctx: i64 fn: i64 name: str) -> i64
  (let ((n (ffi/bytes-new name)))
    (unsafe (let ((b (LLVMAppendBasicBlockInContext ctx fn n))) (do (free n) b)))))

;; The integer constant of type `ty` and value n (an i64 read as unsigned; `signed` extends it).
(defun const-int (ty: i64 n: i64 signed: bool) -> i64
  (unsafe (LLVMConstInt ty n (if signed 1i32 0i32))))

;; The call `fn` (of function type `fty`) with `args`, the result named `name` ("" for a void call).
(defun build-call (b: i64 fty: i64 fn: i64 args: (Vec i64) name: str) -> i64
  (let ((as (ffi/words-new args))
        (n (ffi/bytes-new name)))
    (unsafe
      (let ((c (LLVMBuildCall2 b fty fn as (trunc i32 (count args)) n)))
        (do (free as) (free n) c)))))
