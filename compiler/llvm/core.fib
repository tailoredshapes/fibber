;; compiler/llvm/core.fib: the part of LLVM-C's llvm-c/Core.h that crates/lair uses (the IR builder, types, constants, modules,
;; attributes, memory buffers), as `extern`s and a few safe wrappers. Generated from the headers of LLVM 21 for the 102 functions
;; `grep -rhoE '\bLLVM[A-Z][A-Za-z0-9]+' crates/lair/src` names (plus the two the spike needs: LLVMDumpModule and
;; LLVMCreateMemoryBufferWithMemoryRangeCopy); each is declared under its C name, so `core/LLVMBuildRet` is `LLVMBuildRet`.
;;
;; The types of the externs follow llvm.ffi: a handle or a `char *` LLVM returns is `i64`; a `const char *` going in, an array of
;; handles and an out-parameter are `ptr`; `LLVMBool`, `unsigned`, `int` and every enum are `i32`; `size_t` and `uint64_t` are `i64`;
;; `double` is `f64`. `LLVMDisposeMessage` takes the address as an `i64` because the message came back as one.
;;
;; Not here: the verifier (llvm.analysis), the target (llvm.target), ORC (llvm.orc), the pass builder (llvm.passes).
(ns llvm.core (:require [llvm.ffi :as ffi]))

;; --- Core.h
(extern LLVMAddAttributeAtIndex (i64 i32 i64) -> unit)
(extern LLVMAddCase (i64 i64 i64) -> unit)
