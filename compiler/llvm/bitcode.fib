;; compiler/llvm/bitcode.fib: the ThinLTO bitcode of a module, with its summary, through LLVM-C alone (the FIB_LIRO_THIN spike).
;;
;; LLVM-C cannot write a module summary (BitWriter.h writes plain bitcode). The pass `embed-bitcode<thinlto;emit-summary>` (FatLTO's) runs
;; ThinLTOBitcodeWriterPass and stores what it writes in the private global `llvm.embedded.object`; its initialiser is the bitcode file a
;; ThinLTO link wants. The pass refuses anything but ELF (a fatal error, not a status), so only an ELF triple may ask for it.
(ns llvm.bitcode (:require [llvm.ffi :as ffi]))

(extern LLVMGetNamedGlobal (i64 ptr) -> i64)
(extern LLVMGetInitializer (i64) -> i64)
(extern LLVMGetAsString (i64 ptr) -> i64)

;; The bytes of `llvm.embedded.object` in `m`, nil when the module has none.
(defun embedded-object (m: i64) -> (Option (Array i8))
  (let ((name (ffi/bytes-new "llvm.embedded.object")))
    (unsafe
      (let ((g (LLVMGetNamedGlobal m name)))
        (do (free name)
            (if (= g 0) nil
                (let ((init (LLVMGetInitializer g)))
                  (if (= init 0) nil
                      (let ((len (ffi/slot-new))
                            (p (LLVMGetAsString init len))
                            (n (load-i64 len))
                            (c (cell (array n 0i8))))
                        (do (dotimes (i n) (array-set! &c i (load-i8 (ptr+ (ffi/addr->ptr p) i))))
                            (free len)
                            (some @c)))))))))))
