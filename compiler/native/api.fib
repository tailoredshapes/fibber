;; compiler/native/api.fib: the facade that replaces `lair.jit` (compiler/lair/jit.fib): the same names, parameters and results, over `native.*` and with no C types. OWNER: package J.

;; The cutover is a changed `:require`. `Jit` is opaque to its users (none reads `handle`). Errors are `str`, the text lair prints: the diagnostics one
;; per line without a file name, or `lair-error-str` of the failure. The checks of lair's C interface (capi/jit.rs, capi/aot.rs: `level_arg`, the
;; empty path) are here.

(ns native.api
  (:use lir.ast native.error native.jit native.aot)
  (:require [native.pipeline :as pipe] [native.link :as link] [native.kernel :as kernel] [native.wgsl :as wgsl] [native.target :as target] [lir.targets :as tt]
            [native.liro.build :as liro] [native.liro.file :as liro-file]
            [native.liro.link :as liro-link] [native.libraries :as libraries] [native.timing :as timing]))


(defstruct Jit (session: JitSession))

;; `opt_level is N, not 0 to 3` for a level outside 0 to 3. (capi/error.rs `level_arg`)
(defun level-check :private (opt: i64) -> (Result i64 str)
  (if (and (>= opt 0) (<= opt 3))
      (Ok opt)
      (Err (str "opt_level is " opt ", not 0 to 3"))))

(defun wrap :private (r: (Result JitSession LairError)) -> (Result Jit str)
  (match r
    ((Err e) (Err (lair-error-str e)))
    ((Ok s) (Ok (Jit s)))))

(defun unit-result :private (r: (Result unit LairError)) -> (Result unit str)
  (match r
    ((Err e) (Err (lair-error-str e)))
    ((Ok _) (Ok ()))))

(defun word-result :private (r: (Result i64 LairError)) -> (Result i64 str)
  (match r
    ((Err e) (Err (lair-error-str e)))
    ((Ok a) (Ok a))))

;; A session at optimisation level `opt`. (jit.fib `jit-new`)
(defun jit-new (opt: i64) -> (Result Jit str)
  (match (level-check opt)
    ((Err m) (Err m))
    ((Ok l) (wrap (session-new l)))))

;; (jit.fib `jit-new-fast-codegen`)
(defun jit-new-fast-codegen (opt: i64) -> (Result Jit str)
  (match (level-check opt)
    ((Err m) (Err m))
    ((Ok l) (wrap (session-new-fast-codegen l)))))

;; (jit.fib `jit-free`)
(defun jit-free (j: Jit) -> unit
  (session-free (. j session)))

;; The text read, its macros expanded (native.macros), checked and added. (jit.fib `jit-add-source`)
(defun jit-add-source (j: Jit name: str src: str) -> (Result unit str)
  (match (pipe/check-source src)
    ((Err e) (Err (lair-error-str e)))
    ((Ok m) (unit-result (session-add-checked (. j session) name m)))))

;; Adds the module `m` (lIR trees, as the emitter makes them) without text: what no exported definition reaches is dropped, then the
;; rest is checked and added. (no counterpart in jit.fib; see `session-add-module-live`)
(defun jit-add-module (j: Jit name: str m: LModule) -> (Result unit str)
  (unit-result (session-add-module-live (. j session) name m)))

;; (jit.fib `jit-address`)
(defun jit-address (j: Jit name: str) -> (Result i64 str)
  (word-result (session-address (. j session) name)))

;; (jit.fib `jit-c-entry`)
(defun jit-c-entry (j: Jit name: str) -> (Result i64 str)
  (word-result (session-c-entry (. j session) name)))

;; Parses and checks `src` as a whole module and makes no code. (jit.fib `check-source`)
(defun check-source (src: str) -> (Result unit str)
  (match (pipe/check-source src)
    ((Err e) (Err (lair-error-str e)))
    ((Ok _) (Ok ()))))

;; `header` (the kernel signatures, native.kernel) before the PTX `body`.
(defun with-header :private (header: str body: (Array i8)) -> (Array i8)
  (let ((h (str-bytes header)) (n (array-len body)))
    (let ((out (cell (array (+ (array-len h) n) 0i8))))
      (do (dotimes (i (array-len h)) (array-set! &out i (array-get h i)))
          (dotimes (i n) (array-set! &out (+ (array-len h) i) (array-get body i)))
          @out))))

;; Compiles the module `src`, which must satisfy the `main` rule unless `library` (spec/lir.md 7.2), and links it into the executable `path`. (jit.fib `build-executable`)
(defun build-executable (src: str path: str opt: i64 libs: (Vec str) dirs: (Vec str) library: bool) -> (Result unit str)
  (cond (= path "") (Err "path is empty")
        :else (match (level-check opt)
                ((Err m) (Err m))
                ((Ok l) (match (checked-executable src library)
                          ((Err e) (Err (lair-error-str e)))
                          ((Ok m) (unit-result (liro/build-executable m path path (AotOptions l libs dirs library)))))))))

(defun checked-executable :private (src: str library: bool) -> (Result LModule LairError)
  (let ((t (timing/started)) (r (pipe/for-executable src library)))
    (do (timing/report "lir.check" t) r)))

;; The output of `--emit KIND` (obj, asm, llvm; ptx is asm on a kernel target, whose assembly is PTX, and nothing elsewhere; wgsl is the WebGPU
;; kernel target's own printer, `emit-wgsl`, and never LLVM's).
(defun output-kind :private (kind: str) -> (Result AotOutput str)
  (cond (wgsl-target?) (Err (str "the webgpu kernel target emits WGSL, which LLVM does not make: --emit wgsl, not " kind " (docs/design/webgpu.md)"))
        (= kind "obj") (Ok OutObject) (= kind "asm") (Ok OutAssembly) (= kind "llvm") (Ok OutLlvmIr)
        (= kind "ptx") (if (kernel-target?) (Ok OutAssembly) (Err "--emit ptx needs a kernel target: --target nvptx64-nvidia-cuda (docs/design/gpu.md)"))
        :else (Err (str "unknown --emit " kind))))

;; Whether FIB_TARGET_TRIPLE names the WebGPU kernel target (lir.targets `wgsl-row?`): its kernels are printed as WGSL.
(defun wgsl-target? :private () -> bool
  (match (target/requested-triple-row) ((some r) (tt/wgsl-row? r)) (nil false)))

;; `--emit wgsl`: the kernel module of `src` printed as WGSL compute shaders (native.wgsl) and written to `path`; refused off the WebGPU target.
(defun emit-wgsl :private (src: str path: str) -> (Result unit str)
  (if (not (wgsl-target?))
      (Err "--emit wgsl needs the WebGPU kernel target: --target wgsl-unknown-webgpu (docs/design/webgpu.md)")
      (try-let [m0 (match (pipe/check-source src) ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m)))
                km (kernel/kernel-module m0)
                text (wgsl/wgsl-module km)]
        (match (link/write-bytes path (str-bytes text))
          ((Err e) (Err (str path ": " e)))
          ((Ok _) (Ok ()))))))

;; Whether FIB_TARGET_TRIPLE names a kernel target (lir.targets `kernel-row?`): its module is the program's kernels (native.kernel), its assembly PTX.
(defun kernel-target? :private () -> bool
  (match (target/requested-triple-row) ((some r) (tt/kernel-row? r)) (nil false)))

;; The module to generate code for: the program, or on a kernel target its kernel module (`--emit obj` has no meaning there: PTX is text).
(defun module-for-target :private (m: LModule k: AotOutput) -> (Result LModule str)
  (cond (not (kernel-target?)) (Ok m)
        (match k ((OutObject) true) (_ false)) (Err "a kernel target emits PTX, which is text: --emit ptx (or asm, llvm), not obj")
        :else (kernel/kernel-module m)))

;; Compiles the module `src`, which must satisfy the `main` rule unless `library`, to an object, assembly or LLVM IR (`kind`) written to `path`, for the target of
;; FIB_TARGET_TRIPLE (else the host); links nothing. On a kernel target the module is the program's kernels and the assembly is PTX. (`fibc build --emit`)
(defun emit-file (src: str path: str opt: i64 kind: str library: bool) -> (Result unit str)
  (cond (= kind "wgsl") (emit-wgsl src path)
        (= kind "liro") (try-let [_ (level-check opt)
                                   _ (if (target/cross-target?) (Err "--emit liro initially supports the native host") (Ok ()))
                                   m (match (pipe/check-source src) ((Ok v) (Ok v)) ((Err e) (Err (lair-error-str e))))
                                   libs (libraries/lib-words (libraries/module-libs m))]
                         (unit-result (liro-file/export-file m path opt libs)))
        :else (emit-llvm-file src path opt kind library)))

;; The shared library `out` of the module `ast` (lIR trees): what the module exports is what its text exports, the `external` definitions that are
;; not `hidden` (spec/lir.md 4.3; the linker sees nothing else), so no list of symbols rides beside it (native.link `link-shared`). Its object is
;; written beside `out` and removed; the link adds the module's `dependent-library` forms after `libs`.
(defun build-shared-module (ast: LModule out: str opt: i64 mac: bool libs: (Vec str) dirs: (Vec str)) -> (Result unit str)
  (let ((obj (link/object-path out)))
    (try-let [_ (if (target/cross-target?) (Err "a shared library is linked for the host only; use --emit obj and link where the target runs") (Ok ()))
              ds (match (library-dirs dirs) ((Err e) (Err (lair-error-str e))) ((Ok d) (Ok d)))
              words (libraries/link-words ast libs dirs)
              _ (emit-llvm-module ast obj opt "obj" true)]
      (let ((r (link/link-shared [obj] out mac ds words)))
        (do (link/remove-path obj)
            (match r ((Err e) (Err (libraries/explain-failure (lair-error-str e) (libraries/module-libs ast)))) ((Ok _) (Ok ()))))))))

(defun link-objects (objects: (Vec str) out: str opt: i64 libs: (Vec str) dirs: (Vec str)) -> (Result unit str)
  (try-let [_ (level-check opt)
            _ (if (target/cross-target?) (Err "liro linking initially supports the native host") (Ok ()))
            _ (if (or (= out "") (empty? objects)) (Err "liro linking needs objects and an output path") (Ok ()))]
    (unit-result (liro-link/link-files objects out (aot-options opt libs dirs)))))

(defun emit-llvm-file :private (src: str path: str opt: i64 kind: str library: bool) -> (Result unit str)
  (try-let [l (level-check opt)
            k (output-kind kind)
            m0 (match (if (kernel-target?) (pipe/check-source src) (pipe/for-executable src library)) ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m)))
            m (module-for-target m0 k)
            bytes0 (match (aot-emit m path k (aot-options l [] [])) ((Err e) (Err (lair-error-str e))) ((Ok b) (Ok b)))
            bytes (Ok (if (and (kernel-target?) (match k ((OutAssembly) true) (_ false))) (with-header (kernel/kernel-signatures m) bytes0) bytes0))]
    (match (link/write-bytes path bytes)
      ((Err e) (Err (str path ": " e)))
      ((Ok _) (Ok ())))))

;; The front end hands generated trees to these entry points. Validation precedes
;; code generation and every LIRO cache lookup.
(defun checked-executable-module :private (ast: LModule library: bool) -> (Result LModule LairError)
  (let ((t (timing/started)) (r (pipe/for-executable-module ast library)))
    (do (timing/report "lir.check" t) r)))

;; The executable `path` of the module `ast` (with `library`, a library: no `main` rule, spec/lir.md 7.2; a wasm module with the reactor start): linked
;; with `libs` (the command line's `-l`) and the module's own `dependent-library` forms; a link that fails for one of those says what needs it
;; (native.libraries `explain-failure`).
(defun build-executable-module (ast: LModule path: str opt: i64 libs: (Vec str) dirs: (Vec str) library: bool) -> (Result unit str)
  (try-let ((l (level-check opt))
            (_ (if (= path "") (Err "path is empty") (Ok ())))
            (m (match (checked-executable-module ast library) ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m)))))
    (match (liro/build-executable m path path (AotOptions l libs dirs library))
      ((Err e) (Err (libraries/explain-failure (lair-error-str e) (libraries/module-libs m))))
      ((Ok _) (Ok ())))))

(defun emit-module (ast: LModule path: str opt: i64 kind: str library: bool) -> (Result unit str)
  (try-let ((_ (level-check opt)))
    (cond (= kind "wgsl") (emit-wgsl-module ast path)
          (= kind "liro")
          (try-let ((_ (if (target/cross-target?) (Err "--emit liro initially supports the native host") (Ok ())))
                    (m (match (pipe/check-module ast) ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m))))
                    (libs (libraries/lib-words (libraries/module-libs m))))
            (unit-result (liro-file/export-file m path opt libs)))
          :else (emit-llvm-module ast path opt kind library))))

(defun emit-wgsl-module :private (ast: LModule path: str) -> (Result unit str)
  (if (not (wgsl-target?))
      (Err "--emit wgsl needs the WebGPU kernel target: --target wgsl-unknown-webgpu (docs/design/webgpu.md)")
      (try-let ((m (match (pipe/check-module ast) ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m))))
                (km (kernel/kernel-module m)) (text (wgsl/wgsl-module km)))
        (match (link/write-bytes path (str-bytes text)) ((Err e) (Err (str path ": " e))) ((Ok _) (Ok ()))))))

(defun emit-llvm-module :private (ast: LModule path: str opt: i64 kind: str library: bool) -> (Result unit str)
  (try-let ((l (level-check opt)) (k (output-kind kind))
            (m0 (match (if (kernel-target?) (pipe/check-module ast) (pipe/for-executable-module ast library))
                  ((Err e) (Err (lair-error-str e))) ((Ok m) (Ok m))))
            (m (module-for-target m0 k))
            (bytes0 (match (aot-emit m path k (aot-options l [] [])) ((Err e) (Err (lair-error-str e))) ((Ok b) (Ok b))))
            (bytes (Ok (if (and (kernel-target?) (match k ((OutAssembly) true) (_ false)))
                           (with-header (kernel/kernel-signatures m) bytes0) bytes0))))
    (match (link/write-bytes path bytes) ((Err e) (Err (str path ": " e))) ((Ok _) (Ok ())))))
