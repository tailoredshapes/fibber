;; compiler/native/libraries.fib: the native libraries a module names with `(dependent-library "NAME")` (spec/lir.md 4.9; fibber writes one for each
;; `(extern f .. :lib "NAME")` it reaches, spec/syntax.md 3.15) and how a build links them. A library the program does not reach leaves no form, so
;; no `-l` and no failure for a library the program does not need. The mode of the build decides how a library is linked: `dynamic` (`-lLIB`,
;; resolved when the program starts), or `static` (`-l:libLIB.a`, the archive bundled into the executable). Per library: `--link LIB=MODE`
;; (FIB_LINK, a comma-separated list); for all: `--link-mode MODE` (FIB_LINK_MODE); else static in a `--static` build (a static executable has no
;; loader to resolve anything with) and dynamic in any other. Nothing here reads the lIR text: the forms are read from the module (lir.ast
;; `module-dependent-libraries`), and lair lowers them to LLVM's `!llvm.dependent-libraries` besides linking from them.
(ns native.libraries (:require [fib.string :as s] [native.libsearch :as search] [llvm.ffi :as ffi] [llvm.support :as support])
  (:use lir.ast))

(extern dlerror :private () -> ptr)

;; The libraries the module names, each once, in the order first written.
(defun module-libs (m: LModule) -> (Vec str)
  (module-dependent-libraries m))

;; The mode asked for `lib`: its own (`--link LIB=MODE`), else the build's, else nil.
(defun mode-asked :private (lib: str) -> (Option str)
  (let ((own (first (filter (fn (w: str) (starts-with? w (str lib "="))) (s/split (unwrap-or (sys-getenv "FIB_LINK") "") ",")))))
    (match own
      ((some w) (some (str-slice w (+ (str-len lib) 1) (str-len w))))
      (nil (match (sys-getenv "FIB_LINK_MODE")
             ((some m) (if (= m "") nil (some m)))
             (nil nil))))))

(defun static-build? () -> bool
  (= (unwrap-or (sys-getenv "FIB_STATIC") "") "1"))

;; What a message calls the declaration of `name`.
(defun declared-by :private (name: str) -> str
  (str "the program needs the native library " name " (declared by `(dependent-library \"" name "\")`, which `:lib \"" name "\"` on an extern writes)"))

;; The mode of `name`: static or dynamic, or the reason it cannot be.
(defun mode-of (name: str) -> (Result str str)
  (let ((asked (mode-asked name)))
    (cond (and (some? asked) (not (some? (find-first (fn (y: str) (= y (unwrap-or asked ""))) ["static" "dynamic"]))))
            (Err (str "fibc: --link: the mode of " name " is static or dynamic, not " (unwrap-or asked "")))
          (and (static-build?) (= (unwrap-or asked "static") "dynamic"))
            (Err (str "fibc: " (declared-by name) ", asked dynamic, but a --static executable has no dynamic loader: link it static (--link "
                      name "=static, with lib" name ".a on -L) or leave it out of the program"))
          :else (Ok (unwrap-or asked (if (static-build?) "static" "dynamic"))))))

;; The libraries the C library itself provides (glibc's `-lm -lpthread` are always on the link line; musl has them inside libc.a): declared, but never a link word.
(defun libc-part? :private (name: str) -> bool
  (some? (find-first (fn (y: str) (= y name)) ["c" "m" "pthread" "dl" "rt" "util"])))

;; The `-l` words for the libraries: `LIB` (dynamic) or `:libLIB.a` (static), the first failure otherwise.
(defun lib-words (ls: (Vec str)) -> (Result (Vec str) str)
  (loop ((i 0) (out []))
    (cond (>= i (count ls)) (Ok out)
          (libc-part? (nth ls i)) (recur (+ i 1) out)
          :else
        (match (mode-of (nth ls i))
          ((Err m) (Err m))
          ((Ok mode) (recur (+ i 1) (conj out (if (= mode "static") (str ":lib" (nth ls i) ".a") (nth ls i)))))))))

;; As `lib-words`, for a link that also searches `dirs` (`-L`): a dynamic library whose development link `libLIB.so` is nowhere but whose versioned file
;; `libLIB.so.N` is (native.libsearch) is linked by that file, `:libLIB.so.N`, which the linker finds in `dirs` and its own directories.
(defun lib-words-in (ls: (Vec str) dirs: (Vec str)) -> (Result (Vec str) str)
  (match (lib-words ls)
    ((Err m) (Err m))
    ((Ok words) (Ok (mapv (fn (w: str) (dynamic-word w dirs)) words)))))

;; The link words of a build: the `-l` the command line gave, then the module's own libraries (spec/lir.md 4.9), searched in `dirs`.
(defun link-words (m: LModule given: (Vec str) dirs: (Vec str)) -> (Result (Vec str) str)
  (match (lib-words-in (module-libs m) dirs)
    ((Err e) (Err e))
    ((Ok words) (Ok (into given words)))))

(defun dynamic-word :private (w: str dirs: (Vec str)) -> str
  (if (or (starts-with? w ":") (some? (str-find w "/" 0)))
      w
      (match (search/find-lib w (search/search-dirs dirs))
        ((some f) (if (. f versioned) (str ":" (. f file)) w))
        (nil w))))

;; The libraries loaded into this process for the JIT (`run`, `run --live`, `repl`), as an executable's loader would load them: the development link
;; by the dynamic linker's own search, else the file native.libsearch finds (a versioned `libLIB.so.N`); `:FILE` is the file itself. The first library
;; that cannot be loaded is the error, with what was tried. A library loaded once stays (LLVMLoadLibraryPermanently): the JIT's search of the
;; process (llvm.orc) and the names rules (llvm.support `process-defines?`) then find its symbols.
(defun load-for-jit (ls: (Vec str)) -> (Result unit str)
  (loop ((i 0))
    (if (>= i (count ls))
        (Ok ())
        (match (load-one (nth ls i))
          ((Err m) (Err m))
          ((Ok _) (recur (+ i 1)))))))

(defun load-one :private (name: str) -> (Result unit str)
  (let ((needs (str "fibc: " (declared-by name) ": ")))
    (cond (libc-part? name) (Ok ())
          (starts-with? name ":") (match (load-path (str-slice name 1 (str-len name))) ((Ok _) (Ok ())) ((Err e) (Err (str needs "cannot load it: " e))))
          (match (load-path (search/dev-name name)) ((Ok _) true) ((Err _) false)) (Ok ())
          :else (let ((dirs (search/search-dirs [])))
                  (load-first (search/candidates name dirs) (str needs "not found to load for the JIT; looked for " (search/tried-text name dirs)) needs)))))

;; The first of `fs` that loads; `none` when there are none, the reasons of all that failed otherwise.
(defun load-first :private (fs: (Vec search/Found) none: str needs: str) -> (Result unit str)
  (loop ((i 0) (why []))
    (cond (>= i (count fs)) (Err (if (empty? why) none (str needs "cannot load it: " (str-join (vec (interpose "; " why))))))
          :else (match (load-path (str (. (nth fs i) dir) "/" (. (nth fs i) file)))
                  ((Ok _) (Ok ()))
                  ((Err e) (recur (+ i 1) (conj why e)))))))

;; dlopen of `path` for good, global, by LLVM (so that its process search sees it); the loader's reason when it fails.
(defun load-path :private (path: str) -> (Result unit str)
  (let ((p (ffi/bytes-new path))
        (failed (unsafe (support/LLVMLoadLibraryPermanently p))))
    (do (ffi/free-addr (ffi/ptr->addr p))
        (if (= failed 0i32)
            (Ok ())
            (let ((e (unsafe (ffi/ptr->addr (dlerror)))))
              (Err (if (= e 0) path (ffi/c-string-at e))))))))

;; A failed link's text with what a declaration can add: for each declared library the linker could not find (`cannot find -lLIB`, `-l:libLIB.a`), what needs it.
(defun explain-failure (m: str ls: (Vec str)) -> str
  (let ((missing (filter (fn (name: str) (or (some? (str-find m (str "cannot find -l" name) 0)) (some? (str-find m (str "cannot find -l:lib" name ".") 0)))) ls)))
    (if (empty? missing)
        m
        (str m (str-join (mapv (fn (name: str) (str "\nfibc: " (declared-by name) ": not found; "
                                                   "install it (lib" name ".so, or the versioned lib" name ".so.N, for a dynamic link, lib" name ".a for --link " name "=static or --static) or give its directory with -L DIR")) missing))))))
