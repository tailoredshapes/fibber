;; compiler/native/cli.fib: the command line of lair (crates/lair/src/cli.rs): `check run build emit-llvm cases fuzz fuzz-one dump-ast`; the entry point `compiler/lairf.fib` calls it. OWNER: package H.
;; Errors are the Rust's strings (the caller prints them on standard error and exits 1). `fuzz` is package F's (native.fuzz).

(ns native.cli
  (:require [fib.string :as s] [llvm.ffi :as ffi] [native.imports :as imports] [lir.dump :as dump] [lir.print :as lprint] [lir.diag :as diag] [native.pipeline :as pipe]
            [native.error :as err] [native.aot :as aot] [native.jit :as jit] [native.link :as link] [native.cases :as cases]
            [native.cases.walk :as walk] [native.fuzz :as fuzz] [native.cases.header :as hdr] [native.call :as call]
            [native.liro.build :as liro] [native.liro.file :as liro-file] [native.api :as api] [native.libraries :as libraries]
            [lir.words :as words] [lir.respell :as respell])
  (:use lir.ast lir.types))

(extern exit :private (i32) -> unit)
(extern getpid :private () -> i32)
(extern setenv :private (ptr ptr i32) -> i32)

(def usage: str "usage:
  lair [--target TRIPLE] ..     the target of check/build/emit-llvm: FIB_TARGET_TRIPLE (docs/design/aarch64.md); `build` then needs --emit
  lair [--old-spelling|--new-spelling] ..   admit the old spelling of lIR beside the new, or refuse it (the default; spec/lir.md 2,
                                             transitional for one release; FIB_LIR_SPELLING=old|new, which `cases` and `fuzz` pass on)
  lair check FILE.lir
  lair run [-O n] FILE.lir [ARGS..]
  lair build FILE.lir -o OUT [-O n] [--emit liro|obj|asm|llvm] [--library] [-L DIR].. [-l LIB]..   ; --library: no main rule, the output is a library (a wasm reactor)
  lair link FILE.liro.. -o OUT [-O n] [-L DIR].. [-l LIB]..
  lair emit-llvm FILE.lir
  lair dump-ast FILE.lir
  lair expand FILE.lir            ; the module with its macros expanded, as lIR text (for a backend with no compile-time runtime)
  lair respell FILE.lir [--in-place|--check]   ; the text in the new spelling (spec/lir.md 2), comments and layout kept; --check: exit 1 and the differing lines when it is not already
  lair words                      ; the words of lIR: TEXT and canonical name, one per line (lir.words)
  lair cases DIR.. [-j N]
  lair fuzz [--seed N] [--count N] [--timeout SECS] [-O n] [-o DIR] [--keep DIR] [-v] [--print N] DIR..
  lair fuzz-one [-O n] FILE.lir")

(def fuzz-checked: str "fuzz-one: checked")
(def fuzz-compiled: str "fuzz-one: compiled")

(defun read-src :private (file: str) -> (Result str str)
  (match (read-file file)
    (nil (Err (str file ": cannot read: No such file or directory (os error 2)")))
    ((some src) (Ok src))))

(defun rendered :private (r: (Result a err/LairError) file: str) -> (Result a str)
  (match r
    ((Ok v) (Ok v))
    ((Err e) (Err (err/lair-error-render e file)))))

;; -------------------------------------------------------------------------------------------------- check, emit-llvm, dump-ast

(defun check-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (not (= (count rest) 1))
      (Err usage)
      (try-let [src (read-src (nth rest 0))
                _ (rendered (pipe/check-file src (nth rest 0)) (nth rest 0))]
        (Ok 0))))

(defun emit-llvm-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (not (= (count rest) 1))
      (Err usage)
      (try-let [src (read-src (nth rest 0))
                text (rendered (pipe/emit-llvm src (nth rest 0)) (nth rest 0))]
        (do (print text) (Ok 0)))))

;; The program read, its macros expanded and its imports joined to it (spec/lir.md 4.6, 4.7), printed as lIR text (lir.print: one
;; top-level form per line, which reads back to the same program; no `define-macro`, `require-macros` or `import` remains, and a module
;; with neither prints as parsed). It parses but does not check the module itself: what lir2js and lir2c, which have no compile-time
;; runtime, consume in place of the text.
(defun expand-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (not (= (count rest) 1))
      (Err usage)
      (try-let [src (read-src (nth rest 0))]
        (match (imports/load-program src (nth rest 0))
          ((Err d) (Err (diag/diag-in-file d (nth rest 0))))
          ((Ok p) (do (print-raw (lprint/print-module (. p module))) (Ok 0)))))))

;; `respell FILE [--in-place|--check]` (spec/lir.md 2): the text rewritten in the new spelling at the token level (lir.respell), both
;; spellings read whatever the mode; printed, written back, or compared with the file (`--check`: the lines that differ and
;; exit 1 when it is not already in the new spelling).
(defun respell-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (let ((files (vec (filter (fn (a: str) (not (starts-with? a "--"))) rest)))
        (in-place (some? (first (filter (fn (a: str) (= a "--in-place")) rest))))
        (check (some? (first (filter (fn (a: str) (= a "--check")) rest)))))
    (if (or (not (= (count files) 1)) (and in-place check) (not (= (+ (count files) (if in-place 1 0) (if check 1 0)) (count rest))))
        (Err usage)
        (try-let [src (read-src (nth files 0))
                  out (match (respell/respell-text src) ((Ok t) (Ok t)) ((Err d) (Err (diag/diag-in-file d (nth files 0)))))]
          (cond check (if (= out src) (Ok 0) (do (print-raw (respell/respell-diff src out)) (Ok 1)))
                in-place (if (write-file (nth files 0) out) (Ok 0) (Err (str (nth files 0) ": cannot write")))
                :else (do (print-raw out) (Ok 0)))))))

;; `words`: the table of lir.words, `TEXT name` per line.
(defun words-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (not (empty? rest))
      (Err usage)
      (do (doseq [wd (words/words-table)] (println (str (. wd text) " " (. wd name))))
          (Ok 0))))

;; The canonical text of the parsed program (docs/design/lair-ast-dump.md): the module with its macros expanded and its imports joined to
;; it (spec/lir.md 4.7); it parses but does not check the module itself (an imported module is checked as it is loaded).
(defun dump-ast-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (not (= (count rest) 1))
      (Err usage)
      (try-let [src (read-src (nth rest 0))]
        (match (imports/load-program src (nth rest 0))
          ((Err d) (Err (diag/diag-in-file d (nth rest 0))))
          ((Ok p) (do (dump/dump-with (. p module) (fn (chunk: str) (print-raw chunk))) (Ok 0)))))))

;; -------------------------------------------------------------------------------------------------- the options

(defun opt-level :private (t: str) -> (Result i64 str)
  (match (hdr/parse-i32 t)
    ((some n) (if (and (>= n 0) (<= n 3)) (Ok n) (Err (str "bad -O level " t))))
    (nil (Err (str "bad -O level " t)))))

;; The `-O n` that may start the arguments of run and fuzz-one: the level and what follows.
(defun leading-opt :private (rest: (Vec str)) -> (Result (Pair i64 (Vec str)) str)
  (if (and (>= (count rest) 2) (= (nth rest 0) "-O"))
      (try-let [n (opt-level (nth rest 1))] (Ok (Pair n (vec (drop 2 rest)))))
      (Ok (Pair 0 rest))))

;; -------------------------------------------------------------------------------------------------- run

(defun c-strings :private (words: (Vec str)) -> ptr
  (ffi/words-new (conj (mapv (fn (w: str) (ffi/ptr->addr (ffi/bytes-new w))) words) 0)))

;; Calls `main` at `entry`, with (argc, argv) when its type has parameters; the status, as the C `int` it returned.
(defun call-main :private (entry: i64 takes-args: bool argv: (Vec str)) -> (Result i64 str)
  (try-let [r (call/call-i64 entry (if takes-args [(count argv) (ffi/ptr->addr (c-strings argv))] []))]
    (Ok (sext i64 (trunc i32 r)))))

(defun trace :private (on: bool mark: str) -> unit
  (if on (eprintln mark) ()))

;; JIT-compiles the module and runs `main`; exits with its status (`exit` flushes the C library's buffers, as returning from a C main would).
(defun execute :private (file: str opt: i64 prog-args: (Vec str) tracing: bool) -> (Result i64 str)
  (try-let [src (read-src file)
            m (rendered (pipe/for-executable-file src file false) file)
            session (rendered (jit/session-new opt) file)
            _ (rendered (jit/session-add-module session file m) file)
            ty (rendered (jit/session-signature session "main") file)
            entry (rendered (jit/session-address session "main") file)
            code (do (trace tracing fuzz-checked) (trace tracing fuzz-compiled)
                     (call-main entry (not (empty? (. ty params))) (into [file] prog-args)))]
    (do (unsafe (exit (trunc i32 code))) (Ok code))))

(defun run-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (try-let [lo (leading-opt rest)]
    (let ((tail (. lo snd)))
      (if (empty? tail)
          (Err usage)
          (execute (nth tail 0) (. lo fst) (vec (drop 1 tail)) false)))))

(defun fuzz-one-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (try-let [lo (leading-opt rest)]
    (if (= (count (. lo snd)) 1)
        (execute (nth (. lo snd) 0) (. lo fst) [] true)
        (Err usage))))

;; -------------------------------------------------------------------------------------------------- build

;; What `build` was asked for so far (cli.rs `build`'s locals).
(defstruct BuildArgs (out: (Option str) opt: i64 emit: (Option aot/AotOutput) liro: bool libs: (Vec str) dirs: (Vec str) library: bool))

(defun emit-kind :private (v: str) -> (Result aot/AotOutput str)
  (cond (= v "obj") (Ok aot/OutObject)
        (= v "asm") (Ok aot/OutAssembly)
        (= v "llvm") (Ok aot/OutLlvmIr)
        :else (Err (str "unknown --emit " v))))

;; One option and its value applied to the arguments so far.
(defun build-option :private (b: BuildArgs flag: str v: str) -> (Result BuildArgs str)
  (cond (= flag "-o") (Ok (with b (out (some v))))
        (= flag "-O") (try-let [n (opt-level v)] (Ok (with b (opt n))))
        (= flag "-L") (Ok (with b (dirs (conj (. b dirs) v))))
        (= flag "-l") (Ok (with b (libs (conj (. b libs) v))))
        (= v "liro") (Ok (with b (liro true)))
        :else (try-let [k (emit-kind v)] (Ok (with b (emit (some k)) (liro false))))))

(defun build-flag? :private (a: str) -> bool
  (or (= a "-o") (= a "-O") (= a "-L") (= a "-l") (= a "--emit")))

(defun parse-build :private (words: (Vec str)) -> (Result BuildArgs str)
  (loop ((i 0) (b (BuildArgs nil 0 nil false [] [] false)))
    (cond (>= i (count words)) (Ok b)
          (= (nth words i) "--library") (recur (+ i 1) (with b (library true)))
          (not (build-flag? (nth words i))) (Err (str "unknown option " (nth words i) "\n" usage))
          (>= (+ i 1) (count words)) (Err (str (nth words i) " needs a value"))
          :else (try-let [b2 (build-option b (nth words i) (nth words (+ i 1)))]
                  (recur (+ i 2) b2)))))

(defun build-output :private (b: BuildArgs file: str src: str out: str) -> (Result unit str)
  (let ((opts (aot/AotOptions (. b opt) (. b libs) (. b dirs) (. b library))))
    (if (. b liro)
      (try-let [m (rendered (pipe/check-file src file) file)
                libs (libraries/lib-words (libraries/module-libs m))]
        (rendered (liro-file/export-file m out (. b opt) libs) file))
    (match (. b emit)
      (nil (try-let [m (rendered (pipe/for-executable-file src file (. b library)) file)]
             (rendered (liro/build-executable m file out opts) file)))
      ((some kind) (try-let [m (rendered (pipe/check-file src file) file)
                             bytes (rendered (aot/aot-emit m file kind opts) file)]
                     (match (link/write-bytes out bytes)
                       ((Err e) (Err (str out ": " e)))
                       ((Ok _) (Ok ())))))))))

(defun link-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (let ((split (count (take-while (fn (s: str) (not (starts-with? s "-"))) rest))))
    (try-let [b (parse-build (vec (drop split rest)))
              out (match (. b out) ((some s) (Ok s)) (nil (Err "link needs -o OUT")))
              _ (if (or (. b liro) (some? (. b emit))) (Err "link does not take --emit") (Ok ()))
              _ (api/link-objects (vec (take split rest)) out (. b opt) (. b libs) (. b dirs))]
      (Ok 0))))

(defun build-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (if (empty? rest)
      (Err usage)
      (let ((file (nth rest 0)))
        (try-let [b (parse-build (vec (drop 1 rest)))]
          (match (. b out)
            (nil (Err "build needs -o OUT"))
            ((some out) (try-let [src (read-src file)
                                  _ (build-output b file src out)]
                          (Ok 0))))))))

;; -------------------------------------------------------------------------------------------------- cases

(defun category :private (p: str) -> str
  (let ((cs (walk/components p)))
    (if (or (< (count cs) 2) (= (nth cs (- (count cs) 2)) "/")) "" (nth cs (- (count cs) 2)))))

;; The scratch directory of a run: TMPDIR (or /tmp)/lair-cases-PID.
(defun scratch-dir :private () -> (Result str str)
  (let ((env (unwrap-or (sys-getenv "TMPDIR") ""))
        (d (str-join [(if (= env "") "/tmp" env) "/lair-cases-" (show (sext i64 (unsafe (getpid))))])))
    (if (>= (sys-mkdir d 511) 0)
        (Ok d)
        (if (some? (walk/list-dir d)) (Ok d) (Err (str d ": cannot create the scratch directory"))))))

(defun remove-scratch :private (d: str) -> unit
  (do (match (walk/list-dir d) (nil ()) ((some names) (doseq [n names] (sys-unlink (walk/join-path d n)))))
      (sys-rmdir d)
      ()))

;; The cases and passes of each run of one category.
(defstruct Tally (cat: str n: i64 ok: i64))

(defun tally :private (reports: (Vec cases/CaseReport)) -> (Vec Tally)
  (reduce (fn (ts: (Vec Tally) r: cases/CaseReport)
            (let ((c (category (. r path)))
                  (pass (if (nil? (. r failure)) 1 0))
                  (last (if (empty? ts) nil (some (nth ts (- (count ts) 1))))))
              (match last
                ((some l) (if (= (. l cat) c)
                              (assoc ts (- (count ts) 1) (Tally c (+ (. l n) 1) (+ (. l ok) pass)))
                              (conj ts (Tally c 1 pass))))
                (nil (conj ts (Tally c 1 pass))))))
          [] reports))

;; The table of rows, the counts per category and the total; the status.
(defun summarise :private (reports: (Vec cases/CaseReport)) -> i64
  (let ((failed (count (filter (fn (r: cases/CaseReport) (some? (. r failure))) reports))))
    (do (doseq [r reports]
          (match (. r failure)
            (nil (println (str "ok    " (. r path))))
            ((some f) (println (str "FAIL  " (. r path) ": " f)))))
        (doseq [t (tally reports)]
          (println (str-join [(. t cat) ": " (show (. t n)) " cases, " (show (. t ok)) " pass, " (show (- (. t n) (. t ok))) " fail"])))
        (println (str-join ["total: " (show (count reports)) " cases, " (show (- (count reports) failed)) " pass, " (show failed) " fail"]))
        (if (= failed 0) 0 1))))

;; `-j N` anywhere in the words: taken out, the number of cases run at a time (else FIB_LAIR_WORKERS or 4).
(defun take-jobs :private (words: (Vec str)) -> (Result (Pair (Vec str) i64) str)
  (loop ((i 0) (out []) (jobs (cases/cases-workers)))
    (cond (>= i (count words)) (Ok (Pair out jobs))
          (not (= (nth words i) "-j")) (recur (+ i 1) (conj out (nth words i)) jobs)
          (>= (+ i 1) (count words)) (Err "-j needs a number")
          :else (match (hdr/parse-i32 (nth words (+ i 1)))
                  ((some n) (if (> n 0) (recur (+ i 2) out n) (Err (str "bad -j " (nth words (+ i 1))))))
                  (nil (Err (str "bad -j " (nth words (+ i 1)))))))))

(defun cases-cmd :private (rest: (Vec str)) -> (Result i64 str)
  (try-let [split (take-jobs rest)]
    (let ((found (cases/cases-collect (. split fst))))
      (if (empty? found)
          (Err "no cases found")
          (try-let [scratch (scratch-dir)]
            (let ((reports (cases/cases-run-with (fuzz/self-path) found scratch (. split snd))))
              (do (remove-scratch scratch) (Ok (summarise reports)))))))))

;; -------------------------------------------------------------------------------------------------- dispatch

(defun set-env :private (name: str value: str) -> unit
  (let ((k (ffi/bytes-new name)) (v (ffi/bytes-new value)))
    (do (unsafe (setenv k v 1i32)) ())))

;; `--target TRIPLE` anywhere in the words: removed, and FIB_TARGET_TRIPLE set to the triple (the code generator and the checker's target read it).
;; `--old-spelling` and `--new-spelling` (spec/lir.md 2, transitional): removed, and FIB_LIR_SPELLING set (lir.words: the variable is the mode),
;; which the processes `cases` and `fuzz` start inherit.
(defun take-target :private (args: (Vec str)) -> (Result (Vec str) str)
  (loop ((i 0) (out []))
    (cond (>= i (count args)) (Ok out)
          (= (nth args i) "--old-spelling") (do (words/admit-old-spelling! true) (recur (+ i 1) out))
          (= (nth args i) "--new-spelling") (do (words/admit-old-spelling! false) (recur (+ i 1) out))
          (not (= (nth args i) "--target")) (recur (+ i 1) (conj out (nth args i)))
          (>= (+ i 1) (count args)) (Err "--target needs a triple")
          :else (do (set-env "FIB_TARGET_TRIPLE" (nth args (+ i 1))) (recur (+ i 2) out)))))

;; The fuzzer's grammar writes the old spelling until the tree is converted (spec/lir.md 2), so `fuzz` and `fuzz-one` admit it by default.
(defun fuzz-cmd? :private (words: (Vec str)) -> bool
  (or (includes? "fuzz" words) (includes? "fuzz-one" words)))

;; Runs the command; the exit status, or the usage error (cli.rs `dispatch`); the spelling's default first, the flags after it.
(defun dispatch (words: (Vec str)) -> (Result i64 str)
  (do (words/default-spelling! (fuzz-cmd? words))
      (try-let [args (take-target words)]
        (dispatch-cmd args))))

(defun dispatch-cmd :private (args: (Vec str)) -> (Result i64 str)
  (if (empty? args)
      (Err usage)
      (let ((cmd (nth args 0))
            (rest (vec (drop 1 args))))
        (cond (= cmd "check") (check-cmd rest)
              (= cmd "run") (run-cmd rest)
              (= cmd "build") (build-cmd rest)
              (= cmd "link") (link-cmd rest)
              (= cmd "emit-llvm") (emit-llvm-cmd rest)
              (= cmd "dump-ast") (dump-ast-cmd rest)
              (= cmd "expand") (expand-cmd rest)
              (= cmd "respell") (respell-cmd rest)
              (= cmd "words") (words-cmd rest)
              (= cmd "cases") (cases-cmd rest)
              (= cmd "fuzz-one") (fuzz-one-cmd rest)
              (= cmd "fuzz") (fuzz/fuzz-cmd rest)
              :else (Err usage)))))
