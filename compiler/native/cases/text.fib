;; compiler/native/cases/text.fib: the small text helpers of the case harness: Rust's `str::lines` and the `{:?}` texts the Rust prints in its messages. OWNER: package H.
(ns native.cases.text
  (:require [fib.string :as s]))

;; The lines of `src` as Rust's `str::lines` makes them: split at "\n", a final empty piece dropped, one trailing "\r" taken off each.
(defun rust-lines (src: str) -> (Vec str)
  (let ((n (str-len src)))
    (loop ((from 0) (acc []))
      (cond (>= from n) acc
            :else (let ((e (unwrap-or (str-find src "\n" from) n))
                        (len (if (and (> e from) (= (str-byte-at src (- e 1)) 13i8)) (- (- e from) 1) (- e from))))
                    (recur (+ e 1) (conj acc (str-slice src from (+ from len)))))))))

(defun hex :private (n: i64) -> str
  (let ((d (str-slice "0123456789abcdef" (bit-and n 15) (+ (bit-and n 15) 1))))
    (if (< n 16) d (str-concat (hex (quot n 16)) d))))

(defun escape-byte :private (c: i64) -> str
  (cond (= c 34) "\\\""
        (= c 92) "\\\\"
        (= c 10) "\\n"
        (= c 13) "\\r"
        (= c 9) "\\t"
        (= c 0) "\\0"
        (or (< c 32) (= c 127)) (str-join ["\\u{" (hex c) "}"])
        :else ""))

;; `{:?}` of a str: quoted, with the escapes of Rust's `Debug` (ASCII controls; other characters are left as they are).
(defun debug-str (t: str) -> str
  (let ((n (str-len t)))
    (str-join ["\""
               (loop ((i 0) (from 0) (acc ""))
                 (if (>= i n)
                     (str-concat acc (str-slice t from n))
                     (let ((c (sext i64 (str-byte-at t i)))
                           (esc (if (and (>= c 0) (or (< c 32) (= c 34) (= c 92) (= c 127))) (escape-byte c) "")))
                       (if (= esc "")
                           (recur (+ i 1) from acc)
                           (recur (+ i 1) (+ i 1) (str-join [acc (str-slice t from i) esc]))))))
               "\""])))

;; `{:?}` of a `Vec<&str>` or `Vec<String>`: `["a", "b"]`.
(defun debug-strs (v: (Vec str)) -> str
  (str-join ["[" (s/join ", " (mapv debug-str v)) "]"]))
