;; compiler/native/target.fib: the host target machine (crates/lair/src/llvm/target.rs). OWNER: package L1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; `FIB_TARGET_CPU` names the CPU: unset, empty or `host` mean the host's. LLVM's target initialisation is called by every `machine-host` (it is
;; idempotent), because there is no global state to remember it in.

(ns native.target
  (:use native.error))


(defstruct Machine (tm: i64 triple: str data-layout: str))

;; Initialises the native target, asm printer and asm parser. (target.rs `init`)
(defun target-init () -> unit
  (trap "todo: native.target target-init"))

;; A target machine for the host at code-generation level `opt` (0 none, 1 less, 2 default, 3 aggressive), PIC. (target.rs `Machine::host`)
(defun machine-host (opt: i64) -> (Result Machine LairError)
  (trap "todo: native.target machine-host"))

;; (target.rs `Drop`)
(defun machine-dispose (m: Machine) -> unit
  (trap "todo: native.target machine-dispose"))

;; The CPU the environment asks for: nil for unset, empty or `host`. (target.rs `requested_cpu`)
(defun requested-cpu (var: (Option str)) -> (Option str)
  (trap "todo: native.target requested-cpu"))
