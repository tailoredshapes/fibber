;; compiler/native/target.fib: the host target machine (crates/lair/src/llvm/target.rs). OWNER: package L1.

;; `FIB_TARGET_CPU` names the CPU: unset, empty or `host` mean the host's. LLVM's target initialisation is called by every `machine-host` (it is
;; idempotent), because there is no global state to remember it in. The work is llvm.target's; this module is the lair-shaped face of it.

(ns native.target
  (:use lir.diag lir.ast native.error types.target types.targets)
  (:require [llvm.target :as lt]))


;; The code generation target of this run, as the front end and the emitter see it: the CPU `FIB_TARGET_CPU` names (with the features its
;; name stands for: none written), else the host's CPU and whole feature list. One decision for the checker's lane counts, the
;; module's `(target ..)` form and the machine `lair` builds, so that they agree. (design 2.9)
(defun target-info () -> Target
  (do (lt/init)
      (with-vector-bits
        (match (lt/requested-triple)
          ((some triple) (cross-target-info triple))
          (nil (match (lt/requested-cpu)
                 ((some cpu) (target-of-cpu cpu))
                 (nil (target-of-features (lt/host-cpu-name) (lt/host-features)))))))))

;; `FIB_VECTOR_BITS` (128, 256 or 512) sets the vector width `:native`, `f64xn` and `native-lanes` stand for, whatever the CPU says: a kernel
;; written over the native width then runs at that many lanes. A width the CPU lacks is legalised (split into the registers it has), so
;; 512 on an AVX2 machine is correct and runs at 256-bit speed: the way to test the 512-bit shape of a kernel without AVX-512 hardware.
;; Anything else is ignored.
(defun with-vector-bits :private (t: Target) -> Target
  (match (lt/env "FIB_VECTOR_BITS")
    ((some v) (cond (= v "128") (Target (. t cpu) (. t features) 128 (. t has-fma))
                    (= v "256") (Target (. t cpu) (. t features) 256 (. t has-fma))
                    (= v "512") (Target (. t cpu) (. t features) 512 (. t has-fma))
                    :else t))
    (nil t)))

;; The target of FIB_TARGET_TRIPLE `triple`: its row of types.targets (docs/design/targets.md) with the CPU of `lt/cross-cpu`: AArch64 128-bit
;; vectors (NEON; SVE is not assumed) and fast fma, wasm32 SIMD128 and no fma, riscv64 RV64GC with fma; a CPU named by FIB_TARGET_CPU
;; that the CPU table knows decides the width and fma instead.
(defun cross-target-info :private (triple: str) -> Target
  (target-of-row (with (target-row-of-triple triple) (features (lt/row-features (target-row-of-triple triple)))) (lt/cross-cpu triple) (some? (lt/requested-cpu))))

;; The machine for the code this run generates: the one `FIB_TARGET_TRIPLE` names, else the host's. Objects, assembly and IR come from it; the JIT
;; keeps `machine-host`, because it runs what it makes.
(defun machine-target (opt: i64) -> (Result Machine LairError)
  (match (lt/requested-triple)
    (nil (machine-host opt))
    ((some triple) (match (lt/cross-machine triple opt)
                     ((Err m) (Err (ErrBackend m)))
                     ((Ok m) (Ok (Machine (. m tm) (. m triple) (. m layout))))))))

;; The triple of this run when it is for a fully static executable (a row whose libc is musl: `fibc build --static`, docs/design/static-linking.md); nil otherwise.
;; Such a target links here, against the musl pieces, whatever the host is (native.linkstatic).
(defun static-triple () -> (Option str)
  (match (lt/requested-triple)
    (nil nil)
    ((some t) (if (= (. (target-row-of-triple t) libc) "musl") (some t) nil))))

;; The triple of this run when it is for WebAssembly under WASI (a row whose OS is `wasi`): `fibc build --target wasm32-wasi` links it with wasm-ld (native.linkwasm); nil otherwise.
(defun wasm-triple () -> (Option str)
  (match (lt/requested-triple)
    (nil nil)
    ((some t) (if (= (. (target-row-of-triple t) os) "wasi") (some t) nil))))

;; Whether the program is built as a library: `fibc build --export NAME` set FIB_EXPORTS, so there is no `main` to require (emit.compile).
(defun exports-requested? () -> bool
  (match (lt/env "FIB_EXPORTS") ((some e) (not (= e ""))) (nil false)))

;; Whether the run is for another target than the host: `FIB_TARGET_TRIPLE` is set. An executable cannot be linked for it here.
(defun cross-target? () -> bool
  (some? (lt/requested-triple)))

;; The row of FIB_TARGET_TRIPLE, nil for the host.
(defun requested-triple-row () -> (Option TargetRow)
  (match (lt/requested-triple) ((some t) (some (target-row-of-triple t))) (nil nil)))

(defstruct Machine (tm: i64 triple: str data-layout: str))

;; Initialises the native target, asm printer and asm parser. (target.rs `init`)
(defun target-init () -> unit
  (lt/init))

;; A target machine for the host at code-generation level `opt` (0 none, 1 less, 2 default, 3 aggressive), PIC. (target.rs `Machine::host`)
(defun machine-host (opt: i64) -> (Result Machine LairError)
  (match (lt/host-machine opt)
    ((Err m) (Err (ErrBackend m)))
    ((Ok m) (Ok (Machine (. m tm) (. m triple) (. m layout))))))

;; Whether the host can run code for the module's `target` form: `target: the host does not support +avx512f` for the first feature it lacks.
(defun target-runnable (m: LModule) -> (Result unit LairError)
  (match (module-target m)
    (nil (Ok ()))
    ((some t) (match (lt/host-lacks (. t features))
                ((some f) (Err (ErrInvalid [(diag-new (. t pos) (str "target: the host does not support " f))])))
                (nil (Ok ()))))))

;; (target.rs `Drop`)
(defun machine-dispose (m: Machine) -> unit
  (unsafe (lt/LLVMDisposeTargetMachine (. m tm))))

;; `--static` is the musl row of a Linux target (driver.static); a build for any other target says so, instead of blaming FIB_TARGET_TRIPLE, which `--static`
;; itself leaves set to the host's triple. `os-arch` names a triple as `OS-ARCH` (arm64-apple-darwin25.0 is darwin-arm64).
(defun os-arch :private (triple: str) -> str
  (let ((arch (match (str-find triple "-" 0) ((some i) (str-slice triple 0 i)) (nil triple)))
        (os (if (or (some? (str-find triple "darwin" 0)) (some? (str-find triple "apple" 0)) (some? (str-find triple "macos" 0)))
              "darwin"
              (match (str-find triple "-" 0)
                ((some i) (str-slice triple (+ i 1) (str-len triple)))
                (nil "unknown")))))
    (str os "-" arch)))

(defun static-refusal (triple: str host: str) -> str
  (str "--static builds are Linux-only (musl): " (if (= triple host) (str "this host is " (os-arch triple)) (str "the target is " triple))))

;; Some message when the run is a `--static` one (FIB_STATIC=1) for a target that has no musl row, else nil.
(defun static-refusal-now () -> (Option str)
  (if (and (= (unwrap-or (sys-getenv "FIB_STATIC") "") "1") (not (some? (static-triple))))
    (match (lt/requested-triple)
      ((some t) (some (static-refusal t (lt/host-triple))))
      (nil nil))
    nil))

;; The CPU the environment asks for: nil for unset, empty or `host`. (target.rs `requested_cpu`)
(defun requested-cpu (var: (Option str)) -> (Option str)
  (if-some [v var]
    (if (or (= v "") (= v "host")) nil (some v))
    nil))
