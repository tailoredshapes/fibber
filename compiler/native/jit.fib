;; compiler/native/jit.fib: a JIT session over ORC's LLJIT (crates/lair/src/jit/mod.rs `Jit`). OWNER: package J. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; Named `JitSession` and `session-*` so that it does not meet `lair.jit`'s `Jit` (the legacy bindings) in one program; `native.api` wraps it with the
;; names of `lair.jit`. End a session with `session-free`: its addresses die with it.

(ns native.jit
  (:use lir.diag lir.types lir.lit lir.ast native.error native.jit.names))


(defstruct JitSession
  (lljit: i64
   triple: str
   data-layout: str
   opt-level: i64
   ;; what every module so far defined and exported
   names: (Cell JitNames)))

;; A session at optimisation level `opt` (0 runs no IR optimisation, 1 to 3 `default<On>`), a target machine at the same level. (mod.rs `Jit::new`)
(defun session-new (opt: i64) -> (Result JitSession LairError)
  (trap "todo: native.jit session-new"))

;; As `session-new` with the code generator at level None whatever `opt` is (FastISel): for the compiler's own sessions. (mod.rs `Jit::new_fast_codegen`)
(defun session-new-fast-codegen (opt: i64) -> (Result JitSession LairError)
  (trap "todo: native.jit session-new-fast-codegen"))

;; Disposes the LLJIT; the addresses it gave out are dead. (mod.rs `Drop`)
(defun session-free (s: JitSession) -> unit
  (trap "todo: native.jit session-free"))

;; Parses, checks, lowers, verifies and adds a module. On `Err` nothing was added and the session stays usable. (mod.rs `add_source`)
(defun session-add-source (s: JitSession name: str src: str) -> (Result unit LairError)
  (trap "todo: native.jit session-add-source"))

;; Adds a module: `check`, the names rules, prune, lower, optimise, hand to ORC. (mod.rs `add_module`)
(defun session-add-module (s: JitSession name: str m: LModule) -> (Result unit LairError)
  (trap "todo: native.jit session-add-module"))

;; The lIR type of an exported function defined in this session. (mod.rs `signature`)
(defun session-signature (s: JitSession name: str) -> (Result LFnType LairError)
  (trap "todo: native.jit session-signature"))

;; The address of a `ccc` entry to `name`: the function itself when it is `ccc`, else a trampoline made once. (mod.rs `c_entry`)
(defun session-c-entry (s: JitSession name: str) -> (Result i64 LairError)
  (trap "todo: native.jit session-c-entry"))

;; The address of a defined function, compiled if need be. (mod.rs `address`)
(defun session-address (s: JitSession name: str) -> (Result i64 LairError)
  (trap "todo: native.jit session-address"))
