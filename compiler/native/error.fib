;; compiler/native/error.fib: the errors of the pipeline (crates/lair/src/error.rs `Error`). OWNER: package L1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; The type is real; the two printers are stubs. A handle of LLVM is an i64 everywhere in `native.*` (the convention of compiler/lair/ffi.fib).

(ns native.error
  (:use lir.diag))


;; The checker's diagnostics, or a failure of LLVM, the JIT or the linker (error.rs `Error`).
(defenum LairError
  (ErrInvalid diags: (Vec Diagnostic))      ;; the module is not valid lIR (spec/lir.md section 10)
  (ErrInternal message: str)                ;; LLVM rejected a module the checker accepted: a checker bug
  (ErrJit message: str)                     ;; the JIT failed to add a module or find a symbol
  (ErrBackend message: str))                ;; emitting code, writing a file or linking failed

;; Rendered with a file name in front of each diagnostic: `FILE:L:C: error: M` per line, else `FILE: ` and the display text. (error.rs `render`)
(defun lair-error-render (e: LairError file: str) -> str
  (trap "todo: native.error lair-error-render"))

;; The display text: the diagnostics one per line, `internal error: LLVM verifier rejected a checked module: M`, `error: jit: M`, `error: M`. (error.rs `Display`)
(defun lair-error-str (e: LairError) -> str
  (trap "todo: native.error lair-error-str"))

;; One diagnostic as an error. (error.rs `From<Diagnostic>`)
(defun lair-error-diag (d: Diagnostic) -> LairError
  (trap "todo: native.error lair-error-diag"))
