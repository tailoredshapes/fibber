;; compiler/native/pipeline.fib: the shared front half of every path: read, expand the macros (native.macros), parse, check, and for a program the
;; `main` rule (crates/lair/src/pipeline.rs). OWNER: package L1.

(ns native.pipeline
  (:use lir.diag lir.ast native.error native.owned native.target)
  (:require [native.imports :as imports] [lir.check :as check] [native.lower :as nl]))


;; Reads, expands, parses and checks the module `src`, the text of `file` ("" when it has none: `require-macros` and `import` are then
;; relative to the working directory), with the modules it imports (spec/lir.md 4.7): the program. (pipeline.rs `check_source`, with the
;; expansion of spec/lir.md 4.6 between reading and parsing)
(defun check-file (src: str file: str) -> (Result LModule LairError)
  (match (imports/load-program src file)
    ((Err d) (Err (ErrInvalid [d])))
    ((Ok p) (match (check/check (. p module))
              ((Err ds) (Err (ErrInvalid (mapv (fn (d: Diagnostic) (imports/explain-hidden (. p hidden) d)) ds))))
              ((Ok _) (Ok (. p module)))))))

;; `check-file` of a text with no file.
(defun check-source (src: str) -> (Result LModule LairError)
  (check-file src ""))

;; Parses and checks a module that will run as a program (`check-main`). (pipeline.rs `for_executable`)
(defun for-executable-file (src: str file: str) -> (Result LModule LairError)
  (match (check-file src file)
    ((Err e) (Err e))
    ((Ok m) (match (if (exports-requested?) (Ok ()) (check/check-main m))
              ((Err d) (Err (lair-error-diag d)))
              ((Ok _) (Ok m))))))

(defun for-executable (src: str) -> (Result LModule LairError)
  (for-executable-file src ""))

;; The verified, unoptimised LLVM IR of a module for the host: the text `lairf emit-llvm` prints. (pipeline.rs `emit_llvm`)
(defun emit-llvm (src: str name: str) -> (Result str LairError)
  (match (check-file src name)
    ((Err e) (Err e))
    ((Ok m) (match (machine-target 0)
              ((Err e) (Err e))
              ((Ok host) (let ((r (nl/lower m name (. host triple) (. host data-layout))))
                           (do (machine-dispose host)
                               (match r
                                 ((Err e) (Err e))
                                 ((Ok o) (let ((text (owned-ir o)))
                                           (do (owned-dispose o) (Ok text))))))))))))

;; Generated modules pass the same checks as external lIR source, without a reader.
(defun check-module (m: LModule) -> (Result LModule LairError)
  (match (check/check m) ((Err diagnostics) (Err (ErrInvalid diagnostics))) ((Ok _) (Ok m))))

(defun for-executable-module (m: LModule) -> (Result LModule LairError)
  (try-let ((checked (check-module m)))
    (match (if (exports-requested?) (Ok ()) (check/check-main checked))
      ((Err diagnostic) (Err (lair-error-diag diagnostic))) ((Ok _) (Ok checked)))))
