;; compiler/native/lower/lx.fib: the lowering state, shared by every lowering module (crates/lair/src/lower/mod.rs `Lx`, func.rs `Fx`, and the small helpers of both). OWNER: package L1.

;; ADDED TO THE MODULE MAP: Rust's `lower/mod.rs` is the parent of the other lowering files; fibber has no parent module, so the records they
;; share live in this leaf. `native.lower` is the facade with `lower`.
;;
;; The cycle of the lowering (lower/expr.rs `Fx::expr` is called by arith, calls and memory, which it calls) is closed as the checker's is
;; (lir.check.fcx): the per-function state `Fx` holds the expression lowerer in a field, set once by native.lower.func, and the instruction
;; modules call `fx-val` for their operands, in the order the Rust does. Their functions keep the Rust shape: `(lower-arith fx e)`.
;; An LLVM value, type, builder or block is an i64 handle; a void result is `(Option i64)` nil.

(ns native.lower.lx
  (:use lir.diag lir.types lir.lit lir.ast native.error))


;; A function of the module: its LLVM value and lIR type (the `(LLVMValueRef, FnType)` of `Lx::funcs`).
(defstruct FuncEntry (value: i64 ty: LFnType))

;; Module-level lowering state (mod.rs `Lx`). The maps are Cells: lowering declares structs, functions and globals first, then bodies.
(defstruct Lx
  (ctx: i64
   module: i64
   td: i64
   structs: (Cell (Map str i64))
   struct-fields: (Cell (Map str (Vec LType)))
   funcs: (Cell (Map str FuncEntry))
   globals: (Cell (Map str i64))
   ;; LLVM's number for lIR's `tailcc` on this module's target: the row's `tail-cc` (types.targets)
   tail-cc: i64
   ;; how a tail call is marked (LLVMTailCallKind): 2 musttail, 1 tail where the target has no tailcc: the row's `tail-kind`
   tail-kind: i64))

;; A phi to fix up after every block is lowered: the LLVM phi and its incoming bindings (func.rs `Fx::phis`).
(defstruct PhiFix (phi: i64 incoming: (Vec LBinding)))

;; Per-function lowering state (func.rs `Fx`).
(defstruct Fx
  (lx: Lx
   ;; the builder
   b: i64
   blocks: (Vec i64)
   labels: (Map str i64)
   names: (Cell (Map str i64))
   phis: (Cell (Vec PhiFix))
   ;; the dispatcher: lowers an expression (nil is void); set by native.lower.func to native.lower.expr/lower-expr
   expr: (fn (Fx LExpr) (Result (Option i64) LairError))))

;; LLVM's number for `tailcc`, 18. (mod.rs `TAILCC`)
(defun tailcc-number () -> i64
  18)

;; LLVM's calling convention number: 0 for ccc; for tailcc the target's (`Lx` `tail-cc`: 18, LLVM's tailcc, where the backend has it; the C
;; convention on WebAssembly, whose `musttail` is the tail-call feature's `return_call`; fastcc on RISC-V). (mod.rs `cc_number`)
(defun cc-number (lx: Lx cc: LCc) -> i64
  (match cc ((CcC) 0) ((CcTail) (. lx tail-cc))))

;; Lowers `e` through the dispatcher field. (expr.rs `Fx::expr`)
(defun fx-expr (fx: Fx e: LExpr) -> (Result (Option i64) LairError)
  ((. fx expr) fx e))

;; Lowers `e`, which must have a value. (expr.rs `Fx::val`)
(defun fx-val (fx: Fx e: LExpr) -> (Result i64 LairError)
  (match (fx-expr fx e)
    ((Err x) (Err x))
    ((Ok r) (match r
              ((some v) (Ok v))
              (nil (Err (ErrInternal (str "void value at " (pos-debug (. e pos))))))))))

;; A position as Rust's `{:?}` writes it: `Pos { line: 3, col: 7 }`.
(defun pos-debug (p: i64) -> str
  (str "Pos { line: " (pos-line p) ", col: " (pos-col p) " }"))
