;; Optional compiler phase timings; normal stdout and stderr stay unchanged.
(ns native.timing)

(defun started () -> i64 (sys-clock-now))
(defun elapsed-ms (t: i64) -> i64 (quot (- (sys-clock-now) t) 1000000))
(defun enabled? () -> bool (= (sys-getenv "FIB_TIME") (some "1")))
(defun report (phase: str t: i64) -> unit
  (when (enabled?) (eprintln (str "time " phase " " (elapsed-ms t) " ms"))))
