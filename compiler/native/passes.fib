;; compiler/native/passes.fib: LLVM's new pass manager: the `default<On>` pipelines (crates/lair/src/llvm/passes.rs). OWNER: package L1.

(ns native.passes
  (:use native.error)
  (:require [llvm.passes :as lp] [llvm.support :as support]))


;; The message of an LLVM error, consuming it; nil for success (the null error). (passes.rs `error_message`)
(defun error-message (e: i64) -> (Option str)
  (match (support/status e)
    ((Err m) (some m))
    ((Ok _) nil)))

;; Runs `default<On>` over the module (n = min level 3; level 0 runs nothing); `tm` may be 0. `optimisation failed: M`. (passes.rs `optimize`)
(defun optimize (module: i64 tm: i64 level: i64) -> (Result unit LairError)
  (match (lp/optimize module tm level)
    ((Err m) (Err (ErrBackend m)))
    ((Ok _) (Ok ()))))
