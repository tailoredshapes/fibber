;; compiler/native/call.fib: calling an address the JIT gave out, and the mailbox of a call the compiler answers: the names and signatures of `lair.call` (compiler/lair/call.fib). OWNER: package C. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; The cutover is a changed `:require`: every function below has the name, parameters and result of its namesake in compiler/lair/call.fib, and
;; `Hooks`, `Mailbox` and `Wait` the same fields and variants. How the shim is reached without a handle in the signature is the owner's: see
;; docs/design/lair-interfaces.md section 4.

(ns native.call)


(def max-args: i64 8)

(defstruct Hooks (one: i64 two: i64))

(defstruct Mailbox (handle: i64))

;; What `call-wait` found: the call returned, or the worker is parked at a hook call of this arity (1 or 2).
(defenum Wait (Done) (Hook arity: i64))

;; Calls the C-ABI function at addr with up to 8 integer arguments on the calling thread. (capi/call.rs `lair_call_i64`)
(defun call-i64 (addr: i64 args: (Vec i64)) -> (Result i64 str)
  (trap "todo: native.call call-i64"))

;; As `call-i64` for a function that returns a double. (capi/call.rs `lair_call_f64`)
(defun call-f64 (addr: i64 args: (Vec i64)) -> (Result f64 str)
  (trap "todo: native.call call-f64"))

;; The two hook pointers, `(cx, a) -> word` and `(cx, a, b) -> word`. (capi/mailbox.rs `lair_hook1_address`, `lair_hook2_address`)
(defun hook-addresses () -> Hooks
  (trap "todo: native.call hook-addresses"))

;; A new, idle mailbox. (capi/mailbox.rs `lair_call_new`)
(defun call-new () -> (Result Mailbox str)
  (trap "todo: native.call call-new"))

;; (capi/mailbox.rs `lair_call_free`)
(defun call-free (c: Mailbox) -> unit
  (trap "todo: native.call call-free"))

;; The text of the first misuse since the last accepted start, or nil. (capi/mailbox.rs `lair_call_fault`)
(defun call-fault (c: Mailbox) -> (Option str)
  (trap "todo: native.call call-fault"))

;; Runs the function on the mailbox's worker and returns at once. (capi/mailbox.rs `lair_call_start`)
(defun call-start (c: Mailbox addr: i64 args: (Vec i64)) -> (Result unit str)
  (trap "todo: native.call call-start"))

;; Blocks until the call returned or the worker is parked at a hook. (capi/mailbox.rs `lair_call_wait`)
(defun call-wait (c: Mailbox) -> (Result Wait str)
  (trap "todo: native.call call-wait"))

;; (capi/mailbox.rs `lair_call_hook_arg`)
(defun call-hook-arg (c: Mailbox i: i64) -> i64
  (trap "todo: native.call call-hook-arg"))

;; (capi/mailbox.rs `lair_call_hook_reply`)
(defun call-hook-reply (c: Mailbox v: i64) -> unit
  (trap "todo: native.call call-hook-reply"))

;; (capi/mailbox.rs `lair_call_result`)
(defun call-result (c: Mailbox) -> i64
  (trap "todo: native.call call-result"))
