;; compiler/native/support.fib: the lIR text of the mailbox protocol and of the call shim (crates/lair/src/capi/{exchange,mailbox,call}.rs). OWNER: package C.

;; Fibber cannot call a function address and cannot export a C function, so the call shim and the mailbox (with the hooks a macro-time module
;; calls) are lIR text, compiled once into a JIT session of the process (native.call holds it) and reached from fibber through libc:
;; `bsearch` (one element: it calls its comparison once, on the calling thread) and `pthread_create` (a thread whose stack has a chosen size).
;; docs/design/lair-in-fibber.md 1.5, option (a). native.call says how each function is called.
;;
;; The shim (`lair_shim_run REC`) calls the C function a record in memory names, with up to 8 integer-class and 8 double arguments, and
;; leaves the result in the record. `lair_shim_cmp` and `lair_shim_thread` are the two shapes of entry a libc function can call.
;; The mailbox (`lair_mb_*`) is capi/exchange.rs's state machine over a pthread mutex and two condition variables, with the worker thread
;; made by `pthread_create` on a 64 MiB stack; `lair_mb_hook1` and `lair_mb_hook2` are the hooks. Every function of both modules is exported.

(ns native.support)


;; The lIR module of the call shim: a record of words holding callee, up to eight integer-class and eight double arguments, and the result; `lair_shim_run` reads it, calls through the pointer with `ccc` and stores the result (integer or double). (capi/call.rs `invoke`, `invoke_f64`)
(defun shim-source () -> str
  ";; The call shim: calls the C function a record names. Record, in words: 0 callee, 1..8 the integer arguments, 9..16 the
;; double arguments (as bits), 17 the result (bits), 18 the result kind (0 integer or pointer, 1 double).
;; The call always passes six integers in registers, eight doubles in registers and two more integers on the stack, as the System V
;; ABI places each class independently: a callee of any mix of up to eight integer-class and eight double arguments finds
;; each where its prototype puts it, and ignores the rest.
(DEFINE (lair_shim_run VOID) ((PTR rec))
  (BLOCK entry
    (LET ((callee (INTTOPTR PTR (LOAD I64 rec)))
          (n0 (LOAD I64 (GETELEMENTPTR I64 rec (I64 1))))
          (n1 (LOAD I64 (GETELEMENTPTR I64 rec (I64 2))))
          (n2 (LOAD I64 (GETELEMENTPTR I64 rec (I64 3))))
          (n3 (LOAD I64 (GETELEMENTPTR I64 rec (I64 4))))
          (n4 (LOAD I64 (GETELEMENTPTR I64 rec (I64 5))))
          (n5 (LOAD I64 (GETELEMENTPTR I64 rec (I64 6))))
          (n6 (LOAD I64 (GETELEMENTPTR I64 rec (I64 7))))
          (n7 (LOAD I64 (GETELEMENTPTR I64 rec (I64 8))))
          (d0 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 9)))))
          (d1 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 10)))))
          (d2 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 11)))))
          (d3 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 12)))))
          (d4 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 13)))))
          (d5 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 14)))))
          (d6 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 15)))))
          (d7 (BITCAST DOUBLE (LOAD I64 (GETELEMENTPTR I64 rec (I64 16)))))
          (kind (LOAD I64 (GETELEMENTPTR I64 rec (I64 18)))))
      (BR (ICMP EQ kind (I64 0)) integer real)))
  (BLOCK integer
    (STORE (INDIRECT-CALL callee (FUNCTION I64 (I64 I64 I64 I64 I64 I64 DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE I64 I64))
                          n0 n1 n2 n3 n4 n5 d0 d1 d2 d3 d4 d5 d6 d7 n6 n7)
           (GETELEMENTPTR I64 rec (I64 17)))
    (RET))
  (BLOCK real
    (STORE (BITCAST I64 (INDIRECT-CALL callee (FUNCTION DOUBLE (I64 I64 I64 I64 I64 I64 DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE DOUBLE I64 I64))
                                       n0 n1 n2 n3 n4 n5 d0 d1 d2 d3 d4 d5 d6 d7 n6 n7))
           (GETELEMENTPTR I64 rec (I64 17)))
    (RET)))

;; libc's bsearch with one element calls its comparison once, on the calling thread, as (key, base): the way to run the shim here.
(DEFINE (lair_shim_cmp I32) ((PTR a) (PTR b))
  (BLOCK entry (CALL (GLOBAL lair_shim_run) a) (RET (I32 0))))

;; The start routine of a thread made by pthread_create: the way to run the shim on a stack of a chosen size.
(DEFINE (lair_shim_thread PTR) ((PTR rec))
  (BLOCK entry (CALL (GLOBAL lair_shim_run) rec) (RET (PTR NULL))))")

;; The lIR module of the mailbox: worker thread entry (`pthread_create`, 64 MiB stack), a mutex and two condition variables, the hooks of arity 1 and 2, and the state machine of `exchange.rs` with its defined misuse behaviour. It declares `lair_shim_run`, so the shim module is added first. (capi/exchange.rs, capi/mailbox.rs)
(defun mailbox-source () -> str
  (str-join [(mailbox-part-0) "\n" (mailbox-part-1) "\n" (mailbox-part-2) "\n" (mailbox-part-3) "\n" (mailbox-part-4) "\n" (mailbox-part-5) "\n" (mailbox-part-6) "\n" (mailbox-part-7) "\n" (mailbox-part-8) "\n" (mailbox-part-9) "\n" (mailbox-part-10) "\n" (mailbox-part-11)]))

;; Part 0 of the mailbox's text.
(defun mailbox-part-0 :private () -> str
  ";; The mailbox (crates/lair/src/capi/exchange.rs and mailbox.rs). A mailbox is 64 words: 0 state (0 idle, 1 running, 2 hook, 3 replied,
;; 4 done, 5 a nested call requested, 6 a nested call done), 1 arity, 2 a, 3 b, 4 reply, 5 result, 6 the worker's pthread_t, 7 1 when a worker has been made and not yet joined or
;; detached, 8 the fault text or null, 9 its length, 10 1 for a fault wait has not reported, 11 the reference count (the handle's and
;; the running worker's), 12 the worker's own pthread_self (0 until it runs), 13..31 the call shim's record, 32..39 the mutex (8 words: Darwin's pthread_mutex_t is 64 bytes, glibc's 40),
;; 40..47 the condition the compiler's thread sleeps on, 48..55 the condition the worker sleeps on.
(DECLARE lair_shim_run VOID (PTR))
(DECLARE malloc PTR (I64))
(DECLARE free VOID (PTR))
(DECLARE memset PTR (PTR I32 I64))
(DECLARE strlen I64 (PTR))
(DECLARE pthread_self I64 ())
(DECLARE pthread_create I32 (PTR PTR PTR PTR))
(DECLARE pthread_join I32 (I64 PTR))
(DECLARE pthread_detach I32 (I64))
(DECLARE pthread_attr_init I32 (PTR))
(DECLARE pthread_attr_setstacksize I32 (PTR I64))
(DECLARE pthread_attr_destroy I32 (PTR))
(DECLARE pthread_mutex_init I32 (PTR PTR))
(DECLARE pthread_mutex_destroy I32 (PTR))
(DECLARE pthread_mutex_lock I32 (PTR))
(DECLARE pthread_mutex_unlock I32 (PTR))
(DECLARE pthread_cond_init I32 (PTR PTR))
(DECLARE pthread_cond_destroy I32 (PTR))
(DECLARE pthread_cond_wait I32 (PTR PTR))
(DECLARE pthread_cond_broadcast I32 (PTR))

(DEFINE PRIVATE (w PTR) ((PTR mb) (I64 k))
  (BLOCK entry (RET (GETELEMENTPTR I64 mb k))))
(DEFINE PRIVATE (rd I64) ((PTR mb) (I64 k))
  (BLOCK entry (RET (LOAD I64 (CALL (GLOBAL w) mb k)))))
(DEFINE PRIVATE (wr VOID) ((PTR mb) (I64 k) (I64 v))
  (BLOCK entry (STORE v (CALL (GLOBAL w) mb k)) (RET)))
(DEFINE PRIVATE (lock VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_mutex_lock) (CALL (GLOBAL w) mb (I64 32))) (RET)))
(DEFINE PRIVATE (unlock VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_mutex_unlock) (CALL (GLOBAL w) mb (I64 32))) (RET)))
(DEFINE PRIVATE (wake-main VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_cond_broadcast) (CALL (GLOBAL w) mb (I64 40))) (RET)))
(DEFINE PRIVATE (wake-worker VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_cond_broadcast) (CALL (GLOBAL w) mb (I64 48))) (RET)))
(DEFINE PRIVATE (sleep-main VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_cond_wait) (CALL (GLOBAL w) mb (I64 40)) (CALL (GLOBAL w) mb (I64 32))) (RET)))
(DEFINE PRIVATE (sleep-worker VOID) ((PTR mb))
  (BLOCK entry (CALL (GLOBAL pthread_cond_wait) (CALL (GLOBAL w) mb (I64 48)) (CALL (GLOBAL w) mb (I64 32))) (RET)))")

;; Part 1 of the mailbox's text.
(defun mailbox-part-1 :private () -> str
  "
;; Records a misuse (the first text stays), has the next wait report it and wakes the compiler's thread. The lock is held.
(DEFINE PRIVATE (fault VOID) ((PTR mb) (PTR msg))
  (BLOCK entry (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 8)) (I64 0)) first rest))
  (BLOCK first
    (CALL (GLOBAL wr) mb (I64 8) (PTRTOINT I64 msg))
    (CALL (GLOBAL wr) mb (I64 9) (CALL (GLOBAL strlen) msg))
    (BR rest))
  (BLOCK rest
    (CALL (GLOBAL wr) mb (I64 10) (I64 1))
    (CALL (GLOBAL wake-main) mb)
    (RET)))

;; Drops one reference; the last frees the mailbox.
(DEFINE PRIVATE (release-ref VOID) ((PTR mb))
  (BLOCK entry
    (BR (ICMP EQ (ATOMICRMW SUB SEQ_CST (CALL (GLOBAL w) mb (I64 11)) (I64 1)) (I64 1)) last more))
  (BLOCK last
    (CALL (GLOBAL pthread_mutex_destroy) (CALL (GLOBAL w) mb (I64 32)))
    (CALL (GLOBAL pthread_cond_destroy) (CALL (GLOBAL w) mb (I64 40)))
    (CALL (GLOBAL pthread_cond_destroy) (CALL (GLOBAL w) mb (I64 48)))
    (CALL (GLOBAL free) mb)
    (RET))
  (BLOCK more (RET)))

;; lair_call_new: a new, idle mailbox.
(DEFINE (lair_mb_new PTR) ()
  (BLOCK entry
    (LET ((mb (CALL (GLOBAL malloc) (I64 512))))
      (CALL (GLOBAL memset) mb (I32 0) (I64 512))
      (CALL (GLOBAL wr) mb (I64 11) (I64 1))
      (CALL (GLOBAL pthread_mutex_init) (CALL (GLOBAL w) mb (I64 32)) (PTR NULL))
      (CALL (GLOBAL pthread_cond_init) (CALL (GLOBAL w) mb (I64 40)) (PTR NULL))
      (CALL (GLOBAL pthread_cond_init) (CALL (GLOBAL w) mb (I64 48)) (PTR NULL))
      (RET mb))))")

;; Part 2 of the mailbox's text.
(defun mailbox-part-2 :private () -> str
  "
;; The worker's body: the call, then the result.
(DEFINE PRIVATE (worker PTR) ((PTR mb))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (CALL (GLOBAL wr) mb (I64 12) (CALL (GLOBAL pthread_self)))
    (CALL (GLOBAL unlock) mb)
    (CALL (GLOBAL lair_shim_run) (CALL (GLOBAL w) mb (I64 13)))
    (CALL (GLOBAL lock) mb)
    (CALL (GLOBAL wr) mb (I64 5) (CALL (GLOBAL rd) mb (I64 30)))
    (CALL (GLOBAL wr) mb (I64 0) (I64 4))
    (CALL (GLOBAL wake-main) mb)
    (CALL (GLOBAL unlock) mb)
    (CALL (GLOBAL release-ref) mb)
    (RET (PTR NULL))))

;; Why a start is refused, as a text, or null. The lock is held.
(DEFINE PRIVATE (refusal PTR) ((PTR mb) (I64 addr) (I64 args) (I64 n))
  (BLOCK entry
    (BR (ICMP EQ args (I64 0)) null? many?))
  (BLOCK null?
    (BR (ICMP NE n (I64 0)) bad-null many?))
  (BLOCK bad-null (RET (STRING \"lair_call_start: args is null but n is not 0\")))
  (BLOCK many?
    (BR (ICMP UGT n (I64 8)) too-many state?))
  (BLOCK too-many (RET (STRING \"lair_call_start: more than 8 arguments\")))
  (BLOCK state?
    (LET ((state (CALL (GLOBAL rd) mb (I64 0))))
      (BR (ICMP EQ state (I64 0)) addr? done?)))
  (BLOCK done?
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 4)) addr? busy))
  (BLOCK busy (RET (STRING \"lair_call_start: a call is still running\")))
  (BLOCK addr?
    (BR (ICMP EQ addr (I64 0)) no-address ok))
  (BLOCK no-address (RET (STRING \"lair_call_start: the address is 0\")))
  (BLOCK ok (RET (PTR NULL))))")

;; Part 3 of the mailbox's text.
(defun mailbox-part-3 :private () -> str
  "
;; Writes the call into the shim's record: callee, the n arguments, zeros for the rest, the integer result kind.
(DEFINE PRIVATE (fill VOID) ((PTR mb) (I64 addr) (PTR args) (I64 n))
  (BLOCK entry
    (CALL (GLOBAL memset) (CALL (GLOBAL w) mb (I64 13)) (I32 0) (I64 152))
    (CALL (GLOBAL wr) mb (I64 13) addr)
    (BR loop))
  (BLOCK loop
    (LET ((i (PHI I64 (entry (I64 0)) (body i2))))
      (BR (ICMP ULT i n) body done)))
  (BLOCK body
    (LET ((v (LOAD I64 (GETELEMENTPTR I64 args i)))
          (i2 (ADD i (I64 1))))
      (CALL (GLOBAL wr) mb (ADD (I64 14) i) v)
      (BR loop)))
  (BLOCK done (RET)))")

;; Part 4 of the mailbox's text.
(defun mailbox-part-4 :private () -> str
  "
;; lair_call_start: runs addr with the n arguments at args on a worker thread of 64 MiB of stack.
(DEFINE (lair_mb_start VOID) ((PTR mb) (I64 addr) (PTR args) (I64 n))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (LET ((why (CALL (GLOBAL refusal) mb addr (PTRTOINT I64 args) n)))
      (BR (ICMP EQ why (PTR NULL)) accept refuse)))
  (BLOCK refuse
    (CALL (GLOBAL fault) mb why)
    (CALL (GLOBAL unlock) mb)
    (RET))
  (BLOCK accept
    (CALL (GLOBAL wr) mb (I64 8) (I64 0))
    (CALL (GLOBAL wr) mb (I64 9) (I64 0))
    (CALL (GLOBAL wr) mb (I64 10) (I64 0))
    (CALL (GLOBAL wr) mb (I64 0) (I64 1))
    (CALL (GLOBAL wr) mb (I64 12) (I64 0))
    (LET ((had (CALL (GLOBAL rd) mb (I64 7))))
      (CALL (GLOBAL wr) mb (I64 7) (I64 0))
      (CALL (GLOBAL unlock) mb)
      (BR (ICMP EQ had (I64 0)) spawn join-old)))
  (BLOCK join-old
    (CALL (GLOBAL pthread_join) (CALL (GLOBAL rd) mb (I64 6)) (PTR NULL))
    (BR spawn))
  (BLOCK spawn
    (CALL (GLOBAL fill) mb addr args n)
    (CALL (GLOBAL add-ref) mb)
    (LET ((made (CALL (GLOBAL spawn-thread) mb)))
      (CALL (GLOBAL lock) mb)
      (BR (ICMP EQ made (I32 0)) started failed)))
  (BLOCK started
    (CALL (GLOBAL wr) mb (I64 7) (I64 1))
    (CALL (GLOBAL unlock) mb)
    (RET))
  (BLOCK failed
    (CALL (GLOBAL wr) mb (I64 0) (I64 0))
    (CALL (GLOBAL fault) mb (STRING \"lair_call_start: no worker thread\"))
    (CALL (GLOBAL unlock) mb)
    (CALL (GLOBAL release-ref) mb)
    (RET)))

(DEFINE PRIVATE (add-ref VOID) ((PTR mb))
  (BLOCK entry (ATOMICRMW ADD SEQ_CST (CALL (GLOBAL w) mb (I64 11)) (I64 1)) (RET)))")

;; Part 5 of the mailbox's text.
(defun mailbox-part-5 :private () -> str
  "
;; pthread_create with a 64 MiB stack; the worker's thread id goes into word 6. 0 on success.
(DEFINE PRIVATE (spawn-thread I32) ((PTR mb))
  (BLOCK entry
    (LET ((attr (ALLOCA (ALIGN 8) I64 (I64 8)))) ; 64 bytes: pthread_attr_t is 56
      (CALL (GLOBAL pthread_attr_init) attr)
      (CALL (GLOBAL pthread_attr_setstacksize) attr (I64 67108864))
      (LET ((r (CALL (GLOBAL pthread_create) (CALL (GLOBAL w) mb (I64 6)) attr (GLOBAL worker) mb)))
        (CALL (GLOBAL pthread_attr_destroy) attr)
        (RET r)))))

;; lair_call_wait: 0 when the call returned, the arity of the hook it is parked at, 3 when a nested call (lair_mb_nest) returned, or -1
;; once after a misuse.
(DEFINE (lair_mb_wait I32) ((PTR mb))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR again))
  (BLOCK again
    (BR (ICMP NE (CALL (GLOBAL rd) mb (I64 10)) (I64 0)) reported look))
  (BLOCK reported
    (CALL (GLOBAL wr) mb (I64 10) (I64 0))
    (CALL (GLOBAL unlock) mb)
    (RET (I32 -1)))
  (BLOCK look
    (SWITCH (CALL (GLOBAL rd) mb (I64 0)) sleep ((I64 0) idle) ((I64 2) hooked) ((I64 4) done) ((I64 6) nested)))
  (BLOCK idle
    (CALL (GLOBAL fault) mb (STRING \"lair_call_wait: no call was started\"))
    (BR again))
  (BLOCK hooked
    (LET ((k (CALL (GLOBAL rd) mb (I64 1))))
      (CALL (GLOBAL unlock) mb)
      (RET (TRUNC I32 k))))
  (BLOCK done
    (CALL (GLOBAL unlock) mb)
    (RET (I32 0)))
  (BLOCK nested
    (CALL (GLOBAL unlock) mb)
    (RET (I32 3)))
  (BLOCK sleep
    (CALL (GLOBAL sleep-main) mb)
    (BR again)))")

;; Part 6 of the mailbox's text.
(defun mailbox-part-6 :private () -> str
  "
;; lair_mb_nest: while the worker is parked at a hook, runs the function at addr with the n integer arguments on that same worker, inside
;; the hook (its own hooks park as any do; the hook it was asked from is answered after it): the stack of the nested run is the worker's,
;; so a hook may be served by a run that hooks again, as deep as the stack goes. A nest with no hook waiting is a misuse.
(DEFINE (lair_mb_nest VOID) ((PTR mb) (I64 addr) (PTR args) (I64 n))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 2)) yes no))
  (BLOCK yes
    (CALL (GLOBAL fill) mb addr args n)
    (CALL (GLOBAL wr) mb (I64 0) (I64 5))
    (CALL (GLOBAL wake-worker) mb)
    (CALL (GLOBAL unlock) mb)
    (RET))
  (BLOCK no
    (CALL (GLOBAL fault) mb (STRING \"lair_mb_nest: no hook call is waiting\"))
    (CALL (GLOBAL unlock) mb)
    (RET)))

;; lair_mb_nest_result: the value the nested call returned (after lair_call_wait said 3), the worker parked again at the hook it was asked
;; from; else 0 and a fault.
(DEFINE (lair_mb_nest_result I64) ((PTR mb))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 6)) yes no))
  (BLOCK yes
    (LET ((v (CALL (GLOBAL rd) mb (I64 5))))
      (CALL (GLOBAL wr) mb (I64 0) (I64 2))
      (CALL (GLOBAL unlock) mb)
      (RET v)))
  (BLOCK no
    (CALL (GLOBAL fault) mb (STRING \"lair_mb_nest_result: no nested call has finished\"))
    (CALL (GLOBAL unlock) mb)
    (RET (I64 0))))")

;; Part 7 of the mailbox's text.
(defun mailbox-part-7 :private () -> str
  "
;; lair_call_hook_arg: argument i (0 or 1) of the hook the worker is parked at, else 0 and a fault.
(DEFINE (lair_mb_hook_arg I64) ((PTR mb) (I64 i))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 2)) parked none))
  (BLOCK parked
    (BR (ICMP ULT i (CALL (GLOBAL rd) mb (I64 1))) fine bad-index))
  (BLOCK fine
    (LET ((v (CALL (GLOBAL rd) mb (ADD (I64 2) i))))
      (CALL (GLOBAL unlock) mb)
      (RET v)))
  (BLOCK bad-index
    (CALL (GLOBAL fault) mb (STRING \"lair_call_hook_arg: the index is not below the arity\"))
    (CALL (GLOBAL unlock) mb)
    (RET (I64 0)))
  (BLOCK none
    (CALL (GLOBAL fault) mb (STRING \"lair_call_hook_arg: no hook call is waiting\"))
    (CALL (GLOBAL unlock) mb)
    (RET (I64 0))))

;; lair_call_hook_reply: answers the hook call the worker is parked at.
(DEFINE (lair_mb_hook_reply VOID) ((PTR mb) (I64 v))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 2)) yes no))
  (BLOCK yes
    (CALL (GLOBAL wr) mb (I64 4) v)
    (CALL (GLOBAL wr) mb (I64 0) (I64 3))
    (CALL (GLOBAL wake-worker) mb)
    (CALL (GLOBAL unlock) mb)
    (RET))
  (BLOCK no
    (CALL (GLOBAL fault) mb (STRING \"lair_call_hook_reply: no hook call is waiting\"))
    (CALL (GLOBAL unlock) mb)
    (RET)))")

;; Part 8 of the mailbox's text.
(defun mailbox-part-8 :private () -> str
  "
;; lair_call_result: the value the finished call returned, else 0 and a fault.
(DEFINE (lair_mb_result I64) ((PTR mb))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (BR (ICMP EQ (CALL (GLOBAL rd) mb (I64 0)) (I64 4)) yes no))
  (BLOCK yes
    (LET ((v (CALL (GLOBAL rd) mb (I64 5))))
      (CALL (GLOBAL unlock) mb)
      (RET v)))
  (BLOCK no
    (CALL (GLOBAL fault) mb (STRING \"lair_call_result: no call has finished\"))
    (CALL (GLOBAL unlock) mb)
    (RET (I64 0))))

;; lair_call_fault: the text of the first misuse since the last accepted start, or null; its length goes to *len.
(DEFINE (lair_mb_fault PTR) ((PTR mb) (PTR len))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (LET ((p (CALL (GLOBAL rd) mb (I64 8)))
          (n (CALL (GLOBAL rd) mb (I64 9))))
      (CALL (GLOBAL unlock) mb)
      (STORE n len)
      (RET (INTTOPTR PTR p)))))")

;; Part 9 of the mailbox's text.
(defun mailbox-part-9 :private () -> str
  "
;; lair_call_free: see capi/mailbox.rs. A finished or unused mailbox joins its worker; one that is still running is detached.
(DEFINE (lair_mb_free VOID) ((PTR mb))
  (BLOCK entry
    (CALL (GLOBAL lock) mb)
    (LET ((state (CALL (GLOBAL rd) mb (I64 0)))
          (had (CALL (GLOBAL rd) mb (I64 7)))
          (tid (CALL (GLOBAL rd) mb (I64 6))))
      (CALL (GLOBAL wr) mb (I64 7) (I64 0))
      (CALL (GLOBAL unlock) mb)
      (BR (ICMP EQ had (I64 0)) drop have)))
  (BLOCK have
    (BR (ICMP EQ state (I64 4)) join-it idle?))
  (BLOCK idle?
    (BR (ICMP EQ state (I64 0)) join-it detach-it))
  (BLOCK join-it
    (CALL (GLOBAL pthread_join) tid (PTR NULL))
    (BR drop))
  (BLOCK detach-it
    (CALL (GLOBAL pthread_detach) tid)
    (BR drop))
  (BLOCK drop
    (CALL (GLOBAL release-ref) mb)
    (RET)))")

;; Part 10 of the mailbox's text.
(defun mailbox-part-10 :private () -> str
  "
;; The hook of arity 1 or 2, called by module code with the mailbox as cx: parks the calling worker until the compiler answers.
(DEFINE PRIVATE (hook I64) ((PTR cx) (I64 arity) (I64 a) (I64 b))
  (BLOCK entry
    (BR (ICMP EQ cx (PTR NULL)) none live))
  (BLOCK none (RET (I64 0)))
  (BLOCK live
    (CALL (GLOBAL lock) cx)
    (BR (ICMP EQ (CALL (GLOBAL rd) cx (I64 0)) (I64 1)) mine? stranger))
  (BLOCK mine?
    (BR (ICMP EQ (CALL (GLOBAL rd) cx (I64 12)) (CALL (GLOBAL pthread_self))) park stranger))
  (BLOCK stranger
    (CALL (GLOBAL fault) cx (STRING \"a hook was called outside its call's worker thread\"))
    (CALL (GLOBAL unlock) cx)
    (RET (I64 0)))
  (BLOCK park
    (CALL (GLOBAL wr) cx (I64 0) (I64 2))
    (CALL (GLOBAL wr) cx (I64 1) arity)
    (CALL (GLOBAL wr) cx (I64 2) a)
    (CALL (GLOBAL wr) cx (I64 3) b)
    (CALL (GLOBAL wake-main) cx)
    (BR check))
  (BLOCK check
    (SWITCH (CALL (GLOBAL rd) cx (I64 0)) waiting ((I64 3) answered) ((I64 5) nested)))
  (BLOCK waiting
    (CALL (GLOBAL sleep-worker) cx)
    (BR check))
  (BLOCK nested
    (CALL (GLOBAL wr) cx (I64 0) (I64 1))
    (CALL (GLOBAL unlock) cx)
    (CALL (GLOBAL lair_shim_run) (CALL (GLOBAL w) cx (I64 13)))
    (CALL (GLOBAL lock) cx)
    (CALL (GLOBAL wr) cx (I64 5) (CALL (GLOBAL rd) cx (I64 30)))
    (CALL (GLOBAL wr) cx (I64 0) (I64 6))
    (CALL (GLOBAL wake-main) cx)
    (BR check))
  (BLOCK answered
    (CALL (GLOBAL wr) cx (I64 0) (I64 1))
    (LET ((r (CALL (GLOBAL rd) cx (I64 4))))
      (CALL (GLOBAL unlock) cx)
      (RET r))))

(DEFINE (lair_mb_hook1 I64) ((PTR cx) (I64 a))
  (BLOCK entry (RET (CALL (GLOBAL hook) cx (I64 1) a (I64 0)))))")

;; Part 11 of the mailbox's text.
(defun mailbox-part-11 :private () -> str
  "(DEFINE (lair_mb_hook2 I64) ((PTR cx) (I64 a) (I64 b))
  (BLOCK entry (RET (CALL (GLOBAL hook) cx (I64 2) a b))))")
