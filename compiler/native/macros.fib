;; compiler/native/macros.fib: the compile-time macros of lIR (spec/lir.md 4.6): `define-macro`, `require-macros`, and the expansion of a
;; module's forms between reading them and parsing them. A macro is an lIR function from s-expression objects to one, compiled into a JIT
;; session of the module's own when it is defined (native.jit, as compiler/macros/runner.fib compiles fibber's macros) and called through
;; native.call when it is used. A module that defines no macro pays one atom comparison per top-level form and nothing else: `top-form`
;; hands the form straight to the parser (lir.parse.items), and the forms are still read, parsed and freed one at a time. `(import "FILE")`
;; (spec/lir.md 4.7) is read here and answered by the loader the caller passes in (native.imports). The reader forms (spec/lir.md 4.8) are
;; parsed by native.macros.readforms; a reader macro is compiled here as a macro is, and bound in the module's readtable, which the reader
;; consults (native.macros.readers runs them).
(ns native.macros
  (:use lir.diag lir.sexp lir.ast lir.types native.error native.macros.types native.macros.helpers)
  (:require [lir.parse.items :as items] [lir.parse.names :as names] [native.jit :as jit] [native.call :as call]
            [native.macros.objects :as obj] [native.macros.lib :as lib] [native.macros.readlib :as readlib]
            [native.macros.readers :as readers] [native.macros.readforms :as rf] [native.timing :as timing]))

;; The module's own file counts as being loaded: a library that requires it is a cycle.
(defun env-new :private (file: str gensym: i64) -> Env
  (Env file (file-cstr file) (cell (map-empty)) (cell nil) (cell (set-empty)) (cell (if (= file "") (set-empty) #{(canonical file)})) (cell 0)
       (readers/readers-new) (cell 0) (cell nil) (cell []) gensym))

;; Reads `src` (the text of `file`) into forms, and expands and parses each as it is read: lir.parse `parse-source` with the expansion between,
;; and `(import ..)` answered by the importer. The environment comes back open: the caller closes it (`env-close`) when no module can use
;; its macros any more (native.imports, at the end of the program).
(defun parse-module (src: str file: str importer: Importer) -> (Result Parsed Diagnostic)
  (let ((env (env-new file (. importer gensym))) (items (cell (vec-empty))))
    (match (match (readers/read-with (. env readers) src file (fn (form: Sexp) (top-form env items importer form)))
             ((some d) (some d))
             (nil (apply-hook env items importer)))
      ((some d) (do (env-close env) (Err d)))
      (nil (Ok (Parsed env (LModule @items)))))))

;; Frees the module's worker (its reader macros' and its macros') and streams, and its macro session, if it made one.
(defun env-close (env: Env) -> unit
  (do (readers/readers-close (. env readers))
      (match @(. env session)
        (nil ())
        ((some s) (do (jit/session-free (. s jit))
                      (when (timing/enabled?) (eprintln (str "time lir.macros " (quot @(. env ns) 1000000) " ms"))))))))

;; One top-level form: collected for the module macro once one is armed (spec/lir.md 4.6: read, not expanded, directions included, as an
;; object naming the file it was read from), except an include, which acts there: the file's forms are collected in its place; else a
;; direction (a macro's definition, a library of them, an import, a macro-import, the module macro, an include), a splice, or a form expanded
;; and parsed. A macro use is applied first (`top-result`, the children untouched), so that a result that is a splice is seen before
;; anything in it is expanded.
(defun top-form :private (env: Env items: (Cell (Vec LItem)) importer: Importer form: Sexp) -> (Option Diagnostic)
  (match @(. env hook)
    ((some _) (if (= (head-of form) "include")
                  (include env items importer form)
                  (do (set! (. env collected) (conj @(. env collected) (obj/to-object form (. env cfile)))) nil)))
    (nil (top-direction env items importer form))))

(defun top-direction :private (env: Env items: (Cell (Vec LItem)) importer: Importer form: Sexp) -> (Option Diagnostic)
  (let ((head (head-of form)))
    (cond (= head "define-macro") (define-macro env form)
          (= head "require-macros") (require-macros env form)
          (= head "import") (import-form env importer form)
          (= head "macro-import") (macro-import env form)
          (= head "module-macro") (module-macro env form)
          (= head "include") (include env items importer form)
          (rf/reader-form? head) (define-reader env head form)
          (rf/reader-setting? head) (rf/define-reader-setting (. (. env readers) table) head form)
          :else (match (top-result env form)
                  ((Err d) (some d))
                  ((Ok r) (if (= (head-of r) "begin") (splice env items importer r) (parse-top env items r)))))))

;; `(begin FORM..)` at the top level (spec/lir.md 4.6, written or returned by a macro): each form a top-level form in order, in its place;
;; a splice in a splice flattens by this recursion, and a spliced `define-macro` defines its macro for the forms after it.
(defun splice :private (env: Env items: (Cell (Vec LItem)) importer: Importer r: Sexp) -> (Option Diagnostic)
  (match r
    ((SxList xs _ _)
     (loop ((i 1))
       (if (>= i (count xs))
           nil
           (match (top-form env items importer (nth xs i))
             ((some d) (some d))
             (nil (recur (+ i 1)))))))
    (_ nil)))

;; The form, its children expanded, parsed as an item (every symbol a macro made an atom to the parser: `sexp-plain`, needed only where a
;; macro or a reader macro could have run).
(defun parse-top :private (env: Env items: (Cell (Vec LItem)) r: Sexp) -> (Option Diagnostic)
  (match (if (empty? @(. env macros)) (Ok r) (expand env r))
    ((Err d) (some d))
    ((Ok f) (match (items/parse-item (if (or (not (empty? @(. env macros))) @(. (. (. env readers) table) active)) (sexp-plain f) f))
              ((Err d) (some d))
              ((Ok it) (do (update! items (fn (v) (conj v it))) nil))))))

;; A top-level form with the macro at its head applied (`top-use`) and nothing else; a form that is no use, as it is.
(defun top-result :private (env: Env form: Sexp) -> (Result Sexp Diagnostic)
  (match form
    ((SxList its pos _) (match (macro-of env its)
                        ((some m) (top-use env m its pos 0))
                        (nil (Ok form))))
    (_ (Ok form))))

;; ---------------------------------------------------------------- expansion

(defun macro-of :private (env: Env its: (Vec Sexp)) -> (Option Macro)
  (if (empty? its) nil (match (sexp-atom (nth its 0)) ((some a) (get @(. env macros) a)) (nil nil))))

(defun expand-all :private (env: Env its: (Vec Sexp)) -> (Result (Vec Sexp) Diagnostic)
  (loop ((i 0) (out []))
    (if (>= i (count its))
        (Ok out)
        (match (expand env (nth its i)) ((Err d) (Err d)) ((Ok f) (recur (+ i 1) (conj out f)))))))

;; Every macro use in the form replaced by its expansion, outermost first: a use is replaced by what the macro returns, that is expanded
;; again while its head names a macro, and then its children are expanded. The arguments of a use reach the macro unexpanded.
(defun expand :private (env: Env form: Sexp) -> (Result Sexp Diagnostic)
  (match form
    ((SxList its pos sp) (match (macro-of env its)
                           ((some m) (expand-use env m its pos 0))
                           (nil (match (expand-all env its) ((Err d) (Err d)) ((Ok xs) (Ok (SxList xs pos sp)))))))
    ((SxBrace its pos sp) (match (expand-all env its) ((Err d) (Err d)) ((Ok xs) (Ok (SxBrace xs pos sp)))))
    ((SxBracket its pos sp) (match (expand-all env its) ((Err d) (Err d)) ((Ok xs) (Ok (SxBracket xs pos sp)))))
    (_ (Ok form))))

;; A use inside a form: `top-use`, then the children; a result that is a splice has no place inside a form.
(defun expand-use :private (env: Env m: Macro its: (Vec Sexp) pos: i64 steps: i64) -> (Result Sexp Diagnostic)
  (match (top-use env m its pos steps)
    ((Err d) (Err d))
    ((Ok out) (if (= (head-of out) "begin")
                  (err pos (str "macro " (. m name) ": a splice (begin ..) is a top-level form, not an instruction"))
                  (expand env out)))))

;; The use replaced by what the macro returns, again while the result's head names a macro; the children are left as they are.
(defun top-use :private (env: Env m: Macro its: (Vec Sexp) pos: i64 steps: i64) -> (Result Sexp Diagnostic)
  (if (>= steps max-steps)
      (err pos (str "macro " (. m name) ": the expansion does not end after " max-steps " steps"))
      (match (apply-macro env m its pos)
        ((Err d) (Err d))
        ((Ok out) (match out
                    ((SxList xs p _) (match (macro-of env xs)
                                     ((some m2) (top-use env m2 xs p (+ steps 1)))
                                     (nil (Ok out))))
                    (_ (Ok out)))))))

;; The use `its` (the macro's name first, at `pos`) replaced by what the macro returns.
(defun apply-macro :private (env: Env m: Macro its: (Vec Sexp) pos: i64) -> (Result Sexp Diagnostic)
  (apply-objects env m (mapv (fn (f: Sexp) (obj/to-object f (. env cfile))) (names/vec-from its 1)) pos))

;; The macro applied to the arguments `objs`, objects already (each naming its own file), at `pos`.
(defun apply-objects :private (env: Env m: Macro objs: (Vec i64) pos: i64) -> (Result Sexp Diagnostic)
  (let ((n (count objs)) (t0 (sys-clock-now)))
    (if (or (< n (. m fixed)) (and (not (. m rest)) (> n (. m fixed))))
        (err pos (str "macro " (. m name) " expects " (arity-text m) ", found " n))
        (let ((r (run-entry env m (object-arguments m objs pos (. env cfile)) pos)))
          (do (set! (. env ns) (+ @(. env ns) (- (sys-clock-now) t0)))
              (match r
                ((Err d) (Err d))
                ((Ok a) (if (= a 0)
                            (Err (failure m pos))
                            (match (obj/from-object a pos)
                              ((Ok f) (Ok f))
                              ((Err e) (err pos (str "macro " (. m name) " returned " e))))))))))))

;; ---------------------------------------------------------------- running an entry

;; Runs the macro's entry on the worker of its module (the one its reader macros run on, `readers`) and answers its hook calls; the word it
;; returned, or the error of a nested expansion. A run asked for while one is in progress (the expander answering `lir.sexp.expand`) is
;; nested on the worker inside the hook; one count of runs for the worker, the readers', whichever kind of macro runs.
(defun run-entry :private (env: Env m: Macro args: (Vec i64) pos: i64) -> (Result i64 Diagnostic)
  (let ((s (. m session)) (rs (. s readers)))
    (try-let ((mb (str-err (readers/mailbox-of rs) m pos)))
      (let ((nested (> @(. rs running) 0)))
        (do (set! (. rs running) (+ @(. rs running) 1))
            (let ((r (try-let ((_ (str-err (if nested (call/call-nest mb (. m entry) args) (call/call-start mb (. m entry) args)) m pos)))
                       (serve env s mb m pos))))
              (do (set! (. rs running) (- @(. rs running) 1))
                  (match @(. s pending)
                    ((some d2) (do (set! (. s pending) nil) (Err d2)))
                    (nil r)))))))))

;; Answers the hooks until the call (or the nested call) returns: a hook of arity 1 is `lir.sexp.expand`.
(defun serve :private (env: Env s: Session mb: call/Mailbox m: Macro pos: i64) -> (Result i64 Diagnostic)
  (loop ()
    (match (call/call-wait mb)
      ((Err e) (err pos (str "macro " (. m name) ": " e)))
      ((Ok (call/Done)) (Ok (call/call-result mb)))
      ((Ok (call/Nested)) (Ok (call/call-nest-result mb)))
      ((Ok (call/Hook k))
       (do (call/call-hook-reply mb (if (= k 1) (answer-expand env s (call/call-hook-arg mb 0) pos) 0))
           (recur))))))

;; `lir.sexp.expand` of the object at `a`: the form expanded through the module's macros (as `expand`, outermost first), as an object;
;; null, and the error kept for the use, when the expansion fails.
(defun answer-expand :private (env: Env s: Session a: i64 pos: i64) -> i64
  (match (obj/from-object a pos)
    ((Err e) (do (set! (. s pending) (some (Diagnostic pos (str "lir.sexp.expand: " e)))) 0))
    ((Ok f) (match (expand env f)
              ((Err d) (do (set! (. s pending) (some d)) 0))
              ((Ok out) (obj/to-object out (. env cfile)))))))

;; ---------------------------------------------------------------- the session

;; A fast-codegen session with the library in it, the runner's entries, the program's gensym word `g` given to it (spec/lir.md 4.6: every
;; module's session counts in it), and `lir.sexp.expand` told to park on the module's worker (`rs`'s, made now if no reader macro made it):
;; a reader macro that calls it is answered null by its runner.
(defun session-new :private (rs: readers/Readers g: i64) -> (Result Session str)
  (try-let ((j (lair-str (jit/session-new-fast-codegen 0)))
            (_ (lair-str (jit/session-add-source j "lir.sexp" (lib/lib-source))))
            (_ (lair-str (jit/session-add-source j "lir.read" (readlib/lib-source))))
            (take (lair-str (jit/session-address j "lir.sexp.failure-take")))
            (at (lair-str (jit/session-address j "lir.sexp.failure-at")))
            (set-hook (lair-str (jit/session-address j "lir.sexp.set-hook")))
            (give-cell (lair-str (jit/session-address j "lir.sexp.gensym-cell")))
            (_ (call/call-i64 give-cell [g]))
            (mb (readers/mailbox-of rs))
            (_ (call/call-i64 set-hook [(. (call/hook-addresses) one) (. mb handle)])))
    (Ok (Session j take at set-hook rs (cell nil) (cell (map-empty)) (cell (set-empty)) (cell [])))))

(defun session-of :private (env: Env) -> (Result Session str)
  (match @(. env session)
    ((some s) (Ok s))
    (nil (match (session-new (. env readers) (. env gensym))
           ((Err e) (Err e))
           ((Ok s) (do (set! (. env session) (some s)) (Ok s)))))))

;; ---------------------------------------------------------------- define-macro

;; The items of a macro's module: the library's declarations, the earlier macros', the macro-imported modules' interfaces, then the definition.
(defun macro-module :private (env: Env s: Session def: Sexp) -> (Result LModule Diagnostic)
  (try-let ((forms (read (str (lib/declares-source) "\n" (readlib/declares-source) "\n" (macro-declares env s)))))
    (loop ((i 0) (out []))
      (if (>= i (count forms))
          (match (items/parse-item (sexp-plain def)) ((Err d) (Err d)) ((Ok it) (Ok (LModule (conj (into out @(. s iface)) it)))))
          (match (items/parse-item (nth forms i)) ((Err d) (Err d)) ((Ok it) (recur (+ i 1) (conj out it))))))))

;; `(define-macro NAME (PARAM..) BLOCK..)`: the blocks are expanded with the macros so far, then compiled.
(defun define-macro :private (env: Env form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (if (< (count its) 4)
         (some (Diagnostic pos "define-macro expects NAME, (PARAM..) and blocks"))
         (match (try-let ((name (macro-name env (nth its 1)))
                          (ps (macro-params (nth its 2)))
                          (blocks (expand-all env (names/vec-from its 3))))
                  (compile-macro env name ps blocks pos))
           ((Err d) (some d))
           ((Ok _) nil))))
    (_ (some (Diagnostic (sexp-pos form) "define-macro expects NAME, (PARAM..) and blocks")))))

;; Compiles the macro into the session and records it.
(defun compile-macro :private (env: Env name: str ps: Params blocks: (Vec Sexp) pos: i64) -> (Result unit Diagnostic)
  (try-let ((s (match (session-of env) ((Err e) (err pos (str "macro " name ": " e))) ((Ok s) (Ok s))))
            (entry (compile-entry env s (str "macro " name) (str "lir.macro." name) ps blocks pos)))
    (do (set! (. env macros) (assoc @(. env macros) name (Macro name entry (- (count (. ps names)) (if (. ps rest) 1 0)) (. ps rest) (. env file) (. s take) (. s at) s)))
        (Ok ()))))

;; The function `fname` of parameters `ps` and body `blocks` compiled into the session `s`: its address. Errors carry `what` (`macro NAME`,
;; `reader macro [`).
(defun compile-entry :private (env: Env s: Session what: str fname: str ps: Params blocks: (Vec Sexp) pos: i64) -> (Result i64 Diagnostic)
  (let ((t0 (sys-clock-now)))
    (try-let ((m (macro-module env s (macro-define fname ps blocks pos)))
              (_ (match (jit/session-add-module (. s jit) (str "macro." fname) m) ((Err e) (Err (module-error what e pos))) ((Ok _) (Ok ()))))
              (entry (match (jit/session-address (. s jit) fname) ((Err e) (Err (module-error what e pos))) ((Ok a) (Ok a)))))
      (do (set! (. env ns) (+ @(. env ns) (- (sys-clock-now) t0)))
          (Ok entry)))))

;; ---------------------------------------------------------------- reader macros (spec/lir.md 4.8)

;; `(define-reader-macro "C" (STREAM) BLOCK..)`, `(define-dispatch-macro "C" (STREAM) BLOCK..)`, `(define-token-reader (STREAM TOKEN) BLOCK..)`
;; (parsed by native.macros.readforms): the body expanded with the macros so far and compiled as a macro's is, under a name of its own,
;; and bound in the module's readtable for the forms after this one.
(defun define-reader :private (env: Env head: str form: Sexp) -> (Option Diagnostic)
  (match (try-let ((d (rf/parse-reader head form (. env seq)))
                   (blocks (expand-all env (. d blocks)))
                   (s (match (session-of env) ((Err e) (err (. d pos) (str (. d what) ": " e))) ((Ok s) (Ok s))))
                   (entry (compile-entry env s (. d what) (. d fname) (Params (. d names) false) blocks (. d pos))))
           (Ok (rf/bind! (. (. env readers) table) d entry)))
    ((Err d) (some d))
    ((Ok _) nil)))

;; ---------------------------------------------------------------- require-macros

;; `(import "FILE")` (spec/lir.md 4.7): the form is checked here, the module is the importer's.
(defun import-form :private (env: Env importer: Importer form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (if (not (= (count its) 2))
         (some (Diagnostic pos "import expects one string, the file"))
         (match (nth its 1)
           ((SxStr bs _ _) ((. importer load) env (str-from-bytes bs) pos))
           (other (some (Diagnostic (sexp-pos other) (str "import expects a string, found " (sexp-describe other))))))))
    (_ (some (Diagnostic (sexp-pos form) "import expects one string, the file")))))

;; The macros a module defined in its own file (not those it required or imported), for an importer of it.
(defun own-macros (env: Env) -> (Vec Macro)
  (vec (filter (fn (m: Macro) (= (. m file) (. env file))) (vals @(. env macros)))))

;; Defines in `env` a macro of an imported module, at the import at `pos`.
(defun define-imported (env: Env m: Macro pos: i64) -> (Option Diagnostic)
  (if (some? (get @(. env macros) (. m name)))
      (some (Diagnostic pos (str "duplicate macro " (. m name))))
      (do (set! (. env macros) (assoc @(. env macros) (. m name) m)) nil)))

;; `(require-macros "FILE")`.
(defun require-macros :private (env: Env form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (if (not (= (count its) 2))
         (some (Diagnostic pos "require-macros expects one string, the file"))
         (match (nth its 1)
           ((SxStr bs _ _) (load-library env (resolve env (str-from-bytes bs)) pos))
           (other (some (Diagnostic (sexp-pos other) (str "require-macros expects a string, found " (sexp-describe other))))))))
    (_ (some (Diagnostic (sexp-pos form) "require-macros expects one string, the file")))))

;; The macros of the file `path` defined in `env`, once per module (the file identified by its canonical path, named as written); a file
;; that requires itself, through others or not, is a cycle.
(defun load-library :private (env: Env path: str pos: i64) -> (Option Diagnostic)
  (let ((key (canonical path)))
    (cond (set-contains? @(. env loaded) key) nil
          (set-contains? @(. env loading) key) (some (Diagnostic pos (str "require-macros: " path " requires itself")))
          :else (load-library-text env path key pos))))

(defun load-library-text :private (env: Env path: str key: str pos: i64) -> (Option Diagnostic)
  (match (read-file path)
                (nil (some (Diagnostic pos (str "require-macros: cannot read " path))))
                ((some text)
                 (let ((sub (env-sub env path)))
                   (do (set! (. env loading) (conj @(. env loading) key))
                       (let ((r (readers/read-with (. env readers) text path (fn (f: Sexp) (library-form sub f)))))
                         (do (set! (. env loading) (disj @(. env loading) key))
                             (set! (. env loaded) (conj @(. env loaded) key))
                             (match r
                               (nil nil)
                               ((some d) (some (Diagnostic pos (str "require-macros: " path ":" (diag-str d)))))))))))))

;; A form of a macro library: a definition (of a macro or a reader macro) or another library, nothing else (a library is no module: there is
;; nothing to link its items into, and it imports nothing).
(defun library-form :private (env: Env form: Sexp) -> (Option Diagnostic)
  (let ((head (head-of form)))
    (cond (= head "define-macro") (define-macro env form)
          (= head "require-macros") (require-macros env form)
          (= head "macro-import") (macro-import env form)
          (= head "module-macro") (module-macro env form)
          (rf/reader-form? head) (define-reader env head form)
          (rf/reader-setting? head) (rf/define-reader-setting (. (. env readers) table) head form)
          :else (some (Diagnostic (sexp-pos form) (str "expected define-macro or require-macros, found " (sexp-describe form)))))))

;; ---------------------------------------------------------------- macro-import (spec/lir.md 4.6)

;; `(macro-import "FILE")`: the module FILE compiled into the macro session, once per session by canonical path, its structs, external
;; defines and globals declared in the macro bodies after it; neither linked into the program nor exported.
(defun macro-import :private (env: Env form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (if (not (= (count its) 2))
         (some (Diagnostic pos "macro-import expects one string, the file"))
         (match (nth its 1)
           ((SxStr bs _ _) (match (session-of env)
                           ((Err e) (some (Diagnostic pos (str "macro-import: " e))))
                           ((Ok s) (match (session-import s (resolve env (str-from-bytes bs)) pos (. env gensym)) ((Err d) (some d)) ((Ok _) nil)))))
           (other (some (Diagnostic (sexp-pos other) (str "macro-import expects a string, found " (sexp-describe other))))))))
    (_ (some (Diagnostic (sexp-pos form) "macro-import expects one string, the file")))))

;; The module `path` compiled into the session `s`, once; its interface items. A module being compiled that is imported again is a cycle.
(defun session-import :private (s: Session path: str pos: i64 g: i64) -> (Result (Vec LItem) Diagnostic)
  (let ((key (canonical path)))
    (match (get @(. s imported) key)
      ((some iface) (Ok iface))
      (nil (cond (set-contains? @(. s importing) key) (err pos (str "macro-import: " path " imports itself"))
                 :else (match (read-file path)
                         (nil (err pos (str "macro-import: cannot read " path)))
                         ((some text) (session-import-text s path key text pos g))))))))

;; The module read and expanded as a module of its own (its `import`s macro-imported into the session the same way, their interfaces its
;; declarations, its macros counting in the program's gensym word `g`), checked and added to the session; its interface kept for the bodies after.
(defun session-import-text :private (s: Session path: str key: str text: str pos: i64 g: i64) -> (Result (Vec LItem) Diagnostic)
  (let ((deps (cell []))
        (importer (Importer (fn (env2: Env p: str at: i64)
                              (match (session-import s (resolve env2 p) at g)
                                ((Err d) (some d))
                                ((Ok iface) (do (set! deps (into @deps iface)) nil))))
                            g)))
    (do (set! (. s importing) (conj @(. s importing) key))
        (let ((r (parse-module text path importer)))
          (do (set! (. s importing) (disj @(. s importing) key))
              (match r
                ((Err d) (err pos (str "macro-import: " path ":" (diag-str d))))
                ((Ok p) (do (env-close (. p env))
                            (session-add-import s path key (LModule (into @deps (. (. p module) items))) (interface-items (. p module)) pos)))))))))

(defun session-add-import :private (s: Session path: str key: str m: LModule iface: (Vec LItem) pos: i64) -> (Result (Vec LItem) Diagnostic)
  (match (jit/session-add-module (. s jit) (str "macro-import." path) m)
    ((Err e) (Err (module-error (str "macro-import " path) e pos)))
    ((Ok _) (do (set! (. s imported) (assoc @(. s imported) key iface))
                (set! (. s iface) (into @(. s iface) iface))
                (Ok iface)))))

;; ---------------------------------------------------------------- module-macro (spec/lir.md 4.6)

;; `(module-macro NAME)`: from here to the end of the text the forms are collected, read and not expanded; at the end NAME, a macro with a
;; `...` parameter, is applied to them and its result is a top-level form.
(defun module-macro :private (env: Env form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (cond (not (= (count its) 2)) (some (Diagnostic pos "module-macro expects one name, the macro"))
           (some? @(. env hook)) (some (Diagnostic pos "module-macro: the module has a module macro already"))
           :else (match (sexp-atom (nth its 1))
                   ((some n) (match (get @(. env macros) n)
                               (nil (some (Diagnostic (sexp-pos (nth its 1)) (str "module-macro: " n " is not a macro"))))
                               ((some m) (if (. m rest)
                                             (do (set! (. env hook) (some (Pair m pos))) nil)
                                             (some (Diagnostic (sexp-pos (nth its 1)) (str "module-macro: " n " takes no ... parameter")))))))
                   (nil (some (Diagnostic (sexp-pos (nth its 1)) (str "module-macro expects a name, found " (sexp-describe (nth its 1)))))))))
    (_ (some (Diagnostic (sexp-pos form) "module-macro expects one name, the macro")))))

;; At the end of the text: the module macro applied to the forms collected, disarmed first; its result a top-level form (a splice, usually).
;; A `module-macro` the result splices arms again and takes the rest of the splice: it is applied in turn, until none is armed.
(defun apply-hook :private (env: Env items: (Cell (Vec LItem)) importer: Importer) -> (Option Diagnostic)
  (loop ((steps 0))
    (match @(. env hook)
      (nil nil)
      ((some h)
       (let ((m (. h fst)) (pos (. h snd)) (forms @(. env collected)))
         (do (set! (. env hook) nil)
             (set! (. env collected) [])
             (cond (>= steps max-steps) (some (Diagnostic pos (str "module-macro: " max-steps " module macros in a row")))
                   :else (match (apply-objects env m forms pos)
                           ((Err d) (some d))
                           ((Ok r) (match (top-form env items importer r)
                                     ((some d) (some d))
                                     (nil (recur (+ steps 1)))))))))))))

;; ---------------------------------------------------------------- include (spec/lir.md 4.6)

;; `(include "FILE")`: the file's text read in place under the module's readtable, its forms as if written here (positions name FILE),
;; once per module by canonical path; a file that includes itself is a cycle. With a module macro armed, its forms are collected (`top-form`).
(defun include :private (env: Env items: (Cell (Vec LItem)) importer: Importer form: Sexp) -> (Option Diagnostic)
  (match form
    ((SxList its pos _)
     (if (not (= (count its) 2))
         (some (Diagnostic pos "include expects one string, the file"))
         (match (nth its 1)
           ((SxStr bs _ _) (include-file env items importer (resolve env (str-from-bytes bs)) pos))
           (other (some (Diagnostic (sexp-pos other) (str "include expects a string, found " (sexp-describe other))))))))
    (_ (some (Diagnostic (sexp-pos form) "include expects one string, the file")))))

(defun include-file :private (env: Env items: (Cell (Vec LItem)) importer: Importer path: str pos: i64) -> (Option Diagnostic)
  (let ((key (canonical path)))
    (cond (set-contains? @(. env loaded) key) nil
          (set-contains? @(. env loading) key) (some (Diagnostic pos (str "include: " path " includes itself")))
          :else (match (read-file path)
                  (nil (some (Diagnostic pos (str "include: cannot read " path))))
                  ((some text)
                   (let ((sub (env-sub env path)))
                     (do (set! (. env loading) (conj @(. env loading) key))
                         (let ((r (readers/read-with (. env readers) text path (fn (f: Sexp) (top-form sub items importer f)))))
                           (do (set! (. env loading) (disj @(. env loading) key))
                               (set! (. env loaded) (conj @(. env loaded) key))
                               (match r
                                 (nil nil)
                                 ((some d) (some (Diagnostic pos (str "include: " path ":" (diag-str d))))))))))))))
)
