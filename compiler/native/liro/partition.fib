;; Stable bounded groups of definitions, each with only its required declarations.
;; Program-local IDs remain in the checked bodies and glue initializers. The front
;; end emits them again for every build; a changed number changes its owner's key.
(ns native.liro.partition
  (:use lir.ast lir.types native.liro.deps)
  (:require [lir.check.walk :as walk]))

(defstruct LiroIndex (symbols: (Map str LItem) structs: (Map str LStructDef) target: (Vec LItem) inlines: (Set str)))
(defun symbol-name (it: LItem) -> str
  (match it
    ((ItDefine f) (. f name)) ((ItGlobal g) (. g name))
    ((ItDeclare f) (. f name)) ((ItDeclareGlobal g) (. g name)) (_ "")))
(defun defined? (it: LItem) -> bool (match it ((ItDefine _) true) ((ItGlobal _) true) (_ false)))
(defun index-of (m: LModule) -> LiroIndex
  (reduce (fn (acc: LiroIndex it: LItem)
            (match it
              ((ItStruct s) (with acc (structs (assoc (. acc structs) (. s name) s))))
              ((ItTarget _) (with acc (target (conj (. acc target) it))))
              ((ItDefine f) (with acc (symbols (assoc (. acc symbols) (. f name) it))
                                      (inlines (if (. (. f mods) inline) (conj (. acc inlines) (. f name)) (. acc inlines)))))
              (_ (with acc (symbols (assoc (. acc symbols) (symbol-name it) it))))))
          (LiroIndex {} {} [] (set-empty)) (. m items)))

(defun exported (it: LItem) -> LItem
  (match it
    ((ItDefine f) (ItDefine (if (= (. (. f mods) linkage) LkExternal) f (with f (mods (with (. f mods) (linkage LkExternal) (hidden true)))))))
    ((ItGlobal g) (ItGlobal (if (= (. (. g mods) linkage) LkExternal) g (with g (mods (LModifiers LkExternal true false false false))))))
    (_ it)))
(defun declaration (it: LItem) -> LItem
  (match it
    ((ItDefine f) (ItDeclare (LDeclare (. f name) (. f ty) (. (. f mods) hidden) (. f pos))))
    ((ItGlobal g) (ItDeclareGlobal (LGlobalDecl (. g name) (. g ty) (. (. g mods) hidden) (. g pos))))
    (_ it)))

;; Opt-in experiment knobs (docs/design/compile-performance.md); the defaults are the 16 hash groups of ADR 0024.
;; FIB_LIRO_UNITS=N: N code groups. FIB_LIRO_SPLIT=hash|ns1|ns2|ns3: group by the function-name hash, or by the hash of the
;; first 1, 2 or 3 dotted segments of its namespace (functions of one namespace stay together, so they can inline into one another).
(defun split-count () -> i64
  (match (sys-getenv "FIB_LIRO_UNITS")
    ((some s) (match (parse-long s) ((some n) (if (> n 0) n 16)) (nil 16)))
    (nil 16)))
(defun strip-kind (n: str) -> str
  (cond (starts-with? n "l.") (strip-kind (str-slice n 2 (str-len n)))
        (starts-with? n "f.") (str-slice n 2 (str-len n))
        :else n))
(defun segments (n: str k: i64) -> str
  (loop ((i 0) (seen 0))
    (cond (>= i (str-len n)) n
          (= (str-byte-at n i) 46i8) (if (= (+ seen 1) k) (str-slice n 0 i) (recur (+ i 1) (+ seen 1)))
          :else (recur (+ i 1) seen))))
(defun split-key (n: str mode: str) -> str
  (cond (= mode "ns1") (segments (strip-kind n) 1)
        (= mode "ns2") (segments (strip-kind n) 2)
        (= mode "ns3") (segments (strip-kind n) 3)
        :else n))

;; The unit of a closure specialisation (emit.mono `inst-name`: `NAME#I#CODE#`) and of a literal made in one (`l.NAME#I#CODE#.N`): that
;; of the innermost code it knows, the text after its last `#I#` up to the closing `#`, so that the specialisation and the literal it
;; calls directly are one unit and LLVM can put the literal in line in its loop (in different units the direct call measured slower than
;; the call through the closure it replaced). Any other name is its own.
(defun spec-home (n: str) -> str
  (let ((at (last-opener n)))
    (if (< at 0) n (str-slice n at (loop ((j at)) (if (or (>= j (str-len n)) (= (str-byte-at n j) 35i8)) j (recur (+ j 1))))))))

;; The index just after the last `#DIGITS#` of `n`, or -1.
(defun last-opener :private (n: str) -> i64
  (loop ((i 0) (at -1))
    (if (>= i (str-len n))
        at
        (if (= (str-byte-at n i) 35i8)
            (let ((j (loop ((j (+ i 1))) (if (and (< j (str-len n)) (>= (str-byte-at n j) 48i8) (<= (str-byte-at n j) 57i8)) (recur (+ j 1)) j))))
              (if (and (> j (+ i 1)) (< j (str-len n)) (= (str-byte-at n j) 35i8)) (recur (+ j 1) (+ j 1)) (recur (+ i 1) at)))
            (recur (+ i 1) at)))))

(defun bucket (it: LItem count: i64 mode: str) -> str
  (match it
    ((ItGlobal _) "glue")
    ((ItDefine f) (let ((n (. f name)))
      (cond (starts-with? n "fib.") "runtime"
            (or (starts-with? n "drop.") (starts-with? n "trace.") (starts-with? n "share.")) "walkers"
            :else (str "code-" (rem (bit-and (hash (split-key (spec-home n) mode)) 1073741823) count)))))
    (_ "")))
(defun groups-of (m: LModule) -> (Map str (Vec LItem))
  (let ((count (split-count)) (mode (unwrap-or (sys-getenv "FIB_LIRO_SPLIT") "hash")))
    (reduce (fn (groups: (Map str (Vec LItem)) it: LItem)
              (if (defined? it) (let ((b (bucket it count mode))) (assoc groups b (conj (unwrap-or (get groups b) []) (exported it)))) groups))
            {} (. m items))))

(defun needed-structs (idx: LiroIndex d: LiroDeps) -> (Vec LItem)
  (let ((work (cell (vec @(. d structs)))) (done (cell (set-empty))) (out (cell [])))
    (do (loop ((i 0))
          (when (< i (count @work))
            (let ((n (nth @work i)))
              (do (when (not (contains? @done n))
                    (do (set! done (conj @done n))
                        (match (get (. idx structs) n)
                          (nil ())
                          ((some s) (let ((kids (deps-new)))
                            (do (item-deps kids (ItStruct s)) (set! out (conj @out (ItStruct s)))
                                (set! work (into @work (vec @(. kids structs))))))))))
                  (recur (+ i 1))))))
        (vec (sort-by (fn (it: LItem) (match it ((ItStruct s) (. s name)) (_ ""))) @out)))))

(defun unit-module (idx: LiroIndex defs: (Vec LItem)) -> LModule
  (let ((d (deps-new)) (own (set (mapv symbol-name defs))))
    (do (doseq [it defs] (item-deps d it))
        (let ((imports (vec (keep (fn (n: str)
                              (if (contains? own n) nil
                                  (match (get (. idx symbols) n) ((some it) (some (declaration (exported it)))) (nil nil))))
                            (sort (vec @(. d symbols)))))))
          (do (doseq [it imports] (item-deps d it))
              (LModule (into (into (into (. idx target) (needed-structs idx d)) imports)
                             (vec (sort-by symbol-name defs)))))))))

;; Opt-in cross-unit inlining (experiment): FIB_LIRO_IMPORT=T copies every function of at most T expression nodes that a unit
;; calls into that unit as an internal definition, so LLVM can inline it; FIB_LIRO_IMPORT_DEPTH=D (default 2) rounds of copies
;; (a copy's own callees are copied the next round). The owner keeps the one external definition; the glue unit gets none (a global
;; initializer must name the owner). T=0 (default) copies nothing, except the functions written `inline` (spec/lir.md 4.3): they are always copied into
;; every unit that calls them, whatever their size, because `alwaysinline` cannot inline a call into another unit.
(defun env-count (name: str default: i64) -> i64
  (match (sys-getenv name) ((some s) (unwrap-or (parse-long s) default)) (nil default)))
(defun count-expr (acc: (Cell i64) e: LExpr) -> unit
  (do (set! acc (+ @acc 1)) (doseq [k (walk/children e)] (count-expr acc k))))
(defun fn-size (f: LFunction) -> i64
  (let ((acc (cell 0))) (do (doseq [b (. f blocks)] (doseq [e (. b body)] (count-expr acc e))) @acc)))
(defun small-def (idx: LiroIndex n: str limit: i64) -> (Option LItem)
  (match (get (. idx symbols) n)
    ((some it) (match it ((ItDefine f) (if (or (contains? (. idx inlines) n) (<= (fn-size f) limit)) (some (internal-copy it)) nil)) (_ nil)))
    (nil nil)))
(defun internal-copy (it: LItem) -> LItem
  (match it ((ItDefine f) (ItDefine (with f (mods (with (. f mods) (linkage LkInternal) (hidden false)))))) (_ it)))
(defun wanted (defs: (Vec LItem) own: (Set str)) -> (Vec str)
  (let ((d (deps-new)))
    (do (doseq [it defs] (item-deps d it))
        (vec (sort (vec (filter (fn (n: str) (not (contains? own n))) (vec @(. d symbols)))))))))
(defun copies-of (idx: LiroIndex defs: (Vec LItem) limit: i64 depth: i64) -> (Vec LItem)
  (loop ((round 0) (frontier defs) (own (set (mapv symbol-name defs))) (out []))
    (if (= round depth) out
        (let ((picked (vec (keep (fn (n: str) (small-def idx n limit)) (wanted frontier own)))))
          (if (= (count picked) 0) out
              (recur (+ round 1) picked (into own (mapv symbol-name picked)) (into out picked)))))))
(defun unit-defs (idx: LiroIndex defs: (Vec LItem)) -> (Vec LItem)
  (let ((limit (env-count "FIB_LIRO_IMPORT" 0)))
    (if (and (<= limit 0) (= (count (. idx inlines)) 0))
        defs
        (into defs (copies-of idx defs limit (env-count "FIB_LIRO_IMPORT_DEPTH" 2))))))

(defun modules-with (m: LModule copy: bool) -> (Vec LModule)
  (let ((idx (index-of m)) (groups (groups-of m)))
    (mapv (fn (name: str)
            (let ((defs (unwrap-or (get groups name) [])))
              (unit-module idx (if (and copy (not (= name "glue"))) (unit-defs idx defs) defs))))
          (vec (sort (keys groups))))))
(defun modules (m: LModule) -> (Vec LModule) (modules-with m false))
;; Whether the module has a function written `inline` (spec/lir.md 4.3): it is copied into the units that call it.
(defun has-inline? (m: LModule) -> bool
  (some? (first (filter (fn (it: LItem) (match it ((ItDefine f) (. (. f mods) inline)) (_ false))) (. m items)))))
(defun copying? (m: LModule) -> bool (or (> (env-count "FIB_LIRO_IMPORT" 0) 0) (has-inline? m)))
;; The units to compile: `modules` plus the copies, which are checked after the plain units were validated.
(defun modules-to-compile (m: LModule) -> (Vec LModule) (modules-with m (copying? m)))
(defun validation-units (m: LModule units: (Vec LModule)) -> (Vec LModule)
  (if (and (> (count units) 1) (copying? m)) (modules m) units))
