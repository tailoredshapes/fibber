;; Native executable builds through LIRO; unsupported link targets retain AOT.
(ns native.liro.build
  (:use lir.ast native.error native.liro.context)
  (:require [native.aot :as aot] [native.target :as target] [native.link :as link]
            [native.liro.compile :as compile] [native.liro.partition :as partition]
            [native.liro.contract :as contract] [native.timing :as timing] [native.liro.parallel :as par] [llvm.target :as lt]))

(defun eligible? () -> bool
  (and (or (par/opted-in?) (not (= (sys-getenv "FIB_LIRO_CACHE") (some "off"))))
       (not (target/cross-target?)) (nil? (target/static-triple)) (nil? (target/wasm-triple))))

(defun build-cached (m: LModule path: str opts: aot/AotOptions) -> (Result unit LairError)
  (try-let [dirs (aot/library-dirs (. opts lib-dirs)) c (context-new (. opts opt-level))]
    (let ((units (if (= (sys-getenv "FIB_LIRO_MODE") (some "whole")) [m] (partition/modules-to-compile m))))
    (let ((result (match (compile-units c m units (. opts opt-level))
                    ((Err e) (Err e))
                    ((Ok objects) (let ((t (timing/started))
                                    (r (link/link-paths-with (thin-args c (. opts opt-level)) objects path dirs (. opts libs))))
                                (do (timing/report "link" t) r))))))
      (do (context-close c) result)))))

;; The ThinLTO spike's link: LLVM's gold plugin (GNU ld loads it too) imports across the units, finishes the pipeline and generates code,
;; with its cache beside the unit cache. FIB_LIRO_THIN_PLUGIN names the plugin, FIB_LIRO_THIN_JOBS its backend threads (default 6).
(defun thin-args (c: LiroContext opt: i64) -> (Vec str)
  (if (not (thin?)) []
      (let ((plugin (unwrap-or (sys-getenv "FIB_LIRO_THIN_PLUGIN") "/usr/lib/llvm-21/lib/LLVMgold.so"))
            (base [(str "-Wl,-plugin," plugin) (str "-Wl,-plugin-opt=O" (max 1 (min opt 3))) (str "-Wl,-plugin-opt=mcpu=" (lt/host-cpu-name))
                   (str "-Wl,-plugin-opt=jobs=" (unwrap-or (sys-getenv "FIB_LIRO_THIN_JOBS") "6"))]))
        (if (= (. c cache) "") base (conj base (str "-Wl,-plugin-opt=cache-dir=" (. c cache) "/thinlto"))))))

(defun compile-units (c: LiroContext original: LModule units: (Vec LModule) opt: i64) -> (Result (Vec str) LairError)
  (try-let [_ (error-result (contract/validate-units original (partition/validation-units original units)))]
  (do (par/report-units units)
  (if (= (. c cache) "")
      (par/compile-parallel c units opt (par/jobs))
      (loop ((i 0) (objects []))
        (if (= i (count units)) (Ok objects)
            (try-let [obj (compile/compile-object c (nth units i) opt)]
              (recur (+ i 1) (conj objects obj)))))))))

(defun build-executable (m: LModule name: str path: str opts: aot/AotOptions) -> (Result unit LairError)
  (if (eligible?) (build-cached m path opts) (aot/aot-build-executable m name path opts)))
