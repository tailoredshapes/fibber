;; compiler/native/aot.fib: ahead-of-time compilation: an object, assembly or LLVM IR, and executables (crates/lair/src/aot.rs). OWNER: package A. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

(ns native.aot
  (:use lir.diag lir.types lir.lit lir.ast native.error native.link))


;; What `aot-emit` produces (aot.rs `Output`).
(defenum AotOutput OutObject OutAssembly OutLlvmIr)

;; AOT settings (aot.rs `Options`): the level 0 to 3, the libraries to link (`-l`, after the module's own code), and the directories that hold
;; them (`-L`, each also an absolute rpath).
(defstruct AotOptions (opt-level: i64 libs: (Vec str) lib-dirs: (Vec str)))

;; Compiles a checked module for the host: lower, optimise, emit. (aot.rs `emit`)
(defun aot-emit (m: LModule name: str out: AotOutput opts: AotOptions) -> (Result (Array i8) LairError)
  (trap "todo: native.aot aot-emit"))

;; Compiles a module that satisfies the `main` rule and links it into an executable at `path`. (aot.rs `build_executable`)
(defun aot-build-executable (m: LModule name: str path: str opts: AotOptions) -> (Result unit LairError)
  (trap "todo: native.aot aot-build-executable"))
