;; compiler/native/macros/readlib.fib: the stream of a reader macro (spec/lir.md 4.7), as lIR text: compiled into the macro session beside
;; the form library (native.macros.lib), and declared in every macro's module (`declares-source`). The stream is a struct the host
;; (native.macros.readers) fills from the reader's cursor before a reader macro runs and reads back after: the text and its length, the
;; byte offset, the line and the column, the file, the mailbox and the hook that reach the host (`lir.read.form`, `lir.read.skip`), and the
;; failure a macro records with `lir.read.fail`. The layout is the contract: the host reads and writes it from fibber.
(ns native.macros.readlib)

;; What a macro's module declares of the stream's functions.
(defun declares-source () -> str
  "(DECLARE lir.read.peek I64 (PTR))
(DECLARE lir.read.peek-at I64 (PTR I64))
(DECLARE lir.read.next I64 (PTR))
(DECLARE lir.read.position I64 (PTR))
(DECLARE lir.read.offset I64 (PTR))
(DECLARE lir.read.skip I64 (PTR))
(DECLARE lir.read.form PTR (PTR))
(DECLARE lir.read.fail PTR (PTR I64 PTR))
(DECLARE lir.read.failed I1 (PTR))
")

;; The library's module.
(defun lib-source () -> str
  (str-join [(part-0) "\n" (part-1)]))

(defun part-0 :private () -> str
  ";; lir.read: the stream of a reader macro (spec/lir.md 4.8): text, length, offset, line, column, file, mailbox, hook, failure message,
;; failure position, and whether a form the macro asked for could not be read.
(DEFSTRUCT lir.read.stream (PTR I64 I64 I64 I64 PTR PTR PTR PTR I64 I64))

(DEFINE (lir.read.failed I1) ((PTR s))
  (BLOCK entry
    (RET (OR (ICMP NE (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 10))) (I64 0))
             (ICMP NE (LOAD PTR (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 8))) (PTR NULL))))))

(DEFINE (lir.read.peek I64) ((PTR s))
  (BLOCK entry
    (LET ((off (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 2))))
          (n (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 1)))))
      (BR (ICMP ULT off n) in out)))
  (BLOCK in (RET (ZEXT I64 (LOAD I8 (GETELEMENTPTR I8 (LOAD PTR s) off)))))
  (BLOCK out (RET (I64 -1))))

(DEFINE (lir.read.next I64) ((PTR s))
  (BLOCK entry
    (LET ((b (CALL (GLOBAL lir.read.peek) s)))
      (BR (ICMP SLT b (I64 0)) end more)))
  (BLOCK end (RET (I64 -1)))
  (BLOCK more
    (LET ((offp (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 2))))
      (STORE (ADD (LOAD I64 offp) (I64 1)) offp)
      (BR (ICMP EQ b (I64 10)) newline same)))
  (BLOCK newline
    (LET ((linep (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 3))))
      (STORE (ADD (LOAD I64 linep) (I64 1)) linep)
      (STORE (I64 1) (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 4)))
      (RET b)))
  (BLOCK same (BR (ICMP EQ (AND b (I64 192)) (I64 128)) cont col))
  (BLOCK cont (RET b))
  (BLOCK col
    (LET ((colp (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 4))))
      (STORE (ADD (LOAD I64 colp) (I64 1)) colp)
      (RET b))))
")

(defun part-1 :private () -> str
  "(DEFINE (lir.read.position I64) ((PTR s))
  (BLOCK entry
    (RET (OR (SHL (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 3))) (I64 32))
             (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 4)))))))

;; the byte offset of the stream in its text, what a span is made of (spec/lir.md 4.8)
(DEFINE (lir.read.offset I64) ((PTR s)) (BLOCK entry (RET (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 2))))))

;; the byte n bytes from the cursor (n < 0: behind it), -1 outside the text; nothing is consumed (spec/lir.md 4.8)
(DEFINE (lir.read.peek-at I64) ((PTR s) (I64 n))
  (BLOCK entry
    (LET ((k (ADD (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 2))) n))
          (len (LOAD I64 (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 1)))))
      (BR (ICMP ULT k len) in out)))
  (BLOCK in (RET (ZEXT I64 (LOAD I8 (GETELEMENTPTR I8 (LOAD PTR s) k)))))
  (BLOCK out (RET (I64 -1))))

(DEFINE INTERNAL (lir.read.hook I64) ((PTR s) (I64 code))
  (BLOCK entry
    (RET (INDIRECT-CALL (LOAD PTR (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 7))) (FUNCTION I64 (PTR I64 I64))
                        (LOAD PTR (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 6))) (PTRTOINT I64 s) code))))

(DEFINE (lir.read.form PTR) ((PTR s)) (BLOCK entry (RET (INTTOPTR PTR (CALL (GLOBAL lir.read.hook) s (I64 0))))))
(DEFINE (lir.read.skip I64) ((PTR s)) (BLOCK entry (RET (CALL (GLOBAL lir.read.hook) s (I64 1)))))

(DEFINE (lir.read.fail PTR) ((PTR s) (I64 at) (PTR message))
  (BLOCK entry
    (STORE message (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 8)))
    (STORE at (GETELEMENTPTR (STRUCT lir.read.stream) s (I64 0) (I32 9)))
    (RET (PTR NULL))))
")
