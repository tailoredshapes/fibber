;; compiler/native/jit/trampoline.fib: a `ccc` entry to a `tailcc` function (spec/lir.md section 11; crates/lair/src/jit/trampoline.rs). OWNER: package J.

(ns native.jit.trampoline
  (:use lir.types))


;; The name of `name`'s trampoline: `NAME.tramp`. (trampoline.rs `name_of`)
(defun tramp-name (name: str) -> str
  (str name ".tramp"))

;; The lIR source of the trampoline for `name : ty`, a `tailcc` function defined in the session. (trampoline.rs `source`)
(defun tramp-source (name: str ty: LFnType) -> str
  (let ((ret (ret-str (. ty ret)))
        (params (vec (map (fn (i: i64) -> str (str "(" (type-str (nth (. ty params) i)) " a" i ")")) (range (count (. ty params))))))
        (args (vec (map (fn (i: i64) -> str (str "a" i)) (range (count (. ty params)))))))
    (let ((call (str "(call @" name " " (str-join-with " " args) ")"))
          (body (match (. ty ret)
                  ((some _) (str "(ret " call ")"))
                  (nil (str call " (ret)")))))
      (str "(declare tailcc " name " " ret " " (fn-params-str ty) ")\n"
           "(define (" (tramp-name name) " " ret ") (" (str-join-with " " params) ") (block entry " body "))\n"))))
