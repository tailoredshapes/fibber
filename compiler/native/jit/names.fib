;; compiler/native/jit/names.fib: the cross-module namespace of a JIT session (spec/lir.md section 11; crates/lair/src/jit/names.rs). OWNER: package J. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; The Rust `Names` is mutated by `record`; here the value is persistent: `names-record` returns the new one and the session keeps it in a Cell.

(ns native.jit.names
  (:use lir.diag lir.types lir.ast native.error))


(defenum Defined
  (DefFunc ty: LFnType)
  (DefVar ty: LType))

;; An exported definition and the module that made it.
(defstruct Exported (def: Defined module: str))

;; What every module so far defined: `exported` by name, `hidden` (private and internal definitions) name to module, for messages.
(defstruct JitNames (exported: (Map str Exported) hidden: (Map str str)))

;; No names yet. (names.rs `Names::default`)
(defun names-new () -> JitNames
  (trap "todo: native.jit.names names-new"))

;; An exported function's type, or the error for `name`: `@N is a global, not a function`, `@N is private to module M`, `no function @N is defined in this JIT`. (names.rs `function`)
(defun names-function (names: JitNames name: str) -> (Result LFnType LairError)
  (trap "todo: native.jit.names names-function"))

;; The rules of spec/lir.md section 11 for a module about to be added: no second exported definition; a declaration matches the earlier definition or names a symbol of the host process. (names.rs `check`)
(defun names-check (names: JitNames m: LModule in-process: (fn (str) bool)) -> (Result unit LairError)
  (trap "todo: native.jit.names names-check"))

;; The names after the module is added. (names.rs `record`)
(defun names-record (names: JitNames module: str m: LModule) -> JitNames
  (trap "todo: native.jit.names names-record"))
