;; compiler/native/owned.fib: an LLVM context with one module in it (crates/lair/src/llvm/mod.rs `Owned`, `take_message`). OWNER: package L1. STUB: the signatures are final (docs/design/lair-interfaces.md); every function says `todo:`.

;; There is no destructor in fibber: whoever holds an `Owned` calls `owned-dispose` once, or gives the pair to the JIT (the JIT then owns both and
;; the `Owned` is not disposed).

(ns native.owned
  (:use native.error))


(defstruct Owned (ctx: i64 module: i64))

;; A fresh context and an empty module with the given triple and data layout. (mod.rs `Owned::new`)
(defun owned-new (name: str triple: str data-layout: str) -> Owned
  (trap "todo: native.owned owned-new"))

;; The module as LLVM IR text (`LLVMPrintModuleToString`). (mod.rs `Owned::ir`)
(defun owned-ir (o: Owned) -> str
  (trap "todo: native.owned owned-ir"))

;; Disposes the module and the context. (mod.rs `Drop`)
(defun owned-dispose (o: Owned) -> unit
  (trap "todo: native.owned owned-dispose"))

;; Takes an LLVM-allocated message (an address, 0 for none) and frees it. (mod.rs `take_message`)
(defun take-message (msg: i64) -> str
  (trap "todo: native.owned take-message"))
