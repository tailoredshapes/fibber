;; compiler/syntax/print.fib: the printer, as crates/fibref/src/syntax/print.rs
;; (Display of Form): text that reads back to an equal form, prefix
;; lists in their long spelling (`'x` is `(quote x)`), integers with their
;; suffix unless i64, floats in Rust's Debug layout (shortest digits that
;; read back to the same value, positional from 1e-4 up to 1e16, else
;; scientific) with the suffix f32 for an f32 form.
;;
;; Rules decided where the Rust printer is silent:
;;  - A float that is not finite (a hand-built form; the reader never makes
;;    one) prints as `show` prints it: NaN, inf, -inf, as Rust's Debug does.
;;  - A form is printed into one (Vec str) of pieces and joined once, so
;;    printing is linear in the size of the form, not quadratic.
;;
;; Floats: `show` (types §2.12, Decided 2026-10-01) is Clojure's text, Java's
;; Double.toString: the shortest digits that read back, positional with a
;; `.0` for 1e-3 <= |x| < 1e7 and otherwise `d.dddE<exp>`. The layout here
;; is Rust's `{:?}`, so it is derived from that text: the significant
;; digits and the decimal exponent are read off either form of it and laid
;; out again by Rust's rule (exponent below -4 or at least 16: scientific),
;; and `NaN`, `Infinity`, `-Infinity` print as Rust's Debug does (`NaN`,
;; `inf`, `-inf`). The digits are `show`'s. The interpreter's are Rust's
;; (the same digits as Java's, shortest, nearest, a tie going up) and the
;; compiled `show` (crates/fibc/rt/str.lir, fib.show-fp) gives them too,
;; with one exception that is Java's own rule: when one digit would do,
;; Java writes the nearest decimal of two (4.9E-324, not 5E-324), which
;; changes the digits only of the subnormals whose spelling is one digit,
;; and Rust writes the one digit (`5e-324`, `1e-45f32`). `rust-digits`
;; takes the two digits of `show` back to Rust's one: when a decimal of
;; one digit that is next to them reads back (`strtod`, or `strtof` at f32,
;; as the reader's own number parser does), it is Rust's.
;; Case 187, crates/fibc/tests/floats.rs (both widths, tens of thousands
;; of values) and compiler/tests/reader/print-009-*.fib pin the digits.
(ns syntax.print (:use syntax.form syntax.chars util.text))

;; n zeros.
(defun zeros :private (n: i64) -> str
  (loop ((i 0) (acc (vec-empty)))
    (if (< i n) (recur (+ i 1) (conj acc "0")) (str-join acc))))

;; \u{HEX}, the spelling of a forbidden character, as Rust's `\u{{{:X}}}`.
(defun unicode-escape :private (n: i32) -> str
  (str-join ["\\u{" (hex-upper (zext i64 n) 1) "}"]))

;; One character of a string literal.
(defun str-char :private (c: char) -> str
  (let ((n (char->i32 c)))
    (match c
      (\" "\\\"")
      (\\ "\\\\")
      (\newline "\\n")
      (\tab "\\t")
      (\return "\\r")
      (_ (if (= n 0i32)
             "\\0"
             (if (is-forbidden c) (unicode-escape n) (char->str c)))))))

(defun str-lit :private (s: str) -> str
  (let ((cs (str-chars s))
        (n (count cs)))
    (loop ((i 0) (acc ["\""]))
      (if (< i n)
          (recur (+ i 1) (conj acc (str-char (nth cs i))))
          (str-join (conj acc "\""))))))

;; A character literal: `\a`, the named ones, `\u{HEX}` when forbidden.
(defun chr-lit :private (c: char) -> str
  (match c
    (\newline "\\newline")
    (\space "\\space")
    (\tab "\\tab")
    (\return "\\return")
    (_ (if (is-forbidden c)
           (unicode-escape (char->i32 c))
           (str-concat "\\" (char->str c))))))

(extern strtod :private (ptr ptr) -> f64)
(extern strtof :private (ptr ptr) -> f32)

;; A NUL-terminated copy of s, to be freed by the caller (syntax.number
;; has the same; it requires this module, so it cannot be shared).
(defun c-string :private (s: str) -> ptr
  (let ((bs (str-bytes s))
        (n (array-len bs)))
    (unsafe
      (let ((p (alloc (+ n 1))))
        (dotimes (i n) (store-i8 (ptr+ p i) (array-get bs i)))
        (store-i8 (ptr+ p n) 0i8)
        p))))

(defun read-f64 :private (s: str) -> f64
  (unsafe
    (let ((p (c-string s))
          (e (alloc 8))
          (r (strtod p e)))
      (do (free e) (free p) r))))

(defun read-f32 :private (s: str) -> f32
  (unsafe
    (let ((p (c-string s))
          (e (alloc 8))
          (r (strtof p e)))
      (do (free e) (free p) r))))

;; Whether the decimal text reads back to v at width w (an f32 form holds
;; an f32 value widened to f64).
(defun reads-back? :private (text: str v: f64 w: FltWidth) -> bool
  (match w
    ((F64) (= (read-f64 text) v))
    ((F32) (= (read-f32 text) (fptrunc f32 v)))))

;; Significant digits (no leading or trailing zero) and the decimal
;; exponent of the first.
(defstruct FltDigits (sig: str exp: i64))

;; Rust's digits for the digits sig, exponent exp, that `show` gave for v.
;; They are `show`'s unless `show` wrote two digits a.b where one would do
;; (see the header). Then Rust's are the one digit a, or a plus one, that
;; reads back; when both do, the nearer to the value, which is a when b is
;; below 5 and a plus one when it is above (the nearest decimal of two
;; digits a.b is within half a unit of the second digit of the value).
;; b = 5 with both reading back does not happen: both read back only where
;; the interval that reads back to v is wider than a unit of its first
;; digit, which is true of the two smallest f64 and the seven smallest f32
;; subnormals alone (4.9E-324, 9.9E-324; 1.4E-45, 2.8E-45, 4.2E-45,
;; 5.6E-45, 7.0E-45, 8.4E-45, 9.8E-45) and none has b = 5
;; (compiler/tests/reader/t0c-001-* and t0c-002-*). Were there one, the
;; larger would be taken, as a tie goes up.
(defun rust-digits :private (sig: str exp: i64 v: f64 w: FltWidth) -> FltDigits
  (if (!= (str-len sig) 2)
      (FltDigits sig exp)
      (let ((bs (str-bytes sig))
            (a (- (sext i64 (array-get bs 0)) 48))
            (b (- (sext i64 (array-get bs 1)) 48))
            (carry (= a 9))
            (hi (if carry (FltDigits "1" (+ exp 1)) (FltDigits (show (+ a 1)) exp)))
            (lo (FltDigits (show a) exp))
            (lo-ok (reads-back? (str-join [(show a) "e" (show exp)]) v w))
            (hi-ok (reads-back? (str-join [(. hi sig) "e" (show (. hi exp))]) v w)))
        (if (and lo-ok hi-ok)
            (if (< b 5) lo hi)
            (if lo-ok lo (if hi-ok hi (FltDigits sig exp)))))))

;; The layout of sig, the significant digits (no leading or trailing
;; zero), whose first digit has decimal exponent exp: Rust's Debug rule.
(defun layout-digits :private (sig: str exp: i64) -> str
  (let ((k (str-len sig)))
    (if (or (< exp -4) (>= exp 16))
        (str-join [(str-slice sig 0 1)
                   (if (> k 1) "." "")
                   (if (> k 1) (str-slice sig 1 k) "")
                   "e" (show exp)])
        (if (>= exp 0)
            (if (<= k (+ exp 1))
                (str-join [sig (zeros (- (+ exp 1) k)) ".0"])
                (str-join [(str-slice sig 0 (+ exp 1)) "." (str-slice sig (+ exp 1) k)]))
            (str-join ["0." (zeros (- (- 0 exp) 1)) sig])))))

;; The index of the first byte of bs that is not '0', or its length.
(defun first-nonzero :private (bs: (Array i8)) -> i64
  (let ((n (array-len bs)))
    (loop ((i 0))
      (if (and (< i n) (= (array-get bs i) 48i8)) (recur (+ i 1)) i))))

;; One past the index of the last byte of bs that is not '0', or 0.
(defun end-of-digits :private (bs: (Array i8)) -> i64
  (loop ((i (array-len bs)))
    (if (and (> i 0) (= (array-get bs (- i 1)) 48i8)) (recur (- i 1)) i)))

;; The layout of the digits a, of which the first li are before the
;; decimal point, as the text of the number v (at width w) of the given
;; sign (rust-digits reads its magnitude).
(defun layout-number :private (neg: bool a: str li: i64 v: f64 w: FltWidth) -> str
  (let ((bs (str-bytes a))
        (z (first-nonzero bs))
        (e (end-of-digits bs))
        (sign (if neg "-" "")))
    (if (>= z e)
        (str-concat sign "0.0")
        (let ((d (rust-digits (str-slice a z e) (- (- li z) 1) (if neg (- 0.0 v) v) w)))
          (str-concat sign (layout-digits (. d sig) (. d exp)))))))

;; The index of the first byte of bs equal to b, or its length.
(defun index-of :private (bs: (Array i8) b: i8) -> i64
  (let ((n (array-len bs)))
    (loop ((i 0))
      (if (and (< i n) (!= (array-get bs i) b)) (recur (+ i 1)) i))))

;; The integer that the bytes of bs from `from` on spell: digits with an
;; optional leading `-`, the exponent after the E of a `show` text.
(defun exp-value :private (bs: (Array i8) from: i64) -> i64
  (let ((n (array-len bs))
        (neg (= (array-get bs from) 45i8)))
    (loop ((i (if neg (+ from 1) from)) (acc 0))
      (if (< i n)
          (recur (+ i 1) (+ (* acc 10) (- (sext i64 (array-get bs i)) 48)))
          (if neg (- 0 acc) acc)))))

;; Rust's `{:?}` of the float v (at width w) whose `show` text is given:
;; `NaN`, `Infinity` and `-Infinity` become `NaN`, `inf` and `-inf`; a
;; finite text is an optional `-`, digits, `.`, digits and optionally `E`
;; and an exponent, from which the digits and the point's place are read.
(defun debug-layout :private (text: str v: f64 w: FltWidth) -> str
  (cond ((= text "NaN") "NaN")
        ((= text "Infinity") "inf")
        ((= text "-Infinity") "-inf")
        (true
         (let ((bs (str-bytes text))
               (n (array-len bs))
               (neg (= (array-get bs 0) 45i8))
               (from (if (= (array-get bs 0) 45i8) 1 0))
               (e (index-of bs 69i8))
               (dot (index-of bs 46i8))
               (whole (str-slice text from (if (< dot e) dot e)))
               (frac (if (< dot e) (str-slice text (+ dot 1) e) ""))
               (shift (if (< e n) (exp-value bs (+ e 1)) 0)))
           (layout-number neg (str-concat whole frac) (+ (str-len whole) shift) v w)))))

;; An f32 form holds an f32 value widened to f64: it shows as the f32.
(defun flt-lit :private (v: f64 w: FltWidth) -> str
  (match w
    ((F32) (str-concat (debug-layout (show (fptrunc f32 v)) v w) "f32"))
    ((F64) (debug-layout (show v) v w))))

(defun int-lit :private (v: i64 w: IntWidth) -> str
  (match w
    ((I64) (show v))
    (_ (str-concat (show v) (int-width-suffix w)))))

;; acc with the pieces of the items, between open and close, added.
(defun put-seq :private (acc: (Vec str) open: str items: (Vec Stx) close: str) -> (Vec str)
  (let ((n (count items)))
    (loop ((i 0) (a (conj acc open)))
      (if (< i n)
          (recur (+ i 1) (put-kind (if (> i 0) (conj a " ") a) (. (nth items i) kind)))
          (conj a close)))))

;; acc with the pieces of k added.
(defun put-kind :private (acc: (Vec str) k: StxKind) -> (Vec str)
  (match k
    ((SSym name) (conj acc name))
    ((SKw name) (conj (conj acc ":") name))
    ((SInt v w) (conj acc (int-lit v w)))
    ((SFlt v w) (conj acc (flt-lit v w)))
    ((SStr v) (conj acc (str-lit v)))
    ((SChr c) (conj acc (chr-lit c)))
    ((SBool b) (conj acc (show b)))
    ((SNil) (conj acc "nil"))
    ((SList items) (put-seq acc "(" items ")"))
    ((SVec items) (put-seq acc "[" items "]"))
    ((SMap items) (put-seq acc "{" items "}"))))

;; The text of a form's kind.
(defun kind-show (k: StxKind) -> str
  (str-join (put-kind (vec-empty) k)))

;; The text of a form.
(defun stx-show (s: Stx) -> str
  (kind-show (. s kind)))
