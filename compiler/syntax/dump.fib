;; compiler/syntax/dump.fib: the reader dump of spec/bootstrap.md §2, as
;; crates/fibref/src/dump.rs: the same text, line for line. Lines are
;; returned without their newline.
(ns syntax.dump
  (:require [syntax.reader :as reader] [syntax.print :as printer])
  (:use syntax.pos syntax.form syntax.error util.result util.text))

;; "line:col start..end"
(defun span (p: Pos) -> str
  (str-join [(show (. p line)) ":" (show (. p col)) " " (show (. p start)) ".." (show (. p end))]))

;; One character of a quoted text: `"`, `\` and the control characters
;; escaped, every other character as it is.
(defun quote-char :private (c: char) -> str
  (let ((n (char->i32 c)))
    (match c
      (\" "\\\"")
      (\\ "\\\\")
      (\newline "\\n")
      (\tab "\\t")
      (\return "\\r")
      (_ (if (or (< n 32i32) (= n 127i32))
             (str-concat "\\x" (hex-upper (zext i64 n) 2))
             (char->str c))))))

(defun quote-text (s: str) -> str
  (let ((cs (str-chars s))
        (n (count cs)))
    (loop ((i 0) (acc ["\""]))
      (if (< i n)
          (recur (+ i 1) (conj acc (quote-char (nth cs i))))
          (str-join (conj acc "\""))))))

(defun indent-of :private (depth: i64) -> str
  (loop ((i 0) (acc (vec-empty)))
    (if (< i depth) (recur (+ i 1) (conj acc "  ")) (str-join acc))))

;; The indent of the children of a node at indent ind: one more level,
;; built once per sequence and shared by its items.
(defun deeper :private (ind: str) -> str
  (str-concat ind "  "))

;; A float's text as `show` prints it at its width: an f32 form holds an
;; f32 value widened to f64, which shows as the f32 it is.
(defun flt-text :private (v: f64 w: FltWidth) -> str
  (match w
    ((F32) (show (fptrunc f32 v)))
    ((F64) (show v))))

;; The lines of s and what it holds, at depth, after acc.
(defun dump-stx (acc: (Vec str) s: Stx depth: i64) -> (Vec str)
  (dump-at acc s (indent-of depth)))

;; dump-stx for a node whose indent is ind already.
(defun dump-at :private (acc: (Vec str) s: Stx ind: str) -> (Vec str)
  (let ((at (span (. s pos))))
    (match (. s kind)
      ((SSym name) (conj acc (str-join [ind "sym " (quote-text name) " " at])))
      ((SKw name) (conj acc (str-join [ind "kw " (quote-text name) " " at])))
      ((SInt v w) (conj acc (str-join [ind "int " (show v) " " (int-width-suffix w) " " at])))
      ((SFlt v w)
       (conj acc (str-join [ind "flt " (flt-text v w) " " (flt-width-suffix w) " " at])))
      ((SStr v) (conj acc (str-join [ind "str " (quote-text v) " " at])))
      ((SChr c)
       (conj acc (str-join [ind "chr U+" (hex-upper (zext i64 (char->i32 c)) 4) " " at])))
      ((SBool b) (conj acc (str-join [ind "bool " (show b) " " at])))
      ((SNil) (conj acc (str-join [ind "nil " at])))
      ((SList items) (dump-seq acc "list" items ind at))
      ((SVec items) (dump-seq acc "vec" items ind at))
      ((SMap items) (dump-seq acc "map" items ind at)))))

(defun dump-seq :private (acc: (Vec str) tag: str items: (Vec Stx) ind: str at: str) -> (Vec str)
  (let ((n (count items))
        (inner (deeper ind)))
    (loop ((i 0) (a (conj acc (str-join [ind tag " " (show n) " " at]))))
      (if (< i n)
          (recur (+ i 1) (dump-at a (nth items i) inner))
          a))))

(defun dump-forms (forms: (Vec Stx)) -> (Vec str)
  (let ((n (count forms)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n)
          (recur (+ i 1) (dump-stx acc (nth forms i) 0))
          acc))))

;; The one line of a read error: `error Kind L:C S..E: message`.
(defun dump-error (e: ReadError) -> (Vec str)
  [(str-join ["error " (err-name (. e kind)) " " (span (. e pos)) ": " (err-message (. e kind))])])

;; The dump of reading source as file: the lines of its forms, or the one
;; line of its error.
(defun dump-source (source: str file: str) -> (Vec str)
  (match (reader/read-all source file)
    ((Ok forms) (dump-forms forms))
    ((Err e) (dump-error e))))

;; The printed text of reading source as file: one line per top-level
;; form, its text as syntax.print writes it, or the one line of the read
;; error (dump.rs's print_source, for `read --print`).
(defun print-source (source: str file: str) -> (Vec str)
  (match (reader/read-all source file)
    ((Ok forms) (print-forms forms))
    ((Err e) (dump-error e))))

(defun print-forms :private (forms: (Vec Stx)) -> (Vec str)
  (let ((n (count forms)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n)
          (recur (+ i 1) (conj acc (printer/stx-show (nth forms i))))
          acc))))

;; ---------------------------------------------- the expansion dump's lines
;; (dump.rs `span_in`, `dump_form` with a home, `dump_forms_in`; spec/
;; bootstrap.md §5.1). The same lines as the reader dump above, except that
;; a position in another file than home, the file of the module being
;; dumped, ends `@FILE`: a form that a macro or a definition of another
;; file brings, and the built-in `<builtin>` and `<prelude>`. These
;; functions are additive: the reader's dump does not change.

;; "line:col start..end", and "@FILE" after it when p is not in home.
(defun span-in (p: Pos home: str) -> str
  (if (= (. p file) home)
      (span p)
      (str-join [(span p) "@" (. p file)])))

;; The lines of s and what it holds, at depth, after acc: dump-stx with
;; the positions as span-in prints them.
(defun dump-stx-in (acc: (Vec str) s: Stx depth: i64 home: str) -> (Vec str)
  (dump-in acc s (indent-of depth) home))

;; dump-stx-in for a node whose indent is ind already.
(defun dump-in :private (acc: (Vec str) s: Stx ind: str home: str) -> (Vec str)
  (let ((at (span-in (. s pos) home)))
    (match (. s kind)
      ((SSym name) (conj acc (str-join [ind "sym " (quote-text name) " " at])))
      ((SKw name) (conj acc (str-join [ind "kw " (quote-text name) " " at])))
      ((SInt v w) (conj acc (str-join [ind "int " (show v) " " (int-width-suffix w) " " at])))
      ((SFlt v w)
       (conj acc (str-join [ind "flt " (flt-text v w) " " (flt-width-suffix w) " " at])))
      ((SStr v) (conj acc (str-join [ind "str " (quote-text v) " " at])))
      ((SChr c)
       (conj acc (str-join [ind "chr U+" (hex-upper (zext i64 (char->i32 c)) 4) " " at])))
      ((SBool b) (conj acc (str-join [ind "bool " (show b) " " at])))
      ((SNil) (conj acc (str-join [ind "nil " at])))
      ((SList items) (dump-seq-in acc "list" items ind at home))
      ((SVec items) (dump-seq-in acc "vec" items ind at home))
      ((SMap items) (dump-seq-in acc "map" items ind at home)))))

(defun dump-seq-in :private (acc: (Vec str) tag: str items: (Vec Stx) ind: str at: str home: str) -> (Vec str)
  (let ((n (count items))
        (inner (deeper ind)))
    (loop ((i 0) (a (conj acc (str-join [ind tag " " (show n) " " at]))))
      (if (< i n)
          (recur (+ i 1) (dump-in a (nth items i) inner home))
          a))))

;; The lines of a sequence of top-level forms of the file home, after acc
;; (the forms a module's expansion made: `dump_forms_in` with the lines
;; appended to acc instead of returned as text).
(defun dump-forms-in (acc: (Vec str) forms: (Vec Stx) home: str) -> (Vec str)
  (let ((n (count forms)))
    (loop ((i 0) (a acc))
      (if (< i n)
          (recur (+ i 1) (dump-stx-in a (nth forms i) 0 home))
          a))))
