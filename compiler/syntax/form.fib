;; compiler/syntax/form.fib: what the reader produces, as
;; crates/fibref/src/syntax/form.rs. A Stx is one StxKind plus the
;; position it was read from (syntax §1.3). This is the compiler's own
;; tree; the built-in `Form` (syntax §3.16) is what macros receive, and
;; the expander converts between the two at the macro boundary.
;;
;; Equality (stx-eq) compares the data only, never the positions, and
;; floats by their shown text (shortest round trip), so that 0.0 and -0.0
;; differ, as Rust's compares by bit pattern.
(ns syntax.form (:use syntax.pos))

(defenum IntWidth I8 I16 I32 I64)
(defenum FltWidth F32 F64)

(defenum StxKind
  (SSym name: str)
  (SKw name: str)
  (SInt v: i64 width: IntWidth)
  (SFlt v: f64 width: FltWidth)
  (SStr v: str)
  (SChr v: char)
  (SBool v: bool)
  (SNil)
  (SList items: (Vec Stx))
  (SVec items: (Vec Stx))
  (SMap items: (Vec Stx)))

(defstruct Stx (kind: StxKind pos: Pos))

(defun int-width-suffix (w: IntWidth) -> str
  (match w
    ((I8) "i8")
    ((I16) "i16")
    ((I32) "i32")
    ((I64) "i64")))

(defun flt-width-suffix (w: FltWidth) -> str
  (match w
    ((F32) "f32")
    ((F64) "f64")))

;; The smallest and largest value of the width, as the text of the range
;; in an out-of-range message: "-128 to 127".
(defun int-width-range-text (w: IntWidth) -> str
  (match w
    ((I8) "-128 to 127")
    ((I16) "-32768 to 32767")
    ((I32) "-2147483648 to 2147483647")
    ((I64) "-9223372036854775808 to 9223372036854775807")))
