;; compiler/syntax/lexer.fib: tokens (syntax §1.1, §1.2), as
;; crates/fibref/src/syntax/lexer.rs: delimiters, the prefix reader
;; macros, the form comment `#_`, and atoms, which are complete forms
;; already. Whitespace, commas and `;` comments are skipped here. `syntax.reader` builds forms from these tokens.
;;
;; Every decision, and the order the decisions are taken in, is the Rust
;; lexer's: a token's error is found before the reader sees the token, a
;; comma is whitespace, a tight prefix (`~` `~@` `@` `&`) must touch its
;; form while `'` and `` ` `` need not, a lone `&` is the symbol `&`,
;; `#(` and `#{` are tokens of their own, and `7/2` is one atom, the list
;; `(/ 7 2)` with a position for each of its three forms.
;;
;; Where this port differs in shape only: the end of the input is a
;; token (`TEof`) rather than `None`, so next-token has one result type
;; less to wrap.
(ns syntax.lexer
  (:require [syntax.number :as number] [syntax.literal :as literal])
  (:use syntax.pos syntax.form syntax.error syntax.cursor syntax.chars))

;; The three bracket pairs.
(defenum Delim DParen DBracket DBrace)

;; The six prefix reader macros of §1.2.
(defenum Prefix PQuote PQuasiquote PUnquote PUnquoteSplicing PDeref PInOut)

(defun delim-open (d: Delim) -> char
  (match d
    ((DParen) \()
    ((DBracket) \[)
    ((DBrace) \{)))

(defun delim-close (d: Delim) -> char
  (match d
    ((DParen) \))
    ((DBracket) \])
    ((DBrace) \})))

(defun same-delim (a: Delim b: Delim) -> bool
  (= (char->i32 (delim-close a)) (char->i32 (delim-close b))))

;; The head symbol of the list the prefix reads as.
(defun prefix-head (p: Prefix) -> str
  (match p
    ((PQuote) "quote")
    ((PQuasiquote) "quasiquote")
    ((PUnquote) "unquote")
    ((PUnquoteSplicing) "unquote-splicing")
    ((PDeref) "deref")
    ((PInOut) "&")))

;; The prefix as written.
(defun prefix-text (p: Prefix) -> str
  (match p
    ((PQuote) "'")
    ((PQuasiquote) "`")
    ((PUnquote) "~")
    ((PUnquoteSplicing) "~@")
    ((PDeref) "@")
    ((PInOut) "&")))

(defun in-out? (p: Prefix) -> bool
  (match p
    ((PInOut) true)
    (_ false)))

(defenum TokenKind
  (TOpen d: Delim)
  (TClose d: Delim)
  (TPrefix p: Prefix)
  (TDiscard)
  (TOpenFn)
  (TOpenSet)
  (TOpenSimd)
  (TCloseSimd suffix: (Option str))
  (TAtom k: StxKind)
  (TEof))

;; A token and the text it spans (at the end of the input, the empty
;; span there).
(defstruct Token (kind: TokenKind pos: Pos))

;; The cursor.
(defstruct Lexer (cur: Cursor))

(defun lexer-new (src: str file: str) -> Lexer
  (Lexer (cursor-new src file)))

;; The next token; TEof at the end of the input. simd is true when the token is read directly inside a vector literal
;; `<<..>>` (not inside a list nested in it): there a `>>` ends a number, symbol or keyword and is itself the closing token.
(defun next-token (lx: Lexer simd: bool) -> (Result Token ReadError)
  (do (skip-trivia lx)
      (let ((cur (. lx cur))
            (mark (cursor-mark cur)))
        (match (cursor-peek cur)
          (nil (Ok (Token TEof (cursor-pos-from cur mark))))
          ((some c)
           (match (lex-token lx c mark simd)
             ((Err e) (Err e))
             ((Ok kind) (Ok (Token kind (cursor-pos-from cur mark))))))))))

(defun not-newline :private (c: char) -> bool (not (= (char->i32 c) 10i32)))

;; Skips whitespace, commas and `;` comments.
(defun skip-trivia :private (lx: Lexer) -> unit
  (let ((cur (. lx cur)))
    (loop ()
      (match (cursor-peek cur)
        (nil ())
        ((some c)
         (cond (is-separator c) (do (cursor-bump cur) (recur))
               (= (char->i32 c) 59i32) (do (cursor-bump-while cur not-newline) (recur))
               :else ()))))))

;; Whether the next character starts a form (§1.2).
(defun starts-form :private (lx: Lexer) -> bool
  (starts-form-char (cursor-peek (. lx cur))))

;; The error of kind from mark to the cursor.
(defun err-at :private (cur: Cursor mark: Mark kind: ErrKind) -> ReadError
  (ReadError kind (cursor-pos-from cur mark)))

;; Consumes the one character of a delimiter or a `'` / `` ` `` prefix.
(defun single :private (cur: Cursor kind: TokenKind) -> (Result TokenKind ReadError)
  (do (cursor-bump cur) (Ok kind)))

(defun atom-kind :private (r: (Result StxKind ReadError)) -> (Result TokenKind ReadError)
  (match r
    ((Err e) (Err e))
    ((Ok k) (Ok (TAtom k)))))

(defun lex-token :private (lx: Lexer c: char mark: Mark simd: bool) -> (Result TokenKind ReadError)
  (let ((cur (. lx cur)))
    (match c
      (\( (single cur (TOpen DParen)))
      (\[ (single cur (TOpen DBracket)))
      (\{ (single cur (TOpen DBrace)))
      (\) (single cur (TClose DParen)))
      (\] (single cur (TClose DBracket)))
      (\} (single cur (TClose DBrace)))
      (\' (single cur (TPrefix PQuote)))
      (\` (single cur (TPrefix PQuasiquote)))
      (\" (atom-kind (literal/lex-string cur)))
      (\\ (atom-kind (literal/lex-char cur)))
      (\~ (lex-tight-prefix lx c mark))
      (\@ (lex-tight-prefix lx c mark))
      (\& (lex-tight-prefix lx c mark))
      (\# (lex-dispatch cur mark))
      (\: (lex-keyword cur mark simd))
      (\< (if (opens-simd? cur) (do (cursor-bump cur) (cursor-bump cur) (Ok TOpenSimd)) (lex-word cur c mark simd)))
      (\> (if (and simd (= (cursor-peek-nth cur 1) (some \>))) (lex-simd-close cur mark) (lex-word cur c mark simd)))
      (_ (lex-word cur c mark simd)))))

;; `~` `~@` `@` `&`: each must be followed immediately by a form. A `&`
;; that is not is the reserved symbol `&` itself (§1.1), which is what
;; `(& x)` needs to read back.
(defun lex-tight-prefix :private (lx: Lexer c: char mark: Mark) -> (Result TokenKind ReadError)
  (let ((cur (. lx cur)))
    (do (cursor-bump cur)
        (match c
          (\~ (if (= (cursor-peek cur) (some \@))
                  (do (cursor-bump cur) (tight-prefix lx mark PUnquoteSplicing))
                  (tight-prefix lx mark PUnquote)))
          (\@ (tight-prefix lx mark PDeref))
          (_ (if (starts-form lx)
                 (Ok (TPrefix PInOut))
                 (Ok (TAtom (SSym "&")))))))))

;; The prefix just consumed, which must be followed immediately by a form.
(defun tight-prefix :private (lx: Lexer mark: Mark p: Prefix) -> (Result TokenKind ReadError)
  (if (starts-form lx)
      (Ok (TPrefix p))
      (Err (err-at (. lx cur) mark (PrefixWithoutForm (prefix-text p))))))

(defun lex-dispatch :private (cur: Cursor mark: Mark) -> (Result TokenKind ReadError)
  (do (cursor-bump cur)
      (match (cursor-peek cur)
        ((some \_) (do (cursor-bump cur) (Ok TDiscard)))
        ((some \() (do (cursor-bump cur) (Ok TOpenFn)))
        ((some \{) (do (cursor-bump cur) (Ok TOpenSet)))
        ((some \") (atom-kind (literal/lex-regex cur mark)))
        (other (do (cursor-bump cur) (Err (err-at cur mark (UnknownDispatch other))))))))

(defun lex-keyword :private (cur: Cursor mark: Mark simd: bool) -> (Result TokenKind ReadError)
  (do (cursor-bump cur)
      (bump-token cur simd)
      (let ((text (cursor-text-from cur mark))
            (name (str-slice text 1 (str-len text))))
        (if (or (= (str-len name) 0) (starts-with? name ":") (not (valid-slashes name)))
            (Err (err-at cur mark (InvalidKeyword text)))
            (Ok (TAtom (SKw name)))))))

;; §1.1: a number starts with a digit, or with `-` followed by a digit.
(defun is-digit :private (c: char) -> bool
  (let ((n (char->i32 c)))
    (and (>= n 48i32) (<= n 57i32))))

(defun starts-number :private (c: char next: (Option char)) -> bool
  (or (is-digit c)
      (and (= (char->i32 c) 45i32)
           (match next
             (nil false)
             ((some n) (is-digit n))))))

;; A number, a forbidden character or a symbol: what is left when c starts
;; no delimiter, prefix, string, character, dispatch or keyword.
(defun lex-word :private (cur: Cursor c: char mark: Mark simd: bool) -> (Result TokenKind ReadError)
  (cond (starts-number c (cursor-peek-nth cur 1)) (lex-number cur mark simd)
        (is-forbidden c) (do (cursor-bump cur) (Err (err-at cur mark (InvalidCharacter c))))
        :else (lex-symbol cur mark simd)))

;; The byte offset of the `/` of text when it is `-?D/D` with D a
;; non-empty run of decimal digits (a ratio, §1.1), else -1.
(defun ratio-slash :private (text: str) -> i64
  (let ((bs (str-bytes text))
        (n (array-len bs))
        (from (if (and (> n 0) (= (array-get bs 0) 45i8)) 1 0)))
    (loop ((i from))
      (cond (>= i n) -1
            (digit-byte? (array-get bs i)) (recur (+ i 1))
            (and (= (array-get bs i) 47i8) (> i from) (< (+ i 1) n)
                 (all-digits? bs (+ i 1) n)) i
            :else -1))))

(defun digit-byte? :private (b: i8) -> bool
  (and (>= b 48i8) (<= b 57i8)))

(defun all-digits? :private (bs: (Array i8) from: i64 to: i64) -> bool
  (loop ((i from))
    (cond (>= i to) true
          (digit-byte? (array-get bs i)) (recur (+ i 1))
          :else false)))

;; The position of the bytes from..to of the token at pos (all ASCII, so
;; bytes are columns).
(defun part-pos :private (pos: Pos from: i64 to: i64) -> Pos
  (Pos (. pos file) (. pos line) (+ (. pos col) from) (+ (. pos start) from) (+ (. pos start) to)))

(defun ratio-part :private (text: str pos: Pos from: i64 to: i64) -> (Result Stx ErrKind)
  (match (number/parse-number (str-slice text from to))
    ((Err kind) (Err kind))
    ((Ok k) (Ok (Stx k (part-pos pos from to))))))

;; `7/2` as `(/ 7 2)`; slash is the offset of the `/`.
(defun lex-ratio :private (cur: Cursor mark: Mark text: str slash: i64) -> (Result TokenKind ReadError)
  (let ((pos (cursor-pos-from cur mark)))
    (match (ratio-part text pos 0 slash)
      ((Err kind) (Err (err-at cur mark kind)))
      ((Ok num)
       (match (ratio-part text pos (+ slash 1) (str-len text))
         ((Err kind) (Err (err-at cur mark kind)))
         ((Ok den)
          (Ok (TAtom (SList [(Stx (SSym "/") (part-pos pos slash (+ slash 1))) num den])))))))))

(defun lex-number :private (cur: Cursor mark: Mark simd: bool) -> (Result TokenKind ReadError)
  (do (bump-token cur simd)
      (let ((text (cursor-text-from cur mark))
            (slash (ratio-slash text)))
        (if (>= slash 0)
            (lex-ratio cur mark text slash)
            (match (number/parse-number text)
              ((Ok k) (Ok (TAtom k)))
              ((Err kind) (Err (err-at cur mark kind))))))))

(defun lex-symbol :private (cur: Cursor mark: Mark simd: bool) -> (Result TokenKind ReadError)
  (do (bump-token cur simd)
      (let ((text (cursor-text-from cur mark)))
        (cond (= text "true") (Ok (TAtom (SBool true)))
              (= text "false") (Ok (TAtom (SBool false)))
              (= text "nil") (Ok (TAtom SNil))
              (valid-slashes text) (Ok (TAtom (SSym text)))
              :else (Err (err-at cur mark (InvalidSymbol text)))))))

;; ---- vector literals `<<..>>` (docs/design/simd-and-tensors.md 2.3) ----

;; Consumes the constituents of a number, symbol or keyword; directly inside a vector literal (simd) it stops before a `>>`.
(defun bump-token :private (cur: Cursor simd: bool) -> unit
  (loop ()
    (match (cursor-peek cur)
      (nil ())
      ((some ch)
       (if (and (is-constituent ch) (not (and simd (at-simd-close? cur))))
           (do (cursor-bump cur) (recur))
           ())))))

;; Whether the cursor is on `>>`.
(defun at-simd-close? :private (cur: Cursor) -> bool
  (and (= (cursor-peek cur) (some \>)) (= (cursor-peek-nth cur 1) (some \>))))

;; Whether the cursor, on `<`, starts a vector literal: `<<` and then a character that starts a form (so a bare `<<`, `<<` before a
;; space or a closing delimiter, stays a symbol) other than `<` or `=` (so `<<<` and `<<=` stay symbols), and other than a single `>`
;; (`<<>` stays a symbol; `<<>>` is the empty literal, an error).
(defun opens-simd? :private (cur: Cursor) -> bool
  (and (= (cursor-peek-nth cur 1) (some \<))
       (starts-form-char (cursor-peek-nth cur 2))
       (not (= (cursor-peek-nth cur 2) (some \<)))
       (not (= (cursor-peek-nth cur 2) (some \=)))
       (or (not (= (cursor-peek-nth cur 2) (some \>))) (= (cursor-peek-nth cur 3) (some \>)))))

(defun simd-suffix? :private (s: str) -> bool
  (or (= s "i8") (= s "i16") (= s "i32") (= s "i64") (= s "f32") (= s "f64")))

;; Whether c is a lower-case ASCII letter.
(defun lower-letter? :private (c: char) -> bool
  (let ((n (char->i32 c)))
    (and (>= n 97i32) (<= n 122i32))))

;; The closing `>>` of a vector literal, and the element type suffix that touches it (a run of constituents that starts with a
;; letter, up to the next `>>`): i8 i16 i32 i64 f32 f64, else BadSimdSuffix at the suffix.
(defun lex-simd-close :private (cur: Cursor mark: Mark) -> (Result TokenKind ReadError)
  (do (cursor-bump cur)
      (cursor-bump cur)
      (let ((at (cursor-mark cur)))
        (if (match (cursor-peek cur) (nil false) ((some ch) (lower-letter? ch)))
            (do (bump-token cur true)
                (let ((text (cursor-text-from cur at)))
                  (if (simd-suffix? text)
                      (Ok (TCloseSimd (some text)))
                      (Err (err-at cur at (BadSimdSuffix text))))))
            (Ok (TCloseSimd nil))))))
