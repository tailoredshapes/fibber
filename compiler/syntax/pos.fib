;; compiler/syntax/pos.fib: source positions, as crates/fibref/src/syntax/pos.rs
;; (syntax §1.3). `line` and `col` are 1-based and locate the first
;; character; `col` counts Unicode scalar values from the start of the
;; line; `start..end` is the half-open byte range in the source text as
;; passed in (a leading byte order mark counts in the offsets, not in the
;; column).
(ns syntax.pos)

(defstruct Pos (file: str line: i64 col: i64 start: i64 end: i64))

;; A position covering p through the end of last.
(defun pos-through (p: Pos last: Pos) -> Pos
  (Pos (. p file) (. p line) (. p col) (. p start) (. last end)))
