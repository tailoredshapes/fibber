;; compiler/expand.fib: the expansion tool, as `fibref expand`
;; (crates/fibref/src/main.rs `expand_files`, expand_dump/mod.rs
;; `expand_files`): prints the expansion dump of each file named on the
;; command line, each under a `== FILE` header (spec/bootstrap.md §5.1).
;; The words before the files are the options of `expand.args`
;; (`--prelude`, `--context`, `--implicit`, `--implicit-lib LIST`,
;; `--no-runner`, `--max-steps N`, `--max-depth N`, `--max-forms N`; a lone
;; `--` ends them). With no file,
;; an option that is not one, or a limit that is not decimal digits it
;; prints a usage line to stderr, nothing to stdout, and exits 2.
;;
;; Exit status: 0 if every file expanded, 1 if one ended in an error
;; record (it did not read, load or expand), 2 if one could not be read at
;; all (its dump is the line `unreadable`) or the words were refused; the
;; larger wins. Stage 2's expander is correct when this prints what
;; `fibref expand` prints, byte for byte (crates/fibc/tests/bootstrap_expand.rs).
;;
;; Without `--no-runner` a user macro is run by macros.runner (the stage-2b runner: the macro's module is JITted through lair, so the tool
;; is built with `-L target/debug -l lair`), as `fibref expand` runs it with the interpreter's evaluator.
;;
;; The Rust tool builds the whole text and prints it at the end; this one
;; prints each file's section as soon as it is made, which gives the same
;; bytes and holds one file's lines in memory at a time.
(ns main (:require [expand.args :as cli] [expand.dump :as dump] [macros.runner :as mr]))

(def usage: str
  "usage: expand [--prelude] [--context] [--implicit] [--implicit-lib LIST] [--batch] [--no-runner] [--max-steps N] [--max-depth N] [--max-forms N] [--] FILE..")

(defun max-status (a: i64 b: i64) -> i64 (if (> a b) a b))

;; Prints the lines of a dump, each ended by a newline (the Rust tool
;; prints their join, and println ends the last line).
(defun print-lines (lines: (Vec str))
  (loop ((i 0))
    (if (< i (count lines))
        (do (println (nth lines i)) (recur (+ i 1)))
        ())))

;; Prints the output of each of files in order, and returns the largest
;; status.
(defun expand-files (files: (Vec str) opts: cli/Options) -> i64
  (loop ((i 0) (status 0))
    (if (< i (count files))
        (let ((d (dump/expand-file-with (nth files i) opts (mr/runner-maker))))
          (do (print-lines (. d lines))
              (recur (+ i 1) (max-status status (. d status)))))
        status)))

(def batch-trailer: str "#### status ")

;; `--batch`: one process for many files, the library state built once (expand.dump `Batch`). The output is each file's
;; section as without it, followed by the line `#### status N` (the status that file adds), so a caller can split it.
(defun expand-batch (files: (Vec str) opts: cli/Options) -> i64
  (let ((b (dump/batch-new)))
    (loop ((i 0) (status 0))
      (if (< i (count files))
          (let ((d (dump/expand-file-batch (nth files i) opts (mr/runner-maker) b)))
            (do (print-lines (. d lines))
                (println (str-concat batch-trailer (show (. d status))))
                (recur (+ i 1) (max-status status (. d status)))))
          status))))

;; The words without `--batch` (before a lone `--`), and whether it was there.
(defun without-batch (words: (Vec str)) -> (Pair bool (Vec str))
  (loop ((i 0) (found false) (out (vec-empty)) (open true))
    (if (< i (count words))
        (let ((w (nth words i)))
          (if (and open (= w "--batch"))
              (recur (+ i 1) true out open)
              (recur (+ i 1) found (conj out w) (and open (!= w "--")))))
        (Pair found out))))

(defun main () -> i64
  (let ((p (without-batch (args))))
    (match (cli/parse-args (. p snd))
      (nil (do (eprintln usage) 2))
      ((some parsed) (if (. p fst)
                         (expand-batch (. parsed files) (. parsed opts))
                         (expand-files (. parsed files) (. parsed opts)))))))
