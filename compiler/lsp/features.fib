;; compiler/lsp/features.fib: the requests the server answers (docs/design/fibref-port.md section 6). OWNER: packages L3 (complete, hover) and L4
;; (definition, document symbols). Rust: editor/complete.rs (189), diagnostics.rs. Each is a pure function of a buffer, a position and the roots.
;; `line` is 1-based and `col` 0-based in UTF-16 units as in the Rust `fibref complete`; the server converts.
(ns lsp.features
  (:use expand.roots lsp.types))

(defun complete (src: str path: str line: i64 col: i64 roots: Roots) -> (Vec LsItem) (trap "todo: lsp.features complete"))
(defun hover (src: str path: str line: i64 col: i64 roots: Roots) -> (Option str) (trap "todo: lsp.features hover"))
(defun diagnostics (src: str path: str roots: Roots) -> (Vec LsDiag) (trap "todo: lsp.features diagnostics"))
;; New. The definition of the name under the cursor: a local, a top-level definition of the buffer, or one of a module found through the roots.
(defun definition (src: str path: str line: i64 col: i64 roots: Roots) -> (Option LsLocation) (trap "todo: lsp.features definition"))
(defun document-symbols (src: str path: str) -> (Vec LsItem) (trap "todo: lsp.features document-symbols"))
