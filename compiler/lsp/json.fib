;; compiler/lsp/json.fib: JSON values, reader and writer (docs/design/fibref-port.md section 6). OWNER: package L0. Rust: crates/fibref/src/json.rs (362
;; lines). The library has no JSON module (only lib/fib/lacinia/json.fib, a writer of GraphQL values). Object keys keep their order (the writer's output
;; is what the recorded transcripts compare). Numbers are i64 or f64; \u escapes and surrogate pairs decode to UTF-8.
(ns lsp.json)

(defenum JVal
  JNull
  (JBool b: bool)
  (JInt n: i64)
  (JFloat x: f64)
  (JStr s: str)
  (JArr items: (Vec JVal))
  (JObj keys: (Vec str) vals: (Vec JVal)))

(defun json-parse (text: str) -> (Result JVal str) (trap "todo: lsp.json json-parse"))
(defun json-text (v: JVal) -> str (trap "todo: lsp.json json-text"))
(defun json-get (v: JVal key: str) -> (Option JVal) (trap "todo: lsp.json json-get"))
(defun json-path (v: JVal keys: (Vec str)) -> (Option JVal) (trap "todo: lsp.json json-path"))
(defun json-obj (pairs: (Vec (Pair str JVal))) -> JVal (trap "todo: lsp.json json-obj"))
