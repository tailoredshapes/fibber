;; compiler/lsp/analysis.fib: the front end on an editor buffer (docs/design/fibref-port.md section 6). OWNER: package L1. Rust: editor/analysis.rs (360).
;; Reads, expands, types and ownership-checks the buffer as the main module with the library through `roots` (driver.front's `front-check`, with
;; `--no-runner` unless the macro runner is allowed: a server must not JIT on every keystroke). When the buffer does not check, a program is still built
;; from the library, the `ns` form and the top-level forms other than the one under the cursor (the ladder of `analyse_at`), so names and types still
;; complete. The checked program is kept as `typed`.
(ns lsp.analysis
  (:use expand.roots types.program lsp.types))

(defstruct LsAnalysis (typed: (Option TypedProgram) own: bool diags: (Vec LsDiag)))

(defun analyse (source: str path: str roots: Roots cursor: (Option i64)) -> LsAnalysis (trap "todo: lsp.analysis analyse"))
