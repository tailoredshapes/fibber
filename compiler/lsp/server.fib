;; compiler/lsp/server.fib: the JSON-RPC server over stdio (docs/design/fibref-port.md section 6). OWNER: package L5. Rust: editor/{lsp,transport,cli}.rs
;; (359 + 95 + 94). Content-Length framing both ways; full-text sync; initialize / shutdown / exit; completion, hover; publishDiagnostics on open,
;; change, save and close; `-32601` for any other request; a handler that traps answers its request with `-32603` and the server goes on (a fibber
;; trap aborts, so each handler runs in a child process or the front end is made total: decision D5). Exit status 0 after `shutdown`, 1 without it.
(ns lsp.server
  (:use expand.roots lsp.json))

(defstruct LsServer (docs: (Cell (Map str str)) roots: Roots shutdown: (Cell bool)))

(defun server-new (roots: Roots) -> LsServer (trap "todo: lsp.server server-new"))
;; One message in, the messages to send out and an exit code once the client said `exit`.
(defstruct LsReply (out: (Vec JVal) exit: (Option i64)))
(defun server-handle (s: LsServer msg: JVal) -> LsReply (trap "todo: lsp.server server-handle"))
(defun read-message (fd: i64) -> (Result (Option str) str) (trap "todo: lsp.server read-message"))
(defun write-message (fd: i64 body: str) -> (Result unit str) (trap "todo: lsp.server write-message"))
;; `fibref lsp` / `fibc lsp`: serves standard input and output; the exit status.
(defun lsp-main (roots: Roots) -> i64 (trap "todo: lsp.server lsp-main"))
