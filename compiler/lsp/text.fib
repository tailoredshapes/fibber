;; compiler/lsp/text.fib: positions in a buffer (docs/design/fibref-port.md section 6). OWNER: package L0. Rust: editor/text.rs (59), diagnostics.rs `range`.
;; Everything inside works in byte offsets; LSP counts lines from 0 and characters in UTF-16 code units. An empty diagnostic range is widened to the
;; character at it (or before it at the end of the text) so the editor has something to underline.
(ns lsp.text
  (:use lsp.types))

(defstruct LsPos (line: i64 character: i64))
(defstruct LsRange (start: LsPos end: LsPos))

(defun offset->pos (src: str off: i64) -> LsPos (trap "todo: lsp.text offset->pos"))
(defun pos->offset (src: str p: LsPos) -> i64 (trap "todo: lsp.text pos->offset"))
(defun diag-range (src: str d: LsDiag) -> LsRange (trap "todo: lsp.text diag-range"))
(defun path-of-uri (uri: str) -> str (trap "todo: lsp.text path-of-uri"))     ;; percent escapes decoded; a non-file URI stands for itself
