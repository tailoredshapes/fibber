;; compiler/lsp/catalog.fib: completion candidates from a checked program (docs/design/fibref-port.md section 6). OWNER: package L3.
;; Rust: editor/catalog.rs (241). What each module exports, with the type checker's scheme as the detail, read from the `TypedProgram` tables
;; (types.program, types.display), not from a second front end.
(ns lsp.catalog
  (:use types.program lsp.types))

(defun catalog-names (t: TypedProgram) -> (Vec LsItem) (trap "todo: lsp.catalog catalog-names"))
(defun catalog-types (t: TypedProgram) -> (Vec LsItem) (trap "todo: lsp.catalog catalog-types"))
(defun catalog-exports (t: TypedProgram alias: str) -> (Vec LsItem) (trap "todo: lsp.catalog catalog-exports"))
(defun catalog-fields (t: TypedProgram type-name: str) -> (Vec LsItem) (trap "todo: lsp.catalog catalog-fields"))
(defun catalog-value (t: TypedProgram module: str name: str) -> (Option LsItem) (trap "todo: lsp.catalog catalog-value"))
