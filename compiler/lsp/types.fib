;; compiler/lsp/types.fib: the records the language-server packages share (docs/design/fibref-port.md section 6). OWNER: package L0 (contract).
;; Positions inside the server are byte offsets of the buffer; LSP's (line from 0, character in UTF-16 units) is converted at the edge (lsp.text).
(ns lsp.types)

(def lsp-protocol-version: str "3.17")

;; One problem in a buffer, as a byte range. Rust: editor/analysis.rs Diag
(defstruct LsDiag (start: i64 end: i64 message: str))

;; A completion candidate. `kind` is the protocol's word ("function" "method" "field" "variable" "protocol" "module" "enum" "macro" "variant"
;; "struct" "type"), mapped to the LSP number by lsp.server. Rust: editor/catalog.rs Item
(defstruct LsItem (label: str kind: str detail: str doc: str))

;; Where a definition is: a file (a path, not a URI) and a byte range in its text. New (no go-to-definition in the Rust).
(defstruct LsLocation (path: str start: i64 end: i64))

;; What the front end made of a buffer: `diags` empty when the buffer checks; `own` whether the program holds the buffer's own definitions.
;; The program itself is `typed` (a types.program TypedProgram) kept by lsp.analysis; this record only names the parts others read.
(defstruct LsSummary (diags: (Vec LsDiag) own: bool))
