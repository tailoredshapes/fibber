;; compiler/lsp/scope.fib: what the reader sees at a cursor, and what kind of name is asked for (docs/design/fibref-port.md section 6). OWNER: package L2.
;; Rust: editor/scope.rs (409) and editor/context.rs (107). The text before the cursor, closed by the delimiters still open, reads even when the rest of
;; the buffer does not. `classify` works on the text before the cursor alone.
(ns lsp.scope
  (:use syntax.form))

(defstruct LsLocal (name: str start: i64 end: i64 ty: str))             ;; a parameter or `let` binding in scope; ty "" when not written
(defstruct LsDef (name: str kind: str start: i64 end: i64 signature: str))  ;; a top-level definition of the buffer
(defstruct LsScope (locals: (Vec LsLocal) defs: (Vec LsDef)))

;; What the cursor asks for: a name of the value, type or module namespace, a field after `.`, an export after `alias/`, a keyword.
(defenum LsAsk (AskValue) (AskType) (AskField receiver: str) (AskExport alias: str) (AskKeyword) (AskNone))
(defstruct LsCtx (ask: LsAsk prefix: str word-start: i64))

(defun scope-at (src: str word-start: i64 path: str) -> LsScope (trap "todo: lsp.scope scope-at"))
(defun classify (before: str) -> LsCtx (trap "todo: lsp.scope classify"))
(defun top-defs (forms: (Vec Form) text: str) -> (Vec LsDef) (trap "todo: lsp.scope top-defs"))
