;; compiler/expand/prelude/guard.fib: `if-not`, `some`, `declare` and the
;; presence macros `if-some`, `when-some`, `when-first` (stdlib §4.3, §4.4;
;; tranche 2 X3), as crates/fibref/src/expand/prelude/guard.rs:
;;
;;   (if-not c a b)            ==> (if (fib.prelude/not c) a b)   one-armed: the unit else
;;   (some p c)                ==> (fib.seq/some-p p c)
;;   (some x)                  declined: the constructor of `Option`
;;   (declare n..)             ==> (do)
;;   (if-some [x e] a b)       ==> (match e ((fib.prelude/some x) a) (_ b))
;;   (when-some [x e] body..)  ==> (match e ((fib.prelude/some x) body..) (_ ()))
;;   (when-first [x c] body..) ==> (match (fib.seq/first c) ((fib.prelude/some x) body..) (_ ()))
;;
;; `when-not` is not here: it is `unless` under Clojure's name, `when-macro`
;; of expand.prelude with its name for the arity error. The functions end in
;; `-macro` where the Rust name is a prelude macro (`some`, `declare`..).
;; `some-macro` answers `(Result (Option Stx) ExpandError)`, `nil` for the
;; decline, as the macros that decline do (expand.prelude `declinable-result`).
(ns expand.prelude.guard
  (:use syntax.pos syntax.form expand.error expand.build expand.collections expand.prelude.parts))

;; `(if-not c a b)` and the one-armed `(if-not c a)`. (`if_not`)
(defun if-not-macro (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (try-let ((_ (check-arity "if-not" items 2 (some 3) pos)))
    (Ok (call "if"
              [(call (prelude-name "not") [(nth items 1)] pos) (nth items 2) (item-or-unit items 3 pos)]
              pos))))

;; `(some p c)` is `fib.seq/some-p`; `(some x)` is the constructor and is
;; declined; any other count is an error. (`some`)
(defun some-macro (items: (Vec Stx) pos: Pos) -> (Result (Option Stx) ExpandError)
  (match (count items)
    (2 (Ok nil))
    (3 (Ok (some (call "fib.seq/some-p" (tail-from items 1) pos))))
    (n (Err (ExpandError (MacroArity "some" "1 or 2" (max 0 (- n 1))) pos)))))

;; `(declare n..)`: nothing, since every name is bound before any body is
;; checked (syntax §3.1). Each name must be a symbol. (`declare`)
(defun declare-macro (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (if-some [bad (find-first (fn (n) (not (some? (sym-of n)))) (tail-from items 1))]
    (Err (malformed "declare" "a name is a symbol" (. bad pos)))
    (Ok (call "do" (vec-empty) pos))))

;; The `pattern e` of a binding written `[pattern e]` or `(pattern e)`.
;; (`pair_of`)
(defun pair-of :private (name: str form: Stx) -> (Result (Vec Stx) ExpandError)
  (let ((parts (match (. form kind)
                 ((SList ps) ps)
                 ((SVec ps) ps)
                 (_ (vec-empty)))))
    (if (= (count parts) 2)
        (Ok parts)
        (Err (malformed name "the binding is [pattern expression]" (. form pos))))))

;; `(if-some [x e] a b)`; the else is `()` when there is none. (`if_some`)
(defun if-some-macro (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (try-let ((_ (check-arity "if-some" items 2 (some 3) pos))
            (b (pair-of "if-some" (nth items 1))))
    (Ok (option-match (nth b 0) (nth b 1) (nth items 2) (item-or-unit items 3 pos) pos))))

;; `(when-some [x e] body..)`. (`when_some`)
(defun when-some-macro (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (try-let ((_ (check-arity "when-some" items 1 nil pos))
            (b (pair-of "when-some" (nth items 1))))
    (Ok (option-match (nth b 0) (nth b 1) (body-form (tail-from items 2) pos) (unit pos) pos))))

;; `(when-first [x c] body..)`: `when-some` over `(fib.seq/first c)`.
;; (`when_first`)
(defun when-first-macro (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (try-let ((_ (check-arity "when-first" items 1 nil pos))
            (b (pair-of "when-first" (nth items 1))))
    (Ok (option-match (nth b 0)
                      (call "fib.seq/first" [(nth b 1)] pos)
                      (body-form (tail-from items 2) pos)
                      (unit pos)
                      pos))))
