;; compiler/expand/prelude/text.fib: `print-str`, `pr-str`, `println-str` and
;; `prn-str` (stdlib §4.14; tranche 2 X3), as
;; crates/fibref/src/expand/prelude/text.rs: the printers that return their
;; text. The text is the one `print`, `pr`, `println` and `prn` write
;; (expand.prelude.print): the pieces joined by one space, a literal `nil`
;; as the word `nil`, `Show` for the first and third and `Debug` for the
;; second and fourth.
;;
;;   (print-str)       ==> ""                (println-str) ==> "\n"
;;   (print-str a)     ==> (fib.prelude/show a)
;;   (println-str a b) ==> the text of (print-str a b), then "\n" concatenated once
(ns expand.prelude.text
  (:use syntax.pos syntax.form expand.build expand.prelude.print))

;; The text of the call `(NAME a ..)`: `debug` picks `Debug`, `newline` adds
;; the newline after the joined pieces. (`text`)
(defun text-macro (items: (Vec Stx) pos: Pos debug: bool newline: bool) -> Stx
  (let ((pieces (printer-pieces items pos debug)))
    (if (empty? pieces)
        (string (if newline "\n" "") pos)
        (let ((joined (join-pieces pieces (some " ") pos)))
          (if newline (concat-text joined (string "\n" pos) pos) joined)))))
