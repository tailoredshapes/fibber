;; compiler/expand/prelude/atoms.fib: `swap!` with Clojure's extra arguments
;; (stdlib design §4.1, tranche 1 R6a), as
;; crates/fibref/src/expand/prelude/atoms.rs:
;;
;;   (swap! a f x ..) ==> (fib.prelude/swap! a (fn (v) (f v x ..)))
;;
;; with `v` a gensym. The call of two arguments is the builtin's and is
;; declined (`swap-macro` answers `nil`); so is a call of fewer than two. The
;; extra arguments are evaluated inside the closure. Called by
;; expand.prelude (the registry row `swap!`).
(ns expand.prelude.atoms
  (:use syntax.pos syntax.form expand.error expand.ctx expand.build expand.collections expand.prelude.parts))

;; `(fn (v) (f v x ..))` with `v` a gensym.
(defun swap-closure :private (ctx: ExpandCtx f: Stx extra: (Vec Stx) pos: Pos) -> Stx
  (let ((v (ctx-gensym ctx "v" pos)))
    (list-form [(sym "fn" pos)
                (list-form [v] pos)
                (list-form (concat-forms [f v] extra) pos)]
               pos)))

;; One call of `swap!`: the rewrite from three arguments, else `nil`.
(defun swap-macro (ctx: ExpandCtx items: (Vec Stx) pos: Pos) -> (Option Stx)
  (if (< (count items) 4)
      nil
      (let ((f (swap-closure ctx (nth items 2) (tail-from items 3) pos)))
        (some (call (prelude-name "swap!") [(nth items 1) f] pos)))))

;; `(vswap! v f a ..)`: not atomic, as Clojure's, and the value is the new
;; one; `@c` and `reset!` are written `fib.prelude/deref` and
;; `fib.prelude/reset!`. (atoms.rs `vswap`)
(defun vswap-macro (ctx: ExpandCtx items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (try-let ((_ (check-arity "vswap!" items 2 nil pos)))
    (let ((c (ctx-gensym ctx "c" pos))
          (n (ctx-gensym ctx "n" pos))
          (applied (list-form (concat-forms [(nth items 2) (call (prelude-name "deref") [c] pos)]
                                            (tail-from items 3))
                              pos))
          (done (call "do" [(call (prelude-name "reset!") [c n] pos) n] pos))
          (inner (call "let" [(list-form [(list-form [n applied] pos)] pos) done] pos)))
      (Ok (call "let" [(list-form [(list-form [c (nth items 1)] pos)] pos) inner] pos)))))
