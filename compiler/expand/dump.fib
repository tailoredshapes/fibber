;; compiler/expand/dump.fib: the expansion dump of spec/bootstrap.md §5.1,
;; as crates/fibref/src/expand_dump/mod.rs (286 lines): for a file, the
;; header `== FILE` and then the program's expanded forms module by module
;; in the line format of the reader dump (`syntax.dump`), or the one
;; error record that ended it, or the line `unreadable`. The context a file
;; starts from is fresh each time (the expander's own prelude and
;; `lib/prelude.fib`, expanded with no runner in the scope `fib.prelude`
;; and ended: `prelude-forms` of expand.program), and `--context` adds the
;; lines of expand.dumpctx after each module.
;;
;; Shapes decided where Rust and fibber differ:
;; - the Rust options of the dump (`RunnerKind`, `LimitOverrides`,
;;   `Options`, `Options::default`) are defined in expand.args (porter 4),
;;   which owns the words that make them; this module uses it. Its
;;   `RunnerKind::None` is `NoRunner`.
;; - `expand_files(files, opts) -> (String, u8)` is the loop of the tool
;;   (compiler/expand.fib), which prints each file's output as it is made
;;   and keeps the largest status: `expand-file` is one iteration, giving
;;   the lines of the file's section (without their newlines, the header
;;   first) and the status it adds. A Rust `String` that is appended to
;;   is a `(Vec str)` of lines, a line that holds a line break (an error
;;   message may) being one element. Rust's thread of STACK_BYTES is not
;;   needed: the walks of the port use explicit stacks.
;; - `expand_kind_name` is `expand-err-name` of expand.error.
;; - the runner of the default `Evaluator` kind is stage 2b's
;;   (compiler/lair/expand.fib); stage 2a has none, so `runner-of` gives
;;   `no-runner` for both kinds and a user macro call is
;;   MacroNeedsEvaluator, as `--no-runner` makes it (spec/bootstrap.md
;;   §5.4: 2a is judged with `--no-runner`).
;; - the files are read with `read-file`, `nil` being `unreadable`: it is
;;   not UTF-8 text, or cannot be read.
;; - the prelude of the context is `prelude-forms` of expand.program, which
;;   reads `lib/prelude.fib` of the working directory; its failure, which
;;   Rust (that carries the file in the executable) cannot have, is the
;;   record `error Prelude 0:0 0..0: MESSAGE`.
(ns expand.dump
  (:require [syntax.reader :as reader] [syntax.dump :as sdump] [expand.modules :as mods]
            [expand.program :as prog] [expand.dumpctx :as dctx])
  (:use syntax.pos syntax.form syntax.error util.result expand.error expand.types expand.ctx
        expand.args))

;; One file's output: its lines and the status it adds (0 expanded, 1
;; ended in an error record, 2 unreadable). A line has no newline.
(defstruct Dumped (lines: (Vec str) status: i64))

;; The position of an error that has none: a module that cannot be found.
(def no-position: str "0:0 0..0")

;; `error KIND L:C S..E: MESSAGE`: the record of the reader dump. `at` is
;; the position as text, in the file `home` or with `@FILE` after it.
(defun record :private (kind: str at: str message: str) -> str
  (str-join ["error " kind " " at ": " message]))

(defun read-record :private (e: ReadError home: str) -> str
  (record (err-name (. e kind)) (sdump/span-in (. e pos) home) (err-message (. e kind))))

(defun expand-record :private (e: ExpandError home: str) -> str
  (record (expand-err-name (. e kind)) (sdump/span-in (. e pos) home) (expand-err-message (. e kind))))

;; The record of a program that could not be loaded. A module that is not
;; at its file prints no operating system text: it is not the same words
;; in every language a tool is written in.
(defun load-record :private (e: LoadErr home: str) -> str
  (match e
    ((LoadRead r) (read-record r home))
    ((LoadSpec pos what) (record "BadNs" (sdump/span-in pos home) what))
    ((LoadMissing _ _) (record "ModuleMissing" no-position (mods/load-err-message e)))
    ((LoadCycle _ _) (record "ModuleCycle" no-position (mods/load-err-message e)))
    ((LoadMismatch _ _ _) (record "ModuleMismatch" no-position (mods/load-err-message e)))))

;; Sets the limits of ctx to those overridden, once the prelude is
;; expanded. (LimitOverrides::apply)
(defun apply-limits :private (ctx: ExpandCtx o: LimitOverrides) -> unit
  (let ((l (ctx-limits ctx)))
    (ctx-set-limits ctx (Limits (unwrap-or (. o steps) (. l max-steps))
                                (unwrap-or (. o depth) (. l max-depth))
                                (unwrap-or (. o forms) (. l max-forms))))))

;; What runs the macros of a program. Stage 2a has no evaluator.
(defun runner-of :private (kind: RunnerKind) -> Runner
  (match kind
    ((Evaluator) (no-runner))
    ((NoRunner) (no-runner))))

(defun failed :private (lines: (Vec str) record: str) -> Dumped
  (Dumped (conj lines record) 1))

;; The sections of the modules of loaded, in order, after lines: each
;; begun in ctx, headed `-- module NS FILE`, expanded, dumped, followed
;; by the context when asked (before the module is ended) and ended; the
;; first expansion error is the last record.
(defun dump-modules :private (lines: (Vec str) ctx: ExpandCtx loaded: (Vec Loaded) runner: Runner
                              baseline: dctx/Baseline context: bool) -> Dumped
  (let ((n (count loaded)))
    (loop ((i 0) (acc lines))
      (if (< i n)
          (let ((l (nth loaded i))
                (spec (. l spec))
                (file (. l file)))
            (do (mods/begin-spec ctx spec)
                (let ((head (conj acc (str-join ["-- module " (. spec ns) " " file]))))
                  (match (prog/expand-program (. l forms) ctx runner)
                    ((Err e) (failed head (expand-record e file)))
                    ((Ok forms)
                     (let ((body (sdump/dump-forms-in head forms file))
                           (full (if context
                                     (dctx/dump-context body ctx (. spec ns) file baseline)
                                     body)))
                       (do (ctx-end-module ctx)
                           (recur (+ i 1) full))))))))
          (Dumped acc 0)))))

;; The dump of the program whose main module is source (the file `file`):
;; the prelude is expanded in a fresh context, then the program's modules
;; in dependency order, the main one last. (dump_program)
(defun dump-program :private (lines: (Vec str) source: str file: str opts: Options) -> Dumped
  (let ((ctx (ctx-new)))
    (match (prog/prelude-forms ctx)
      ((Err m) (failed lines (record "Prelude" no-position m)))
      ((Ok _)
       (do (apply-limits ctx (. opts limits))
           (let ((baseline (dctx/baseline-of ctx)))
             (match (mods/try-load source file)
               ((Err e) (failed lines (load-record e file)))
               ((Ok loaded)
                (dump-modules lines ctx loaded (runner-of (. opts runner)) baseline (. opts context))))))))))

;; The dump of source (the file `file`) as a library prelude, which is what
;; `prelude-forms` makes of `lib/prelude.fib`: expanded with no runner in
;; the module `fib.prelude`, after the expander's own prelude
;; (`prelude-source`), whose forms are in the same section and end with
;; `@<prelude>`. With `lib/prelude.fib` as the file it is the expanded
;; prelude every program expands in. (dump_prelude)
(defun dump-prelude :private (lines: (Vec str) source: str file: str opts: Options) -> Dumped
  (match (reader/read-all source file)
    ((Err e) (failed lines (read-record e file)))
    ((Ok lib)
     (let ((ctx (ctx-new))
           (head (conj lines (str-join ["-- module " prelude-ns " " file]))))
       (match (prog/expand-prelude ctx)
         ((Err e) (failed head (expand-record e file)))
         ((Ok own)
          (do (apply-limits ctx (. opts limits))
              (match (prog/expand-program lib ctx (no-runner))
                ((Err e) (failed head (expand-record e file)))
                ((Ok forms)
                 (let ((body (sdump/dump-forms-in (sdump/dump-forms-in head own file) forms file)))
                   (Dumped (if (. opts context)
                               (dctx/dump-context body ctx prelude-ns file (dctx/baseline-empty))
                               body)
                           0)))))))))))

;; What `fibref expand` prints for one file: the line `== FILE`, then its
;; dump or the line `unreadable`: the program's modules in dependency
;; order with their forms, or the one error record that ended it; as a
;; library prelude with `--prelude`. (the body of `expand_here`'s loop)
(defun expand-file (file: str opts: Options) -> Dumped
  (let ((header [(str-concat "== " file)]))
    (match (read-file file)
      (nil (Dumped (conj header "unreadable") 2))
      ((some source)
       (if (. opts prelude)
           (dump-prelude header source file opts)
           (dump-program header source file opts))))))
