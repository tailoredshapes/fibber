;; compiler/expand/shared.fib: the expansion of the library, done once for a batch of programs (docs/design/test-pyramid.md). A tool that
;; checks many files in one process (`types --batch`, `emit-dump --batch`) expands for each file the expander's prelude, `lib/prelude.fib` and the
;; implicit modules (what the files do not change); here that is kept as snapshots of the expander's context (serve.snap: a context is cells of
;; persistent values, so a copy continues where the first stopped and is not changed by what the copy goes on to expand). `base` is the context
;; after the preludes; the second part is the context after the implicit modules and the modules they read, with those modules as expanded,
;; under a key of their files (they are expanded the same for every program). Nothing here changes what a file expands to: a tool run with and without
;; `--batch` prints the same bytes, which the golden check compares.
(ns expand.shared
  (:require [expand.modules :as mods] [expand.program :as prog] [expand.libdir :as libdir] [serve.snap :as snap])
  (:use syntax.form expand.types expand.ctx))

(defstruct Shared (base: (Cell (Option ExpandCtx)) prelude: (Cell (Vec Stx))
                   key: (Cell str) ctx: (Cell (Option ExpandCtx)) done: (Cell (Vec Expanded))
                   hint: (Cell (Option (Pair str i64)))))

(defstruct Start (ctx: ExpandCtx prelude: (Vec Stx)))

(defun shared-new () -> Shared (Shared (cell nil) (cell (vec-empty)) (cell "") (cell nil) (cell (vec-empty)) (cell nil)))

;; A fresh copy of the context after the expander's prelude and `lib/prelude.fib`, and the prelude's forms (the macro runner takes them).
(defun shared-start (sh: Shared) -> (Result Start str)
  (match @(. sh base)
    ((some c) (Ok (Start (snap/ctx-snapshot c) @(. sh prelude))))
    (nil (let ((ctx (ctx-new)))
           (match (prog/prelude-forms ctx)
             ((Err m) (Err m))
             ((Ok forms) (do (set! (. sh base) (some (snap/ctx-snapshot ctx)))
                             (set! (. sh prelude) forms)
                             (Ok (Start ctx forms)))))))))

;; How many of loaded, from the start, are implicit (the loader reads them first).
(defun implicit-count (loaded: (Vec Loaded)) -> i64
  (loop ((i 0)) (if (and (< i (count loaded)) (. (nth loaded i) implicit)) (recur (+ i 1)) i)))

(defun prefix-key (loaded: (Vec Loaded) k: i64) -> str
  (loop ((i 0) (acc (vec-empty)))
    (if (< i k)
        (recur (+ i 1) (conj acc (str-join [(. (. (nth loaded i) spec) ns) "@" (. (nth loaded i) file)])))
        (str-join acc))))

;; The context after the implicit modules `key` names, and those modules as expanded, when they are kept.
(defun shared-prefix (sh: Shared key: str) -> (Option (Pair ExpandCtx (Vec Expanded)))
  (match @(. sh ctx)
    (nil nil)
    ((some c) (if (= key @(. sh key)) (some (Pair (snap/ctx-snapshot c) @(. sh done))) nil))))

;; Keeps ctx (copied) and the expanded modules as the state after the implicit modules `key` names.
(defun shared-keep (sh: Shared key: str ctx: ExpandCtx done: (Vec Expanded)) -> unit
  (do (set! (. sh key) key)
      (set! (. sh ctx) (some (snap/ctx-snapshot ctx)))
      (set! (. sh done) done)))

;; The words of a command line without the `--batch` that stands among its options (before a lone `--`), and whether there was one.
(defun take-batch (words: (Vec str)) -> (Pair bool (Vec str))
  (loop ((i 0) (found false) (out (vec-empty)) (open true))
    (if (< i (count words))
        (let ((w (nth words i)))
          (if (and open (= w "--batch"))
              (recur (+ i 1) true out open)
              (recur (+ i 1) found (conj out w) (and open (!= w "--")))))
        (Pair found out))))

;; What a batch tool prints after each file's section, so that a caller can cut the stream: `#### status N`, the status that file adds.
(defun batch-trailer (status: i64) -> str (str-concat "#### status " (show status)))

;; ---- the library prefix of the program being checked (the persistent checker, own.staged)

;; The key of the library the checker keeps its state for: the files of the first `k` of `loaded` (names and contents) and the text of
;; `lib/prelude.fib`. A change to any of them is a different key.
(defun content-key (loaded: (Vec Loaded) k: i64) -> str
  (content-key-of (prefix-key loaded k)
                  (mapv (fn (i: i64) (unwrap-or (read-file (. (nth loaded i) file)) "")) (range k))
                  (unwrap-or (read-file (str-concat (libdir/library-dir) "/prelude.fib")) "")))

;; `content-key` from the names and files of the modules (`prefix-key`), the text of each and the text of the prelude.
(defun content-key-of (names: str texts: (Vec str) prelude: str) -> str
  (str-join [names "#" (str-join (mapv (fn (t: str) (str-join [(show (hash t)) ":" (show (str-len t)) ","])) texts)) "#" (show (hash prelude)) ":" (show (str-len prelude))]))

;; What the loader of a batch tells its check: the key of the first `k` modules of the program, the library. Kept in the batch's `Shared`
;; and set before the check of each file.
(defun hint-set (sh: Shared key: str k: i64) -> unit (set! (. sh hint) (some (Pair key k))))

(defun hint-get (sh: Shared) -> (Option (Pair str i64)) @(. sh hint))
