;; compiler/expand/brackets.fib: the bracket binding forms (syntax §3.2, §3.3, §3.18; X2, E3), as
;; crates/fibref/src/expand/brackets.rs: the bracket spelling of the binding list of `let` and `loop`
;; and of the parameter list of `fn` is the parenthesised form they have always had.
;;
;;   (let [a 1 b 2] body)           (let ((a 1) (b 2)) body)
;;   (let [a: i64 1 b 2] body)      (let ((a: i64 1) (b 2)) body)
;;   (loop [i 0 acc 0] body)        (loop ((i 0) (acc 0)) body)
;;   (fn [x y] body)                (fn (x y) body)
;;   (fn name [x y] body)           (fn name (x y) body)
;;
;; A binding is a pattern and an expression; a name that ends in `:` takes the next form as its type
;; and the next as its value, three items. The rewrite is syntactic, one level, and counts no step:
;; expand.expr loops on its result without admitting it, so the planner and the checker only ever
;; see the parenthesised forms. `seq-items`, the Rust `brackets::seq_items`, is in expand.prelude.parts
;; with the other readers of a form's items, which the prelude macros share.
(ns expand.brackets
  (:use syntax.pos syntax.form expand.error expand.build expand.core expand.prelude.parts))

;; The index of the bracket operand of `(let [..] ..)`, `(loop [..] ..)`, `(fn [..] ..)` or
;; `(fn name [..] ..)`, when the form has one. (`bracket_at`)
(defun bracket-at :private (items: (Vec Stx)) -> (Option i64)
  (let [head (if (> (count items) 0) (unwrap-or (sym-of (nth items 0)) "") "")
        at (cond (or (= head "let") (= head "loop")) 1
                 (and (= head "fn") (> (count items) 1) (some? (sym-of (nth items 1)))) 2
                 (= head "fn") 1
                 :else 0)]
    (if (and (> at 0) (< at (count items)))
        (match (. (nth items at) kind)
          ((SVec _) (some at))
          (_ nil))
        nil)))

;; Whether `form` is a `let`, `loop` or `fn` written with a bracket operand. (`has_brackets`)
(defun has-brackets (form: Stx) -> bool
  (match (items-of form)
    ((some items) (some? (bracket-at items)))
    (nil false)))

;; The bindings of a flat binding vector as the parenthesised pairs: `pattern expr` and
;; `name: type expr`. An incomplete one is refused at its first form. (`pairs`)
(defun pairs :private (head: str flat: (Vec Stx)) -> (Result (Vec Stx) ExpandError)
  (loop [i 0 out (vec-empty)]
    (if (>= i (count flat))
        (Ok out)
        (let [lead (nth flat i)
              width (if (annotated-name lead) 3 2)]
          (if (> (+ i width) (count flat))
              (Err (malformed head "a binding is a pattern and an expression, or name: a type and an expression"
                              (. lead pos)))
              (recur (+ i width)
                     (conj out (list-form (head-of (tail-from flat i) width) (. lead pos)))))))))

;; `form` with its bracket operand in the parenthesised spelling; a form without one is returned
;; as it is. (`rewrite`)
(defun rewrite (form: Stx) -> (Result Stx ExpandError)
  (let [items (unwrap-or (items-of form) (vec-empty))]
    (if-some [at (bracket-at items)]
      (let [operand (nth items at)
            inner (unwrap-or (seq-items operand) (vec-empty))
            head (unwrap-or (sym-of (nth items 0)) "let")]
        (try-let ((parts (if (= head "fn") (Ok inner) (pairs head inner))))
          (Ok (list-form (concat-forms (conj (head-of items at) (list-form parts (. operand pos)))
                                       (tail-from items (+ at 1)))
                         (. form pos)))))
      (Ok form))))
