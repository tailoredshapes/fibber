;; compiler/expand/targetos.fib: the operating system the code is generated for, as the compiler's front end and emitter ask it (docs/design/aarch64.md 2.1).
;; Without FIB_TARGET_TRIPLE it is the host's (`fib.os.platform.detect/current`: `uname`); with it, the triple's row of types.targets decides (`runtime-os`): an Apple triple
;; is "Darwin", anything else "Linux" (for the wasm rows a stand-in: docs/design/targets.md). It picks the OS backend of the library (expand.roots) and the runtime's libc adaptation (emit.rt).
(ns expand.targetos (:require [fib.os.platform :as platform] [types.targets :as tt]))

;; The OS name of a triple: its row's runtime OS.
(defun name-of-triple (triple: str) -> str
  (. (tt/target-row-of-triple triple) runtime-os))

;; The OS the generated code is for.
(defun target-platform-name () -> str
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    ((some t) (if (or (= t "") (= t "host")) (platform/name (platform/current)) (name-of-triple t)))
    (nil (platform/name (platform/current)))))

;; The OS this process runs on (what the JIT, and so a macro, sees).
(defun host-platform-name () -> str
  (platform/name (platform/current)))
