;; compiler/expand/targetos.fib: the operating system the code is generated for, as the compiler's front end and emitter ask it (docs/design/aarch64.md 2.1).
;; Without FIB_TARGET_TRIPLE it is the host's (`fib.os.platform.detect/current`: `uname`); with it, the triple decides: an Apple triple (`-apple-`, `-darwin`,
;; `-ios`, `-macos`) is "Darwin", anything else "Linux". It picks the OS backend of the library (expand.roots) and the runtime's libc adaptation (emit.rt).
(ns expand.targetos (:require [fib.os.platform :as platform]))

(defun has :private (s: str t: str) -> bool (some? (str-find s t 0)))

;; The OS name of a triple.
(defun name-of-triple (triple: str) -> str
  (if (or (has triple "-apple-") (has triple "-darwin") (has triple "-ios") (has triple "-macos")) "Darwin" "Linux"))

;; The OS the generated code is for.
(defun target-platform-name () -> str
  (match (sys-getenv "FIB_TARGET_TRIPLE")
    ((some t) (if (or (= t "") (= t "host")) (platform/name (platform/current)) (name-of-triple t)))
    (nil (platform/name (platform/current)))))
