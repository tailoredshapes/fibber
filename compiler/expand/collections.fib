;; compiler/expand/collections.fib: literal collections in expression
;; position become library calls after expansion (syntax §1.4), as
;; crates/fibref/src/expand/collections.rs (51 lines of Rust).
;;
;;   []              => (vec-empty)
;;   [e1 e2 ... en]  => (vec-conj (vec-conj ... (vec-conj (vec-empty) e1) ...) en)
;;   {}              => (map-empty)
;;   {k1 v1 ...}     => (map-assoc (map-assoc (map-empty) k1 v1) ...)
;;
;; §1.4: "the rewrite resolves them in the prelude, not in the current
;; namespace". A form can only carry that as a qualified symbol, so the
;; heads are written `fib.prelude/vec-conj` etc., which a user binding of
;; `vec-conj` cannot shadow. The targets are the prelude's ordinary
;; functions on `Vec` and `Map`, not the methods of its `Collection` and
;; `Associative` protocols (stdlib design C-5): the library's `fib.coll`
;; defines `conj` and `assoc` of its own, and the flip deletes the
;; prelude's protocols. The built calls take the position of the literal;
;; the elements keep their own (§1.3).
;;
;; `PRELUDE_NS` is `prelude-ns` of `expand.ctx` (the skeleton defines it,
;; with the same value, and two modules that both export a name make a
;; bare reference to it an error in any module that `:use`s both), so
;; this module keeps its own copy private, and exports `prelude-name`.
(ns expand.collections (:use syntax.pos syntax.form expand.build))

(def prelude-ns: str :private "fib.prelude")

;; `fib.prelude/name`: a head no user binding of `name` can shadow.
(defun prelude-name (name: str) -> str
  (str-join [prelude-ns "/" name]))

;; The rewrite of `[items...]`, the items already expanded.
(defun vec-literal (items: (Vec Stx) pos: Pos) -> Stx
  (let ((vec-conj-head (prelude-name "vec-conj"))
        (n (count items)))
    (loop ((i 0) (acc (call (prelude-name "vec-empty") (vec-empty) pos)))
      (if (< i n)
          (recur (+ i 1) (call vec-conj-head [acc (nth items i)] pos))
          acc))))

;; The rewrite of `{k1 v1 ...}`, the items already expanded. The reader
;; guarantees an even count; a trailing odd item (only a macro can build
;; one) is paired with nothing and dropped, so callers check the count
;; first.
(defun map-literal (items: (Vec Stx) pos: Pos) -> Stx
  (let ((map-assoc-head (prelude-name "map-assoc"))
        (n (count items)))
    (loop ((i 0) (acc (call (prelude-name "map-empty") (vec-empty) pos)))
      (if (< (+ i 1) n)
          (recur (+ i 2) (call map-assoc-head [acc (nth items i) (nth items (+ i 1))] pos))
          acc))))
