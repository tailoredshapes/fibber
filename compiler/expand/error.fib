;; compiler/expand/error.fib: expansion errors, as
;; crates/fibref/src/expand/error.rs (260 lines of Rust). Every malformed
;; input to the expander is one of these values, with the position of the
;; offending form; the expander never traps on input (a `trap` here is
;; for a state that cannot happen).
;;
;; THE SHARED BASE of M6 step 2 (spec/bootstrap.md §5): the types are
;; fixed. `expand-err-message` was a `todo:` stub and is written (porter
;; 1); `pos-display` and `expand-error-text` are added (the Display of a
;; `Pos` and of an `ExpandError`, which `types::prelude_forms`' error
;; text and the messages of `expand.modules` need). Nothing here may
;; change without telling the other porters.
;;
;; `TooDeep` is also a variant of the reader's `ErrKind` (syntax.error),
;; and a variant's name is global to the modules that `:use` its module: a
;; module that `:use`s both this one and syntax.error must write
;; `expand.error/TooDeep` (the compiler says so where the bare name is
;; used). Every other name of the two modules is different.
(ns expand.error (:use syntax.pos syntax.form syntax.error))

;; The variants of ExpandErrorKind, with the same names and fields (a
;; `&'static str` is a str, a usize an i64, BadLiteral's ReadErrorKind
;; the reader's ErrKind).
(defenum ExpandErrKind
  (MacroNeedsEvaluator name: str)
  (MacroPhase name: str fun: str)
  (MacroFailed name: str message: str)
  (MacroArity name: str expected: str found: i64)
  (AmbiguousMacro name: str first: str second: str)
  (UnquoteOutsideQuasiquote head: str)
  (SpliceOutsideList)
  (Malformed head: str reason: str)
  (MacroNamesCoreForm name: str)
  (DeriveProtocol name: str)
  (DeriveTarget name: str)
  (NotAStruct op: str name: str)
  (NotAnEnum op: str name: str)
  (BadReflection op: str)
  (ThreadStep)
  (InOutOutsideArgument)
  (NilCalled)
  (BraceInPattern)
  (ExpressionAtTopLevel)
  (DefinitionInExpression head: str)
  (NsNotFirst)
  (TooManySteps limit: i64)
  (TooDeep limit: i64)
  (TooLarge limit: i64)
  (BadLiteral error: ErrKind))

;; An expansion error: what went wrong and where (a macro call's position
;; for a macro).
(defstruct ExpandError (kind: ExpandErrKind pos: Pos))

;; The variant's own name, as `expand_kind_name` of
;; crates/fibref/src/expand_dump/mod.rs prints it in the dump record.
(defun expand-err-name (k: ExpandErrKind) -> str
  (match k
    ((MacroNeedsEvaluator _) "MacroNeedsEvaluator")
    ((MacroPhase _ _) "MacroPhase")
    ((MacroFailed _ _) "MacroFailed")
    ((MacroArity _ _ _) "MacroArity")
    ((AmbiguousMacro _ _ _) "AmbiguousMacro")
    ((UnquoteOutsideQuasiquote _) "UnquoteOutsideQuasiquote")
    ((SpliceOutsideList) "SpliceOutsideList")
    ((Malformed _ _) "Malformed")
    ((MacroNamesCoreForm _) "MacroNamesCoreForm")
    ((DeriveProtocol _) "DeriveProtocol")
    ((DeriveTarget _) "DeriveTarget")
    ((NotAStruct _ _) "NotAStruct")
    ((NotAnEnum _ _) "NotAnEnum")
    ((BadReflection _) "BadReflection")
    ((ThreadStep) "ThreadStep")
    ((InOutOutsideArgument) "InOutOutsideArgument")
    ((NilCalled) "NilCalled")
    ((BraceInPattern) "BraceInPattern")
    ((ExpressionAtTopLevel) "ExpressionAtTopLevel")
    ((DefinitionInExpression _) "DefinitionInExpression")
    ((NsNotFirst) "NsNotFirst")
    ((TooManySteps _) "TooManySteps")
    ((TooDeep _) "TooDeep")
    ((TooLarge _) "TooLarge")
    ((BadLiteral _) "BadLiteral")))

;; The kind's Display text: the message after the position, word for
;; word as `impl Display for ExpandErrorKind` writes it.
(defun expand-err-message (k: ExpandErrKind) -> str
  (match k
    ((MacroNeedsEvaluator name)
     (str-join ["macro " name " needs the evaluator to expand (pending)"]))
    ((MacroPhase name fun)
     (str-join ["macro " name " calls " fun ", which is not available at expansion time; move "
                fun " to a required module"]))
    ((MacroFailed name message) (str-join ["macro " name " failed: " message]))
    ((MacroArity name expected found)
     (str-join ["macro " name " takes " expected " argument(s), got " (show found)]))
    ((AmbiguousMacro name a b)
     (str-join [name " is exported by both " a " and " b "; write " a "/" name " or " b "/" name]))
    ((UnquoteOutsideQuasiquote head) (str-join [head " outside quasiquote"]))
    ((SpliceOutsideList) "unquote-splicing outside a list, vector or map")
    ((Malformed head reason) (str-join ["malformed " head ": " reason]))
    ((MacroNamesCoreForm name) (str-join ["defmacro cannot redefine core form " name]))
    ((DeriveProtocol name) (str-join ["cannot derive " name ": only Eq, Ord, Hash, Show, Debug and ToStr"]))
    ((DeriveTarget name) (str-join ["cannot derive for " name ": not a struct or enum"]))
    ((NotAStruct op name) (str-join [op ": " name " is not a struct"]))
    ((NotAnEnum op name) (str-join [op ": " name " is not an enum"]))
    ((BadReflection op) (str-join ["bad reflection call " op ": expects one symbol"]))
    ((ThreadStep) "threading step must be a symbol or a non-empty list")
    ((InOutOutsideArgument) "& x is only allowed on a symbol, as an argument of a call")
    ((NilCalled) "nil is a constant, not a function; write nil")
    ((BraceInPattern) "braces are not allowed in patterns")
    ((ExpressionAtTopLevel) "expression at top level")
    ((DefinitionInExpression head) (str-join [head " is only allowed at top level"]))
    ((NsNotFirst) "ns must be the first form of the module")
    ((TooManySteps limit)
     (str-join ["more than " (show limit) " macro expansions in one top-level form"]))
    ((TooDeep limit) (str-join ["expansion nested deeper than " (show limit) " levels"]))
    ((TooLarge limit)
     (str-join ["macro expansions of one top-level form produced more than " (show limit)
                " forms"]))
    ((BadLiteral e) (str-join ["a macro built an invalid literal: " (err-message e)]))))

;; A position as Rust's `Pos` Display writes it: FILE:LINE:COL (not the
;; dump's `LINE:COL START..END`, which is `syntax.dump`'s `span`).
(defun pos-display (p: Pos) -> str
  (str-join [(. p file) ":" (show (. p line)) ":" (show (. p col))]))

;; The error's Display text: `FILE:LINE:COL: MESSAGE`
;; (`impl Display for ExpandError`; `types::prelude_forms` returns it).
(defun expand-error-text (e: ExpandError) -> str
  (str-join [(pos-display (. e pos)) ": " (expand-err-message (. e kind))]))

;; An error of kind at pos, as a value to return.
(defun expand-error (kind: ExpandErrKind pos: Pos) -> ExpandError
  (ExpandError kind pos))

;; `Malformed head reason` at pos (expand/build.rs `malformed`).
(defun malformed-error (head: str reason: str pos: Pos) -> ExpandError
  (ExpandError (Malformed head reason) pos))
