;; compiler/expand/fuseinline.fib: a fused chain with its stage functions in line (docs/design/vec-performance.md item 2;
;; stage 2 only, no Rust twin). Run on a top-level form after the let rule (expand.fuselet) and before the fusing walk:
;;
;;   (mapv F c)  (filterv P c)  (vec CHAIN)  (into [] CHAIN)
;;
;; where CHAIN is a call of `map`, `filter`, `remove`, `keep`, `take` or `take-while` whose collection is another (down to a
;; source that is none), or `(map F a b)` at the bottom of a chain of `map`s, and every stage function is a symbol (a
;; function called directly) or a plain `fn` literal, becomes loops with the stages' bodies in line: `(let ((x elt)) body)`
;; for a literal, `(g elt)` for a symbol, nested from the innermost stage out. The loops are written by
;;  - expand.fusespan, for a chain of `map`s over sources held in arrays (a Vec, an Array: the `span-count` and `span-array`
;;    methods of Reducible), which is asked when the program runs: any other source takes the call as it was, which the
;;    fusing walk then makes recipes of;
;;  - expand.fuserange, for a chain of `map`s over a `range` call (`(range n)`, `(range a b)`, `(range a b s)`, `range-by`):
;;    the loop walks the range itself, by repeated addition of the step, as its Reducible instance does;
;;  - expand.fuseflow, for a chain with other steps over one source of either kind: a loop that appends what comes through
;;    to a builder, a take's count a loop variable, the walk ended where the recipes Taken and TakenWhile end it.
;; The first two write the output in fresh arrays of 32 that `vec-from-spans` makes the Vec without a copy, and their inner
;; loop is the shape LLVM vectorises: one counted loop from a small constant, every array index the loop variable itself (an
;; index with an offset, `(array-get b (+ i d))`, leaves a bounds check LLVM cannot count, and the loop is not vectorised).
;; The third has branches and early exits and is not vectorised; it calls nothing through a pointer.
;;
;; Why it is the same program: the stage functions are atomic (a symbol or a `fn` form: evaluating them has no effect),
;; so evaluating the sources first, in their order, moves nothing past an effect (a take's count that is not atomic is
;; evaluated before them, the outermost first, as the calls evaluate them); the elements are read once each, in
;; order, and each stage runs once per element, innermost first, element after element, as the recipe walk runs them; a
;; trap in a stage traps at the same element. A literal is taken only when it is a plain `fn` (no name, `->` or `:where`)
;; whose parameters are symbols, one per element it receives, and whose body has no `recur` outside a `loop` of its own
;; (it would bind to the loop) and is small: it is written twice, for the first element (which fills the output arrays)
;; and in the loop, besides the call as it was. The names the loop uses bare (`array`, `cell` ..) must not be bound by
;; the form or defined by the module.
(ns expand.fuseinline
  (:use syntax.pos syntax.form expand.ctx expand.build expand.collections expand.fusetab expand.fusescan expand.fuse
        expand.fusegen expand.fusespan expand.fuserange expand.fuseflow))

;; The bodies of the stages, in nodes, past which the chain is not put in line.
(def max-body-nodes: i64 200)

;; The names the loop uses bare.
(def bare-names: (Vec str) ["let" "loop" "if" "do" "recur" "cell" "array" "array-get" "array-set!" "array-len" "deref" "&" "." "match" "some"])

(defun form-nodes :private (f: Stx) -> i64
  (match (. f kind)
    ((SList items) (items-nodes items))
    ((SVec items) (items-nodes items))
    ((SMap items) (items-nodes items))
    (_ 1)))

(defun items-nodes :private (items: (Vec Stx)) -> i64
  (loop ((i 0) (acc 1))
    (if (< i (count items)) (recur (+ i 1) (+ acc (form-nodes (nth items i)))) acc)))

;; Whether `f` has a `recur` that is not inside a `loop` or a `fn` of its own: in line, it would bind to the loop.
(defun has-recur? :private (f: Stx) -> bool
  (match (. f kind)
    ((SSym s) (= s "recur"))
    ((SList items) (if (or (= (fuse-item-sym items 0) (some "loop")) (= (fuse-item-sym items 0) (some "fn")))
                       false
                       (any-recur? items)))
    ((SVec items) (any-recur? items))
    ((SMap items) (any-recur? items))
    (_ false)))

(defun any-recur? :private (items: (Vec Stx)) -> bool
  (loop ((i 0))
    (cond (>= i (count items)) false
          (has-recur? (nth items i)) true
          :else (recur (+ i 1)))))

;; The number of parameters of a literal's list when each is a symbol (`x`, or `x:` and its type); -1 otherwise.
(defun param-count :private (params: (Vec Stx)) -> i64
  (loop ((i 0) (n 0))
    (if (>= i (count params))
        n
        (match (fuse-sym-of (nth params i))
          (nil -1)
          ((some s) (cond (or (= s "&") (= s "nil")) -1
                          (fg-ends-with-colon? s) (if (< (+ i 1) (count params)) (recur (+ i 2) (+ n 1)) -1)
                          :else (recur (+ i 1) (+ n 1))))))))

(defun annotation? :private (f: Stx) -> bool
  (match (. f kind)
    ((SSym s) (= s "->"))
    ((SKw k) (= k "where"))
    (_ false)))

;; The stage `f` is, taking `arity` elements, if it can be put in line.
(defun in-stage :private (f: Stx arity: i64) -> (Option InStage)
  (match (. f kind)
    ((SSym s) (if (or (= s "nil") (= s "fn")) nil (some (InSym f))))
    ((SList items)
     (if (and (>= (count items) 3)
              (= (fuse-item-sym items 0) (some "fn"))
              (fuse-list-form? (nth items 1))
              (not (annotation? (nth items 2)))
              (= (param-count (fuse-list-items (nth items 1))) arity))
         (let ((body (loop ((i 2) (acc (vec-empty)))
                       (if (< i (count items)) (recur (+ i 1) (conj acc (nth items i))) acc))))
           (if (any-recur? body) nil (some (InFn (fuse-list-items (nth items 1)) body))))
         nil))
    (_ nil)))

(defun stage-nodes :private (s: InStage) -> i64
  (match s
    ((InFn _ body) (items-nodes body))
    ((InSym _) 1)))

(defun step-nodes :private (st: Step) -> i64
  (match st
    ((StMap f) (stage-nodes f))
    ((StFilter p) (stage-nodes p))
    ((StRemove p) (stage-nodes p))
    ((StKeep f) (stage-nodes f))
    ((StTake _) 1)
    ((StTakeWhile p) (stage-nodes p))))

;; ------------------------------------------------------------ reading the chain

;; The library's name of the call `items` (`fib.seq/map`, `map$2` and a bare `map` the form and module do not shadow are
;; `map`), with its arguments counted.
(defun seq-name :private (env: FuseEnv items: (Vec Stx)) -> (Option str)
  (match (fuse-item-sym items 0)
    (nil nil)
    ((some head) (fuse-library env head (- (count items) 1) FacSeq))))

;; A step read from a call, and what it reads: one collection, or the two sources of a two-source `map`.
(defstruct Got (step: Step colls: (Vec Stx)))

(defun one-arg :private (items: (Vec Stx) make: (fn (InStage) Step)) -> (Option Got)
  (match (in-stage (nth items 1) 1)
    ((some s) (some (Got (make s) [(nth items 2)])))
    (nil nil)))

;; The step the call `items` is, if it is one this rewrite takes; `mapv` is `map` and `filterv` `filter` when `top`.
(defun step-of :private (env: FuseEnv items: (Vec Stx) top: bool) -> (Option Got)
  (let ((argc (- (count items) 1)))
    (match (seq-name env items)
      (nil nil)
      ((some name)
       (cond (and (= argc 3) (= name "map"))
             (match (in-stage (nth items 1) 2)
               ((some s) (some (Got (StMap s) [(nth items 2) (nth items 3)])))
               (nil nil))
             (not (= argc 2)) nil
             (or (= name "map") (and top (= name "mapv"))) (one-arg items (fn (s) (StMap s)))
             (or (= name "filter") (and top (= name "filterv"))) (one-arg items (fn (s) (StFilter s)))
             (= name "remove") (one-arg items (fn (s) (StRemove s)))
             (= name "keep") (one-arg items (fn (s) (StKeep s)))
             (= name "take-while") (one-arg items (fn (s) (StTakeWhile s)))
             (= name "take") (some (Got (StTake (nth items 1)) [(nth items 2)]))
             :else nil)))))

;; Whether `c` is a call of the library's `range` (one or three arguments) or `range-by`: its value is a Range.
(defun range-call? :private (env: FuseEnv c: Stx) -> bool
  (let ((items (fuse-list-items c)))
    (match (seq-name env items)
      (nil false)
      ((some name) (let ((argc (- (count items) 1)))
                     (or (and (= name "range") (or (= argc 1) (= argc 3)))
                         (and (= name "range-by") (= argc 3))))))))

;; The chain read from `c`, the collection of the steps already taken (`steps`, `depth` stage calls below the top).
(defun descend :private (env: FuseEnv c: Stx steps: (Vec Step) depth: i64) -> Chain
  (match (step-of env (fuse-list-items c) false)
    ((some g) (if (= (count (. g colls)) 2)
                  (Chain (conj steps (. g step)) (. g colls) (+ depth 1) false)
                  (descend env (nth (. g colls) 0) (conj steps (. g step)) (+ depth 1))))
    (nil (Chain steps [c] depth (range-call? env c)))))

;; The chain of the top call (a `mapv` or `filterv` call, or the stage call `vec` and `into []` read), if its step is one.
(defun chain-of :private (env: FuseEnv top: Stx) -> (Option Chain)
  (match (step-of env (fuse-list-items top) true)
    (nil nil)
    ((some g) (if (= (count (. g colls)) 2)
                  (some (Chain [(. g step)] (. g colls) 0 false))
                  (some (descend env (nth (. g colls) 0) [(. g step)] 0))))))

;; The top of the chain of a terminal call, if it is one this rewrite takes: the `mapv` or `filterv` call itself, or the
;; stage call `vec` and `into []` read; and where in the call it is (-1 for `mapv`, the call is the top).
(defstruct Top (form: Stx at: i64))

(defun top-of :private (env: FuseEnv items: (Vec Stx)) -> (Option Top)
  (match (fuse-item-sym items 0)
    (nil nil)
    ((some head)
     (let ((argc (- (count items) 1)))
       (cond (and (= argc 2) (or (= (fuse-library env head 2 FacSeq) (some "mapv")) (= (fuse-library env head 2 FacSeq) (some "filterv"))))
             (some (Top (list-form items (. (nth items 0) pos)) -1))
             (and (= argc 1) (= (fuse-library env head 1 FacColl) (some "vec")) (stage-call? env (nth items 1)))
             (some (Top (nth items 1) 1))
             (and (= argc 2) (= (fuse-library env head 2 FacColl) (some "into")) (empty-vec? (nth items 1))
                  (stage-call? env (nth items 2)))
             (some (Top (nth items 2) 2))
             :else nil)))))

(defun stage-call? :private (env: FuseEnv f: Stx) -> bool
  (some? (step-of env (fuse-list-items f) false)))

;; `[]` as the first walk leaves it.
(defun empty-vec? :private (f: Stx) -> bool
  (let ((items (fuse-list-items f)))
    (and (= (count items) 1) (= (fuse-item-sym items 0) (some "fib.prelude/vec-empty")))))

;; Whether the chain is one the loops are written for, small enough, and none of the bare names is the form's or the
;; module's: a chain of `map` steps over one or two sources, or a chain with other steps over one source (a filter, remove
;; or take-while asks `truthy?` of fib.core, which the module must see). A source that is itself a stage the recipe rewrite
;; takes (a `drop`, a `mapcat`, a `map` whose function is not put in line ..) is left to it: bound to a name it would be
;; the lazy seq, which converts a source that is not one in full (case 821).
(defun chain-ok? :private (env: FuseEnv ch: Chain) -> bool
  (and (loop ((i 0))
         (cond (>= i (count (. ch sources))) true
               (some? (fuse-stage-call env (fuse-list-items (nth (. ch sources) i)))) false
               :else (recur (+ i 1))))
       (or (fg-maps-only? (. ch steps))
           (and (= (count (. ch sources)) 1) (or (. (. env module) core) (not (needs-truthy? (. ch steps))))))
       (<= (loop ((i 0) (n 0))
             (if (< i (count (. ch steps))) (recur (+ i 1) (+ n (step-nodes (nth (. ch steps) i)))) n))
           max-body-nodes)
       (loop ((i 0))
         (cond (>= i (count bare-names)) true
               (name-taken? env (nth bare-names i)) false
               :else (recur (+ i 1))))))

(defun needs-truthy? :private (steps: (Vec Step)) -> bool
  (loop ((i 0))
    (cond (>= i (count steps)) false
          (match (nth steps i) ((StFilter _) true) ((StRemove _) true) ((StTakeWhile _) true) (_ false)) true
          :else (recur (+ i 1)))))

;; Whether `name` is bound by the form or is the module's own.
(defun name-taken? :private (env: FuseEnv name: str) -> bool
  (or (fuse-has-name? (. env bound) name)
      (fuse-has-name? (. (. env module) shadow) name)))

;; ------------------------------------------------------------ the rewrite

;; The rewrite of the terminal call `form` (items `items`), if it is one.
(defun inline-call :private (env: FuseEnv ctx: ExpandCtx form: Stx items: (Vec Stx)) -> (Option Stx)
  (match (top-of env items)
    (nil nil)
    ((some top)
     (let ((top-form (if (< (. top at) 0) form (. top form))))
       (match (chain-of env top-form)
         (nil nil)
         ((some ch) (if (chain-ok? env ch) (some (rewritten ctx form items top top-form ch)) nil)))))))

;; The loops of the chain; the call as it was, with gensyms for its sources, is the fallback. The count of a `take` that is
;; not atomic is evaluated first, the outermost first, as the calls evaluate them (each before the collection it reads),
;; and its gensym is the count in the loops and in the fallback.
(defun rewritten :private (ctx: ExpandCtx form: Stx items: (Vec Stx) top: Top top-form: Stx ch0: Chain) -> Stx
  (let ((pos (. form pos)) (counts (count-pairs ctx (. ch0 steps) pos)))
    (let ((ch (Chain (. counts steps) (. ch0 sources) (. ch0 depth) (. ch0 range))))
      (let ((fallback (fn (news: (Vec Stx))
                        (let ((fallback-top (fg-with-sources top-form (. ch depth) news (. ch steps) 0)))
                          (if (< (. top at) 0) fallback-top (with-item-at form items (. top at) fallback-top))))))
        (let ((loops (cond (not (fg-maps-only? (. ch steps))) (fuse-flow-rewrite ctx ch pos fallback)
                           (. ch range) (fuse-range-rewrite ctx ch pos fallback)
                           :else (fuse-span-rewrite ctx ch pos fallback))))
          (if (= (count (. counts pairs)) 0) loops (fg-let (. counts pairs) loops pos)))))))

;; The steps with each `take` count that is not atomic a gensym, and the bindings of those gensyms, outermost first.
(defstruct CountPairs (steps: (Vec Step) pairs: (Vec Stx)))

(defun count-pairs :private (ctx: ExpandCtx steps: (Vec Step) pos: Pos) -> CountPairs
  (loop ((i 0) (out (vec-empty)) (pairs (vec-empty)))
    (if (>= i (count steps))
        (CountPairs out pairs)
        (match (nth steps i)
          ((StTake n) (if (fuse-atomic? n)
                          (recur (+ i 1) (conj out (StTake n)) pairs)
                          (let ((g (ctx-gensym ctx "fuse" pos)))
                            (recur (+ i 1) (conj out (StTake g)) (conj pairs (fg-pair g n pos))))))
          (_ (recur (+ i 1) (conj out (nth steps i)) pairs))))))

(defun with-item-at :private (form: Stx items: (Vec Stx) at: i64 x: Stx) -> Stx
  (Stx (SList (loop ((i 0) (out (vec-empty)))
                (if (< i (count items)) (recur (+ i 1) (conj out (if (= i at) x (nth items i)))) out)))
       (. form pos)))

;; `form` with every chain this rewrite takes in line, innermost first (the operand of a `quote` or `lir` is data).
(defun fuse-inline (env: FuseEnv ctx: ExpandCtx form: Stx) -> Stx
  (match (. form kind)
    ((SList items)
     (if (or (= (head-name form) (some "quote")) (= (head-name form) (some "lir")))
         form
         (let ((inner-items (loop ((i 0) (out (vec-empty)))
                              (if (< i (count items)) (recur (+ i 1) (conj out (fuse-inline env ctx (nth items i)))) out))))
           (let ((inner (Stx (SList inner-items) (. form pos))))
             (match (inline-call env ctx inner inner-items)
               ((some done) done)
               (nil inner))))))
    ((SVec items) (Stx (SVec (inline-items env ctx items)) (. form pos)))
    ((SMap items) (Stx (SMap (inline-items env ctx items)) (. form pos)))
    (_ form)))

(defun inline-items :private (env: FuseEnv ctx: ExpandCtx items: (Vec Stx)) -> (Vec Stx)
  (loop ((i 0) (out (vec-empty)))
    (if (< i (count items)) (recur (+ i 1) (conj out (fuse-inline env ctx (nth items i)))) out)))

;; Whether `form` calls `mapv` or `filterv` anywhere (with `vec` and `into`, which are terminals, the calls this rewrite reads).
(defun fuse-calls-mapv? (form: Stx) -> bool
  (match (. form kind)
    ((SList items)
     (or (match (fuse-item-sym items 0)
           ((some h) (or (= h "mapv") (= h "fib.seq/mapv") (= h "filterv") (= h "fib.seq/filterv")))
           (nil false))
         (any-mapv? items)))
    ((SVec items) (any-mapv? items))
    ((SMap items) (any-mapv? items))
    (_ false)))

(defun any-mapv? :private (items: (Vec Stx)) -> bool
  (loop ((i 0))
    (cond (>= i (count items)) false
          (fuse-calls-mapv? (nth items i)) true
          :else (recur (+ i 1)))))
