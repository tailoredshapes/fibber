;; compiler/expand/prelude.fib: the prelude macros of syntax §4.4 as
;; rewrites, as crates/fibref/src/expand/prelude/{mod,logic,forms,loops}.rs
;; (76 + 133 + 137 + 146 = 492 lines of Rust). Each takes the whole call
;; form and returns its expansion, which the expander expands again; a form
;; a macro builds carries the call's position, a form taken from the
;; arguments keeps its own (syntax §1.3); the expansions are hygienic in
;; the one way a rewrite can be (stdlib design §6.3, tranche 1 R2): every
;; head or constant that is not a core form is `fib.prelude/NAME`
;; (`prelude-name`); the macros an expansion names (`and`, `or`), the core
;; forms and the bindings a macro introduces itself (gensyms) are plain.
;;
;; TABLE-DRIVEN, as Rust's mod.rs: one function per macro, in the order of
;; the Rust files (logic, forms, loops), and `expand-call` is the Rust
;; `match` on the head, so a later change of a Rust macro is a mirror of one
;; function and a new macro is one function, one line of `prelude-macros`
;; and one line of `expand-call`. (The Rust is a registry of rows,
;; `MACROS`, and `PRELUDE_MACROS` the names of its rows; a name that is
;; no row is declined, which the last line of `expand-call` does.) This
;; port is of the CURRENT Rust macros only.
;;
;; Decided here, where the Rust is silent or a name would clash:
;; - `PRELUDE_MACROS` is the vector `prelude-macros`. The Rust functions
;;   are private to their module (`pub(super)`) and so are here; those
;;   whose Rust name is itself a prelude macro or a core form (`when`,
;;   `cond`, `list`, `assert`, `dbg`, `doto`, `range`, `if-let`,
;;   `when-let`, `plet`, `while`, `dotimes`, `for-each`: a call of one in
;;   fibber source would be expanded as the macro) end in `-macro`;
;;   `and_or` is `and-or`, `thread` is `thread`.
;; - `Outcome::Expanded` is `Rewritten`: `Expanded` is a struct of
;;   expand.types, and two modules exporting one name make that name an
;;   error where it is used unqualified (syntax §5).
;; - A Rust `Option<(Form, Form)>` or a tuple of forms is a `(Vec Stx)` of
;;   the parts in order; `Vec<Form>` iterated with `skip(n)` is `tail-from`.
;; - the Rust's second check of a `cond` clause cannot fire after its first
;;   and is not ported (`bad-clause` is the one check).
;; - a call whose head names no row (`()`, which `is-macro` never lets
;;   through) is declined, as the Rust does.
;; - `list`, `plet`, `->`, `->>`, `doto`, `assert` and `dbg` (the Rust
;;   forms.rs) are the module expand.prelude.forms, and the helpers the two
;;   share (`tail-from`, `items-of`, `body-form`...) are expand.prelude.parts,
;;   to keep each file under 500 lines.
;; - `defn` and `defn-` (Rust defn.rs), `update` (update.rs) and `reduce`
;;   (reduce.rs), the stdlib tranche 1 package R6b, are the modules
;;   expand.prelude.defn, .update and .reduce. A Rust macro that can decline
;;   (`update`, `reduce`) returns the `Outcome`, whose type is this module's:
;;   here the submodule answers `(Option Stx)`, `nil` for a decline, and
;;   `declinable` makes the outcome.
;; - `+ - * < > <= >= = max min bit-and bit-or bit-xor` (Rust fold.rs),
;;   `conj assoc dissoc merge` (colls.rs) and `swap!` (atoms.rs), the stdlib
;;   tranche 1 package R6a, are the modules expand.prelude.fold, .colls and
;;   .atoms. Each declines the binary call the builtin or the library
;;   function serves, so each answers `nil` as `update` does (`-`, `assoc`
;;   and `merge` can also fail: `declinable-result`).
;; - the rows of stdlib tranche 2 (X3, re-synced in E1) are the modules
;;   expand.prelude.guard (`if-not some declare if-some when-some
;;   when-first`; `when-not` is `unless` under its name, `when-macro` here
;;   with the name the arity error says), .vector (`vector hash-set
;;   array-map hash-map`), .extremum (`max-key min-key`), .trylet, .comp
;;   (`for doseq`) and .text (`print-str pr-str println-str prn-str`, over
;;   the pieces of expand.prelude.print), and `vswap!` is in
;;   expand.prelude.atoms. `some` can decline (the constructor), so it is
;;   `declinable-result`. `option-match`, which `if-let` and the presence
;;   macros share, is in expand.prelude.parts.
;; - `derive` is the one macro that is not a rewrite of this module,
;;   `expand.derive` (porter 3) answers it. Module dependency: expand.prelude
;;   uses expand.derive, expand.build, expand.core, expand.ctx and
;;   expand.error, and is used by expand.expr.
(ns expand.prelude
  (:use syntax.pos syntax.form expand.error expand.types expand.ctx expand.build
        expand.collections expand.prelude.parts expand.prelude.forms expand.prelude.print
        expand.prelude.defn expand.prelude.update expand.prelude.reduce
        expand.prelude.fold expand.prelude.colls expand.prelude.atoms
        expand.prelude.guard expand.prelude.vector expand.prelude.extremum
        expand.prelude.text expand.prelude.trylet expand.prelude.comp)
  (:require [expand.own :as own] [expand.derive :as dv]))

;; The prelude macros, by name, in the order of the Rust table (the soup
;; of crates/fibc/tests/bootstrap_expand picks them from it).
(def prelude-macros: (Vec str)
  ["when" "unless" "cond" "and" "or" "if-let" "when-let" "list" "plet" "while"
   "dotimes" "for-each" "range" "->" "->>" "doto" "assert" "dbg" "derive"
   "defn" "defn-" "update" "reduce" "str" "println" "print" "prn" "pr"
   "+" "-" "*" "<" ">" "<=" ">=" "=" "max" "min" "bit-and" "bit-or" "bit-xor"
   "conj" "assoc" "dissoc" "merge" "swap!"
   "if-not" "when-not" "some" "declare" "if-some" "when-some" "when-first" "try-let"
   "for" "doseq" "vector" "hash-set" "array-map" "hash-map" "max-key" "min-key"
   "vswap!" "print-str" "pr-str" "println-str" "prn-str"])

;; What a prelude macro did with a call.
(defenum Outcome
  ;; the call's expansion
  (Rewritten form: Stx)
  ;; the call, unchanged: it is not a use of the macro (only `for-each`
  ;; and the one-argument `range` decline, when they are the library
  ;; functions, §4.4)
  (Declined form: Stx))

;; Whether name is a prelude macro. (mod.rs `is_macro`)
(defun is-macro (name: str) -> bool
  (let ((n (count prelude-macros)))
    (loop ((i 0))
      (if (< i n)
          (if (= (nth prelude-macros i) name) true (recur (+ i 1)))
          false))))

;; `fib.prelude/`, which a head names the prelude's own with. (mod.rs
;; `QUALIFIER`)
(def qualifier: str "fib.prelude/")

;; Whether the head name is written `fib.prelude/NAME`. (mod.rs `is_qualified`)
(defun is-qualified (name: str) -> bool
  (starts-with? name qualifier))

;; The head without the qualifier.
(defun unqualified :private (name: str) -> str
  (if (is-qualified name) (str-slice name (str-len qualifier) (str-len name)) name))

;; The prelude macro that the head `name` of a call reaches in the module
;; `ctx` is expanding (R14, stdlib §6.3; mod.rs `macro_of`): a bare name
;; that is a prelude macro the module does not define itself or see a
;; program module export (`ctx-hides-macro`); or `fib.prelude/NAME`, the
;; prelude's macro NAME whatever the module defines, except `println`,
;; which is the prelude's function (the printing macros' expansion calls
;; it, and the macro would expand its own expansion for ever; mod.rs
;; `FUNCTION_TWINS`). The answer is the row's own name.
(defun macro-of (ctx: ExpandCtx name: str) -> (Option str)
  (if (is-qualified name)
      (let ((base (unqualified name)))
        (if (and (is-macro base) (!= base "println")) (some base) nil))
      (if (and (is-macro name) (= (own/ctx-hides-macro ctx name) false)) (some name) nil)))

;; A macro that declines answers `nil`: the call, unchanged, is the outcome.
(defun declinable :private (r: (Option Stx) items: (Vec Stx) pos: Pos) -> (Result Outcome ExpandError)
  (match r
    ((some f) (Ok (Rewritten f)))
    (nil (Ok (Declined (list-form items pos))))))

;; The same for a macro that can decline and fail.
(defun declinable-result :private (r: (Result (Option Stx) ExpandError) items: (Vec Stx) pos: Pos)
    -> (Result Outcome ExpandError)
  (match r
    ((Err e) (Err e))
    ((Ok o) (declinable o items pos))))

;; The call's expansion, as an outcome.
(defun rewritten :private (r: (Result Stx ExpandError)) -> (Result Outcome ExpandError)
  (match r
    ((Err e) (Err e))
    ((Ok f) (Ok (Rewritten f)))))

;; logic.rs: when unless cond and or if-let when-let
;; `(when c body...)` ==> `(if c body ())`; `(unless c body...)` and
;; `(when-not c body...)` ==> `(if c () body)`; `name` is the one the arity
;; error names.
(defun when-macro :private (items: (Vec Stx) pos: Pos negate: bool name: str) -> (Result Stx ExpandError)
  (match (check-arity name items 1 nil pos)
    ((Err e) (Err e))
    ((Ok _)
     (let ((test (nth items 1))
           (body (body-form (tail-from items 2) pos)))
       (Ok (call "if" (if negate [test (unit pos) body] [test body (unit pos)]) pos))))))

;; `(and)` ==> `true`, `(and a)` ==> `a`, `(and a b ...)` ==> `(if a (and b
;; ...) false)`; `or` dually with `(if a true (or b ...))`.
(defun and-or :private (items: (Vec Stx) pos: Pos is-and: bool) -> Stx
  (let ((args (tail-from items 1)))
    (if (<= (count args) 1)
        (item-or-boolean args is-and pos)
        (let ((rest (call (prelude-name (if is-and "and" "or")) (tail-from args 1) pos)))
          (call "if" (if is-and
                         [(nth args 0) rest (boolean false pos)]
                         [(nth args 0) (boolean true pos) rest])
                pos)))))

;; The only argument, or the boolean the empty `and`/`or` is.
(defun item-or-boolean :private (args: (Vec Stx) b: bool pos: Pos) -> Stx
  (if (= (count args) 1) (nth args 0) (boolean b pos)))

;; Whether a `cond` clause test is the catch-all `else` or `:else`.
(defun is-else :private (test: Stx) -> bool
  (match (. test kind)
    ((SSym s) (= s "else"))
    ((SKw k) (= k "else"))
    (_ false)))

;; The first clause of `cond` that is not a list of two or more forms.
(defun bad-clause :private (clauses: (Vec Stx)) -> (Option Stx)
  (loop ((i 0))
    (if (< i (count clauses))
        (match (items-of (nth clauses i))
          ((some parts) (if (< (count parts) 2) (some (nth clauses i)) (recur (+ i 1))))
          (nil (some (nth clauses i))))
        nil)))

;; `(cond (test body+)*)`: nested `if`s, tried in order. A final clause
;; whose test is `else` or `:else` is the default; without one, falling
;; off the end is `(trap "cond: no clause matched at POS")`, which has
;; every type, so `(cond)` is that trap.
(defun cond-macro :private (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (let ((clauses (tail-from items 1)))
    (match (bad-clause clauses)
      ((some bad) (Err (malformed "cond" "a clause is (test body+)" (. bad pos))))
      (nil
       (let ((message (str-join ["cond: no clause matched at " (pos-display pos)])))
         (cond-fold clauses (call (prelude-name "trap") [(string message pos)] pos) pos))))))

;; The clauses, last first, folded onto the trap: clause j is the default
;; only when it is the last one.
(defun cond-fold :private (clauses: (Vec Stx) trap: Stx pos: Pos) -> (Result Stx ExpandError)
  (let ((last (- (count clauses) 1)))
    (loop ((j last) (acc trap))
      (if (< j 0)
          (Ok acc)
          (let ((cpos (. (nth clauses j) pos))
                (parts (unwrap-or (items-of (nth clauses j)) (vec-empty)))
                (test (nth parts 0))
                (body (body-form (tail-from parts 1) cpos)))
            (if (is-else test)
                (if (!= j last)
                    (Err (malformed "cond" "else must be the last clause" cpos))
                    (recur (- j 1) body))
                (recur (- j 1) (call "if" [test body acc] pos))))))))

;; The `x e` of the `(x e)` binding of `if-let`/`when-let`.
(defun option-binding :private (name: str form: Stx) -> (Result (Vec Stx) ExpandError)
  (match (items-of form)
    ((some parts)
     (if (= (count parts) 2)
         (Ok parts)
         (Err (malformed name "the binding is (pattern expression)" (. form pos)))))
    (nil (Err (malformed name "the binding is (pattern expression)" (. form pos))))))

;; `(if-let (p e) a b)` ==> `(match e ((fib.prelude/some p) a) (_ b))`;
;; `(if-let (p e) a)` has `()` as its else (§4.4, stdlib §2.4).
(defun if-let-macro :private (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (match (check-arity "if-let" items 2 (some 3) pos)
    ((Err e) (Err e))
    ((Ok _)
     (match (option-binding "if-let" (nth items 1))
       ((Err e) (Err e))
       ((Ok b)
        (Ok (option-match (nth b 0) (nth b 1) (nth items 2)
                          (if (> (count items) 3) (nth items 3) (unit pos)) pos)))))))

;; `(when-let (p e) body...)` ==> `(match e ((fib.prelude/some p) body)
;; (_ ()))`.
(defun when-let-macro :private (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (match (check-arity "when-let" items 1 nil pos)
    ((Err e) (Err e))
    ((Ok _)
     (match (option-binding "when-let" (nth items 1))
       ((Err e) (Err e))
       ((Ok b)
        (Ok (option-match (nth b 0) (nth b 1) (body-form (tail-from items 2) pos)
                          (unit pos) pos)))))))

;; loops.rs: while dotimes for-each range
;; `(while c body...)`.
(defun while-macro :private (items: (Vec Stx) pos: Pos) -> (Result Stx ExpandError)
  (match (check-arity "while" items 1 nil pos)
    ((Err e) (Err e))
    ((Ok _)
     (let ((steps (conj (tail-from items 2) (call "recur" (vec-empty) pos)))
           (body (call "if" [(nth items 1) (call "do" steps pos) (unit pos)] pos)))
       (Ok (call "loop" [(unit pos) body] pos))))))

;; The counting loop shared by `dotimes` and `for-each`: `bounds` are
;; the `(gensym expr)` pairs bound, in order, before the loop; `start`
;; and `limit` name the bound values.
(defstruct Counting :private (i: Stx bounds: (Vec Stx) start: Stx limit: Stx))

(defun counting-loop :private (c: Counting body: (Vec Stx) pos: Pos) -> Stx
  (let ((next (call (prelude-name "+") [(. c i) (int 1 pos)] pos))
        (steps (conj body (call "recur" [next] pos)))
        (test (call (prelude-name "<") [(. c i) (. c limit)] pos))
        (branch (call "if" [test (call "do" steps pos) (unit pos)] pos))
        (vars (list-form [(list-form [(. c i) (. c start)] pos)] pos))
        (lp (call "loop" [vars branch] pos)))
    (call "let" [(list-form (. c bounds) pos) lp] pos)))

;; `(dotimes (i n) body...)`.
(defun dotimes-macro :private (ctx: ExpandCtx items: (Vec Stx) pos: Pos)
    -> (Result Stx ExpandError)
  (match (check-arity "dotimes" items 1 nil pos)
    ((Err e) (Err e))
    ((Ok _)
     (match (counter-spec (nth items 1))
       (nil (Err (malformed "dotimes" "expected (dotimes (sym count) body)" (. (nth items 1) pos))))
       ((some spec)
        (let ((m (ctx-gensym ctx "m" pos)))
          (Ok (counting-loop (Counting (nth spec 0) [(list-form [m (nth spec 1)] pos)] (int 0 pos) m)
                             (tail-from items 2)
                             pos))))))))

;; The `i n` of a `(i n)` with `i` a symbol.
(defun counter-spec :private (form: Stx) -> (Option (Vec Stx))
  (match (items-of form)
    (nil nil)
    ((some xs) (if (and (= (count xs) 2) (some? (sym-of (nth xs 0)))) (some xs) nil))))

;; The `a b` of a literal `(range a b)`, or `0 n` of `(range n)`
;; (Decided, owner, 2026-09-27: `(range n)` is `(range 0 n)`).
(defun literal-range :private (form: Stx) -> (Option (Vec Stx))
  (match (items-of form)
    (nil nil)
    ((some xs)
     (cond ((and (= (count xs) 3) (is-sym (nth xs 0) "range")) (some [(nth xs 1) (nth xs 2)]))
           ((and (= (count xs) 2) (is-sym (nth xs 0) "range")) (some [(int 0 (. form pos)) (nth xs 1)]))
           (true nil)))))

;; `(range a b)` ==> `(fib.seq/range-by a b 1)`; `(range n)` is declined and
;; stays a call of the library function `range` (§4.4, §4.5). There is
;; no arity overloading, so the two-argument form is this rewrite. A call
;; of three arguments is declined too: it is Clojure's `(range a b step)`,
;; the library's `range-by`, and the checker's arity error of the library
;; function says so (stdlib §7 D1, `use range-by`), which a macro's own
;; arity error could not.
(defun range-macro :private (items: (Vec Stx) pos: Pos) -> (Result Outcome ExpandError)
  (if (= (count items) 4)
      (Ok (Declined (list-form items pos)))
      (match (check-arity "range" items 1 (some 2) pos)
        ((Err e) (Err e))
        ((Ok _)
         (if (= (count items) 3)
             (Ok (Rewritten (call "fib.seq/range-by" [(nth items 1) (nth items 2) (int 1 pos)] pos)))
             (Ok (Declined (list-form items pos))))))))

;; The `i` and body of a literal `(fn (i) body+)`, as `i` then the body:
;; no name, one unannotated parameter, no result annotation.
(defun literal-fn :private (form: Stx) -> (Option (Vec Stx))
  (match (items-of form)
    (nil nil)
    ((some xs)
     (if (and (>= (count xs) 3) (is-sym (nth xs 0) "fn"))
         (fn-parameter xs)
         nil))))

;; The parameter of `(fn (p) body+)` and its body, when `p` is a plain name.
(defun fn-parameter :private (xs: (Vec Stx)) -> (Option (Vec Stx))
  (match (items-of (nth xs 1))
    (nil nil)
    ((some ps)
     (if (= (count ps) 1)
         (match (sym-of (nth ps 0))
           (nil nil)
           ((some name)
            (if (or (ends-with-colon name) (= name "nil") (is-sym (nth xs 2) "->"))
                nil
                (some (concat-forms [(nth ps 0)] (tail-from xs 2))))))
         nil))))

(defun ends-with-colon :private (s: str) -> bool
  (and (> (str-len s) 0) (= (str-slice s (- (str-len s) 1) (str-len s)) ":")))

;; `(for-each (range a b) (fn (i) body...))` becomes the loop; any other
;; `(for-each c f)` is `(fib.seq/run! f c)`, the library's walk with the
;; function first; any other number of arguments is the macro's arity
;; error.
(defun for-each-macro :private (ctx: ExpandCtx items: (Vec Stx) pos: Pos)
    -> (Result Outcome ExpandError)
  (match (check-arity "for-each" items 2 (some 2) pos)
    ((Err e) (Err e))
    ((Ok _)
     (match (for-each-shape items)
       (nil (Ok (Rewritten (call "fib.seq/run!" [(nth items 2) (nth items 1)] pos))))
       ((some fun-bounds)
        (Ok (Rewritten (for-each-loop ctx (nth fun-bounds 0) (nth fun-bounds 1) pos))))))))

;; The `[a b]` and the parameter and body of a literal-range literal-fn pair.
(defun for-each-shape :private (items: (Vec Stx)) -> (Option (Vec (Vec Stx)))
  (match (literal-range (nth items 1))
    (nil nil)
    ((some bounds)
     (match (literal-fn (nth items 2))
       (nil nil)
       ((some fun) (some [bounds fun]))))))

;; The loop of a `for-each` over `a b` with the parameter and body `fun`;
;; `s` is handed out before `m`.
(defun for-each-loop :private (ctx: ExpandCtx bounds: (Vec Stx) fun: (Vec Stx) pos: Pos) -> Stx
  (let ((start (ctx-gensym ctx "s" pos))
        (m (ctx-gensym ctx "m" pos)))
    (counting-loop (Counting (nth fun 0)
                             [(list-form [start (nth bounds 0)] pos)
                              (list-form [m (nth bounds 1)] pos)]
                             start
                             m)
                   (tail-from fun 1)
                   pos)))

;; mod.rs: the table, in three `match`es to keep each function short: the
;; rows of syntax §4.4 (`expand-call`), those of stdlib tranche 1
;; (`expand-terse`: `defn` to `swap!`) and those of tranche 2, X3
;; (`expand-more`: `if-not` to `prn-str`); a name that is no row is
;; declined by the last.
;; The call `items` of the macro `name`, at pos. (the `match` of `expand`)
(defun expand-call :private (ctx: ExpandCtx name: str items: (Vec Stx) pos: Pos)
    -> (Result Outcome ExpandError)
  (match name
    ("when" (rewritten (when-macro items pos false "when")))
    ("unless" (rewritten (when-macro items pos true "unless")))
    ("cond" (rewritten (cond-macro items pos)))
    ("and" (Ok (Rewritten (and-or items pos true))))
    ("or" (Ok (Rewritten (and-or items pos false))))
    ("if-let" (rewritten (if-let-macro items pos)))
    ("when-let" (rewritten (when-let-macro items pos)))
    ("list" (Ok (Rewritten (list-macro items pos))))
    ("plet" (rewritten (plet-macro ctx items pos)))
    ("->" (rewritten (thread items pos true)))
    ("->>" (rewritten (thread items pos false)))
    ("doto" (rewritten (doto-macro ctx items pos)))
    ("assert" (rewritten (assert-macro items pos)))
    ("dbg" (rewritten (dbg-macro ctx items pos)))
    ("while" (rewritten (while-macro items pos)))
    ("dotimes" (rewritten (dotimes-macro ctx items pos)))
    ("for-each" (for-each-macro ctx items pos))
    ("range" (range-macro items pos))
    ("derive" (rewritten (dv/derive ctx items pos)))
    (_ (expand-terse ctx name items pos))))

;; The rows of stdlib tranche 1 (R5 to R6b).
(defun expand-terse :private (ctx: ExpandCtx name: str items: (Vec Stx) pos: Pos)
    -> (Result Outcome ExpandError)
  (match name
    ("defn" (rewritten (defn-macro items pos false)))
    ("defn-" (rewritten (defn-macro items pos true)))
    ("update" (declinable (update-macro ctx items pos) items pos))
    ("reduce" (declinable (reduce-macro ctx items pos) items pos))
    ("str" (Ok (Rewritten (str-macro items pos))))
    ("println" (Ok (Rewritten (printer-macro items pos Println))))
    ("print" (Ok (Rewritten (printer-macro items pos Print))))
    ("prn" (Ok (Rewritten (printer-macro items pos Prn))))
    ("pr" (Ok (Rewritten (printer-macro items pos Pr))))
    ("+" (declinable (sum-or-product items pos "+" 0) items pos))
    ("-" (declinable-result (difference items pos) items pos))
    ("*" (declinable (sum-or-product items pos "*" 1) items pos))
    ("<" (declinable (comparison ctx items pos "<") items pos))
    (">" (declinable (comparison ctx items pos ">") items pos))
    ("<=" (declinable (comparison ctx items pos "<=") items pos))
    (">=" (declinable (comparison ctx items pos ">=") items pos))
    ("=" (declinable (comparison ctx items pos "=") items pos))
    ("max" (declinable (extremum items pos "max") items pos))
    ("min" (declinable (extremum items pos "min") items pos))
    ("bit-and" (declinable (bits-macro items pos "bit-and") items pos))
    ("bit-or" (declinable (bits-macro items pos "bit-or") items pos))
    ("bit-xor" (declinable (bits-macro items pos "bit-xor") items pos))
    ("conj" (declinable (conj-macro items pos) items pos))
    ("assoc" (declinable-result (assoc-macro items pos) items pos))
    ("dissoc" (declinable (dissoc-macro items pos) items pos))
    ("merge" (declinable-result (merge-macro items pos) items pos))
    ("swap!" (declinable (swap-macro ctx items pos) items pos))
    (_ (expand-more ctx name items pos))))

;; The rows of tranche 2, X3.
(defun expand-more :private (ctx: ExpandCtx name: str items: (Vec Stx) pos: Pos)
    -> (Result Outcome ExpandError)
  (match name
    ("if-not" (rewritten (if-not-macro items pos)))
    ("when-not" (rewritten (when-macro items pos true "when-not")))
    ("some" (declinable-result (some-macro items pos) items pos))
    ("declare" (rewritten (declare-macro items pos)))
    ("if-some" (rewritten (if-some-macro items pos)))
    ("when-some" (rewritten (when-some-macro items pos)))
    ("when-first" (rewritten (when-first-macro items pos)))
    ("try-let" (rewritten (try-let-macro ctx items pos)))
    ("for" (rewritten (for-macro ctx items pos)))
    ("doseq" (rewritten (doseq-macro ctx items pos)))
    ("vector" (Ok (Rewritten (vector-macro items pos))))
    ("hash-set" (Ok (Rewritten (hash-set-macro items pos))))
    ("array-map" (rewritten (array-map-macro items pos)))
    ("hash-map" (rewritten (hash-map-macro items pos)))
    ("max-key" (rewritten (key-extremum ctx items pos "max-key" "fib.seq/max-key-pair")))
    ("min-key" (rewritten (key-extremum ctx items pos "min-key" "fib.seq/min-key-pair")))
    ("vswap!" (rewritten (vswap-macro ctx items pos)))
    ("print-str" (Ok (Rewritten (text-macro items pos false false))))
    ("pr-str" (Ok (Rewritten (text-macro items pos true false))))
    ("println-str" (Ok (Rewritten (text-macro items pos false true))))
    ("prn-str" (Ok (Rewritten (text-macro items pos true true))))
    (_ (Ok (Declined (list-form items pos))))))

;; Expands one call of a prelude macro: the form must be a list whose head
;; is one of prelude-macros (a form that is not a list is declined as it
;; is). The context gives the gensyms of `plet`, `doto`, `dbg`, `dotimes`
;; `for-each`, `try-let`, `for`, `doseq`, `max-key`, `min-key` and `vswap!`, and
;; `derive` its reflection. (mod.rs `expand`)
(defun expand (ctx: ExpandCtx form: Stx) -> (Result Outcome ExpandError)
  (match (. form kind)
    ((SList items)
     (expand-call ctx
                  (if (> (count items) 0) (unqualified (unwrap-or (sym-of (nth items 0)) "")) "")
                  items
                  (. form pos)))
    (_ (Ok (Declined form)))))
