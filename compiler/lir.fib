;; compiler/lir.fib: the front half of lIR as one call (crates/lir/src/lib.rs `parse_and_check`). OWNER: package K1.

(ns lir
  (:use lir.diag lir.ast)
  (:require [lir.parse :as parse] [lir.check :as check]))


;; Parses and checks `src`: every diagnostic, or the checked module. (lib.rs `parse_and_check`)
(defun parse-and-check (src: str) -> (Result LModule (Vec Diagnostic))
  (match (parse/parse-source src)
    ((Err d) (Err [d]))
    ((Ok m) (match (check/check m)
              ((Ok _) (Ok m))
              ((Err ds) (Err ds))))))
