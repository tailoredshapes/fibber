;; compiler/lsp.fib: the language server as a tool (docs/design/fibref-port.md section 6; package L5): `lsp [lsp] [-I dir].. ` serves LSP over
;; standard input and output until `exit` (status 0 after `shutdown`, 1 without it). It is `fibc lsp` without the rest of the compiler, and what
;; `fibref lsp` will call (`lsp.server` `lsp-main`, one function for both: decision D2). The leading `lsp` is optional so that the command line the
;; VS Code pack builds (`lsp -I DIR ..`) runs as it is. The roots are `-I dir`.., then FIB_LIB, then the library (spec/syntax.md section 5).
;; Build: `fibc build compiler/lsp.fib -I compiler -I lib -L /usr/lib/llvm-21/lib -l LLVM-21 -o OUT` (run from the repository root).
(ns main
  (:require [driver.args :as a] [driver.native :as native] [expand.roots :as roots] [lsp.server :as srv]))

(defun main () -> i64
  (let ((_ (native/ignore-sigpipe))
        (words (vec (args)))
        (split (a/split-roots (if (and (> (count words) 0) (= (nth words 0) "lsp")) (vec (drop 1 words)) words))))
    (srv/lsp-main (roots/roots-from-env (. split dirs) (native/getenv-opt "FIB_LIB")))))
