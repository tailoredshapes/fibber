;; compiler/util/result.fib: the sum every pass of the compiler returns
;; when it can fail: a value, or the error that stopped it. fibber's
;; prelude has Option only, and an error carries a position and a
;; message the caller must see, so the compiler defines its own.
(ns util.result)

(defenum (Result a b)
  (Ok v: a)
  (Err e: b))
