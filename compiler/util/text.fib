;; compiler/util/text.fib: small string helpers the compiler shares.
(ns util.text)

;; n in uppercase hexadecimal, padded with zeros to at least width digits
;; (Rust's {:04X} is (hex-upper n 4)); n is not negative.
(defun hex-upper (n: i64 width: i64) -> str
  (let ((digits "0123456789ABCDEF"))
    (loop ((rest n) (acc (vec-empty)) (count 0))
      (if (and (= rest 0) (>= count width))
          (str-join (reverse-vec acc))
          (recur (shr rest 4)
                 (conj acc (str-slice digits (bit-and rest 15) (+ (bit-and rest 15) 1)))
                 (+ count 1))))))

(defun reverse-vec (v: (Vec str)) -> (Vec str)
  (let ((n (count v)))
    (loop ((i 0) (acc (vec-empty)))
      (if (< i n) (recur (+ i 1) (conj acc (nth v (- (- n 1) i)))) acc))))
