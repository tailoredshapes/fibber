;; compiler/types.fib: the type checker's tool (spec/bootstrap.md §5 for
;; the layout, the plan of M6 step 3). A STUB until the driver (package
;; P6) lands: it links every module of compiler/types/, so that
;; `fibc build compiler/types.fib` proves every stub compiles; it prints
;; nothing. The modules are in dependency order.
(ns main
  (:require [types.driver :as driver])
  (:use types.ty types.scheme types.error types.store types.table types.ast types.decls
        types.names types.display types.annot types.builtins types.init
        types.lower.typeform types.lower.decl types.lower.private types.lower.defaults
        types.lower.protos types.lower.impl-head types.lower.supers types.lower.top
        types.lower.mod types.lower.scope types.lower.bindings types.lower.clause
        types.lower.pattern types.lower.call types.lower.expr
        types.infer.cx types.infer.unify types.infer.units types.infer.send
        types.infer.colour types.infer.solve types.infer.general types.infer.polyrec
        types.infer.deps types.infer.scc types.infer.pattern types.infer.call
        types.infer.expr types.infer.mod types.exhaust.matrix types.exhaust.show
        types.exhaust types.program))

(defun main () -> i64 0)
