;; compiler/fibref/error.fib: why a run stopped, and the lines of a trace. OWNER: package F0 (contract). Rust: eval/error.rs, eval/pipeline.rs.
;; The rule of the Rust header: a plan that lacks what the interpreter needs stops the run with `IeGap`; the interpreter never invents a rule.
(ns fibref.error
  (:use syntax.pos fibref.value))

(defenum IRunError
  (IeTrap message: str pos: Pos)         ;; a `trap` or a checked failure of a builtin (types section 8.12): exit status 134 under `fibref run`
  (IeAudit message: str)                 ;; the heap's audit fired (an HpErr rendered): a memory-safety failure of the plan
  (IeGap message: str)                   ;; the plan lacks something
  (IeUnsupported message: str)           ;; an extern outside the whitelist, a program that needs preemption (exit 4)
  (IeDepth)                              ;; the evaluator's depth budget (exit 4, never a pass)
  (IeInternal message: str))

;; The statuses of the tool are those of `fibc` (driver.front: exit-rejected 3, exit-unsupported 4, exit-compile-failed 5), a trap 134.
(def exit-trap: i64 134)

;; One line of the compiled-trace format of spec/compiler.md section 4.
(defstruct ITraceLine (kind: str ordinal: i64 class: str))   ;; kind "A" "F" "S" "D" "T"; class "o" "c" "a" or ""
