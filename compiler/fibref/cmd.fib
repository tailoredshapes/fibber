;; compiler/fibref/cmd.fib: the commands run, trace, audit, explain (docs/design/fibref-port.md section 2). OWNER: package F5.
;; Each takes what the command line gave and returns the exit status, as driver.commands does. `run` prints `result: N` and the audit summary line in
;; the format of `fibref run` at seed-1 (compiler/tests/golden/fibref/run-ownership.txt); `trace` the trace of spec/compiler.md section 4 on stderr.
(ns fibref.cmd
  (:use expand.roots)
  (:require [expand.maker :as mk]))

(defun cmd-run (file: str args: (Vec str) roots: Roots rm: mk/RunnerMaker) -> i64 (trap "todo: fibref.cmd cmd-run"))
(defun cmd-trace (file: str events: bool roots: Roots rm: mk/RunnerMaker) -> i64 (trap "todo: fibref.cmd cmd-trace"))
(defun cmd-audit (file: str roots: Roots rm: mk/RunnerMaker) -> i64 (trap "todo: fibref.cmd cmd-audit"))
(defun cmd-explain (file: str steps: bool roots: Roots rm: mk/RunnerMaker) -> i64 (trap "todo: fibref.cmd cmd-explain"))
