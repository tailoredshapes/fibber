;; compiler/fibref/value.fib: the value the interpreter computes with (docs/design/fibref-port.md section 3). OWNER: package F0 (contract).
;; Rust: crates/fibref/src/eval/value.rs (Val), eval/option.rs. Scalars are unboxed in the model; every counted object is an id into the heap
;; (`IObj`, an index of `fibref.heap`'s object table). An `(Option T)` of an object is `INone`/`ISome`, of a scalar it holds a value and allocates
;; nothing (spec/types.md section 8.1, docs/design/unboxed-option.md). Names carry the prefix I (type and variant names are global when linked).
(ns fibref.value)

(defenum IVal
  IUnit
  (IBool b: bool)
  (IInt n: i64 width: i64)        ;; width in bits: 8 16 32 64
  (IFloat x: f64 width: i64)      ;; 32 or 64
  (IChar code: i64)
  (IKw name: str)
  (IPtr addr: i64)                ;; an address in the interpreter's raw arena (fibref.builtins), 0 is null
  (ITag tag: i64)
  (IWeak id: i64)                 ;; a weak reference to an object of the heap (not counted); the heap's `Weak` of seed-1 (heap/value.rs)
  ITaken                          ;; a slot whose content was moved out (steal, take, move-in): the null of the compiled code; the heap audits it
  (IObj id: i64)                  ;; a counted, stack or immortal object of the heap
  INone
  (ISome v: IVal))

;; What kind an object is (Rust heap/value.rs Kind): an immutable object, a cell, an atom.
(defenum IKind IImmutable ICell IAtom)

;; The object id a value carries, if any (a retain or release of a value with none is a no-op, as in the emitter). Rust: value.rs
(defun ival-obj (v: IVal) -> (Option i64)
  (match v
    ((IObj id) (some id))
    ((ISome x) (ival-obj x))
    (_ nil)))

;; The object a weak value names, if it is one (an `IWeak`, or an `ISome` of one).
(defun ival-weak (v: IVal) -> (Option i64)
  (match v
    ((IWeak id) (some id))
    ((ISome x) (ival-weak x))
    (_ nil)))

;; Structural equality of two values (floats by value, an object by id): the model has no derived Eq.
(defun ival-eq (a: IVal b: IVal) -> bool
  (match a
    ((IUnit) (match b ((IUnit) true) (_ false)))
    ((IBool x) (match b ((IBool y) (= x y)) (_ false)))
    ((IInt x w) (match b ((IInt y v) (and (= x y) (= w v))) (_ false)))
    ((IFloat x w) (match b ((IFloat y v) (and (= x y) (= w v))) (_ false)))
    ((IChar x) (match b ((IChar y) (= x y)) (_ false)))
    ((IKw x) (match b ((IKw y) (= x y)) (_ false)))
    ((IPtr x) (match b ((IPtr y) (= x y)) (_ false)))
    ((ITag x) (match b ((ITag y) (= x y)) (_ false)))
    ((IWeak x) (match b ((IWeak y) (= x y)) (_ false)))
    ((IObj x) (match b ((IObj y) (= x y)) (_ false)))
    ((ITaken) (match b ((ITaken) true) (_ false)))
    ((INone) (match b ((INone) true) (_ false)))
    ((ISome x) (match b ((ISome y) (ival-eq x y)) (_ false)))))
