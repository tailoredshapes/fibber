;; compiler/fibref/value.fib: the value the interpreter computes with (docs/design/fibref-port.md section 3). OWNER: package F0 (contract).
;; Rust: crates/fibref/src/eval/value.rs (Val), eval/option.rs. Scalars are unboxed in the model; every counted object is an id into the heap
;; (`IObj`, an index of `fibref.heap`'s object table). An `(Option T)` of an object is `INone`/`ISome`, of a scalar it holds a value and allocates
;; nothing (spec/types.md section 8.1, docs/design/unboxed-option.md). Names carry the prefix I (type and variant names are global when linked).
(ns fibref.value)

(defenum IVal
  IUnit
  (IBool b: bool)
  (IInt n: i64 width: i64)        ;; width in bits: 8 16 32 64
  (IFloat x: f64 width: i64)      ;; 32 or 64
  (IChar code: i64)
  (IKw name: str)
  (IPtr addr: i64)                ;; an address in the interpreter's raw arena (fibref.builtins), 0 is null
  (ITag tag: i64)
  (IObj id: i64)                  ;; a counted, stack or immortal object of the heap
  INone
  (ISome v: IVal))

;; What kind an object is (Rust heap/value.rs Kind): an immutable object, a cell, an atom.
(defenum IKind IImmutable ICell IAtom)

;; The object id a value carries, if any (a retain or release of a value with none is a no-op, as in the emitter). Rust: value.rs
(defun ival-obj (v: IVal) -> (Option i64) (trap "todo: fibref.value ival-obj"))
