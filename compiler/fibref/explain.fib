;; compiler/fibref/explain.fib: step-level explanation of a run (docs/design/fibref-port.md section 7). OWNER: package F5. New (not in the Rust).
;; `fibref explain FILE` prints the ownership plan (the text of own.explain, byte for byte); `fibref explain --steps FILE` runs the program and prints,
;; for each plan operation it performs, the source position, the operation, the object's ordinal and its count before and after.
(ns fibref.explain
  (:use own.driver fibref.heap))

(defun explain-plan (c: Checked) -> str (trap "todo: fibref.explain explain-plan"))
(defun explain-steps (c: Checked args: (Vec str)) -> str (trap "todo: fibref.explain explain-steps"))
;; The retain/release history of the object with this trace ordinal, and what still holds it at exit.
(defun explain-why-live (c: Checked ordinal: i64) -> str (trap "todo: fibref.explain explain-why-live"))
