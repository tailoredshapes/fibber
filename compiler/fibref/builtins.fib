;; compiler/fibref/builtins.fib: the 79 builtins of types.builtins and the methods of the built-in instances (docs/design/fibref-port.md section 5).
;; OWNER: package F3. Rust: eval/{native,arith,float_bits,floattext,strtod,strings,arrays,cells,io,sys,raw,unsafe_ops}.rs. One entry, uniform shape;
;; the package splits the implementation by group under compiler/fibref/builtins/ (arith, float, fmt, str, array, cell, sys, raw, extern).
;; Arithmetic traps on overflow at each width with the message of types section 8.12; there is no host wrapping to lean on.
(ns fibref.builtins
  (:use syntax.pos fibref.value fibref.error fibref.heap))

(defstruct IBuiltinCx (heap: Heap pos: Pos args: (Vec str) arena: (Cell (Vec i64))))

;; Calls the builtin `name` (or the method `name` of a built-in protocol instance on scalars, str, keywords and tags) on `args`.
(defun call-builtin (cx: IBuiltinCx name: str args: (Vec IVal)) -> (Result IVal IRunError) (trap "todo: fibref.builtins call-builtin"))
;; Whether `name` is implemented. A test compares it with the rows of types.builtins: a new row with no implementation fails the test.
(defun builtin-known? (name: str) -> bool (trap "todo: fibref.builtins builtin-known?"))
