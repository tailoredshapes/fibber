;; compiler/fibref/trace.fib: the free trace of spec/compiler.md section 4 from a heap's events. OWNER: package F1. Rust: crates/fibc/src/trace.rs
;; and heap/event.rs `traced`. After the last InitDone, ordinals renumbered in order of first allocation, immortal objects skipped.
(ns fibref.trace
  (:use fibref.heap fibref.error))

(defun trace-lines (h: Heap) -> (Vec ITraceLine) (trap "todo: fibref.trace trace-lines"))
(defun trace-text (lines: (Vec ITraceLine)) -> str (trap "todo: fibref.trace trace-text"))
;; The whole event log, one line per event (retain, release, read, write too): what `fibref trace --events` prints. New (not in the compiled trace).
(defun events-text (h: Heap) -> str (trap "todo: fibref.trace events-text"))
