;; compiler/fibref/prepare.fib: one pass per body that makes the evaluator fast: locals become frame slots, each node carries its plan
;; operations, calls carry a resolved callee, patterns become test sequences (docs/design/fibref-port.md section 3.3). OWNER: package F2.
(ns fibref.prepare
  (:use own.driver))

;; A prepared body, opaque to the other packages. `ops-text` prints the operations per call in the format of `own.explain`, so a test compares
;; prepare's operations with `fibc explain` (the plan and the evaluator then cannot disagree silently).
(defstruct IBody (name: str slots: i64 nodes: (Vec i64)))
(defun prepare-program (c: Checked) -> (Vec IBody) (trap "todo: fibref.prepare prepare-program"))
(defun ops-text (c: Checked) -> str (trap "todo: fibref.prepare ops-text"))
