;; compiler/fibref/eval.fib: the evaluator of the checked, ownership-annotated program (docs/design/fibref-port.md section 3). OWNER: package F2.
;; Input: `own.driver`'s Checked (the typed program and the plan, the data the emitter consumes). It performs the plan's retains, releases and
;; stack-ends against the audited heap. `fibref.prepare` turns a body into a slot-numbered node tree first.
(ns fibref.eval
  (:use own.driver fibref.value fibref.error fibref.heap))

;; What a run produced: the result, or why it stopped, and the heap it ran on (for the audit and the trace).
(defstruct IRun (result: (Result IVal IRunError) heap: Heap))

;; Runs `main` of the checked program. `args` is (args); `budget` the step budget in calls and back edges (0: unlimited); `depth` the call depth.
(defun run-program (c: Checked args: (Vec str) budget: i64 depth: i64) -> IRun (trap "todo: fibref.eval run-program"))
