;; compiler/fibref/task.fib: spawn, join, async, await, swap!, weak, with a deterministic schedule (docs/design/fibref-port.md section 3.5).
;; OWNER: package F4. Rust: eval/{sched,threads,task}.rs. Plan A: a task runs to completion when joined or awaited, or at the end of main; a program
;; that waits on an atom for another thread's write exhausts the step budget and is `IeUnsupported "needs preemption"`. `T` is traced per spawn.
(ns fibref.task
  (:use fibref.value fibref.error fibref.heap))

(defstruct ITasks (queue: (Cell (Vec i64)) spawned: (Cell i64)))
(defun tasks-new () -> ITasks (trap "todo: fibref.task tasks-new"))
(defun task-spawn (t: ITasks h: Heap closure: IVal) -> (Result IVal IRunError) (trap "todo: fibref.task task-spawn"))
(defun task-join (t: ITasks h: Heap task: IVal) -> (Result IVal IRunError) (trap "todo: fibref.task task-join"))
(defun task-tick (t: ITasks budget: i64) -> (Result unit IRunError) (trap "todo: fibref.task task-tick"))
