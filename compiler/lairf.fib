;; compiler/lairf.fib: lair in fibber, the tool: `lairf check|run|build|emit-llvm|dump-ast|cases|fuzz-one ..` as `lair` (crates/lair/src/cli.rs).
;; Build: fibc build compiler/lairf.fib -I compiler -I lib -L /usr/lib/llvm-21/lib -l LLVM-21 -o lairf        (run with LD_LIBRARY_PATH including /usr/lib/llvm-21/lib)
(ns main (:require [native.cli :as cli]))

(defun main () -> i64
  (match (cli/dispatch (vec (args)))
    ((Ok code) code)
    ((Err msg) (do (eprintln msg) 1))))
