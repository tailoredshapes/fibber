;; compiler/fibgen.fib: the random program generator as a tool, the port of crates/fibgen/src/main.rs (seed-1) and of `fibc gen` (method rule 5).
;; `fibgen show --seed S [--size K] [--kind programs|pipelines]` prints a program and `;; model: RESULT`; `fibgen run` generates, runs through the case
;; harness and classifies; `fibgen emit` writes cases. OWNER: package D (docs/design/fibgen-port.md section 5). Not a `fibc` command: `fibc.fib` keeps
;; refusing `gen` until the port is judged (section 6); the tool is built beside the compiler: `fibc build compiler/fibgen.fib -I compiler -I lib -o fibgen`.
(ns main
  (:require [gen.cli :as cli]))

(defun main () -> i64 (cli/cli-main (vec (args))))
