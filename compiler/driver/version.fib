;; compiler/driver/version.fib: the version of the compiler in fibber (the release line: 0.x until the owner says 1.0.0). The Rust tools
;; are the 0.0.x line. The file `VERSION` at the repository root holds the same text; scripts/check-version.sh fails if they differ,
;; since a fibber program cannot read a file at build time.
(ns driver.version)

(def version: str "0.1.2")

;; What `fibc --version` prints.
(defun version-line () -> str (str-concat "fibc " version))
