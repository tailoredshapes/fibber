;; Compiler process harness: directory and executable discovery use fib.os.
(ns driver.proc
  (:require [lair.ffi :as ffi] [fib.os :as os]))

(extern fork :private () -> i32)
(extern execv :private (ptr ptr) -> i32)
(extern dup2 :private (i32 i32) -> i32)
(extern creat :private (ptr i32) -> i32)
(extern close :private (i32) -> i32)
(extern waitpid :private (i32 ptr i32) -> i32)
(extern _exit :private (i32) -> unit)
(extern alarm :private (i32) -> i32)

(defstruct Entry (name: str dir: bool))

;; Unknown filesystem entry types still need recursive inspection by the harness.
(defun list-dir (dir: str) -> (Option (Vec Entry))
  (match (os/list-directory dir)
    ((Err _) nil)
    ((Ok entries) (some (mapv (fn (entry: os/DirectoryEntry)
      (Entry (. entry name) (or (= (. entry kind) os/Directory) (= (. entry kind) os/UnknownEntry)))) entries)))))

;; The exit status as `waitpid`'s word says it: the code of a process that exited, 128 and the signal of one that was killed.
(defun decode-status :private (w: i64) -> i64
  (if (= (bit-and w 127) 0) (bit-and (quot w 256) 255) (+ 128 (bit-and w 127))))

(defun make-temp-dir (base: str) -> (Option str)
  (match (os/create-temp-directory (str-concat base "/fibcases-XXXXXX"))
    ((Ok path) (some path)) ((Err _) nil)))

(defun remove-file (path: str) -> unit (do (os/remove-file path) ()))
(defun remove-dir (path: str) -> unit (do (os/remove-directory path) ()))

;; In the child: standard output and error to the files, the alarm set, this executable run with `argv`.
(defun become :private (pp: ptr av: ptr fo: i32 fe: i32 secs: i64) -> i64
  (unsafe
    (do (dup2 fo 1i32) (dup2 fe 2i32) (alarm (trunc i32 secs)) (execv pp av) (_exit 127i32) 0)))

;; This executable started with the words `argv` (the first is its name), standard output to the file `out` and standard error to `err`,
;; killed by SIGALRM after `secs` seconds (status 142); its process id, or -1 if there was no process. The parent's copies of the
;; words are freed at once (the child has its own after the fork), so a caller can start several and `wait-pid` for each later.
(defun spawn-start (argv: (Vec str) out: str err: str secs: i64) -> i64
  (match (os/executable-path)
    ((Err _) -1)
    ((Ok executable) (spawn-executable executable argv out err secs))))

(defun spawn-executable (executable: str argv: (Vec str) out: str err: str secs: i64) -> i64
  (let ((po (ffi/bytes-new out))
        (pe (ffi/bytes-new err))
        (pp (ffi/bytes-new executable))
        (cs (mapv (fn (w: str) (ffi/ptr->addr (ffi/bytes-new w))) argv))
        (av (ffi/words-new cs))
        (pid (unsafe
               (let ((fo (creat po 384i32))
                     (fe (creat pe 384i32))
                     (pid (fork)))
                 (cond (< pid 0i32) -1
                       (= pid 0i32) (become pp av fo fe secs)
                       :else (do (close fo) (close fe) (sext i64 pid)))))))
    (do (doseq [c cs] (ffi/free-addr c))
        (doseq [p [(ffi/ptr->addr po) (ffi/ptr->addr pe) (ffi/ptr->addr pp) (ffi/ptr->addr av)]] (ffi/free-addr p))
        pid)))

;; The exit status of the process `pid` started by `spawn-start`, waited for: as `decode-status` says; -1 if it cannot be waited for.
(defun wait-pid (pid: i64) -> i64
  (let ((st (ffi/slot-new))
        (r (unsafe (waitpid (trunc i32 pid) st 0i32)))
        (status (if (< r 0i32) -1 (decode-status (sext i64 (unsafe (load-i32 st)))))))
    (do (ffi/free-addr (ffi/ptr->addr st)) status)))

;; Waits for whichever child process ends first: its process id and its exit status (as `decode-status` says); the id is -1 when there is
;; no child left to wait for.
(defstruct Ended (pid: i64 status: i64))

(defun wait-any () -> Ended
  (let ((st (ffi/slot-new))
        (r (unsafe (waitpid -1i32 st 0i32)))
        (status (if (< r 0i32) -1 (decode-status (sext i64 (unsafe (load-i32 st)))))))
    (do (ffi/free-addr (ffi/ptr->addr st)) (Ended (sext i64 r) status))))

;; `spawn-start` and `wait-pid`: the status of the run, or -1 if there was no process.
(defun spawn-wait (argv: (Vec str) out: str err: str secs: i64) -> i64
  (let ((pid (spawn-start argv out err secs)))
    (if (< pid 0) -1 (wait-pid pid))))
