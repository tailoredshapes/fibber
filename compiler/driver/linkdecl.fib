;; compiler/driver/linkdecl.fib: what fibber adds to lair's word about a native library. The lIR names the library alone, `(dependent-library "NAME")`
;; (spec/lir.md 4.9), and lair's errors name only that; the emitter also noted which module of the program wrote the `:lib "NAME"` (emit.compile
;; `Emitted.declared`), so the driver appends it, and a user sees which of their modules asked for the library that is missing.
(ns driver.linkdecl)

;; `m` with, for each library it says is needed, the module that declared it.
(defun name-modules (m: str declared: (Vec (Pair str str))) -> str
  (reduce (fn (acc: str d: (Pair str str))
            (if (some? (str-find m (str "the native library " (. d fst)) 0))
                (str acc "\nfibc: module " (. d snd) " declared it (`:lib \"" (. d fst) "\"` on its externs)")
                acc))
          m declared))
