;; compiler/driver/commands.fib: the commands of the driver, as crates/fibc/src/main.rs `run`, `build`, `emit`, `emit_dump`,
;; `explain` (spec/compiler.md §1): each takes what the command line gave and the roots, prints what the Rust prints and returns
;; the exit status. The macro runner (`rm`, expand.maker) is the tool's: macros.runner by default, none with `--no-runner` (driver.front).
(ns driver.commands
  (:require [driver.front :as front] [expand.maker :as mk] [driver.native :as native] [emit.args :as ea] [emit.dump :as ed] [own.explain :as oe])
  (:use expand.roots driver.args))

;; The message and status of a lIR module that lair stopped at. Rust: main.rs `fail`
(defun compile-failed :private (m: str) -> i64
  (do (eprintln (str-concat "compile failed: " m)) front/exit-compile-failed))

;; `emit FILE`: the lIR module. Rust: main.rs:228 `emit`
(defun cmd-emit (file: str roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/lower-kind file roots rm false)
    ((Err code) code)
    ((Ok text) (native/write-stdout text))))

;; `explain FILE`: the ownership checker's decisions. Rust: main.rs:245 `explain`
(defun cmd-explain (file: str roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/check-file file roots rm)
    ((Err code) code)
    ((Ok c) (native/write-stdout (oe/explain (. c typed) (. c owned))))))

;; The lines of a dump, each with its newline, as one text.
(defun lines-text :private (lines: (Vec str)) -> str
  (str-join (mapv (fn (l: str) (str-concat l "\n")) lines)))

;; `emit-dump`: each file's output in turn, written at the end as one text (as the Rust does), and the largest status; a failed write
;; is the status of the write, a closed pipe is no failure. Rust: main.rs:237 `emit_dump`
(defun cmd-emit-dump (files: (Vec str) o: ea/EmitOptions roots: Roots rm: mk/RunnerMaker) -> i64
  (loop ((i 0) (texts (vec-empty)) (status 0))
    (if (< i (count files))
        (let ((d (ed/emit-file-with (nth files i) o roots rm)))
          (recur (+ i 1) (conj texts (lines-text (. d lines))) (max status (. d status))))
        (let ((w (native/write-stdout (str-join texts))))
          (if (= w 0) status w)))))

;; `run`: the module through the JIT, `main` called, its status the status. Rust: main.rs:154 `run`
(defun cmd-run (file: str trace: bool args: (Vec str) opt: i64 roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/lower-kind file roots rm false)
    ((Err code) code)
    ((Ok lir)
     (do (when trace (native/setenv-set "FIB_TRACE" "1"))
         (match (native/run-lir file lir opt args)
           ((Err m) (compile-failed m))
           ((Ok code) code))))))

;; `build`: the executable. A directory that cannot be read is refused first, before anything is compiled. Rust: main.rs:200 `build`
(defun cmd-build (file: str out: str dirs: (Vec str) libs: (Vec str) opt: i64 roots: Roots rm: mk/RunnerMaker) -> i64
  (match (first (filter (fn (d: str) (not (native/readable-dir? d))) dirs))
    ((some d) (do (eprintln (str-join ["fibc: -L " d ": not a directory that can be read"])) front/exit-usage))
    (nil
     (match (front/lower-kind file roots rm true)
       ((Err code) code)
       ((Ok lir)
        (match (native/build-lir lir out opt dirs libs)
          ((Err m) (compile-failed m))
          ((Ok _) 0)))))))
