;; compiler/driver/commands.fib: the commands of the driver, as crates/fibc/src/main.rs `run`, `build`, `emit`, `emit_dump`,
;; `explain` (spec/compiler.md §1): each takes what the command line gave and the roots, prints what the Rust prints and returns
;; the exit status. The macro runner (`rm`, expand.maker) is the tool's: macros.runner by default, none with `--no-runner` (driver.front).
(ns driver.commands
  (:require [types.targets :as tt] [llvm.target :as lt] [driver.front :as front] [expand.maker :as mk] [driver.native :as native] [driver.linkdecl :as ld] [driver.staticrun :as sr] [driver.viac :as viac] [emit.args :as ea] [emit.dump :as ed] [own.explain :as oe])
  (:use expand.roots driver.args))

;; The message and status of a lIR module that lair stopped at. Rust: main.rs `fail`
(defun compile-failed :private (m: str) -> i64
  (do (eprintln (str-concat "compile failed: " m)) front/exit-compile-failed))

;; `emit FILE`: the lIR module. Rust: main.rs:228 `emit`
(defun cmd-emit (file: str roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/lower-kind file roots rm (some? (native/getenv-opt "FIB_EMIT_EXE")))
    ((Err code) code)
    ((Ok text) (native/write-stdout text))))

;; `explain FILE`: the ownership checker's decisions. Rust: main.rs:245 `explain`
(defun cmd-explain (file: str roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/check-file file roots rm false)
    ((Err code) code)
    ((Ok c) (native/write-stdout (oe/explain (. c typed) (. c owned))))))

;; The lines of a dump, each with its newline, as one text.
(defun lines-text :private (lines: (Vec str)) -> str
  (str-join (mapv (fn (l: str) (str-concat l "\n")) lines)))

;; `emit-dump`: each file's output in turn, written at the end as one text (as the Rust does), and the largest status; a failed write
;; is the status of the write, a closed pipe is no failure. Rust: main.rs:237 `emit_dump`
(defun cmd-emit-dump (files: (Vec str) o: ea/EmitOptions roots: Roots rm: mk/RunnerMaker) -> i64
  (loop ((i 0) (texts (vec-empty)) (status 0))
    (if (< i (count files))
        (let ((d (ed/emit-file-with (nth files i) o roots rm)))
          (recur (+ i 1) (conj texts (lines-text (. d lines))) (max status (. d status))))
        (let ((w (native/write-stdout (str-join texts))))
          (if (= w 0) status w)))))

;; `run`: the module through the JIT, `main` called, its status the status. Rust: main.rs:154 `run`
(defun cmd-run (file: str trace: bool args: (Vec str) opt: i64 roots: Roots rm: mk/RunnerMaker) -> i64
  (cond (viac/via-c?) (viac/run-via-c file args opt roots rm)
        (sr/static-cases?) (sr/run-static file args opt roots rm)
        :else (cmd-run-jit file trace args opt roots rm)))

(defun cmd-run-jit :private (file: str trace: bool args: (Vec str) opt: i64 roots: Roots rm: mk/RunnerMaker) -> i64
  (match (front/lower-kind file roots rm false)
    ((Err code) code)
    ((Ok lir)
     (do (when trace (native/setenv-set "FIB_TRACE" "1"))
         (match (native/run-lir file lir opt args)
           ((Err m) (compile-failed m))
           ((Ok code) code))))))

;; The row of FIB_TARGET_TRIPLE when it is a target `build` refuses (docs/adr/0008: parked, or no row for its architecture) and
;; FIB_ALLOW_UNSUPPORTED (`--allow-unsupported`) is not 1; nil for the host, a supported row and a portability target.
(defun refused-target :private () -> (Option tt/TargetRow)
  (match (native/getenv-opt "FIB_TARGET_TRIPLE")
    (nil nil)
    ((some t) (let ((r (tt/target-row-of-triple t)))
                (if (or (= t "") (= t "host") (tt/row-buildable? r) (= (unwrap-or (native/getenv-opt "FIB_ALLOW_UNSUPPORTED") "") "1")) nil (some r))))))

;; `build`: the executable. A directory that cannot be read is refused first, before anything is compiled, then a target outside ADR 0008.
;; Rust: main.rs:200 `build`
(defun cmd-build (file: str out: str dirs: (Vec str) libs: (Vec str) opt: i64 emit: str kernel: str roots: Roots rm: mk/RunnerMaker) -> i64
  (match (first (filter (fn (d: str) (not (native/readable-dir? d))) dirs))
    ((some d) (do (eprintln (str-join ["fibc: -L " d ": not a directory that can be read"])) front/exit-usage))
    (nil (if-some [r (refused-target)]
           (do (eprintln (str-join ["fibc: " (. r triple) " is not a supported target (" (tt/support-text r) "; docs/adr/0008-supported-isas-have-guaranteed-tail-calls-and-fma.md): "
                                    "its code would lack a guaranteed tail call or a fused multiply-add; --allow-unsupported builds it anyway"]))
               front/exit-usage)
           (build-checked file out dirs libs opt emit kernel roots rm)))))

;; The kernel target of the build (docs/design/gpu.md 4.4): `--kernel-target`, else FIB_KERNEL_TARGET; "" or "none" is none.
(defun kernel-target-of :private (kernel: str) -> str
  (let ((k (if (= kernel "") (unwrap-or (native/getenv-opt "FIB_KERNEL_TARGET") "") kernel)))
    (if (= k "none") "" k)))

;; The kernels a lowered program has, from its kernel table (`(constant internal fib.kernel.NAME ptr @F)`, emit.compile): their names.
(defun kernels-in (lir: str) -> (Vec str)
  (let ((mark "(constant internal fib.kernel."))
    (loop ((from 0) (out []))
      (match (str-find lir mark from)
        (nil out)
        ((some i) (let ((s (+ i (str-len mark))))
                    (match (str-find lir " " s)
                      (nil out)
                      ((some j) (recur j (conj out (str-slice lir s j)))))))))))

(defun platform-name :private () -> str
  (match (native/getenv-opt "FIB_TARGET_TRIPLE")
    ((some t) (if (or (= t "") (= t "host")) (lt/host-triple) t))
    (nil (lt/host-triple))))

(defun build-checked :private (file: str out: str dirs: (Vec str) libs: (Vec str) opt: i64 emit: str kernel: str roots: Roots rm: mk/RunnerMaker) -> i64
  (let ((kt (kernel-target-of kernel)))
    (cond (not (= emit "exe"))
          (match (front/lower-kind file roots rm true)
            ((Err code) code)
            ((Ok lir) (if (= emit "c")
                          (match (viac/emit-c lir file out) ((Err m) (compile-failed m)) ((Ok _) 0))
                          (match (native/emit-lir lir out opt emit) ((Err m) (compile-failed m)) ((Ok _) 0)))))
          (not (= kt "")) (build-with-kernels file out dirs libs opt kt roots rm)
          :else
          (match (front/lower-kind file roots rm true)
            ((Err code) code)
            ((Ok lir)
             (let ((ks (kernels-in lir)))
               (if (empty? ks)
                   (build-exe lir file out opt dirs libs)
                   (do (eprintln (str-join ["fibc: the program has the kernel" (if (= (count ks) 1) " " "s ") (str-join-with ", " ks)
                                            " (defkernel) and " (platform-name) " has no kernel target: build with --kernel-target nvptx64-nvidia-cuda "
                                            "(or FIB_KERNEL_TARGET), which embeds the kernels' PTX for a driver; there is no CPU fallback for a kernel (docs/design/gpu.md 4.4)"]))
                       front/exit-usage))))))))

(defun str-join-with :private (sep: str xs: (Vec str)) -> str
  (reduce (fn (acc: str x: str) (if (= acc "") x (str-join [acc sep x]))) "" xs))

;; An executable with its kernels for the kernel target `kt` (docs/design/gpu.md 4.4): the program is lowered for `kt` (every pass, the kernel
;; checker among them) and its kernel module written as PTX to OUT.ptx (with the signature header, the launch ABI), then lowered for the host
;; with FIB_KERNEL_PTX naming that file, so that `(gpu/program-ptx)` is the PTX text embedded in the executable.
(defun build-with-kernels :private (file: str out: str dirs: (Vec str) libs: (Vec str) opt: i64 kt: str roots: Roots rm: mk/RunnerMaker) -> i64
  (let ((host (unwrap-or (native/getenv-opt "FIB_TARGET_TRIPLE") "host")) (ptx (str-join [out ".ptx"])))
    (if (not (tt/kernel-triple? (some kt)))
        (do (eprintln (str-join ["fibc: --kernel-target " kt ": not a kernel target (`fibc targets` lists nvptx64-nvidia-cuda as one; docs/design/gpu.md)"])) front/exit-usage)
        (do (native/setenv-set "FIB_TARGET_TRIPLE" kt)
            (match (front/lower-kind file roots rm true)
              ((Err code) (do (native/setenv-set "FIB_TARGET_TRIPLE" host) code))
              ((Ok klir)
               (match (native/emit-lir klir ptx opt "ptx")
                 ((Err m) (do (native/setenv-set "FIB_TARGET_TRIPLE" host) (compile-failed m)))
                 ((Ok _)
                  (do (native/setenv-set "FIB_TARGET_TRIPLE" host)
                      (native/setenv-set "FIB_KERNEL_PTX" ptx)
                      (match (front/lower-kind file roots rm true)
                        ((Err code) code)
                        ((Ok lir) (build-exe lir file out opt dirs libs))))))))))))

;; The executable of `lir`: the libraries its modules declare (driver.linkdecl) are linked by the mode of the build, after the `-l` the command line gave; a link that fails
;; for one of them names the module that needs it. `--via c` builds it through the C compiler (driver.viac) instead of LLVM.
(defun build-exe :private (lir: str file: str out: str opt: i64 dirs: (Vec str) libs: (Vec str)) -> i64
  (let ((declared (ld/declared-libs lir)))
    (match (ld/lib-words declared)
      ((Err m) (do (eprintln m) front/exit-usage))
      ((Ok words)
       (match (if (viac/via-c?) (viac/build-via-c lir file out opt dirs (into libs words)) (native/build-lir lir out opt dirs (into libs words)))
         ((Err m) (compile-failed (ld/explain-failure m declared)))
         ((Ok _) 0))))))

;; `targets`: the table of code generation targets (types.targets), a header line and one tab-separated line per row.
(defun cmd-targets () -> i64
  (do (println tt/ROW-HEADER)
      (doseq [r (tt/target-rows)] (println (tt/row-line r)))
      0))

;; `check MODULE..` (LIBFIX-1): `run`, `build` and `emit` check a library definition only when the program reaches it (types.infer.demand), so a type error in a
;; function nobody calls waits for its first caller. This is the full check, as `explain`'s and `emit-dump`'s: a program of one `main` that requires each module
;; (found beside the working directory, under -I, FIB_LIB and `lib`), every unit of every module it loads inferred and ownership-checked. All the modules go in one
;; program; when it is rejected each is checked alone, so that every failing module is named (with its first error), not only the first the checker met.
(defun check-source :private (mods: (Vec str)) -> str
  (str-join ["(ns main (:require " (str-join (mapv (fn (i: i64) (str-join ["[" (nth mods i) " :as m" (str i) "]"])) (range (count mods)))) "))\n(defun main () -> i64 0)\n"]))

(defun check-verdict :private (mods: (Vec str) roots: Roots rm: mk/RunnerMaker) -> (Result unit (Pair i64 str))
  (match (front/front-check (check-source mods) "<check>" roots rm false)
    ((front/FrontChecked _) (Ok ()))
    ((front/FrontRejected m) (Err (Pair front/exit-rejected m)))
    ((front/FrontFailed m) (Err (Pair front/exit-compile-failed m)))
    ((front/FrontPending r) (Err (Pair front/exit-pending r)))))

(defun cmd-check (mods: (Vec str) roots: Roots rm: mk/RunnerMaker) -> i64
  (match (check-verdict mods roots rm)
    ((Ok _) (do (println (str-join ["checked " (str (count mods)) " module(s) in full"])) 0))
    ((Err e)
     (if (= (count mods) 1)
         (do (eprintln (str-concat "rejected:\n" (. e snd))) (. e fst))
         (let ((bad (filter (fn (m: str) (match (check-verdict [m] roots rm) ((Ok _) false) ((Err _) true))) mods)))
           (do (doseq [m bad] (eprintln (str-join ["FAIL " m ": " (match (check-verdict [m] roots rm) ((Err x) (. x snd)) ((Ok _) "")) ])))
               (if (empty? bad) (do (eprintln (str-concat "rejected:\n" (. e snd))) (. e fst)) (. e fst))))))))
