;; compiler/driver/front.fib: the front end of the driver, as crates/fibc/src/front.rs `check_in` (spec/compiler.md §1) and the
;; lowering of crates/fibc/src/main.rs (`lower`, `lower_kind`, :19 the exit codes): read, load (the modules of the program found in
;; `roots`), expand, type, check ownership, then the lIR text of the module; or what to say and the exit status when a step stops.
;; Shapes decided: the macros of the program are run by the runner the tool gives (`RunnerMaker`, expand.maker; stage 2b's is macros.runner,
;; the default of `fibc`); with `--no-runner` (`no-runner-maker`) a program that calls a macro is `FrontPending` (the expander's
;; `MacroNeedsEvaluator` record on stderr, exit 1), `front-check` being the one place that expands. The reason a file or a module cannot be read is the operating system's, asked for as Rust prints it (driver.native `fault-of`).
(ns driver.front
  (:require [syntax.dump :as sdump] [expand.modules :as mods] [expand.maker :as mk] [types.driver :as td] [emit.compile :as ec] [driver.native :as native] [native.target :as nt]
            [expand.shared :as sh] [own.staged :as st] [fib.string :as s] [emit.live :as live] [pkg.modules :as md] [pkg.paths :as pp])
  (:use syntax.form expand.error expand.types expand.ctx expand.roots own.error own.program own.driver lir.target))

;; The exit statuses of a program the compiler stops at. Rust: harness/child.rs EXIT_REJECTED, EXIT_UNSUPPORTED, EXIT_COMPILE_FAILED
(def exit-usage: i64 2)
(def exit-rejected: i64 3)
(def exit-unsupported: i64 4)
(def exit-compile-failed: i64 5)
(def exit-pending: i64 1)

;; What the front end said about a program. Rust: front.rs:15 Front (and `FrontPending`: a macro that needs a runner)
(defenum Front
  (FrontChecked c: Checked)
  (FrontRejected message: str)
  (FrontFailed message: str)
  (FrontPending record: str))

;; The expander stopped: a macro that needs a runner (stage 2a has none) is pending, any other error a rejection.
(defun expand-stop :private (e: ExpandError file: str) -> Front
  (match (. e kind)
    ((MacroNeedsEvaluator _)
     (FrontPending (str-join ["error MacroNeedsEvaluator " (sdump/span-in (. e pos) file) ": " (expand-err-message (. e kind))])))
    (_ (FrontRejected (expand-error-text e)))))

;; The text of a module that is not at its file: the Rust asks the operating system why for each place it looked (beside the main file,
;; then each root), and says so for the first, naming the others with `nor at`; a place that is not missing but cannot be read ends it.
;; Rust: roots.rs:103 `find`, modules/load.rs:121 (the words are those of `impl Display for LoadError`)
(defun missing-text :private (ns: str file: str roots: Roots) -> str
  (let ((rel (str-concat (str-join (vec (interpose "/" (s/split ns ".")))) ".fib"))
        (places (into [file] (mapv (fn (d: str) (path-join d rel)) (. roots dirs)))))
    (loop ((i 0) (missing []))
      (if (>= i (count places))
          (let ((first-fault (nth missing 0))
                (also (mapv (fn (m: (Pair str native/Fault)) (. m fst)) (vec (drop 1 missing)))))
            (str-join ["module " ns " is not at " (. first-fault fst) ": " (. (. first-fault snd) text)
                       (if (empty? also) "" (str-concat "; nor at " (str-join (vec (interpose ", " also)))))]))
          (let ((f (native/fault-of (nth places i))))
            (if (or (= (. f code) 2) (= (. f code) 20))
                (recur (+ i 1) (conj missing (Pair (nth places i) f)))
                (str-join ["module " ns " is not at " (nth places i) ": " (. f text)])))))))

;; The text of a load failure; a module that is not at its file says why. Rust: modules.rs:71 `impl Display for LoadError`
(defun load-failure :private (e: LoadErr roots: Roots) -> str
  (match e
    ((LoadMissing ns file) (missing-text ns file roots))
    (_ (mods/load-err-message e))))

;; The checker's verdict. Rust: front.rs:83
(defun check-stop :private (e: CheckError) -> Front
  (match e
    ((CePrelude m) (FrontFailed m))
    ((CeInternal m) (FrontFailed m))
    (_ (FrontRejected (check-error-text e)))))

;; The live module rule of a project (emit.live `program-module?`, docs/design/live-meshql.md 4): with FIB_LIVE_ROOTS set (fibc sets it in
;; a project), the modules whose file is under one of its directories are the live ones, recorded on the checked program's globals; unset,
;; emit.live keeps its name rule.
(defun note-live-modules :private (c: Checked loaded: (Vec Loaded)) -> Checked
  (do (live/set-live-modules (. (. c typed) globals)
        (match (sys-getenv "FIB_LIVE_ROOTS")
          (nil nil)
          ((some text) (some (md/live-modules (mapv (fn (l: Loaded) (Pair (. (. l spec) ns) (. l file))) loaded) (pp/split-on text ":"))))))
      c))

;; Reads, expands, types and checks `source` (named `file` in positions), its modules looked for in `roots`, exactly as the Rust
;; front end does before it lowers. Rust: front.rs:45 `check_in`
(defun front-check (source: str file: str roots: Roots rm: mk/RunnerMaker demand: bool) -> Front
  (let ((ctx (ctx-new)))
    (match (td/prelude-forms ctx)
      ((Err m) (FrontFailed (str-concat "the prelude does not expand: " m)))
      ((Ok prelude)
       (match (mods/try-load-in source file roots)
         ((Err e) (FrontRejected (load-failure e roots)))
         ((Ok loaded)
          (match (let ((t0 (sys-clock-now)) (r (mods/expand-all loaded ctx (mk/maker-runner rm prelude loaded))))
                   (do (td/phase-note "front.expand" t0) r))
            ((Err e) (expand-stop e file))
            ((Ok modules)
             (match (check-modules loaded modules prelude (some (nt/target-info)) demand)
               ((Err e) (check-stop e))
               ((Ok c) (FrontChecked (note-live-modules c loaded))))))))))))

;; The whole check of the expanded program: lowering, inference, ownership; on demand, the units of the library the program cannot reach are left out.
(defun check-whole :private (modules: (Vec Expanded) prelude: (Vec Stx) target: (Option Target) demand: bool) -> (Result Checked CheckError)
  (if demand (own-check-modules-on-demand-for modules prelude target) (own-check-modules-for modules prelude target)))

;; The same through the persistent checker (own.staged): the implicit library lowered, typed and decided first, the program's modules after it. A process
;; that checks one program gains nothing from keeping the library's state; this is for FIB_CHECK_CACHE=on and =verify (docs/design/persistent-checker.md).
(defun check-staged :private (loaded: (Vec Loaded) modules: (Vec Expanded) prelude: (Vec Stx) target: (Option Target) demand: bool) -> (Result Checked CheckError)
  (let ((k (sh/implicit-count loaded)))
    (if (= k 0)
        (check-whole modules prelude target demand)
        (st/staged-check (st/memo-new) (sh/content-key loaded k) k modules prelude target true (if demand (some (library-flags modules)) nil)))))

;; The lIR of a checked program, or why there is none: what two checks of one program must agree on.
(defun checked-text :private (r: (Result Checked CheckError)) -> str
  (match r
    ((Ok c) (match (ec/compile-ast (. c typed) (. c owned))
              ((Ok m) (ec/emitted-text m))
              ((Err m) (str-concat "unsupported: " m))))
    ((Err e) (str-concat "error: " (check-error-text e)))))

;; FIB_CHECK_CACHE=verify checks both ways and fails when the lIR (or the error) differs; `on` uses the persistent checker; else the whole check.
(defun check-modules :private (loaded: (Vec Loaded) modules: (Vec Expanded) prelude: (Vec Stx) target: (Option Target) demand: bool)
    -> (Result Checked CheckError)
  (match (sys-getenv "FIB_CHECK_CACHE")
    ((some "on") (check-staged loaded modules prelude target demand))
    ((some "verify")
     (let ((a (check-staged loaded modules prelude target demand)) (b (check-whole modules prelude target demand)))
       (if (= (checked-text a) (checked-text b))
           b
           (Err (CeInternal "FIB_CHECK_CACHE=verify: the persistent checker and the whole check differ")))))
    (_ (check-whole modules prelude target demand))))

;; The checked program of `file`, or the exit status after the message of what stopped it. Rust: main.rs:47 `lower_kind` (first half)
(defun check-file (file: str roots: Roots rm: mk/RunnerMaker demand: bool) -> (Result Checked i64)
  (match (read-file file)
    (nil (do (eprintln (str-join ["fibc: cannot read " file ": " (. (native/fault-of file) text)])) (Err exit-usage)))
    ((some source)
     (match (front-check source file roots rm demand)
       ((FrontChecked c) (Ok c))
       ((FrontRejected m) (do (eprintln (str-concat "rejected:\n" m)) (Err exit-rejected)))
       ((FrontFailed m) (do (eprintln (str-concat "failed: " m)) (Err exit-compile-failed)))
       ((FrontPending r) (do (eprintln r) (Err exit-pending)))))))

;; The front end and the lowering: the lIR text of `file` (of an executable when `executable`), or the exit status that says why
;; not, its message already printed. The lowering's warnings (types.decls `warnings`: simd/fma without FMA) go to standard error first. Rust: main.rs:47 `lower_kind`
(defun lower-module (file: str roots: Roots rm: mk/RunnerMaker executable: bool) -> (Result ec/Emitted i64)
  (match (check-file-timed file roots rm)
    ((Err code) (Err code))
    ((Ok c)
     (let ((r (compile-timed c executable)))
       (do (doseq [w @(. (. (. c typed) globals) warnings)] (eprintln w))
           (match r
             ((Err m) (do (eprintln (str-concat "unsupported: " m)) (Err exit-unsupported)))
             ((Ok text) (Ok text))))))))

(defun check-file-timed :private (file: str roots: Roots rm: mk/RunnerMaker) -> (Result Checked i64)
  (let ((t (sys-clock-now)) (r (check-file file roots rm true)))
    (do (when (= (sys-getenv "FIB_TIME") (some "1"))
          (eprintln (str "time front " (quot (- (sys-clock-now) t) 1000000) " ms"))) r)))

(defun compile-timed :private (c: Checked executable: bool) -> (Result ec/Emitted str)
  (let ((t (sys-clock-now))
        (r (if executable (ec/compile-executable-ast (. c typed) (. c owned)) (ec/compile-ast (. c typed) (. c owned)))))
    (do (when (= (sys-getenv "FIB_TIME") (some "1"))
          (eprintln (str "time lir.emit " (quot (- (sys-clock-now) t) 1000000) " ms"))) r)))

;; Source text is produced only for tools that explicitly request a serialization.
(defun lower-kind (file: str roots: Roots rm: mk/RunnerMaker executable: bool) -> (Result str i64)
  (try-let ((m (lower-module file roots rm executable))) (Ok (ec/emitted-text m))))
